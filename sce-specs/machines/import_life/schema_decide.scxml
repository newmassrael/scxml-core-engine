<!-- The owner decides about a block. The event carries nothing: what was decided is a line of the
     proposal's log, and no rule of the proposal's life reads into it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="schema_decide"
       sce:event-name="decide">
  <datamodel sce:payload="none"/>
</scxml>
