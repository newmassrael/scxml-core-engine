"""Bazel repository rule for consuming the SCE C++ runtime.

Provides @sce//:sce_core (header-only) and @sce//:sce_base (compiled).

sce_base_sources.cmake is the single source of truth for the file list.
This rule parses it and generates BUILD.bazel files automatically.

Usage in consumer WORKSPACE:

    load("//path/to/sce_repo.bzl", "sce_local_repository")

    sce_local_repository(
        name = "sce",
        path = "/path/to/scxml-core-engine",
    )

Or with environment variable:

    sce_local_repository(
        name = "sce",
        environ = "MY_SCE_ROOT",
    )
"""

def _parse_cmake_sources(content, variable):
    """Extract file paths from a CMake set(<variable> ...) block."""
    sources = []
    in_block = False
    for line in content.split("\n"):
        stripped = line.strip()
        if stripped.startswith("set(" + variable):
            in_block = True
            continue
        if in_block:
            if stripped == ")":
                break
            if stripped.startswith("#") or stripped == "":
                continue
            sources.append(stripped)
    return sources

_THIRD_PARTY_BUILD = '''\
# Auto-generated by sce_local_repository.
'''

_NLOHMANN_BUILD = '''\
# Auto-generated by sce_local_repository.
cc_library(
    name = "nlohmann_json",
    hdrs = ["include/nlohmann/json.hpp"],
    includes = ["include"],
    visibility = ["//sce:__pkg__"],
)
'''

_PUGIXML_BUILD = '''\
# Auto-generated by sce_local_repository.
cc_library(
    name = "pugixml",
    srcs = ["src/pugixml.cpp"],
    hdrs = [
        "src/pugiconfig.hpp",
        "src/pugixml.hpp",
    ],
    includes = ["src"],
    visibility = ["//sce:__pkg__"],
)
'''

_SCE_BUILD_TEMPLATE = '''\
# Auto-generated by sce_local_repository.
# Source list parsed from sce_base_sources.cmake (SSOT).

cc_library(
    name = "sce_core",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = [
        "//third_party/nlohmann_json",
        "//third_party/pugixml",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "sce_base",
    srcs = {srcs},
    copts = [
        "-include common/ExternTemplates.h",
        "-include common/DisableStdOut.h",
    ],
    local_defines = ["SCE_ENABLE_RUNTIME_LOGGING"],
    deps = [":sce_core"],
    visibility = ["//visibility:public"],
)
'''

_ROOT_BUILD = '''\
# Auto-generated by sce_local_repository.
alias(
    name = "sce_core",
    actual = "//sce:sce_core",
    visibility = ["//visibility:public"],
)

alias(
    name = "sce_base",
    actual = "//sce:sce_base",
    visibility = ["//visibility:public"],
)
'''

# Directories to skip when symlinking the SCE source tree.
_SKIP_DIRS = (
    "embed", "build", "build_debug", "build_debug_qjs", "build_python",
    "build_wasm", "build_scripts", "target", "Testing",
    ".git", ".github", ".gradle", ".kotlin", ".pytest_cache", ".serena",
    ".claude",
)

def _sce_local_repository_impl(ctx):
    # Resolve SCE root: explicit path > environment variable.
    sce_root = ""
    if ctx.attr.path:
        sce_root = ctx.attr.path
    elif ctx.attr.environ:
        sce_root = ctx.os.environ.get(ctx.attr.environ, "")

    if not sce_root:
        fail(
            "sce_local_repository: SCE root not found.\n" +
            "Set the 'path' attribute or the '{}' environment variable.".format(
                ctx.attr.environ or "SCE_ROOT",
            ),
        )

    root = ctx.path(sce_root)
    if not root.exists:
        fail("sce_local_repository: path does not exist: " + sce_root)

    # Symlink SCE source tree, skipping build artifacts.
    for entry in root.readdir():
        name = entry.basename
        if name in _SKIP_DIRS or name == "WORKSPACE":
            continue
        ctx.symlink(entry, name)

    # Parse cmake SSOT and generate BUILD files.
    cmake_content = ctx.read(
        root.get_child("sce").get_child("sce_base_sources.cmake"),
    )
    srcs = _parse_cmake_sources(cmake_content, "SCE_BASE_SOURCES")
    srcs_str = "[\n" + "".join(
        ["        \"%s\",\n" % s for s in srcs],
    ) + "    ]"

    ctx.file("BUILD.bazel", _ROOT_BUILD)
    ctx.file("sce/BUILD.bazel", _SCE_BUILD_TEMPLATE.format(srcs = srcs_str))
    ctx.file("third_party/BUILD.bazel", _THIRD_PARTY_BUILD)
    ctx.file("third_party/nlohmann_json/BUILD.bazel", _NLOHMANN_BUILD)
    ctx.file("third_party/pugixml/BUILD.bazel", _PUGIXML_BUILD)
    ctx.file("WORKSPACE", "workspace(name = \"sce\")\n")

sce_local_repository = repository_rule(
    implementation = _sce_local_repository_impl,
    attrs = {
        "path": attr.string(doc = "Absolute path to scxml-core-engine checkout."),
        "environ": attr.string(
            default = "SCE_ROOT",
            doc = "Environment variable holding the SCE checkout path.",
        ),
    },
    environ = ["SCE_ROOT"],
    local = True,
    doc = "Exposes the SCE C++ runtime (sce_core + sce_base) as a Bazel repository.",
)
