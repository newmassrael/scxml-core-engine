<?xml version="1.0" encoding="UTF-8"?>
<!--
  §scxml-6.4, docs/adr/0098: a value an <invoke> hands its child, under the id
  of a <data> in the child's top-level <datamodel>, is that <data>'s initial
  value, in place of its own:

    "the SCXML Processor MUST use the value of the <param> element as the
     initial value of the corresponding <data> element. [...] (Note that this
     means that any value specified in the <data> element is ignored.)"

  The child declares one <data> for each half of that sentence and reports
  what it saw to its parent, which keeps each report in a variable of its own
  for the test to read:

    failing      its own expression would raise error.execution; the handed
                 value takes its place, so nothing is raised (saw_errors).
    effectful    its own expression would change `effects`; the handed value
                 takes its place, so `effects` is untouched (saw_effects).
    state_local  a state's <data>, under a name the parent hands: it never
                 takes a handed value and keeps its own.
    nowhere      a name the child declares nowhere: it is not added.
    record       an object with an object and an array inside it, handed
                 from the parent's datamodel: it arrives whole.
    seen_by_script, seen_by_entry
                 the top-level <script> and the initial <onentry> read the
                 handed values, so they are declared before either runs.
    refused      a value the test's engine may refuse to hold
                 (AChildTakesAHandedValueInPlaceOfItsDataTest): its <data> then
                 fails as one whose own expression failed, with
                 error.execution, and its own value is not taken instead.

  Every report is a string the child computes, so the parent never reads a
  location that may be missing, and the child counts the error.execution
  events it saw before it reports: those of its start are on its internal
  queue ahead of `checked`.

  Not under integration_resources/: a stem there is a commitment of every
  channel, and the canonical fixture of docs/adr/0098 lands there last, once
  every backend takes a handed value in place of its <data>.

  Kotlin compile+run: scripts/regen_a_child_takes_a_handed_value_in_place_of_its_data_kotlin.sh
  commits the generated machines, and
  backends/kotlin/tests/src/test/kotlin/com/sce/integration/AChildTakesAHandedValueInPlaceOfItsDataTest.kt
  drives them.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" initial="invoking"
       name="a_child_takes_a_handed_value_in_place_of_its_data">
    <datamodel>
        <data id="record" expr="({ name: 'whole', inner: { depth: 2 }, tags: ['a', 'b'] })"/>
        <data id="saw_failing" expr="'unreported'"/>
        <data id="saw_errors" expr="'unreported'"/>
        <data id="saw_effectful" expr="'unreported'"/>
        <data id="saw_effects" expr="'unreported'"/>
        <data id="saw_state_local" expr="'unreported'"/>
        <data id="saw_nowhere" expr="'unreported'"/>
        <data id="saw_record" expr="'unreported'"/>
        <data id="saw_by_script" expr="'unreported'"/>
        <data id="saw_by_entry" expr="'unreported'"/>
        <data id="saw_refused" expr="'unreported'"/>
    </datamodel>

    <state id="invoking">
        <invoke type="scxml" id="kid">
            <param name="failing" expr="'handed'"/>
            <param name="effectful" expr="'handed'"/>
            <param name="state_local" expr="'handed'"/>
            <param name="nowhere" expr="'handed'"/>
            <param name="record" expr="record"/>
            <param name="refused" expr="'unholdable'"/>
            <content>
                <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                       datamodel="ecmascript" initial="check">
                    <datamodel>
                        <data id="effects" expr="0"/>
                        <data id="failing" expr="undefined.invalidProperty"/>
                        <data id="effectful" expr="effects = effects + 1"/>
                        <data id="record" expr="null"/>
                        <data id="refused" expr="'own'"/>
                        <data id="errors" expr="0"/>
                        <data id="seen_by_script" expr="'unset'"/>
                        <data id="seen_by_entry" expr="'unset'"/>
                    </datamodel>
                    <script>seen_by_script = failing;</script>
                    <state id="check">
                        <datamodel>
                            <data id="state_local" expr="'own'"/>
                        </datamodel>
                        <onentry>
                            <assign location="seen_by_entry" expr="effectful"/>
                            <raise event="checked"/>
                        </onentry>
                        <transition event="error.execution">
                            <assign location="errors" expr="errors + 1"/>
                        </transition>
                        <transition event="checked" target="done">
                            <send target="#_parent" event="report">
                                <param name="failing" expr="failing"/>
                                <param name="errors" expr="errors === 0 ? 'none' : (errors === 1 ? 'one' : 'many')"/>
                                <param name="effectful" expr="effectful"/>
                                <param name="effects" expr="effects === 0 ? 'untouched' : 'changed'"/>
                                <param name="state_local" expr="state_local"/>
                                <param name="nowhere" expr="typeof nowhere"/>
                                <param name="record" expr="record &amp;&amp; record.inner &amp;&amp; record.tags &amp;&amp; record.name === 'whole' &amp;&amp; record.inner.depth === 2 &amp;&amp; record.tags.length === 2 &amp;&amp; record.tags[1] === 'b' ? 'whole' : 'not whole'"/>
                                <param name="by_script" expr="seen_by_script"/>
                                <param name="by_entry" expr="seen_by_entry"/>
                                <param name="refused" expr="typeof refused"/>
                            </send>
                        </transition>
                    </state>
                    <final id="done"/>
                </scxml>
            </content>
        </invoke>
        <transition event="report" target="reported">
            <assign location="saw_failing" expr="_event.data.failing"/>
            <assign location="saw_errors" expr="_event.data.errors"/>
            <assign location="saw_effectful" expr="_event.data.effectful"/>
            <assign location="saw_effects" expr="_event.data.effects"/>
            <assign location="saw_state_local" expr="_event.data.state_local"/>
            <assign location="saw_nowhere" expr="_event.data.nowhere"/>
            <assign location="saw_record" expr="_event.data.record"/>
            <assign location="saw_by_script" expr="_event.data.by_script"/>
            <assign location="saw_by_entry" expr="_event.data.by_entry"/>
            <assign location="saw_refused" expr="_event.data.refused"/>
        </transition>
    </state>

    <final id="reported"/>
</scxml>
