<?xml version="1.0" encoding="UTF-8"?>
<!--
  docs/adr/0098, §scxml-6.4: a value an invoke hands its child is the initial
  value of the child's top-level <data> whose id it names. The <data>'s own
  value is never evaluated, state-local <data> takes nothing, a name no
  top-level <data> declares is not added, and the value arrives whole. The
  child's start takes the values before it declares its datamodel, so its
  top-level <script>, its first <onentry> and its first macrostep read them.

  A document of the C11 channel alone, beside its C test, until the canonical
  fixture of docs/adr/0098 lands with the runners of every channel. Its last
  phase leans on bounds the C test's target sets for this document
  (`SCE_MAX_HANDED_VALUE_DEPTH` 4, `SCE_MAX_HANDED_VALUE_ENTRIES` 8), which no
  other channel has.

  Each phase lands its failure in a <final> of its own, so a regression says
  which sentence broke.

    inPlace         a child that addresses its parent, started through
                    `_init_with_parent`. `failing` has an own expression that
                    raises error.execution and `effect` one that counts its
                    runs in `ownRuns`; both are handed values, so neither
                    expression runs. `stateOwn` is state-local and keeps its
                    own value although a value is handed under its name;
                    `stray` names nothing the child declares and stays
                    undefined. `record` arrives whole, its nested array and
                    object included. The top-level <script> copies `effect`
                    into `seenByScript` and the initial <onentry> copies
                    `failing` into `seenByEntry`. The child raises `report`
                    on entry, behind any error.execution its datamodel raised,
                    and answers with one event.

    firstMacrostep  a child that does not address its parent, started through
                    `_init_invoked`, whose first macrostep runs inside its
                    start. Its eventless transition reads `handed`: the handed
                    value takes it to its <final>, which ends the invoke, and
                    its own value strands it in `missed`, which leaves this
                    machine waiting here.

    namelistPhase   the same, for a `namelist` name whose value is an object:
                    the child's <final> is reached only when the object arrives
                    whole.

    unheld          a value the child cannot hold is its <data>'s
                    initialization error: `tooDeep` nests five objects past the
                    bound of four, and `tooMany` holds nine entries past the
                    bound of eight. Each raises error.execution in the child
                    and is left undefined, its own value not tried, and
                    `within`, handed beside them, still arrives.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" initial="inPlace"
       name="a_child_takes_what_it_is_handed">
    <datamodel>
        <data id="record" expr="({name: 'n', list: [1, 2, {deep: true}]})"/>
        <data id="deep" expr="({a: {b: {c: {d: {e: 1}}}}})"/>
        <data id="many" expr="[1, 2, 3, 4, 5, 6, 7, 8, 9]"/>
    </datamodel>

    <state id="inPlace">
        <invoke type="scxml" id="inv_in_place">
            <param name="failing" expr="1"/>
            <param name="effect" expr="'handed'"/>
            <param name="stateOwn" expr="'handed'"/>
            <param name="stray" expr="'leaked'"/>
            <param name="record" expr="record"/>
            <content>
                <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                       datamodel="ecmascript" initial="start">
                    <datamodel>
                        <data id="absent"/>
                        <data id="failing" expr="absent.field"/>
                        <data id="ownRuns" expr="0"/>
                        <data id="effect" expr="(ownRuns = ownRuns + 1)"/>
                        <data id="record" expr="'own'"/>
                        <data id="seenByScript"/>
                        <data id="seenByEntry"/>
                    </datamodel>
                    <script>seenByScript = effect;</script>
                    <state id="start">
                        <datamodel>
                            <data id="stateOwn" expr="'own'"/>
                        </datamodel>
                        <onentry>
                            <assign location="seenByEntry" expr="failing"/>
                            <raise event="report"/>
                        </onentry>
                        <transition event="error.execution" target="done">
                            <send target="#_parent" event="seed.raised"/>
                        </transition>
                        <transition event="report" cond="ownRuns !== 0" target="done">
                            <send target="#_parent" event="seed.ran"/>
                        </transition>
                        <transition event="report" cond="failing !== 1 || effect !== 'handed'" target="done">
                            <send target="#_parent" event="seed.missing"/>
                        </transition>
                        <transition event="report" cond="stateOwn !== 'own'" target="done">
                            <send target="#_parent" event="seed.local"/>
                        </transition>
                        <transition event="report" cond="typeof stray !== 'undefined'" target="done">
                            <send target="#_parent" event="seed.leaked"/>
                        </transition>
                        <transition event="report"
                                    cond="JSON.stringify(record) !== JSON.stringify({name: 'n', list: [1, 2, {deep: true}]})"
                                    target="done">
                            <send target="#_parent" event="seed.partial"/>
                        </transition>
                        <transition event="report" cond="seenByScript !== 'handed'" target="done">
                            <send target="#_parent" event="seed.script"/>
                        </transition>
                        <transition event="report" cond="seenByEntry !== 1" target="done">
                            <send target="#_parent" event="seed.entry"/>
                        </transition>
                        <transition event="report" target="done">
                            <send target="#_parent" event="seed.ok"/>
                        </transition>
                    </state>
                    <final id="done"/>
                </scxml>
            </content>
        </invoke>
        <transition event="seed.ok" target="firstMacrostep"/>
        <transition event="seed.raised" target="failOwnExpressionRaised"/>
        <transition event="seed.ran" target="failOwnExpressionRan"/>
        <transition event="seed.missing" target="failHandedValueLost"/>
        <transition event="seed.local" target="failStateLocalDataSeeded"/>
        <transition event="seed.leaked" target="failUnmatchedNameAdded"/>
        <transition event="seed.partial" target="failObjectNotWhole"/>
        <transition event="seed.script" target="failScriptReadItsDefault"/>
        <transition event="seed.entry" target="failEntryReadItsDefault"/>
        <transition event="error.execution" target="failParentRaised"/>
    </state>

    <state id="firstMacrostep">
        <invoke type="scxml" id="inv_first">
            <param name="handed" expr="'given'"/>
            <content>
                <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                       datamodel="ecmascript" initial="look">
                    <datamodel>
                        <data id="handed" expr="'own'"/>
                    </datamodel>
                    <state id="look">
                        <transition cond="handed === 'given'" target="took"/>
                        <transition target="missed"/>
                    </state>
                    <state id="missed">
                        <transition event="never" target="took"/>
                    </state>
                    <final id="took"/>
                </scxml>
            </content>
        </invoke>
        <transition event="done.invoke.inv_first" target="namelistPhase"/>
        <transition event="error.execution" target="failParentRaised"/>
    </state>

    <state id="namelistPhase">
        <invoke type="scxml" id="inv_namelist" namelist="record">
            <content>
                <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                       datamodel="ecmascript" initial="look">
                    <datamodel>
                        <data id="record" expr="'own'"/>
                    </datamodel>
                    <state id="look">
                        <transition cond="JSON.stringify(record) === JSON.stringify({name: 'n', list: [1, 2, {deep: true}]})"
                                    target="took"/>
                        <transition target="missed"/>
                    </state>
                    <state id="missed">
                        <transition event="never" target="took"/>
                    </state>
                    <final id="took"/>
                </scxml>
            </content>
        </invoke>
        <transition event="done.invoke.inv_namelist" target="unheld"/>
        <transition event="error.execution" target="failParentRaised"/>
    </state>

    <state id="unheld">
        <invoke type="scxml" id="inv_unheld">
            <param name="tooDeep" expr="deep"/>
            <param name="tooMany" expr="many"/>
            <param name="within" expr="'fits'"/>
            <content>
                <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                       datamodel="ecmascript" initial="count">
                    <datamodel>
                        <data id="raised" expr="0"/>
                        <data id="tooDeep" expr="'own'"/>
                        <data id="tooMany" expr="'own'"/>
                        <data id="within" expr="'own'"/>
                    </datamodel>
                    <state id="count">
                        <onentry>
                            <raise event="report"/>
                        </onentry>
                        <transition event="error.execution">
                            <assign location="raised" expr="raised + 1"/>
                        </transition>
                        <transition event="report" cond="raised !== 2" target="done">
                            <send target="#_parent" event="seed.unraised"/>
                        </transition>
                        <transition event="report"
                                    cond="typeof tooDeep !== 'undefined' || typeof tooMany !== 'undefined'"
                                    target="done">
                            <send target="#_parent" event="seed.held"/>
                        </transition>
                        <transition event="report" cond="within !== 'fits'" target="done">
                            <send target="#_parent" event="seed.missing"/>
                        </transition>
                        <transition event="report" target="done">
                            <send target="#_parent" event="seed.ok"/>
                        </transition>
                    </state>
                    <final id="done"/>
                </scxml>
            </content>
        </invoke>
        <transition event="seed.ok" target="pass"/>
        <transition event="seed.unraised" target="failUnheldValueRaisedNothing"/>
        <transition event="seed.held" target="failValuePastItsBoundHeld"/>
        <transition event="seed.missing" target="failHandedValueLost"/>
        <transition event="error.execution" target="failParentRaised"/>
    </state>

    <final id="pass"/>
    <final id="failOwnExpressionRaised"/>
    <final id="failOwnExpressionRan"/>
    <final id="failHandedValueLost"/>
    <final id="failStateLocalDataSeeded"/>
    <final id="failUnmatchedNameAdded"/>
    <final id="failObjectNotWhole"/>
    <final id="failScriptReadItsDefault"/>
    <final id="failEntryReadItsDefault"/>
    <final id="failUnheldValueRaisedNothing"/>
    <final id="failValuePastItsBoundHeld"/>
    <final id="failParentRaised"/>
</scxml>
