<?xml version="1.0" encoding="UTF-8"?>
<!--
  A typed event payload with one 64-bit real: the field whose JSON text the
  C11 inject seam writes into the event's `data` (ARCHITECTURE.md, "JSON Number
  Text"). Generic vocabulary (`reading.taken` and a `value`), duplicated beside
  the statechart because sce-c-tests generates from its own resource tree and
  the import resolves relative to the importing statechart's directory.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="schema_reading"
       sce:kind="event-schema"
       sce:event-name="reading.taken">
  <datamodel>
    <data id="value" sce:type="float64" sce:direction="in"/>
  </datamodel>
</scxml>
