#
# The relay of shared lists as a systemd service (docs/SCE_RELAY_DEPLOY.md), installed as
# /etc/systemd/system/sce-relay.service. It runs as a user of its own made for it (DynamicUser=),
# reads its keys as credentials only it can read, writes nowhere but its store, and is counted as
# started only once it has verified its store and taken its port (Type=notify).
#
# For a relay behind a proxy that terminates TLS: drop the tls.key credential and `--tls-key`, and
# the two capability lines (it listens on a port above 1024).

[Unit]
Description=Relay of shared lists (sce-relay)
Documentation=https://github.com/newmassrael/scxml-core-engine/blob/main/docs/SCE_RELAY_DEPLOY.md
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/sce-relay serve --config /etc/sce-relay/relay.toml --authority-key %d/authority.key --tls-key %d/tls.key

# The keys, copied by the service manager where only this service reads them (%d).
LoadCredential=authority.key:/etc/sce-relay/authority.key
LoadCredential=tls.key:/etc/sce-relay/tls/key.pem

# A user of its own, and the one directory it writes.
DynamicUser=yes
StateDirectory=sce-relay
StateDirectoryMode=0700
UMask=0077

# Port 443, and no other privilege.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# What it may see and reach.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

# What it may take of a server of 1 GB: past MemoryHigh it is slowed and reclaimed from, at
# MemoryMax it is stopped. Descriptors for 512 connections, 64 open store files and the rest.
MemoryHigh=512M
MemoryMax=640M
TasksMax=64
LimitNOFILE=4096

# A store that does not verify (65) or a configuration that is wrong (78) is not started again
# until an operator has changed something; anything else is.
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=65 78
# Starting reads and verifies every record of the store.
TimeoutStartSec=300
# SIGTERM to the relay, which stops accepting and waits up to its grace (10 s) for each connection
# to finish what it began, and as long again for the runtime to wind down.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
