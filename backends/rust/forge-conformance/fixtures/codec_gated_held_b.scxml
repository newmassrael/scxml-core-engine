<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance (docs/adr/0072, docs/adr/0077 §7): the arm of
     codec_feature_gated_arm_held under the build feature `gated-arm`. It holds
     bytes, so it has a storage trait, and a build without the feature does not
     compile this module, so nothing else may name that trait there.

     Wire shape:
       byte 0 : header, kind 1 in bit 0.
       byte 1 : the payload's length.
       then the payload.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_gated_held_b">
  <datamodel>
    <sce:flags id="header" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="kind" bit="0" width="1" value="0x01"/>
    </sce:flags>
    <data id="len" sce:type="uint8" sce:byte="1" sce:bit-size="8"/>
    <data id="payload" sce:type="bytes" sce:byte="2" sce:bit-size="length-ref" sce:length-field="len" sce:max-size="8"/>
  </datamodel>
</scxml>
