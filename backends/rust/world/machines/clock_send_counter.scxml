<?xml version="1.0" encoding="UTF-8"?>
<!--
  The counter of the stamp a node issues after the stamp (`wall`, `counter`) when its
  host says it is `now`: hlc_send's `counter`, as a number. See clock_send_wall, the
  other half. The counter continues the reading it is given and the wall time of the
  answer replaces it, so a caller asks for this one first.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="algorithm" name="clock_send_counter" version="1.0">
  <sce:import kind="event-schema" src="sce:std/merge/hlc_timestamp.scxml" as="Hlc"/>
  <sce:import kind="algorithm" src="sce:std/merge/hlc_send.scxml" as="send"/>
  <sce:signature>
    <sce:param name="wall" type="int64"/>
    <sce:param name="counter" type="uint32"/>
    <sce:param name="now" type="int64"/>
    <sce:param name="node" type="uint64"/>
    <sce:return type="uint32" may-fail="true"/>
  </sce:signature>
  <sce:body>
    <sce:var name="prev" type="record:Hlc">
      <sce:set name="wallTime" expr="wall"/>
      <sce:set name="counter" expr="counter"/>
      <sce:set name="nodeId" expr="node"/>
    </sce:var>
    <sce:var name="next" type="record:Hlc" init="send(prev, now, node)"/>
    <sce:return expr="next.counter"/>
  </sce:body>
</scxml>
