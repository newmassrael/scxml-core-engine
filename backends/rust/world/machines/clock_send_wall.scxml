<?xml version="1.0" encoding="UTF-8"?>
<!--
  The wall time of the stamp a node issues after the stamp (`wall`, `counter`) when
  its host says it is `now`: hlc_send's `wallTime`, as a number. A statechart hands
  an algorithm numbers and lists and takes a number or a list back, and not yet a
  record in either direction, so a stamp is given as its two numbers and asked for
  in halves (clock_send_counter is the other), each the answer hlc_send gives and
  not a second copy of its rule. The node id is the same on both sides of the
  call, so a stamp's third number is the node's.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="algorithm" name="clock_send_wall" version="1.0">
  <sce:import kind="event-schema" src="sce:std/merge/hlc_timestamp.scxml" as="Hlc"/>
  <sce:import kind="algorithm" src="sce:std/merge/hlc_send.scxml" as="send"/>
  <sce:signature>
    <sce:param name="wall" type="int64"/>
    <sce:param name="counter" type="uint32"/>
    <sce:param name="now" type="int64"/>
    <sce:param name="node" type="uint64"/>
    <sce:return type="int64" may-fail="true"/>
  </sce:signature>
  <sce:body>
    <sce:var name="prev" type="record:Hlc">
      <sce:set name="wallTime" expr="wall"/>
      <sce:set name="counter" expr="counter"/>
      <sce:set name="nodeId" expr="node"/>
    </sce:var>
    <sce:var name="next" type="record:Hlc" init="send(prev, now, node)"/>
    <sce:return expr="next.wallTime"/>
  </sce:body>
</scxml>
