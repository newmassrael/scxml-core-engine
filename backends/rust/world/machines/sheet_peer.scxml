<?xml version="1.0" encoding="UTF-8"?>
<!--
  datamodel="sce-static" (docs/SCE_ACCEPTED_SUBSET.md §2.15): one copy of a shared
  sheet of numbers, for the world simulation (backends/rust/world). The same document
  is a person's copy and the hub the copies send to; `sheet.join` says which.

  An edit is applied to this copy at once and sent to the hub, so typing never waits
  for the network. A write that arrives, from the hub or, at the hub, from a person,
  is applied the same way, and the hub passes it on to the other copies. Applying a
  write keeps the later of two writes to a cell by their hybrid logical clock
  stamps, so every copy ends with the same cells whatever order the writes reach it
  in and however many times each does.

  The clock is moved by what a copy sees as well as by what it does (hlc_receive):
  an edit made after reading someone else's write sorts after it, which is what a
  person who saw the number and typed over it meant. The machine reads no clock of
  its own, so a write that arrives is received at the latest time the copy has
  already stamped, and an edit is stamped at the time its host says (`now`). The
  counter of a new stamp is asked for before its wall time, because it continues
  the reading the wall time replaces.

  The merge is written out here and not in an algorithm that takes the cells and
  returns them: a statechart hands an algorithm numbers and not a list or a record,
  and takes a number or a list back and not a record. The only thing asked of an
  algorithm is the order of two stamps (stamp_later).

  The hub passes a write on to `alice` and `bob`, the two people of the simulated
  sheet, except to the one whose node id is the write's: a copy that sent a write
  does not need it back.

  `cells` is the whole sheet and is what a run compares across copies.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="open" datamodel="sce-static" name="sheet_peer">
  <sce:import kind="event-schema" src="sheet_cell.scxml" as="Cell"/>
  <sce:import kind="event-schema" src="sheet_edit.scxml" as="Edit"/>
  <sce:import kind="event-schema" src="sheet_join.scxml" as="Join"/>
  <sce:import kind="event-schema" src="sheet_row.scxml" as="Row"/>
  <sce:import kind="event-schema" src="sheet_gone.scxml" as="Gone"/>
  <sce:import kind="event-schema" src="sheet_add_row.scxml" as="AddRow"/>
  <sce:import kind="event-schema" src="sheet_drop_row.scxml" as="DropRow"/>
  <sce:import kind="event-schema" src="sce:std/merge/hlc_timestamp.scxml" as="Hlc"/>
  <sce:import kind="algorithm" src="stamp_later.scxml" as="StampLater"/>
  <sce:import kind="algorithm" src="clock_send_wall.scxml" as="SendWall"/>
  <sce:import kind="algorithm" src="clock_send_counter.scxml" as="SendCounter"/>
  <sce:import kind="algorithm" src="clock_receive_wall.scxml" as="ReceiveWall"/>
  <sce:import kind="algorithm" src="clock_receive_counter.scxml" as="ReceiveCounter"/>
  <datamodel>
    <data id="node" sce:type="uint64" expr="0" sce:direction="out"/>
    <data id="hub" sce:type="bool" expr="false" sce:direction="out"/>
    <data id="clock" sce:type="record:Hlc" sce:direction="out">
      <sce:set name="wallTime" expr="0"/>
      <sce:set name="counter" expr="0"/>
      <sce:set name="nodeId" expr="0"/>
    </data>
    <data id="cells" sce:type="list&lt;record:Cell&gt;" sce:capacity="64" sce:direction="out"/>
    <data id="rebuilt" sce:type="list&lt;record:Cell&gt;" sce:capacity="64"/>
    <data id="found" sce:type="bool" expr="false"/>
    <data id="wall32" sce:type="uint32" expr="0"/>
    <data id="node32" sce:type="uint32" expr="0"/>
    <data id="rows" sce:type="list&lt;record:Row&gt;" sce:capacity="64" sce:direction="out"/>
    <data id="aligned" sce:type="list&lt;record:Row&gt;" sce:capacity="64"/>
    <data id="gone" sce:type="list&lt;record:Gone&gt;" sce:capacity="64" sce:direction="out"/>
    <data id="lamport" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="newKey" sce:type="uint32" expr="0"/>
    <data id="phase" sce:type="uint8" expr="0"/>
    <data id="orphans" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="refusals" sce:type="uint32" expr="0" sce:direction="out"/>
  </datamodel>
  <state id="open">
    <transition event="sheet.join" type="internal">
      <assign location="node" expr="_event.data.node"/>
      <assign location="hub" expr="_event.data.hub"/>
    </transition>

    <!-- A person's edit: stamped, then handled as any write is, and sent to the hub. -->
    <transition event="sheet.edit" type="internal">
      <assign location="clock.counter"
              expr="SendCounter(clock.wallTime, clock.counter, _event.data.now, node)"/>
      <assign location="clock.wallTime"
              expr="SendWall(clock.wallTime, clock.counter, _event.data.now, node)"/>
      <assign location="wall32" expr="clock.wallTime"/>
      <assign location="node32" expr="node"/>
      <send target="#_internal" event="sheet.cell">
        <param name="row" expr="_event.data.row"/>
        <param name="col" expr="_event.data.col"/>
        <param name="value" expr="_event.data.value"/>
        <param name="wallTime" expr="wall32"/>
        <param name="counter" expr="clock.counter"/>
        <param name="nodeId" expr="node32"/>
      </send>
      <send target="#server" event="sheet.cell">
        <param name="row" expr="_event.data.row"/>
        <param name="col" expr="_event.data.col"/>
        <param name="value" expr="_event.data.value"/>
        <param name="wallTime" expr="wall32"/>
        <param name="counter" expr="clock.counter"/>
        <param name="nodeId" expr="node32"/>
      </send>
    </transition>

    <!-- A write to a cell, from a person here or from elsewhere. -->
    <transition event="sheet.cell" type="internal">
      <if cond="_event.data.nodeId !== node">
        <assign location="clock.counter"
                expr="ReceiveCounter(clock.wallTime, clock.counter, _event.data.wallTime, _event.data.counter, _event.data.nodeId, clock.wallTime, node)"/>
        <assign location="clock.wallTime"
                expr="ReceiveWall(clock.wallTime, clock.counter, _event.data.wallTime, _event.data.counter, _event.data.nodeId, clock.wallTime, node)"/>
      </if>
      <assign location="found" expr="false"/>
      <sce:clear target="rebuilt"/>
      <foreach array="cells" item="c">
        <if cond="c.row === _event.data.row &amp;&amp; c.col === _event.data.col">
          <assign location="found" expr="true"/>
          <if cond="StampLater(_event.data.wallTime, _event.data.counter, _event.data.nodeId, c.wallTime, c.counter, c.nodeId) === 1">
            <sce:append target="rebuilt" expr="_event.data"/>
          <else/>
            <sce:append target="rebuilt" expr="c"/>
          </if>
        <else/>
          <sce:append target="rebuilt" expr="c"/>
        </if>
      </foreach>
      <if cond="!found">
        <sce:append target="rebuilt" expr="_event.data"/>
      </if>
      <sce:clear target="cells"/>
      <foreach array="rebuilt" item="c">
        <sce:append target="cells" expr="c"/>
      </foreach>
      <if cond="hub &amp;&amp; _event.data.nodeId !== 1">
        <send target="#alice" event="sheet.cell">
          <param name="row" expr="_event.data.row"/>
          <param name="col" expr="_event.data.col"/>
          <param name="value" expr="_event.data.value"/>
          <param name="wallTime" expr="_event.data.wallTime"/>
          <param name="counter" expr="_event.data.counter"/>
          <param name="nodeId" expr="_event.data.nodeId"/>
        </send>
      </if>
      <if cond="hub &amp;&amp; _event.data.nodeId !== 2">
        <send target="#bob" event="sheet.cell">
          <param name="row" expr="_event.data.row"/>
          <param name="col" expr="_event.data.col"/>
          <param name="value" expr="_event.data.value"/>
          <param name="wallTime" expr="_event.data.wallTime"/>
          <param name="counter" expr="_event.data.counter"/>
          <param name="nodeId" expr="_event.data.nodeId"/>
        </send>
      </if>
    </transition>

    <!-- A person's new row: it takes the next id this copy can issue, which is larger
         than every id it has seen, and is handled as any row is and sent to the hub. -->
    <transition event="sheet.add_row" type="internal">
      <assign location="lamport" expr="lamport + 1"/>
      <assign location="newKey" expr="lamport * 256 + node"/>
      <send target="#_internal" event="sheet.row">
        <param name="key" expr="newKey"/>
        <param name="after" expr="_event.data.after"/>
      </send>
      <send target="#server" event="sheet.row">
        <param name="key" expr="newKey"/>
        <param name="after" expr="_event.data.after"/>
      </send>
    </transition>

    <!-- A row put into the sheet, from a person here or from elsewhere: placed directly
         after the row it names, past the rows already there with a larger id (the
         replicated growable array rule). A row already held is held once, so a row
         that arrives twice changes nothing. A row whose predecessor is not held cannot
         happen where a link delivers in order, and is counted and put at the end. -->
    <transition event="sheet.row" type="internal">
      <if cond="_event.data.key / 256 &gt; lamport">
        <assign location="lamport" expr="_event.data.key / 256"/>
      </if>
      <assign location="found" expr="false"/>
      <foreach array="rows" item="r">
        <if cond="r.key === _event.data.key">
          <assign location="found" expr="true"/>
        </if>
      </foreach>
      <if cond="!found">
        <sce:clear target="aligned"/>
        <if cond="_event.data.after === 0">
          <assign location="phase" expr="1"/>
        <else/>
          <assign location="phase" expr="0"/>
        </if>
        <foreach array="rows" item="r">
          <if cond="phase === 0">
            <sce:append target="aligned" expr="r"/>
            <if cond="r.key === _event.data.after">
              <assign location="phase" expr="1"/>
            </if>
          <elseif cond="phase === 1"/>
            <if cond="r.key &gt; _event.data.key">
              <sce:append target="aligned" expr="r"/>
            <else/>
              <sce:append target="aligned" expr="_event.data"/>
              <sce:append target="aligned" expr="r"/>
              <assign location="phase" expr="2"/>
            </if>
          <else/>
            <sce:append target="aligned" expr="r"/>
          </if>
        </foreach>
        <if cond="phase !== 2">
          <if cond="phase === 0">
            <assign location="orphans" expr="orphans + 1"/>
          </if>
          <sce:append target="aligned" expr="_event.data"/>
        </if>
        <sce:clear target="rows"/>
        <foreach array="aligned" item="r">
          <sce:append target="rows" expr="r"/>
        </foreach>
      </if>
      <if cond="hub &amp;&amp; _event.data.key % 256 !== 1">
        <send target="#alice" event="sheet.row">
          <param name="key" expr="_event.data.key"/>
          <param name="after" expr="_event.data.after"/>
        </send>
      </if>
      <if cond="hub &amp;&amp; _event.data.key % 256 !== 2">
        <send target="#bob" event="sheet.row">
          <param name="key" expr="_event.data.key"/>
          <param name="after" expr="_event.data.after"/>
        </send>
      </if>
    </transition>

    <!-- A person's removal of a row. -->
    <transition event="sheet.drop_row" type="internal">
      <assign location="node32" expr="node"/>
      <send target="#_internal" event="sheet.gone">
        <param name="key" expr="_event.data.row"/>
        <param name="by" expr="node32"/>
      </send>
      <send target="#server" event="sheet.gone">
        <param name="key" expr="_event.data.row"/>
        <param name="by" expr="node32"/>
      </send>
    </transition>

    <!-- A row taken out of the sheet: marked, and left in its place. Taking it out
         twice is taking it out once. -->
    <transition event="sheet.gone" type="internal">
      <assign location="found" expr="false"/>
      <foreach array="gone" item="g">
        <if cond="g.key === _event.data.key">
          <assign location="found" expr="true"/>
        </if>
      </foreach>
      <if cond="!found">
        <sce:append target="gone" expr="_event.data"/>
      </if>
      <if cond="hub &amp;&amp; _event.data.by !== 1">
        <send target="#alice" event="sheet.gone">
          <param name="key" expr="_event.data.key"/>
          <param name="by" expr="_event.data.by"/>
        </send>
      </if>
      <if cond="hub &amp;&amp; _event.data.by !== 2">
        <send target="#bob" event="sheet.gone">
          <param name="key" expr="_event.data.key"/>
          <param name="by" expr="_event.data.by"/>
        </send>
      </if>
    </transition>

    <transition event="error.execution" type="internal">
      <assign location="refusals" expr="refusals + 1"/>
    </transition>
  </state>
</scxml>
