<?xml version="1.0" encoding="UTF-8"?>
<!--
  One cell of a sheet, as a replica holds it and as a write to it travels: where it
  is (`row`, `col`), the number it holds, and the stamp of the write that put it there
  (a hybrid logical clock, hlc_timestamp). The row and the column are the ids the
  sheet gave them, which are not their places: a place is decided by the order the
  rows and columns stand in, and an id does not move when another is inserted before
  it. A cell is a last-writer-wins register, and the stamp is what decides which of
  two writes to it stays.
  The world simulation (backends/rust/world) uses it as the event-schema of a write
  and as the record of a replica's cell list, so the two cannot disagree on a field.
  Every field is at most 32 bits wide because a `<send>` carries no wider integer
  (docs/SCE_ACCEPTED_SUBSET.md §2.15): the wall time is the world's virtual
  milliseconds, which hold 49 days, and a node id is a small number.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="sheet_cell"
       sce:event-name="sheet.cell">
  <datamodel>
    <data id="row" sce:type="uint32" sce:direction="in"/>
    <data id="col" sce:type="uint32" sce:direction="in"/>
    <data id="value" sce:type="int32" sce:direction="in"/>
    <data id="wallTime" sce:type="uint32" sce:direction="in"/>
    <data id="counter" sce:type="uint32" sce:direction="in"/>
    <data id="nodeId" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
