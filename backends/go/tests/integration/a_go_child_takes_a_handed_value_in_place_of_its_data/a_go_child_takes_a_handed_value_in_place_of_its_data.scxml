<?xml version="1.0" encoding="UTF-8"?>
<!-- §scxml-6.4 on the Go channel (docs/adr/0098): a value an invoke hands its
     child is the initial value of the child's top-level <data> it names, in
     place of that <data>'s own.

       "If the 'name' of a <param> element in the <invoke> matches the 'id' of
        a <data> element in the top-level data declarations of the invoked
        session, the SCXML Processor MUST use the value of the <param> element
        as the initial value of the corresponding <data> element. [...] (Note
        that this means that any value specified in the <data> element is
        ignored.) [...] If the names do not match, the Processor MUST NOT add
        the value of the <param> element or namelist key/value pair to the
        invoked session's data model."

     The parent hands the child five names, and the child holds one of the
     rule's consequences on each:

       risky       its own expr raises error.execution (W3C test277's
                   expression), so a child that evaluates it and then
                   overwrites the value raises an error the document never
                   asked for. The child reports any error.execution first.
       noted       its own expr has an effect: it pushes onto `trail`, which
                   is declared before it and is not handed. A child that
                   evaluates it leaves `trail` one element long.
       parcel      an object holding an object and an array, which arrives
                   whole, structure included.
       stateOwned  the id of a <data> of the state `report`, not of the
                   top-level datamodel. Binding is early, so that <data> is
                   declared at load, as the top-level ones are, and keeps its
                   own value: a state's <data> never takes a handed value.
       stray       the id of no <data> at all, so it is not added.

     The top-level <script> and the initial <onentry> read the handed values,
     because the start declares them before either runs.

     The child answers with one event, the first of its checks that fails, and
     the parent ends in a <final> named for it, so a regression says which
     consequence broke. A check that cannot be evaluated is not passed over
     into `seed.ok`: the last check is the positive one, and anything else
     ends in `sawParcelBroken`.

     A Go-only document, outside integration_resources/: the canonical fixture
     of docs/adr/0098 "Decision" 5 lands there once every channel seeds this
     way. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" initial="handing"
       name="a_go_child_takes_a_handed_value_in_place_of_its_data">
    <datamodel>
        <data id="parcel" expr="({label: 'boxed', inner: {n: 7}, list: [1, 2]})"/>
    </datamodel>

    <state id="handing">
        <invoke type="scxml" id="taker">
            <param name="risky" expr="'handed'"/>
            <param name="noted" expr="'kept'"/>
            <param name="parcel" expr="parcel"/>
            <param name="stateOwned" expr="'handed'"/>
            <param name="stray" expr="'leaked'"/>
            <content>
                <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                       datamodel="ecmascript" initial="report">
                    <datamodel>
                        <data id="risky" expr="undefined.invalidProperty"/>
                        <data id="trail" expr="[]"/>
                        <data id="noted" expr="trail.push('pushed')"/>
                        <data id="parcel" expr="null"/>
                        <data id="scriptSaw" expr="'unset'"/>
                        <data id="entrySaw" expr="'unset'"/>
                    </datamodel>
                    <script>scriptSaw = risky;</script>
                    <state id="report">
                        <datamodel>
                            <data id="stateOwned" expr="'own'"/>
                        </datamodel>
                        <onentry>
                            <assign location="entrySaw" expr="noted"/>
                            <raise event="settled"/>
                        </onentry>
                        <transition event="error.execution" target="done">
                            <send target="#_parent" event="seed.raised"/>
                        </transition>
                        <transition event="settled" cond="typeof stray !== 'undefined'" target="done">
                            <send target="#_parent" event="seed.leaked"/>
                        </transition>
                        <transition event="settled" cond="stateOwned !== 'own'" target="done">
                            <send target="#_parent" event="seed.stateData"/>
                        </transition>
                        <transition event="settled" cond="trail.length !== 0" target="done">
                            <send target="#_parent" event="seed.ownValueEvaluated"/>
                        </transition>
                        <transition event="settled" cond="risky !== 'handed' || noted !== 'kept'" target="done">
                            <send target="#_parent" event="seed.ownValueKept"/>
                        </transition>
                        <transition event="settled" cond="scriptSaw !== 'handed'" target="done">
                            <send target="#_parent" event="seed.scriptReadOwn"/>
                        </transition>
                        <transition event="settled" cond="entrySaw !== 'kept'" target="done">
                            <send target="#_parent" event="seed.entryReadOwn"/>
                        </transition>
                        <transition event="settled" cond="parcel !== null &amp;&amp; parcel.label === 'boxed' &amp;&amp; parcel.inner !== null &amp;&amp; parcel.inner.n === 7 &amp;&amp; parcel.list !== null &amp;&amp; parcel.list.length === 2 &amp;&amp; parcel.list[1] === 2" target="done">
                            <send target="#_parent" event="seed.ok"/>
                        </transition>
                        <transition event="settled" target="done">
                            <send target="#_parent" event="seed.parcelBroken"/>
                        </transition>
                    </state>
                    <final id="done"/>
                </scxml>
            </content>
        </invoke>
        <transition event="seed.ok" target="pass"/>
        <transition event="seed.raised" target="sawErrorExecution"/>
        <transition event="seed.leaked" target="sawStrayAdded"/>
        <transition event="seed.stateData" target="sawStateDataSeeded"/>
        <transition event="seed.ownValueEvaluated" target="sawOwnValueEvaluated"/>
        <transition event="seed.ownValueKept" target="sawOwnValueKept"/>
        <transition event="seed.scriptReadOwn" target="sawScriptReadOwnValue"/>
        <transition event="seed.entryReadOwn" target="sawEntryReadOwnValue"/>
        <transition event="seed.parcelBroken" target="sawParcelBroken"/>
        <transition event="error.execution" target="sawParentError"/>
    </state>

    <final id="pass"/>
    <final id="sawErrorExecution"/>
    <final id="sawStrayAdded"/>
    <final id="sawStateDataSeeded"/>
    <final id="sawOwnValueEvaluated"/>
    <final id="sawOwnValueKept"/>
    <final id="sawScriptReadOwnValue"/>
    <final id="sawEntryReadOwnValue"/>
    <final id="sawParcelBroken"/>
    <final id="sawParentError"/>
</scxml>
