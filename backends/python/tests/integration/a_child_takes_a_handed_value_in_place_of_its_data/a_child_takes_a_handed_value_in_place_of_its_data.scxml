<?xml version="1.0" encoding="UTF-8"?>
<!--
  §scxml-6.4 (docs/adr/0098): a value an `<invoke>` hands its child, under a
  name that is the id of a top-level `<data>` of the child, is that `<data>`'s
  initial value, in place of the `<data>`'s own; state-local `<data>` takes no
  handed value, and a name that is the id of no top-level `<data>` is not added.

    "the SCXML Processor MUST use the value of the <param> element as the
     initial value of the corresponding <data> element. [...] (Note that this
     means that any value specified in the <data> element is ignored.)"

  The Python half of the rule, held before the canonical fixture of
  docs/adr/0098 lands on every channel. It lives beside its driver, not under
  `integration_resources/`, because a stem there is a commitment of every
  channel and the other backends do not meet the rule yet.

  Each region of `cases` invokes one child and lands in a `<final>` of its own,
  so a run says which half of the rule broke. A child reports what it saw with
  one event; the parent reads nothing but that event's name.

    failing   the child's `fragile` has an own expression that cannot be
              evaluated (`nothing.deep`, an index of null). Seeded, it is not
              evaluated, so the child raises no `error.execution`.
    effect    the child's `effectful` has an own expression with an effect: it
              assigns `effects`. Seeded, the assignment never runs.
    local     the child declares `localName` only in its initial state's
              `<datamodel>`; the parent hands `localName` all the same, and
              the state-local `<data>` keeps its own value.
    stray     the parent hands `nowhere`, which the child does not declare,
              beside `declared`, which it does: `declared` arrives, `nowhere`
              is not a variable of the child.
    namelist  the same through `namelist`: `record` (an object) arrives whole
              under the child's `record`, `stray` is not added.
    whole     an object handed by `<param>` arrives whole: its nested object
              and its array are the parent's, read field by field.
    ordered   the child's top-level `<script>` and its initial `<onentry>` both
              read the handed `greeting`: the value is in place before either
              runs, not applied after the child's start.

  Each child reads what it saw on an internal event its `<onentry>` raises, so
  an `error.execution` its start queued is taken first.

  Driver: test_a_child_takes_a_handed_value_in_place_of_its_data_aot.py.
  Regeneration: scripts/regen_a_child_takes_a_handed_value_in_place_of_its_data_python.sh.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" initial="cases"
       name="a_child_takes_a_handed_value_in_place_of_its_data">
    <datamodel>
        <data id="record" expr="({label: 'pair', items: [1, 2], inner: {depth: 2}})"/>
        <data id="stray" expr="'stray'"/>
    </datamodel>

    <parallel id="cases">
        <state id="failing" initial="failingRunning">
            <state id="failingRunning">
                <invoke type="scxml" id="inv_failing">
                    <param name="fragile" expr="'handed'"/>
                    <content>
                        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                               datamodel="ecmascript" initial="report">
                            <datamodel>
                                <data id="nothing" expr="null"/>
                                <data id="fragile" expr="nothing.deep"/>
                            </datamodel>
                            <state id="report">
                                <onentry>
                                    <raise event="look"/>
                                </onentry>
                                <transition event="error.execution" target="done">
                                    <send target="#_parent" event="failing.raised"/>
                                </transition>
                                <transition event="look" cond="fragile === 'handed'" target="done">
                                    <send target="#_parent" event="failing.handed"/>
                                </transition>
                                <transition event="look" target="done">
                                    <send target="#_parent" event="failing.lost"/>
                                </transition>
                            </state>
                            <final id="done"/>
                        </scxml>
                    </content>
                </invoke>
                <transition event="failing.handed" target="failingHanded"/>
                <transition event="failing.raised" target="failingRaised"/>
                <transition event="failing.lost" target="failingLost"/>
            </state>
            <final id="failingHanded"/>
            <final id="failingRaised"/>
            <final id="failingLost"/>
        </state>

        <state id="effect" initial="effectRunning">
            <state id="effectRunning">
                <invoke type="scxml" id="inv_effect">
                    <param name="effectful" expr="'handed'"/>
                    <content>
                        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                               datamodel="ecmascript" initial="report">
                            <datamodel>
                                <data id="effects" expr="0"/>
                                <data id="effectful" expr="effects = effects + 1"/>
                            </datamodel>
                            <state id="report">
                                <onentry>
                                    <raise event="look"/>
                                </onentry>
                                <transition event="look" cond="effects !== 0" target="done">
                                    <send target="#_parent" event="effect.ran"/>
                                </transition>
                                <transition event="look" cond="effectful === 'handed'" target="done">
                                    <send target="#_parent" event="effect.absent"/>
                                </transition>
                                <transition event="look" target="done">
                                    <send target="#_parent" event="effect.lost"/>
                                </transition>
                            </state>
                            <final id="done"/>
                        </scxml>
                    </content>
                </invoke>
                <transition event="effect.absent" target="effectAbsent"/>
                <transition event="effect.ran" target="effectRan"/>
                <transition event="effect.lost" target="effectLost"/>
            </state>
            <final id="effectAbsent"/>
            <final id="effectRan"/>
            <final id="effectLost"/>
        </state>

        <state id="local" initial="localRunning">
            <state id="localRunning">
                <invoke type="scxml" id="inv_local">
                    <param name="localName" expr="'handed'"/>
                    <content>
                        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                               datamodel="ecmascript" initial="report">
                            <state id="report">
                                <datamodel>
                                    <data id="localName" expr="'own'"/>
                                </datamodel>
                                <onentry>
                                    <raise event="look"/>
                                </onentry>
                                <transition event="look" cond="localName === 'own'" target="done">
                                    <send target="#_parent" event="local.own"/>
                                </transition>
                                <transition event="look" target="done">
                                    <send target="#_parent" event="local.taken"/>
                                </transition>
                            </state>
                            <final id="done"/>
                        </scxml>
                    </content>
                </invoke>
                <transition event="local.own" target="localOwn"/>
                <transition event="local.taken" target="localTaken"/>
            </state>
            <final id="localOwn"/>
            <final id="localTaken"/>
        </state>

        <state id="strayCase" initial="strayRunning">
            <state id="strayRunning">
                <invoke type="scxml" id="inv_stray">
                    <param name="declared" expr="'handed'"/>
                    <param name="nowhere" expr="'leaked'"/>
                    <content>
                        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                               datamodel="ecmascript" initial="report">
                            <datamodel>
                                <data id="declared" expr="'own'"/>
                            </datamodel>
                            <state id="report">
                                <onentry>
                                    <raise event="look"/>
                                </onentry>
                                <transition event="look" cond="typeof nowhere !== 'undefined'" target="done">
                                    <send target="#_parent" event="stray.leaked"/>
                                </transition>
                                <transition event="look" cond="declared === 'handed'" target="done">
                                    <send target="#_parent" event="stray.absent"/>
                                </transition>
                                <transition event="look" target="done">
                                    <send target="#_parent" event="stray.lost"/>
                                </transition>
                            </state>
                            <final id="done"/>
                        </scxml>
                    </content>
                </invoke>
                <transition event="stray.absent" target="strayAbsent"/>
                <transition event="stray.leaked" target="strayLeaked"/>
                <transition event="stray.lost" target="strayLost"/>
            </state>
            <final id="strayAbsent"/>
            <final id="strayLeaked"/>
            <final id="strayLost"/>
        </state>

        <state id="namelistCase" initial="namelistRunning">
            <state id="namelistRunning">
                <invoke type="scxml" id="inv_namelist" namelist="record stray">
                    <content>
                        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                               datamodel="ecmascript" initial="report">
                            <datamodel>
                                <data id="record" expr="null"/>
                            </datamodel>
                            <state id="report">
                                <onentry>
                                    <raise event="look"/>
                                </onentry>
                                <transition event="look" cond="typeof stray !== 'undefined'" target="done">
                                    <send target="#_parent" event="namelist.leaked"/>
                                </transition>
                                <transition event="look" cond="record !== null &amp;&amp; record.label === 'pair' &amp;&amp; record.inner.depth === 2" target="done">
                                    <send target="#_parent" event="namelist.taken"/>
                                </transition>
                                <transition event="look" target="done">
                                    <send target="#_parent" event="namelist.lost"/>
                                </transition>
                            </state>
                            <final id="done"/>
                        </scxml>
                    </content>
                </invoke>
                <transition event="namelist.taken" target="namelistTaken"/>
                <transition event="namelist.leaked" target="namelistLeaked"/>
                <transition event="namelist.lost" target="namelistLost"/>
            </state>
            <final id="namelistTaken"/>
            <final id="namelistLeaked"/>
            <final id="namelistLost"/>
        </state>

        <state id="whole" initial="wholeRunning">
            <state id="wholeRunning">
                <invoke type="scxml" id="inv_whole">
                    <param name="handedRecord" expr="record"/>
                    <content>
                        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                               datamodel="ecmascript" initial="report">
                            <datamodel>
                                <data id="handedRecord" expr="({label: 'own'})"/>
                            </datamodel>
                            <state id="report">
                                <onentry>
                                    <raise event="look"/>
                                </onentry>
                                <transition event="look" cond="handedRecord.label === 'pair' &amp;&amp; handedRecord.items.length === 2 &amp;&amp; handedRecord.items[0] === 1 &amp;&amp; handedRecord.items[1] === 2 &amp;&amp; handedRecord.inner.depth === 2" target="done">
                                    <send target="#_parent" event="whole.arrived"/>
                                </transition>
                                <transition event="look" target="done">
                                    <send target="#_parent" event="whole.broken"/>
                                </transition>
                            </state>
                            <final id="done"/>
                        </scxml>
                    </content>
                </invoke>
                <transition event="whole.arrived" target="wholeArrived"/>
                <transition event="whole.broken" target="wholeBroken"/>
            </state>
            <final id="wholeArrived"/>
            <final id="wholeBroken"/>
        </state>

        <state id="ordered" initial="orderedRunning">
            <state id="orderedRunning">
                <invoke type="scxml" id="inv_ordered">
                    <param name="greeting" expr="'handed'"/>
                    <content>
                        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
                               datamodel="ecmascript" initial="report">
                            <datamodel>
                                <data id="greeting" expr="'own'"/>
                                <data id="scriptSaw" expr="'nothing'"/>
                                <data id="entrySaw" expr="'nothing'"/>
                            </datamodel>
                            <script>scriptSaw = greeting;</script>
                            <state id="report">
                                <onentry>
                                    <assign location="entrySaw" expr="greeting"/>
                                    <raise event="look"/>
                                </onentry>
                                <transition event="look" cond="scriptSaw === 'handed' &amp;&amp; entrySaw === 'handed'" target="done">
                                    <send target="#_parent" event="ordered.inPlace"/>
                                </transition>
                                <transition event="look" target="done">
                                    <send target="#_parent" event="ordered.late"/>
                                </transition>
                            </state>
                            <final id="done"/>
                        </scxml>
                    </content>
                </invoke>
                <transition event="ordered.inPlace" target="orderedInPlace"/>
                <transition event="ordered.late" target="orderedLate"/>
            </state>
            <final id="orderedInPlace"/>
            <final id="orderedLate"/>
        </state>
    </parallel>
</scxml>
