<!-- The moment a request is looked at: a running request whose lease ran out is written
     down as interrupted. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="schema_normalize"
       sce:event-name="normalize">
  <datamodel>
    <data id="now" sce:type="uint64" sce:direction="in"/>
  </datamodel>
</scxml>
