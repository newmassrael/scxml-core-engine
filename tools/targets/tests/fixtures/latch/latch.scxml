<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="transform" name="latch">
  <datamodel>
    <data id="level" sce:type="int32" sce:direction="in"/>

    <data id="alarm" sce:type="string" sce:direction="out"
          expr="level &gt; 80 ? 'HIGH' : (level &lt; 20 ? 'LOW' : '')"/>
  </datamodel>
</scxml>
