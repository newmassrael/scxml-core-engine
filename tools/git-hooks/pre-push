#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only WITH LicenseRef-SCE-Linking-Exception OR LicenseRef-SCE-Commercial
#
# SCE pre-push hook: work out what this push changes, and hand that to the
# gate runner, through bx when `$BX` names it (see "Where the gates run").
#
# The hook used to carry every gate inline, guarded by `stage_on "N"` blocks
# whose physical order in the file WAS the run order. That coupling is what
# this delegation removes. Gates now live one-per-file under
# `scripts/gates/`, `tools/git-hooks/gate_registry.py` records what each one
# needs and what it costs, and `scripts/gate` derives the order. The
# practical differences:
#
#   - A gate can be run on its own (`scripts/gate ledger-citations`), so
#     "check this before pushing" is a command instead of a recipe written
#     down somewhere.
#   - Order follows measured cost, so the cheapest gate that can fail runs
#     first. Under the inline arrangement a sub-minute check sat behind
#     fifteen gates because that was where it had been added.
#   - Adding a gate does not renumber anything, so nothing that refers to a
#     gate by name goes stale.
#
# What stays here is what only a push knows: which refs are being pushed and
# what they change relative to the remote.
#
# A push is bounded. `PUSH_BUDGET_S` in the registry is the ceiling on what
# this hook may cost — the owner set it at five minutes — and the gates that
# did not fit are marked `ci_only` and run in CI instead. The hook prints
# which ones it handed over at the end of a run, because a delegation nobody
# is told about is how a CI lane stays red for eight pushes.
#
# `PREPUSH_FULL=1` runs every gate regardless of paths, `ci_only` included,
# so it is NOT bounded by the budget and is the deliberate way to verify a
# tree end to end. It is the right tool after a `SKIP_PREPUSH=1` push, and
# the wrong one for an ordinary push.
#
# Bypass (for genuine emergencies): `SKIP_PREPUSH=1 git push ...`.
# Do not skip by habit — every gate corresponds to a CI failure that has
# already cost a round-trip.

set -euo pipefail

# ⚠ The refs are consumed once, here: stdin is a one-shot stream and several
# consumers below walk this variable instead.
PUSHED_REFS="$(cat)"

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ── What this push would publish, against the restricted-term list.
#
# AHEAD OF `SKIP_PREPUSH`, for the reason `pre-commit` runs its term gate ahead of
# `SKIP_PRECOMMIT`: the remote is public, a push does not un-publish, and a
# bypass meant for a slow gate is not a reason to publish a term. This is also
# the check that reads commits made past the commit hooks (`--no-verify`, a
# cherry-pick, a rebase, a clone without the installer). It has its own override,
# which says so and writes itself to the override log.
# shellcheck source=tools/git-hooks/restricted-term-gate.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/restricted-term-gate.sh"
term_push_failed=0
while read -r _tref tlocal _trref tremote; do
    [[ -z "${tlocal:-}" ]] && continue
    [[ "$tlocal" =~ ^0+$ ]] && continue   # a deletion publishes no commits
    if [[ -z "${tremote:-}" || "$tremote" =~ ^0+$ ]] \
        || ! git cat-file -e "${tremote}^{commit}" 2>/dev/null; then
        # A new ref, or a remote commit this clone does not have (a force
        # push): what is new is what no remote-tracking ref reaches.
        restricted_term_gate_range "pre-push" "$tlocal" --not --remotes || term_push_failed=1
    else
        restricted_term_gate_range "pre-push" "${tremote}..${tlocal}" || term_push_failed=1
    fi
done <<<"$PUSHED_REFS"
if (( term_push_failed )); then
    printf '\npre-push: take the text out of the commits above (amend or rebase) and push\n' >&2
    printf 'pre-push: again — the remote is public and a push does not un-publish.\n' >&2
    exit 1
fi

if [[ "${SKIP_PREPUSH:-0}" == "1" ]]; then
    echo "pre-push: SKIP_PREPUSH=1 — bypassing all local CI gates" >&2
    exit 0
fi

# ── The identities this push would publish.
#
# BEFORE the `PREPUSH_FULL` branch below, which `exec`s the runner and would
# otherwise skip this entirely — the one arrangement where "run every gate"
# runs one fewer.
#
# Not a `scripts/gates/` entry: it verifies the commits being published rather
# than the tree, and no hosted runner can observe an identity before it exists.
# See ident-gate.sh for why the push and not only the commit — pre-commit runs
# only for `git commit`, so a cherry-pick, a rebase, a merge, `SKIP_PRECOMMIT`
# or a commit made where the hooks are not installed reaches the remote without
# meeting it, and that last one is the shape the incident had.
#
# shellcheck source=tools/git-hooks/ident-gate.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ident-gate.sh"
ident_push_failed=0
while read -r _iref ilocal _irref iremote; do
    [[ -z "${ilocal:-}" ]] && continue
    [[ "$ilocal" =~ ^0+$ ]] && continue   # a deletion publishes no commits
    if [[ -z "${iremote:-}" || "$iremote" =~ ^0+$ ]]; then
        ident_range="$ilocal"             # new ref: grade the whole history
    else
        ident_range="${iremote}..${ilocal}"
    fi
    ident_gate_range "pre-push" "$ident_range" || ident_push_failed=1
done <<<"$PUSHED_REFS"
if (( ident_push_failed )); then
    printf '\npre-push: rewrite the offending commits before pushing — the remote is\n' >&2
    printf 'pre-push: public and a push does not un-publish.\n' >&2
    exit 1
fi

RUNNER="$REPO_ROOT/scripts/gate"
[[ -x "$RUNNER" ]] || {
    printf '\nERROR pre-push: gate runner missing at %s\n' "$RUNNER" >&2
    exit 1
}

# ── The tree the gates read is the commit this push publishes.
#
# The gates judge the checkout, and the push publishes commits. Those are the
# same thing only when every ref goes out at HEAD and the tracked tree is
# HEAD's: an uncommitted edit, or a push of some other commit, was judged in
# the checkout's place and the verdict was printed as the push's. bx makes the
# gap one machine wider (it sends the working tree, not a commit), but it was
# there before bx was.
#
# Untracked files are not this check's business: a local run reads them as it
# always has, and bx refuses a tree that has any, by name, before it sends.
#
# A push that publishes no commit (an up-to-date push, a deletion) runs no gate
# below, so it has no tree to be judged and is not asked for one.
HEAD_SHA="$(git rev-parse HEAD)"
tree_mismatch=0
publishes=0
while read -r href hlocal _hrref _hremote; do
    [[ -z "${hlocal:-}" ]] && continue
    [[ "$hlocal" =~ ^0+$ ]] && continue   # a deletion publishes no commits
    publishes=1
    if [[ "$hlocal" != "$HEAD_SHA" ]]; then
        printf '\nERROR pre-push: %s is pushed at %s, but the gates would read HEAD (%s)\n' \
            "$href" "${hlocal:0:12}" "${HEAD_SHA:0:12}" >&2
        tree_mismatch=1
    fi
done <<<"$PUSHED_REFS"
if (( publishes )) && ! git diff --quiet HEAD --; then
    printf '\nERROR pre-push: the tracked tree differs from HEAD, so the gates would\n' >&2
    printf 'pre-push: judge edits this push does not publish:\n' >&2
    git diff --name-only HEAD -- | sed 's/^/      /' >&2
    tree_mismatch=1
fi
if (( tree_mismatch )); then
    printf '\npre-push: push from a checkout whose HEAD is the pushed commit and whose\n' >&2
    printf 'pre-push: tracked tree is clean (commit or stash the edits, or push HEAD).\n' >&2
    exit 1
fi

# ── Where the gates run.
#
# The hook used to start the runner in place, so every gate a push selected
# ran on this workstation and bx, which decides where heavy work goes, never
# saw it. Measured 2026-10-20: one push took 46 minutes here, with the Gradle
# daemon at 450% CPU and 15 GB of swap in use, while the build machines idled.
#
# `$BX` is the opt-in, and only its NAME lives in the tree: the path is this
# machine's, set in its environment. Unset, the runner starts here as before.
# Set, bx decides where the runner goes and says why; it falls back to this
# machine by itself when no build machine can take the run. Its refusals (an
# untracked file, a tree the far side does not agree with) are verdicts about
# this checkout, so the hook adds no fallback of its own: running the gates
# here after bx refused would answer a question bx already answered.
#
# One bx call carries the whole run, so the tree crosses once and the gates
# share the far side's build products. Each gate computes its verdict where it
# runs, which is also where any tree it regenerates is compared. Nothing is
# piped: bx's exit status is the runner's.
run_gates() {
    if [[ -n "${BX:-}" && -x "${BX}" ]]; then
        "$BX" --label pre-push -- scripts/gate "$@"
    else
        "$RUNNER" "$@"
    fi
}

if [[ "${PREPUSH_FULL:-0}" == "1" ]]; then
    printf '\n==> pre-push: PREPUSH_FULL=1 — running every gate\n' >&2
    full_rc=0
    run_gates --all || full_rc=$?
    exit "$full_rc"
fi

# git feeds `<local ref> <local sha> <remote ref> <remote sha>` per pushed
# ref on stdin. Union the changed paths over every ref in the push.
#
# Each ref yields a commit range as well as its paths. The runner is handed
# the ranges (`--changed-in`), which mean the same thing on whichever machine
# bx sends it to; the path list stays here for the notices at the end, which
# this machine prints.
ZERO="0000000000000000000000000000000000000000"
CHANGED_FILE="$(mktemp)"
trap 'rm -f "$CHANGED_FILE"' EXIT
RANGE_ARGS=()

saw_ref=0
force_full=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ -z "${local_sha:-}" ]] && continue
    saw_ref=1
    # Branch deletion: nothing of ours is being added.
    [[ "$local_sha" == "$ZERO" ]] && continue
    if [[ "$remote_sha" == "$ZERO" ]]; then
        # New branch — diff against whatever it forked from. If that cannot
        # be resolved, fall back to the full run rather than guessing a range.
        base="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || true)"
        if [[ -z "$base" ]]; then
            force_full=1
            continue
        fi
    else
        base="$remote_sha"
    fi
    git diff --name-only "$base" "$local_sha" >>"$CHANGED_FILE"
    RANGE_ARGS+=(--changed-in "${base}..${local_sha}")
done <<<"$PUSHED_REFS"

# githooks(5): git writes one line per ref it is about to push. No lines
# therefore means there is nothing to push — an already-up-to-date `git
# push`, which git still invokes the hook for. Treating that as "range
# unknown, verify everything" made a no-op push run the entire suite, the
# exact opposite of what path scoping exists for. Nothing to push is nothing
# to verify.
#
# The same applies to a by-hand invocation with no stdin: there is no range
# to derive, so there is nothing to check. `PREPUSH_FULL=1` is the way to
# run the suite deliberately, and `scripts/gate` is the way to run part of
# it.
if (( ! saw_ref )); then
    printf '\n==> pre-push: no refs to push — nothing to verify\n' >&2
    exit 0
fi

# Not `exec` past this point: the EXIT trap above owns the temp file, and
# exec replaces the shell without running it.
if (( force_full )); then
    printf '\n==> pre-push: push range unresolvable — running every gate\n' >&2
    full_rc=0
    run_gates --all || full_rc=$?
    exit "$full_rc"
fi

# Every ref was a deletion: refs went out, commits did not, and a runner
# handed no range has nothing to select from.
if (( ${#RANGE_ARGS[@]} == 0 )); then
    printf '\n==> pre-push: the push publishes no commits — nothing to verify\n' >&2
    exit 0
fi

sort -u "$CHANGED_FILE" -o "$CHANGED_FILE"
printf '\n==> pre-push: %s changed path(s)\n' \
    "$(wc -l <"$CHANGED_FILE" | tr -d ' ')" >&2

# `|| gate_rc=$?` rather than a bare call plus `$?`: `set -e` is on, so a
# failing runner would end the script before the assignment ran and the
# exit status below would never be reached.
gate_rc=0
run_gates "${RANGE_ARGS[@]}" || gate_rc=$?

# What this push did NOT verify, said out loud.
#
# `ci_only` keeps the push inside its budget by handing whole gates to CI,
# and the failure mode of that trade is silence: four CI lanes on this
# repository stayed red for five to eight pushes because nothing said they
# were now the only thing looking. Printing the delegation names the
# outstanding verdicts and the workflow that owns each, in the terminal
# where the decision was made.
#
# Only on the path-scoped branch: `--all` above runs the ci_only gates too,
# so on those branches nothing is owed. Failures here are swallowed — a
# registry that cannot answer must not turn a passing push into a failing
# one, since this paragraph is a notice and not a gate.
if (( gate_rc == 0 )); then
    OWED="$(python3 "$REPO_ROOT/tools/git-hooks/gate_registry.py" \
                --changed-from "$CHANGED_FILE" --ci-owed 2>/dev/null || true)"
    if [[ -n "$OWED" ]]; then
        printf '\n==> pre-push: handed to CI, not run here:\n' >&2
        while read -r slug workflow; do
            [[ -z "$slug" ]] && continue
            printf '      %-22s %s\n' "$slug" "$workflow" >&2
        done <<<"$OWED"
        printf '    Read them before building on this push.\n' >&2
    fi

    # The residue of the line above, and the half that can actually lose a
    # verdict. `--ci-owed` names gates CI will run; these are gates the
    # change REACHES that neither the push nor CI will run, because a
    # workflow's `paths:`/`paths-ignore:` filter keeps it from starting.
    # That is often correct — a README cannot break a C++ ctest suite — and
    # the point is only that it is said here rather than inferred later from
    # a lane that quietly stopped reporting. A notice, like the block above:
    # failures swallowed, `gate_rc` untouched.
    UNOWED="$(python3 "$REPO_ROOT/tools/git-hooks/gate_registry.py" \
                  --changed-from "$CHANGED_FILE" --ci-unowed 2>/dev/null || true)"
    if [[ -n "$UNOWED" ]]; then
        printf '\n==> pre-push: reached but run by NOBODY (filtered out of CI):\n' >&2
        while read -r slug workflow; do
            [[ -z "$slug" ]] && continue
            printf '      %-22s %s\n' "$slug" "$workflow" >&2
        done <<<"$UNOWED"
        printf '    If one of these can see this change, its filter is wrong.\n' >&2
        printf '    A path no rule classifies reaches EVERY gate, so on that\n' >&2
        printf '    branch the list is wide by construction — read it against\n' >&2
        printf '    the selection reason above before treating it as loss.\n' >&2
    fi
fi

exit $gate_rc
