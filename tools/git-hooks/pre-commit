#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-2.1-or-later WITH LicenseRef-SCE-Linking-Exception OR LicenseRef-SCE-Commercial
#
# SCE pre-commit hook: run cheap mechanical checks that should fail at
# commit time rather than at push time, so the offending content never
# lands in the local history. The rustfmt gate moved down from the
# pre-push hook Stage 0 (2026-05-23) so a developer who commits before
# running `cargo fmt --all` learns immediately, not at `git push` time
# after every other check has already run.
#
# Gates:
#   0. cargo fmt --all --check               — mirrors CI rustfmt gate
#                                              (reproduces the 2026-05-20
#                                              fmt-drift CI fail-mode)
#   1. clang-format staged C/C++ check       — mirrors CI clang-format
#                                              gate via the shared
#                                              scripts/check_clang_format.sh
#   2. commit-audit backstop                 — re-runs .claude/hooks/
#                                              commit_audit.sh at the git
#                                              layer (see below)
#   3. staged citation existence             — the hallucination half of the
#                                              `ledger-citations` gate, scoped
#                                              to the staged content (see
#                                              below)
#
# Why this stage exists (2026-06-03, rescoped 2026-08-10):
# commit_audit.sh started as a Claude Code *PreToolUse* hook, which the
# harness runs before a Bash tool call. That layer is not
# git-guaranteed: a piped or compound `git commit ... | grep ...` was
# observed to slip past it entirely, and it is absent for a commit made
# from a terminal or an editor. git ALWAYS runs this hook, so the
# diff-based gates (arch violation, unconsumed filter, memory-lifecycle)
# run here. We feed commit_audit.sh a synthesized `git commit` payload
# with no -m, so the message-based format/forward-ref checks self-skip —
# those belong to `commit-msg`, which git hands the final message.
#
# The PreToolUse registration was removed on 2026-08-10 along with the
# self-audit answer-file gate: the audit lived under `.git/`, a Claude
# Code protected path that `permissions.allow` rules cannot pre-approve,
# so it prompted on every commit while its own effect stayed unmeasured
# (583 answer files, 69 of them byte-identical copies). Every check that
# had measured effect now runs from a git hook instead.
#
# Bypass (for genuine emergencies): `SKIP_PRECOMMIT=1 git commit ...`.
# Do not skip hooks by habit — the rustfmt gate runs in <1s and prevents
# fmt-only follow-up commits.

set -euo pipefail

if [[ "${SKIP_PRECOMMIT:-0}" == "1" ]]; then
    echo "pre-commit: SKIP_PRECOMMIT=1 — bypassing local fmt gate" >&2
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

log_step() { printf '\n==> pre-commit: %s\n' "$1" >&2; }
fail_step() { printf '\nERROR pre-commit: %s FAILED — commit aborted.\n  Run `cargo fmt --all` locally, re-stage the touched files, and retry.\n  Bypass with SKIP_PRECOMMIT=1 for emergencies.\n' "$1" >&2; exit 1; }

# ── Stage 0: cargo fmt --all --check ──────────────────────────────
# Mirror CI's `.github/workflows/rust-ci.yml` cargo fmt gate at
# commit time instead of push time. Reproduces the 2026-05-20 CI
# fail-mode where 488 files of accumulated rustfmt drift survived
# past the hook because no previous stage exercised rustfmt; running
# at commit time means fmt-only fix-up commits never land in local
# history.
log_step "Stage 0/3 — cargo fmt --all -- --check (mirrors CI fmt gate)"
cargo fmt --all -- --check \
    || fail_step "Stage 0 (cargo fmt --all --check)"

# ── Stage 1: clang-format on staged C/C++ files ───────────────────
# Mirror CI's clang-format-check.yml at commit time, scoped to the
# staged C/C++ files so a drifted-but-untouched file elsewhere never
# blocks an unrelated commit. Enumeration and the generated-source
# skip policy live in scripts/check_clang_format.sh (shared with CI —
# single source of truth). Skipped with a diagnostic when clang-format
# is not installed; the CI gate stays the authoritative enforcement
# point, matching the rustfmt doctrine above.
log_step "Stage 1/3 — clang-format --dry-run on staged C/C++ files"
mapfile -t staged_cxx < <(git diff --cached --name-only --diff-filter=ACMR \
    -- '*.c' '*.cc' '*.cpp' '*.h' '*.hpp')
if [[ ${#staged_cxx[@]} -eq 0 ]]; then
    echo "pre-commit: no staged C/C++ files — clang-format check skipped." >&2
elif ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format not on PATH; skipping (CI gate still runs)." >&2
else
    if ! "$REPO_ROOT/scripts/check_clang_format.sh" "${staged_cxx[@]}"; then
        printf '\nERROR pre-commit: Stage 1 (clang-format) FAILED — commit aborted.\n  Run `clang-format -i` on the files above, re-stage, and retry.\n  Bypass with SKIP_PRECOMMIT=1 for emergencies.\n' >&2
        exit 1
    fi
fi

# ── Stage 2: commit-audit backstop ────────────────────────────────
# Re-run the Claude Code commit-audit hook at the git layer so a commit
# can never land without its audit-answer file even when the PreToolUse
# layer is gone entirely. Reuses the exact same script — no logic
# duplication. The synthesized payload carries a bare `git commit`
# command (no -m), so message-based checks self-skip while the
# diff/state gates run against the real staged index.
log_step "Stage 2/3 — staged-diff gates (.claude/hooks/commit_audit.sh)"
AUDIT_HOOK="$REPO_ROOT/.claude/hooks/commit_audit.sh"
if [[ -x "$AUDIT_HOOK" ]]; then
    AUDIT_PAYLOAD="$(REPO_ROOT="$REPO_ROOT" python3 -c \
        'import json, os; print(json.dumps({"tool_input": {"command": "git commit"}, "cwd": os.environ["REPO_ROOT"]}))')"
    if ! printf '%s' "$AUDIT_PAYLOAD" | "$AUDIT_HOOK"; then
        printf '\nERROR pre-commit: a staged-diff gate blocked this commit.\n  Resolve the banner printed above, then re-run the commit.\n  Bypass with SKIP_PRECOMMIT=1 for genuine emergencies.\n' >&2
        exit 1
    fi
else
    printf 'pre-commit: commit-audit hook not found at %s — backstop skipped.\n' "$AUDIT_HOOK" >&2
fi

# ── Stage 3: staged citation existence ────────────────────────────
# The hallucination half of the `ledger-citations` gate, run over the
# staged content instead of the whole tree.
#
# The full gate lives at push and costs ~110s alone, of which 108.9s is the
# validator's whole-tree symbol resolution — which cannot be scoped to
# a diff, so the binding axes stay there. Existence can: whether a cited
# section exists is decidable from the staged file alone, and it is the
# class this repo has produced twice. Both times the report arrived at
# push, naming a batch rather than a commit: thirteen cites over four
# commits (2026-08-10) and a fabricated `§synth-F4` a whole round after
# the commit that wrote it (2026-08-11).
#
# The gate script owns the scope, so commit time and push time cannot
# come to disagree about which trees are covered.
log_step "Stage 3/3 — staged citation existence (scripts/gates/ledger-citations.sh --staged)"
CITE_GATE="$REPO_ROOT/scripts/gates/ledger-citations.sh"
if [[ -x "$CITE_GATE" ]]; then
    if ! "$CITE_GATE" --staged; then
        printf '\nERROR pre-commit: Stage 3 (staged citation existence) FAILED — commit aborted.\n  Resolve each citation against the ledger, then correct the number.\n  Do NOT migrate a bad number to §-form to silence it.\n  Bypass with SKIP_PRECOMMIT=1 for genuine emergencies.\n' >&2
        exit 1
    fi
else
    printf 'pre-commit: citation gate not found at %s — stage skipped.\n' "$CITE_GATE" >&2
fi

printf '\npre-commit: all gates passed — commit allowed.\n' >&2
