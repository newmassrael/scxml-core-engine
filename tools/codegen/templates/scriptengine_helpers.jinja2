    // Helper: Ensure session ID is initialized
    //
    // W3C SCXML C.1: an invoked child adopts the id its parent recorded for
    // it. The parent mints `parentSession.invokeId` and keys `activeInvokes_`
    // on it, so an event from this child arrives at the parent carrying that
    // id as its origin; if the child also minted an address-of-this id for
    // its own script session, the location it publishes in `_ioprocessors`
    // and the origin the parent sees would be two names for one session that
    // can never be compared — which is exactly what C.1 requires of them.
    void ensureSessionId() const {
        if (!sessionId_.has_value()) {
{% if model.needs_parent_template %}
            sessionId_ = childSessionId_.empty()
                             ? "session_" + std::to_string(reinterpret_cast<uintptr_t>(this))
                             : childSessionId_;
{% else %}
            sessionId_ = "session_" + std::to_string(reinterpret_cast<uintptr_t>(this));
{% endif %}
        }
    }

{% if model.needs_script_engine %}
    // W3C SCXML B.1: per-instance script engine handle, set before initialize()
    // via setScriptEngine(). Mirrors the Kotlin StateMachineEngine(scriptEngine)
    // constructor-injection contract — generated machines never reach back into
    // a process-global singleton.
    mutable ::std::shared_ptr<::SCE::IScriptEngine> scriptEngine_;

    void setScriptEngine(::std::shared_ptr<::SCE::IScriptEngine> engine) const {
        scriptEngine_ = ::std::move(engine);
    }

    ::SCE::IScriptEngine& getScriptEngine() const {
        if (!scriptEngine_) {
            throw ::std::runtime_error(
                "{{ model.name }}Policy::getScriptEngine: "
                "setScriptEngine() must be called before initialize()");
        }
        return *scriptEngine_;
    }

    // §scxml-C-2-3: inbound BasicHTTP endpoint serving this machine, declared
    // by the deployment before initialize(). Empty means no such endpoint is
    // deployed, and no BasicHTTP entry is published.
    mutable ::std::string basicHttpAccessUri_;

    void setBasicHttpAccessUri(::std::string accessUri) const {
        basicHttpAccessUri_ = ::std::move(accessUri);
    }

    // Helper: Ensure JSEngine is initialized (lazy initialization)
    void ensureScriptEngine() const {
        if (scriptEngineInitialized_) return;
        ensureSessionId();
        if (!sessionId_.has_value()) return;
        auto& scriptEngine = getScriptEngine();
        scriptEngine.createSession(sessionId_.value());

        // §scxml-C-1-1 / §scxml-C-2-3: the `_ioprocessors` entries come from the
        // same helper the Interpreter uses, so a machine reads the same entry
        // names and the same addresses whichever engine runs it.
        auto ioProcessors = ::SCE::IOProcessorHelper::build(sessionId_.value(), basicHttpAccessUri_);
        auto setupResult = scriptEngine.setupSystemVariables(sessionId_.value(), "{{ model.scxml_name | default('') | w3c_session_name(model.name) | escape_cpp }}", ioProcessors).get();
        if (!setupResult.isSuccess()) {
            SCE_LOG_ERROR("AOT ensureScriptEngine: Failed to setup system variables: {}", setupResult.getErrorMessage());
        }

{% for var in model.variables %}
{% if var.expr %}
        auto initExpr_{{ var.id }} = scriptEngine.evaluateExpression(sessionId_.value(), {{ var.expr | to_script_source_expr }}).get();
        if (!::SCE::ScriptResultUtils::isSuccess(initExpr_{{ var.id }})) {
            SCE_LOG_ERROR("Failed to evaluate expression for variable: {{ var.id }}");
        } else {
            scriptEngine.setVariable(sessionId_.value(), "{{ var.id }}", initExpr_{{ var.id }}.getInternalValue());
        }
{% elif var.content %}
        auto initExpr_{{ var.id }} = scriptEngine.evaluateExpression(sessionId_.value(), {{ var.content | to_script_source_data_content }}).get();
        if (!::SCE::ScriptResultUtils::isSuccess(initExpr_{{ var.id }})) {
            SCE_LOG_ERROR("Failed to evaluate expression for variable: {{ var.id }}");
        } else {
            scriptEngine.setVariable(sessionId_.value(), "{{ var.id }}", initExpr_{{ var.id }}.getInternalValue());
        }
{% elif var.type == 'runtime' %}
        auto initExpr_{{ var.id }} = scriptEngine.evaluateExpression(sessionId_.value(), "undefined").get();
        if (!::SCE::ScriptResultUtils::isSuccess(initExpr_{{ var.id }})) {
            SCE_LOG_ERROR("Failed to evaluate expression for variable: {{ var.id }}");
        } else {
            scriptEngine.setVariable(sessionId_.value(), "{{ var.id }}", initExpr_{{ var.id }}.getInternalValue());
        }
{% endif %}
{% endfor %}

{% if model.has_parallel_states or model.uses_in_predicate %}
        // W3C SCXML 5.9.2: Register state query callback for In() predicate support
        // ARCHITECTURE.md All-or-Nothing Strategy: Static AOT engines cannot hold StateMachine*
        // pointers (no base class). Callback mechanism provides In() capability while maintaining
        // compile-time static structure. isStateActive() uses InPredicateHelper for shared logic.
        scriptEngine.setStateQueryCallback(
            [this](const std::string& stateId) { return this->isStateActive(stateId); },
            sessionId_.value()
        );
        AOT_DEBUG("AOT ensureScriptEngine: Registered state query callback for In() predicate");
{% endif %}

        scriptEngineInitialized_ = true;
    }

    // ARCHITECTURE.MD: Zero Duplication - Use DataModelInitHelper (shared with Interpreter)
    // W3C SCXML 5.2/5.3: Initialize datamodel and raise error.execution if failed
    // Called during StaticExecutionEngine::initialize() to ensure proper error event timing
    template <typename Engine>
    void initializeDataModel([[maybe_unused]] Engine& engine) {
        if (scriptEngineInitialized_) return;
        ensureSessionId();
        if (!sessionId_.has_value()) return;
        auto& scriptEngine = getScriptEngine();
        scriptEngine.createSession(sessionId_.value());

        // §scxml-C-1-1 / §scxml-C-2-3: the `_ioprocessors` entries come from the
        // same helper the Interpreter uses, so a machine reads the same entry
        // names and the same addresses whichever engine runs it.
        auto ioProcessors = ::SCE::IOProcessorHelper::build(sessionId_.value(), basicHttpAccessUri_);
        auto setupResult = scriptEngine.setupSystemVariables(sessionId_.value(), "{{ model.scxml_name | default('') | w3c_session_name(model.name) | escape_cpp }}", ioProcessors).get();
        if (!setupResult.isSuccess()) {
            SCE_LOG_ERROR("AOT initializeDataModel: Failed to setup system variables: {}", setupResult.getErrorMessage());
        }
{% if not model.variables and not (model.states.values() | selectattr('datamodel') | list) and not model.global_scripts %}
        // No variables or scripts to initialize
{% endif %}

{% for var in model.variables %}
{% if var.src %}
        // W3C SCXML 5.2.2: Load datamodel variable from external file
        // ARCHITECTURE.md: basePath resolved from executable location for execution independence
        ::SCE::DataModelInitHelper::initializeVariableFromSrc(
            scriptEngine, sessionId_.value(), "{{ var.id }}", "{{ var.src }}",
            ::SCE::DataModelInitHelper::resolveExecutableBasePath("{{ base_path }}"),
            [&engine](const ::std::string& msg) {
                engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, msg));
            });
{% elif var.expr %}
{# ARCHITECTURE.md: Zero Duplication - Function detection matches DataModelInitHelper::isFunctionExpression() #}
{# W3C SCXML B.2: Template-time detection (Python) for code generation optimization #}
{% set is_function_expr = var.expr.strip().startswith('function') %}
{% if is_function_expr %}
        // W3C SCXML B.2: For function expressions, use direct JavaScript assignment to preserve function type
        // Test 453: ECMAScript function literals must be stored as functions, not converted to C++
        // ARCHITECTURE.md Zero Duplication: Matches Interpreter behavior (StateMachine.cpp:1615-1635)
        {
            auto scriptResult = scriptEngine.executeScript(sessionId_.value(), {{ var.expr | to_script_source_assignment(var.id) }}).get();
            if (!::SCE::ScriptResultUtils::isSuccess(scriptResult)) {
                std::string errorMsg = "Failed to assign function expression for '{{ var.id }}'";
                SCE_LOG_ERROR("AOT initializeDataModel: {}", errorMsg);
                engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, errorMsg));
            }
            AOT_DEBUG("AOT initializeDataModel: Initialized function variable '{{ var.id }}'");
        }
{% else %}
        // W3C SCXML 5.2/5.3: Use initializeVariableFromExpr for expr attribute
        // Test 277: expr evaluation failure must raise error.execution (no fallback)
        ::SCE::DataModelInitHelper::initializeVariableFromExpr(
            scriptEngine, sessionId_.value(), "{{ var.id }}", {{ var.expr | to_script_source_expr }},
            [&engine](const ::std::string& msg) {
                engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, msg));
            });
{% endif %}
{% elif var.content %}
        // W3C SCXML B.2: Initialize with inline XML content (DOM creation)
        ::SCE::DataModelInitHelper::initializeVariable(
            scriptEngine, sessionId_.value(), "{{ var.id }}", {{ var.content | to_script_source_data_content }},
            [&engine](const ::std::string& msg) {
                engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, msg));
            });
{% elif var.type == 'runtime' %}
        // W3C SCXML 5.2: Runtime datamodel variable (late binding)
        ::SCE::DataModelInitHelper::initializeVariable(
            scriptEngine, sessionId_.value(), "{{ var.id }}", "",
            [&engine](const ::std::string& msg) {
                engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, msg));
            });
{% endif %}
{% endfor %}

{% if model.states.values() | selectattr('datamodel') | list %}
{% if model.binding == 'early' %}
        // W3C SCXML 5.3: Early binding - Initialize state-level datamodel variables at startup
        // All datamodel variables are globally accessible regardless of state entry
        // ARCHITECTURE.md Zero Duplication: Uses datamodel_macros.jinja2 (DRY principle)
{% import 'datamodel_macros.jinja2' as dm %}
{% for state_id, state in model.states | dictsort %}
{% if state.datamodel %}
        // State {{ state_id }} datamodel variables
{{ dm.initialize_state_datamodel(state, state_id, "AOT initializeDataModel", base_path) }}
{% endif %}
{% endfor %}
{% else %}
        // W3C SCXML 5.9: Late binding - State datamodel variables initialized on state entry
        // Variables are NOT initialized here, but in executeEntryActions() for each state
        // ARCHITECTURE.md Zero Duplication: Uses datamodel_macros.jinja2 (DRY principle)
{% endif %}
{% endif %}

{% if model.global_scripts %}
        // W3C SCXML 5.8: Execute global (top-level) scripts at document load time
        // ARCHITECTURE.md Zero Duplication: Matches Interpreter behavior (StateMachine.cpp execution order)
        // Execution order: datamodel init → global scripts → state machine start
{% for script in model.global_scripts %}
        {
            auto scriptResult = scriptEngine.executeScript(sessionId_.value(), {{ script.content | to_script_source_script }}).get();
            if (!::SCE::ScriptResultUtils::isSuccess(scriptResult)) {
                std::string errorMsg = "Global script execution failed";
                SCE_LOG_ERROR("W3C SCXML 5.8: {}", errorMsg);
                engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, errorMsg));
            }
        }
{% endfor %}
{% endif %}

{% if model.has_parallel_states or model.uses_in_predicate %}
        // W3C SCXML 5.9.2: Register state query callback for In() predicate support
        // ARCHITECTURE.md All-or-Nothing Strategy: Static AOT engines cannot hold StateMachine*
        // pointers (no base class). Callback mechanism provides In() capability while maintaining
        // compile-time static structure. isStateActive() uses InPredicateHelper for shared logic.
        scriptEngine.setStateQueryCallback(
            [this](const std::string& stateId) { return this->isStateActive(stateId); },
            sessionId_.value()
        );
        AOT_DEBUG("AOT initializeDataModel: Registered state query callback for In() predicate");
{% endif %}

        scriptEngineInitialized_ = true;
    }
{% endif %}
