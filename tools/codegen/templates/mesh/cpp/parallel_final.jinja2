{# SCE_MESH.md §14 rule 12 — per-`<parallel>` partition-role branch.  #}
{# Inherited context: `state`, `state_id`, `model`.                   #}
{# `model.partition_parallel_roles` maps `<parallel>` id → role       #}
{# (Root / NonRoot / SinglePartition). Absent id ⇒ treat as           #}
{# SinglePartition — byte-identical to pre-mesh AOT codegen.          #}
{% set _parallel_id = model.states[state.parent].parent %}
{% set _role = model.partition_parallel_roles.get(_parallel_id) if model.partition_parallel_roles else None %}
{% if _role == 'Root' %}
                // SCE_MESH.md §14 rule 12 / §16.5 Root branch: the
                // root-hosting partition aggregates local region
                // completions and remote `ParallelRegionDone` envelopes
                // (wire 21) into the per-`<parallel>` tracker. Remote
                // delivery lands via `engine.onParallelRegionDone(env)`
                // (see `{{ model.name }}::onParallelRegionDone`);
                // threshold raises `done.state.<parallel>` into the
                // SM's local external queue via the tracker's callback.
                engine.tracker_{{ _parallel_id }}_.onLocalRegionComplete("{{ state.parent }}");
{% elif _role == 'NonRoot' %}
                // SCE_MESH.md §14 rule 12 / §16.5 NonRoot branch: a
                // partition hosting the region but not the
                // `<parallel>` root emits wire 21 `ParallelRegionDone`
                // with `subject = <parallel>/<region>` and does NOT
                // raise `done.state.<parallel>` locally (the root will
                // raise it on threshold). The actual inter-partition
                // transport routing is delegated to
                // `engine.sendParallelRegionDone` on the SM class.
{% if state.donedata %}
                engine.sendParallelRegionDone("{{ _parallel_id }}", "{{ state.parent }}", eventData);
{% else %}
                engine.sendParallelRegionDone("{{ _parallel_id }}", "{{ state.parent }}", std::string());
{% endif %}
{% else %}
                // SCE_MESH.md §14 rule 12 SinglePartition fallback:
                // all regions of `<parallel>` live in one partition —
                // equivalent to monolithic execution — so the legacy
                // `ParallelCompletionHelper` path applies unchanged.
                // W3C SCXML 3.4: Check if parent's parent (parallel state) is complete
                // W3C SCXML 3.7.1: Generate done.state event when all regions reach final states
                // Uses ParallelCompletionHelper (Zero Duplication - shared with Interpreter)
                {
                    const auto parallelState = State::{{ model.states[state.parent].parent | capitalize }};
                    AOT_DEBUG("Checking parallel state {} completion after region {} final",
                             static_cast<int>(parallelState), "{{ state.parent }}");

                    // W3C SCXML 3.4: Use shared Helper (ARCHITECTURE.md Zero Duplication Principle)
                    if (::SCE::Core::ParallelCompletionHelper::areAllRegionsInFinal<State, {{ model.name }}Policy>(
                            parallelState, activeStates_)) {
                        AOT_DEBUG("All regions of parallel state {} are complete, generating done.state event",
                                 static_cast<int>(parallelState));
                        engine.raise(typename Engine::EventWithMetadata(Event::Done_state_{{ model.states[state.parent].parent }}));
                    }
                }
{% endif %}

