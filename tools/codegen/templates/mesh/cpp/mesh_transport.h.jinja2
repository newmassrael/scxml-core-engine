{# ── (D2b) Session pool — every SCXML document instance running
   under this router is a session (W3C SCXML §2.4). Non-pool routers
   host exactly one session; `server.instances:` pool routers host
   N independent sessions each backing one offered SOME/IP instance
   (SCE_MESH.md §14.4). `sessions_` is the single source of truth for
   dispatch — no parallel sender-alias shim. Sessions are stored as raw
   pointers in a fixed-size array so the template can preserve the
   existing `has_per_target_field` declaration order (reorder with
   local targets is -Wreorder-sensitive) while staying allocation-free.
   Emitted unconditionally: every mesh router installs the outbound
   mesh-send callback in its ctor, which needs at least one session
   handle to bind against. Pure-shm routers run with N_SESSIONS == 1
   and have no inbound dispatch surface; pool routers size N to the
   offered-instance count. ── #}
    // Session pool. One entry per SCXML document instance hosted by this
    // router; N_SESSIONS is 1 for every router except a SOME/IP server
    // pool (SCE_MESH.md §14.4), which offers N distinct vsomeip instances
    // backed by N independent sessions indexed identically to
    // SOMEIP_SERVER_INSTANCES.
    //
    // Thread-safety: the ctor completes-then-publishes the router before
    // init() spawns any transport callback threads, so the array write
    // (ctor initializer) happens-before any read (callback thread
    // dispatch) per C++ §32.4.2. Pointers are const after construction.
    //
    // Lifetime contract (caller-enforced):
    //   every sessions_[i]  MUST outlive TransportRouter
    //   TransportRouter     MUST outlive any inflight transport operations
    //
    // The second part is honored by shutdown():
    //   - vsomeip::application::stop() joins callback threads before return
    //   - zenoh::Session dtor (via zenoh_session_.reset()) blocks until
    //     all query reply/subscription callbacks finish (z_close semantics)
    // so once shutdown() returns, no callback can still be dispatching
    // through any sessions_[i]. Violating the first part (destroying
    // session pointees before the router) is a caller bug — the codegen
    // cannot enforce it and there is no runtime check for it.
    //
    // Nullability: the ctor accepts `std::array<SenderEngine*, N_SESSIONS>`
    // and the conventional call-site form `router({&engineA, &engineB})`
    // produces non-null pointers because the `&` operator binds to named
    // objects only. Passing `nullptr` is a caller bug; the array is not
    // probed for null.
    static constexpr std::size_t N_SESSIONS = {{ n_sessions }};
    std::array<SenderEngine*, N_SESSIONS> sessions_;
{% if has_server_someip %}
    // Map a SOME/IP instance id to the sessions_ slot that hosts it.
    // The inbound server-handler lambdas capture `server_instance`
    // (bound by the for-loop over SOMEIP_SERVER_INSTANCES in init())
    // and call this helper to route every decoded envelope to the
    // specific SCXML session whose offered instance received it. Linear
    // find is O(N_SESSIONS); N is the pool cardinality (deploy.yaml
    // `server.instances:`), typically ≤ 8. A miss returns
    // `N_SESSIONS` as a sentinel — reachable only if vsomeip dispatched
    // for an instance not in the declared set (codegen/deployment
    // drift), in which case the caller logs and drops (SCE_MESH.md
    // §14.4).
    static constexpr std::size_t session_index_for_instance(
        vsomeip::instance_t instance) {
        for (std::size_t i = 0; i < SOMEIP_SERVER_INSTANCES.size(); ++i) {
            if (SOMEIP_SERVER_INSTANCES[i] == instance) return i;
        }
        return N_SESSIONS;
    }
{% endif %}

    // SCE_MESH.md §10.9: router-scoped routing identity. Generated once
    // at construction (UUID v7) and stamped on every outbound envelope's
    // `routing_id` field. Self-filter sites (Zenoh server put-subscriber
    // echo, prospective multi-instance echo paths) compare `env.routing_id`
    // against this member to distinguish "message from a different router
    // hosting the same machine name" (pass through) from "our own wire
    // echo" (drop). Declared const so the ctor initializer is the SSoT
    // and the value cannot be rebound across a router's lifetime.
    //
    // Pool scope (SCE_MESH.md §14.4): a pool router hosts N sessions
    // that share this single routing_id. Self-echo filtering is a
    // router-level property (one transport session per router on each
    // backend), so sibling sessions within the same router are not
    // distinguishable via `routing_id` — the current self-echo sites
    // (Zenoh server put-sub) are invoked only under deployments that
    // do not combine pool with Zenoh, which keeps the router-scoped
    // identity sufficient for every currently supported shape.
    //
    // Unconditional — the mesh-send-callback body (which stamps this
    // field) is itself unconditional: even an shm-only router installs
    // `setMeshSendCallback` on each session and stamps `routing_id` on
    // each outbound envelope, so the member must exist regardless of
    // whether inbound dispatch surfaces are emitted.
    const SCE::uuid::Bytes routing_id_;

{# ── (D2c) Correlation types + SOME/IP RPC correlation table ── #}
{# CorrelationKey/Hash: needed by client SOME/IP correlation AND/OR
   server pending-request storage. Emitted once under a shared guard. #}
{% if needs_correlation_key %}
    struct CorrelationKey {
        std::array<uint8_t, 16> id;
        bool operator==(const CorrelationKey& o) const { return id == o.id; }
    };
    struct CorrelationKeyHash {
        std::size_t operator()(const CorrelationKey& k) const noexcept {
            constexpr std::size_t FNV_OFFSET = 0xcbf29ce484222325ULL;
            constexpr std::size_t FNV_PRIME  = 0x00000100000001B3ULL;
            std::size_t h = FNV_OFFSET;
            for (auto b : k.id) {
                h ^= static_cast<std::size_t>(b);
                h *= FNV_PRIME;
            }
            return h;
        }
    };
{% endif %}
{% if "someip" in transport_types %}
    // Client SOME/IP RPC correlation: maps correlation_id → reply event name.
    std::mutex correlation_mutex_;
    std::unordered_map<CorrelationKey, std::string, CorrelationKeyHash> pending_rpcs_;
{% endif %}

{# ── (D2d) sce:mesh-rpc invoke bookkeeping (SCE_MESH.md §9.5) ── #}
{% if has_mesh_rpc.v %}
    // invoke_correlation_: 16-byte UUID → deliver callback. Fires at
    // most once per registration, on RpcReply, deadline, or never (on
    // cancel). Correlates mesh-rpc replies back to their originating
    // invoke so the sender engine can raise done.invoke.<id> /
    // error.invoke.<id> with the right EventWithMetadata.invokeId.
    SCE::Mesh::InvokeCorrelation invoke_correlation_;
{% endif %}

{% if has_mesh_rpc.v or has_server_query_timeout or has_any_retry.v %}
    // deadline_scheduler_: callback-based timer shared by three paths:
    //   - Client-side (`has_mesh_rpc.v`, §9.5): fires
    //     `invoke_correlation_.handleDeadline(uuid)` after
    //     `_mesh_deadline_ms`, delivering `error.invoke.<id>` via the
    //     deliver callback registered below.
    //   - Server-side (`has_server_query_timeout`, gap Z2): fires
    //     `onServerQueryTimedOut(cid)` after the deploy.yaml
    //     `server.query_timeout_ms`, erasing the stranded
    //     `pending_server_queries_` entry.
    //   - SCE Mesh §16.7 row 3 (`has_any_retry.v`): fires
    //     `RetryingDispatcher::onRetryFire(envelope_id)` after each
    //     backoff interval, triggering the next retry attempt or the
    //     final DELIVERY_EXHAUSTED raise. The envelope id is a
    //     16-byte UUIDv7 from `MeshEnvelope.id`, which never aliases
    //     mesh-rpc invoke ids or server correlation ids.
    // Safety: the scheduler's key space is 16-byte UUIDv7, which is
    // globally unique by construction. Client `invoke_id`, server
    // `CorrelationKey.id`, and outbound `MeshEnvelope.id` never alias
    // inside the shared namespace, so a single scheduler instance
    // covers all three roles. Destructor joins the timer thread; see
    // MeshDeadlineScheduler header for shutdown semantics.
    SCE::Mesh::MeshDeadlineScheduler deadline_scheduler_;
{% endif %}

{% if has_mesh_rpc.v %}
    // active_invokes_: (target, fieldSuffix) → ActiveInvokeRecord.
    // The state-entry callback tracks UUIDs here so state-exit cancel
    // (performMeshCancel) can erase the matching correlation entry
    // without the state machine itself managing UUID storage. Mutex
    // guards concurrent enter/exit from the engine thread against
    // transport callback threads that might fire handleReply in
    // parallel and mutate no shared state (handleReply only touches
    // invoke_correlation_, which has its own mutex).
    //
    // Two-uuid record (SCE_MESH.md §16.7 row 3 follow-up): the
    // invoke deadline (`deadline_scheduler_`) keys off `invoke_uuid`,
    // whereas the per-target retry layer (`RetryingDispatcher`)
    // keys off `envelope_uuid` (== `env.id`). The two key spaces
    // were aliased in the row 3 atomic — both were assigned the
    // same uuid in invokeMeshRpc, so the retry layer's own
    // `registerDeadline(env.id, ...)` collided with the invoke
    // deadline's registration and silently rolled back into
    // SEND_FAILED. Splitting the uuids restores the "key spaces
    // never alias" invariant the design locked in.
    //
    // InvokeSiteKey is a typed composite of (target, fieldSuffix). A
    // string-concat key (`target + ":" + fieldSuffix`) would have
    // worked given the SCXML grammar (target starts with `#`, suffix
    // is identifier-safe — no `:` in either), but the collision-free
    // property would be an implicit grammar invariant rather than a
    // type-system guarantee. The struct + dedicated hash makes the
    // composition explicit and is robust against any future grammar
    // change that might allow `:` in either component.
    struct InvokeSiteKey {
        std::string target;
        std::string field_suffix;
        bool operator==(const InvokeSiteKey& o) const noexcept {
            return target == o.target && field_suffix == o.field_suffix;
        }
    };
    struct InvokeSiteKeyHash {
        // Hash combiner: boost::hash_combine pattern (golden ratio
        // mixing constant) — diffuses bits between the two component
        // hashes so prefix-correlated targets (e.g., `#motor1`,
        // `#motor2`) do not concentrate in a small slot range.
        std::size_t operator()(const InvokeSiteKey& k) const noexcept {
            std::size_t h = std::hash<std::string>{}(k.target);
            h ^= std::hash<std::string>{}(k.field_suffix)
                 + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2);
            return h;
        }
    };
    struct ActiveInvokeRecord {
        std::array<std::uint8_t, 16> invoke_uuid;
        std::array<std::uint8_t, 16> envelope_uuid;
    };
    std::mutex active_invokes_mutex_;
    std::unordered_map<InvokeSiteKey, ActiveInvokeRecord,
                       InvokeSiteKeyHash> active_invokes_;
{% endif %}

{# ── (D2e) Subscription refcount (SCE_MESH.md §10.9, §13) ── #}
{% if has_pubsub.v %}
    // Per-(target, event) subscription refcount. Parallel regions may
    // subscribe to the same event independently; the logical refcount
    // tracks how many live SCXML subscriptions hold each (target, event)
    // axis. Key: "target|event" (e.g. "#bus|event.subscribe.brake_status").
    // Concurrency: written only from the owning engine's step thread
    // (mesh send callback), same thread-safety model as zenoh_subscribers_.
    std::unordered_map<std::string, int> subscription_refcount_;

    // SCE_MESH.md §10.9 invariant 6: per-target count of distinct
    // (target, event) axes whose logical refcount is currently > 0.
    // The transport-native declare/undeclare fires on the 0↔1 transition
    // of THIS count, not the per-(target, event) refcount above. Both
    // Zenoh (one subscriber per keyexpr, samples carry the event in the
    // envelope payload) and SOME/IP (one eventgroup subscription per
    // target, eventgroup carries multiple events) naturally key their
    // transport-level subscription lifetime on the target, not on the
    // logical SCXML event — so transport-level declare/undeclare must
    // follow the target-level count, not the event-level refcount.
    // Without this gate, a single (target, event) unsubscribe that drives
    // its per-event refcount to zero would erase `zenoh_subscribers_`
    // [target] while sibling (target, *) subscriptions still depend on
    // it (SCE_MESH_KEYING_AUDIT.md T2 clobber).
    std::unordered_map<std::string, int> target_sub_live_count_;
{% endif %}

{# ── (D2f) Server-side fields (SCE_MESH.md §13 Session E) ── #}
{% if has_server_someip %}
    // Server SOME/IP pending request storage (server_app_ declared above
    // for initializer-list ordering). `mutable` so read-only accessors
    // (e.g. test hooks) can hold the mutex inside a const method —
    // matches MeshDeadlineScheduler's mutable-mutex convention.
    std::thread server_thread_;
    mutable std::mutex server_pending_mutex_;
    std::unordered_map<CorrelationKey, std::shared_ptr<vsomeip::message>,
                       CorrelationKeyHash> pending_server_requests_;
{% endif %}
{% if has_server_zenoh %}
    // Server Zenoh queryable + pending query storage.
    // Inbound queries are stashed here keyed by correlation_id; when the
    // engine sends service.response.X the handleServerResponse method
    // retrieves the stored Query and calls reply(). `mutable` so read-only
    // accessors (`pending_server_size`, `server_first_cid`) can hold
    // the mutex inside a const method.
    std::optional<zenoh::Queryable<void>> zenoh_queryable_;
    mutable std::mutex server_pending_mutex_;
    std::unordered_map<CorrelationKey, zenoh::Query,
                       CorrelationKeyHash> pending_server_queries_;
{% if has_server_query_timeout %}
    // SCE Mesh gap Z2: suppress the deadline callback during router
    // teardown. `shutdown()` sets this BEFORE it drains the scheduler
    // (release), and `onServerQueryTimedOut` reads with acquire. Together
    // with the scheduler's own "benign drop" semantics (MeshDeadlineScheduler::shutdown,
    // §9.5) this ensures no late callback races the map's destructor.
    std::atomic<bool> server_shutdown_in_progress_{false};
{% endif %}
{% if server.has_server_put %}
    // Server inbound-put subscriber on ZENOH_SERVER_KEY (SCE_MESH.md §8.3).
    // `session.put` from clients lands on the same key as `session.get`
    // queries, so a parallel subscriber declaration is required — the
    // queryable does not observe puts. One subscriber fans every
    // put-based pattern (FireForget, FieldWrite) by inspecting
    // `env.type` in the decoded envelope and routing through
    // dispatchToSession.
    std::optional<zenoh::Subscriber<void>> zenoh_server_put_sub_;
{% endif %}
{% endif %}

{# ── (D3) Constructor ──
   Session-first binding: the ctor takes a fixed-size pointer array
   (one slot per SCXML document instance hosted on this router) and any
   local target engines, wires the mesh-send callback onto every
   session in the body, and stores the array for dispatch use. The
   previous two-step `ctor + wireTo()` pattern has been collapsed into
   this single construction so the invariant "every session is bound
   before init()" is enforced by the type system, not by caller
   discipline. #}
    TransportRouter(
        std::array<SenderEngine*, N_SESSIONS> sessions
        {%- for target in targets if target.state.kind == "local" -%}
        , {{ target.target_pascal }}Engine& {{ target.target_snake }}
        {%- endfor -%}
    )
{# Initializer list: collect initializer expressions into a list, then
   join with ", ". Declarative composition (as opposed to an imperative
   "is this the first entry?" state machine) makes the ":" / "," layout
   structurally correct for every transport mix — no fixture matrix
   needed to prove the combinatorics. New transports add a single
   `ns.parts` append; separator logic is a fixed `join(", ")`.

   Order MUST mirror the member declaration order above (D1 → D2b), or
   GCC `-Wreorder` (part of `-Wall`) fails compilation at `-Werror`
   whenever the ctor is actually synthesized for a concrete engine type.
   Declarations run per-target-fields first, then `sessions_`, so the
   initializers do the same. #}
{%- set ns = namespace(parts=[]) %}
{%- for target in targets if target.has_per_target_field %}
{%-   if target.state.kind == "local" %}
{%-     set ns.parts = ns.parts + [target.target_snake ~ "_(" ~ target.target_snake ~ ")"] %}
{%-   elif target.state.kind == "shm" %}
{%-     set ns.parts = ns.parts + [target.target_snake ~ "_(SHM_CHANNEL_" ~ (target.target_snake | upper) ~ ", " ~ target.target_pascal ~ "ShmChannel::Mode::Create)"] %}
{%-   elif target.state.kind == "someip" %}
{#-     Application identity: deploy.yaml `transports.someip.application_name`
        (when present) MUST match an `applications[*].name` in vsomeip.json
        (SCE_MESH.md §13). Fallback is the legacy `<machine>_<target>` — an
        auto-generated identity kept for tests that predate the external
        config integration. `someip_transport.application_name` is a
        pre-escaped C++ string literal, so the template can drop it into the
        ctor call verbatim with no further escaping. #}
{%-     if someip_transport and someip_transport.application_name %}
{%-       set ns.parts = ns.parts + [target.target_snake ~ "_app_(vsomeip::runtime::get()->create_application(" ~ someip_transport.application_name ~ "))"] %}
{%-     else %}
{%-       set ns.parts = ns.parts + [target.target_snake ~ "_app_(vsomeip::runtime::get()->create_application(\"" ~ machine_name ~ "_" ~ target.target_snake ~ "\"))"] %}
{%-     endif %}
{%-   elif target.state.kind == "custom_tcp" %}
{#-     custom_tcp client constructor: connect endpoint is pre-escaped as a
        complete C++ string literal in Rust (TargetStateView::CustomTcp);
        the on_receive callback dispatches inbound envelopes through
        `dispatchToSession` so a single client field handles the duplex
        path the same way SOME/IP and Zenoh do. session_idx is `0`:
        custom_tcp is client-only (no pool support), so N_SESSIONS
        is always 1 when this ctor init fires. #}
{%-     set ns.parts = ns.parts + [target.target_snake ~ "_(" ~ target.state.connect ~ ", [this](const SCE::Mesh::MeshEnvelope& env){ (void)this->dispatchToSession(env, 0); })"] %}
{%-   endif %}
{%- endfor %}
{#- SCE Mesh §10.10 per-target OutboundBuffer initializers. Declaration
    order in the private: block is: per-target fields (shm / _app_ /
    custom_tcp) → ordering_buffer_ → seq_counter_{target}_ →
    OutboundBuffer → server_app_ → sessions_ → routing_id_. -Wreorder
    requires ctor init order to match, so OutboundBuffer inits land
    AFTER the per-target field loop but BEFORE the server_app_ /
    sessions_ / routing_id_ entries appended below. The dispatch
    closure captures `this`; the router owns the buffer by value so
    the lifetime contract is identical to every other generated
    runtime primitive. #}
{%- if machine_outbound_buffer %}
{%-   for target in targets if target.state.kind in ("someip", "zenoh") %}
{#- SCE_MESH.md §16.7 row 2 SEND_FAILED Stage 2: the dispatcher lambda
    returns a `SendResult` whose `transport_error` (when populated)
    surfaces through `OutboundBuffer` into
    `CommunicationError::transport_error`. SOME/IP stamps a sentinel
    when `app.send()` returns false (vsomeip exposes no errno
    equivalent); Zenoh's `Publisher::put` throws `zenoh::ZException` on
    transport-API failure, so the lambda wraps the call in try/catch
    and surfaces `e.what()` as the transport_error. The pre-call null
    check (publisher/app not yet initialized) is also classified as a
    transport-API decline. #}
{%-     if target.state.kind == "someip" %}
{#- SCE Mesh §16.7 row 3 retry-layer classification: vsomeip's two
   failure modes are distinguished by `retryable`.
   - app_ == nullptr: configuration error (the SOME/IP application
     was never created or has been torn down). Retrying with the same
     null pointer cannot succeed; mark TERMINAL.
   - app.send() returns false: vsomeip declined the message
     (transient routing-manager state, congestion, missing SD entry
     that may resolve). Mark RETRYABLE so the retry layer can give
     the routing manager time to recover. #}
{%-       set dispatch = "[this](const SCE::Mesh::MeshEnvelope& env) -> SCE::Mesh::SendResult { if (!" ~ target.target_snake ~ "_app_) return SCE::Mesh::SendResult::failure(\"vsomeip app not initialized\", /*retryable=*/false); return send_to_" ~ target.target_snake ~ "(*" ~ target.target_snake ~ "_app_, env) ? SCE::Mesh::SendResult::success() : SCE::Mesh::SendResult::failure(\"vsomeip app.send returned false\", /*retryable=*/true); }" %}
{%-       set transport_literal = "\"someip\"" %}
{%-     else %}
{#- SCE Mesh §16.7 row 3 retry-layer classification for Zenoh.
   - publisher_ == nullptr: declared publisher was never opened (or
     teardown ran). Retrying with the same null can't succeed; mark
     TERMINAL.
   - ZException from Publisher::put: zenoh exposes no
     terminal-vs-transient discriminator on the C++ binding; the
     default classification is RETRYABLE (transient) so a transport
     hiccup gets the configured backoff. A future atomic can add
     terminal-pattern matching against ZException::what() once
     zenoh's error surface stabilises around a documented vocabulary. #}
{%-       set dispatch = "[this](const SCE::Mesh::MeshEnvelope& env) -> SCE::Mesh::SendResult { if (!" ~ target.target_snake ~ "_publisher_) return SCE::Mesh::SendResult::failure(\"zenoh publisher not initialized\", /*retryable=*/false); try { " ~ target.target_snake ~ "_publisher_->put(zenoh::Bytes(SCE::Mesh::encodeEnvelope(env))); return SCE::Mesh::SendResult::success(); } catch (const zenoh::ZException& e) { return SCE::Mesh::SendResult::failure(e.what(), /*retryable=*/true); } }" %}
{%-       set transport_literal = "\"zenoh\"" %}
{%-     endif %}
{%-     if target.retry %}
{#- SCE Mesh §16.7 row 3 — wrap the transport-send closure in a
    `RetryingDispatcher`. Policy fields are deploy.yaml-baked at
    codegen time (validator runs on each before reaching here, so
    every value is in its accepted range). The OutboundBuffer's
    dispatcher then routes through the wrapper's `send_with_retry`
    so SEND_FAILED is suppressed (per Q6=(c) "DELIVERY_EXHAUSTED
    only when max_retries>0"). #}
{%-       set retry_policy_init =
            "{ /*max_retries=*/" ~ target.retry.max_retries ~
            ", /*initial_backoff=*/std::chrono::milliseconds(" ~ target.retry.initial_backoff_ms ~ ")" ~
            ", /*backoff_multiplier=*/" ~ target.retry.backoff_multiplier ~
            ", /*max_backoff=*/std::chrono::milliseconds(" ~ target.retry.max_backoff_ms ~ ")" ~
            ", /*jitter_pct=*/" ~ target.retry.jitter_pct ~
            ", /*transport=*/" ~ transport_literal ~
            ", /*target=*/\"" ~ target.target ~ "\" }" %}
{%-       set retry_init =
            target.target_snake ~ "_retry_(deadline_scheduler_, SCE::Mesh::RetryingDispatcher::Policy" ~
            retry_policy_init ~ ", " ~ dispatch ~
            ", [this](SCE::Mesh::CommunicationError err) { raiseCommunicationError(std::move(err)); })" %}
{%-       set ns.parts = ns.parts + [retry_init] %}
{%-       set wrapped_dispatch =
            "[this](const SCE::Mesh::MeshEnvelope& env) -> SCE::Mesh::SendResult { return " ~
            target.target_snake ~ "_retry_.send_with_retry(env); }" %}
{%-       set init = target.target_snake ~ "_outbound_(\"" ~ target.target ~ "\", " ~ machine_outbound_buffer.max_pending_per_target ~ ", " ~ transport_literal ~ ", " ~ wrapped_dispatch ~ ", [this](SCE::Mesh::CommunicationError err) { raiseCommunicationError(std::move(err)); })" %}
{%-     else %}
{%-       set init = target.target_snake ~ "_outbound_(\"" ~ target.target ~ "\", " ~ machine_outbound_buffer.max_pending_per_target ~ ", " ~ transport_literal ~ ", " ~ dispatch ~ ", [this](SCE::Mesh::CommunicationError err) { raiseCommunicationError(std::move(err)); })" %}
{%-     endif %}
{%-     set ns.parts = ns.parts + [init] %}
{%-   endfor %}
{%- endif %}
{#- SCE_MESH.md §16.5 wire-21 channels: declaration order in (D1c)
    appends after the per-target shm/someip/custom_tcp fields, so
    the ctor init order matches. -Wreorder requires init order to
    follow declaration order: per-target → wire21 → OutboundBuffer →
    server_app_ → sessions_ → routing_id_. Senders use Mode::Create
    (writes READY_MAGIC); receivers use Mode::Open (which may yield
    an invalid channel until the peer creates — `pumpWire21Inbound`
    reopens lazily). #}
{%- for r in partition_wire21_outbound_unique_dests %}
{%-   set ns.parts = ns.parts + ["wire21_to_" ~ r.dst_partition_snake ~ "_(PARTITION_WIRE21_TO_" ~ (r.dst_partition_snake | upper) ~ ", PartitionWire21Channel::Mode::Create)"] %}
{%- endfor %}
{%- for r in partition_wire21_inbound_sources %}
{%-   set ns.parts = ns.parts + ["wire21_from_" ~ r.src_partition_snake ~ "_(PARTITION_WIRE21_FROM_" ~ (r.src_partition_snake | upper) ~ ", PartitionWire21Channel::Mode::Open)"] %}
{%- endfor %}
{#- SCE_MESH.md §9.6.2 Session F scxml-remote invoke channels. Declaration
    order in (D1c') puts outbound peers before inbound peers; the ctor
    init list mirrors that. Per-peer transport branches:
      * shm: outbound `p2c_to_<peer>_` creates, paired `c2p_from_<peer>_`
        opens lazily. Inbound `p2c_from_<peer>_` opens (may yield invalid
        until the outbound peer launches); `c2p_to_<peer>_` creates so
        the outbound peer can observe the reply.
      * custom_tcp: one `Client` per peer, connect endpoint comes from
        `peer.connect_endpoint` (Rust classifier resolved the peer's own
        `transports.custom_tcp.listen`). The Client's receive callback is
        a no-op here — inbound dispatch goes through the device-shared
        `custom_tcp_server_` (Session 2 commit 2 installs the pattern
        switch). #}
{#- SCE_MESH.md §9.6.2 Session 4b machine-level SOME/IP scxml-invoke
    vsomeip application: one per machine, created BEFORE the per-peer
    endpoints because their ctor stores a shared_ptr copy. Follows the
    same declaration-before-use ordering as `server_app_` below. #}
{%- if scxml_remote_outbound_peers | selectattr("transport", "equalto", "someip") | list or scxml_remote_inbound_peers | selectattr("transport", "equalto", "someip") | list or someip_liveness_service_id_self_hex or someip_machine_liveness_service_id_self_hex %}
{%-   set ns.parts = ns.parts + [someip_sce_app_field ~ "(vsomeip::runtime::get()->create_application(\"" ~ someip_sce_app_vsomeip_name ~ "\"))"] %}
{%- endif %}
{%- for peer in scxml_remote_outbound_peers %}
{%-   if peer.transport == "custom_tcp" %}
{%-     set ns.parts = ns.parts + ["p2c_to_" ~ peer.name ~ "_(\"" ~ peer.connect_endpoint ~ "\", [](const SCE::Mesh::MeshEnvelope&) {})"] %}
{%-   elif peer.transport == "someip" %}
{%-     set ns.parts = ns.parts + ["scxml_invoke_to_" ~ peer.name ~ "_(" ~ someip_sce_app_field ~ ", SCE_SOMEIP_SERVICE_SELF, SCE_SOMEIP_SERVICE_PEER_" ~ (peer.name | upper) ~ ")"] %}
{%-   elif peer.transport != "zenoh" %}
{%-     set ns.parts = ns.parts + ["p2c_to_" ~ peer.name ~ "_(P2C_TO_" ~ (peer.name | upper) ~ ", SCE::Mesh::ShmChannel<>::Mode::Create)"] %}
{%-     set ns.parts = ns.parts + ["c2p_from_" ~ peer.name ~ "_(C2P_FROM_" ~ (peer.name | upper) ~ ", SCE::Mesh::ShmChannel<>::Mode::Open)"] %}
{%-   endif %}
{%- endfor %}
{%- for peer in scxml_remote_inbound_peers %}
{%-   if peer.transport == "custom_tcp" %}
{%-     set ns.parts = ns.parts + ["c2p_to_" ~ peer.name ~ "_(\"" ~ peer.connect_endpoint ~ "\", [](const SCE::Mesh::MeshEnvelope&) {})"] %}
{%-   elif peer.transport == "someip" %}
