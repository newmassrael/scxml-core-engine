    /// Dispatch an incoming envelope to an arbitrary receiver engine.
    ///
    /// Generic fallback used by out-of-band callers (tests, special
    /// wiring). Prefer `dispatchToSender` when the target is the
    /// sender engine bound at construction.
    ///
    /// @tparam Policy Receiver's StatePolicy (generated struct)
    /// @tparam Engine StaticExecutionEngine<Policy>
    /// @return true if the envelope was dispatched to the engine
    template <typename Policy, typename Engine>
    bool onIncoming(const SCE::Mesh::MeshEnvelope& env, Engine& engine) {
        return SCE::Mesh::dispatchEnvelope<Policy>(env, engine);
    }

{# ── (D6) Zenoh multi-pattern dispatch ──────────────────────────
   Zenoh realizes all four capability categories through four native API
   primitives: put (FireForget/FieldWrite), get+reply callback (RpcRequest/
   FieldRead), declare_subscriber (EventSubscribe), and handle destruction
   (EventUnsubscribe). Correlation is handled by the zenoh runtime — each
   get() invocation's on_reply closure captures the per-call reply-event
   name, so no correlation table is needed.

   Member function (not free) because multi-pattern dispatch requires
   mutating router state (zenoh_subscribers_) and capturing receive
   state (receive_callback_) into closures passed to the zenoh API. #}
{% if "zenoh" in transport_types %}
    /// Dispatch an outbound envelope through Zenoh using the pattern-matched
    /// native API. Called by route_send() with the target's key expression.
    ///
    /// @param env           outbound envelope (pattern-discriminated)
    /// @param key_expr_str  Zenoh key expression for the target (null-terminated)
    /// @param target_name   SCXML target string — key into zenoh_subscribers_
    /// @return true if the zenoh primitive accepted the operation; false if
    ///         the pattern is not outbound on this transport (inbound-only
    ///         patterns like EventNotify are rejected here).
    [[nodiscard]] bool send_zenoh(const SCE::Mesh::MeshEnvelope& env,
                                  const char* key_expr_str,
                                  const std::string& target_name) {
        using PK = SCE::Mesh::PatternKind;
        if (!zenoh_session_) return false;
        zenoh::KeyExpr key(key_expr_str);
        auto encoded = SCE::Mesh::encodeEnvelope(env);

        switch (env.pattern) {
        case PK::FireForget:
        case PK::FieldWrite: {
            zenoh_session_->put(key, zenoh::Bytes(std::move(encoded)));
            return true;
        }
        case PK::RpcRequest:
        case PK::FieldRead: {
            // Capture reply-event (RPC only) and pattern-kind-on-reply. The
            // on_reply closure runs on a zenoh runtime thread; it decodes the
            // reply envelope, rewrites type/pattern to the sender's
            // expectations, and dispatches to the sender engine through
            // `this->dispatchToSender`. Capturing `this` (rather than a
            // std::function copy) removes one layer of type erasure and
            // relies on the same lifetime contract the rest of the router
            // does — TransportRouter must outlive in-flight operations.
            const char* reply = (env.pattern == PK::RpcRequest)
                                    ? resolveReplyEvent(env.type)
                                    : "";
            std::string reply_event = reply;
            const PK reply_pattern = (env.pattern == PK::RpcRequest)
                                         ? PK::RpcReply
                                         : PK::FieldNotify;

            zenoh::Session::GetOptions opts;
            opts.payload = zenoh::Bytes(std::move(encoded));
            zenoh_session_->get(
                key, "",
                [this, reply_event, reply_pattern](const zenoh::Reply& reply_msg) {
                    if (!reply_msg.is_ok()) return;
                    const auto& sample = reply_msg.get_ok();
                    auto bytes = sample.get_payload().as_vector();
                    SCE::Mesh::MeshEnvelope resp;
                    if (!SCE::Mesh::decodeEnvelope(bytes.data(), bytes.size(), resp)) return;
                    if (!reply_event.empty()) resp.type = reply_event;
                    resp.pattern = reply_pattern;
                    // Dispatch result ignored intentionally: MeshDispatch
                    // returns false for unknown event names, which in a
                    // reply closure means the sender has no handler for
                    // this event — the envelope is dropped silently, same
                    // as any W3C SCXML unmatched external event.
                    //
                    // SCE_MESH.md §10.5: Zenoh client reply gate. Uses
                    // `has_undeduped_transport` rather than
                    // `server_needs_dedup` because this closure runs on
                    // the client path — the server flag can be false on
                    // pure-client machines that still have Zenoh targets.
                    // The invariant chain (Zenoh target →
                    // `needs_dedup = true` → `has_undeduped_transport`)
                    // keeps the `admitInbound` branch live here today;
                    // the fallback is the same registry-shift defence
                    // as the server-side gates above.
                    (void)this->{{ dedup_or_dispatch(has_undeduped_transport, "resp") }};
                },
                // on_drop: fires when zenoh signals query completion (all
                // replies received or session closed). Per-query state is
                // self-contained in the reply closure above, so no
                // teardown work is required on this side.
                []{},
                std::move(opts));
            return true;
        }
        case PK::EventSubscribe: {
            auto sub = zenoh_session_->declare_subscriber(
                key,
                [this](const zenoh::Sample& sample) {
                    auto bytes = sample.get_payload().as_vector();
                    SCE::Mesh::MeshEnvelope notify;
                    if (!SCE::Mesh::decodeEnvelope(bytes.data(), bytes.size(), notify)) return;
                    notify.pattern = SCE::Mesh::PatternKind::EventNotify;
                    // SCE_MESH.md §10.5: Zenoh client subscribe gate —
                    // same `has_undeduped_transport` flag as the reply
                    // closure above.
                    (void)this->{{ dedup_or_dispatch(has_undeduped_transport, "notify") }};
                },
                // on_drop: fires when the Subscriber handle is destroyed
                // (removed from zenoh_subscribers_ or router shutdown).
                // Handle lifetime is managed by the map; nothing to do.
                []{});
            // Duplicate-subscribe semantics: silent replace (refresh).
            // SCXML state-entry bindings re-execute on every entry to the
            // owning state, so re-entering a subscribed state MUST be a
            // valid no-op-or-refresh, not an error. RAII destruction of
            // the prior Subscriber undeclares it before the new one is
            // installed; from the receiver's perspective there is at most
            // a millisecond gap with no active subscription. Callers that
            // need at-least-once delivery during a refresh should use
            // machine-lifetime subscriptions (deploy.yaml, Session E)
            // instead of state-entry bindings.
            zenoh_subscribers_.insert_or_assign(target_name, std::move(sub));
            return true;
        }
        case PK::EventUnsubscribe: {
            zenoh_subscribers_.erase(target_name);  // RAII undeclares
            return true;
        }
        default:
            // RpcReply, EventNotify, FieldNotify are inbound-only patterns.
            return false;
        }
    }
