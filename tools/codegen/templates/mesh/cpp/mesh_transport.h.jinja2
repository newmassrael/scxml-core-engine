    // self-filter (`keyexpr == sce/live/<machine_name>`) defends
    // against the same race if the order ever shifts.
    std::optional<zenoh::LivelinessToken> liveliness_token_;
    std::optional<zenoh::Subscriber<void>> liveliness_subscriber_;
    std::mutex liveliness_mutex_;
    std::unordered_map<std::string, std::chrono::steady_clock::time_point> peer_last_seen_;
