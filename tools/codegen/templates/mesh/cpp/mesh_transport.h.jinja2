    /// is excluded from the SOME/IP server pool shape (SCE_MESH.md
    /// §14.4), so every router on the Zenoh client path has
    /// N_SESSIONS == 1.
    [[nodiscard]] bool admitZenohInbound(const std::string& target,
                                         const SCE::Mesh::MeshEnvelope& env) {
{% for t in targets if t.state.kind == "zenoh" %}
        if (target == "{{ t.target }}") {
            return this->{{ admit_or_dispatch(t.needs_ordering, t.needs_dedup, "env", "0") }};
