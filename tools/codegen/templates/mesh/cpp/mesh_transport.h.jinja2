        using PK = SCE::Mesh::PatternKind;
{# Collect all unique event→pattern mappings across all targets #}
{% set ns = namespace(has_patterns=false) %}
{% for target in targets %}
{% for ep in target.event_patterns %}
{% set ns.has_patterns = true %}
        if (eventName == "{{ ep.event }}") return static_cast<PK>({{ ep.pattern_kind }});
{% endfor %}
{% endfor %}
{% if not ns.has_patterns %}
        (void)eventName;
{% endif %}
        return PK::FireForget;
    }

{% if "someip" in transport_types %}
    /// Look up the sce:reply-event name for an RPC event (build-time table).
    /// Returns empty string if no reply-event is configured.
    static const char* resolveReplyEvent(const std::string& eventName) {
{% for target in targets %}
{% for ep in target.event_patterns if ep.reply_event %}
        if (eventName == "{{ ep.event }}") return "{{ ep.reply_event }}";
{% endfor %}
{% endfor %}
        (void)eventName;
        return "";
    }
{% endif %}

    /// Wire this router to a sender StaticExecutionEngine's mesh-send callback.
    ///
    /// After this call, <send target="#<machine>"/> in the sender machine is
    /// automatically dispatched through the router. The lambda builds a
    /// MeshEnvelope from the raw fields and routes it to the target transport.
    /// For RPC patterns, a correlation_id is generated and stored in the
    /// pending_rpcs_ table for response matching. Unknown targets are declined
    /// so the engine may fall back to the external queue (W3C behavior).
    template <typename SenderEngine>
    void wireTo(SenderEngine& engine) {
{% if "someip" in transport_types %}
        // Install receive callback: incoming SOME/IP responses/notifications
        // are dispatched to the sender engine via MeshDispatch.
        using SenderPolicy = std::decay_t<decltype(engine.getPolicy())>;
        receive_callback_ = [&engine](const SCE::Mesh::MeshEnvelope& env) -> bool {
            return SCE::Mesh::dispatchEnvelope<SenderPolicy>(env, engine);
        };
{% endif %}
        engine.setMeshSendCallback(
            [this](const std::string& target, const std::string& eventName,
                   const std::string& data, const std::string& /*sendId*/) -> bool {
                SCE::Mesh::MeshEnvelope env;
                env.id = SCE::uuid::v7();
                env.source = "{{ machine_name }}";
                env.type = eventName;
                env.pattern = resolvePattern(eventName);
                env.datacontenttype = data.empty()
                    ? SCE::Mesh::PayloadCodec::None
                    : SCE::Mesh::PayloadCodec::Json;
                env.data.assign(data.begin(), data.end());
{% if "someip" in transport_types %}
                // RPC correlation: generate correlation_id and register reply-event
                if (env.pattern == SCE::Mesh::PatternKind::RpcRequest) {
                    auto cid = SCE::uuid::v7();
                    env.correlation_id = cid;
                    env.reply_to = "{{ machine_name }}";
                    const char* reply = resolveReplyEvent(eventName);
                    if (reply[0] != '\0') {
                        std::lock_guard<std::mutex> lock(correlation_mutex_);
                        pending_rpcs_[CorrelationKey{cid}] = reply;
                    }
                }
{% endif %}
                return route_send(target, env);
            });
    }

    /// Dispatch an incoming envelope to the appropriate handler based on
    /// its communication pattern. Delegates to MeshDispatch.h — single
    /// source of truth for pattern-based dispatch logic.
    ///
    /// @tparam Policy Receiver's StatePolicy (generated struct)
    /// @tparam Engine StaticExecutionEngine<Policy>
    /// @return true if the envelope was dispatched to the engine
    template <typename Policy, typename Engine>
    bool onIncoming(const SCE::Mesh::MeshEnvelope& env, Engine& engine) {
        return SCE::Mesh::dispatchEnvelope<Policy>(env, engine);
    }
