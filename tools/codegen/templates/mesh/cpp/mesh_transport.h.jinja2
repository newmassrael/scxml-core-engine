{# ── (D2c) SOME/IP RPC correlation table ── #}
{% if "someip" in transport_types %}
    // RPC correlation table: maps correlation_id → reply event name.
    // Written on send (RpcRequest), consumed on receive (RpcReply).
    // vsomeip callbacks run on vsomeip's internal thread, so access is guarded.
    //
    // TTL / timeout eviction: entries for which no response arrives (network
    // failure, peer crash, deadline exceeded) remain in this map until the
    // router is destroyed — effectively a bounded leak proportional to the
    // number of orphaned RPC calls. Timeout-based eviction keyed on
    // `env.deadline_unix_ms` is deferred to Session E, where the full
    // `<invoke type="sce:mesh-rpc">` lifecycle (start/done/error/cancel)
    // provides a natural expiration point per invocation.
    struct CorrelationKey {
        std::array<uint8_t, 16> id;
        bool operator==(const CorrelationKey& o) const { return id == o.id; }
    };
    struct CorrelationKeyHash {
        // FNV-1a 64-bit hash. Deterministic, well-mixed across all byte
        // positions — important because UUID v7 packs a ms-resolution
        // timestamp in the leading bytes, so IDs generated in close
        // succession share a common prefix. FNV-1a's per-byte multiply
        // diffuses those shared prefixes across the output word.
        std::size_t operator()(const CorrelationKey& k) const noexcept {
            constexpr std::size_t FNV_OFFSET = 0xcbf29ce484222325ULL;
            constexpr std::size_t FNV_PRIME  = 0x00000100000001B3ULL;
            std::size_t h = FNV_OFFSET;
            for (auto b : k.id) {
                h ^= static_cast<std::size_t>(b);
                h *= FNV_PRIME;
            }
            return h;
        }
    };
    std::mutex correlation_mutex_;
    std::unordered_map<CorrelationKey, std::string, CorrelationKeyHash> pending_rpcs_;
{% endif %}

