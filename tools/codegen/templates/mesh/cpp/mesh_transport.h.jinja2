    // TTL / timeout eviction: entries for which no response arrives (network
    // failure, peer crash, deadline exceeded) remain in this map until the
    // router is destroyed — effectively a bounded leak proportional to the
    // number of orphaned RPC calls. Timeout-based eviction keyed on
    // `env.deadline_unix_ms` is deferred to Session E, where the full
    // `<invoke type="sce:mesh-rpc">` lifecycle (start/done/error/cancel)
    // provides a natural expiration point per invocation.
    struct CorrelationKey {
