{# SCE Mesh — unified transport routing (per-target transport dispatch).

   Each target's transport type determines its send function and router field.
   Supports mixed transports: e.g. #motor via local, #display via shm,
   #logger via someip, #telemetry via zenoh.

   Template structure:
     (A) Includes                     — keyed by `transport_types`
     (B) Per-target constants         — keyed by `target.state.kind`
     (C) Per-target send functions    — keyed by `target.state.kind`
     (D) TransportRouter
         D1. Per-target fields        — iterates `target.has_per_target_field`
         D2. Shared transport fields  — keyed by `transport_types`
         D3. Constructor              — iterates `target.has_per_target_ctor_init`
         D4. init() / shutdown()      — keyed by `transport_types` (shared resources)
         D5. route_send() dispatch    — keyed by `target.state.kind`

   Adding a new transport (authoritative registry lives in transport.rs):
     (1) Add one entry to `transport::lookup()` with shape + capabilities
         + `implemented: true`.
     (2) If device-shared session config is needed, add a typed field to
         `deploy::TransportConfigs` (parse-time validated by serde), then
         thread it through `generate_mesh` as a new parameter.
     (3) Add {% elif %} blocks in this template at "NEW TRANSPORT" markers.

   Per-target vs shared: per-target transports (local, shm, someip) emit
   one field per target and one init-list entry per target. Shared-session
   transports (zenoh) emit a single device-wide field initialized in init().

   Transport types handled:
     local  — same-process direct call (inlined by compiler)
     shm    — shared memory cross-process via ShmChannel
     someip — SOME/IP over Ethernet via vsomeip (per-target application)
     zenoh  — Zenoh pub/sub via zenoh-cpp (device-shared session) #}

{# ── Jinja2 macros: SOME/IP boilerplate extraction ─────────
   Eliminates three near-identical request-build sequences (RPC / FieldRead /
   FieldWrite) and four near-identical receive-handler shells (RPC response /
   event notify / getter resp / setter resp). RPC response path injects
   correlation lookup; all others share the decode-and-dispatch body. #}

{% macro someip_send_request(target, method_constant) -%}
        auto request = vsomeip::runtime::get()->create_request(
            {% if target.state.extra.protocol is defined and target.state.extra.protocol == "tcp" %}true{% else %}false{% endif %});
        request->set_service(SOMEIP_SERVICE_{{ target.target_snake | upper }});
        request->set_instance(SOMEIP_INSTANCE_{{ target.target_snake | upper }});
        request->set_method({{ method_constant }});
        auto buf = SCE::Mesh::encodeEnvelope(env);
        auto payload = vsomeip::runtime::get()->create_payload(
            reinterpret_cast<const vsomeip::byte_t*>(buf.data()),
            static_cast<uint32_t>(buf.size()));
        request->set_payload(payload);
        app.send(request);
        return true;
{%- endmacro %}

{% macro someip_receive_handler(target, method_constant, pattern_kind, kind) -%}
        {{ target.target_snake }}_app_->register_message_handler(
            SOMEIP_SERVICE_{{ target.target_snake | upper }},
            SOMEIP_INSTANCE_{{ target.target_snake | upper }},
            {{ method_constant }},
            [this](const std::shared_ptr<vsomeip::message>& msg) {
{% if kind == "rpc" %}
                if (msg->get_return_code() != vsomeip::return_code_e::E_OK
                    && msg->get_message_type() != vsomeip::message_type_e::MT_RESPONSE) return;
{% elif kind == "field" %}
                if (msg->get_message_type() != vsomeip::message_type_e::MT_RESPONSE) return;
{% endif %}
                auto pl = msg->get_payload();
                if (!pl) return;
                SCE::Mesh::MeshEnvelope env;
                if (!SCE::Mesh::decodeEnvelope(pl->get_data(), pl->get_length(), env)) return;
{% if kind == "rpc" %}
                // Correlation: look up reply-event name for this correlation_id
                if (env.correlation_id) {
                    std::lock_guard<std::mutex> lock(correlation_mutex_);
                    auto it = pending_rpcs_.find(CorrelationKey{*env.correlation_id});
                    if (it != pending_rpcs_.end()) {
                        env.type = it->second;
                        env.pattern = SCE::Mesh::PatternKind::RpcReply;
                        pending_rpcs_.erase(it);
                    }
                }
{% else %}
                env.pattern = {{ pattern_kind }};
{% endif %}
                // Dispatch result ignored intentionally — unknown event
                // names in the sender policy drop the envelope, which is
                // the desired behavior for unmatched inbound messages.
                // SCE_MESH.md §10.5: per-binding dedup. A SOME/IP binding
                // pinned to `protocol: tcp` rides a single TCP stream per
                // client↔server pair — duplicates are physically
                // impossible and the runtime DedupWindow is bypassed.
                // Unpinned (UDP-default) bindings route through
                // admitInbound to filter on (source, id). Forwarded
                // to the shared `dedup_or_dispatch` macro so all eight
                // inbound call sites read identically.
                (void)this->{{ dedup_or_dispatch(target.needs_dedup, "env") }};
            });
{%- endmacro %}
{#
  SCE_MESH.md §10.5: single decision point for every inbound call site
  that can see an envelope from a transport with `supplies_dedup: false`.

  `condition` is the flag the caller wants to gate on:
    * `server_needs_dedup` for server-side handlers (SOME/IP method
      callbacks, Zenoh queryable / put-subscriber). True whenever the
      server is served by an undeduped transport.
    * `has_undeduped_transport` for client-side closures invoked by
      `send_zenoh` (Zenoh reply + subscribe). True whenever ANY target
      on the machine routes through an undeduped transport, which is
      the same condition that emits the `admitInbound` method itself,
      so the fallback branch is unreachable on today's registry.

  `env_name` names the C++ variable holding the decoded envelope at
  the call site (`env`, `resp`, `notify`, …). The caller supplies the
  `(void)this->…;` wrapper and any leading indentation, so the macro
  stays a one-line expression and every caller keeps its local
  context unchanged.
#}
{%- macro dedup_or_dispatch(condition, env_name) -%}
{%- if condition -%}
admitInbound({{ env_name }})
{%- else -%}
dispatchToSender({{ env_name }})
{%- endif -%}
{%- endmacro %}
