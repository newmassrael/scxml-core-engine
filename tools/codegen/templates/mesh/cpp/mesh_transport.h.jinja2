{% endif %}
{% if scxml_remote_inbound_peers %}

    /// SCE_MESH.md §9.6.2 worker-side inbound pump — drains every inbound
    /// `p2c_from_<peer>_` channel and routes each envelope into the
    /// `WorkerSessionHost` by pattern:
    ///   wire-14 `InvokeStart`  → host.onWire14 (spawn child + publish wire-15)
    ///   wire-17 `ParentEvent`  → host.onWire17 (deliver to child queue)
    ///   wire-19 `InvokeCancel` → host.onWire19 (terminate child)
