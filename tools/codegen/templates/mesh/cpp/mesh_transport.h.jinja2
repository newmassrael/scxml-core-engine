    [[nodiscard]] bool send_zenoh(const SCE::Mesh::MeshEnvelope& env,
                                  const char* key_expr_str,
                                  const std::string& target_name) {
        using PK = SCE::Mesh::PatternKind;
        if (!zenoh_session_) return false;
        zenoh::KeyExpr key(key_expr_str);
        auto encoded = SCE::Mesh::encodeEnvelope(env);

        switch (env.pattern) {
        case PK::FireForget:
        case PK::FieldWrite: {
            zenoh_session_->put(key, zenoh::Bytes(std::move(encoded)));
            return true;
        }
        case PK::RpcRequest:
        case PK::FieldRead: {
            // Capture reply-event (RPC only) and pattern-kind-on-reply. The
            // on_reply closure runs on a zenoh runtime thread; it decodes the
            // reply envelope, rewrites type/pattern to the sender's
            // expectations, and dispatches to the sender engine through
            // `this->dispatchToSession`. Capturing `this` (rather than a
            // std::function copy) removes one layer of type erasure and
            // relies on the same lifetime contract the rest of the router
            // does — TransportRouter must outlive in-flight operations.
            const char* reply = (env.pattern == PK::RpcRequest)
                                    ? resolveReplyEvent(env.type)
                                    : "";
            std::string reply_event = reply;
            const PK reply_pattern = (env.pattern == PK::RpcRequest)
                                         ? PK::RpcReply
                                         : PK::FieldNotify;

            zenoh::Session::GetOptions opts;
            opts.payload = zenoh::Bytes(std::move(encoded));
{% if has_zenoh_mesh_rpc %}
            // SCE Mesh gap Z3: the reply and on_drop closures share a
            // "reply observed" flag so on_drop can tell whether the
            // query terminated happily (reply dispatched) or needs an
            // early cancellation. `shared_ptr<atomic<bool>>` is the
            // textbook lifetime tool here — each closure is an
            // independent heap-allocated callable inside zenoh's
            // runtime, so capture-by-value + shared state is the only
            // way to coordinate. `invoke_id_capture` is the mesh-rpc
            // correlation key; when absent (plain `<send>`-triggered
            // RpcRequest) the on_drop closure short-circuits because
            // there is no InvokeCorrelation entry to cancel.
            auto reply_seen = std::make_shared<std::atomic<bool>>(false);
            std::optional<std::array<std::uint8_t, 16>> invoke_id_capture = env.invoke_id;
{% if has_any_retry.v %}
            // §16.7 row 3 follow-up — envelope uuid is captured so the
            // on_drop closure can fan out cancelEnvelopeRetryById to
            // the per-target RetryingDispatchers. Always present (every
            // outbound envelope carries env.id), unlike invoke_id which
            // is mesh-rpc-only.
            const auto envelope_id_capture = env.id;
{% endif %}
{% endif %}
            zenoh_session_->get(
                key, "",
                [this, reply_event, reply_pattern,
                 target_owned = std::string(target_name){% if has_zenoh_mesh_rpc %},
                 reply_seen{% endif %}](const zenoh::Reply& reply_msg) {
                    if (!reply_msg.is_ok()) return;
{% if has_zenoh_mesh_rpc %}
                    // Mark reply observed BEFORE decode/dispatch — a
                    // racing on_drop on another zenoh runtime thread
                    // must see this store. Acquire/release ordering
                    // establishes happens-before; an on_drop firing
                    // after this line is guaranteed to see `true` and
                    // skip the early-cancel branch.
                    reply_seen->store(true, std::memory_order_release);
{% endif %}
                    const auto& sample = reply_msg.get_ok();
                    auto bytes = sample.get_payload().as_vector();
                    SCE::Mesh::MeshEnvelope resp;
                    if (!SCE::Mesh::decodeEnvelope(bytes.data(), bytes.size(), resp)) {{ raise_envelope_corrupt("zenoh") }}
                    if (!reply_event.empty()) resp.type = reply_event;
                    resp.pattern = reply_pattern;
                    // SCE_MESH.md §10.5/§10.6 SSoT dispatch: the per-
                    // target admit chain (ordering → dedup → direct) is
                    // selected by the build-time switch inside
                    // `admitZenohInbound`. Capturing `target_name` by
                    // value (the zenoh runtime can invoke this closure
                    // past the scope of `send_zenoh`) keeps the dispatch
                    // identity stable for the lifetime of the reply.
                    // Dispatch result ignored intentionally: an unknown
                    // reply event name drops the envelope, matching W3C
                    // SCXML's unmatched-external-event semantics.
                    (void)this->admitZenohInbound(target_owned, resp);
                },
{% if has_zenoh_mesh_rpc %}
                // SCE Mesh gap Z3: zenoh fires this once per query —
                // after the last reply, on `queries_default_timeout`
                // expiry, or on session teardown. If no reply was seen
                // AND the query carried an `invoke_id` (mesh-rpc path),
                // delegate to `onZenohQueryDropped` which cancels the
                // deadline entry and raises `error.invoke.<id>` with
                // `RpcStatus::Unavailable`. Non-invoke queries (plain
                // `<send>` RpcRequest, no `invoke_id`) have no
                // correlation entry to cancel — the branch short-circuits.
                [this, reply_seen, invoke_id_capture{% if has_any_retry.v %}, envelope_id_capture{% endif %}]() noexcept {
                    if (reply_seen->load(std::memory_order_acquire)) return;
                    if (!invoke_id_capture) return;
                    this->onZenohQueryDropped(*invoke_id_capture{% if has_any_retry.v %}, envelope_id_capture{% endif %});
                },
{% else %}
                // on_drop fires once at query termination. No mesh-rpc
                // machinery on this machine, so there is no InvokeCorrelation
                // entry to early-cancel; the reply closure above is
                // self-contained and per-query state rides with it.
                []() noexcept {},
{% endif %}
                std::move(opts));
            return true;
        }
        case PK::EventSubscribe: {
            auto sub = zenoh_session_->declare_subscriber(
                key,
                [this,
                 target_owned = std::string(target_name)](const zenoh::Sample& sample) {
                    auto bytes = sample.get_payload().as_vector();
                    SCE::Mesh::MeshEnvelope notify;
                    if (!SCE::Mesh::decodeEnvelope(bytes.data(), bytes.size(), notify)) {{ raise_envelope_corrupt("zenoh") }}
                    notify.pattern = SCE::Mesh::PatternKind::EventNotify;
                    // SCE_MESH.md §10.5/§10.6: per-target admit chain
                    // via the same SSoT helper the reply closure uses.
                    // The captured `target_owned` lifetime matches the
                    // subscriber handle in `zenoh_subscribers_`, which
                    // the router owns.
                    (void)this->admitZenohInbound(target_owned, notify);
                },
                // Client subscriber on_drop: zenoh invokes this once
                // when the Subscriber handle is destroyed, which happens
                // exactly when this machine removes the target from
                // `zenoh_subscribers_` (duplicate-subscribe refresh,
                // EventUnsubscribe pattern, or router shutdown). The
                // undeclare is deliberate and author-triggered — the
                // on_sample closure owns the admit chain, so there is
                // no per-subscription state to unwind on teardown.
                []() noexcept {});
            // State-entry subscription semantics (SCE Mesh Z5,
            // mesh_zenoh_gaps_roadmap.md; SCE_MESH.md §10.9, §13).
            //
            // The two-level gate emitted above (around the `has_pubsub`
            // gate) collapses both redundant logical subscribes on the
            // same (target, event) axis and redundant transport-level
            // declares for sibling (target, *) axes — reaching this
            // dispatcher implies `target_sub_live_count_[target]` just
            // transitioned 0→1, i.e. this is the first live subscription
            // anywhere on the target. The matching transport-level
            // undeclare in the `EventUnsubscribe` case below runs only
            // on the corresponding 1→0 transition, so a sibling event's
            // unsubscribe cannot tear down the shared subscriber while
            // this event is still live (SCE_MESH_KEYING_AUDIT.md T2 fix).
            //
            // The residual window Z5 names is the re-entry cycle on a
            // single (target, event) pair: state exit issues the
            // auto-synthesized `event.unsubscribe.*` which runs
            // refcount 1→0 and erases the map entry (RAII undeclare),
            // then state re-entry re-issues subscribe → refcount
            // 0→1 → fresh declare_subscriber here. Between exit and
            // re-entry the transport has no subscriber; peer `put`
            // deliveries on the keyexpr during that window are lost.
            //
            // The window is intrinsic to state-entry lifecycle
            // semantics (subscribe on entry, unsubscribe on exit), not
            // a transport-level defect. Authors who need at-least-once
            // delivery across state re-entry reach for the
            // machine-lifetime path — deploy.yaml
            // `machines.<name>.subscriptions:` (emitted in `init()`
            // above, Session Task #7 / Z5a). Build-time target
            // synthesis projects each subscription source into an
            // implicit ResolvedTarget, so the init-time
            // `route_send(source, sub_env)` lands on the same
            // per-target arm an SCXML `<send>` would — the subscribe
            // reaches this dispatcher unchanged.
            zenoh_subscribers_.insert_or_assign(target_name, std::move(sub));
            return true;
        }
        case PK::EventUnsubscribe: {
            zenoh_subscribers_.erase(target_name);  // RAII undeclares
            return true;
        }
        default:
            // RpcReply, EventNotify, FieldNotify are inbound-only patterns.
            return false;
        }
    }
{% endif %}
};

