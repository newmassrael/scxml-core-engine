{% endif %}
{% if has_pubsub.v %}
                // Two-level subscription gating (SCE_MESH.md §10.9 invariant 6,
                // §13). Parallel regions may subscribe to the same (target,
                // event) axis independently — `subscription_refcount_`
                // tracks that logical SCXML count. The transport-native
                // declare/undeclare, however, is gated on the per-target
                // total: `target_sub_live_count_[target]` is the number of
                // (target, *) axes with live logical subscriptions, and the
                // transport-level transition fires only when THIS count
                // crosses 0↔1. Zenoh (one subscriber per keyexpr) and
                // SOME/IP (one eventgroup subscription per target) both key
                // their transport-level lifetime on target, so a single
                // (target, event) unsubscribe must not tear down the shared
                // transport subscriber while sibling (target, *) axes are
                // still live (SCE_MESH_KEYING_AUDIT.md T2 reproduction).
                //
                // Refcount key uses the subscribe event name for both
                // subscribe and unsubscribe so they share the same counter.
                using PK = SCE::Mesh::PatternKind;
                if (env.pattern == PK::EventSubscribe) {
                    auto key = target + "|" + eventName;
                    if (subscription_refcount_[key]++ > 0) {
                        return true;  // another region already holds this (target, event)
                    }
                    if (target_sub_live_count_[target]++ > 0) {
                        return true;  // sibling (target, *) keeps transport alive
                    }
                    // target_sub_live_count_ 0→1: first live subscription
                    // for this target — fall through to transport declare.
                }
                if (env.pattern == PK::EventUnsubscribe) {
                    // Derive the subscribe key from the unsubscribe event.
                    // "event.unsubscribe.X" → "event.subscribe.X"
                    std::string sub_event = eventName;
                    const std::string unsub_prefix = "event.unsubscribe";
                    const std::string sub_prefix = "event.subscribe";
                    if (sub_event.compare(0, unsub_prefix.size(), unsub_prefix) == 0) {
                        sub_event = sub_prefix + sub_event.substr(unsub_prefix.size());
                    }
                    auto key = target + "|" + sub_event;
                    auto it = subscription_refcount_.find(key);
                    if (it == subscription_refcount_.end()) {
                        return true;  // unsubscribe for never-subscribed (target, event) — no-op
                    }
                    if (--it->second > 0) {
                        return true;  // other regions still hold this (target, event)
                    }
                    subscription_refcount_.erase(it);
                    // (target, event) went 1→0. Decrement the per-target
                    // count; reach transport undeclare only when the target
                    // itself has no more live (target, *) subscriptions.
                    auto tit = target_sub_live_count_.find(target);
                    if (tit != target_sub_live_count_.end()) {
                        if (--tit->second > 0) {
                            return true;  // sibling (target, *) still live
