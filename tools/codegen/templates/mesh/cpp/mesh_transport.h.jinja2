                switch (in.pattern) {
                case SCE::Mesh::PatternKind::InvokeStart:
                    worker_session_host_.onWire14(in,
                        [this](const SCE::Mesh::MeshEnvelope& env) -> bool {
                            return c2p_to_{{ peer.name }}_.send(env);
