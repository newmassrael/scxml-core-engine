{# SCE_MESH.md §14.4 (Gap 7): multi-instance server pool.
   `server.instance_pool` carries the Option<Vec<u16>> declared in
   deploy.yaml; the parse-time validator has already enforced that the
   list is only present on transports whose registry flag
   `supports_multi_instance_server` is true (SOME/IP today). When the
   list is absent, the singular `server.state.service.instance_id` is
   the sole offered instance, and `someip_server_instances` degenerates
   to a 1-element list so every server-side call site iterates the same
   shape regardless of pool arity. #}
{% set has_server_someip_pool = has_server_someip and server.instance_pool %}
{% if has_server_someip %}
{% set someip_server_instances = server.instance_pool if has_server_someip_pool else [server.state.service.instance_id] %}
{% endif %}

{# SCE_MESH.md §14.4 — canonical session count for this router.
   Each SCXML document instance running under the router is a "session"
   (W3C SCXML §2.4). A pool server hosts N independent sessions, each
   backing one offered SOME/IP instance; every other router shape hosts
   exactly one session. `n_sessions` is the single source of truth
   consumed by the `sessions_` array, ctor, per-session callback loop,
   and every dispatch site — no parallel "sender vs pool" codepath. #}
{% if has_server_someip %}
{% set n_sessions = someip_server_instances | length %}
{% else %}
{% set n_sessions = 1 %}
{% endif %}


{# SCE Mesh §9.5 gap Z2: per-server Zenoh queryable response deadline.
   Gate requires BOTH a zenoh server AND the deploy.yaml knob being set.
   Absent knob ⇒ gate false ⇒ zero lines of Z2 code — matches the
   pre-Z2 behaviour where `pending_server_queries_` leaks entries
   whose engine never emits the paired response. Zenoh-only today;
   SOME/IP's server-side lifecycle differs and has no gap memo yet. #}
{% set has_server_query_timeout = has_server_zenoh and server.query_timeout_ms is defined %}

{# SCE Mesh §16.7 row 8 (PEER_PARTITIONED): per-machine opt-in liveliness.
   `machine_liveliness` is null when the deploy.yaml author omitted the
   `liveliness:` section; present-but-truthy when they declared one.
   Liveliness is a Zenoh-only feature today (zenoh-cpp native API), so
   the emission gate requires BOTH a zenoh transport on this machine AND
   the opt-in section. A SCXML that never sends over zenoh pays zero LoC
   even if the deploy.yaml declared a liveliness block by mistake. #}
{% set has_zenoh_liveliness = ("zenoh" in transport_types) and machine_liveliness %}

{# Emission gate for Zenoh client-side `session.get` on_drop wiring
   (SCE Mesh gap Z3). The on_drop closure early-cancels a mesh-rpc
   invoke whose query terminated without a reply, so `error.invoke.<id>`
   surfaces in milliseconds instead of waiting out `_mesh_deadline_ms`.
   Gate requires BOTH zenoh transport AND `<invoke type="sce:mesh-rpc">`
   on this machine — without mesh-rpc the outbound envelope never
   stamps `invoke_id`, so there is no correlation entry to cancel. #}
