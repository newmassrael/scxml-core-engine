{% if scxml_remote_inbound_peers %}
    /// SCE_MESH.md §9.6 WorkerSessionHost — child session registry and
    /// lifecycle driver for remote `<invoke type="scxml" src="#{{ machine_name }}">`.
    ///
    /// Each wire-14 `InvokeStart` creates a new `ChildSessionAdapter<{{ machine_name }}>`,
    /// initialises its engine, and publishes wire-15 `InvokeStarted` back.
    /// The host then ticks all active children at the worker's cadence and
    /// emits wire-16 `ChildEvent` (child → parent sends), wire-18
    /// `InvokeDone` (final reached), or wire-20 `InvokeError` (instantiation
    /// failure). The `sessions_` map is keyed on the parent-side invoke_id
    /// string (compile-time `_invoke_N` suffix) so every envelope the
    /// child receives (wire-17, wire-19) is routed by `env.subject`.
    ///
    /// Orthogonal to the TransportRouter's `sessions_` array — that array
    /// holds N_SESSIONS compile-time main engine instances (one per hosted
    /// machine on this device). `WorkerSessionHost::sessions_` holds
    /// runtime-dynamic child instances of this machine class that were
    /// spawned by remote invokes.
    class WorkerSessionHost {
    public:
        using ChildEngine = ::SCE::Generated::{{ machine_name }}{% if partition_wire21_self %}::P_{{ partition_wire21_self }}{% endif %}::{{ machine_name }};
        using ChildAdapter = ::SCE::Mesh::ChildSessionAdapter<ChildEngine>;

        explicit WorkerSessionHost(std::string host_machine_name)
            : host_machine_name_(std::move(host_machine_name)) {}

        void onWire14(const ::SCE::Mesh::MeshEnvelope& env,
                      ::SCE::Mesh::ChildToParentPublisher send_ctp) {
            if (!env.subject || !env.invoke_id) {
                return;
            }
            const std::string invoke_id_str = *env.subject;
            const std::array<uint8_t, 16> invoke_uuid = *env.invoke_id;
            std::string session_id = env.source + ":" + invoke_id_str;

            auto adapter = std::make_unique<ChildAdapter>(
                host_machine_name_,
                session_id,
                invoke_uuid,
                invoke_id_str,
                env.source,
                send_ctp);

            // Publish wire-15 `InvokeStarted` BEFORE the child's first
            // macrostep. `engine().initialize()` may invoke `<onentry>`
            // bodies that emit `<send target="#_parent">`, each of which
            // the mesh callback translates into a wire-16 `ChildEvent`.
            // The parent's `onInvokeStarted` consumer stashes the child
            // session URI on wire-15; if wire-16 overtook wire-15, the
            // parent's `executeFinalizeForChildEvent` would see an empty
            // `childSession.sessionId` and skip `<finalize>` — silently
            // violating W3C §6.4.4 ordering (feedback_silently_broken_hooks).
            ::SCE::Mesh::MeshEnvelope started{};
            started.id = SCE::uuid::v7();
            started.source = host_machine_name_;
            started.type = "sce.invoke.started";
            started.pattern = ::SCE::Mesh::PatternKind::InvokeStarted;
            started.invoke_id = invoke_uuid;
            started.subject = invoke_id_str;
            started.child_session_id = session_id;
            (void)send_ctp(started);

            // W3C SCXML B.1: Forward the build-configured script engine to the
            // child adapter before initialize() — generated
            // Policy::getScriptEngine() throws when unset. The host owns no
            // engine of its own, so it routes through ScriptEngineProvider
            // (compile-time selected). Aliasing shared_ptr + no-op deleter:
            // lifetime is owned by the provider singleton. The setter is a
            // no-op when ChildEngine does not need a script engine.
            adapter->engine().setScriptEngine(::std::shared_ptr<::SCE::IScriptEngine>(
                &::SCE::ScriptEngineProvider::getScriptEngine(),
                [](::SCE::IScriptEngine*){}));

            adapter->engine().initialize();

            if (adapter->isFinal()) {
                emitWire18(*adapter, send_ctp);
                return;
            }
            sessions_.emplace(invoke_id_str, std::move(adapter));
        }

        void onWire17(const ::SCE::Mesh::MeshEnvelope& env) {
            if (!env.subject) return;
            auto it = sessions_.find(*env.subject);
            if (it == sessions_.end()) return;
            std::string data(env.data.begin(), env.data.end());
            (void)it->second->raiseExternal(env.type, data, std::string());
        }

        void onWire19(const ::SCE::Mesh::MeshEnvelope& env) {
            if (!env.subject) return;
            auto it = sessions_.find(*env.subject);
            if (it == sessions_.end()) return;
            it->second->cancel();
            sessions_.erase(it);
        }

        void tick(std::function<::SCE::Mesh::ChildToParentPublisher(const std::string&)> send_ctp_for) {
            for (auto it = sessions_.begin(); it != sessions_.end();) {
                it->second->tick();
                if (it->second->isFinal()) {
                    auto publisher = send_ctp_for(it->second->parentPeer());
                    emitWire18(*it->second, publisher);
                    it = sessions_.erase(it);
                } else {
                    ++it;
                }
            }
        }

        std::size_t activeCount() const { return sessions_.size(); }

    private:
        void emitWire18(::SCE::Mesh::IChildSession& s,
                        ::SCE::Mesh::ChildToParentPublisher& send_ctp) {
            ::SCE::Mesh::MeshEnvelope done{};
            done.id = SCE::uuid::v7();
            done.source = host_machine_name_;
            done.type = "sce.invoke.done";
            done.pattern = ::SCE::Mesh::PatternKind::InvokeDone;
            done.invoke_id = s.invokeUuid();
            done.subject = s.invokeIdString();
            done.child_session_id = s.sessionId();
            std::string donedata = s.getDonedata();
            done.data.assign(donedata.begin(), donedata.end());
            done.datacontenttype = donedata.empty()
                ? ::SCE::Mesh::PayloadCodec::None
                : ::SCE::Mesh::PayloadCodec::Json;
            (void)send_ctp(done);
        }

        std::string host_machine_name_;
        std::unordered_map<std::string, std::unique_ptr<::SCE::Mesh::IChildSession>> sessions_;
    };

    WorkerSessionHost worker_session_host_;
{% endif %}

