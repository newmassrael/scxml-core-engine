        std::size_t total = 0;
{% for r in partition_wire21_inbound_sources %}
        if (!wire21_from_{{ r.src_partition_snake }}_.valid()) {
            wire21_from_{{ r.src_partition_snake }}_ = PartitionWire21Channel(
                PARTITION_WIRE21_FROM_{{ r.src_partition_snake | upper }},
                PartitionWire21Channel::Mode::Open);
