{# SCE Mesh — unified transport routing (per-target transport dispatch).

   Each target's transport type determines its send function and router field.
   Supports mixed transports: e.g. #motor via local, #display via shm,
   #logger via someip, #telemetry via zenoh.

   Template structure:
     (A) Includes                     — keyed by `transport_types`
     (B) Per-target constants         — keyed by `target.state.kind`
     (C) Per-target send functions    — keyed by `target.state.kind`
     (D) TransportRouter
         D1. Per-target fields        — iterates `target.has_per_target_field`
         D2. Shared transport fields  — keyed by `transport_types`
         D3. Constructor              — iterates `target.has_per_target_ctor_init`
         D4. init() / shutdown()      — keyed by `transport_types` (shared resources)
         D5. route_send() dispatch    — keyed by `target.state.kind`

   Adding a new transport (authoritative registry lives in transport.rs):
     (1) Add one entry to `transport::lookup()` with shape + capabilities
         + `implemented: true`.
     (2) If device-shared session config is needed, add a typed field to
         `deploy::TransportConfigs` (parse-time validated by serde), then
         thread it through `generate_mesh` as a new parameter.
     (3) Add {% elif %} blocks in this template at "NEW TRANSPORT" markers.

   Per-target vs shared: per-target transports (local, shm, someip) emit
   one field per target and one init-list entry per target. Shared-session
   transports (zenoh) emit a single device-wide field initialized in init().

   Transport types handled:
     local  — same-process direct call (inlined by compiler)
     shm    — shared memory cross-process via ShmChannel
     someip — SOME/IP over Ethernet via vsomeip (per-target application)
     zenoh  — Zenoh pub/sub via zenoh-cpp (device-shared session) #}

{# ── Jinja2 macros: SOME/IP boilerplate extraction ─────────
   Eliminates three near-identical request-build sequences (RPC / FieldRead /
   FieldWrite) and four near-identical receive-handler shells (RPC response /
   event notify / getter resp / setter resp). RPC response path injects
   correlation lookup; all others share the decode-and-dispatch body. #}

{% macro someip_send_request(target, method_constant) -%}
        auto request = vsomeip::runtime::get()->create_request(
            {% if target.state.extra.protocol is defined and target.state.extra.protocol == "tcp" %}true{% else %}false{% endif %});
        request->set_service(SOMEIP_SERVICE_{{ target.target_snake | upper }});
        request->set_instance(SOMEIP_INSTANCE_{{ target.target_snake | upper }});
        request->set_method({{ method_constant }});
        auto buf = SCE::Mesh::encodeEnvelope(env);
        auto payload = vsomeip::runtime::get()->create_payload(
            reinterpret_cast<const vsomeip::byte_t*>(buf.data()),
            static_cast<uint32_t>(buf.size()));
        request->set_payload(payload);
        app.send(request);
        return true;
{%- endmacro %}

{% macro someip_receive_handler(target, method_constant, pattern_kind, kind) -%}
        {{ target.target_snake }}_app_->register_message_handler(
            SOMEIP_SERVICE_{{ target.target_snake | upper }},
{% if target.pool_plan and target.pool_plan.kind == "someip" %}
            // SCE_MESH.md §14.4 SOME/IP pool: register once for every
            // instance in the set. vsomeip application_impl.cpp:683/700/745
            // treats ANY_INSTANCE as a wildcard for handler-side APIs
            // (unlike request_service, which treats it as a literal id —
            // see next_session_phase5_binding_placeholder.md). Replies
            // from any pool member reach the same correlation table.
            vsomeip::ANY_INSTANCE,
{% else %}
            SOMEIP_INSTANCE_{{ target.target_snake | upper }},
{% endif %}
            {{ method_constant }},
            [this](const std::shared_ptr<vsomeip::message>& msg) {
{% if kind == "rpc" %}
                if (msg->get_return_code() != vsomeip::return_code_e::E_OK
                    && msg->get_message_type() != vsomeip::message_type_e::MT_RESPONSE) return;
{% elif kind == "field" %}
                if (msg->get_message_type() != vsomeip::message_type_e::MT_RESPONSE) return;
{% endif %}
                auto pl = msg->get_payload();
                if (!pl) return;
                SCE::Mesh::MeshEnvelope env;
                if (!SCE::Mesh::decodeEnvelope(pl->get_data(), pl->get_length(), env)) {{ raise_envelope_corrupt("someip") }}
{% if kind == "rpc" %}
                // Correlation: look up reply-event name for this correlation_id
                if (env.correlation_id) {
                    std::lock_guard<std::mutex> lock(correlation_mutex_);
                    auto it = pending_rpcs_.find(CorrelationKey{*env.correlation_id});
                    if (it != pending_rpcs_.end()) {
                        env.type = it->second;
                        env.pattern = SCE::Mesh::PatternKind::RpcReply;
                        pending_rpcs_.erase(it);
                    }
                }
{% else %}
                env.pattern = {{ pattern_kind }};
{% endif %}
                // Dispatch result ignored intentionally — unknown event
                // names in the sender policy drop the envelope, which is
                // the desired behavior for unmatched inbound messages.
                // SCE_MESH.md §10.5 / §10.6: per-binding admit layering.
                // A SOME/IP binding pinned to `protocol: tcp` rides a
                // single TCP stream per client↔server pair — duplicates
                // are physically impossible and the runtime DedupWindow
                // is bypassed. Unpinned (UDP-default) bindings route
                // through `admitInbound` to filter on (source, id). When
                // the binding additionally declares `ordering: required`,
                // the path becomes `admitOrdered` — the ordering buffer
                // runs first and chains dedup internally. Forwarded to
                // the shared `admit_or_dispatch` macro so every inbound
                // call site reads identically.
                //
                // session_idx is hard-coded `0`: this macro only fires
                // on client-side SOME/IP receive handlers, which never
                // drive a server pool (SCE_MESH.md §14.4 scopes the
                // pool shape to SOME/IP server transports). Pool +
                // mesh-rpc-client is rejected at codegen so N_SESSIONS
                // is always 1 here.
                (void)this->{{ admit_or_dispatch(target.needs_ordering, target.needs_dedup, "env", "0") }};
            });
{%- endmacro %}
{#
  SCE_MESH.md §10.5: single decision point for every inbound call site
  that can see an envelope from a transport with `supplies_dedup: false`.

  `condition` is the flag the caller wants to gate on:
    * `server_needs_dedup` for server-side handlers (SOME/IP method
      callbacks, Zenoh queryable / put-subscriber). True whenever the
      server is served by an undeduped transport.
    * `has_undeduped_transport` for client-side closures invoked by
      `send_zenoh` (Zenoh reply + subscribe). True whenever ANY target
      on the machine routes through an undeduped transport, which is
      the same condition that emits the `admitInbound` method itself,
      so the fallback branch is unreachable on today's registry.

  `env_name` names the C++ variable holding the decoded envelope at
  the call site (`env`, `resp`, `notify`, …). `session_idx_expr` is a
  C++ expression that evaluates to the sessions_ slot this envelope
  should dispatch into (SCE_MESH.md §14.4). SOME/IP server handlers
  pass `session_index_for_instance(server_instance)`; every other
  call site passes `0` because its inbound path is not server-pool
  multi-session. The caller supplies the `(void)this->…;` wrapper and
  any leading indentation, so the macro stays a one-line expression.
#}
{%- macro dedup_or_dispatch(condition, env_name, session_idx_expr) -%}
{%- if condition -%}
admitInbound({{ env_name }}, {{ session_idx_expr }})
{%- else -%}
dispatchToSession({{ env_name }}, {{ session_idx_expr }})
{%- endif -%}
{%- endmacro %}

{# SCE_MESH.md §16.7 row 4 — ENVELOPE_CORRUPT raise block. Used at
   every codegen call site of `decodeEnvelope` so a CBOR
   deserialization failure surfaces as `error.communication` with the
   row-4 catalog shape instead of a silent return. One-line expansion
   so the macro can replace the existing `return;` token without
   disturbing the caller's indentation. `transport` is the literal
   string the catalog row carries ("someip" / "zenoh" — extend when a
   new transport that decodes envelopes lands). `codec` is always
   "cbor" today (MeshEnvelope wire is canonical CBOR per §7.5);
   `position` stays absent because tinycbor's bool return does not
   expose a post-failure cursor. #}
{%- macro raise_envelope_corrupt(transport) -%}
{ ::SCE::Mesh::CommunicationError __sce_decode_err; __sce_decode_err.reason = ::SCE::Mesh::ReasonCode::EnvelopeCorrupt; __sce_decode_err.transport = "{{ transport }}"; __sce_decode_err.codec = "cbor"; raiseCommunicationError(std::move(__sce_decode_err)); return; }
{%- endmacro %}
{# Lambda-body variant: same emit, no trailing `return;`. Used at
   hand-written endpoint decode-error callback sites (`ShmChannel::drainWith`,
   `CustomTcp` read loops, `ZenohScxmlInvokeEndpoint` /
   `SomeipScxmlInvokeEndpoint` subscribers) where the caller supplies a
   `void()` lambda whose body emits Row 4 and falls off naturally — the
   bool-returning early-exit shape of `raise_envelope_corrupt` is wrong
   for those call sites. #}
{%- macro raise_envelope_corrupt_lambda(transport) -%}
{ ::SCE::Mesh::CommunicationError __sce_decode_err; __sce_decode_err.reason = ::SCE::Mesh::ReasonCode::EnvelopeCorrupt; __sce_decode_err.transport = "{{ transport }}"; __sce_decode_err.codec = "cbor"; raiseCommunicationError(std::move(__sce_decode_err)); }
{%- endmacro %}
{#
  SCE_MESH.md §10.6: per-target admit layering for ordered routes.

  `needs_ordering` and `needs_dedup` are the per-binding flags computed
  by `compute_needs_ordering` / `compute_needs_dedup` in codegen.rs.
  The three-layer chain (ordering → dedup → dispatch) is emitted as a
  single method name at each inbound call site, so the generated code
  contains no dead branches:

    * ordered route + undeduped transport → `admitOrdered`
      (internally consults dedup on each released envelope)
    * undeduped transport, no ordering requirement → `admitInbound`
    * neither → `dispatchToSession` direct

  `session_idx_expr` carries the same session-routing contract as
  `dedup_or_dispatch` above (SCE_MESH.md §14.4). All admit layers
  forward it untouched to the final `dispatchToSession` call so a
  SOME/IP server-pool envelope lands on the session whose offered
  instance received it.

  Server-side closures and zenoh client-side reply/subscribe closures
  keep using the machine-wide `dedup_or_dispatch` macro above; the
  per-binding `ordering: required` declaration only addresses
  client-target dispatch today, so the server side does not enter the
  ordering branch until SCE_MESH.md §10.6 is extended with a server
  schema.
#}
{%- macro admit_or_dispatch(needs_ordering, needs_dedup, env_name, session_idx_expr) -%}
{%- if needs_ordering -%}
admitOrdered({{ env_name }}, {{ session_idx_expr }})
{%- elif needs_dedup -%}
admitInbound({{ env_name }}, {{ session_idx_expr }})
{%- else -%}
dispatchToSession({{ env_name }}, {{ session_idx_expr }})
{%- endif -%}
{%- endmacro %}
