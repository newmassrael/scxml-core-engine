        for (std::size_t i = 0; i < N_SESSIONS; ++i) {
            sessions_[i]->setMeshSendCallback(
                [this, i](const std::string& target, const std::string& eventName,
                          const std::string& data, const std::string& /*sendId*/,
                          const std::string& invokeId) -> bool {
                SCE::Mesh::MeshEnvelope env;
                env.id = SCE::uuid::v7();
                env.source = "{{ machine_name }}";
                env.routing_id = routing_id_;
                env.type = eventName;
                env.pattern = resolvePattern(eventName);
                env.datacontenttype = data.empty()
