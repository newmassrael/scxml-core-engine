{% endfor %}
{% for peer in scxml_remote_inbound_peers if peer.transport == "zenoh" %}
        scxml_invoke_to_{{ peer.name }}_.reset();
{% endfor %}
        zenoh_session_.reset();
{% endif %}
{% if "custom_tcp" in transport_types and custom_tcp_transport and custom_tcp_transport.listen %}
