            // response. Accepts MT_REQUEST, dispatches the envelope, and
            // returns — no create_response call and no pending_server_requests
            // stash because there is nothing to correlate. env.type /
            // env.pattern are trusted from the decoded envelope.
            server_app_->register_message_handler(
                SOMEIP_SERVER_SERVICE, server_instance,
                SOMEIP_SERVER_FIRE_FORGET_{{ ff.event_const }},
                [this, server_instance](const std::shared_ptr<vsomeip::message>& msg) {
                    if (msg->get_message_type() != vsomeip::message_type_e::MT_REQUEST) return;
                    // §14.4: session lookup identical to the RPC handler
                    // above (same drift-sentinel guard).
                    const auto session_idx = session_index_for_instance(server_instance);
                    if (session_idx == N_SESSIONS) {
                        SCE_LOG_ERROR(
                            "SOME/IP FireForget handler: instance {} not in declared pool (drift); dropping",
                            server_instance);
                        return;
                    }
                    auto pl = msg->get_payload();
                    if (!pl) return;
                    SCE::Mesh::MeshEnvelope env;
                    if (!SCE::Mesh::decodeEnvelope(pl->get_data(), pl->get_length(), env)) {{ raise_envelope_corrupt("someip") }}
                    // SCE_MESH.md §10.5: same server-side dedup gate as the
                    // RPC handler above.
                    (void)this->{{ dedup_or_dispatch(server_needs_dedup, "env", "session_idx") }};
                });
{% endfor %}
{% for fa in server.field_access_pairs if fa.method_id %}
            // FieldAccess inbound handler (SCE_MESH.md §8.3): getter/setter
            // requests share the RPC response path — the engine raises
            // `field.notify.X`, inject_server_response_sends appends a
            // synthetic <send>, and handleServerResponse routes it via
            // `create_response` on the original request. env.type /
            // env.pattern are trusted from the decoded envelope.
            server_app_->register_message_handler(
                SOMEIP_SERVER_SERVICE, server_instance,
                SOMEIP_SERVER_{{ fa.kind | upper }}_{{ fa.event_const }},
                [this, server_instance](const std::shared_ptr<vsomeip::message>& msg) {
                    if (msg->get_message_type() != vsomeip::message_type_e::MT_REQUEST) return;
                    // §14.4: session lookup identical to the RPC / FireForget
                    // handlers above (same drift-sentinel guard).
                    const auto session_idx = session_index_for_instance(server_instance);
                    if (session_idx == N_SESSIONS) {
                        SCE_LOG_ERROR(
                            "SOME/IP FieldAccess handler: instance {} not in declared pool (drift); dropping",
                            server_instance);
                        return;
                    }
                    auto pl = msg->get_payload();
                    if (!pl) return;
                    SCE::Mesh::MeshEnvelope env;
                    if (!SCE::Mesh::decodeEnvelope(pl->get_data(), pl->get_length(), env)) {{ raise_envelope_corrupt("someip") }}
                    // Stash original request (key symmetry with the RPC
                    // handler: invoke_id first, correlation_id fallback,
                    // fresh UUID last). handleServerResponse looks the
                    // message back up and calls create_response on it.
                    auto cid = env.invoke_id.value_or(
                        env.correlation_id.value_or(SCE::uuid::v7()));
                    {
                        std::lock_guard<std::mutex> lock(server_pending_mutex_);
                        pending_server_requests_[CorrelationKey{cid}] = msg;
                    }
                    env.correlation_id = cid;
                    // SCE_MESH.md §10.5: same server-side dedup gate as the
                    // RPC / FireForget handlers above.
                    (void)this->{{ dedup_or_dispatch(server_needs_dedup, "env", "session_idx") }};
                });
{% endfor %}
{% for eg in server.eventgroup_events if eg.event_group_id %}
            // Eventgroup notification (SCE_MESH.md §8.1): offer the event so
            // clients that subscribe to this eventgroup receive notify messages
            // via vsomeip multicast. offer_event MUST precede start().
            server_app_->offer_event(
                SOMEIP_SERVER_SERVICE, server_instance,
                SOMEIP_SERVER_EVENT_{{ eg.event_const }},
                {SOMEIP_SERVER_EVENTGROUP_{{ eg.event_const }}});
{% endfor %}
        }
        server_thread_ = std::thread([this]{ server_app_->start(); });
{% endif %}
{% if has_server_zenoh %}
        // Server Zenoh: declare queryable for session.get-based patterns
        // (RpcRequest, FieldRead). Must happen after zenoh session open.
        // env.type / env.pattern are trusted from the decoded envelope —
        // the client encoded them via resolvePattern before session.get.
        zenoh_queryable_.emplace(zenoh_session_->declare_queryable(
            zenoh::KeyExpr(ZENOH_SERVER_KEY),
            [this](const zenoh::Query& query) {
                auto payload_opt = query.get_payload();
                if (!payload_opt.has_value()) return;
                auto bytes = payload_opt->get().as_vector();
                SCE::Mesh::MeshEnvelope env;
                if (!SCE::Mesh::decodeEnvelope(bytes.data(), bytes.size(), env)) {{ raise_envelope_corrupt("zenoh") }}
                // Key by invoke_id when available (mesh-rpc invoke path) so the
                // outbound response can be correlated through the engine's
                // currentEventInvokeId without an extra mapping table. Falls
                // back to correlation_id (SOME/IP client sets it) or a fresh
                // UUID (plain <send> path — single outstanding request).
                auto cid = env.invoke_id.value_or(
                    env.correlation_id.value_or(SCE::uuid::v7()));
                {
                    std::lock_guard<std::mutex> lock(server_pending_mutex_);
                    pending_server_queries_.insert_or_assign(CorrelationKey{cid}, query.clone());
{% if has_server_query_timeout %}
                    // SCE Mesh gap Z2: arm the deadline under the same
                    // lock as the insert so `handleServerResponse`'s
                    // cancel-before-erase cannot observe a half-built
                    // entry. `registerDeadline` returns false on a
                    // duplicate cid — the map's `insert_or_assign` just
                    // replaced an entry, so the same cid's timer is still
                    // live and the new one is implicitly coalesced to
                    // the earlier deadline (§9.5 benign-drop: the next
                    // responder wins). No re-arm race because inbound
                    // queries always carry a fresh UUIDv7 cid.
                    (void)deadline_scheduler_.registerDeadline(
                        cid,
                        std::chrono::milliseconds({{ server.query_timeout_ms }}),
                        [this, cid]() noexcept { onServerQueryTimedOut(cid); });
{% endif %}
                }
                env.correlation_id = cid;
                // SCE_MESH.md §10.5: Zenoh server queryable gate. Uses
                // the same `server_needs_dedup` flag as the SOME/IP
                // server handlers above so all server-side inbound
                // call sites read identically. Today's Zenoh
                // classification (`supplies_dedup = false`) forces
                // `server_needs_dedup = true` whenever this block
                // emits, so the fallback is unreachable — it is
                // retained so a future registry shift (e.g. Zenoh
                // gaining a reliable-unicast profile that supplies
                // dedup) lands correctly without template edits.
                //
                // session_idx is `0`: SCE_MESH.md §14.4 scopes the
                // multi-instance server pool shape to SOME/IP only,
                // so every Zenoh server router runs with N_SESSIONS
                // == 1 and the queryable dispatches to sessions_[0].
                (void)this->{{ dedup_or_dispatch(server_needs_dedup, "env", "0") }};
            },
            // Queryable on_drop: zenoh invokes this once when the
            // Queryable handle is destroyed (shutdown() resets
            // `zenoh_queryable_`). Pending query state, if any, is
            // managed by `pending_server_queries_` — that map is
            // cleared as part of the router teardown sequence and does
            // not need per-drop bookkeeping here.
            []() noexcept {}));
{% if server.has_server_put %}
        // Server Zenoh inbound-put subscriber (SCE_MESH.md §8.3).
        // `session.put` from clients does not trigger the queryable, so a
        // parallel subscriber is declared on the same server key. The
        // decoded envelope carries the real event name and pattern (the
        // client stamped env.pattern via resolvePattern); the subscriber
        // forwards it to dispatchToSession unchanged.
        zenoh_server_put_sub_.emplace(zenoh_session_->declare_subscriber(
            zenoh::KeyExpr(ZENOH_SERVER_KEY),
            [this](const zenoh::Sample& sample) {
                auto bytes = sample.get_payload().as_vector();
                SCE::Mesh::MeshEnvelope env;
                if (!SCE::Mesh::decodeEnvelope(bytes.data(), bytes.size(), env)) {{ raise_envelope_corrupt("zenoh") }}
                // Skip self-published eventgroup notifications. When the
                // server publishes via session.put on ZENOH_SERVER_KEY, this
                // subscriber also receives the event. Filtering by source
                // avoids a self-loop that would dispatch the server's own
                // notification back to its engine.
                //
                // Limitation: in multi-instance deployments where two
                // Self-echo gate keys on `routing_id` (SCE_MESH.md §10.8):
                // two sessions of the same machine_name generate distinct
                // routing_ids at ctor time, so a session receiving its
                // peer-session's put recognises it as non-self and passes
                // through. Envelopes from peers that have not yet been
                // migrated to stamp `routing_id` (Gap 3b-3e) carry an
                // absent optional, which compares unequal to the local
                // `routing_id_` bytes and therefore passes the gate — the
                // cross-backend echo path is unblocked during per-backend
                // rollout.
                if (env.routing_id.has_value() && *env.routing_id == routing_id_) return;
                // SCE_MESH.md §10.5: Zenoh server put-subscriber gate —
                // same `server_needs_dedup` flag as the queryable above.
                // session_idx is `0`: Zenoh is excluded from the pool
                // shape (SCE_MESH.md §14.4), so N_SESSIONS is 1.
                (void)this->{{ dedup_or_dispatch(server_needs_dedup, "env", "0") }};
            },
            // Server put-subscriber on_drop: zenoh invokes this once
            // when the Subscriber handle is destroyed (shutdown() resets
            // `zenoh_server_put_sub_`). The subscriber keeps no
            // per-sample state — each inbound put is processed
            // synchronously in the on_sample closure above — so teardown
            // is purely handle destruction.
            []() noexcept {}));
{% endif %}
{% endif %}
{% if machine_subscriptions %}
        // Machine-lifetime subscriptions (SCE_MESH.md §13 deploy.yaml path).
        // Subscribe on init, unsubscribe on shutdown. Each entry came from
        // deploy.yaml `machines.<name>.subscriptions[*]`.
{% for sub in machine_subscriptions %}
        {
            SCE::Mesh::MeshEnvelope sub_env;
            sub_env.id = SCE::uuid::v7();
            sub_env.source = "{{ machine_name }}";
            sub_env.routing_id = routing_id_;
            sub_env.type = "{{ sub.event }}";
            sub_env.pattern = SCE::Mesh::PatternKind::EventSubscribe;
            sub_env.datacontenttype = SCE::Mesh::PayloadCodec::None;
            (void)route_send("{{ sub.source }}", sub_env);
        }
{% endfor %}
{% endif %}
{% if has_ordered_binding %}
        // SCE_MESH.md §10.6.4 periodic tick. Started last so a partial
        // init() that returned false above did not leave a joinable
        // thread behind for shutdown() to manage. The thread reads
        // `ordering_tick_shutdown_` (atomic, initialized to false) and
        // exits on the next wakeup once shutdown() flips it.
        ordering_tick_thread_ = std::thread(&TransportRouter::orderingTickLoop, this);
{% endif %}
        return true;
    }

{% if "custom_tcp" in transport_types and custom_tcp_transport and custom_tcp_transport.listen %}
    /// SCE_MESH.md §9.6 / §16.8.3 — kernel-assigned endpoint readback for
    /// the device-shared custom_tcp server. Intended consumer is the
    /// two-process cross-device harness: when deploy.yaml declares
    /// `transports.custom_tcp.listen: "127.0.0.1:0"` the actual port is
    /// chosen by `bind()` inside `init()`, so the harness reads the
    /// chosen `host:port` back via this getter and exports it to the
    /// dialing peer (who feeds it into its own `init(PortOverride)`).
    ///
    /// Returns `std::nullopt` when `init()` has not run, failed to bind,
    /// or `shutdown()` has already closed the listen fd. The narrow
    /// forwarding keeps the field encapsulated — callers should not
    /// reach into `custom_tcp_server_` directly — and the nullopt path
    /// matches `Server::local_endpoint()`'s own contract so the
    /// interface stays thin.
    [[nodiscard]] std::optional<std::string> custom_tcp_local_endpoint() const {
        return custom_tcp_server_ ? custom_tcp_server_->local_endpoint()
                                  : std::nullopt;
    }

{% endif %}
    /// Stop all transport connections and release shared resources.
    void shutdown() {
{% if has_ordered_binding %}
        // Stop the periodic ordering tick before transport shutdown so
        // no late tick fires while the sender engine reference may be
        // racing another teardown path. Idempotent: after the first
        // call, `joinable()` returns false and subsequent calls are
        // no-ops (dtor-via-shutdown safety).
        //
        // The flag flip is performed under `ordering_tick_mutex_` so
        // the waiting thread cannot miss the wakeup — if the worker's
        // predicate check and our store interleave without the lock,
        // a just-started wait could block until the next tick period
        // despite the shutdown signal. Standard condvar teardown
        // idiom (cppreference `notify_all` guidance).
        {
            std::lock_guard<std::mutex> lk(ordering_tick_mutex_);
            ordering_tick_shutdown_.store(true);
        }
        ordering_tick_cv_.notify_all();
        if (ordering_tick_thread_.joinable()) {
            ordering_tick_thread_.join();
        }
{% endif %}
{% if has_mesh_rpc.v %}
        // SCE_MESH.md §10.4.1 row 1704 + §16.7 row 5: every outstanding
        // `<invoke type="sce:mesh-rpc">` whose reply has not yet
        // arrived is failed with `error.communication` carrying
        // `reason="INVOKE_CHILD_LOST"` + `invoke_id` + `target`. Runs
        // BEFORE transport teardown so the sender engine's external
        // queue still accepts the event (transports are still up at
        // this point; only the ordering tick has joined). The
        // `cancelAllPending` callback receives `(uuid, target)` per
        // entry; deliver callbacks are NOT fired (cancel-style erase
        // semantics, no synthetic `done.invoke.<id>` / `error.invoke.<id>`).
        // Also drops the matching `active_invokes_` site entries so a
        // racing state-exit `cancelMeshRpc` is a no-op on already-failed
        // invokes.
        invoke_correlation_.cancelAllPending(
            [this](const SCE::Mesh::InvokeCorrelation::Key& uuid,
                   const std::string& target) {
                SCE::Mesh::CommunicationError err;
                err.reason = ::SCE::Mesh::ReasonCode::InvokeChildLost;
                err.invoke_id = SCE::uuid::to_string(uuid);
                err.target = target;
                raiseCommunicationError(std::move(err));
            });
        {
            std::lock_guard<std::mutex> lock(active_invokes_mutex_);
            active_invokes_.clear();
        }
{% endif %}
{% if machine_subscriptions %}
        // Machine-lifetime unsubscribe (reverse of init subscriptions).
{% for sub in machine_subscriptions %}
        {
            SCE::Mesh::MeshEnvelope unsub_env;
            unsub_env.id = SCE::uuid::v7();
            unsub_env.source = "{{ machine_name }}";
            unsub_env.routing_id = routing_id_;
            unsub_env.type = "{{ sub.event }}";
            unsub_env.pattern = SCE::Mesh::PatternKind::EventUnsubscribe;
            unsub_env.datacontenttype = SCE::Mesh::PayloadCodec::None;
            (void)route_send("{{ sub.source }}", unsub_env);
        }
{% endfor %}
{% endif %}
{% for target in targets if target.state.kind == "someip" %}
        if ({{ target.target_snake }}_app_) {{ target.target_snake }}_app_->stop();
        if ({{ target.target_snake }}_thread_.joinable()) {{ target.target_snake }}_thread_.join();
{% endfor %}
{% if has_server_someip %}
        if (server_app_) server_app_->stop();
        if (server_thread_.joinable()) server_thread_.join();
{% endif %}
{#- SCE_MESH.md §9.6.2 Session 4b SOME/IP scxml-invoke app teardown.
    Parallel to the per-`<send>`-target loop above — the dedicated §9.6
    application on this machine is owned separately and torn down
    independently. Idempotent via shared_ptr reset + joinable() guard
    so dtor-via-shutdown does not touch an already-joined thread. #}
{% if scxml_remote_outbound_peers | selectattr("transport", "equalto", "someip") | list or scxml_remote_inbound_peers | selectattr("transport", "equalto", "someip") | list or someip_liveness_service_id_self_hex or someip_machine_liveness_service_id_self_hex %}
        if ({{ someip_sce_app_field }}) {{ someip_sce_app_field }}->stop();
        if ({{ someip_sce_app_thread }}.joinable()) {{ someip_sce_app_thread }}.join();
        {{ someip_sce_app_field }}.reset();
{% endif %}
{% if has_server_zenoh %}
{% if has_server_query_timeout %}
        // SCE Mesh gap Z2: arm the server-side shutdown flag BEFORE
        // tearing down the scheduler so any callback already dispatched
        // on the scheduler thread observes the teardown and bails out
        // before touching `pending_server_queries_`. Release pairs with
        // the acquire load inside `onServerQueryTimedOut`. Then drain
        // the scheduler — this joins its worker thread and drops any
        // remaining pending timers per §9.5 "benign drop" (a router
        // being destroyed cannot deliver further events). Ordering
        // matters: the flag-set must precede the scheduler drain so a
        // callback that has already crossed the scheduler's unlock
        // boundary short-circuits on the flag. `scheduler.shutdown()`
        // is idempotent across the dtor-via-shutdown path.
        server_shutdown_in_progress_.store(true, std::memory_order_release);
        deadline_scheduler_.shutdown();
{% endif %}
{% if server.has_server_put %}
        zenoh_server_put_sub_.reset();
{% endif %}
        zenoh_queryable_.reset();
{% endif %}
{% if "zenoh" in transport_types %}
{% if has_zenoh_mesh_rpc %}
        // SCE Mesh gap Z3: arm the shutdown flag BEFORE any zenoh reset
        // so the cascade of on_drop closures fired by session teardown
        // short-circuits `onZenohQueryDropped` instead of raising late
        // `error.invoke.<id>` on a mid-teardown sender engine. Release
