   so the initializer-list order (server_app_ then sender_) matches
   C++ member declaration order. ── #}
{% if has_server_someip %}
    // Server SOME/IP application. Created in ctor initializer, started
    // in init(). Must be declared before sender_ for -Wreorder safety.
    std::shared_ptr<vsomeip::application> server_app_;
{% endif %}

{# ── (D2b) Sender engine — bound by ctor, dispatched to by transport
   callback threads (vsomeip, zenoh runtime) and by cross-router
   linkTo (local). Storing the reference (instead of a std::function
   like pre-Session D) keeps the dispatch call direct (no type erasure)
   and makes "bound exactly once" a compile-time guarantee via `const`
   — there is no setter to misuse.
   The `local` disjunct was added so a router whose only transport is
   local can still host dispatchToSender and be the inbound target of
   another router's linkTo closure (SCE_MESH.md §9.5 mesh-rpc pairs). ── #}
{% if "someip" in transport_types or "zenoh" in transport_types or "local" in transport_types or "custom_tcp" in transport_types or has_mesh_rpc.v or has_server %}
    // Sender engine reference. Bound in the ctor and never rebound.
    //
    // Thread-safety: the ctor completes-then-publishes the router before
    // init() spawns any transport callback threads, so the write (ctor
    // initializer) happens-before any read (callback thread dispatch)
    // per C++ §32.4.2. `const` prevents accidental reassignment after
    // construction, which removes the data-race hazard that a mutable
    // std::function receive callback would carry.
    //
    // Lifetime contract (caller-enforced):
    //   sender_engine   MUST outlive TransportRouter
    //   TransportRouter MUST outlive any inflight transport operations
    //
    // The second part is honored by shutdown():
    //   - vsomeip::application::stop() joins callback threads before return
    //   - zenoh::Session dtor (via zenoh_session_.reset()) blocks until
    //     all query reply/subscription callbacks finish (z_close semantics)
    // so once shutdown() returns, no callback can still be dispatching
    // through this->sender_. Violating the first part (destroying the
    // sender engine before the router) is a caller bug — the codegen
    // cannot enforce it and there is no runtime check for it.
    SenderEngine& sender_;
{% endif %}

{# ── (D2c) Correlation types + SOME/IP RPC correlation table ── #}
{# CorrelationKey/Hash: needed by client SOME/IP correlation AND/OR
   server pending-request storage. Emitted once under a shared guard. #}
{% if needs_correlation_key %}
    struct CorrelationKey {
        std::array<uint8_t, 16> id;
        bool operator==(const CorrelationKey& o) const { return id == o.id; }
    };
    struct CorrelationKeyHash {
        std::size_t operator()(const CorrelationKey& k) const noexcept {
            constexpr std::size_t FNV_OFFSET = 0xcbf29ce484222325ULL;
            constexpr std::size_t FNV_PRIME  = 0x00000100000001B3ULL;
            std::size_t h = FNV_OFFSET;
            for (auto b : k.id) {
                h ^= static_cast<std::size_t>(b);
                h *= FNV_PRIME;
            }
            return h;
        }
    };
{% endif %}
{% if "someip" in transport_types %}
    // Client SOME/IP RPC correlation: maps correlation_id → reply event name.
    std::mutex correlation_mutex_;
    std::unordered_map<CorrelationKey, std::string, CorrelationKeyHash> pending_rpcs_;
{% endif %}

{# ── (D2d) sce:mesh-rpc invoke bookkeeping (SCE_MESH.md §9.5) ── #}
{% if has_mesh_rpc.v %}
    // invoke_correlation_: 16-byte UUID → deliver callback. Fires at
    // most once per registration, on RpcReply, deadline, or never (on
    // cancel). Correlates mesh-rpc replies back to their originating
    // invoke so the sender engine can raise done.invoke.<id> /
    // error.invoke.<id> with the right EventWithMetadata.invokeId.
    SCE::Mesh::InvokeCorrelation invoke_correlation_;

    // deadline_scheduler_: callback-based timer for _mesh_deadline_ms.
    // Fires invoke_correlation_.handleDeadline(uuid) on expiry, which
    // delivers error.invoke.<id> via the deliver callback registered
    // below. Destructor joins the timer thread; see MeshDeadlineScheduler
    // header for shutdown semantics.
    SCE::Mesh::MeshDeadlineScheduler deadline_scheduler_;

    // active_invokes_: (target, fieldSuffix) → latest invoke UUID.
    // The state-entry callback tracks UUIDs here so state-exit cancel
    // (performMeshCancel) can erase the matching correlation entry
    // without the state machine itself managing UUID storage. Mutex
    // guards concurrent enter/exit from the engine thread against
    // transport callback threads that might fire handleReply in
    // parallel and mutate no shared state (handleReply only touches
    // invoke_correlation_, which has its own mutex).
    //
    // InvokeSiteKey is a typed composite of (target, fieldSuffix). A
    // string-concat key (`target + ":" + fieldSuffix`) would have
    // worked given the SCXML grammar (target starts with `#`, suffix
    // is identifier-safe — no `:` in either), but the collision-free
    // property would be an implicit grammar invariant rather than a
    // type-system guarantee. The struct + dedicated hash makes the
    // composition explicit and is robust against any future grammar
    // change that might allow `:` in either component.
    struct InvokeSiteKey {
        std::string target;
        std::string field_suffix;
        bool operator==(const InvokeSiteKey& o) const noexcept {
            return target == o.target && field_suffix == o.field_suffix;
        }
    };
    struct InvokeSiteKeyHash {
        // Hash combiner: boost::hash_combine pattern (golden ratio
        // mixing constant) — diffuses bits between the two component
        // hashes so prefix-correlated targets (e.g., `#motor1`,
        // `#motor2`) do not concentrate in a small slot range.
        std::size_t operator()(const InvokeSiteKey& k) const noexcept {
            std::size_t h = std::hash<std::string>{}(k.target);
            h ^= std::hash<std::string>{}(k.field_suffix)
                 + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2);
            return h;
        }
    };
    std::mutex active_invokes_mutex_;
    std::unordered_map<InvokeSiteKey, std::array<std::uint8_t, 16>,
                       InvokeSiteKeyHash> active_invokes_;
{% endif %}

{# ── (D2e) Subscription refcount (SCE_MESH.md §13) ── #}
{% if has_pubsub.v %}
    // Per-(target, event) subscription refcount. Parallel regions may
    // subscribe to the same event independently; the transport-native
    // subscribe/unsubscribe fires only on 0→1 / 1→0 transitions.
    // Key: "target|event" (e.g. "#bus|event.subscribe.brake_status").
    // Concurrency: written only from the owning engine's step thread
    // (mesh send callback), same thread-safety model as zenoh_subscribers_.
    std::unordered_map<std::string, int> subscription_refcount_;
{% endif %}

{# ── (D2f) Server-side fields (SCE_MESH.md §13 Session E) ── #}
{% if has_server_someip %}
    // Server SOME/IP pending request storage (server_app_ declared above
    // for initializer-list ordering).
    std::thread server_thread_;
    std::mutex server_pending_mutex_;
    std::unordered_map<CorrelationKey, std::shared_ptr<vsomeip::message>,
                       CorrelationKeyHash> pending_server_requests_;
{% endif %}
{% if has_server_zenoh %}
    // Server Zenoh queryable + pending query storage.
    // Inbound queries are stashed here keyed by correlation_id; when the
    // engine sends service.response.X the handleServerResponse method
    // retrieves the stored Query and calls reply().
    std::optional<zenoh::Queryable<void>> zenoh_queryable_;
    std::mutex server_pending_mutex_;
    std::unordered_map<CorrelationKey, zenoh::Query,
                       CorrelationKeyHash> pending_server_queries_;
{% if server.has_server_put %}
    // Server inbound-put subscriber on ZENOH_SERVER_KEY (SCE_MESH.md §8.3).
    // `session.put` from clients lands on the same key as `session.get`
    // queries, so a parallel subscriber declaration is required — the
    // queryable does not observe puts. One subscriber fans every
    // put-based pattern (FireForget, FieldWrite) by inspecting
    // `env.type` in the decoded envelope and routing through
    // dispatchToSender.
    std::optional<zenoh::Subscriber<void>> zenoh_server_put_sub_;
{% endif %}
{% endif %}

{# ── (D3) Constructor ──
   Sender-first binding: the ctor takes the sender engine and any local
   target engines, wires the mesh-send callback onto the sender in the
   body, and stores a const reference for dispatch use. The previous
   two-step `ctor + wireTo()` pattern has been collapsed into this single
   construction so the invariant "sender is bound before init()" is
   enforced by the type system, not by caller discipline. #}
    TransportRouter(
        SenderEngine& sender
        {%- for target in targets if target.state.kind == "local" -%}
        , {{ target.target_pascal }}Engine& {{ target.target_snake }}
        {%- endfor -%}
    )
{# Initializer list: collect initializer expressions into a list, then
   join with ", ". Declarative composition (as opposed to an imperative
   "is this the first entry?" state machine) makes the ":" / "," layout
   structurally correct for every transport mix — no fixture matrix
   needed to prove the combinatorics. New transports add a single
   `ns.parts` append; separator logic is a fixed `join(", ")`.

   Order MUST mirror the member declaration order above (D1 → D2b), or
   GCC `-Wreorder` (part of `-Wall`) fails compilation at `-Werror`
   whenever the ctor is actually synthesized for a concrete engine type.
   Declarations run per-target-fields first, then `sender_`, so the
   initializers do the same. #}
{%- set emit_sender = "someip" in transport_types or "zenoh" in transport_types or "local" in transport_types or "custom_tcp" in transport_types or has_mesh_rpc.v or has_server -%}
{%- set ns = namespace(parts=[]) %}
{%- for target in targets if target.has_per_target_field %}
{%-   if target.state.kind == "local" %}
{%-     set ns.parts = ns.parts + [target.target_snake ~ "_(" ~ target.target_snake ~ ")"] %}
{%-   elif target.state.kind == "shm" %}
{%-     set ns.parts = ns.parts + [target.target_snake ~ "_(SHM_CHANNEL_" ~ (target.target_snake | upper) ~ ", " ~ target.target_pascal ~ "ShmChannel::Mode::Create)"] %}
{%-   elif target.state.kind == "someip" %}
{#-     Application identity: deploy.yaml `transports.someip.application_name`
        (when present) MUST match an `applications[*].name` in vsomeip.json
        (SCE_MESH.md §13). Fallback is the legacy `<machine>_<target>` — an
        auto-generated identity kept for tests that predate the external
        config integration. `someip_transport.application_name` is a
        pre-escaped C++ string literal, so the template can drop it into the
        ctor call verbatim with no further escaping. #}
{%-     if someip_transport and someip_transport.application_name %}
{%-       set ns.parts = ns.parts + [target.target_snake ~ "_app_(vsomeip::runtime::get()->create_application(" ~ someip_transport.application_name ~ "))"] %}
{%-     else %}
{%-       set ns.parts = ns.parts + [target.target_snake ~ "_app_(vsomeip::runtime::get()->create_application(\"" ~ machine_name ~ "_" ~ target.target_snake ~ "\"))"] %}
{%-     endif %}
{%-   elif target.state.kind == "custom_tcp" %}
{#-     custom_tcp client constructor: connect endpoint is pre-escaped as a
        complete C++ string literal in Rust (TargetStateView::CustomTcp);
        the on_receive callback dispatches inbound envelopes through
        `dispatchToSender` so a single client field handles the duplex
        path the same way SOME/IP and Zenoh do. #}
{%-     set ns.parts = ns.parts + [target.target_snake ~ "_(" ~ target.state.connect ~ ", [this](const SCE::Mesh::MeshEnvelope& env){ (void)this->dispatchToSender(env); })"] %}
{%-   endif %}
{%- endfor %}
{#- Server SOME/IP app init: must appear in declaration order (before sender_).
    The device-level `transports.someip.application_name` identifies the
    CLIENT app on this device. The server role belongs to a different
    machine on the same device and needs a distinct vsomeip application
    identity — reusing the client name collides at `create_application`
    and makes routing-manager selection non-deterministic. The server app
    name is always `<machine>_server`; vsomeip.json's
    `applications[*].name` must declare that convention (e.g.
    `motor_someip_multi_server`). #}
{%- if has_server_someip %}
{%-   set ns.parts = ns.parts + ["server_app_(vsomeip::runtime::get()->create_application(\"" ~ machine_name ~ "_server\"))"] %}
{%- endif %}
{%- if emit_sender %}
{%-   set ns.parts = ns.parts + ["sender_(sender)"] %}
{%- endif %}
{%- if ns.parts %}
        : {{ ns.parts | join(", ") }}
{%- endif %}
    {
        // Install the outbound dispatch hook on the sender engine. All
        // `<send target="#machine"/>` invocations on the sender are
        // rewritten into MeshEnvelopes here and routed to the matching
        // transport via route_send(). Must happen after member
        // initialization because the lambda captures `this`.
        sender.setMeshSendCallback(
            [this](const std::string& target, const std::string& eventName,
                   const std::string& data, const std::string& /*sendId*/,
                   const std::string& invokeId) -> bool {
                SCE::Mesh::MeshEnvelope env;
                env.id = SCE::uuid::v7();
                env.source = "{{ machine_name }}";
                env.type = eventName;
                env.pattern = resolvePattern(eventName);
                env.datacontenttype = data.empty()
                    ? SCE::Mesh::PayloadCodec::None
                    : SCE::Mesh::PayloadCodec::Json;
                env.data.assign(data.begin(), data.end());
                // W3C SCXML 6.4.1 auto-propagation extended to mesh-rpc:
                // stamp env.invoke_id when the outbound pattern is a paired
                // reply (RpcReply / FieldNotify) so the server response
                // handler can correlate back to the stored request. Non-reply
                // patterns leave env.invoke_id unset — invokeId is ignored
                // rather than leaked cross-pattern. A non-parseable invokeId
                // on a reply usually means the triggering event was a
                // non-mesh invoke (e.g. W3C child session "_invoke_0"); log
                // at warn so the mismatch is diagnosable rather than
                // surfacing as a silent deadline timeout on the invoker side.
                if ((env.pattern == SCE::Mesh::PatternKind::RpcReply
                     || env.pattern == SCE::Mesh::PatternKind::FieldNotify)
                    && !invokeId.empty()) {
                    if (auto parsed = SCE::uuid::from_string(invokeId)) {
                        env.invoke_id = *parsed;
                    } else {
                        SCE_LOG_WARN(
                            "Mesh reply to '{}' for event '{}': invokeId '{}' is not "
                            "an RFC 4122 canonical UUID; env.invoke_id left unset and "
                            "receiver correlation will not match",
                            target, eventName, invokeId);
                    }
                }
{% if "someip" in transport_types %}
                // RPC correlation: generate correlation_id and register reply-event
                // (SOME/IP-only — Zenoh's session.get on_reply closure correlates
                // natively without a lookup table).
                if (env.pattern == SCE::Mesh::PatternKind::RpcRequest) {
                    auto cid = SCE::uuid::v7();
                    env.correlation_id = cid;
                    env.reply_to = "{{ machine_name }}";
                    const char* reply = resolveReplyEvent(eventName);
                    if (reply[0] != '\0') {
                        std::lock_guard<std::mutex> lock(correlation_mutex_);
                        pending_rpcs_[CorrelationKey{cid}] = reply;
                    }
                }
{% endif %}
{% if has_pubsub.v %}
                // Subscription refcount (SCE_MESH.md §13): parallel regions
                // may subscribe to the same event independently. The
                // transport-native subscribe/unsubscribe fires only on
                // refcount 0→1 (first subscriber) / 1→0 (last unsubscriber).
                //
                // Refcount key uses the subscribe event name for both
                // subscribe and unsubscribe so they share the same counter.
                using PK = SCE::Mesh::PatternKind;
                if (env.pattern == PK::EventSubscribe) {
                    auto key = target + "|" + eventName;
                    if (subscription_refcount_[key]++ > 0) {
                        return true;  // transport already subscribed
                    }
                }
                if (env.pattern == PK::EventUnsubscribe) {
                    // Derive the subscribe key from the unsubscribe event.
                    // "event.unsubscribe.X" → "event.subscribe.X"
                    std::string sub_event = eventName;
                    const std::string unsub_prefix = "event.unsubscribe";
                    const std::string sub_prefix = "event.subscribe";
                    if (sub_event.compare(0, unsub_prefix.size(), unsub_prefix) == 0) {
                        sub_event = sub_prefix + sub_event.substr(unsub_prefix.size());
                    }
                    auto key = target + "|" + sub_event;
                    auto it = subscription_refcount_.find(key);
                    if (it != subscription_refcount_.end()) {
                        if (--it->second > 0) {
                            return true;  // other regions still subscribed
                        }
                        subscription_refcount_.erase(it);
                    }
                    // Fall through to transport-native unsubscribe (refcount 1→0)
                }
{% endif %}
{% if has_server %}
                // Server response interception (SCE_MESH.md §13 Session E
                // / §8.3): when this machine is serving RPCs or FieldAccess
                // and the outbound pattern is a paired reply (RpcReply /
                // FieldNotify), route through the server response handler
                // instead of target dispatch. The response is correlated
                // by UUID to the inbound request stored at receive time.
                //
                // Correlation bridge: the inbound queryable/message handler
                // keyed the pending request by invoke_id (mesh-rpc path).
                // The engine's currentEventInvokeId propagates as invokeId
                // → env.invoke_id (parsed above). Stamp correlation_id so
                // handleServerResponse finds the stored request.
                if (env.pattern == SCE::Mesh::PatternKind::RpcReply
                    || env.pattern == SCE::Mesh::PatternKind::FieldNotify) {
                    if (!env.correlation_id && env.invoke_id) {
                        env.correlation_id = env.invoke_id;
                    }
{% if server.has_eventgroup %}
                    // Reply path first (correlated to pending request).
                    // Fallback to eventgroup publish (spontaneous
                    // notification with no pending request to correlate).
                    if (handleServerResponse(env)) return true;
                    return publishEventgroupNotify(env);
{% else %}
                    return handleServerResponse(env);
{% endif %}
                }
{% endif %}
                return route_send(target, env);
            });
{% if has_mesh_rpc.v %}

        // SCE_MESH.md §9.5: install the mesh-rpc invoke + cancel hooks
        // so generated onentry / onexit blocks can dispatch through
        // `performMeshInvoke` / `performMeshCancel` without having a
        // direct router reference. The lambdas forward to the member
        // functions below, which own envelope construction, correlation
        // registration, deadline arming, and the active_invokes_
        // bookkeeping that pairs cancel to the right UUID.
        sender.setMeshInvokeCallback(
            [this](const std::string& target, const std::string& fieldSuffix,
                   const std::string& invokeId, const std::string& data) -> bool {
                return this->invokeMeshRpc(target, fieldSuffix, invokeId, data);
            });
        sender.setMeshCancelCallback(
            [this](const std::string& target, const std::string& fieldSuffix) -> bool {
                return this->cancelMeshRpc(target, fieldSuffix);
            });
{% endif %}
    }
{% if "someip" in transport_types or "zenoh" in transport_types or "custom_tcp" in transport_types or has_mesh_rpc.v or has_server %}

{# ── (D4) init() / shutdown() — lifecycle for shared transport resources ── #}
    /// Initialize transport connections and open shared sessions.
    ///
    /// Must be called before route_send() for transports with a connect/start
    /// lifecycle (currently: SOME/IP, Zenoh). Local and SHM transports are
    /// fully initialized in the constructor.
{% if "someip" in transport_types %}
    /// SOME/IP: calls init(), request_service(), and spawns start() in a
    /// background thread for each SOME/IP binding.
{% endif %}
{% if "zenoh" in transport_types %}
    /// Zenoh: opens a single Session configured from deploy.yaml session-level
    /// keys (mode, connect, listen), shared by all Zenoh bindings on this device.
{% endif %}
    ///
    /// @return true if all transport connections initialized successfully.
    ///         On failure, any already-initialized state (spawned SOME/IP
    ///         threads, opened Zenoh session) is torn down via `shutdown()`
    ///         before returning — the router is left in a safe state for
    ///         destruction or a retry.
    [[nodiscard]] bool init() {
        // No sender-binding assertion needed: `sender_` is a non-owning
        // const reference bound in the ctor initializer list, so any
        // attempt to reach init() with an unbound sender would have
        // failed at construction. The happens-before relation between
        // ctor completion and transport callback thread creation still
        // holds (sender_ is written in ctor; threads are created below).
{% for target in targets if target.state.kind == "someip" %}
        if (!{{ target.target_snake }}_app_ || !{{ target.target_snake }}_app_->init()) {
            shutdown();
            return false;
        }
        {{ target.target_snake }}_app_->request_service(
            SOMEIP_SERVICE_{{ target.target_snake | upper }},
            SOMEIP_INSTANCE_{{ target.target_snake | upper }});
{# Per-event receive handlers (SCE_MESH.md §14): one register_message_handler
   per (target, event) so different events on the same target can use
   different methods/event-groups/getters/setters. Dispatch keys on the
   SomeipEventIds discriminator (field_kind).

   Events flagged `skip_receive_handler` (currently: EventUnsubscribe) are
   excluded. EventUnsubscribe is outbound-only and shares the same event_id
   as its paired EventSubscribe — registering a second handler on the same
   (service, instance, event_id) triple would replace the subscribe handler
   in vsomeip. The flag is set by the Rust codegen (codegen.rs) so the
   template never hard-codes wire values. #}
{% for ep in target.event_patterns if not ep.skip_receive_handler %}
{% if ep.field_kind == "method" %}
        // {{ ep.event }} → SOMEIP_METHOD_{{ target.target_snake | upper }}_{{ ep.event_const }}
{{ someip_receive_handler(target, "SOMEIP_METHOD_" + (target.target_snake | upper) + "_" + ep.event_const, "", "rpc") }}
{% elif ep.field_kind == "event_group" %}
        // {{ ep.event }} → SOMEIP_EVENT_{{ target.target_snake | upper }}_{{ ep.event_const }}
{{ someip_receive_handler(target, "SOMEIP_EVENT_" + (target.target_snake | upper) + "_" + ep.event_const, "SCE::Mesh::PatternKind::EventNotify", "notify") }}
{% elif ep.field_kind == "getter" %}
        // {{ ep.event }} → SOMEIP_GETTER_{{ target.target_snake | upper }}_{{ ep.event_const }}
{{ someip_receive_handler(target, "SOMEIP_GETTER_" + (target.target_snake | upper) + "_" + ep.event_const, "SCE::Mesh::PatternKind::FieldNotify", "field") }}
{% elif ep.field_kind == "setter" %}
        // {{ ep.event }} → SOMEIP_SETTER_{{ target.target_snake | upper }}_{{ ep.event_const }}
{{ someip_receive_handler(target, "SOMEIP_SETTER_" + (target.target_snake | upper) + "_" + ep.event_const, "SCE::Mesh::PatternKind::FieldNotify", "field") }}
{% endif %}
{% endfor %}
        {{ target.target_snake }}_thread_ = std::thread([this]{ {{ target.target_snake }}_app_->start(); });
{% endfor %}
{% if "custom_tcp" in transport_types and custom_tcp_transport and custom_tcp_transport.listen %}
        // custom_tcp device-shared server: bind+listen happens in the
        // ctor; failure surfaces as `valid() == false`. Inbound envelopes
        // dispatch through `dispatchToSender` on the per-connection read
        // thread the Server class spawns. SCE_MESH.md §16.8.3.
        custom_tcp_server_ = std::make_unique<SCE::Mesh::CustomTcp::Server>(
            {{ custom_tcp_transport.listen }},
            [this](const SCE::Mesh::MeshEnvelope& env) {
                (void)this->dispatchToSender(env);
            });
        if (!custom_tcp_server_->valid()) {
            shutdown();
            return false;
        }
{% endif %}
{% if "zenoh" in transport_types %}
        try {
{# Base config comes from an external zenoh.json5 (SCE_MESH.md §13) when
   `transports.zenoh.config:` is declared; otherwise the zenoh defaults.
   `zenoh::Config::from_file` throws `zenoh::ZException` on IO/parse failure;
   the surrounding `try` below converts this to `init()` returning false. #}
{% if zenoh_session_json5 and zenoh_session_json5.config_file %}
            auto config = zenoh::Config::from_file({{ zenoh_session_json5.config_file }});
{% else %}
            auto config = zenoh::Config::create_default();
{% endif %}
{# Session config literals are pre-escaped in Rust (codegen::cpp_string_literal). #}
{# The template inserts them verbatim — no manual C++/JSON escaping here.      #}
{# deploy.yaml overrides merge OVER the external file's values.                #}
{% if zenoh_session_json5 and zenoh_session_json5.mode %}
            config.insert_json5("mode", {{ zenoh_session_json5.mode }});
{% endif %}
{% if zenoh_session_json5 and zenoh_session_json5.connect %}
            config.insert_json5("connect/endpoints", {{ zenoh_session_json5.connect }});
{% endif %}
{% if zenoh_session_json5 and zenoh_session_json5.listen %}
            config.insert_json5("listen/endpoints", {{ zenoh_session_json5.listen }});
{% endif %}
            zenoh_session_.emplace(zenoh::Session::open(std::move(config)));
        } catch (const zenoh::ZException&) {
            // Zenoh signals config/open failures via ZException. Unknown
            // exception types should propagate (not be silently converted).
            // Tear down any SOME/IP threads spawned earlier in this init().
            shutdown();
            return false;
        }
{% endif %}
{% if has_server_someip %}
        // Server SOME/IP: offer service + register request handlers.
        // offer_service MUST precede start() (vsomeip requirement).
        if (!server_app_ || !server_app_->init()) {
            shutdown();
            return false;
        }
        server_app_->offer_service(SOMEIP_SERVER_SERVICE, SOMEIP_SERVER_INSTANCE);
{% for pair in server.rpc_pairs if pair.method_id %}
        server_app_->register_message_handler(
            SOMEIP_SERVER_SERVICE, SOMEIP_SERVER_INSTANCE,
            SOMEIP_SERVER_METHOD_{{ pair.event_const }},
            [this](const std::shared_ptr<vsomeip::message>& msg) {
                if (msg->get_message_type() != vsomeip::message_type_e::MT_REQUEST) return;
                auto pl = msg->get_payload();
                if (!pl) return;
                SCE::Mesh::MeshEnvelope env;
                if (!SCE::Mesh::decodeEnvelope(pl->get_data(), pl->get_length(), env)) return;
                // Stash original request for create_response() when the
                // engine sends service.response.X. Key by invoke_id when
                // available (mesh-rpc path) for correlation bridge symmetry
                // with the Zenoh queryable handler. env.type / env.pattern
                // are trusted from the decoded envelope — the client
                // encoded them via resolvePattern before send.
                auto cid = env.invoke_id.value_or(
                    env.correlation_id.value_or(SCE::uuid::v7()));
                {
                    std::lock_guard<std::mutex> lock(server_pending_mutex_);
                    pending_server_requests_[CorrelationKey{cid}] = msg;
                }
                env.correlation_id = cid;
                // SCE_MESH.md §10.5: server-side dedup gate. Today the
                // deploy schema has no server-side `protocol: tcp` knob,
                // so SOME/IP server sockets ride the vsomeip.json-defined
                // endpoint (UDP-default) and `server_needs_dedup` is
                // true. pending_server_requests_ stashing happens BEFORE
                // admit; on a duplicate, the next insert overwrites with
                // the same correlation_id and handleServerResponse
                // still finds a valid entry when the engine replies.
                (void)this->{{ dedup_or_dispatch(server_needs_dedup, "env") }};
            });
{% endfor %}
{% for ff in server.fire_forget_events if ff.method_id %}
        // FireForget inbound handler (SCE_MESH.md §8.3): one-way, no
        // response. Accepts MT_REQUEST, dispatches the envelope, and
        // returns — no create_response call and no pending_server_requests
        // stash because there is nothing to correlate. env.type /
        // env.pattern are trusted from the decoded envelope.
        server_app_->register_message_handler(
            SOMEIP_SERVER_SERVICE, SOMEIP_SERVER_INSTANCE,
            SOMEIP_SERVER_FIRE_FORGET_{{ ff.event_const }},
            [this](const std::shared_ptr<vsomeip::message>& msg) {
                if (msg->get_message_type() != vsomeip::message_type_e::MT_REQUEST) return;
                auto pl = msg->get_payload();
                if (!pl) return;
                SCE::Mesh::MeshEnvelope env;
                if (!SCE::Mesh::decodeEnvelope(pl->get_data(), pl->get_length(), env)) return;
                // SCE_MESH.md §10.5: same server-side dedup gate as the
                // RPC handler above.
                (void)this->{{ dedup_or_dispatch(server_needs_dedup, "env") }};
            });
{% endfor %}
{% for fa in server.field_access_pairs if fa.method_id %}
        // FieldAccess inbound handler (SCE_MESH.md §8.3): getter/setter
        // requests share the RPC response path — the engine raises
        // `field.notify.X`, inject_server_response_sends appends a
        // synthetic <send>, and handleServerResponse routes it via
        // `create_response` on the original request. env.type /
        // env.pattern are trusted from the decoded envelope.
        server_app_->register_message_handler(
            SOMEIP_SERVER_SERVICE, SOMEIP_SERVER_INSTANCE,
            SOMEIP_SERVER_{{ fa.kind | upper }}_{{ fa.event_const }},
            [this](const std::shared_ptr<vsomeip::message>& msg) {
                if (msg->get_message_type() != vsomeip::message_type_e::MT_REQUEST) return;
                auto pl = msg->get_payload();
                if (!pl) return;
                SCE::Mesh::MeshEnvelope env;
                if (!SCE::Mesh::decodeEnvelope(pl->get_data(), pl->get_length(), env)) return;
                // Stash original request (key symmetry with the RPC
                // handler: invoke_id first, correlation_id fallback,
                // fresh UUID last). handleServerResponse looks the
                // message back up and calls create_response on it.
                auto cid = env.invoke_id.value_or(
                    env.correlation_id.value_or(SCE::uuid::v7()));
                {
                    std::lock_guard<std::mutex> lock(server_pending_mutex_);
                    pending_server_requests_[CorrelationKey{cid}] = msg;
                }
                env.correlation_id = cid;
                // SCE_MESH.md §10.5: same server-side dedup gate as the
                // RPC / FireForget handlers above.
                (void)this->{{ dedup_or_dispatch(server_needs_dedup, "env") }};
            });
{% endfor %}
{% for eg in server.eventgroup_events if eg.event_group_id %}
        // Eventgroup notification (SCE_MESH.md §8.1): offer the event so
        // clients that subscribe to this eventgroup receive notify messages
        // via vsomeip multicast. offer_event MUST precede start().
        server_app_->offer_event(
            SOMEIP_SERVER_SERVICE, SOMEIP_SERVER_INSTANCE,
            SOMEIP_SERVER_EVENT_{{ eg.event_const }},
            {SOMEIP_SERVER_EVENTGROUP_{{ eg.event_const }}});
{% endfor %}
        server_thread_ = std::thread([this]{ server_app_->start(); });
{% endif %}
{% if has_server_zenoh %}
        // Server Zenoh: declare queryable for session.get-based patterns
        // (RpcRequest, FieldRead). Must happen after zenoh session open.
        // env.type / env.pattern are trusted from the decoded envelope —
        // the client encoded them via resolvePattern before session.get.
        zenoh_queryable_.emplace(zenoh_session_->declare_queryable(
            zenoh::KeyExpr(ZENOH_SERVER_KEY),
            [this](const zenoh::Query& query) {
                auto payload_opt = query.get_payload();
                if (!payload_opt.has_value()) return;
                auto bytes = payload_opt->get().as_vector();
                SCE::Mesh::MeshEnvelope env;
                if (!SCE::Mesh::decodeEnvelope(bytes.data(), bytes.size(), env)) return;
                // Key by invoke_id when available (mesh-rpc invoke path) so the
                // outbound response can be correlated through the engine's
                // currentEventInvokeId without an extra mapping table. Falls
                // back to correlation_id (SOME/IP client sets it) or a fresh
                // UUID (plain <send> path — single outstanding request).
                auto cid = env.invoke_id.value_or(
                    env.correlation_id.value_or(SCE::uuid::v7()));
                {
                    std::lock_guard<std::mutex> lock(server_pending_mutex_);
                    pending_server_queries_.insert_or_assign(CorrelationKey{cid}, query.clone());
                }
                env.correlation_id = cid;
                // SCE_MESH.md §10.5: Zenoh server queryable gate. Uses
                // the same `server_needs_dedup` flag as the SOME/IP
                // server handlers above so all server-side inbound
                // call sites read identically. Today's Zenoh
                // classification (`supplies_dedup = false`) forces
                // `server_needs_dedup = true` whenever this block
                // emits, so the fallback is unreachable — it is
                // retained so a future registry shift (e.g. Zenoh
                // gaining a reliable-unicast profile that supplies
                // dedup) lands correctly without template edits.
                (void)this->{{ dedup_or_dispatch(server_needs_dedup, "env") }};
            },
            []{}));
{% if server.has_server_put %}
        // Server Zenoh inbound-put subscriber (SCE_MESH.md §8.3).
        // `session.put` from clients does not trigger the queryable, so a
        // parallel subscriber is declared on the same server key. The
        // decoded envelope carries the real event name and pattern (the
        // client stamped env.pattern via resolvePattern); the subscriber
        // forwards it to dispatchToSender unchanged.
        zenoh_server_put_sub_.emplace(zenoh_session_->declare_subscriber(
            zenoh::KeyExpr(ZENOH_SERVER_KEY),
            [this](const zenoh::Sample& sample) {
                auto bytes = sample.get_payload().as_vector();
                SCE::Mesh::MeshEnvelope env;
                if (!SCE::Mesh::decodeEnvelope(bytes.data(), bytes.size(), env)) return;
                // Skip self-published eventgroup notifications. When the
                // server publishes via session.put on ZENOH_SERVER_KEY, this
                // subscriber also receives the event. Filtering by source
                // avoids a self-loop that would dispatch the server's own
                // notification back to its engine.
                //
                // Limitation: in multi-instance deployments where two
                // instances share the same machine_name AND the same Zenoh
                // key, instance A's inbound FireForget/FieldWrite from
                // instance B would be dropped. Current scope (single-
                // instance per machine name) is safe. Multi-instance
                // would need a session-unique origin ID instead.
                if (env.source == "{{ machine_name }}") return;
                // SCE_MESH.md §10.5: Zenoh server put-subscriber gate —
                // same `server_needs_dedup` flag as the queryable above.
                (void)this->{{ dedup_or_dispatch(server_needs_dedup, "env") }};
            },
            []{}));
{% endif %}
{% endif %}
{% if machine_subscriptions %}
        // Machine-lifetime subscriptions (SCE_MESH.md §13 deploy.yaml path).
        // Subscribe on init, unsubscribe on shutdown. Each entry came from
        // deploy.yaml `machines.<name>.subscriptions[*]`.
{% for sub in machine_subscriptions %}
        {
            SCE::Mesh::MeshEnvelope sub_env;
            sub_env.id = SCE::uuid::v7();
            sub_env.source = "{{ machine_name }}";
            sub_env.type = "{{ sub.event }}";
            sub_env.pattern = SCE::Mesh::PatternKind::EventSubscribe;
            sub_env.datacontenttype = SCE::Mesh::PayloadCodec::None;
            (void)route_send("{{ sub.source }}", sub_env);
        }
{% endfor %}
{% endif %}
        return true;
    }

    /// Stop all transport connections and release shared resources.
    void shutdown() {
{% if machine_subscriptions %}
        // Machine-lifetime unsubscribe (reverse of init subscriptions).
{% for sub in machine_subscriptions %}
        {
            SCE::Mesh::MeshEnvelope unsub_env;
            unsub_env.id = SCE::uuid::v7();
            unsub_env.source = "{{ machine_name }}";
            unsub_env.type = "{{ sub.event }}";
            unsub_env.pattern = SCE::Mesh::PatternKind::EventUnsubscribe;
            unsub_env.datacontenttype = SCE::Mesh::PayloadCodec::None;
            (void)route_send("{{ sub.source }}", unsub_env);
        }
{% endfor %}
{% endif %}
{% for target in targets if target.state.kind == "someip" %}
        if ({{ target.target_snake }}_app_) {{ target.target_snake }}_app_->stop();
        if ({{ target.target_snake }}_thread_.joinable()) {{ target.target_snake }}_thread_.join();
{% endfor %}
{% if has_server_someip %}
        if (server_app_) server_app_->stop();
        if (server_thread_.joinable()) server_thread_.join();
{% endif %}
{% if has_server_zenoh %}
{% if server.has_server_put %}
        zenoh_server_put_sub_.reset();
{% endif %}
        zenoh_queryable_.reset();
{% endif %}
{% if "zenoh" in transport_types %}
        // Drop subscriber handles before closing session (RAII order matters:
        // each ~Subscriber calls into zenoh_session_).
        zenoh_subscribers_.clear();
        zenoh_session_.reset();
{% endif %}
{% if "custom_tcp" in transport_types and custom_tcp_transport and custom_tcp_transport.listen %}
        // Server first: shutting it down unblocks the accept thread and
        // joins per-connection readers. The per-target Client members
        // (D1) are RAII-destroyed by the TransportRouter dtor, after this
        // shutdown() returns and before any client field destructors run.
        if (custom_tcp_server_) custom_tcp_server_->shutdown();
        custom_tcp_server_.reset();
{% endif %}
    }

    ~TransportRouter() { shutdown(); }
{% endif %}

{% if "local" in transport_types %}
{# ── (D4b) linkTo — register cross-router inbound dispatcher ── #}
    /// Register a dispatcher for a local target so outbound envelopes to
    /// that target route through another router's inbound path rather
    /// than the raw engine external queue. SCE_MESH.md §9.5: the caller
    /// router owns InvokeCorrelation for mesh-rpc; the callee router
    /// uses this hook to hand replies back through
    /// caller.dispatchToSender(env), which consults the correlation
    /// table and raises done.invoke.<id> / error.invoke.<id> on the
    /// caller engine.
    ///
    /// Typical wiring (both directions):
    ///   routerA.linkTo("#engineB",
    ///       [&routerB](const auto& env){ return routerB.dispatchToSender(env); });
    ///   routerB.linkTo("#engineA",
    ///       [&routerA](const auto& env){ return routerA.dispatchToSender(env); });
    ///
    /// Setup-only: MUST be called before init() and before any outbound
    /// mesh send. The map is read-only after that, so no mutex is held
    /// on the dispatch path. Unlinked targets fall back to the direct
    /// dispatchEnvelope path in route_send (preserves single-router
    /// test fixtures).
    void linkTo(const std::string& target,
                std::function<bool(const SCE::Mesh::MeshEnvelope&)> dispatcher) {
        linked_[target] = std::move(dispatcher);
    }
{% endif %}

{# ── (D5) route_send() dispatch (NEW TRANSPORT: add {% elif %} block) ── #}
    /// Dispatch an envelope to the target identified by the SCXML target string.
    ///
    /// Local transport skips CBOR encode/decode (same-process); byte-stream
    /// transports (shm, someip, zenoh) encode the envelope on the wire.
    ///
    /// @return true if the event was dispatched; false if the target is unknown
    ///         or the transport-specific send failed.
    [[nodiscard]] bool route_send({% if targets %}const std::string& target, const SCE::Mesh::MeshEnvelope& env{% else %}[[maybe_unused]] const std::string& target, [[maybe_unused]] const SCE::Mesh::MeshEnvelope& env{% endif %}) {
{% for target in targets %}
        {% if not loop.first %}else {% endif %}if (target == "{{ target.target }}") {
{% if target.state.kind == "local" %}
            // SCE_MESH.md §9.5: if another router has registered a link
            // for this target, route through its dispatcher — typically
            // the peer's dispatchToSender, which consults its
            // InvokeCorrelation table before delivering to the engine.
            // Unlinked targets fall through to direct external-queue
            // enqueue so single-router fixtures keep working unchanged.
            if (auto it = linked_.find("{{ target.target }}"); it != linked_.end()) {
                return it->second(env);
            }
            // W3C SCXML 3.12: enqueue to external queue only. Macrostep
            // timing is scheduler/application responsibility — the transport
            // layer does not drive target engine execution.
            using TargetPolicy = std::decay_t<decltype({{ target.target_snake }}_.getPolicy())>;
            return SCE::Mesh::dispatchEnvelope<TargetPolicy>(env, {{ target.target_snake }}_);
{% elif target.state.kind == "shm" %}
            return send_to_{{ target.target_snake }}({{ target.target_snake }}_, env);
{% elif target.state.kind == "someip" %}
            if ({{ target.target_snake }}_app_) {
                return send_to_{{ target.target_snake }}(*{{ target.target_snake }}_app_, env);
            }
            return false;
{% elif target.state.kind == "zenoh" %}
            if (zenoh_session_) {
                return send_zenoh(env,
                                  ZENOH_KEY_{{ target.target_snake | upper }},
                                  "{{ target.target }}");
            }
            return false;
{% elif target.state.kind == "custom_tcp" %}
            return send_to_{{ target.target_snake }}({{ target.target_snake }}_, env);
{% endif %}
        }
{% endfor %}
        return false;  // unknown target — let caller handle fallback
    }

    /// Resolve the PatternKind for a given event name based on build-time
    /// pattern detection from event name conventions (SCE_MESH.md §13 path B).
    /// Falls back to FireForget for events with no detected pattern.
    static SCE::Mesh::PatternKind resolvePattern(const std::string& eventName) {
        using PK = SCE::Mesh::PatternKind;
{# Collect all unique event→pattern mappings across all targets #}
{% set ns = namespace(has_patterns=false) %}
{% for target in targets %}
{% for ep in target.event_patterns %}
{% set ns.has_patterns = true %}
        if (eventName == "{{ ep.event }}") return static_cast<PK>({{ ep.pattern_kind }});
{% endfor %}
{% endfor %}
{# Server response events: the mesh send callback must resolve outbound
   response events as RpcReply / FieldNotify so the server interceptor
   routes them to handleServerResponse instead of falling through to
   route_send (which has no binding for the self-target). SCE_MESH.md
   §13 Session E / §8.3. #}
{% if has_server %}
{% for pair in server.rpc_pairs %}
{% set ns.has_patterns = true %}
        if (eventName == "{{ pair.response_event }}") return PK::RpcReply;
{% endfor %}
{% for resp in server.field_notify_events %}
{% set ns.has_patterns = true %}
        if (eventName == "{{ resp }}") return PK::FieldNotify;
{% endfor %}
{% endif %}
{% if not ns.has_patterns %}
        (void)eventName;
{% endif %}
        return PK::FireForget;
    }

{% if "someip" in transport_types or "zenoh" in transport_types or "custom_tcp" in transport_types or has_mesh_rpc.v or has_server %}
    /// Look up the paired reply event for an RPC request (build-time table).
    /// SCE_MESH.md §13 path B: the pair is inferred by convention —
    /// `service.request.X` ↔ `service.response.X`. Returns empty string
    /// for non-RPC events.
    static const char* resolveReplyEvent(const std::string& eventName) {
{% for target in targets %}
{% for ep in target.event_patterns if ep.reply_event %}
        if (eventName == "{{ ep.event }}") return "{{ ep.reply_event }}";
{% endfor %}
{% endfor %}
        (void)eventName;
        return "";
    }
{% endif %}

{% if "someip" in transport_types or "zenoh" in transport_types or "local" in transport_types or "custom_tcp" in transport_types or has_mesh_rpc.v or has_server %}
    /// Dispatch an incoming envelope to the sender engine via MeshDispatch.
    ///
    /// Called on transport callback threads (vsomeip application threads,
    /// zenoh runtime threads) and by peer routers through linkTo closures
    /// for cross-router local dispatch. Uses the bound `sender_` reference
    /// — no type-erased std::function in the hot path. Policy is recovered
    /// at the call site via `sender_.getPolicy()`, so the header stays
    /// ignorant of the concrete policy type until instantiation.
    ///
    /// @return true if MeshDispatch delivered the envelope
    [[nodiscard]] bool dispatchToSender(const SCE::Mesh::MeshEnvelope& env) {
{% if has_mesh_rpc.v %}
        // SCE_MESH.md §9.5: RpcReply + invoke_id = mesh-rpc reply.
        // Consult the correlation table first — if the invoke_id owns
        // a live registration, its deliver callback raises done.invoke /
        // error.invoke on the sender with the reply payload and the
        // envelope is consumed. Cancel any deadline still armed (reply
        // beat it to the correlation entry, so the deadline firing
        // later would be a no-op but wastes a wakeup). Non-matching
        // replies fall through to generic MeshDispatch — they may be
        // session-level RPCs routed through the SOME/IP pending_rpcs_
        // table, for example.
        if (env.pattern == SCE::Mesh::PatternKind::RpcReply && env.invoke_id) {
            const auto status = env.rpc_status.value_or(SCE::Mesh::RpcStatus::Ok);
            if (invoke_correlation_.handleReply(*env.invoke_id, status, env.data)) {
                deadline_scheduler_.cancelDeadline(*env.invoke_id);
                return true;
            }
        }
{% endif %}
        using SenderPolicy = std::decay_t<decltype(sender_.getPolicy())>;
        return SCE::Mesh::dispatchEnvelope<SenderPolicy>(env, sender_);
    }

{% if has_undeduped_transport %}
    /// Filter + dispatch inbound envelopes from transports without
    /// inherent duplicate suppression (SCE_MESH.md §10.5).
    ///
    /// Keyed on `(env.source, env.id)`: envelopes whose id is already in
    /// the per-sender window are dropped silently (return false). Novel
    /// ids are forwarded to `dispatchToSender`, which still performs the
    /// mesh-rpc correlation lookup for RpcReply+invoke_id envelopes.
    ///
    /// Called only on inbound paths from transports that declared
    /// `supplies_dedup: false` in transport.rs (Zenoh queryable, Zenoh
    /// put subscriber, Zenoh session.get reply closure, Zenoh subscribe
    /// notify closure). SOME/IP-over-TCP, custom_tcp, shm, and local
    /// inbound paths continue to call `dispatchToSender` directly —
    /// their transport already guarantees at-most-once delivery.
    ///
    /// The `[[nodiscard]]` attribute mirrors `dispatchToSender`: the
    /// transport-callback call sites explicitly `(void)`-cast the
    /// return (there is no meaningful recovery action at that layer
    /// — the decoder has already committed to a dropped envelope),
    /// but `test_mesh_dedup_injection.cpp` does consume the return to
    /// assert the §10.5 contract. Removing the attribute would let a
    /// test regress to "admit returns are unchecked" silently.
    ///
    /// @return true iff the envelope was novel AND MeshDispatch accepted it
    [[nodiscard]] bool admitInbound(const SCE::Mesh::MeshEnvelope& env) {
        if (!dedup_.admit(env.source, env.id)) {
            return false;
        }
        return dispatchToSender(env);
    }
{% endif %}

{% if has_server %}
    /// Route an outbound server response back through the transport layer.
    ///
    /// SCE_MESH.md §13 Session E: when the engine sends service.response.X
    /// (pattern == RpcReply), this method is called from the mesh send
    /// callback. It looks up the pending inbound request by correlation_id
    /// and routes the response through the transport-native reply mechanism
    /// (SOME/IP create_response + send, Zenoh Query::reply).
    ///
    /// @return true if the response was correlated and sent; false if no
    ///         pending request matched the correlation_id.
    [[nodiscard]] bool handleServerResponse(const SCE::Mesh::MeshEnvelope& env) {
        if (!env.correlation_id) return false;
        CorrelationKey ckey{*env.correlation_id};
{% if has_server_someip %}
        std::shared_ptr<vsomeip::message> original;
        {
            std::lock_guard<std::mutex> lock(server_pending_mutex_);
            auto it = pending_server_requests_.find(ckey);
            if (it == pending_server_requests_.end()) return false;
            original = it->second;
            pending_server_requests_.erase(it);
        }
        auto response = vsomeip::runtime::get()->create_response(original);
        auto buf = SCE::Mesh::encodeEnvelope(env);
        auto payload = vsomeip::runtime::get()->create_payload(
            reinterpret_cast<const vsomeip::byte_t*>(buf.data()),
            static_cast<uint32_t>(buf.size()));
        response->set_payload(payload);
        server_app_->send(response);
        return true;
{% elif has_server_zenoh %}
        std::lock_guard<std::mutex> lock(server_pending_mutex_);
        auto it = pending_server_queries_.find(ckey);
        if (it == pending_server_queries_.end()) return false;
        // Move the Query out and erase before reply — the query
        // handle is valid until reply() consumes it.
        auto stored_query = std::move(it->second);
        pending_server_queries_.erase(it);
        auto buf = SCE::Mesh::encodeEnvelope(env);
        stored_query.reply(zenoh::KeyExpr(ZENOH_SERVER_KEY),
                           zenoh::Bytes(std::move(buf)));
        return true;
{% endif %}
    }
{% if server.has_eventgroup %}

    /// Publish an eventgroup notification to all subscribed clients.
    ///
    /// SCE_MESH.md §8.1: when the engine raises a field.notify.X event
    /// spontaneously (without a preceding getter/setter request), the mesh
    /// send callback falls through handleServerResponse (no pending request
    /// to correlate) and reaches this method. The event is published via
    /// the transport's native pub/sub mechanism: SOME/IP `notify` to the
    /// offered eventgroup, or Zenoh `session.put` on the server key.
    ///
    /// @return true if the event matched an eventgroup binding and was
    ///         published; false if no binding matched (event dropped).
    [[nodiscard]] bool publishEventgroupNotify(const SCE::Mesh::MeshEnvelope& env) {
{% if has_server_someip %}
{% for eg in server.eventgroup_events if eg.event_id %}
        if (env.type == "{{ eg.event }}") {
            auto buf = SCE::Mesh::encodeEnvelope(env);
            auto payload = vsomeip::runtime::get()->create_payload(
                reinterpret_cast<const vsomeip::byte_t*>(buf.data()),
                static_cast<uint32_t>(buf.size()));
            server_app_->notify(SOMEIP_SERVER_SERVICE, SOMEIP_SERVER_INSTANCE,
                                SOMEIP_SERVER_EVENT_{{ eg.event_const }}, payload);
            return true;
        }
{% endfor %}
        return false;
{% elif has_server_zenoh %}
        // Zenoh pub/sub: session.put on the server key. Clients that called
        // declare_subscriber on this key receive the event. The server's own
        // put_sub filters self-published events by source name.
{% for eg in server.eventgroup_events %}
        if (env.type == "{{ eg.event }}") {
            auto buf = SCE::Mesh::encodeEnvelope(env);
            zenoh_session_->put(zenoh::KeyExpr(ZENOH_SERVER_KEY),
                                zenoh::Bytes(std::move(buf)));
            return true;
        }
{% endfor %}
        return false;
{% endif %}
    }
{% endif %}
{% endif %}

{% if has_mesh_rpc.v %}
    /// Dispatch a `<invoke type="sce:mesh-rpc">` request (SCE_MESH.md §9.5).
    ///
    /// Generates a UUID v7 as the wire-level `invoke_id`, registers a
    /// deliver callback keyed on that UUID, arms the deadline timer if
    /// the invoke site declared `_mesh_deadline_ms`, and routes the
    /// envelope to the target transport via `route_send`. The deliver
    /// callback captures only the SCXML invoke id and a pointer to
    /// `sender_`, so it can raise `done.invoke.<id>` or
    /// `error.invoke.<id>` on the sender engine once the reply or
    /// deadline outcome resolves.
    ///
    /// @return true if the request was submitted to the transport;
    ///         false if (target, fieldSuffix) has no matching invoke
    ///         site (caller-error — indicates codegen/runtime drift)
    ///         or the transport rejected the send.
    [[nodiscard]] bool invokeMeshRpc(const std::string& target,
                                     const std::string& fieldSuffix,
                                     const std::string& invokeId,
                                     const std::string& data) {
        SCE::Mesh::MeshEnvelope env;
        const auto uuid = SCE::uuid::v7();
        env.id = uuid;
        env.invoke_id = uuid;
        env.source = "{{ machine_name }}";
        env.pattern = SCE::Mesh::PatternKind::RpcRequest;
        env.datacontenttype = data.empty()
            ? SCE::Mesh::PayloadCodec::None
            : SCE::Mesh::PayloadCodec::Json;
        env.data.assign(data.begin(), data.end());

        bool matched_site = false;
{% for target in targets %}
{% for site in target.invoke_sites %}
        if (target == "{{ target.target }}" && fieldSuffix == "{{ site.field_suffix }}") {
            env.type = "{{ site.mesh_event }}";
{% if site.deadline_ms is not none %}
            // Per-invoke deadline from <param name="_mesh_deadline_ms">.
            // Fires handleDeadline on the invoke_correlation_ table which
            // invokes the deliver callback with RpcStatus::DeadlineExceeded —
            // surfaced to the parent as error.invoke.<invokeId>.
            deadline_scheduler_.registerDeadline(uuid,
                std::chrono::milliseconds({{ site.deadline_ms }}),
                [this, uuid]{ (void)invoke_correlation_.handleDeadline(uuid); });
{% endif %}
            matched_site = true;
        }
{% endfor %}
{% endfor %}
        if (!matched_site) {
            return false;  // codegen drift — (target, suffix) not in invoke_sites
        }

        // Register deliver callback BEFORE route_send so a synchronous
        // reply (local transport) cannot race with registration. The
        // callback captures `&sender_` by raw pointer — TransportRouter
        // outlives the sender engine per the ctor contract, so the
        // pointer is stable until shutdown joins all callback threads.
        SenderEngine* sender_ptr = &sender_;
        std::string captured_invoke_id = invokeId;
        invoke_correlation_.registerInvoke(uuid,
            [sender_ptr, captured_invoke_id](
                SCE::Mesh::RpcStatus status,
                std::vector<std::uint8_t> payload) {
                typename SenderEngine::EventWithMetadata evt;
                evt.event = (status == SCE::Mesh::RpcStatus::Ok)
                    ? SenderEngine::Event::Done_invoke
                    : SenderEngine::Event::Error_invoke;
                evt.data.assign(payload.begin(), payload.end());
                evt.invokeId = captured_invoke_id;
                evt.originType = "sce:mesh-rpc";
                sender_ptr->raiseExternal(evt);
            });

        // Track (target, fieldSuffix) → uuid so a later cancel from
        // onexit can erase the matching correlation + deadline entries.
        {
            std::lock_guard<std::mutex> lock(active_invokes_mutex_);
            active_invokes_[InvokeSiteKey{target, fieldSuffix}] = uuid;
        }

        return route_send(target, env);
    }

    /// Cancel a pending mesh-rpc invoke (SCE_MESH.md §9.5 `<cancel>`).
    ///
    /// Called from generated onexit blocks when a state with a pending
    /// mesh-rpc invoke is left before the reply lands. Erases both the
    /// correlation entry and any armed deadline — a late reply arriving
    /// after cancel is silently dropped because `handleReply` finds no
    /// entry to fire. No cancel envelope is placed on the wire: §9.5
    /// "benign drop" semantics. Returns true if there was something to
    /// cancel, false if already fired or never registered.
    [[nodiscard]] bool cancelMeshRpc(const std::string& target,
                                     const std::string& fieldSuffix) {
        std::array<std::uint8_t, 16> uuid;
        {
            std::lock_guard<std::mutex> lock(active_invokes_mutex_);
            auto it = active_invokes_.find(InvokeSiteKey{target, fieldSuffix});
            if (it == active_invokes_.end()) return false;
            uuid = it->second;
            active_invokes_.erase(it);
        }
        (void)deadline_scheduler_.cancelDeadline(uuid);
        return invoke_correlation_.handleCancel(uuid);
    }
{% endif %}
