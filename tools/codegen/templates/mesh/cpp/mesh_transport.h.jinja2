    }

    ~TransportRouter() { shutdown(); }
{% endif %}

{% if "local" in transport_types %}
{# ── (D4b) linkTo — register cross-router inbound dispatcher ── #}
    /// Register a dispatcher for a local target so outbound envelopes to
    /// that target route through another router's inbound path rather
    /// than the raw engine external queue. SCE_MESH.md §9.5: the caller
    /// router owns InvokeCorrelation for mesh-rpc; the callee router
    /// uses this hook to hand replies back through
    /// caller.dispatchToSession(env, 0), which consults the correlation
    /// table and raises done.invoke.<id> / error.invoke.<id> on the
    /// caller engine. `0` is the sole session slot: cross-router linkTo
    /// is single-session by construction (the SOME/IP server pool is
    /// the only multi-session shape, §14.4, and it does not use linkTo).
    ///
    /// Typical wiring (both directions):
    ///   routerA.linkTo("#engineB",
    ///       [&routerB](const auto& env){ return routerB.dispatchToSession(env, 0); });
    ///   routerB.linkTo("#engineA",
    ///       [&routerA](const auto& env){ return routerA.dispatchToSession(env, 0); });
    ///
    /// Setup-only: MUST be called before init() and before any outbound
    /// mesh send. The map is read-only after that, so no mutex is held
    /// on the dispatch path. Unlinked targets fall back to the direct
    /// dispatchEnvelope path in route_send (preserves single-router
    /// test fixtures).
    void linkTo(const std::string& target,
                std::function<bool(const SCE::Mesh::MeshEnvelope&)> dispatcher) {
        linked_[target] = std::move(dispatcher);
    }
{% endif %}

{# ── (D5) route_send() dispatch (NEW TRANSPORT: add {% elif %} block) ── #}
    /// Dispatch an envelope to the target identified by the SCXML target string.
    ///
    /// Local transport skips CBOR encode/decode (same-process); byte-stream
    /// transports (shm, someip, zenoh) encode the envelope on the wire.
    ///
    /// @return true if the event was dispatched; false if the target is unknown
    ///         or the transport-specific send failed.
    [[nodiscard]] bool route_send({% if targets %}const std::string& target, const SCE::Mesh::MeshEnvelope& env{% else %}[[maybe_unused]] const std::string& target, [[maybe_unused]] const SCE::Mesh::MeshEnvelope& env{% endif %}) {
{% for target in targets %}
        {% if not loop.first %}else {% endif %}if (target == "{{ target.target }}") {
{% if target.state.kind == "local" %}
            // SCE_MESH.md §9.5: if another router has registered a link
            // for this target, route through its dispatcher — typically
            // the peer's dispatchToSession, which consults its
            // InvokeCorrelation table before delivering to the engine.
            // Unlinked targets fall through to direct external-queue
            // enqueue so single-router fixtures keep working unchanged.
            if (auto it = linked_.find("{{ target.target }}"); it != linked_.end()) {
                return it->second(env);
            }
            // W3C SCXML 3.12: enqueue to external queue only. Macrostep
            // timing is scheduler/application responsibility — the transport
            // layer does not drive target engine execution.
            using TargetPolicy = std::decay_t<decltype({{ target.target_snake }}_.getPolicy())>;
            return SCE::Mesh::dispatchEnvelope<TargetPolicy>(env, {{ target.target_snake }}_);
{% elif target.state.kind == "shm" %}
            return send_to_{{ target.target_snake }}({{ target.target_snake }}_, env);
{% elif target.state.kind == "someip" %}
{% if machine_outbound_buffer %}
            // SCE Mesh §10.10: availability-gated buffering. The admit
            // closure invokes `send_to_{{ target.target_snake }}` when
            // ready (vsomeip availability callback flipped the buffer's
            // markReady state), otherwise enqueues up to
            // `max_pending_per_target`; overflow raises
            // `error.communication` with reason BACKPRESSURE_DROP
            // (§16.7 row 9). The buffer owns the app-pointer null check
            // identically to the pre-§10.10 direct path.
            return {{ target.target_snake }}_outbound_.admit(env);
{% else %}
            if ({{ target.target_snake }}_app_) {
                return send_to_{{ target.target_snake }}(*{{ target.target_snake }}_app_, env);
            }
            return false;
{% endif %}
{% elif target.state.kind == "zenoh" %}
{% if machine_outbound_buffer %}
            // SCE Mesh §10.10: subscriber-matching-gated buffering for
            // PUT-style patterns (FireForget, FieldWrite). GET-style
            // patterns (RpcRequest, FieldRead), EventSubscribe and
            // EventUnsubscribe bypass the buffer — Zenoh's `session.get`
            // surfaces a late-subscriber via its own `on_drop` path
            // (gap Z3: `RpcStatus::Unavailable`) and
            // `declare_subscriber` is resilient to subscriber-first
            // ordering by construction. Only the put path has the
            // publisher-first-lost failure mode the buffer addresses.
            using PK = SCE::Mesh::PatternKind;
            if (env.pattern == PK::FireForget || env.pattern == PK::FieldWrite) {
                return {{ target.target_snake }}_outbound_.admit(env);
            }
            if (zenoh_session_) {
                return send_zenoh(env,
                                  ZENOH_KEY_{{ target.target_snake | upper }},
                                  "{{ target.target }}");
            }
{% else %}
            if (zenoh_session_) {
                return send_zenoh(env,
                                  ZENOH_KEY_{{ target.target_snake | upper }},
                                  "{{ target.target }}");
            }
{% endif %}
            return false;
{% elif target.state.kind == "custom_tcp" %}
            return send_to_{{ target.target_snake }}({{ target.target_snake }}_, env);
{% endif %}
        }
{% endfor %}
        return false;  // unknown target — let caller handle fallback
    }

    /// Resolve the PatternKind for a given event name based on build-time
    /// pattern detection from event name conventions (SCE_MESH.md §13 path B).
    /// Falls back to FireForget for events with no detected pattern.
    static SCE::Mesh::PatternKind resolvePattern(const std::string& eventName) {
        using PK = SCE::Mesh::PatternKind;
{# Collect all unique event→pattern mappings across all targets #}
{% set ns = namespace(has_patterns=false) %}
{% for target in targets %}
{% for ep in target.event_patterns %}
{% set ns.has_patterns = true %}
        if (eventName == "{{ ep.event }}") return static_cast<PK>({{ ep.pattern_kind }});
{% endfor %}
{% endfor %}
{# Server response events: the mesh send callback must resolve outbound
   response events as RpcReply / FieldNotify so the server interceptor
   routes them to handleServerResponse instead of falling through to
   route_send (which has no binding for the self-target). SCE_MESH.md
   §13 Session E / §8.3. #}
{% if has_server %}
{% for pair in server.rpc_pairs %}
{% set ns.has_patterns = true %}
        if (eventName == "{{ pair.response_event }}") return PK::RpcReply;
{% endfor %}
{% for resp in server.field_notify_events %}
{% set ns.has_patterns = true %}
        if (eventName == "{{ resp }}") return PK::FieldNotify;
{% endfor %}
{% endif %}
{% if not ns.has_patterns %}
        (void)eventName;
{% endif %}
        return PK::FireForget;
    }

{% if "someip" in transport_types or "zenoh" in transport_types or "custom_tcp" in transport_types or has_mesh_rpc.v or has_server %}
    /// Look up the paired reply event for an RPC request (build-time table).
    /// SCE_MESH.md §13 path B: the pair is inferred by convention —
    /// `service.request.X` ↔ `service.response.X`. Returns empty string
    /// for non-RPC events.
    static const char* resolveReplyEvent(const std::string& eventName) {
{% for target in targets %}
{% for ep in target.event_patterns if ep.reply_event %}
        if (eventName == "{{ ep.event }}") return "{{ ep.reply_event }}";
{% endfor %}
{% endfor %}
        (void)eventName;
        return "";
    }
{% endif %}

{% if "someip" in transport_types or "zenoh" in transport_types or "local" in transport_types or "custom_tcp" in transport_types or has_mesh_rpc.v or has_server or scxml_remote_inbound_peers or scxml_remote_outbound_peers %}
    /// Dispatch an incoming envelope to a specific session via MeshDispatch.
    ///
    /// Called on transport callback threads (vsomeip application threads,
    /// zenoh runtime threads) and by peer routers through linkTo closures
    /// for cross-router local dispatch. Uses the `sessions_[session_idx]`
    /// pointer — no type-erased std::function in the hot path. Policy is
    /// recovered at the call site via `sessions_[0]->getPolicy()`, so the
    /// header stays ignorant of the concrete policy type until instantiation
    /// (every session shares the same `SenderEngine` template parameter).
    ///
    /// `session_idx` is the sessions_ slot the envelope targets (SCE_MESH.md
    /// §14.4). SOME/IP server-pool handlers pass
    /// `session_index_for_instance(msg->get_instance())`; every other caller
    /// passes `0` because its inbound path is not pool-dispatched. Values
    /// outside `[0, N_SESSIONS)` are a caller bug — no runtime bounds
    /// check (the upstream handler uses the `N_SESSIONS` sentinel + early
    /// drop before ever reaching this method).
    ///
    /// @return true if MeshDispatch delivered the envelope
    [[nodiscard]] bool dispatchToSession(const SCE::Mesh::MeshEnvelope& env,
                                         std::size_t session_idx) {
{% if has_mesh_rpc.v %}
        // SCE_MESH.md §9.5: RpcReply + invoke_id = mesh-rpc reply.
        // Consult the correlation table first — if the invoke_id owns
        // a live registration, its deliver callback raises done.invoke /
        // error.invoke on the sender with the reply payload and the
        // envelope is consumed. Cancel any deadline still armed (reply
        // beat it to the correlation entry, so the deadline firing
        // later would be a no-op but wastes a wakeup). Non-matching
        // replies fall through to generic MeshDispatch — they may be
        // session-level RPCs routed through the SOME/IP pending_rpcs_
        // table, for example.
        //
        // invoke_correlation_ is router-scoped (not session-scoped) and
        // has_mesh_rpc.v + SOME/IP server pool is rejected at codegen,
        // so this branch only emits when N_SESSIONS == 1 and every
        // session_idx is 0.
        if (env.pattern == SCE::Mesh::PatternKind::RpcReply && env.invoke_id) {
            const auto status = env.rpc_status.value_or(SCE::Mesh::RpcStatus::Ok);
            if (invoke_correlation_.handleReply(*env.invoke_id, status, env.data)) {
                deadline_scheduler_.cancelDeadline(*env.invoke_id);
                return true;
            }
        }
{% endif %}
        using SenderPolicy = std::decay_t<decltype(sessions_[0]->getPolicy())>;
        return SCE::Mesh::dispatchEnvelope<SenderPolicy>(env, *sessions_[session_idx]);
    }

{% if has_undeduped_transport %}
    /// Filter + dispatch inbound envelopes from transports without
    /// inherent duplicate suppression (SCE_MESH.md §10.5).
    ///
    /// Keyed on `(env.source, env.id)`: envelopes whose id is already in
    /// the per-sender window are dropped silently (return false). Novel
    /// ids are forwarded to `dispatchToSession`, which still performs
    /// the mesh-rpc correlation lookup for RpcReply+invoke_id envelopes.
    ///
    /// Called only on inbound paths from transports that declared
    /// `supplies_dedup: false` in transport.rs (Zenoh queryable, Zenoh
    /// put subscriber, Zenoh session.get reply closure, Zenoh subscribe
    /// notify closure, SOME/IP server handlers over UDP). SOME/IP-over-
    /// TCP, custom_tcp, shm, and local inbound paths continue to call
    /// `dispatchToSession` directly — their transport already guarantees
    /// at-most-once delivery.
    ///
    /// `session_idx` carries the SCE_MESH.md §14.4 session routing
    /// contract verbatim through the dedup layer to `dispatchToSession`
    /// so a SOME/IP server-pool envelope lands on the session whose
    /// offered instance received it.
    ///
    /// The `[[nodiscard]]` attribute mirrors `dispatchToSession`: the
    /// transport-callback call sites explicitly `(void)`-cast the
    /// return (there is no meaningful recovery action at that layer
    /// — the decoder has already committed to a dropped envelope),
    /// but `test_mesh_dedup_injection.cpp` does consume the return to
    /// assert the §10.5 contract. Removing the attribute would let a
    /// test regress to "admit returns are unchecked" silently.
    ///
    /// @return true iff the envelope was novel AND MeshDispatch accepted it
    [[nodiscard]] bool admitInbound(const SCE::Mesh::MeshEnvelope& env,
                                    std::size_t session_idx) {
        const auto dedup_result = dedup_.admitWithSignal(env.source, env.id);
        if (dedup_result == ::SCE::Mesh::DedupWindow::Result::Duplicate) {
            return false;
        }
        if (dedup_result == ::SCE::Mesh::DedupWindow::Result::NovelWithEviction) {
            // SCE_MESH.md §16.7 row 7 — DEDUP_WINDOW_OVERFLOW. The
            // sender's sustained novel-id rate exceeded this
            // receiver's 256-slot per-sender ring; the spec calls
            // this operationally as "eviction happened", surfaced
            // here as the closest in-bounds signal of the
            // underlying fault. Authors guard on `_event.data.reason
            // == 'DEDUP_WINDOW_OVERFLOW' && _event.data.source ==
            // '<peer>'` to react to the specific peer overrunning
            // the window.
            ::SCE::Mesh::CommunicationError __sce_dedup_err;
            __sce_dedup_err.reason = ::SCE::Mesh::ReasonCode::DedupWindowOverflow;
            __sce_dedup_err.source = env.source;
            __sce_dedup_err.window_size =
                static_cast<std::int64_t>(::SCE::Mesh::DedupWindow::kCapacity);
            raiseCommunicationError(std::move(__sce_dedup_err));
        }
        return dispatchToSession(env, session_idx);
    }
{% endif %}

{% if raises_communication_error %}
    /// Raise an `error.communication` event on every hosted session with
    /// the §10.10.1 / §16.7 `_event.data` shape encoded as JSON.
    ///
    /// Call sites:
    ///   * `admitOrdered` when an envelope arrives on an ordered route
    ///     without `sequence_no` — raises `reason = "MISSING_SEQUENCE"`
    ///     (§16.7 row 11). Drift diagnostic for the sender.
    ///   * `driveOrderingTick` via the `OrderingBuffer::OnGap` callback
    ///     when a gap has been blocked past `gap_timeout` — raises
    ///     `reason = "ORDERING_GAP"` with `lost_seq_lo`/`lost_seq_hi`
    ///     (§16.7 row 12). Recovery signal: the receiver has fast-
    ///     forwarded past the missing range.
    ///   * The Zenoh liveliness subscriber (when
    ///     `machines.<name>.liveliness:` is declared) on DELETE samples —
    ///     raises `reason = "PEER_PARTITIONED"` with `target` and, when
    ///     a prior PUT was observed, `last_seen_ms_ago` (§16.7 row 8).
    ///
    /// All three sites observe a condition at the transport layer, not
    /// on a specific SCXML document instance. SCE_MESH.md §14.4: the
    /// raise fans out to every sessions_[i] so each hosted document
    /// reacts independently. Non-pool routers have N_SESSIONS == 1 and
    /// the loop executes exactly once.
    ///
    /// The event reaches each session via `dispatchToSession`, the same
    /// path used for ordinary inbound envelopes. SCXML authors can
    /// guard with `<transition event="error.communication"
    /// cond="_event.data.reason == 'ORDERING_GAP'">` etc.; unhandled
    /// events are silently dropped per W3C SCXML 1.0 §3.12, which is
    /// the desired behaviour when the author did not opt in.
    ///
    /// No cycling hazard: `dispatchToSession` goes straight to
    /// `MeshDispatch`, never back through the transport callback or
    /// ordering admit layer, so the `error.communication` envelope
    /// cannot re-trigger another raise.
    void raiseCommunicationError(SCE::Mesh::CommunicationError err) {
        SCE::Mesh::MeshEnvelope evt;
        evt.id = SCE::uuid::v7();
        evt.source = "{{ machine_name }}";
        evt.routing_id = routing_id_;
        evt.type = "error.communication";
        evt.pattern = SCE::Mesh::PatternKind::FireForget;
        evt.datacontenttype = SCE::Mesh::PayloadCodec::Json;
        evt.data = err.toJsonBytes();
        for (std::size_t i = 0; i < N_SESSIONS; ++i) {
            (void)dispatchToSession(evt, i);
        }
    }
{% endif %}

{% if has_ordered_binding %}
    /// Drive one tick of the ordering buffer's gap-timeout processing.
    ///
    /// The buffer's `tick()` returns an `OrderingTickResult` (released
    /// envelopes + gap events) — all engine-visible work (raising
    /// `error.communication` with reason `ORDERING_GAP`, dispatching
    /// the fast-forwarded data envelopes) runs AFTER the buffer's
    /// mutex has been released, so a slow sender or reentrant raise
    /// cannot stall concurrent admit() calls on the same buffer.
    ///
    /// Dispatch chain mirrors `admitOrdered`: dedup is applied per
    /// released envelope when the transport is undeduped, same
    /// rationale as there.
    ///
    /// Called by the periodic `ordering_tick_thread_` and by
    /// `tickOrdering()` below.
    ///
    /// @return total number of data envelopes dispatched to the
    ///         sender engine during this tick across all sources
    ///         (error.communication raises are NOT counted — only the
    ///         fast-forwarded data envelopes are).
    std::size_t driveOrderingTick() {
        auto result = ordering_buffer_.tick();
        // §16.7 row 12: one error.communication per timed-out gap.
        // Raised outside the buffer mutex — reentrant admit() calls
        // from other transport threads are not blocked by this loop.
        for (const auto& gap : result.gaps) {
            SCE::Mesh::CommunicationError err;
            err.reason = ::SCE::Mesh::ReasonCode::OrderingGap;
            err.source = gap.source;
            err.lost_seq_lo = gap.lost_lo;
            err.lost_seq_hi = gap.lost_hi;
            raiseCommunicationError(std::move(err));
        }
        std::size_t dispatched = 0;
        for (auto& env : result.released) {
{% if has_undeduped_transport %}
            // §10.5 dedup chained after ordering, same rationale as
            // admitOrdered: needs_ordering implies needs_dedup for
            // every registry transport today.
            const auto __sce_dedup_after_ordering =
                dedup_.admitWithSignal(env.source, env.id);
            if (__sce_dedup_after_ordering == ::SCE::Mesh::DedupWindow::Result::Duplicate) continue;
            if (__sce_dedup_after_ordering == ::SCE::Mesh::DedupWindow::Result::NovelWithEviction) {
                // §16.7 row 7 — same overflow surface as admitInbound
                // (separate dispatch entry, identical raise contract).
                ::SCE::Mesh::CommunicationError __sce_dedup_err;
                __sce_dedup_err.reason = ::SCE::Mesh::ReasonCode::DedupWindowOverflow;
                __sce_dedup_err.source = env.source;
                __sce_dedup_err.window_size =
                    static_cast<std::int64_t>(::SCE::Mesh::DedupWindow::kCapacity);
                raiseCommunicationError(std::move(__sce_dedup_err));
            }
{% endif %}
            // session_idx is `0`: SCE_MESH.md §10.6 scopes
            // `ordering: required` to client-target bindings, and the
            // SOME/IP server pool (§14.4) does not participate in the
            // ordering admit chain — so every router that emits
            // driveOrderingTick runs with N_SESSIONS == 1.
            if (dispatchToSession(env, 0)) ++dispatched;
        }
        return dispatched;
    }

    /// Test hook: drive a single tick synchronously from the calling
    /// thread, bypassing the periodic tick thread's 50 ms cadence.
    /// Hermetic injection tests use this to verify gap behaviour
    /// without depending on the thread's wakeup timing.
    ///
    /// The behaviour is identical to one iteration of the periodic
    /// thread — `error.communication` events land on every hosted
    /// session via `raiseCommunicationError`, observable through
    /// whatever capture the test's sender-engine double provides.
    ///
    /// @return total number of envelopes released during this tick.
    std::size_t tickOrdering() {
        return driveOrderingTick();
    }

    /// Body of the `ordering_tick_thread_`. Blocks on the shutdown
    /// condvar with the deploy.yaml-supplied tick cadence
    /// ({{ machine_ordering.tick_period_ms }} ms here, from
    /// `machines.<name>.ordering.tick_period_ms`); drives one tick per
    /// wakeup until shutdown is signalled. Wait-lock is dropped around
    /// the tick call because `driveOrderingTick` takes the
    /// OrderingBuffer's internal mutex — nesting would deadlock if a
    /// raise path later acquired `ordering_tick_mutex_`.
    void orderingTickLoop() {
        while (true) {
            {
                std::unique_lock<std::mutex> lk(ordering_tick_mutex_);
                ordering_tick_cv_.wait_for(
                    lk, std::chrono::milliseconds({{ machine_ordering.tick_period_ms }}),
                    [this] { return ordering_tick_shutdown_.load(); });
                if (ordering_tick_shutdown_.load()) return;
            }
            (void)driveOrderingTick();
        }
    }

    /// Sequence-ordered admit + dispatch (SCE_MESH.md §10.6).
    ///
    /// Chains the three inbound layers the codegen composes for an
    /// ordered route: RpcReply/FieldNotify bypass → OrderingBuffer
    /// per-sender reorder → (optional) DedupRouter (source, id)
    /// filter → `dispatchToSession`.
    ///
    /// Why RpcReply / FieldNotify bypass: both patterns carry a
    /// `correlation_id` and match pending requests by that field,
    /// so their wire-level order is irrelevant to correctness.
    /// Routing them through the ordering buffer would add reply
    /// latency for an invariant no handler depends on.
    ///
    /// Why missing-sequence raise: §10.6.3 guarantees every sender on
    /// an ordered route stamps `sequence_no`. An envelope that
    /// reaches this method without the field signals an out-of-sync
    /// sender. The envelope is dropped from the ordering domain AND
    /// an `error.communication` event with reason `MISSING_SEQUENCE`
    /// is raised so authors can surface the drift (§16.7 row 11).
    ///
    /// `session_idx` carries the SCE_MESH.md §14.4 session routing
    /// contract verbatim through the ordering layer to
    /// `dispatchToSession`. §10.6 scopes `ordering: required` to
    /// client-target bindings and the SOME/IP server pool (§14.4)
    /// excludes ordering, so every router that emits `admitOrdered`
    /// runs with N_SESSIONS == 1 in practice.
    ///
    /// @return true iff at least one DATA envelope (from the
    ///         sequence-ordered stream) was released to the sender
    ///         engine during this admit call. Error.communication
    ///         raises are a side-channel dispatch and do NOT affect
    ///         this return value — they are always observable on
    ///         the sender regardless of what is returned here.
    ///         Callers that need to detect a MISSING_SEQUENCE raise
    ///         should watch for `error.communication` on the sender,
    ///         not poll the return value.
    [[nodiscard]] bool admitOrdered(const SCE::Mesh::MeshEnvelope& env,
                                    std::size_t session_idx) {
        using PK = SCE::Mesh::PatternKind;
        if (env.pattern == PK::RpcReply || env.pattern == PK::FieldNotify) {
            return dispatchToSession(env, session_idx);
        }
        if (!env.sequence_no.has_value()) {
            // §10.6.3 drift: raise MISSING_SEQUENCE so the engine
            // sees the condition, then drop from the ordering domain.
            SCE::Mesh::CommunicationError err;
            err.reason = ::SCE::Mesh::ReasonCode::MissingSequence;
            err.source = env.source;
            err.envelope_id = env.id;
            raiseCommunicationError(std::move(err));
            return false;
        }
        auto released = ordering_buffer_.admit(env.source, env);
        bool dispatched = false;
        for (auto& released_env : released) {
{% if has_undeduped_transport %}
            // §10.5 dedup chained after ordering. needs_ordering=true
            // + supplies_ordering=false implies needs_dedup=true for
            // every registry entry today, so this branch is the
            // common path — never a dead branch on current transports.
            if (!dedup_.admit(released_env.source, released_env.id)) {
                continue;
            }
{% endif %}
            if (dispatchToSession(released_env, session_idx)) {
                dispatched = true;
            }
        }
        return dispatched;
    }
{% endif %}

{% if has_server %}
    /// Route an outbound server response back through the transport layer.
    ///
    /// SCE_MESH.md §13 Session E: when the engine sends service.response.X
    /// (pattern == RpcReply), this method is called from the mesh send
    /// callback. It looks up the pending inbound request by correlation_id
    /// and routes the response through the transport-native reply mechanism
    /// (SOME/IP create_response + send, Zenoh Query::reply).
    ///
    /// @return true if the response was correlated and sent; false if no
    ///         pending request matched the correlation_id.
    [[nodiscard]] bool handleServerResponse(const SCE::Mesh::MeshEnvelope& env) {
        if (!env.correlation_id) return false;
        CorrelationKey ckey{*env.correlation_id};
{% if has_server_someip %}
        std::shared_ptr<vsomeip::message> original;
        {
            std::lock_guard<std::mutex> lock(server_pending_mutex_);
            auto it = pending_server_requests_.find(ckey);
            if (it == pending_server_requests_.end()) return false;
            original = it->second;
            pending_server_requests_.erase(it);
        }
        auto response = vsomeip::runtime::get()->create_response(original);
        auto buf = SCE::Mesh::encodeEnvelope(env);
        auto payload = vsomeip::runtime::get()->create_payload(
            reinterpret_cast<const vsomeip::byte_t*>(buf.data()),
            static_cast<uint32_t>(buf.size()));
        response->set_payload(payload);
        server_app_->send(response);
        return true;
{% elif has_server_zenoh %}
        std::lock_guard<std::mutex> lock(server_pending_mutex_);
        auto it = pending_server_queries_.find(ckey);
        if (it == pending_server_queries_.end()) return false;
{% if has_server_query_timeout %}
        // SCE Mesh gap Z2: cancel the deadline BEFORE erasing so the
        // timer cannot fire between find() and erase() and race the
        // reply. `cancelDeadline` returns false if the timer has
        // already fired — in that case `onServerQueryTimedOut`
        // already removed the entry, `find()` missed it, and this
        // line is unreachable.
        //
        // Deadlock analysis: `cancelDeadline` is `mark-cancelled,
        // don't wait` — it briefly takes only the scheduler's own
        // internal mutex, never blocks on in-flight callback
        // completion. When the scheduler fires a callback it
        // unlocks BEFORE invoking it (MeshDeadlineScheduler.h
        // `run()` loop), so an in-flight `onServerQueryTimedOut`
        // runs outside the scheduler mutex and blocks on
        // `server_pending_mutex_` — which this thread holds — until
        // handleServerResponse releases it, then executes
        // `erase(cid)` on an already-gone entry (a no-op). No lock
        // cycle, no wait dependency between the two mutexes.
        (void)deadline_scheduler_.cancelDeadline(ckey.id);
{% endif %}
        // Move the Query out and erase before reply — the query
        // handle is valid until reply() consumes it.
        auto stored_query = std::move(it->second);
        pending_server_queries_.erase(it);
        auto buf = SCE::Mesh::encodeEnvelope(env);
        stored_query.reply(zenoh::KeyExpr(ZENOH_SERVER_KEY),
                           zenoh::Bytes(std::move(buf)));
        return true;
{% endif %}
    }
{% if server.has_eventgroup %}

    /// Publish an eventgroup notification to all subscribed clients.
    ///
    /// SCE_MESH.md §8.1: when the engine raises a field.notify.X event
    /// spontaneously (without a preceding getter/setter request), the mesh
    /// send callback falls through handleServerResponse (no pending request
    /// to correlate) and reaches this method. The event is published via
    /// the transport's native pub/sub mechanism: SOME/IP `notify` to the
    /// offered eventgroup, or Zenoh `session.put` on the server key.
    ///
    /// `session_idx` identifies the sessions_ slot whose document raised
    /// the event. SCE_MESH.md §14.4: a pool server emits the notification
    /// on that session's own offered vsomeip instance
    /// (`SOMEIP_SERVER_INSTANCES[session_idx]`) so client-side
    /// instance-filtered subscriptions observe the correct origin. Non-
    /// pool routers run with N_SESSIONS == 1 and session_idx is always 0.
    ///
    /// @return true if the event matched an eventgroup binding and was
    ///         published; false if no binding matched (event dropped).
    [[nodiscard]] bool publishEventgroupNotify(const SCE::Mesh::MeshEnvelope& env,
                                               std::size_t session_idx) {
{% if has_server_someip %}
{% for eg in server.eventgroup_events if eg.event_id %}
        if (env.type == "{{ eg.event }}") {
            auto buf = SCE::Mesh::encodeEnvelope(env);
            auto payload = vsomeip::runtime::get()->create_payload(
                reinterpret_cast<const vsomeip::byte_t*>(buf.data()),
                static_cast<uint32_t>(buf.size()));
            // SCE_MESH.md §14.4: emit on the raising session's own
            // offered instance so pool deployments preserve per-
            // instance origin in spontaneous notifications. Client
            // subscribers that pin on a specific instance observe
            // only their bound session's events.
            server_app_->notify(SOMEIP_SERVER_SERVICE,
                                SOMEIP_SERVER_INSTANCES[session_idx],
                                SOMEIP_SERVER_EVENT_{{ eg.event_const }}, payload);
            return true;
        }
{% endfor %}
        return false;
{% elif has_server_zenoh %}
        // Zenoh pub/sub: session.put on the server key. Clients that
        // called declare_subscriber on this key receive the event. The
        // server's own put_sub filters self-published events by
        // routing_id. session_idx is unused — Zenoh is excluded from
        // the pool shape (SCE_MESH.md §14.4), so N_SESSIONS is 1 and
        // there is only one server-side instance axis to select.
        (void)session_idx;
{% for eg in server.eventgroup_events %}
        if (env.type == "{{ eg.event }}") {
            auto buf = SCE::Mesh::encodeEnvelope(env);
            zenoh_session_->put(zenoh::KeyExpr(ZENOH_SERVER_KEY),
                                zenoh::Bytes(std::move(buf)));
            return true;
        }
{% endfor %}
        return false;
{% endif %}
    }
{% endif %}
{% endif %}

{% if has_mesh_rpc.v %}
    /// Erase bookkeeping for an invoke that registered its correlation
    /// entry but abandoned the send before the envelope reached the
    /// wire — the `<invoke type="sce:mesh-rpc">` pre-envelope setup-fault
    /// class (SCE_MESH.md §9.5 three-tier error table): SOME/IP pool
    /// instance out-of-set, Zenoh key-substitution miss, malformed pool
    /// payload, unknown method on target, zenoh::ZException thrown
    /// while constructing the KeyExpr. Per §10.7.1 the caller raises
    /// error.execution with reason=INVOKE_SRC_NOT_FOUND; this helper
    /// drops the three router-scoped registrations (correlation entry,
    /// deadline, active_invokes site) so a later reply or state-exit
    /// cancel finds no stale state.
    ///
    /// handleCancel erases without firing the deliver callback, which
    /// is what we want — the pre-§9.5-realignment template called
    /// handleReply(Unavailable, {}) here, synthesizing a fake wire
    /// reply that fired error.invoke.<id> and collided with the
    /// caller's error.execution raise at the invoke site. Cleanup
    /// semantics are now single-source.
{% if has_any_retry.v %}
    /// SCE_MESH.md §16.7 row 3 follow-up — when the §9.5 invoke
    /// lifecycle terminates (deadline fire, author `<cancel>`,
    /// pre-wire setup-fault, zenoh `on_drop` terminal), any pending
    /// retry chain for the same envelope id must also be erased so
    /// the retry layer's DELIVERY_EXHAUSTED emission cannot race the
    /// invoke-side error.invoke.<id> / silent-drop raise. The router
    /// fans out the cancel to every per-target `RetryingDispatcher`;
    /// only one can hold the entry (the envelope's outbound target),
    /// so non-owning dispatchers return false and the call is
    /// idempotent on misses.
    void cancelEnvelopeRetryById(
        const std::array<std::uint8_t, 16>& envelope_id) noexcept {
{% for target in targets if target.retry %}
        (void){{ target.target_snake }}_retry_.cancelEnvelopeRetry(envelope_id);
{% endfor %}
    }

{% endif %}
    void cleanupAbandonedMeshInvoke(const std::array<std::uint8_t, 16>& invoke_uuid,
{% if has_any_retry.v %}
                                    const std::array<std::uint8_t, 16>& envelope_uuid,
{% endif %}
                                    const std::string& target,
                                    const std::string& fieldSuffix) {
        invoke_correlation_.handleCancel(invoke_uuid);
        (void)deadline_scheduler_.cancelDeadline(invoke_uuid);
{% if has_any_retry.v %}
        // §16.7 row 3 follow-up — retry chain for the same envelope
        // would otherwise fire DELIVERY_EXHAUSTED after the §10.7.1
        // error.execution raise has already moved the author past this
        // invoke. cancelEnvelopeRetryById uses the ENVELOPE uuid (the
        // retry layer's scheduler key) — disjoint from the invoke
        // deadline key. Idempotent on misses.
        cancelEnvelopeRetryById(envelope_uuid);
{% endif %}
        {
            std::lock_guard<std::mutex> lock(active_invokes_mutex_);
            active_invokes_.erase(InvokeSiteKey{target, fieldSuffix});
        }
    }

    /// Dispatch a `<invoke type="sce:mesh-rpc">` request (SCE_MESH.md §9.5).
    ///
    /// Generates a UUID v7 as the wire-level `invoke_id`, registers a
    /// deliver callback keyed on that UUID, arms the deadline timer if
    /// the invoke site declared `_mesh_deadline_ms`, and routes the
    /// envelope to the target transport via `route_send`. The deliver
    /// callback captures only the SCXML invoke id and a pointer to
    /// `sessions_[0]`, so it can raise `done.invoke.<id>` or
    /// `error.invoke.<id>` on the sender engine once the reply or
    /// deadline outcome resolves.
    ///
    /// Pool + mesh-rpc-client is rejected at codegen
    /// (CodegenError::PoolWithRpcClientUnsupported (kind: MeshRpc)), so every
    /// router that synthesizes this method runs with N_SESSIONS == 1
    /// and `sessions_[0]` is the sole correlation target.
    ///
    /// @return true if the request was submitted to the transport;
    ///         false if (target, fieldSuffix) has no matching invoke
    ///         site (caller-error — indicates codegen/runtime drift)
    ///         or the transport rejected the send.
    [[nodiscard]] bool invokeMeshRpc(const std::string& target,
                                     const std::string& fieldSuffix,
                                     const std::string& invokeId,
                                     const std::string& data) {
        SCE::Mesh::MeshEnvelope env;
        // SCE_MESH.md §16.7 row 3 follow-up: invoke uuid (correlation
        // + deadline key) is distinct from envelope uuid (retry +
        // dedup key) so the per-target RetryingDispatcher's
        // backoff scheduler entry cannot collide with the invoke
        // deadline's entry — both share the same
        // MeshDeadlineScheduler instance.
        const auto invoke_uuid = SCE::uuid::v7();
        const auto envelope_uuid = SCE::uuid::v7();
        env.id = envelope_uuid;
        env.invoke_id = invoke_uuid;
        env.source = "{{ machine_name }}";
        env.routing_id = routing_id_;
        env.pattern = SCE::Mesh::PatternKind::RpcRequest;
        env.datacontenttype = data.empty()
            ? SCE::Mesh::PayloadCodec::None
            : SCE::Mesh::PayloadCodec::Json;
        env.data.assign(data.begin(), data.end());

        bool matched_site = false;
{% for target in targets %}
{% for site in target.invoke_sites %}
        if (target == "{{ target.target }}" && fieldSuffix == "{{ site.field_suffix }}") {
            env.type = "{{ site.mesh_event }}";
{% if site.deadline_ms is not none %}
            // Per-invoke deadline from <param name="_mesh_deadline_ms">.
            // Fires handleDeadline on the invoke_correlation_ table which
            // invokes the deliver callback with RpcStatus::DeadlineExceeded —
            // surfaced to the parent as error.invoke.<invokeId>.
            //
            // §16.7 row 3 follow-up — when the binding declared a retry
            // policy, the deadline preempts any pending retry chain for
            // the same envelope so the retry layer's DELIVERY_EXHAUSTED
            // emission cannot race the deadline's error.invoke.<id>
            // raise. cancelEnvelopeRetryById fans out to every per-target
            // RetryingDispatcher with the ENVELOPE uuid (the retry
            // layer's own scheduler key); idempotent on misses.
            deadline_scheduler_.registerDeadline(invoke_uuid,
                std::chrono::milliseconds({{ site.deadline_ms }}),
                [this, invoke_uuid{% if has_any_retry.v %}, envelope_uuid{% endif %}]{
                    (void)invoke_correlation_.handleDeadline(invoke_uuid);
{% if has_any_retry.v %}
                    cancelEnvelopeRetryById(envelope_uuid);
{% endif %}
                });
{% endif %}
            matched_site = true;
        }
{% endfor %}
{% endfor %}
        if (!matched_site) {
            return false;  // codegen drift — (target, suffix) not in invoke_sites
        }

        // Register deliver callback BEFORE route_send so a synchronous
        // reply (local transport) cannot race with registration. The
        // callback captures `sessions_[0]` by raw pointer —
        // TransportRouter outlives every session per the ctor
        // contract, so the pointer is stable until shutdown joins all
        // callback threads. Pool + mesh-rpc-client is rejected at
        // codegen, so `sessions_[0]` is the sole session here.
        SenderEngine* sender_ptr = sessions_[0];
        std::string captured_invoke_id = invokeId;
        invoke_correlation_.registerInvoke(invoke_uuid, target,
            [sender_ptr, captured_invoke_id](
                SCE::Mesh::RpcStatus status,
                std::vector<std::uint8_t> payload) {
                typename SenderEngine::EventWithMetadata evt;
                evt.event = (status == SCE::Mesh::RpcStatus::Ok)
                    ? SenderEngine::Event::Done_invoke
                    : SenderEngine::Event::Error_invoke;
                evt.data.assign(payload.begin(), payload.end());
                evt.invokeId = captured_invoke_id;
                evt.originType = "sce:mesh-rpc";
                sender_ptr->raiseExternal(evt);
            });

        // Track both uuids per (target, fieldSuffix) so a later cancel
        // / setup-fault / zenoh on_drop has the envelope uuid available
        // for the retry-cancel fanout in addition to the invoke uuid
        // for the correlation/deadline erase.
        {
            std::lock_guard<std::mutex> lock(active_invokes_mutex_);
            active_invokes_[InvokeSiteKey{target, fieldSuffix}] =
                ActiveInvokeRecord{invoke_uuid, envelope_uuid};
        }

{% for target in targets if target.pool_plan and target.pool_plan.kind == "someip" %}
        // SCE_MESH.md §14.4: SOME/IP bounded pool — runtime instance selection.
        // The instance id is read from the `{{ target.pool_plan.instance_from }}`
        // <param> value on the invoking <invoke>, validated against the
        // compile-time `instances: [...]` set (all of which were already
        // request_service'd in init), and fed to vsomeip via set_instance
        // before the request is sent. Out-of-set values fail closed with
        // RpcStatus::Unavailable — vsomeip would silently drop them
        // otherwise because no request_service was ever issued for the id.
        if (target == "{{ target.target }}") {
            std::string pool_json(env.data.begin(), env.data.end());
            auto pool_parsed = ::SCE::EventDataHelper::jsonStringToScriptValue(pool_json);
            if (!pool_parsed) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
            auto* pool_obj_sp = std::get_if<std::shared_ptr<::ScriptObject>>(&*pool_parsed);
            if (!pool_obj_sp || !*pool_obj_sp) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
            auto& pool_obj = **pool_obj_sp;
            auto inst_it = pool_obj.properties.find("{{ target.pool_plan.instance_from }}");
            if (inst_it == pool_obj.properties.end()) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
            std::string inst_str = ::SCE::EventDataHelper::scriptValueToJsonString(inst_it->second);
            if (inst_str.size() >= 2 && inst_str.front() == '"' && inst_str.back() == '"') {
                inst_str = inst_str.substr(1, inst_str.size() - 2);
            }
            unsigned long long inst_ul = 0;
            const char* inst_begin = inst_str.data();
            const char* inst_end = inst_begin + inst_str.size();
            auto parse = std::from_chars(inst_begin, inst_end, inst_ul);
            if (parse.ec != std::errc() || parse.ptr != inst_end || inst_ul > 0xFFFFu) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
            vsomeip::instance_t runtime_instance = static_cast<vsomeip::instance_t>(inst_ul);
            static constexpr vsomeip::instance_t pool_instances_{{ target.target_snake }}[] = {
{% for i in target.pool_plan.instances %}                {{ i }}{% if not loop.last %},{% endif %}
{% endfor %}
            };
            if (std::find(std::begin(pool_instances_{{ target.target_snake }}),
                          std::end(pool_instances_{{ target.target_snake }}),
                          runtime_instance) == std::end(pool_instances_{{ target.target_snake }})) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
            vsomeip::method_t method_id = 0;
            bool method_set = false;
{% for ep in target.event_patterns if ep.field_kind == "method" %}
            if (env.type == "{{ ep.event }}") {
                method_id = SOMEIP_METHOD_{{ target.target_snake | upper }}_{{ ep.event_const }};
                method_set = true;
            }
{% endfor %}
            if (!method_set) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
            auto request = vsomeip::runtime::get()->create_request(
                {% if target.state.extra.protocol is defined and target.state.extra.protocol == "tcp" %}true{% else %}false{% endif %});
            request->set_service(SOMEIP_SERVICE_{{ target.target_snake | upper }});
            request->set_instance(runtime_instance);
            request->set_method(method_id);
            auto buf = SCE::Mesh::encodeEnvelope(env);
            auto payload = vsomeip::runtime::get()->create_payload(
                reinterpret_cast<const vsomeip::byte_t*>(buf.data()),
                static_cast<uint32_t>(buf.size()));
            request->set_payload(payload);
            {{ target.target_snake }}_app_->send(request);
            return true;
        }
{% endfor %}
{% for target in targets if target.pool_plan and target.pool_plan.kind == "zenoh" %}
        // SCE_MESH.md §14.4: Zenoh open pool — bind-time `key:` carries
        // `{name}` placeholders. Substituted at invoke time from the
        // JSON envelope payload (populated by the generator from the
        // author's `<param>` entries), yielding a per-invoke KeyExpr.
        // route_send cannot see placeholder values (it only accepts
        // `env`), so the pool path bypasses it and dispatches directly
        // via `zenoh_session_->get` with the same reply / on_drop
        // closures as the literal-key path (see `send_zenoh` RpcRequest
        // branch — semantics must stay in sync).
        if (target == "{{ target.target }}") {
            if (!zenoh_session_) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
            std::string pool_json(env.data.begin(), env.data.end());
            auto pool_parsed = ::SCE::EventDataHelper::jsonStringToScriptValue(pool_json);
            if (!pool_parsed) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
            auto* pool_obj_sp = std::get_if<std::shared_ptr<::ScriptObject>>(&*pool_parsed);
            if (!pool_obj_sp || !*pool_obj_sp) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
            auto& pool_obj = **pool_obj_sp;
            std::string pool_key = "{{ target.state.key }}";
{% for ph in target.pool_plan.placeholders %}
            {
                auto it = pool_obj.properties.find("{{ ph }}");
                if (it == pool_obj.properties.end()) {
                    cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                    return false;
                }
                // scriptValueToJsonString wraps strings in quotes; strip
                // them so the substitution yields the raw token value.
                std::string pv = ::SCE::EventDataHelper::scriptValueToJsonString(it->second);
                if (pv.size() >= 2 && pv.front() == '"' && pv.back() == '"') {
                    pv = pv.substr(1, pv.size() - 2);
                }
                const std::string token = "{{ '{' }}{{ ph }}{{ '}' }}";
                auto pos = pool_key.find(token);
                if (pos == std::string::npos) {
                    cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                    return false;
                }
                pool_key.replace(pos, token.size(), pv);
            }
{% endfor %}
            try {
                zenoh::KeyExpr pool_kexpr(pool_key);
                auto encoded = SCE::Mesh::encodeEnvelope(env);
                const char* reply = resolveReplyEvent(env.type);
                std::string reply_event = reply;
                zenoh::Session::GetOptions opts;
                opts.payload = zenoh::Bytes(std::move(encoded));
                auto reply_seen = std::make_shared<std::atomic<bool>>(false);
                std::optional<std::array<std::uint8_t, 16>> invoke_id_capture = env.invoke_id;
{% if has_any_retry.v %}
                // Envelope uuid is captured separately so on_drop's
                // retry-cancel fanout (§16.7 row 3 follow-up) keys off
                // the retry layer's scheduler key, not the invoke key.
                const auto envelope_id_capture = env.id;
{% endif %}
                zenoh_session_->get(
                    pool_kexpr, "",
                    [this, reply_event,
                     target_owned = std::string("{{ target.target }}"),
                     reply_seen](const zenoh::Reply& reply_msg) {
                        if (!reply_msg.is_ok()) return;
                        reply_seen->store(true, std::memory_order_release);
                        const auto& sample = reply_msg.get_ok();
                        auto bytes = sample.get_payload().as_vector();
                        SCE::Mesh::MeshEnvelope resp;
                        if (!SCE::Mesh::decodeEnvelope(bytes.data(), bytes.size(), resp)) {{ raise_envelope_corrupt("zenoh") }}
                        if (!reply_event.empty()) resp.type = reply_event;
                        resp.pattern = SCE::Mesh::PatternKind::RpcReply;
                        (void)this->admitZenohInbound(target_owned, resp);
                    },
                    [this, reply_seen, invoke_id_capture{% if has_any_retry.v %}, envelope_id_capture{% endif %}]() noexcept {
                        if (reply_seen->load(std::memory_order_acquire)) return;
                        if (!invoke_id_capture) return;
                        this->onZenohQueryDropped(*invoke_id_capture{% if has_any_retry.v %}, envelope_id_capture{% endif %});
                    },
                    std::move(opts));
                return true;
            } catch (const zenoh::ZException&) {
                cleanupAbandonedMeshInvoke(invoke_uuid,
{%- if has_any_retry.v %} envelope_uuid,{% endif %} target, fieldSuffix);
                return false;
            }
        }
{% endfor %}
        return route_send(target, env);
    }

    /// Cancel a pending mesh-rpc invoke (SCE_MESH.md §9.5 `<cancel>`).
    ///
    /// Called from generated onexit blocks when a state with a pending
    /// mesh-rpc invoke is left before the reply lands. Erases both the
    /// correlation entry and any armed deadline — a late reply arriving
    /// after cancel is silently dropped because `handleReply` finds no
    /// entry to fire. No cancel envelope is placed on the wire: §9.5
    /// "benign drop" semantics. Returns true if there was something to
    /// cancel, false if already fired or never registered.
    [[nodiscard]] bool cancelMeshRpc(const std::string& target,
                                     const std::string& fieldSuffix) {
        ActiveInvokeRecord rec;
        {
            std::lock_guard<std::mutex> lock(active_invokes_mutex_);
            auto it = active_invokes_.find(InvokeSiteKey{target, fieldSuffix});
            if (it == active_invokes_.end()) return false;
            rec = it->second;
            active_invokes_.erase(it);
        }
        (void)deadline_scheduler_.cancelDeadline(rec.invoke_uuid);
{% if has_any_retry.v %}
        // §16.7 row 3 follow-up — author <cancel> moved past the invoke;
        // any pending retry chain for the same envelope must not fire
        // DELIVERY_EXHAUSTED as a stale post-cancel signal. The retry
        // dispatcher's scheduler key is the envelope uuid; the invoke
        // deadline key is the invoke uuid — they are disjoint.
        cancelEnvelopeRetryById(rec.envelope_uuid);
{% endif %}
        return invoke_correlation_.handleCancel(rec.invoke_uuid);
    }
{% if has_zenoh_mesh_rpc %}

    /// Early-cancel a mesh-rpc invoke whose Zenoh `session.get` query
    /// terminated without a successful reply (SCE Mesh gap Z3).
    ///
    /// Zenoh fires the `on_drop` closure exactly once per query — after
    /// the last reply, on `queries_default_timeout` expiry, or on
    /// client session teardown. When that fires without any reply having
    /// been dispatched AND the query carried an `invoke_id` (§9.5 mesh-rpc
    /// path), the correlation entry would otherwise sit pending until
    /// `_mesh_deadline_ms` — wasting the deadline budget even though zenoh
    /// has already signalled query termination in milliseconds.
    ///
    /// This helper closes the gap. Deadline is cancelled first so the
    /// scheduler thread cannot fire `handleDeadline` on an entry we are
    /// about to erase — same ordering `cancelMeshRpc` uses. Then
    /// `handleReply(uuid, Unavailable, {})` delivers
    /// `error.invoke.<id>` through the standard invoke lifecycle path;
    /// `RpcStatus::Unavailable` (grpc::UNAVAILABLE, wire value 14)
    /// matches "peer not reachable" semantics for a dropped query.
    ///
    /// Thread-safety: runs on a zenoh runtime thread. Both
    /// `MeshDeadlineScheduler::cancelDeadline` and
    /// `InvokeCorrelation::handleReply` are internally synchronized.
    /// The deliver callback invoked by `handleReply` runs outside the
    /// correlation mutex, so a slow sender engine cannot block other
    /// drops on the same router.
    ///
    /// Shutdown semantics: router teardown closes the zenoh session,
    /// which fires on_drop for every inflight query in parallel. The
    /// `zenoh_shutdown_in_progress_` flag suppresses those firings —
    /// matches `MeshDeadlineScheduler::shutdown`'s "benign drop" policy
    /// (§9.5): a router being destroyed cannot deliver events, so
    /// dropped queries observe the same silent outcome as cancel.
    void onZenohQueryDropped(
        const std::array<std::uint8_t, 16>& invoke_uuid
{%- if has_any_retry.v %},
        const std::array<std::uint8_t, 16>& envelope_uuid
{%- endif %}) noexcept {
        if (zenoh_shutdown_in_progress_.load(std::memory_order_acquire)) {
            return;
        }
        (void)deadline_scheduler_.cancelDeadline(invoke_uuid);
{% if has_any_retry.v %}
        // §16.7 row 3 follow-up — zenoh query terminated (timeout /
        // session teardown / last reply). Any pending retry chain for
        // the same envelope is now moot; suppress its DELIVERY_EXHAUSTED.
        // Retry scheduler key is the envelope uuid (distinct from the
        // invoke uuid above).
        cancelEnvelopeRetryById(envelope_uuid);
{% endif %}
        (void)invoke_correlation_.handleReply(
            invoke_uuid, SCE::Mesh::RpcStatus::Unavailable, {});
    }
{% endif %}
{% endif %}
{% endif %}

{% if has_mesh_rpc.v or has_server_query_timeout %}
    /// Test-only accessor: number of currently-armed deadlines in
    /// `deadline_scheduler_`. Reads `active_.size()` through the
    /// scheduler's own const-correct accessor (`MeshDeadlineScheduler.h`).
    ///
    /// Verification role: the Z2 happy-path scenario calls this
    /// IMMEDIATELY after `handleServerResponse` to confirm
    /// `cancelDeadline` released the scheduler's `active_` entry.
    /// Without this direct signal, the test can only observe
    /// `pending_server_size() == 0` — which is trivially true whether
    /// `cancelDeadline` succeeded or the timer already fired and its
    /// callback ran a no-op erase, so the two failure modes are
    /// indistinguishable. Observing `deadline_scheduler_size() == 0`
    /// within milliseconds of the cancel (well before the deadline
    /// could elapse) pins the cancel path's liveness directly.
    [[nodiscard]] std::size_t deadline_scheduler_size() const {
        return deadline_scheduler_.size();
    }
{% endif %}
{% if has_server_query_timeout %}
    /// SCE Mesh gap Z2: fire when a stranded server queryable entry
    /// outlives `server.query_timeout_ms` because the engine never
    /// emitted the paired response envelope (e.g. the handling state
    /// was left before `<send event="service.response.X">` ran).
    ///
    /// Erasing the stored `zenoh::Query` destructs it; zenoh signals
    /// "query done" to the client peer, whose `session.get` `on_drop`
    /// closure fires. With gap Z3 wired client-side, the client raises
    /// `error.invoke.<id>` via `RpcStatus::Unavailable` — no new
    /// `error.communication` row is needed here (§9.5 + §16.7: all
    /// existing rows are client-centric, a server row would be
    /// speculative operator telemetry).
    ///
    /// Thread-safety: runs on the MeshDeadlineScheduler worker thread.
    /// `server_pending_mutex_` serializes with the queryable callback
    /// and `handleServerResponse`; lock order matches the insert /
    /// cancel sites (router mutex first, scheduler internal second).
    ///
    /// Shutdown semantics: `shutdown()` sets
    /// `server_shutdown_in_progress_` and drains the scheduler before
    /// tearing down the queryable — the flag is a belt-and-braces
    /// guard in case a callback is already dispatched when shutdown
    /// begins.
    void onServerQueryTimedOut(
        const std::array<std::uint8_t, 16>& cid) noexcept {
        if (server_shutdown_in_progress_.load(std::memory_order_acquire)) {
            return;
        }
        std::lock_guard<std::mutex> lock(server_pending_mutex_);
        pending_server_queries_.erase(CorrelationKey{cid});
    }

    /// Test-only accessor: number of inbound server queries still
    /// awaiting an engine response. A verification test asserts this
    /// drops to zero within `query_timeout_ms + slack` after the
    /// engine fails to emit the paired response.
    [[nodiscard]] std::size_t pending_server_size() const {
        std::lock_guard<std::mutex> lock(server_pending_mutex_);
        return pending_server_queries_.size();
    }

    /// Test-only accessor: the `CorrelationKey.id` (16-byte UUIDv7)
    /// of the first inbound server query still awaiting a response,
    /// or `std::nullopt` if none. A verification test uses this to
    /// hand-craft the matching response envelope without reaching
    /// into `pending_server_queries_` or `server_pending_mutex_`
    /// directly — preserves encapsulation of the pending map's
    /// internal layout, mirroring the `pending_server_size` shape.
    [[nodiscard]] std::optional<std::array<std::uint8_t, 16>>
    server_first_cid() const {
        std::lock_guard<std::mutex> lock(server_pending_mutex_);
        if (pending_server_queries_.empty()) return std::nullopt;
        return pending_server_queries_.begin()->first.id;
    }
{% endif %}

    /// Dispatch an incoming envelope to an arbitrary receiver engine.
    ///
    /// Generic fallback used by out-of-band callers (tests, special
    /// wiring). Prefer `dispatchToSession` when the target is one of
    /// the session engines bound at construction.
    ///
    /// @tparam Policy Receiver's StatePolicy (generated struct)
    /// @tparam Engine StaticExecutionEngine<Policy>
    /// @return true if the envelope was dispatched to the engine
    template <typename Policy, typename Engine>
    bool onIncoming(const SCE::Mesh::MeshEnvelope& env, Engine& engine) {
        return SCE::Mesh::dispatchEnvelope<Policy>(env, engine);
    }

{# ── (D6) Zenoh multi-pattern dispatch ──────────────────────────
   Zenoh realizes all four capability categories through four native API
   primitives: put (FireForget/FieldWrite), get+reply callback (RpcRequest/
   FieldRead), declare_subscriber (EventSubscribe), and handle destruction
   (EventUnsubscribe). Correlation is handled by the zenoh runtime — each
   get() invocation's on_reply closure captures the per-call reply-event
   name, so no correlation table is needed.

   Member function (not free) because multi-pattern dispatch requires
   mutating router state (zenoh_subscribers_) and capturing receive
   state (receive_callback_) into closures passed to the zenoh API. #}
{% if "zenoh" in transport_types %}
    /// Dispatch an outbound envelope through Zenoh using the pattern-matched
    /// native API. Called by route_send() with the target's key expression.
    ///
    /// @param env           outbound envelope (pattern-discriminated)
    /// @param key_expr_str  Zenoh key expression for the target (null-terminated)
    /// @param target_name   SCXML target string — key into zenoh_subscribers_
    /// @return true if the zenoh primitive accepted the operation; false if
    ///         the pattern is not outbound on this transport (inbound-only
    ///         patterns like EventNotify are rejected here).
    /// Per-target inbound dispatch for Zenoh client closures
    /// (SCE_MESH.md §10.5/§10.6). Keeps the admit-layer decision
    /// per-binding (SSoT with the SOME/IP side) instead of routing
    /// Zenoh through a machine-level flag: `reply` and subscribe
    /// callbacks close over the outbound target name, dispatch into
    /// this helper, and the build-time switch picks the right admit
    /// chain (ordering → dedup → direct) for exactly that binding.
    ///
