    std::size_t pumpScxmlInvokeRequests() {
        std::size_t total = 0;
{% for peer in scxml_remote_inbound_peers if peer.transport not in ("custom_tcp", "someip", "zenoh") %}
        if (!p2c_from_{{ peer.name }}_.valid()) {
            p2c_from_{{ peer.name }}_ = SCE::Mesh::ShmChannel<>(
                P2C_FROM_{{ peer.name | upper }},
                SCE::Mesh::ShmChannel<>::Mode::Open);
        }
        if (p2c_from_{{ peer.name }}_.valid()) {
            total += p2c_from_{{ peer.name }}_.drainWith(
                [this](const SCE::Mesh::MeshEnvelope& in) {
                    switch (in.pattern) {
                    case SCE::Mesh::PatternKind::InvokeStart:
                        worker_session_host_.onWire14(in,
                            [this](const SCE::Mesh::MeshEnvelope& env) -> bool {
                                return c2p_to_{{ peer.name }}_.send(env);
                            });
                        break;
                    case SCE::Mesh::PatternKind::ParentEvent:
                        worker_session_host_.onWire17(in);
                        break;
                    case SCE::Mesh::PatternKind::InvokeCancel:
                        worker_session_host_.onWire19(in);
                        break;
                    default:
                        break;  // misrouted pattern — drop
                    }
                },
                // SCE_MESH.md §16.7 row 4: malformed CBOR on the
                // p2c_from_<peer>_ shm channel raises with
                // `transport="shm"`. Lambda-body variant of
                // `raise_envelope_corrupt` (no trailing `return;`).
                [this]() {{ raise_envelope_corrupt_lambda("shm") }});
        }
{% endfor %}
