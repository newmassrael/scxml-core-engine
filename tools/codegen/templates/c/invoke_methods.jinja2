{% if model.invokes | scxml_family %}
{# ── drive_active_children ───────────────────────────────────────────
   Emitted only for machines that can actually hold a child. A
   §scxml-6.4.1 unsupported `type` rides the same pending queue but
   starts nothing, so for a machine whose only `<invoke>` is unsupported
   both walks below would render empty and leave `sm` unread — which the
   C11 test build rejects under `-Wunused-parameter -Werror`. The two
   call sites in `state_machine.c.jinja2` carry the same guard.

   W3C SCXML 6.4: drive every active child's macrostep so the parent's
   `<send target="#_<invokeid>" event="X">` lower (which enqueued onto
   the child's external queue) gets drained on the next call cycle.
   When a child reaches its top-level `<final>` here we synthesise
   `done.invoke` onto the parent's external queue — same shape as the
   sync-final raise in `execute_pending_invokes`. The parent's `_step`
   calls this AFTER `process_event_queues` and `execute_pending_invokes`
   so any sends the child raises during its own step (`<send target=
   "#_parent">` from a transition body) land on the parent's external
   queue in time for the next macrostep iteration to dequeue them. #}
static void {{ csym_prefix }}{{ model.name }}_drive_active_children({{ csym_prefix }}{{ model.name }}_t *sm) {
    {% for state_id, state in model.states | dictsort %}
    {% for invoke_info in state.invokes | hybrid %}
    /* W3C SCXML 6.4 (test216/530): hybrid stub children always reach
       `<final>` during `_init` (initial="final" by construction in
       `generate_hybrid_child_scxmls`), so the active flag will already
       be paired with `is_in_final_state == true` on entry. The only
       reason to drive them is defensive — a future stub that defers
       finalisation would land here. The trivial-stub fast path below
       no-ops gracefully. */
{% set tick_targets = invoke_info.candidates if invoke_info.candidates else [{'stem': invoke_info.child_name}] %}
{% for target in tick_targets %}
{% set slot = ('child_' ~ invoke_info.field_suffix ~ '_' ~ target.stem) if invoke_info.candidates else ('child_' ~ invoke_info.field_suffix) %}
    if (sm->{{ slot }}_active
        && !{{ csym_prefix }}{{ target.stem }}_is_in_final_state(&sm->{{ slot }})) {
        {{ csym_prefix }}{{ target.stem }}_step(&sm->{{ slot }});
{% if invoke_info.use_specific_event or 'done.invoke' in model.events %}
        /* Raised only when the document listens for it — see the spawn site. */
        if ({{ csym_prefix }}{{ target.stem }}_is_in_final_state(&sm->{{ slot }})) {
            {{ csym_prefix }}{{ model.name }}_event_with_meta_t _done_evt;
            memset(&_done_evt, 0, sizeof(_done_evt));
            _done_evt.event = {% if invoke_info.use_specific_event %}{{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_DONE_INVOKE_{{ invoke_info.invoke_id | upper | replace('.', '_') | replace('-', '_') }}{% else %}{{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_DONE_INVOKE{% endif %};
            sce_copy_bounded_id(_done_evt.invoke_id, sm->child_{{ invoke_info.field_suffix }}_invoke_id);
            {% if invoke_info.child_needs_script_engine %}
            /* W3C SCXML 5.5 + 6.3.1: hybrid async-final donedata carry. */
            {{ se.lua_marshal_child_donedata("sm->" ~ slot ~ ".L", "_done_evt") }}
            {% endif %}
            {{ csym_prefix }}{{ model.name }}_raise_external(sm, &_done_evt);
        }
{% endif %}
    }
{% endfor %}
    {% endfor %}
    {% for invoke_info in state.invokes | scxml %}
    if (sm->child_{{ invoke_info.field_suffix }}_active
        && !{{ csym_prefix }}{{ invoke_info.child_name }}_is_in_final_state(&sm->child_{{ invoke_info.field_suffix }})) {
        {% if invoke_info.child_needs_event_scheduler %}
        /* W3C SCXML 6.2 (test207): the child carries `<send delay>`
           in its own session, so call its `_tick` (which promotes
           elapsed scheduled events onto its internal queue, then
           runs a macrostep). Driving `_step` alone would never
           dispatch the child's delayed events. */
        {{ csym_prefix }}{{ invoke_info.child_name }}_tick(&sm->child_{{ invoke_info.field_suffix }});
        {% else %}
        {{ csym_prefix }}{{ invoke_info.child_name }}_step(&sm->child_{{ invoke_info.field_suffix }});
        {% endif %}
        if ({{ csym_prefix }}{{ invoke_info.child_name }}_is_in_final_state(&sm->child_{{ invoke_info.field_suffix }})) {
            /* W3C SCXML 6.4 / 6.3.1: child completed asynchronously
               (post-init parent→child message drove it to <final>).
               Raise done.invoke with the spawn-time invoke_id stamped
               by `execute_pending_invokes`. The send-to-parent body
               of the child's terminal transition has already enqueued
               onto sm's external queue — done.invoke lands AFTER it
               (FIFO) so a parent that has both a verdict-event
               transition and a `done.invoke → fail` net (test192/253)
               drains the verdict event first. */
            {{ csym_prefix }}{{ model.name }}_event_with_meta_t _done_evt;
            memset(&_done_evt, 0, sizeof(_done_evt));
            _done_evt.event = {% if invoke_info.use_specific_event %}{{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_DONE_INVOKE_{{ invoke_info.invoke_id | upper | replace('.', '_') | replace('-', '_') }}{% else %}{{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_DONE_INVOKE{% endif %};
            sce_copy_bounded_id(_done_evt.invoke_id, sm->child_{{ invoke_info.field_suffix }}_invoke_id);
            {% if invoke_info.child_needs_script_engine %}
            /* W3C SCXML 5.5 + 6.3.1: scxml async-final donedata carry —
               the child reached `<final>` during a post-init macrostep
               (parent→child `<send target="#_<invokeid>">` drove it).
               Same lift contract as the sync-final site in
               `execute_pending_invokes`; the lua-side `_pending_donedata`
               slot is whatever the child's terminal `<donedata>` emit
               stashed before this `_step` returned. */
            {{ se.lua_marshal_child_donedata("sm->child_" ~ invoke_info.field_suffix ~ ".L", "_done_evt") }}
            {% endif %}
            {{ csym_prefix }}{{ model.name }}_raise_external(sm, &_done_evt);
        }
    }
    {% endfor %}
    {% endfor %}
}

{# ── destroy_active_children ──────────────────────────────────────────
   Called from `_destroy` to reclaim any children still active.
   Idempotent on already-destroyed children (active flag gate). #}
static void {{ csym_prefix }}{{ model.name }}_destroy_active_children({{ csym_prefix }}{{ model.name }}_t *sm) {
    {% for state_id, state in model.states | dictsort %}
    {% for invoke_info in state.invokes | scxml %}
    if (sm->child_{{ invoke_info.field_suffix }}_active) {
        {{ csym_prefix }}{{ invoke_info.child_name }}_destroy(&sm->child_{{ invoke_info.field_suffix }});
        sm->child_{{ invoke_info.field_suffix }}_active = false;
    }
    {% endfor %}
    {% for invoke_info in state.invokes | hybrid %}
{% set destroy_targets = invoke_info.candidates if invoke_info.candidates else [{'stem': invoke_info.child_name}] %}
{% for target in destroy_targets %}
{% set slot = ('child_' ~ invoke_info.field_suffix ~ '_' ~ target.stem) if invoke_info.candidates else ('child_' ~ invoke_info.field_suffix) %}
    if (sm->{{ slot }}_active) {
        {{ csym_prefix }}{{ target.stem }}_destroy(&sm->{{ slot }});
        sm->{{ slot }}_active = false;
    }
{% endfor %}
    {% endfor %}
    {% endfor %}
}
{% endif %}
