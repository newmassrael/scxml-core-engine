{# ── W3C SCXML 6.4: Invoke lifecycle helpers (per-SM) ────────────────
   Mirrors `tools/codegen/templates/invoke_methods.jinja2` (cpp) — the
   C11 emitter inlines a focused subset (defer queue + child SM struct
   embed + macrostep-end execute hook + onexit cancel/destroy +
   cross-machine `#_parent` dispatch + `<param>` / `namelist` value
   transfer).

   T3 lock-in: per-SM logic emitted into `_sm.c`. Cross-SM types
   (`sce_invoke_pending_queue_t`) live in `sce-c-runtime/include/sce/invoke.h`
   as static inline helpers — no .c source.                             #}

{% set _ns = namespace(any_child_parent_send=false) %}
{% for invoke_info in model.invokes | scxml %}
{% if invoke_info.child_has_send_to_parent %}
{% set _ns.any_child_parent_send = true %}
{% endif %}
{% endfor %}

{% if _ns.any_child_parent_send %}
{# ── dispatch_external_by_name ───────────────────────────────────────
   W3C SCXML 6.4: child-to-parent event routing shim. Children spawned
   via `<invoke>` whose body contains `<send target="#_parent">` invoke
   this function through their `parent_dispatch` fn pointer (stamped on
   the child SM struct at `execute_pending_invokes` time). The shim
   converts the event-name string to this SM's event enum and enqueues
   onto the external queue, mirroring the parent-template parameter
   shape the cpp backend uses for the same routing.

   Event names absent from this SM's enum (events the analyzer's
   `collect_child_to_parent_events` pass did not promote because no
   `<send target="#_parent">` in any registered child fixture used them)
   silently drop. Wildcard `event="*"` parent transitions still match
   any of the promoted names because the dispatch goes through the
   regular external queue, which the macrostep evaluates against every
   transition's matcher (W3C SCXML 3.13). The empty NULL-guard handles
   defensive callers — production children always pass a valid name. #}
static void {{ model.name }}_dispatch_external_by_name(void *opaque, const char *name, const char *invoke_id) {
    if (opaque == NULL || name == NULL) {
        return;
    }
    {{ model.name }}_t *sm = ({{ model.name }}_t *)opaque;
    {{ model.name }}_event_with_meta_t evt;
    memset(&evt, 0, sizeof(evt));
    if (invoke_id != NULL) {
        strncpy(evt.invoke_id, invoke_id, (size_t)SCE_MAX_ID_LEN - 1u);
        evt.invoke_id[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
    }
    {% for ev_name in model.events | sort %}
    if (strcmp(name, "{{ ev_name }}") == 0) {
        evt.event = {{ model.name | upper }}_EVENT_{{ ev_name | upper | replace('.', '_') | replace('-', '_') }};
        {{ model.name }}_raise_external(sm, &evt);
        return;
    }
    {% endfor %}
}
{% endif %}

{# ── execute_pending_invokes ─────────────────────────────────────────
   Drain the parent's pending queue at macrostep end. For each pending:
     1. Initialize the embedded child SM (its onentry runs; if its initial
        is a top-level <final>, it reaches the final state immediately).
     2. Mark the child as active (so destroy/cancel can reclaim).
     3. Check `is_in_final_state` — when the child has already reached
        a top-level <final> (e.g. inline content whose only state is
        <final>), raise the parent's `done.invoke` event (W3C 6.3.1)
        onto the external queue.
   Cross-SM event routing for children whose initial onentry sends to
   the parent (`<send target="#_parent">`) — and the parent→child tick
   loop those children require to reach final asynchronously — is the
   surface the next lift phase extends here. #}
static void {{ model.name }}_execute_pending_invokes({{ model.name }}_t *sm) {
    if (sm->pending_invokes.count == 0) {
        return;
    }

    /* W3C SCXML 6.4: cpp `InvokeHelper::executePendingInvokes` copies the
       pending vector before iterating — child init may push more events
       (via <send target="#_parent">) but won't recurse into pending
       since <invoke> in the child's onentry would push to the child's
       own pending queue, not the parent's. C11 mirrors with a snapshot
       count + clear-up-front. */
    int n = sm->pending_invokes.count;
    sce_invoke_pending_t snapshot[SCE_MAX_INVOKES];
    for (int i = 0; i < n; ++i) {
        snapshot[i] = sm->pending_invokes.entries[i];
    }
    sce_invoke_pending_clear(&sm->pending_invokes);

    for (int i = 0; i < n; ++i) {
        const sce_invoke_pending_t *p = &snapshot[i];

        {% for state_id, state in model.states | dictsort %}
        {% for invoke_info in state.invokes | scxml %}
        if (p->state == (int){{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}
            && p->invoke_idx == {{ loop.index0 }}) {
            /* W3C SCXML 6.4: spawn child {{ invoke_info.child_name }}
               (invoke id `{{ invoke_info.invoke_id }}` in state `{{ state_id }}`). */
            {% if invoke_info.child_has_send_to_parent %}
            /* W3C SCXML 6.4 (test191/338): stamp parent-routing fields
               BEFORE the configuration entry walk by passing them
               through `_init_with_parent`. `<onentry><send target="#_parent">`
               in the child runs during `enter_state_recursive` inside
               this call, so a NULL `parent_dispatch` would silently
               drop the event. Fixtures whose child only routes to
               `#_parent` from inside `<transition>` bodies (test226/
               240/241/243/244/245/276) are unaffected by the stamp
               ordering — those sends fire later from the macrostep
               loop below — but the unified `_init_with_parent` entry
               point keeps a single child-SM init shape. */
            {{ invoke_info.child_name }}_init_with_parent(
                &sm->child_{{ invoke_info.field_suffix }},
                sm,
                {{ model.name }}_dispatch_external_by_name,
                p->invoke_id);
            {% else %}
            {{ invoke_info.child_name }}_init(&sm->child_{{ invoke_info.field_suffix }});
            {% endif %}
            sm->child_{{ invoke_info.field_suffix }}_active = true;
            /* W3C SCXML 6.3.1: persist the spawn-time invoke id so
               `_drive_active_children` can stamp `done.invoke.invoke_id`
               for async-final children whose own SM struct does not
               carry an `invoke_id` slot (test247-shape children with
               no `<send target="#_parent">`). */
            strncpy(sm->child_{{ invoke_info.field_suffix }}_invoke_id, p->invoke_id,
                    (size_t)SCE_MAX_ID_LEN - 1u);
            sm->child_{{ invoke_info.field_suffix }}_invoke_id[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
            {% if invoke_info.child_needs_script_engine and (invoke_info.params or invoke_info.namelist) %}
            /* W3C SCXML 6.4.1 (test226/240/241/243/244/245/276):
               `<param>` and `namelist` value passing. Evaluate each
               param's `expr` (or read each namelist name's binding)
               on the parent's `lua_State` so the value lands on
               `sm->L`'s top of stack, then transfer to the child's
               `lua_State` as a global under the param/namelist name —
               overriding the `<data expr=...>` defaults that the
               child's `_init` already seeded. The cpp backend mirrors
               this shape via `child->setParamInScriptEngine(name, expr)`
               (`tools/codegen/templates/invoke_methods.jinja2:118-128`)
               but transfers the expr STRING for re-evaluation in the
               child's engine; C11 evaluates parent-side because each
               generated SM owns its own Lua state and a parent-side
               variable name is undefined in the child's state. For
               literal exprs (the entire W3C corpus param/namelist
               surface) both shapes converge on the same observable.

               Names not declared in the child's `<datamodel>` skip
               the transfer (test245: namelist Var2 with no child
               <data id="Var2"> stays unbound) — mirrors cpp's
               `DatamodelValidationHelper::isVariableDeclaredInChild`
               filter at `invoke_methods.jinja2:102-104`. */
            {% if invoke_info.params %}
            {% for param in invoke_info.params %}
            {% if invoke_info.child_datamodel_vars and param.name in invoke_info.child_datamodel_vars %}
            /* `<param name="{{ param.name }}" expr="{{ param.expr | escape_c }}"/>` */
            if (luaL_dostring(sm->L,
                "return ({{ param.expr | to_lua_expr | escape_c }})") == 0) {
{{ se.lua_xfer_top_to_child("sm->L", "sm->child_" ~ invoke_info.field_suffix ~ ".L", param.name) }}
            } else {
                lua_pop(sm->L, 1);
            }
            {% endif %}
            {% endfor %}
            {% endif %}
            {% if invoke_info.namelist %}
            {% for ns_name in invoke_info.namelist.split() %}
            {% if invoke_info.child_datamodel_vars and ns_name in invoke_info.child_datamodel_vars %}
            /* namelist `{{ ns_name }}` */
            lua_getglobal(sm->L, "{{ ns_name }}");
{{ se.lua_xfer_top_to_child("sm->L", "sm->child_" ~ invoke_info.field_suffix ~ ".L", ns_name) }}
            {% endif %}
            {% endfor %}
            {% endif %}
            {% endif %}
            {% if invoke_info.child_has_send_to_parent %}
            /* W3C SCXML 6.4: drive the child's deferred macrostep loop
               now that param/namelist have been applied and parent
               routing is live. The bound (16) is a safety net — the
               W3C corpus' Phase-3 children reach `<final>` in one
               macrostep (single eventless transition + send-to-parent
               + enter subFinal). The first iteration that observes
               `is_in_final_state` exits before calling `_step` again
               so a child that finalised during init's entry walk
               (test247-style sync-final) costs zero `_step` calls. */
            for (int _step_n = 0; _step_n < 16; ++_step_n) {
                if ({{ invoke_info.child_name }}_is_in_final_state(&sm->child_{{ invoke_info.field_suffix }})) {
                    break;
                }
                {{ invoke_info.child_name }}_step(&sm->child_{{ invoke_info.field_suffix }});
            }
            {% endif %}
            /* The child's `_init` runs the configuration entry walk and
               onentry actions of its initial state. When the initial is
               a top-level <final> (test247), is_in_final_state returns
               true at this point and we synthesise `done.invoke`
               immediately so the parent's next dequeue drains it. */
            if ({{ invoke_info.child_name }}_is_in_final_state(&sm->child_{{ invoke_info.field_suffix }})) {
                {{ model.name }}_event_with_meta_t _done_evt;
                memset(&_done_evt, 0, sizeof(_done_evt));
                /* W3C SCXML 6.4 / 6.3.1 (test235): when the parent has a
                   `done.invoke.<id>` transition (used_done_invoke_events
                   contains the specific name), `use_specific_event` is
                   set on the invoke and the spec-mirror raise emits the
                   `_<id>` enum variant. Otherwise the generic
                   `done.invoke` enum carries the event (test247). cpp
                   `invoke_methods.jinja2:160` makes the same choice via
                   the `Event::Done_invoke_<id>` vs `Event::Done_invoke`
                   ternary. */
                _done_evt.event = {% if invoke_info.use_specific_event %}{{ model.name | upper }}_EVENT_DONE_INVOKE_{{ invoke_info.invoke_id | upper | replace('.', '_') | replace('-', '_') }}{% else %}{{ model.name | upper }}_EVENT_DONE_INVOKE{% endif %};
                strncpy(_done_evt.invoke_id, p->invoke_id, (size_t)SCE_MAX_ID_LEN - 1u);
                _done_evt.invoke_id[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
                {{ model.name }}_raise_external(sm, &_done_evt);
            }
            continue;
        }
        {% endfor %}
        {% endfor %}
    }
}

{# ── drive_active_children ───────────────────────────────────────────
   W3C SCXML 6.4: drive every active child's macrostep so the parent's
   `<send target="#_<invokeid>" event="X">` lower (which enqueued onto
   the child's external queue) gets drained on the next call cycle.
   When a child reaches its top-level `<final>` here we synthesise
   `done.invoke` onto the parent's external queue — same shape as the
   sync-final raise in `execute_pending_invokes`. The parent's `_step`
   calls this AFTER `process_event_queues` and `execute_pending_invokes`
   so any sends the child raises during its own step (`<send target=
   "#_parent">` from a transition body) land on the parent's external
   queue in time for the next macrostep iteration to dequeue them. #}
static void {{ model.name }}_drive_active_children({{ model.name }}_t *sm) {
    {% for state_id, state in model.states | dictsort %}
    {% for invoke_info in state.invokes | scxml %}
    if (sm->child_{{ invoke_info.field_suffix }}_active
        && !{{ invoke_info.child_name }}_is_in_final_state(&sm->child_{{ invoke_info.field_suffix }})) {
        {% if invoke_info.child_needs_event_scheduler %}
        /* W3C SCXML 6.2 (test207): the child carries `<send delay>`
           in its own session, so call its `_tick` (which promotes
           elapsed scheduled events onto its internal queue, then
           runs a macrostep). Driving `_step` alone would never
           dispatch the child's delayed events. */
        {{ invoke_info.child_name }}_tick(&sm->child_{{ invoke_info.field_suffix }});
        {% else %}
        {{ invoke_info.child_name }}_step(&sm->child_{{ invoke_info.field_suffix }});
        {% endif %}
        if ({{ invoke_info.child_name }}_is_in_final_state(&sm->child_{{ invoke_info.field_suffix }})) {
            /* W3C SCXML 6.4 / 6.3.1: child completed asynchronously
               (post-init parent→child message drove it to <final>).
               Raise done.invoke with the spawn-time invoke_id stamped
               by `execute_pending_invokes`. The send-to-parent body
               of the child's terminal transition has already enqueued
               onto sm's external queue — done.invoke lands AFTER it
               (FIFO) so a parent that has both a verdict-event
               transition and a `done.invoke → fail` net (test192/253)
               drains the verdict event first. */
            {{ model.name }}_event_with_meta_t _done_evt;
            memset(&_done_evt, 0, sizeof(_done_evt));
            _done_evt.event = {% if invoke_info.use_specific_event %}{{ model.name | upper }}_EVENT_DONE_INVOKE_{{ invoke_info.invoke_id | upper | replace('.', '_') | replace('-', '_') }}{% else %}{{ model.name | upper }}_EVENT_DONE_INVOKE{% endif %};
            strncpy(_done_evt.invoke_id, sm->child_{{ invoke_info.field_suffix }}_invoke_id,
                    (size_t)SCE_MAX_ID_LEN - 1u);
            _done_evt.invoke_id[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
            {{ model.name }}_raise_external(sm, &_done_evt);
        }
    }
    {% endfor %}
    {% endfor %}
}

{# ── destroy_active_children ──────────────────────────────────────────
   Called from `_destroy` to reclaim any children still active.
   Idempotent on already-destroyed children (active flag gate). #}
static void {{ model.name }}_destroy_active_children({{ model.name }}_t *sm) {
    {% for state_id, state in model.states | dictsort %}
    {% for invoke_info in state.invokes | scxml %}
    if (sm->child_{{ invoke_info.field_suffix }}_active) {
        {{ invoke_info.child_name }}_destroy(&sm->child_{{ invoke_info.field_suffix }});
        sm->child_{{ invoke_info.field_suffix }}_active = false;
    }
    {% endfor %}
    {% endfor %}
}
