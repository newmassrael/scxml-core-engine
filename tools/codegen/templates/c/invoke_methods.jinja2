{# ── W3C SCXML 6.4: Invoke lifecycle helpers (per-SM) ────────────────
   Mirrors `tools/codegen/templates/invoke_methods.jinja2` (cpp) — the
   C11 emitter inlines a focused subset (defer queue + child SM struct
   embed + macrostep-end execute hook + onexit cancel/destroy +
   cross-machine `#_parent` dispatch + `<param>` / `namelist` value
   transfer).

   Per-SM logic is emitted into `_sm.c`. Cross-SM types
   (`sce_invoke_pending_queue_t`) live in `backends/c/runtime/include/sce/invoke.h`
   as static inline helpers — no .c source.                             #}
{%- import 'c/param_macros.jinja2' as param_macros %}

{% set _ns = namespace(any_child_parent_send=false) %}
{% for invoke_info in model.invokes | scxml %}
{% if invoke_info.child_has_send_to_parent %}
{% set _ns.any_child_parent_send = true %}
{% endif %}
{% endfor %}
{# A declared candidate is an ordinary document the parent may start, and
   announcing itself with `<send target="#_parent">` is how a selection
   becomes observable at all — so the routing shim is owed here for the same
   reason the static-invoke scan above owes it. Emitted for any candidate
   set rather than per candidate's own content: the set is the unit the
   parent commits to, and a shim that appeared only for some of them would
   make the selection's observability depend on which document won. #}
{% for invoke_info in model.invokes | hybrid %}
{% if invoke_info.candidates %}
{% set _ns.any_child_parent_send = true %}
{% endif %}
{% endfor %}

{% if _ns.any_child_parent_send %}
{# ── dispatch_external_by_name ───────────────────────────────────────
   W3C SCXML 6.4: child-to-parent event routing shim. Children spawned
   via `<invoke>` whose body contains `<send target="#_parent">` invoke
   this function through their `parent_dispatch` fn pointer (stamped on
   the child SM struct at `execute_pending_invokes` time). The shim
   converts the event-name string to this SM's event enum and enqueues
   onto the external queue, mirroring the parent-template parameter
   shape the cpp backend uses for the same routing.

   Event names absent from this SM's enum (events the analyzer's
   `collect_child_to_parent_events` pass did not promote because no
   `<send target="#_parent">` in any registered child fixture used them)
   silently drop. Wildcard `event="*"` parent transitions still match
   any of the promoted names because the dispatch goes through the
   regular external queue, which the macrostep evaluates against every
   transition's matcher (W3C SCXML 3.13). The empty NULL-guard handles
   defensive callers — production children always pass a valid name. #}
static void {{ csym_prefix }}{{ model.name }}_dispatch_external_by_name(void *opaque, const char *name, const char *invoke_id, const char *event_data) {
    if (opaque == NULL || name == NULL) {
        return;
    }
    {{ csym_prefix }}{{ model.name }}_t *sm = ({{ csym_prefix }}{{ model.name }}_t *)opaque;
    {{ csym_prefix }}{{ model.name }}_event_with_meta_t evt;
    memset(&evt, 0, sizeof(evt));
    sce_copy_bounded_id(evt.invoke_id, invoke_id);
    /* W3C SCXML C.1 `_event.origin`: an invoked session is an external entity
       from the parent's point of view, and the clause names exactly which
       address its parent-bound events carry — the 'location' the SENDING
       session published in its own `_ioprocessors`. `#_<invokeid>` is the
       parent's way to address the child (§6.4), not the child's published
       location, so an origin spelled that way matches nothing the child
       published and a peer comparing the two never agrees.

       The child's location is the address it published for itself at `_init`
       (see `scriptengine.jinja2`), read here from the child instance the
       parent embeds. The invoke id -> child slot mapping is known at codegen
       time, so the address still needs no runtime session registry — but the
       address itself is the child's to state, because it names that child's
       session rather than the document it was generated from. */
    if (invoke_id != NULL && invoke_id[0] != '\0') {
{% for invoke_info in model.invokes | scxml %}
        if (strcmp(invoke_id, "{{ invoke_info.invoke_id }}") == 0) {
            sce_copy_bounded_origin(evt.origin, sm->child_{{ invoke_info.field_suffix }}.scxml_location);
        }
{% endfor %}
    }
    /* W3C SCXML 6.4 (test233): copy child-supplied `<send><param>` Lua-
       source string into `event_with_meta_t.data`. The dequeue path
       loads it into the parent's L state as `_event.data` before
       transition matching + finalize. NULL or empty `event_data` leaves
       the slot zero-initialised so the dequeue's empty-string check
       skips the load — same observable as cpp `EventWithMetadata{event,
       data=""}` in the no-param send-to-parent shape. */
    if (event_data != NULL && event_data[0] != '\0') {
        strncpy(evt.data, event_data, (size_t)SCE_MAX_DATA_LEN - 1u);
        evt.data[(size_t)SCE_MAX_DATA_LEN - 1u] = '\0';
    }
    {% for ev_name in model.events | sort %}
    if (strcmp(name, "{{ ev_name }}") == 0) {
        evt.event = {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_{{ ev_name | upper | replace('.', '_') | replace('-', '_') }};
        {{ csym_prefix }}{{ model.name }}_raise_external(sm, &evt);
        return;
    }
    {% endfor %}
}
{% endif %}

{# ── execute_pending_invokes ─────────────────────────────────────────
   Drain the parent's pending queue at macrostep end. For each pending:
     1. Initialize the embedded child SM (its onentry runs; if its initial
        is a top-level <final>, it reaches the final state immediately).
     2. Mark the child as active (so destroy/cancel can reclaim).
     3. Check `is_in_final_state` — when the child has already reached
        a top-level <final> (e.g. inline content whose only state is
        <final>), raise the parent's `done.invoke` event (W3C 6.3.1)
        onto the external queue.
   Cross-SM event routing for children whose initial onentry sends to
   the parent (`<send target="#_parent">`) — and the parent→child tick
   loop those children require to reach final asynchronously — is the
   surface the next lift phase extends here. #}
static void {{ csym_prefix }}{{ model.name }}_execute_pending_invokes({{ csym_prefix }}{{ model.name }}_t *sm) {
    if (sm->pending_invokes.count == 0) {
        return;
    }

    /* W3C SCXML 6.4: cpp `InvokeHelper::executePendingInvokes` copies the
       pending vector before iterating — child init may push more events
       (via <send target="#_parent">) but won't recurse into pending
       since <invoke> in the child's onentry would push to the child's
       own pending queue, not the parent's. C11 mirrors with a snapshot
       count + clear-up-front. */
    int n = sm->pending_invokes.count;
    sce_invoke_pending_t snapshot[SCE_MAX_INVOKES];
    for (int i = 0; i < n; ++i) {
        snapshot[i] = sm->pending_invokes.entries[i];
    }
    sce_invoke_pending_clear(&sm->pending_invokes);

    for (int i = 0; i < n; ++i) {
        const sce_invoke_pending_t *p = &snapshot[i];

        {% for state_id, state in model.states | dictsort %}
        {% for invoke_info in state.invokes | unsupported %}
        if (p->state == (int){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}
            && p->invoke_idx == {{ loop.index0 + (state.invokes | scxml | length) }}) {
{% if invoke_info.host_served %}
            /* W3C SCXML 6.4.1: the host declared this `type`, so START the
               invocation rather than refusing it. The id handed over is the
               DOCUMENT's, not the per-instance one the pending queue carries:
               `done.invoke.<id>` is the name the author wrote a transition
               for, so it is the name the host must answer on.

               Emitted inside the `unsupported` loop rather than in a
               `host_invoker` one of its own, because `p->invoke_idx` is
               positional — it counts this state's invokes in order, and a
               second loop would restart the index and address the wrong
               entry. The two arms are told apart by the per-entry flag. */
{% set host_namelist = (invoke_info.namelist | split) if invoke_info.namelist else [] %}
{% set host_param_cap = (invoke_info.params | length) + (host_namelist | length) %}
{% if host_param_cap > 0 %}
            sce_host_send_param_t _host_inv_params[{{ host_param_cap }}];
            int _host_inv_param_count = 0;
{% endif %}
{% if invoke_info.idlocation %}
            /* W3C SCXML 6.4.1: the invocation's generated id goes to
               `idlocation` when the element is evaluated. It is the id the
               host is handed and `done.invoke.<id>` names, so the document can
               match on what it stored. The write is the assignment `<assign>`
               makes, so a member path lands, and a location that cannot take
               the id starts nothing (W3C SCXML 5.9.2). */
            {
                bool _idloc_ok = false;
{{ se.lua_store_id_in_location(invoke_info.idlocation, '"' ~ (invoke_info.invoke_id | escape_c) ~ '"', '_idloc_ok') }}
                if (!_idloc_ok) {
{% if 'error.execution' in model.events %}
                    {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                        sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                        "<invoke idlocation='{{ invoke_info.idlocation | escape_c }}'> could not take the invoke id");
{% endif %}
                    continue;
                }
            }
{% endif %}
            /* W3C SCXML 6.4.1: what the request says is evaluated now, when
               the invocation starts. An attribute that cannot be evaluated
               raises error.execution and starts nothing; a `<param>` that
               cannot is reported and dropped (W3C SCXML 5.7.1) while the
               invocation still starts. */
{% for attr, buf, cap, expr in [('src', '_host_inv_src', 'SCE_MAX_URI_LEN', invoke_info.srcexpr), ('content', '_host_inv_content', 'SCE_MAX_DATA_LEN', invoke_info.contentexpr)] %}
{% if expr %}
            char {{ buf }}[{{ cap }}];
            bool {{ buf }}_ok = false;
{{ se.lua_eval_to_wire_string(expr, buf, 'sizeof(' ~ buf ~ ')', buf ~ '_ok') }}
            if (!{{ buf }}_ok) {
{% if 'error.execution' in model.events %}
                {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                    sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                    "<invoke> {{ attr }}expr failed to evaluate");
{% endif %}
                continue;
            }
{% endif %}
{% endfor %}
{% for var_name in host_namelist %}
            char _host_inv_nl_value_{{ loop.index0 }}[SCE_MAX_DATA_LEN];
            bool _host_inv_nl_ok_{{ loop.index0 }} = false;
{{ se.lua_namelist_var_to_wire_string(var_name, '_host_inv_nl_value_' ~ loop.index0, 'sizeof(_host_inv_nl_value_' ~ loop.index0 ~ ')', '_host_inv_nl_ok_' ~ loop.index0) }}
            if (!_host_inv_nl_ok_{{ loop.index0 }}) {
                /* W3C SCXML 5.9.2: a namelist item that names no readable
                   location is an error, and the invocation does not start. */
{% if 'error.execution' in model.events %}
                {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                    sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                    "<invoke> namelist names '{{ var_name | escape_c }}', which could not be read");
{% endif %}
                continue;
            }
            _host_inv_params[_host_inv_param_count].name = "{{ var_name | escape_c }}";
            _host_inv_params[_host_inv_param_count].value = _host_inv_nl_value_{{ loop.index0 }};
            _host_inv_param_count++;
{% endfor %}
{% if invoke_info.invoke_id in host_invoke_request_checks %}
{% set request_checks = host_invoke_request_checks[invoke_info.invoke_id] %}
            /* SCE Accepted Subset 2.12: `sce:request` makes the params a
               record, so each value is held to its field here, where the
               invocation starts; one that cannot be evaluated or does not fit
               starts nothing. A string literal was held to its field at build
               time, so it passes as written. */
{% for param in invoke_info.params %}
{% if param.name in request_checks and not param.is_static_literal %}
            char _host_inv_typed_{{ loop.index0 }}[SCE_MAX_DATA_LEN];
            const char *_host_inv_refusal_{{ loop.index0 }} = NULL;
{{ se.lua_eval_to_request_field(param.expr or param.location, request_checks[param.name], '_host_inv_typed_' ~ loop.index0, 'sizeof(_host_inv_typed_' ~ loop.index0 ~ ')', '_host_inv_refusal_' ~ loop.index0) }}
            if (_host_inv_refusal_{{ loop.index0 }} != NULL) {
{% if 'error.execution' in model.events %}
                char _host_inv_message[SCE_MAX_DATA_LEN];
                snprintf(_host_inv_message, sizeof(_host_inv_message),
                         "<invoke> <param name='{{ param.name | escape_c }}'> cannot be its request field: '{{ param.name | escape_c }}' %s",
                         _host_inv_refusal_{{ loop.index0 }});
                {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                    sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION, _host_inv_message);
{% endif %}
                continue;
            }
            _host_inv_params[_host_inv_param_count].name = "{{ param.name | escape_c }}";
            _host_inv_params[_host_inv_param_count].value = _host_inv_typed_{{ loop.index0 }};
            _host_inv_param_count++;
{% else %}
{{ param_macros.collect_host_params_into([param], model, csym_prefix, '_host_inv_params', '_host_inv_param_count', '_host_inv_param_' ~ loop.index0, '<invoke>', '            ') -}}
{% endif %}
{% endfor %}
{% else %}
{{ param_macros.collect_host_params_into(invoke_info.params, model, csym_prefix, '_host_inv_params', '_host_inv_param_count', '_host_inv_param', '<invoke>', '            ') -}}
{% endif %}
            {
                sce_host_invoke_event_t _host_inv;
                memset(&_host_inv, 0, sizeof(_host_inv));
                _host_inv.phase = SCE_HOST_INVOKE_START;
                _host_inv.processor_type = "{{ invoke_info.invoke_type | escape_c }}";
                _host_inv.invoke_id = "{{ invoke_info.invoke_id | escape_c }}";
                _host_inv.src = {% if invoke_info.srcexpr %}_host_inv_src{% else %}"{{ invoke_info.src | default('', true) | escape_c }}"{% endif %};
                _host_inv.content = {% if invoke_info.contentexpr %}_host_inv_content{% else %}"{{ invoke_info.content | default('', true) | escape_c }}"{% endif %};
                /* W3C SCXML 6.4.1: the machine's one start path records the
                   invocation, reads its deadline and runs the handler; this
                   site only says what the document wrote. */
                if (!{{ csym_prefix }}{{ model.name }}_perform_host_invoke(
                        sm, &_host_inv, {% if host_param_cap > 0 %}_host_inv_params, _host_inv_param_count{% else %}NULL, 0{% endif %})) {
                    /* W3C SCXML 6.4.1: declared but no invoker registered. The
                       document asked for a process to be run and none was,
                       which is the same fact as an unsupported type — so the
                       same event, rather than a silence that reads as
                       started. */
{% if 'error.execution' in model.events %}
                    {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                        sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                        "<invoke> names an invoker the host declared but never registered");
{% endif %}
                }
            }
{% else %}
            /* W3C SCXML 6.4.1: unsupported `type` — place error.execution on
               the internal queue and start nothing. */
            {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                "<invoke type='{{ invoke_info.invoke_type | escape_c }}'> names an external service this platform does not support");
{% endif %}
            continue;
        }
        {% endfor %}
        {% for invoke_info in state.invokes | scxml %}
        if (p->state == (int){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}
            && p->invoke_idx == {{ loop.index0 }}) {
            {% if invoke_info.namelist %}
            {# W3C SCXML 6.4 / test554: a namelist name not declared in the
               parent's `<datamodel>` is an evaluation error — cpp
               `InvokeExecutor::startInvoke` (sce/src/runtime/InvokeExecutor.cpp:425-432)
               aborts the spawn via `destroySession + return ""`, propagating
               error.execution upstream. Parent vars are statically known
               at codegen time (model.variables), so the membership check
               folds to a compile-time predicate. The `loop.first` arm
               emits the error.execution raise + skip-spawn (`continue`)
               exactly once on the first undeclared name — subsequent
               undeclared names produce no output (the spawn is already
               aborted). The param/namelist transfer block below stays
               unreachable for this iteration. #}
            {% set _parent_var_ids = model.variables | map(attribute='id') | list %}
            {% for _ns_name in invoke_info.namelist.split() if _ns_name not in _parent_var_ids %}
            {% if loop.first %}
            /* W3C SCXML 6.4 (test554): namelist references undeclared
               parent var `{{ _ns_name }}` — abort spawn and raise
               error.execution per cpp `InvokeExecutor`. */
            {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                "<invoke> namelist names '{{ _ns_name }}', which the parent does not declare");
            continue;
            {% endif %}
            {% endfor %}
            {% endif %}
            /* W3C SCXML 6.4: spawn child {{ invoke_info.child_name }}
               (invoke id `{{ invoke_info.invoke_id }}` in state `{{ state_id }}`). */
            {% if invoke_info.child_has_send_to_parent %}
            /* W3C SCXML 6.4 (test191/338): stamp parent-routing fields
               BEFORE the configuration entry walk by passing them
               through `_init_with_parent`. `<onentry><send target="#_parent">`
               in the child runs during `enter_initial_configuration` inside
               this call, so a NULL `parent_dispatch` would silently
               drop the event. Fixtures whose child only routes to
               `#_parent` from inside `<transition>` bodies (test226/
               240/241/243/244/245/276) are unaffected by the stamp
               ordering — those sends fire later from the macrostep
               loop below — but the unified `_init_with_parent` entry
               point keeps a single child-SM init shape. */
            {{ csym_prefix }}{{ invoke_info.child_name }}_init_with_parent(
                &sm->child_{{ invoke_info.field_suffix }},
                sm,
                {{ csym_prefix }}{{ model.name }}_dispatch_external_by_name,
                p->invoke_id);
            {% else %}
            {{ csym_prefix }}{{ invoke_info.child_name }}_init(&sm->child_{{ invoke_info.field_suffix }});
            {% endif %}
            sm->child_{{ invoke_info.field_suffix }}_active = true;
            /* W3C SCXML 6.3.1: persist the spawn-time invoke id so
               `_drive_active_children` can stamp `done.invoke.invoke_id`
               for async-final children whose own SM struct does not
               carry an `invoke_id` slot (test247-shape children with
               no `<send target="#_parent">`). */
            sce_copy_bounded_id(sm->child_{{ invoke_info.field_suffix }}_invoke_id, p->invoke_id);
            {% if invoke_info.child_needs_script_engine and (invoke_info.params or invoke_info.namelist) %}
            /* W3C SCXML 6.4.1 (test226/240/241/243/244/245/276):
               `<param>` and `namelist` value passing. Evaluate each
               param's `expr` (or read each namelist name's binding)
               on the parent's `lua_State` so the value lands on
               `sm->L`'s top of stack, then transfer to the child's
               `lua_State` as a global under the param/namelist name —
               overriding the `<data expr=...>` defaults that the
               child's `_init` already seeded. C11 evaluates
               parent-side because each generated SM owns its own Lua
               state and a parent-side variable name is undefined in
               the child's state.

               The cpp backend transferred the expr STRING for
               re-evaluation in the child's engine until the fixture
               `integration_resources/invoke_param_seeds_declared_child_data/`
               separated the two: for literal exprs — the entire W3C
               corpus param/namelist surface — both shapes converge on
               the same observable, which is why the divergence lived
               as long as it did. It now passes the value, so this
               backend's shape and cpp's are the same shape.

               Names not declared in the child's `<datamodel>` skip
               the transfer (test245: namelist Var2 with no child
               <data id="Var2"> stays unbound). §scxml-6.4.3 requires
               it — "if the names do not match, the Processor MUST NOT
               add the value ... to the invoked session's data model" —
               and cpp decides the same question at codegen time now,
               having reached it through the runtime
               `DatamodelValidationHelper::isVariableDeclaredInChild`
               on its namelist arm alone. */
            {% if invoke_info.params %}
            {% for param in invoke_info.params %}
            {% if invoke_info.child_datamodel_vars and param.name in invoke_info.child_datamodel_vars %}
            /* `<param name="{{ param.name }}" expr="{{ param.expr }}"/>` */
            if (luaL_dostring(sm->L,
                "return ({{ param.expr | to_lua_expr | escape_c }})") == 0) {
{{ se.lua_xfer_top_to_child("sm->L", "sm->child_" ~ invoke_info.field_suffix ~ ".L", param.name) }}
            } else {
                /* §scxml-5.7.1: BOTH halves — `error.execution` on the internal
                   queue AND the name and value ignored. Only the silent half was
                   here: the error object was popped and the child came up with a
                   `<data>` nothing explained.

                   The clause delegates only the SUCCESSFUL name and value to the
                   context ("Otherwise the use of the name and value depends on
                   the context ... See 5.5 <donedata>, 6.2 <send> and 6.4
                   <invoke>"), so §scxml-6.4.2's "terminate the processing of the
                   element" is not what a failing `<param>` costs: the child still
                   starts, one pair short. */
                lua_pop(sm->L, 1);
                {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                    sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                    "<invoke> <param name='{{ param.name | escape_c }}'> expr failed to evaluate");
            }
            {% endif %}
            {% endfor %}
            {% endif %}
            {% if invoke_info.namelist %}
            {% for ns_name in invoke_info.namelist.split() %}
            {% if invoke_info.child_datamodel_vars and ns_name in invoke_info.child_datamodel_vars %}
            /* namelist `{{ ns_name }}` */
            lua_getglobal(sm->L, "{{ ns_name }}");
{{ se.lua_xfer_top_to_child("sm->L", "sm->child_" ~ invoke_info.field_suffix ~ ".L", ns_name) }}
            {% endif %}
            {% endfor %}
            {% endif %}
            {% endif %}
            /* W3C SCXML 6.4: drive the child's deferred main event loop
               now that param/namelist have been applied and parent
               routing is live. At least one pass, even for a child whose
               entry walk already entered its top-level <final>
               (test236/247-style sync-final): that loop is where the
               child runs §scxml-D-exitInterpreter, so its `<onexit>` —
               and any `<send target="#_parent">` in it — happens before
               the done.invoke raised below. A child that sends to its
               parent is driven further, up to a safety bound of 16 —
               the W3C corpus' invoked children reach `<final>` in one
               macrostep; any other child is driven on from
               `_drive_active_children`. */
            {{ csym_prefix }}{{ invoke_info.child_name }}_step(&sm->child_{{ invoke_info.field_suffix }});
            {% if invoke_info.child_has_send_to_parent %}
            for (int _step_n = 1; _step_n < 16; ++_step_n) {
                if ({{ csym_prefix }}{{ invoke_info.child_name }}_is_in_final_state(&sm->child_{{ invoke_info.field_suffix }})) {
                    break;
                }
                {{ csym_prefix }}{{ invoke_info.child_name }}_step(&sm->child_{{ invoke_info.field_suffix }});
            }
            {% endif %}
            /* The child's `_init` runs the configuration entry walk and
               onentry actions of its initial state. When the initial is
               a top-level <final> (test247), is_in_final_state returns
               true at this point and we synthesise `done.invoke`
               immediately so the parent's next dequeue drains it. */
            if ({{ csym_prefix }}{{ invoke_info.child_name }}_is_in_final_state(&sm->child_{{ invoke_info.field_suffix }})) {
                /* W3C SCXML 6.4 (test236): the child's own main event loop
                   ran exitInterpreter when it entered its final, so every
                   `<onexit><send target="#_parent">` it holds is already on
                   this machine's external queue, ahead of the done.invoke
                   raised here. */
                {{ csym_prefix }}{{ model.name }}_event_with_meta_t _done_evt;
                memset(&_done_evt, 0, sizeof(_done_evt));
                /* W3C SCXML 6.4 / 6.3.1 (test235): when the parent has a
                   `done.invoke.<id>` transition (used_done_invoke_events
                   contains the specific name), `use_specific_event` is
                   set on the invoke and the spec-mirror raise emits the
                   `_<id>` enum variant. Otherwise the generic
                   `done.invoke` enum carries the event (test247). cpp
                   `invoke_methods.jinja2:160` makes the same choice via
                   the `Event::Done_invoke_<id>` vs `Event::Done_invoke`
                   ternary. */
