{#
    `<name>_saved.h`: the header of a C11 machine's saved unit (docs/adr/0110, D2,
    SCE Accepted Subset §2.15). It declares the saved form of every type the
    machine declares (`static_saved_defs`, the functions that write a value of
    each to a saved state and read one back) and, for a machine whose state a
    saved state holds, the doors a host saves and restores it through, which
    `c/saved.c.jinja2` defines. A test component reads its module parameters by
    the same readers (docs/SCE_TEST_PROFILE.md §11.5), so its source includes
    this header too.

    Hosted by design: it includes the saved-state runtime, which formats and
    reads JSON text with the C library. The machine's own header includes
    nothing of it, so a deployment that does not persist compiles neither this
    nor the unit.
#}
{% include 'license_header.jinja2' %}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{# Kept in step with the same `set`s in `state_machine.h.jinja2`: what `_judge`
   and `_restore` take besides the text. #}
{% set ns_maps = namespace(any=false, holds=false, judges=false) %}
{% for field in static_fields %}{% if field.saved_kind in ["map", "set"] %}{% set ns_maps.holds = true %}{% endif %}{% endfor %}
{% for invoke_info in model.invokes | scxml %}{% if invoke_info.child_takes_map_seed %}{% set ns_maps.any = true %}{% endif %}{% if invoke_info.child_judges_saved_maps %}{% set ns_maps.judges = true %}{% endif %}{% endfor %}
{% for invoke_info in model.invokes | hybrid %}{% for candidate in invoke_info.candidates %}{% if candidate.child_takes_map_seed %}{% set ns_maps.any = true %}{% endif %}{% if candidate.child_judges_saved_maps %}{% set ns_maps.judges = true %}{% endif %}{% endfor %}{% endfor %}
{% if ns_maps.holds %}{% set ns_maps.judges = true %}{% endif %}
{% if ns_maps.judges or static_seeds_algorithms %}{% set ns_maps.any = true %}{% endif %}
{% set map_seed_param = ', sce_map_seed_t map_seed' if ns_maps.any else '' %}
{% set _t = csym_prefix ~ model.name %}

{# The SCE-MAP marker every emitted file carries (`_macros/sce_map_marker.jinja2`),
   at module level as the machine's own header has it. #}
{{ sce_map.source_marker(model.source_location, "c", module_level=true, symbol_artifact=sce_artifact.machine) }}

#ifndef SCE_GENERATED_{{ csym_prefix | upper }}{{ model.name | upper }}_SAVED_H
#define SCE_GENERATED_{{ csym_prefix | upper }}{{ model.name | upper }}_SAVED_H

#include "{{ model.name }}_sm.h"
/* The saved-state runtime: the JSON writer and reader every saved form is written with, and the
   readers and writers of a saved value of each type. */
#include "sce/saved_state.h"

#ifdef __cplusplus
extern "C" {
#endif
{% if static_saved_defs %}

/* ── The saved form of each type the machine declares (SCE Accepted Subset §2.15) ── */
{{ static_saved_defs }}
{% endif %}
{% if static_saved_shape %}
{% set saved_restore_args = model.needs_event_scheduler or model.host_processor_types or model.host_invoker_types or has_native_actions %}

/* ── SCE Accepted Subset §2.15: saving this machine, restoring it ───── */
/* A running machine saved at a macrostep boundary, and restored into a new process in place of
   `_init` (docs/adr/0045). The saved state is JSON (`sce-saved-state`, format 3; formats 1 and 2
   are read too), the same on every backend, so a state another backend saved is one this machine
   restores, and the other way round. Nothing is allocated: the host owns the buffer a state is
   written into and the text one is read from, and every refusal is one sentence in `err`
   (`sce/saved_json.h`), in the words the other backends use. */

/* The state of `sm`, written to `buf` of `cap` bytes as `sce-saved-state` JSON, terminated.
   `wall_now_ms` is what time it is on the wall clock, in milliseconds since the Unix epoch: each
   delayed `<send>` still waiting is written as the moment it comes due on that clock, not as a
   wait, which would start again when the process came back.

   `*len` is the length of the text, not counting its terminator, whether or not it fit: called
   with `buf` NULL, this measures the text, and a host sizes its buffer by it. False, with the
   reason in `err`, for a machine that is not running, one whose last macrostep stopped at the
   microstep ceiling, and a buffer too small. */
bool {{ _t }}_save(const {{ _t }}_t *sm, int64_t wall_now_ms, char *buf, size_t cap, size_t *len,
                   sce_saved_error_t *err);

/* Whether `text` is a state a machine of this document could restore, built from nothing and
   touching no machine: its shape, its variables, its configuration, its queue and its waiting
   sends are judged. What a parent's restore asks of the state of each child it holds. */
{% if ns_maps.judges %}
/* docs/adr/0108, D8: `check` is where the judge puts each map's entries to find a key held
   twice, storage of the bound the host holds (`_saved_check_t`) and the judge's alone while
   it runs; nothing the judge answers depends on what it held before. */
{% endif %}
bool {{ _t }}_judge(const char *text, size_t len{% if ns_maps.judges %}, {{ _t }}_saved_check_t *check{% endif %}, sce_saved_error_t *err);

/* Stand `sm`, storage the caller owns, where `text` left a machine of this document: in place of
   `_init`, so no `<onentry>` runs and no `<data>` is evaluated, since the saved run already did
   both. Every value is read and the state judged before `sm` is touched, so a refused restore
   leaves the storage as it was.

   `wall_now_ms` is what time it is on the wall clock the saved `due`s were written against. A
   delayed `<send>` is armed against the machine's clock to come due `due - wall_now_ms` after
   now, and one that came due while the machine was away comes due now. A tree (format 2 or 3)
   carries on under the id it was saved with, which every child's id and a peer's address name; a
   format-1 state holds none, so the machine keeps the one it drew. The host drives the machine
   on as it would one it had initialized. */
bool {{ _t }}_restore({{ _t }}_t *sm, const char *text, size_t len, int64_t wall_now_ms{% if saved_restore_args %},
                      const {{ _t }}_restore_args_t *args{% endif %}{{ map_seed_param }}, sce_saved_error_t *err);

/* ── The session of a tree (docs/adr/0045) ───────────────────────────── */
/* A tree of sessions is saved by each session writing its own members into the object of its
   parent's `invokes[i].session`, and restored by each being resumed where it stood. A parent
   calls these on the child it runs, which it embeds; a host has no use for them. */

/* Write the members of this session into the object `w` has open, in the order every backend
   writes them. The root's `_save` is this inside the object that names the format. */
bool {{ _t }}_save_members(const {{ _t }}_t *sm, int64_t wall_now_ms, sce_jw_t *w, sce_saved_error_t *err);

/* Refuse `members`, the object a child session was saved as in a tree of `form` (a child states no
   format: its tree's is its own), unless it is a state of this document, building nothing
   (docs/adr/0045, section 3, step 1). */
bool {{ _t }}_judge_members(sce_jv_t members, int form{% if ns_maps.judges %}, {{ _t }}_saved_check_t *check{% endif %}, sce_saved_error_t *err);

/* Stand `sm`, a machine its parent has begun (`_invoked_begin`) and not entered, where `members`
   left it, read in the format `form` of its tree, in place of `_invoked_enter`: no `<onentry>`, no
   `<data>`, nothing sent. */
bool {{ _t }}_resume({{ _t }}_t *sm, sce_jv_t members, int form, int64_t wall_now_ms, sce_saved_error_t *err);
{% endif %}

#ifdef __cplusplus
}
#endif

#endif  /* SCE_GENERATED_{{ csym_prefix | upper }}{{ model.name | upper }}_SAVED_H */
