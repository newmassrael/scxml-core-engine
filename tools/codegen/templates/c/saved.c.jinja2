{#
    Saving this machine and restoring it (SCE Accepted Subset §2.15, docs/adr/0045):
    the functions of a `sce-static` document that saves, included by
    `state_machine.c.jinja2` after the doors that construct a machine. The C11
    twin of the saved block of tools/codegen/templates/go/state_machine.go.jinja2
    and of tools/codegen/templates/python/saved_functions.py.jinja2.

    The profile is the C11 one: nothing is allocated. A text a machine restores is
    read in place (`sce/saved_state.h`), a text it saves is written into a buffer
    the host owns (`sce/saved_json.h`), and a value is read into the machine's own
    fields by a reader that judges it without keeping it when it is handed no place
    to keep it. So a state is judged before anything is written, and a restore a
    machine refuses leaves it as the caller had it (`_restore` constructs the
    machine only after the judge has passed).

    The `_save`, `_judge` and `_restore` doors are declared in the header.
#}

{%- import '_macros/c_child_begin.jinja2' as child_begin %}
{#- A variable's saved form. `is_enum` says the value is of an enum, written and
    read by the functions its type declares beside it. -#}
{% macro put_scalar(is_enum, stype, expr) -%}
{%- if is_enum -%}
{{ stype }}_saved_write(w, {{ expr }});
{%- elif stype == "string" -%}
sce_saved_write_string(w, ({{ expr }}).data);
{%- elif stype == "bytes" -%}
sce_saved_write_bytes(w, ({{ expr }}).data, ({{ expr }}).len);
{%- else -%}
sce_saved_write_{{ stype }}(w, {{ expr }});
{%- endif -%}
{%- endmacro %}
{% macro get_scalar(is_enum, stype, bound, member, what, dest) -%}
{%- if is_enum -%}
{{ stype }}_saved_read({{ member }}, {{ what }}, &{{ dest }}, err)
{%- elif stype == "string" -%}
sce_saved_read_string_bounded({{ member }}, {{ what }}, ({{ dest }}).data, {{ bound }}u, err)
{%- elif stype == "bytes" -%}
sce_saved_read_bytes({{ member }}, {{ what }}, ({{ dest }}).data, {{ bound }}u, &({{ dest }}).len, err)
{%- else -%}
sce_saved_read_{{ stype }}({{ member }}, {{ what }}, &{{ dest }}, err)
{%- endif -%}
{%- endmacro %}
{#- The statement that writes the variable `field`, held in `expr`. -#}
{% macro put_value(field, expr) -%}
{%- if field.saved_kind == "scalar" -%}
{{ put_scalar(false, field.saved_type, expr) }}
{%- elif field.saved_kind == "enum" -%}
{{ put_scalar(true, field.saved_type, expr) }}
{%- elif field.saved_kind == "record" -%}
{{ field.saved_type }}_saved_write(w, &{{ expr }});
{%- elif field.saved_kind == "list" -%}
sce_jw_begin_array(w);
    for (size_t at_ = 0u; at_ < ({{ expr }}).len; ++at_) {
        sce_jw_element(w);
        {{ put_scalar(false, field.saved_type, expr ~ ".data[at_]") }}
    }
    sce_jw_end_array(w);
{%- elif field.saved_kind == "record_list" -%}
sce_jw_begin_array(w);
    for (size_t at_ = 0u; at_ < ({{ expr }}).len; ++at_) {
        sce_jw_element(w);
        {{ field.saved_type }}_saved_write(w, &({{ expr }}).data[at_]);
    }
    sce_jw_end_array(w);
{%- elif field.saved_kind == "optional" -%}
if (({{ expr }}).present) {
        {{ put_scalar(field.saved_elem == "enum", field.saved_type, expr ~ ".value") }}
    } else {
        sce_jw_null(w);
    }
{%- endif -%}
{%- endmacro %}
{#- Which revision of its schema the record the variable `field` holds was saved at:
    the entry of `record_at` for the lineage that names the variable a holder, and 1
    for a variable that is no record. -#}
{% macro record_at_of(field) -%}
{%- set found = namespace(index=-1) -%}
{%- for record in static_saved_shape.records -%}
{%- set outer = loop.index0 -%}
{%- for holder in record.holders -%}
{%- if holder.variable == field.id -%}{%- set found.index = outer -%}{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- if found.index >= 0 -%}record_at[{{ found.index }}]{%- else -%}1u{%- endif -%}
{%- endmacro %}

