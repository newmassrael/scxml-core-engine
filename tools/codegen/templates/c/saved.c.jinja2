SCE_SM_FN static const {{ _t }}_saved_invoke_owner_t *{{ _t }}_saved_invoke_owner(sce_jv_t id) {
    for (size_t i = 0u; i < sizeof({{ _t }}_saved_invoke_owners) / sizeof({{ _t }}_saved_invoke_owners[0]); ++i) {
        if (sce_jv_string_is(id, {{ _t }}_saved_invoke_owners[i].id)) {
            return &{{ _t }}_saved_invoke_owners[i];
