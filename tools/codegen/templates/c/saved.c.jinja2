/* The name the document writes for an event, which a saved state holds it by. */
SCE_SM_FN static SCE_C_UNUSED const char *{{ _t }}_saved_event_name({{ _t }}_event_t event) {
    switch (event) {
{% for event_name in model.events | sort %}
    case {{ _u }}_EVENT_{{ event_name | to_c11_upper_ident }}:
        return "{{ event_name | event_wire_name }}";
{% endfor %}
    default:
        return "";
    }
}

/* The states of `bits`, in document order, as a saved state lists them. */
SCE_SM_FN static void {{ _t }}_saved_write_states(sce_jw_t *w, uint32_t bits) {
    sce_jw_begin_array(w);
    for (uint32_t k = 0u; k < (uint32_t){{ _u }}_STATE_COUNT; ++k) {
        const {{ _t }}_state_t s = k_document_order[k];
        if ((bits & state_bit(s)) != 0u) {
            sce_jw_element(w);
            sce_jw_string(w, {{ _t }}_state_name(s));
        }
    }
    sce_jw_end_array(w);
}

{# ── Variables ─────────────────────────────────────────────────────────── #}
{% for field in static_fields %}
/* The variable `{{ field.id }}`, read from its saved form; `out` may be NULL, which judges the
   value and keeps nothing. */
SCE_SM_FN static bool {{ _t }}_saved_read_{{ field.name }}(sce_jv_t v, const char *what, unsigned at, {{ field.ty }} *out,
                                                        sce_saved_error_t *err) {
    {{ field.ty }} value;
    (void)at;
    memset(&value, 0, sizeof(value));
{% if field.saved_kind == "scalar" %}
    if (!{{ get_scalar(false, field.saved_type, field.bound, "v", "what", "value") }}) {
        return false;
    }
{% elif field.saved_kind == "enum" %}
    if (!{{ get_scalar(true, field.saved_type, field.bound, "v", "what", "value") }}) {
        return false;
    }
{% elif field.saved_kind == "record" %}
    if (!{{ field.saved_type }}_saved_read(v, what, at, &value, err)) {
        return false;
    }
{% elif field.saved_kind == "list" or field.saved_kind == "record_list" %}
    {
        size_t count = 0u;
        sce_jiter_t it;
        sce_jv_t item;
        char element_what[SCE_SAVED_AT_LEN];
        if (!sce_saved_list(v, what, {{ field.bound }}u, &count, err)) {
            return false;
        }
        (void)sce_jv_iter(v, &it);
        for (size_t i = 0u; sce_jiter_element(&it, &item); ++i) {
            sce_saved_path_index(element_what, sizeof(element_what), what, i);
{% if field.saved_kind == "list" %}
            if (!{{ get_scalar(false, field.saved_type, none, "item", "element_what", "value.data[i]") }}) {
                return false;
            }
{% else %}
            if (!{{ field.saved_type }}_saved_read(item, element_what, at, &value.data[i], err)) {
                return false;
            }
{% endif %}
        }
        value.len = count;
    }
{% elif field.saved_kind == "optional" %}
    if (!sce_jv_is_null(v)) {
        value.present = true;
        if (!{{ get_scalar(field.saved_elem == "enum", field.saved_type, field.bound, "v", "what", "value.value") }}) {
            return false;
        }
    }
{% endif %}
    if (out != NULL) {
        *out = value;
    }
    return true;
}

{% endfor %}
/* Every variable of `s`, read as the value of its type, or the refusal that names the first that
   is not one. `policy` is where they are kept, NULL to judge them and keep none. */
SCE_SM_FN static bool {{ _t }}_saved_read_variables(const sce_saved_session_t *s, const unsigned *record_at,
                                                  {{ _t }}_policy_t *policy, sce_saved_error_t *err) {
    sce_jv_t v;
    (void)s;
    (void)err;
    (void)record_at;
    (void)policy;
    (void)v;
{% for field in static_fields %}
    if (!sce_jv_get(s->variables, "{{ field.id | escape_c }}", &v)) {
        return sce_saved_refuse(err, "the saved state has no variable '{{ field.id | escape_c }}'");
    }
    if (!{{ _t }}_saved_read_{{ field.name }}(v, "{{ field.id | escape_c }}", {{ record_at_of(field) }},
                                              policy != NULL ? &policy->{{ field.name }} : NULL, err)) {
        return false;
    }
{% endfor %}
    return true;
}

