    "{{ static_saved_shape.first }}",
    "{{ static_saved_shape.revised }}",
    "{{ static_saved_shape.format2_first }}",
    "{{ static_saved_shape.format2_revised }}",
    {% if n_records %}{{ _t }}_saved_records{% else %}NULL{% endif %}, {{ n_records }}u,
