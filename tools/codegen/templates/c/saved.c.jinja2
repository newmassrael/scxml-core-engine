/* What history `index` recorded, as the states of its snapshot; false when it has recorded
   nothing. */
SCE_SM_FN static bool {{ _t }}_saved_history_get(const {{ _t }}_t *sm, size_t index, uint32_t *bits) {
    switch (index) {
{% for hid, info in model.history_states | dictsort(case_sensitive=true) %}
    case {{ loop.index0 }}u:
        *bits = sm->policy.history_{{ hid }}_snapshot;
        return sm->policy.history_{{ hid }}_recorded && sm->policy.history_{{ hid }}_snapshot != 0u;
{% endfor %}
    default:
        return false;
    }
}

SCE_SM_FN static void {{ _t }}_saved_history_set({{ _t }}_t *sm, size_t index, uint32_t bits) {
    switch (index) {
{% for hid, info in model.history_states | dictsort(case_sensitive=true) %}
    case {{ loop.index0 }}u:
        sm->policy.history_{{ hid }}_snapshot = bits;
        sm->policy.history_{{ hid }}_recorded = true;
        break;
{% endfor %}
    default:
        break;
    }
}

/* §scxml-3.11, for a subtree: whether `state`, in the set `among`, holds the number of children a
   configuration gives it. */
SCE_SM_FN static {{ _t }}_configuration_rejection_t {{ _t }}_saved_child_arity(uint32_t among, {{ _t }}_state_t state) {
    const uint32_t children = k_child_states[state];
    uint32_t held = among & children;
    size_t count = 0u;
    while (held != 0u) {
        held &= held - 1u;
        ++count;
    }
    if (state_is_parallel(state)) {
        if ((children & ~among) != 0u) {
            return {{ _u }}_CONFIG_PARALLEL_REGION_MISSING;
        }
        size_t regions = 0u;
        for (uint32_t rest = children; rest != 0u; rest &= rest - 1u) {
            ++regions;
        }
        return count != regions ? {{ _u }}_CONFIG_PARALLEL_CHILD_COUNT : {{ _u }}_CONFIG_NONE;
    }
    if (state_is_compound(state)) {
        return count != 1u ? {{ _u }}_CONFIG_COMPOUND_CHILD_COUNT : {{ _u }}_CONFIG_NONE;
    }
    return count != 0u ? {{ _u }}_CONFIG_ATOMIC_HAS_CHILDREN : {{ _u }}_CONFIG_NONE;
}

/* The history `history` of the parent `parent`, deep or shallow, as a saved state records it:
   its active children for a shallow one, the active atomic states below it for a deep one
   (§scxml-3.10). What it recorded is part of a configuration, so a value read back is held to
   that, and the restored machine can only be taken through the history to a configuration its
   document could have been in. Refused with the words of the other backends, naming the state. */
SCE_SM_FN static bool {{ _t }}_saved_history_read(sce_jv_t names, const char *history, {{ _t }}_state_t parent, bool deep,
                                                uint32_t *bits, sce_saved_error_t *err) {
    sce_jiter_t it;
    sce_jv_t item;
    uint32_t held = 0u;
    uint32_t subtree = state_bit(parent);
    char name[SCE_SAVED_QUOTE_LEN];
    size_t count = 0u;
    (void)sce_jv_iter(names, &it);
    while (sce_jiter_element(&it, &item)) {
        {{ _t }}_state_t state;
        (void)sce_jv_string(item, name, sizeof(name), NULL);
        if (!{{ _t }}_state_from_name(name, &state)) {
            return sce_saved_refuse(err, "the history '%s' records '%s', which the document does not name", history, name);
        }
        if ((held & state_bit(state)) != 0u) {
            return sce_saved_refuse(err, "the history '%s' records '%s' twice", history, name);
        }
        held |= state_bit(state);
        ++count;
    }
    if (count == 0u) {
        return sce_saved_refuse(err, "the history '%s' records no state, and a history records at least one", history);
    }
    for (uint32_t k = 0u; k < (uint32_t){{ _u }}_STATE_COUNT; ++k) {
        /* The recorded states, and every state between each of them and `parent`. */
        {{ _t }}_state_t state = ({{ _t }}_state_t)k;
        uint32_t chain = 0u;
        bool has_parent = true;
        if ((held & state_bit(state)) == 0u) {
            continue;
        }
        while (has_parent && state != parent) {
            chain |= state_bit(state);
            state = state_get_parent(state, &has_parent);
        }
        if (!has_parent || chain == 0u) {
            return sce_saved_refuse(err, "the history '%s' records '%s', which is not below its parent '%s'", history,
                                    {{ _t }}_state_name(({{ _t }}_state_t)k), {{ _t }}_state_name(parent));
        }
        subtree |= chain;
    }
    if (deep) {
        for (uint32_t k = 0u; k < (uint32_t){{ _u }}_STATE_COUNT; ++k) {
            if ((held & state_bit(({{ _t }}_state_t)k)) != 0u && k_child_states[k] != 0u) {
                return sce_saved_refuse(err,
                                        "the history '%s' records '%s', which has children (a deep history records "
                                        "atomic states)",
                                        history, {{ _t }}_state_name(({{ _t }}_state_t)k));
            }
        }
        for (uint32_t k = 0u; k < (uint32_t){{ _u }}_STATE_COUNT; ++k) {
            if ((subtree & state_bit(({{ _t }}_state_t)k)) != 0u) {
                const {{ _t }}_configuration_rejection_t verdict = {{ _t }}_saved_child_arity(subtree, ({{ _t }}_state_t)k);
                if (verdict != {{ _u }}_CONFIG_NONE) {
                    return sce_saved_refuse(err, "the history '%s' records states of no configuration: %s", history,
                                            {{ _t }}_configuration_rejection_text(verdict));
                }
            }
        }
    } else {
        for (uint32_t k = 0u; k < (uint32_t){{ _u }}_STATE_COUNT; ++k) {
            bool has_parent = false;
            if ((held & state_bit(({{ _t }}_state_t)k)) != 0u &&
                (state_get_parent(({{ _t }}_state_t)k, &has_parent) != parent || !has_parent)) {
                return sce_saved_refuse(err,
                                        "the history '%s' records '%s', which is not a child of '%s' (a shallow history "
                                        "records the children)",
                                        history, {{ _t }}_state_name(({{ _t }}_state_t)k), {{ _t }}_state_name(parent));
            }
        }
        {
            const {{ _t }}_configuration_rejection_t verdict = {{ _t }}_saved_child_arity(subtree, parent);
            if (verdict != {{ _u }}_CONFIG_NONE) {
                return sce_saved_refuse(err, "the history '%s' records states of no configuration: %s", history,
                                        {{ _t }}_configuration_rejection_text(verdict));
            }
        }
    }
    *bits = held;
    return true;
}

/* What `s` records for each `<history>` of the document, as the states of this document, or the
   refusal that says which value is not one. A history the document does not declare is refused.
   `bits[i]` and `recorded[i]` are history `i`'s. */
SCE_SM_FN static bool {{ _t }}_saved_histories_read(const sce_saved_session_t *s, uint32_t *bits, bool *recorded,
                                                  sce_saved_error_t *err) {
    sce_jiter_t it;
    sce_jv_t key;
    sce_jv_t names;
    for (size_t i = 0u; i < {{ n_histories }}u; ++i) {
        bits[i] = 0u;
        recorded[i] = false;
    }
    (void)sce_jv_iter(s->history, &it);
    while (sce_jiter_member(&it, &key, &names)) {
        size_t index = 0u;
        char id[SCE_SAVED_QUOTE_LEN];
        bool found = false;
        (void)sce_jv_string(key, id, sizeof(id), NULL);
        for (size_t i = 0u; i < {{ n_histories }}u && !found; ++i) {
            if (sce_jv_string_is(key, {{ _t }}_saved_histories[i].id)) {
                index = i;
                found = true;
            }
        }
        if (!found) {
            return sce_saved_refuse(err,
                                    "the saved state records the history '%s', which the document does not declare", id);
        }
        if (!{{ _t }}_saved_history_read(names, {{ _t }}_saved_histories[index].id, {{ _t }}_saved_histories[index].parent,
                                         {{ _t }}_saved_histories[index].deep, &bits[index], err)) {
            return false;
        }
        recorded[index] = true;
    }
    return true;
}

