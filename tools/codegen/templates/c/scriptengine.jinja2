{# RFC §synth-5-J-1 — C11 script-engine helpers (lua_State* direct, no abstraction).

   The C++/Rust/Go/Kotlin backends route script execution through an
   IScriptEngine interface (ScriptEngineProvider in C++/Rust/Go,
   ScriptEngineHost in Kotlin) so that a fixture-level test harness can
   swap a mock engine. The C11 backend is AOT-only and bare-metal-bound:
   the embedded target runs Lua 5.4 directly with no allocator hook, no
   futures, no virtual dispatch. So this template emits raw lua C API
   calls inline, and the abstraction layer that the other backends carry
   never appears in the generated `_sm.c`.

   Macros exported:
     - lua_init_engine()         → create lua_State, openlibs, init datamodel
     - lua_destroy_engine()      → close lua_State (idempotent, NULL-safe)
     - lua_assign(loc, expr)     → execute "loc = (transpiled_expr)" chunk
     - lua_eval_guard(cond, var) → set `var` (bool) to truthiness of cond
     - lua_foreach_no_body(...)  → W3C 4.6 foreach with empty body (var decl
                                   + iteration item/index without C body)
     - lua_foreach_body_prologue / _iter / _epilogue → W3C 4.6 foreach with
                                   a C-side body. Prologue caches the array
                                   on the lua global named by `slot` and
                                   exposes its length on C local `_sce_n`;
                                   _iter sets item/index for one iteration;
                                   _epilogue clears the cache. The caller
                                   names one slot per nesting depth, so a
                                   nested foreach keeps its own array.

   Every macro takes the Lua state pointer as `sm->L`; the calling
   template owns the surrounding block scope and any per-block error
   handling. Decision: jinja2-inline only —
   no helper class, no shared .c file. #}

{# §scxml-5.10: store the value at the top of the stack as the data model
   variable `name`, a name the document chose, and pop it. Through
   `set_document_global` (a protected `lua_setglobal`, emitted by
   state_machine.c.jinja2), because the shared globals refuse a write of a
   system variable's name, and a refusal raised outside a protected call ends
   the process: a `<data id="_event">` is a write that fails, which the clause
   answers with error.execution. #}
{% macro lua_set_document_global_top(name) %}
            if (!set_document_global(sm->L, "{{ name | escape_c }}")) {
                {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                    sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                    {{ reason("data_unstored", name) }});
            }
{% endmacro %}

{# W3C SCXML 5.3: give the data model variable `name` the value of the lowered
   expression `lua_value`. The value is evaluated as `return (<value>)` and
   stored as a global keyed by the name as a string: a `<data id>`
   is an XML name, and `screen-rules = (4)` — the chunk this used to run — is
   a subtraction to Lua, so a legal declaration was never initialised. The
   other Lua backends key the variable the same way.

   `fallback`, when given, is the literal an inline `<data>` content
   (W3C SCXML 5.3.2) that does not evaluate becomes (W3C SCXML B.2); without it the failure is the
   expression's, and raises error.execution.

   The store is `lua_set_document_global_top`'s, as for every name a document
   chooses. #}
{% macro lua_set_data_global(name, lua_value, fallback=none) %}
        if ((luaL_loadstring(sm->L, "return ({{ lua_value | escape_c }})") || lua_pcall(sm->L, 0, 1, 0)) != 0) {
            lua_pop(sm->L, 1);
{% if fallback is not none %}
            lua_pushliteral(sm->L, "{{ fallback | escape_c }}");
{{ lua_set_document_global_top(name) }}
{% else %}
            {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                {{ reason("data_expr_failed", name) }});
{% endif %}
        } else {
{{ lua_set_document_global_top(name) }}
        }
{% endmacro %}

{% macro lua_init_engine() %}
    /* W3C SCXML 5.10: Open Lua state and register standard libraries. */
    sm->L = luaL_newstate();
    if (sm->L != NULL) {
        luaL_openlibs(sm->L);
        {% if model.needs_dom_helper %}
        /* W3C SCXML B.2: install metatables for the host-side XML DOM
           helper so subsequent `<data>` / `<send><content>` XML payloads
           can construct DOM userdata via `sce_lua_dom_push_object`.
           Mirrors cpp `LuaEngine::initializeSession` registerMetatable
           hook (sce/src/scripting/LuaEngine.cpp:385). The helper is
           defined in backends/c/runtime/scripting/lua_dom_binding.c (the
           `sce_c_scripting` tier), which a machine links exactly when it
           states the `dom` requirement, as this one does. */
        sce_lua_dom_register_metatable(sm->L);
        {% endif %}
        /* W3C SCXML B.2: the ECMAScript operators and library Lua does not
           share — `+` (concatenation or addition depending on the operands),
           `==` (which coerces where Lua's does not), the bitwise family
           (which acts on ToInt32 of its operands), and the vocabulary the
           emitted code calls by name: `_scxml_truthy`, `_typeof`,
           `_isArray`, `_indexOf`, `_concat`, `parseInt`, `parseFloat`.
           Emitted from the one shared source,
           sce/include/scripting/ecma_semantics.lua, that the C++, Rust, Go,
           Kotlin and Python engines load at startup; C11 cannot read a file
           at runtime (RFC §synth-5-J-1 forbids a runtime fopen in
           sce-c-runtime), so the same bytes travel in the generated source.

           This template used to carry its own Lua definitions of those seven
           above this line, as did four other engines in four other
           languages. Measured 2026-08-16 against
           tests/ecmascript/ecma262_semantics.json, once every Lua backend
           had a reader: the six copies disagreed on Arrays, on `indexOf`'s
           second argument, and on what `parseInt` answers for "42abc". They
           are in the shared file now, and this backend gets them the same
           way it gets `==`.

           Several calls rather than one because ISO C99 guarantees a string
           literal of only 4095 characters and `-pedantic -Werror` holds the
           C11 test build to it. Each call carries a complete Lua chunk. */
{{ ecma_semantics_lua_c }}
        /* W3C SCXML B.2: `JSON.stringify` / `JSON.parse`, from the same
           shared source the C++, Rust, Go and Kotlin Lua engines load —
           sce/include/scripting/json_builtins.lua. The clause puts `JSON` in
           an ECMAScript datamodel, and this session was the one that did not
           have it, so a `<script>` calling `JSON.stringify` reached a nil
           here while reaching the builtin everywhere else.

           It is also what the structured `<data>` readers below ask for:
           they hand the value over as the text this serialiser produces
           rather than walking the table themselves, so that six backends
           share one encoder instead of six that drift. */
{{ json_builtins_lua_c }}
        /* W3C SCXML 5.10: `_sessionid` is a read-only system variable bound
           on startup to the system-generated id for the CURRENT SESSION.
           The value comes from `sm->session_id`, issued once in `_init`
           from a per-machine monotonic counter; it is not spelled here,
           because a codegen-time literal names the document and every
           instance of it would then read the same id.

           This comment used to restate the requirement as "bound and
           unchanging", which is true of the clause and drops the two parts
           that constrain the value — that it identifies the session, and
           that it is an NMTOKEN — and then satisfied only what was left.

           §scxml-5.10, §scxml-B-2-8: "any attempt to change the value of a
           system variable" fails, whichever way it is made. The assign guard
           in `state_machine.c.jinja2`'s emit_action refuses an `<assign>` to
           the whole variable before any Lua runs, and the Lua state refuses
           everything else — `_sessionid = 'x'` in a `<script>`, a write into
           `_event` or an `_ioprocessors` entry — because each of the four is
           bound through `bind_system_variable`, which hands it to the shared
           `_scxml_bind_system`. The shared semantics above define that
           function, so they are loaded before this first bind. These were
           plain globals set by `luaL_dostring` until 2026-11-08, and a
           document's `<script>` could rebind any of them.

           A bind that fails is the shared Lua missing, not a document's
           error, and it is said out loud (`bind_system_variable` writes the
           reason) and raised as error.execution, as a failing script is. */
        lua_pushstring(sm->L, sm->session_id);
        if (!bind_system_variable(sm->L, "_sessionid")) {
            {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                {{ reason("system_variable_unbound", "_sessionid") }});
        }
        /* W3C SCXML 5.10: `_name` is the SCXML element's `name` attribute
           (cpp `LuaEngine.cpp` calls this `sessionName`). Falls back to
           the document identity when the SCXML omits the attribute, which
           is W3C 5.10 §3.2.1's "the processor MUST generate a name".

           Pushed as a value, so the name crosses one literal boundary, the
           C string's, and `escape_c` is the whole of its escaping. It used to
           be spliced into a Lua chunk as well, which needed `escape_lua`
           first and a double-quoted Lua string: with single quotes, a name of
           `it's` produced `_name = 'it's'`. */
        lua_pushstring(sm->L, "{{ model.scxml_name | default('') | w3c_session_name(model.name) | escape_c }}");
        if (!bind_system_variable(sm->L, "_name")) {
            {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                {{ reason("system_variable_unbound", "_name") }});
        }
        /* W3C SCXML C.1.1 / C.2.3: `_ioprocessors` holds one entry per
           processor the deployment supports, each with a `location` field
           naming the address that reaches this session through it. Entry
           names and locations follow cpp `IOProcessorHelper::build`
           (`sce/include/common/IOProcessorHelper.h`), so a machine reads the
           same table whichever backend runs it.

           The SCXML processor is filed under both C.1.1's entry name and the
           `scxml` alias documents index with. Its location is `sm->scxml_location`,
           the address derived from this session's id in `_init` (or the id a
           restore carries on under) by `sce_scxml_location` — the one encoder
           that also spells the origin of every event this session sends
           (docs/adr/0090), so the address the session publishes and the
           address its events carry cannot differ.

           W3C SCXML C.2.3: the BasicHTTP entry lands only once the deployment
           has declared an inbound endpoint. Support for that processor is
           optional and per-deployment, so a machine with no listener publishes
           no entry rather than an address nothing answers on.

           The table is built through the Lua C API, every location pushed as a
           value — the BasicHTTP URI arrives from outside the generated code,
           and spliced into a chunk a quote in it would end the string literal
           and be read as Lua — and bound whole, once: §scxml-B-2-8 makes each
           entry and its `location` part of the read-only variable, so nothing
           can be added to it after the bind, this machine included. */
        {
            static const char *const _scxml_entry[2] = {"http://www.w3.org/TR/scxml/#SCXMLEventProcessor", "scxml"};
            static const char *const _http_entry[2] = {"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor",
                                                       "basichttp"};
            lua_newtable(sm->L);
            for (int _proc = 0; _proc < 2; _proc++) {
                lua_newtable(sm->L);
                lua_pushstring(sm->L, sm->scxml_location);
                lua_setfield(sm->L, -2, "location");
                lua_setfield(sm->L, -2, _scxml_entry[_proc]);
                if (sm->basic_http_access_uri[0] != '\0') {
                    lua_newtable(sm->L);
                    lua_pushstring(sm->L, sm->basic_http_access_uri);
                    lua_setfield(sm->L, -2, "location");
                    lua_setfield(sm->L, -2, _http_entry[_proc]);
                }
            }
            if (!bind_system_variable(sm->L, "_ioprocessors")) {
                {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                    sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                    {{ reason("system_variable_unbound", "_ioprocessors") }});
            }
        }
        /* W3C SCXML 5.5 + 3.7: the final-state entry emit evaluates
           `<donedata>` into `_sce_donedata` (string / number / table). A
           compound final serialises it onto its own done.state event's
           `data[]` and clears it; a top-level final leaves it for the
           parent, which asks for it through this machine's
           `_done_data_wire` onto done.invoke. No dequeue reads it: an
           event's data rides on the event (`set_current_event`). */
        (void)luaL_dostring(sm->L, "_sce_donedata = nil");
        /* W3C SCXML 5.5 + 6.3.1 + B-2-9 cross-SM donedata carry: serialise
           the `_sce_donedata` stash (populated by the child's
           `<final><donedata>` entry emit) into the wire string the parent's
           `process_event_queues` external dequeue reads back.

           That wire is JSON, the same one cpp ships on
           `EventWithMetadata::data`. It used to be a LUA-SOURCE literal,
           on the reasoning that C11 is AOT-only with Lua 5.4 as its sole
           script engine so source was "the round-trip-free equivalent".
           The reasoning held for the sender and not for the field: the
           parent read it with `load`, and the same `data[]` field is what
           an EMBEDDER writes — `examples/ai_loop` every turn, a downstream
           MCU consumer from the wire — so the receiving side was running
           text that need not have come from this engine at all. §B-2-8-1
           gives that field three readings and none of them is Lua.

           Encoding contract:
             - nil    → '' (empty; receiver skips the override)
             - a wire text the build finished (`lua_stash_donedata_wire`:
                        XML as written, or a literal's JSON), marked by the
                        `_sce_wire_text` metatable → that text unchanged, so
                        XML reaches the receiver as the document it is
             - other  → `JSON.stringify`, whose object keys are sorted, so
                        equal content produces byte-equal output
                        (committed-tree-sweep §synth-6.2.6 contract).
           Every SM with `needs_script_engine` initialises this helper
           because `lua_init_engine` runs in each; `lua_donedata_wire_into`
           calls it on the machine's own L, for a compound final's
           done.state and for the `_done_data_wire` a parent asks, whose
           string lands on the `done.invoke.<id>` event's `data[]`. */
        (void)luaL_dostring(sm->L,
            "_sce_wire_text = {}\n"
            "function _sce_donedata_to_wire(v)\n"
            "  if v == nil then return '' end\n"
            "  if getmetatable(v) == _sce_wire_text then return v[1] end\n"
            "  return JSON.stringify(v)\n"
            "end");
        {% if model.needs_donedata_helper or model.needs_namelist_helper %}
        /* W3C SCXML 5.7 + C.1 (test343, test553): donedata `<param>` and
           `<send namelist>` evaluation both need to detect ECMAScript
           ReferenceError semantics — referencing an undeclared identifier
           must raise error.execution per W3C 5.7 / 6.2. Lua's native
           semantics return `nil` for undeclared globals, so we register
           a `_scxml_declared` table mirroring cpp `LuaSessionContext::declaredVars`
           (see `LuaEngine.cpp:99-118`, `isUndeclaredIdentifier`). Both the
           donedata param evaluator and the namelist evaluator inspect
           this set together with `_G[base]` — same two-source check
           as cpp, whose `lua_getglobal` reads through `_G`'s metatable as
           `_G[base]` does, and so finds the system variables
           (§scxml-5.10), which `_scxml_bind_system` holds outside `_G`
           itself; a `rawget` would call `_event` undeclared. The set spans top-level <data> and every state-local
           <datamodel> entry so binding mode (early / late) is irrelevant
           to membership; the lua values are placeholder booleans because
           only the keys are read. Emitted only for fixtures that actually
           use donedata or namelist (analyzer-pinned helper flags), so
           non-using fixtures keep their lua init footprint unchanged. */
        (void)luaL_dostring(sm->L,
            "_scxml_declared = {"
            {%- set ns = namespace(first=true) -%}
            {%- for var in model.variables -%}
            {%- if not ns.first %}", "{% endif -%}
            "[\"{{ var.id | escape_c }}\"] = true"
            {%- set ns.first = false -%}
            {%- endfor -%}
            {%- for state_id, state in model.states | dictsort -%}
            {%- if state.datamodel -%}
            {%- for var in state.datamodel -%}
            {%- if not ns.first %}", "{% endif -%}
            "[\"{{ var.id | escape_c }}\"] = true"
            {%- set ns.first = false -%}
            {%- endfor -%}
            {%- endif -%}
            {%- endfor -%}
            "}");
        {% endif %}
        {# W3C SCXML 5.2: the document's top-level <datamodel>, one data object
           per <data> it wraps, each a global of this session's engine. #}
        {% for var in model.variables %}
        {% if var.expr %}
        /* W3C SCXML 5.3: <data id="{{ var.id }}" expr="{{ var.expr }}">.
           On expression failure the data element is left undefined (lua nil)
           and error.execution is queued so the SM can react. memset on the
           SM struct in `_init` zero-initialised both queues before this
           loop runs, so direct enqueue is safe at this point. */
{{ lua_set_data_global(var.id, var.expr | to_lua_expr) }}
        {% elif var.content %}
        {% if (var.content | trim) is startingwith('<') %}
        /* W3C SCXML B.2: inline `<data>` content begins with `<` →
           construct an XML DOM object via the host-side helper. cpp
           `DataModelInitHelper::initializeVariable` isXML branch
           (sce/src/common/DataModelInitHelper.cpp:103-118) 1:1 mirror —
           cpp's `setVariableAsDOM` lowers to `LuaDOMBinding::pushDOMObject
           + lua_setglobal`, which is what `sce_lua_dom_push_object`
           and the protected store below emit. */
        sce_lua_dom_push_object_or_nil(sm->L, {{ var.content | c_text_expr }});
{{ lua_set_document_global_top(var.id) }}
        {% else %}
        /* W3C SCXML 5.3/B.2: <data id="{{ var.id }}"> inline non-XML
           content. cpp `DataModelInitHelper::initializeVariable`
           (sce/src/common/DataModelInitHelper.cpp:80-156) dispatch: try
           eval as expression; on Lua syntax/runtime failure, fall back
           to a whitespace-normalized string (cpp
           `DataModelInitHelper.cpp:142-155`, normalizeWhitespace +
           setVariable). */
{{ lua_set_data_global(var.id, var.content | to_lua_data_content, var.content | normalize_ws) }}
        {% endif %}
        {% elif var.src %}
        /* W3C SCXML 5.3.1: <data id="{{ var.id }}" src="{{ var.src }}">.
           C11 codegen-time file read (RFC §synth-5-J-1 R3 zero-deps: no runtime
           fopen in backends/c/runtime). Mirrors cpp
           `DataModelInitHelper::initializeVariableFromSrc` (sce/src/common/
           DataModelInitHelper.cpp:159-181), which loads the file and
           dispatches to `initializeVariable` — the C11 codegen reads the
           file via the `read_data_src` filter and threads the content
           through the same isXML / eval / whitespace-fallback dispatch as
           inline content. cmake's c11 fixture path copies the `.txt`
           sidecar alongside the SCXML so the codegen-time read resolves
           under ${SCE_C_GENERATED_DIR}. */
        {%- set _src_content = var.src | read_data_src(model.scxml_base_path) %}
        {% if (_src_content | trim) is startingwith('<') %}
        /* W3C SCXML B.2: src= file's first non-WS char is `<` → DOM. */
        sce_lua_dom_push_object_or_nil(sm->L, {{ _src_content | c_text_expr }});
{{ lua_set_document_global_top(var.id) }}
        {% else %}
{{ lua_set_data_global(var.id, _src_content | to_lua_data_content, _src_content | normalize_ws) }}
        {% endif %}
        {% endif %}
        {% endfor %}
        {% if model.binding == 'early' %}
        {# W3C SCXML 5.3 early binding (default per parser.rs:378 unwrap_or("early")):
           state-local <datamodel> variables initialise at startup so that any
           state can read them before its own onentry runs. Mirrors the cpp
           scriptengine_helpers.jinja2 early-binding loop (model.states |
           dictsort + state.datamodel guard). The corresponding late-binding
           emit is in `state_machine.c.jinja2::execute_entry_actions` so that
           the per-state init runs on entry before the onentry blocks
           (cpp `entry_exit_actions.jinja2:79-90` mirror).
           Init-failure error.execution raise mirrors cpp
           `DataModelInitHelper::initializeVariableFromExpr` errorCallback
           (datamodel_macros.jinja2:22-24 lambda → engine.raise). The
           top-level loop above and this state-local loop both lift to the
           rc-checked shape (spec-mirror parity carve-out per
           feedback_spec_mirror_parity.md — reference backend's branch is
           the contract). No current corpus fixture has a state-local <data>
           with an illegal expr (test277 only forces top-level), but cpp
           emits the same lambda raise for both top-level and state-local
           loops, so silent-drop here would be coincidence-match drift. #}
        {% for state_id, state in model.states | dictsort %}
        {% if state.datamodel %}
        {% for var in state.datamodel %}
        {% if var.expr %}
        /* W3C SCXML 5.3 (early): state '{{ state_id }}' <data id="{{ var.id }}" expr="{{ var.expr }}"> */
{{ lua_set_data_global(var.id, var.expr | to_lua_expr) }}
        {% elif var.content %}
        {% if (var.content | trim) is startingwith('<') %}
        /* W3C SCXML B.2 (early): state '{{ state_id }}' <data id="{{ var.id }}"> inline XML content → DOM. */
        sce_lua_dom_push_object_or_nil(sm->L, {{ var.content | c_text_expr }});
{{ lua_set_document_global_top(var.id) }}
        {% else %}
        /* W3C SCXML 5.3/B.2 (early): state '{{ state_id }}' <data id="{{ var.id }}"> inline non-XML content. eval+whitespace-fallback per top-level branch above. */
{{ lua_set_data_global(var.id, var.content | to_lua_data_content, var.content | normalize_ws) }}
        {% endif %}
        {% elif var.src %}
        /* W3C SCXML 5.3.1 + 5.3.3 (early): state '{{ state_id }}' <data id="{{ var.id }}" src="{{ var.src }}"> codegen-time file read. */
        {%- set _src_content = var.src | read_data_src(model.scxml_base_path) %}
        {% if (_src_content | trim) is startingwith('<') %}
        sce_lua_dom_push_object_or_nil(sm->L, {{ _src_content | c_text_expr }});
{{ lua_set_document_global_top(var.id) }}
        {% else %}
{{ lua_set_data_global(var.id, _src_content | to_lua_data_content, _src_content | normalize_ws) }}
        {% endif %}
        {% endif %}
        {% endfor %}
        {% endif %}
        {% endfor %}
        {% endif %}
        {% if model.global_scripts %}
        /* W3C SCXML 5.8: top-level <script> bodies execute at document
           load time, after datamodel <data> initialisation and before any
           state machine entry. Mirrors cpp `scriptengine_helpers.jinja2`
           lines 165-179 (model.global_scripts loop): each script's content
           routes through `to_lua_script` (compound assignment / increment /
           array-literal / function-syntax transforms — distinct from the
           expression-only `to_lua_expr` used for <data expr> / <assign expr>
           because a script body can be a multi-statement chunk) and lands
           in a luaL_dostring chunk. Chunk failure (load-time syntax error
           or runtime trap) raises error.execution per W3C 5.10, mirroring
           the cpp `engine.raise(typename Engine::EventWithMetadata(
           Event::Error_execution, errorMsg))` shape. The
           document-rejection path (parse_global_scripts setting
           `model.document_rejected = true` on bad src) short-circuits at
           the codegen entry boundary in `sce_codegen.rs:690-706` so this
           loop only runs for fixtures whose scripts parsed successfully —
           src loading failure never reaches the template. */
        {% for script in model.global_scripts %}
        if (luaL_dostring(sm->L,
            {{ script.content | to_lua_script | c_text_expr }}) != 0) {
            lua_pop(sm->L, 1);
            {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                {{ reason("top_script_failed") }});
        }
        {% endfor %}
        {% endif %}
    }
{% endmacro %}

{# W3C SCXML 5.3.3 late binding: state-local <data> variables initialise on
   the *entry* of the owning state, before any onentry markup runs. Called
   from `state_machine.c.jinja2::execute_entry_actions` for each state with
   `state.datamodel and model.binding == 'late'`. Mirrors cpp
   `datamodel_macros.jinja2::initialize_state_datamodel` invoked from
   `entry_exit_actions.jinja2:79-90`.

   First entry only: §scxml-D-enterStates binds a state's <data> when
   `binding == "late" and s.isFirstEntry`. The caller guards this block with
   the machine's `late_bound` bitmap, so re-entering a state does not
   re-evaluate its init expressions — the rule the other six channels keep in
   their runtime (measured 2026-09-26: C11, C++ AOT, Rust and Kotlin used to
   re-bind on every entry, and Go never bound at all).

   Init-failure semantics: rc-checked, mirrors cpp
   `DataModelInitHelper::initializeVariableFromExpr` errorCallback
   (datamodel_macros.jinja2:22-24 lambda → engine.raise(Error_execution)).
   Spec-mirror parity carve-out per feedback_spec_mirror_parity.md — the
   reference backend's branch IS the contract, missing it would be silent
   semantic drift / coincidence-match. No current corpus fixture has a
   state-local <data> with an illegal expr that drives binding="late" (only
   test307 has the shape and is a manual test), but cpp emits the same
   lambda raise from both early and late call sites, so the C11 macro
   matches that 1:1 regardless of differential corpus coverage. #}
{% macro lua_init_state_datamodel(state, state_id) %}
    {% for var in state.datamodel %}
    {% if var.expr %}
    /* W3C SCXML 5.3 (late): state '{{ state_id }}' <data id="{{ var.id }}" expr="{{ var.expr }}"> */
{{ lua_set_data_global(var.id, var.expr | to_lua_expr) }}
    {% elif var.content %}
    {% if (var.content | trim) is startingwith('<') %}
    /* W3C SCXML B.2 (late): state '{{ state_id }}' <data id="{{ var.id }}"> inline XML content → DOM. */
    sce_lua_dom_push_object_or_nil(sm->L, {{ var.content | c_text_expr }});
{{ lua_set_document_global_top(var.id) }}
    {% else %}
    /* W3C SCXML 5.3/B.2 (late): state '{{ state_id }}' <data id="{{ var.id }}"> inline non-XML content. eval+whitespace-fallback per top-level branch in the early-binding macro above. */
{{ lua_set_data_global(var.id, var.content | to_lua_data_content, var.content | normalize_ws) }}
    {% endif %}
    {% elif var.src %}
    /* W3C SCXML 5.3.1 + 5.3.3 (late): state '{{ state_id }}' <data id="{{ var.id }}" src="{{ var.src }}"> codegen-time file read. */
    {%- set _src_content = var.src | read_data_src(model.scxml_base_path) %}
    {% if (_src_content | trim) is startingwith('<') %}
    sce_lua_dom_push_object_or_nil(sm->L, {{ _src_content | c_text_expr }});
{{ lua_set_document_global_top(var.id) }}
    {% else %}
{{ lua_set_data_global(var.id, _src_content | to_lua_data_content, _src_content | normalize_ws) }}
    {% endif %}
    {% endif %}
    {% endfor %}
{% endmacro %}

{% macro lua_destroy_engine() %}
    if (sm->L != NULL) {
        lua_close(sm->L);
        sm->L = NULL;
    }
{% endmacro %}

{# Emit a bounded block that assigns `loc = (expr)` via luaL_dostring.
   On chunk failure (illegal location, illegal expression, type error)
   the macro pops the lua error message off the stack and enqueues an
   `error.execution` event onto the SM's internal queue — W3C SCXML 5.4
   mandates that an unsuccessful <assign> raise this event so the
   surrounding state's `transition event="error.execution"` can fire.
   The raise emit shape is identical to the <raise> action emit in
   `state_machine.c.jinja2::emit_action`; `_err_evt` is declared inside
   the inner if-block scope so concurrent <assign>s in the same onentry
   block do not collide. The EVENT_ERROR_EXECUTION enum value is always
   present whenever this path runs — `analyzer.rs::apply_script_engine_implications`
   injects "error.execution" into model.events for every fixture that
   sets needs_script_engine, and any fixture using <assign> does. The
   guard/eval failure on cond expressions remains silent-drop until a
   negative-cond fixture forces it. #}
{# W3C SCXML B.2: the target is authored ECMAScript, lowered by the same
   frontend the reads go through — `arr[0]` names one cell whichever side
   of the `=` it is written on. #}
{# W3C SCXML 4.9: the error ends the block — every block this backend emits
   is its own C function, so `return` ends it, and inside a <foreach> body
   (W3C SCXML 4.6) ends the loop as well. #}
{% macro lua_assign(loc, expr) %}
    if (luaL_dostring(sm->L,
        "{{ loc | to_lua_location | escape_c }} = ({{ expr | to_lua_expr | escape_c }})") != 0) {
        lua_pop(sm->L, 1);
        {{ csym_prefix }}{{ model.name }}_raise_platform_error(
            sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
            {{ reason("assign_failed", loc) }});
        return;
    }
{% endmacro %}

{# Emit a bounded block that evaluates `cond` and stores its truthiness in
   `result_var` (must be `bool` and already declared by the caller). The
   chunk returns the value, lua_toboolean lifts it, lua_pop drops the
   stack slot.

   W3C SCXML B.2.3: the cond's effective boolean value is ECMAScript's
   ToBoolean, not Lua's truthiness, which counts `0` and `""` as true.
   `to_lua_guard` lowers the cond so that every operand that is not already a
   boolean goes through `_scxml_truthy` (the shared
   sce/include/scripting/ecma_semantics.lua), so the value the chunk returns
   is already that boolean and lua_toboolean only lifts it.

   W3C SCXML 5.9 (test344): "If a conditional expression cannot be
   evaluated as a boolean value or its evaluation causes an error, the
   SCXML processor MUST place the error 'error.execution' in the
   internal event queue." On luaL_dostring failure (syntax error, runtime
   trap, etc.) we pop the error message, raise error.execution, and leave
   `result_var` at its initial false — mirrors cpp `LuaEngine::evaluateBoolean`
   chunk-failure path (LuaEngine.cpp:~880, returns false + sets error
   so the surrounding `process_transition` can route the error to a
   handler). The success path is unchanged from the prior silent-drop
   shape so cond expressions that legitimately evaluate to false (e.g.
   test309's `cond="return"` racing with an unconditional fall-through
   transition) keep producing the same observable: result_var stays
   false, the next transition fires eventlessly before error.execution
   is dequeued, and pass is reached. #}
{# `failed_var`, when given, names a bool set to true on a failure: an <if>
   or <elseif> cond needs it, since W3C SCXML 4.9 then ends the block the
   <if> is in, and `result_var` alone cannot tell a false cond from one that
   could not be evaluated (W3C SCXML 5.9.1). A transition passes none. #}
{% macro lua_eval_guard(cond, result_var, failed_var='', element='a <transition>') %}
    {{ result_var }} = false;
    if (luaL_dostring(sm->L,
        "return ({{ cond | to_lua_guard | escape_c }})") == 0) {
        {{ result_var }} = (bool)lua_toboolean(sm->L, -1);
        lua_pop(sm->L, 1);
    } else {
        lua_pop(sm->L, 1);
{% if failed_var %}
        {{ failed_var }} = true;
{% endif %}
        {{ csym_prefix }}{{ model.name }}_raise_platform_error(
            sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
            {{ reason("cond_failed", element) }});
    }
{% endmacro %}

{# Emit a body-empty <foreach>: declare item (and optional index) on the Lua
   datamodel, then iterate through `array` setting item/index each step.
   W3C SCXML 4.6 mandates that even an empty foreach declares its item /
   index variables (so a later state can test them via `typeof`).
   Index is 0-based to mirror cpp `ForeachHelper::setForeachIterationVariables`
   (size_t i passed verbatim). Non-array `array` values: the empty-body
   variant proceeds silently — the no-body case has no observable
   side-effect to raise about (item/index already set to nil), and the
   first force fixture for a body-less foreach over a non-array would
   need a separate raise lift. body-bearing foreach routes to the
   prologue/iter/epilogue trio above (state_machine.c.jinja2 lines
   233-256), never to this macro — the call-site `{% if action.actions %}`
   guard is the single seam. #}
{% macro lua_foreach_no_body(array, item, index) %}
{% set item_loc = item | to_lua_location | escape_c %}
{% set index_loc = index | to_lua_location | escape_c %}
    (void)luaL_dostring(sm->L,
        "{{ item_loc }} = nil; "
        {% if index %}"{{ index_loc }} = nil; "{% endif %}
        "do local _a = ({{ array | to_lua_expr | escape_c }}); "
        "if _isArray(_a) or type(_a) == 'table' then "
        "for _i, _v in ipairs(_a) do "
        "{{ item_loc }} = _v"
        {% if index %}"; {{ index_loc }} = _i - 1"{% endif %}
        " end end end");
{% endmacro %}

{# Body-bearing foreach prologue: stash the array on the lua global `slot`
   and the length on local `_sce_n`. Returns -1 for non-table values; the
   caller's `if (_sce_n < 0) raise + return;` arm raises error.execution
   per W3C 4.6 + 5.4 (mirrors cpp `ForeachHelper::evaluateForeachArray`
   nullopt → caller raise). For tables that pass `_isArray` returns
   `#slot`; for empty / dictionary-shaped tables (no integer
   keys, rawlen 0) falls back to length 0 per cpp's empty-table
   fallback at `ForeachHelper.h:173-191`. Caller declares the C-local
   `_sce_n`. #}
{% macro lua_foreach_body_prologue(array, item, index, slot) %}
    int _sce_n = -1;
    if (luaL_dostring(sm->L,
        "{{ slot }} = ({{ array | to_lua_expr | escape_c }}); "
        "if _isArray({{ slot }}) then return #{{ slot }} "
        "elseif type({{ slot }}) == 'table' then return 0 "
        "else return -1 end") == 0) {
        _sce_n = (int)lua_tointeger(sm->L, -1);
    }
    lua_pop(sm->L, 1);
    /* W3C 4.6: declare item / index on the datamodel even for empty arrays. */
    (void)luaL_dostring(sm->L,
        "{{ item | to_lua_location | escape_c }} = nil"
        {% if index %}"; {{ index | to_lua_location | escape_c }} = nil"{% endif %});
{% endmacro %}

{# Per-iteration update: set item to `slot[_i+1]` (lua is
   1-based, W3C index is 0-based; the C loop counter `_i` is the W3C
   index). On chunk failure (e.g. illegal item identifier like
   `'continue'` triggering a Lua syntax error) raise
   EVENT_ERROR_EXECUTION and `return` — W3C 4.6 ends the <foreach> and
   the block that contains it.

   The buffer is sized from the two targets this chunk actually writes
   rather than from a corpus assumption. It used to be a flat 96 bytes,
   "sized for the W3C corpus (≤ 32-char identifiers)" — a claim about
   the fixtures rather than about the document being generated, and a
   target the frontend refuses carries its refusal *message* here, which
   gcc rejected at 196 bytes with `-Werror=format-truncation`. The
   lengths are known at generation time, so they are used: 96 covers the
   fixed text (26) and two `%d` at 11 each, with room to spare. #}
{% macro lua_foreach_body_iter(item, index, slot) %}
{% set item_loc = item | to_lua_location | escape_c %}
{% set index_loc = index | to_lua_location | escape_c %}
    {
        char _sce_buf[{{ 96 + (item_loc | length) + (index_loc | length) + (slot | length) }}];
        (void)snprintf(_sce_buf, sizeof(_sce_buf),
            "{{ item_loc }} = {{ slot }}[%d]"
            {% if index %}"; {{ index_loc }} = %d"{% endif %},
            _i + 1{% if index %}, _i{% endif %});
        if (luaL_dostring(sm->L, _sce_buf) != 0) {
            lua_pop(sm->L, 1);
            {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                {{ reason("built_expression_failed") }});
            return;  /* W3C SCXML 4.6: ends the <foreach> and its block */
        }
    }
{% endmacro %}

{# Tear down the cached array global so a sibling foreach in the same
   onentry block does not pick up a stale reference. #}
{% macro lua_foreach_body_epilogue(slot) %}
    (void)luaL_dostring(sm->L, "{{ slot }} = nil");
{% endmacro %}

{# W3C SCXML 5.5: evaluate `<donedata><content expr="X"/></donedata>` into
   the `_sce_donedata` stash its done event is built from. On chunk failure
   the lua error is popped, `_sce_donedata` is reset to nil (W3C 5.5:
   "Return empty data when evaluation fails"), and an `error.execution`
   event is queued (W3C 5.10). Mirrors cpp `DoneDataHelper::evaluateContent`
   — the cpp path returns `outEventData = ""` on failure but still emits
   the done.state event, and the C11 emit follows that same flow; no
   donedata failure withholds the done event (§scxml-5.7). #}
{# `lua` arrives already lowered, because which filter lowers it is what
   distinguishes the two readings §scxml-B-2 gives `<content>`: `expr`
   promises an expression (`to_lua_expr`), while inline text is an
   expression only if it is one and otherwise a string
   (`to_lua_data_content`). Taking the lowered form as the parameter is
   what lets both readings share this body rather than fork it. #}
{# W3C SCXML B.2: stash a `<donedata>` content the build finished as its wire
   text (`inline_content_reading`): the XML as written or a literal's JSON. It
   is marked with the `_sce_wire_text` metatable, so `_sce_donedata_to_wire`
   hands it on unchanged where it would otherwise write the JSON of a string
   holding it, and the receiver reads XML as the document it is. Nothing is
   evaluated, so nothing can fail. #}
{% macro lua_stash_donedata_wire(wire) %}
    (void)luaL_dostring(sm->L,
        "_sce_donedata = setmetatable({ \"{{ wire | escape_lua | escape_c }}\" }, _sce_wire_text)");
{% endmacro %}

{% macro lua_eval_donedata_content(lua) %}
    if (luaL_dostring(sm->L,
        "_sce_donedata = ({{ lua | escape_c }})") != 0) {
        lua_pop(sm->L, 1);
        (void)luaL_dostring(sm->L, "_sce_donedata = nil");
        {{ csym_prefix }}{{ model.name }}_raise_platform_error(
            sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
            {{ reason("donedata_failed") }});
    }
{% endmacro %}

{# W3C SCXML 5.7: evaluate one `<param name=N expr=X/>` (or location=X) and
   set `_sce_donedata.N = (X)`. The caller emits `_sce_donedata = {}`
   once before iterating so the table exists. On chunk failure W3C 5.7
   says "ignore the failed param, continue with others"; the macro pops
   the lua error and queues `error.execution` without aborting the loop.
   Structural-error (empty location AND empty expr) is decided at codegen
   time by the caller and never reaches this macro. The chosen-expression
   precedence (location > expr) mirrors cpp's
   `param.location if param.location else param.expr`.

   ECMAScript ReferenceError detection (W3C 5.7, test343): cpp
   `LuaEngine::evaluateExpressionInternal` (`LuaEngine.cpp:795`) detects
   undeclared simple variables via `isUndeclaredSimpleVariable` and
   returns `ScriptResult::createError("ReferenceError: ...")`, which
   triggers the param-error `error.execution` raise upstream. C11 mirrors
   that check inside the lua chunk: extract the base identifier of the
   chosen expression (everything up to the first `.` / `[` / operator),
   look it up in `_scxml_declared` (set up in `lua_init_engine` to mirror
   cpp's `declaredVars`) and `_G[base]` (covers Lua standard globals like
   `math` / `string`, and the system variables, which `_G`'s metatable
   reads from outside the table — see `lua_init_engine`). Missing on both paths is undeclared → error → upstream
   pcall catches it and the macro raises error.execution. The base
   extraction uses lua's pattern `^[%a_][%w_]*` so multi-segment
   expressions like `Var1.foo` only check the first segment, exactly
   like cpp's `expr.substr(0, baseEnd)`. #}
{% macro lua_eval_donedata_param_expr(param_name, chosen_expr) %}
    if (luaL_dostring(sm->L,
        "do "
          "local _expr = '{{ chosen_expr | escape_c }}'; "
          "local _base = _expr:match('^[%a_][%w_]*'); "
          "if _base and not _scxml_declared[_base] and _G[_base] == nil then "
            "error('ReferenceError: ' .. _base .. ' is not defined') "
          "end; "
          "_sce_donedata[\"{{ param_name | escape_lua | escape_c }}\"] = ({{ chosen_expr | to_lua_expr | escape_c }}) "
        "end") != 0) {
        lua_pop(sm->L, 1);
        {{ csym_prefix }}{{ model.name }}_raise_platform_error(
            sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
            {{ reason("donedata_param_failed") }});
    }
{% endmacro %}

{# Consumer-agnostic to-string evaluator: evaluate an arbitrary lua-side
   expression and copy the resulting `tostring(...)` value into a
   caller-owned char buffer (`out_buf`, capacity `out_cap`). Active
   consumers: `<send eventexpr>` (W3C 6.2), `<send targetexpr>`,
   `<send typeexpr>`, `<log expr>` (W3C 4.4), `<cancel sendidexpr>`
   (W3C 6.3). The chunk pushes `tostring((expr))` onto the lua stack so
   any value type (string / number / bool) coerces to its conventional
   textual form before C reads it — mirrors cpp `ScriptResultUtils::resultToString`
   semantics. On chunk failure the buffer is left empty and `out_ok`
   becomes false; the caller is responsible for raising error.execution
   and stopping the rest of the action per W3C 5.10. lua_pop runs
   unconditionally so the stack is clean for the next caller. Buffer
   cap is per-call-site (64 for short event names / target tokens, 256
   for log payloads / typeexpr URIs); fixtures that exceed a cap raise
   it locally without affecting other consumers. #}
{# W3C SCXML 6.2.4 / 6.4.1: write a generated id to an `idlocation`.

   The location is a location expression, so this is the assignment `<assign>`
   makes: lowered by `to_lua_location`, so a member path lands, and `out_ok`
   false when it cannot take the id — the caller raises error.execution
   (W3C SCXML 5.9.2) and abandons the element. The id travels as the chunk's
   argument (`...`) rather than spliced into its text, so a run-time id needs
   no quoting and cannot change what the chunk says. A failure's message is
   popped, not left on the stack. #}
{% macro lua_store_id_in_location(loc, id_expr, out_ok) %}
    {{ out_ok }} = false;
    if (luaL_loadstring(sm->L, "{{ loc | to_lua_location | escape_c }} = ...") == 0) {
        lua_pushstring(sm->L, {{ id_expr }});
        {{ out_ok }} = lua_pcall(sm->L, 1, 0, 0) == 0;
        if (!{{ out_ok }}) {
            lua_pop(sm->L, 1);
        }
    } else {
        lua_pop(sm->L, 1);
    }
{% endmacro %}

{% macro lua_eval_to_string(expr, out_buf, out_cap, out_ok) %}
    {{ out_ok }} = false;
    {{ out_buf }}[0] = '\0';
    if (luaL_dostring(sm->L,
        "return tostring(({{ expr | to_lua_expr | escape_c }}))") == 0) {
        size_t _evt_len = 0u;
        const char *_evt_str = lua_tolstring(sm->L, -1, &_evt_len);
        if (_evt_str != NULL) {
            if (_evt_len >= (size_t)({{ out_cap }})) {
                _evt_len = (size_t)({{ out_cap }}) - 1u;
            }
            memcpy({{ out_buf }}, _evt_str, _evt_len);
            {{ out_buf }}[_evt_len] = '\0';
            {{ out_ok }} = true;
        }
    }
    lua_pop(sm->L, 1);
{% endmacro %}

{# W3C SCXML C.2: evaluate an expression and render the result as the text a
   form-encoded `<param>` carries.

   `lua_eval_to_string` above is the wrong renderer for this one surface, and
   the reason is `tostring`. It is Lua's spelling of a value, and the wire is
   not Lua's: `tostring(nil)` is the word "nil" where every other channel
   sends nothing, and `tostring({1,2})` is `table: 0x55f3...` — a POINTER,
   valid for exactly one process. Measured 2026-08-21, this one field had six
   answers across six backends. The rendering below is the one C++
   `ScriptResultUtils::resultToString` gives on every arm the corpus reaches,
   so a document compiled to C11 puts the same bytes on the wire as the same
   document compiled anywhere else:

     nil            → ""            (§scxml-C-1: absence is the empty string)
     boolean        → true / false
     integral number→ 5             (ECMAScript String(5), not Lua's "5.0")
     other number   → tostring
     string         → itself, unquoted
     table          → JSON, via the shared `json_builtins.lua` encoder this
                      session already loads — the same encoder the other five
                      backends use, rather than a sixth spelling here.

   `math.tointeger` rather than `%d`: it answers nil for a float with no exact
   integer value instead of raising, so the numeric arm needs no range guard. #}
{# The rendering above as a Lua local function `_w`, spliced into a chunk as C
   string literals. Written once so the two chunks that render a value as wire
   text — one expression here, and every evaluated `<send>` pair a host
   receives — cannot render the same value two ways. #}
{% macro lua_wire_string_fn() %}
        "local function _w(v)\n"
        "  if v == nil then return '' end\n"
        "  local t = type(v)\n"
        "  if t == 'string' then return v end\n"
        "  if t == 'boolean' then return tostring(v) end\n"
        "  if t == 'number' then\n"
        "    local i = math.tointeger(v)\n"
        "    if i ~= nil then return tostring(i) end\n"
        "    return tostring(v)\n"
        "  end\n"
        "  if t == 'table' then return JSON.stringify(v) end\n"
        "  return tostring(v)\n"
        "end\n"
{% endmacro %}
{# `record_as`, when given, is the name the evaluated value is also kept under
   in `_sce_invoke_pairs`, as the data model holds it: a host-run `<invoke>`
   reads its request's event data (the pairs as JSON) from that table, so the
   one evaluation that renders the text also supplies the typed value. #}
{% macro lua_record_pair(record_as) %}{% if record_as %}"table.insert(_sce_invoke_pairs, {\"{{ record_as | escape_lua | escape_c }}\", v})\n"{% endif %}{% endmacro %}
{# docs/adr/0086, section 8.6 (d): the copy of the wire text `_wire_str`,
   `_wire_len` bytes, into where the caller asked. With `role`, a role of the
   scratch (a row of the pairs, the invocation's content), grown in the engine's
   heap to hold the text whole: `out_buf` is then a `const char *` the caller
   declared, which views the text once it is there, and `held` a `bool` the
   caller declared true, set false when the heap could not hold it, which is
   refused whole and counted (`refuse_event_data`), so the caller raises no
   reason of its own for it. Without `role`, `out_buf` is a fixed buffer of
   `out_cap` bytes. #}
{% macro lua_wire_text_copy(out_buf, out_cap, out_ok, role, held) %}
{% if role %}
            if (SCE_SCRATCH_RESERVE({{ role }}, _wire_len + 1u)) {
                memcpy(SCE_SCRATCH_BUF({{ role }}), _wire_str, _wire_len);
                SCE_SCRATCH_BUF({{ role }})[_wire_len] = '\0';
                {{ out_buf }} = SCE_SCRATCH_BUF({{ role }});
                {{ out_ok }} = true;
            } else {
                {{ held }} = false;
                refuse_event_data(sm, NULL);
            }
{% else %}
            if (_wire_len >= (size_t)({{ out_cap }})) {
                _wire_len = (size_t)({{ out_cap }}) - 1u;
            }
            memcpy({{ out_buf }}, _wire_str, _wire_len);
            {{ out_buf }}[_wire_len] = '\0';
            {{ out_ok }} = true;
{% endif %}
{% endmacro %}
{% macro lua_wire_text_clear(out_buf, role) %}{% if role %}    {{ out_buf }} = "";{% else %}    {{ out_buf }}[0] = '\0';{% endif %}{% endmacro %}
{% macro lua_eval_to_wire_string(expr, out_buf, out_cap, out_ok, record_as=none, role=none, held=none) %}
    {{ out_ok }} = false;
{{ lua_wire_text_clear(out_buf, role) }}
    if (luaL_dostring(sm->L,
{{ lua_wire_string_fn() }}
{% if record_as %}
        "local v = ({{ expr | to_lua_expr | escape_c }})\n"
        {{ lua_record_pair(record_as) }}
        "return _w(v)") == 0) {
{% else %}
        "return _w(({{ expr | to_lua_expr | escape_c }}))") == 0) {
{% endif %}
        size_t _wire_len = 0u;
        const char *_wire_str = lua_tolstring(sm->L, -1, &_wire_len);
        if (_wire_str != NULL) {
{{ lua_wire_text_copy(out_buf, out_cap, out_ok, role, held) }}
        }
    }
    lua_pop(sm->L, 1);
{% endmacro %}

{# SCE Accepted Subset 2.12: one `<param>` of a typed host-run `<invoke>`,
   evaluated and held to its request field (`field_type`, an
   `sce_request_field_type_t` initializer) by `sce_request_field_wire`.

   Unlike `lua_eval_to_wire_string`, the value's TYPE is read before it is
   spelled: a record's field is promised a number, a truth value or a text,
   and the spelling alone cannot tell `2` from `'2'`. The value is read into a
   neutral scalar and judged by the runtime header, so the rule is written
   once for every C11 machine. `out_refusal` is NULL when the value fits, else
   the sentence the caller raises.

   docs/adr/0086, section 8.6 (d): the text is written into the scratch's role
   `role` (a row of the pairs), grown in the engine's heap first to the most
   bytes the field's spelling of the value can take
   (`sce_request_field_wire_size`), so the spelling is never cut by the
   buffer; `out_buf` is a `const char *` the caller declared, which views it.
   `held` is a `bool` the caller declared true, set false when the heap could
   not grow the row: the value is then refused whole and counted
   (`refuse_event_data`), and `out_refusal` is NULL. #}
{% macro lua_eval_to_request_field(expr, field_type, out_buf, role, held, out_refusal, record_as=none) %}
    {{ out_refusal }} = SCE_REQUEST_REFUSE_UNEVALUATED;
{% if record_as %}
    if (luaL_dostring(sm->L,
        "local v = ({{ expr | to_lua_expr | escape_c }})\n"
        {{ lua_record_pair(record_as) }}
        "return v") == 0) {
{% else %}
    if (luaL_dostring(sm->L, "return ({{ expr | to_lua_expr | escape_c }})") == 0) {
{% endif %}
        sce_script_scalar_t _scalar;
        memset(&_scalar, 0, sizeof(_scalar));
        switch (lua_type(sm->L, -1)) {
        case LUA_TNIL:
            _scalar.kind = SCE_SCRIPT_SCALAR_NIL;
            break;
        case LUA_TBOOLEAN:
            _scalar.kind = SCE_SCRIPT_SCALAR_BOOL;
            _scalar.boolean = lua_toboolean(sm->L, -1) != 0;
            break;
        case LUA_TNUMBER:
            if (lua_isinteger(sm->L, -1)) {
                _scalar.kind = SCE_SCRIPT_SCALAR_INTEGER;
                _scalar.integer = (int64_t)lua_tointeger(sm->L, -1);
            } else {
                _scalar.kind = SCE_SCRIPT_SCALAR_FLOAT;
                _scalar.floating = (double)lua_tonumber(sm->L, -1);
            }
            break;
        case LUA_TSTRING:
            _scalar.kind = SCE_SCRIPT_SCALAR_STRING;
            _scalar.text = lua_tolstring(sm->L, -1, &_scalar.text_len);
            break;
        default:
            _scalar.kind = SCE_SCRIPT_SCALAR_OTHER;
            break;
        }
        if (SCE_SCRATCH_RESERVE({{ role }}, sce_request_field_wire_size(&_scalar))) {
            {{ out_refusal }} = sce_request_field_wire(&_scalar, {{ field_type }}, SCE_SCRATCH_BUF({{ role }}),
                                                       SCE_SCRATCH_CAP({{ role }}));
            {{ out_buf }} = SCE_SCRATCH_BUF({{ role }});
        } else {
            {{ out_refusal }} = NULL;
            {{ held }} = false;
            refuse_event_data(sm, NULL);
        }
    }
    lua_pop(sm->L, 1);
{% endmacro %}

{# W3C SCXML C.2: one namelist item, rendered as the form parameter a
   BasicHTTP POST carries.

   Not `lua_eval_to_wire_string`, and the difference is the whole point.
   §scxml-6.2.2 defines a namelist item as a DATA MODEL LOCATION and sends
   the reader to §scxml-5.9.2; it is not an authored expression. Lowering it
   through `to_lua_expr` asks the ECMAScript frontend whether the name is
   declared, and the frontend answers by REFUSING the document — so a
   `<send namelist>` naming something the datamodel does not hold stopped
   being a runtime error (`error.execution`, §scxml-5.9.2) and became a
   document this backend will not generate. Measured 2026-08-21: the same
   backend's SCXMLEventProcessor arm reads the same construct with
   `lua_eval_namelist_var`'s declared-guard and is right, so one clause had
   two answers here, and only the arm with a witness (W3C test553) had the
   right one — test553 declares no `<data>` at all, which is the only reason
   the frontend stayed silent on it.

   The declared-guard is the same two-source check that macro uses
   (`_scxml_declared` for the document's own declarations, `_G` for what
   the running machine has bound since, its system variables included). A miss leaves `out_ok` false and the
   caller discards the message, per §scxml-6.2.3. #}
{% macro lua_namelist_var_to_wire_string(var_name, out_buf, out_cap, out_ok, record_as=none, role=none, held=none) %}
    {{ out_ok }} = false;
{{ lua_wire_text_clear(out_buf, role) }}
    if (luaL_dostring(sm->L,
        "if not _scxml_declared['{{ var_name | escape_c }}'] and "
          "_G['{{ var_name | escape_c }}'] == nil then "
          "error('namelist variable not declared: {{ var_name | escape_c }}') "
        "end\n"
        "local v = ({{ var_name | escape_c }})\n"
{% if record_as %}
        {{ lua_record_pair(record_as) }}
{% endif %}
        "if v == nil then return '' end\n"
        "local t = type(v)\n"
        "if t == 'string' then return v end\n"
        "if t == 'boolean' then return tostring(v) end\n"
        "if t == 'number' then\n"
        "  local i = math.tointeger(v)\n"
        "  if i ~= nil then return tostring(i) end\n"
        "  return tostring(v)\n"
        "end\n"
        "if t == 'table' then return JSON.stringify(v) end\n"
        "return tostring(v)") == 0) {
        size_t _wire_len = 0u;
        const char *_wire_str = lua_tolstring(sm->L, -1, &_wire_len);
        if (_wire_str != NULL) {
{{ lua_wire_text_copy(out_buf, out_cap, out_ok, role, held) }}
        }
    }
    lua_pop(sm->L, 1);
{% endmacro %}

{# W3C SCXML 6.2 (test175): evaluate `<send delayexpr="...">` and read the
   value as the CSS2 time the clause names. The value is rendered as wire text
   by the same `_w` every other value crossing takes, then read by
   `sce_parse_delay_ms` — the runtime's one duration reader, held to
   tests/durations/css2_time.json like every engine's (ARCHITECTURE.md,
   "Durations"). `out_eval_ok` says the expression evaluated; `out_is_time`
   says its value is a time. A value too long for the buffer is not one: it is
   refused rather than truncated into some other text. #}
{% macro lua_eval_delayexpr(expr, out_ms, out_eval_ok, out_is_time) %}
    {{ out_eval_ok }} = false;
    {{ out_is_time }} = false;
    {{ out_ms }} = 0;
    if (luaL_dostring(sm->L,
{{ lua_wire_string_fn() }}
        "return _w(({{ expr | to_lua_expr | escape_c }}))") == 0) {
        size_t _delay_len = 0u;
        const char *_delay_str = lua_tolstring(sm->L, -1, &_delay_len);
        if (_delay_str != NULL) {
            char _delay_text[SCE_MAX_ID_LEN];
            {{ out_eval_ok }} = true;
            if (_delay_len < sizeof(_delay_text) && strlen(_delay_str) == _delay_len) {
                memcpy(_delay_text, _delay_str, _delay_len);
                _delay_text[_delay_len] = '\0';
                {{ out_is_time }} = sce_parse_delay_ms(_delay_text, &{{ out_ms }});
            }
        }
    }
    lua_pop(sm->L, 1);
{% endmacro %}

{# W3C SCXML 6.4 (test226/240/241/243/244/245/276): cross-Lua-state value
   transfer for `<invoke><param>` / `<invoke namelist>`. Parent's
   `execute_pending_invokes` evaluates the expression (for params) or reads
   the global (for namelist) on its own `lua_State` so the value lands on
   `src_L`'s top of stack; this macro copies that top value to `dst_L`'s
   global table under `dst_name` and pops the source slot.

   C11 evaluates parent-side and transfers the value because each generated
   SM owns a dedicated `lua_State` per `_init`, so a string that names a
   parent-side variable would be undefined in the child's state. §scxml-6.4.3
   asks for exactly that — the VALUE of the `<param>` element becomes the
   matching child `<data>`'s initial value.

   cpp passed the param's expr STRING to the child's script engine so the
   child re-evaluated it in its own context, until the fixture
   `integration_resources/invoke_param_seeds_declared_child_data/` made the
   two answers differ. For literal-expression W3C tests (all of test226/240
   /241/243/244/245/276 use `expr="1"` or namelist names that resolve to
   integers) both shapes converge on the same observable child datamodel,
   which is why that divergence survived every suite.

   Type dispatch covers the W3C corpus param/namelist value types: integer
   / float (Lua number, distinguished via lua_isinteger so 0 stays an int
   in the child datamodel), string, boolean. Non-primitives (table /
   function / userdata) collapse to nil — no fixture in the W3C corpus
   passes those; the first one forces a typed-payload helper. nil and
   none transfer as nil. The pop on `src_L` keeps the parent's stack
   balanced for sibling-param iteration.

   §scxml-5.10: the child's variable is named by the document, so it is
   stored through `set_document_global`, protected; a name the child's shared
   globals refuse (a system variable's) is a value that could not be given,
   raised on the parent as error.execution like a `<param>` that could not be
   read, and the child starts one pair short. #}
{% macro lua_xfer_top_to_child(src_L, dst_L, dst_name) %}
        {
            int _xfer_t = lua_type({{ src_L }}, -1);
            if (_xfer_t == LUA_TBOOLEAN) {
                lua_pushboolean({{ dst_L }}, lua_toboolean({{ src_L }}, -1));
            } else if (_xfer_t == LUA_TNUMBER) {
                if (lua_isinteger({{ src_L }}, -1)) {
                    lua_pushinteger({{ dst_L }}, lua_tointeger({{ src_L }}, -1));
                } else {
                    lua_pushnumber({{ dst_L }}, lua_tonumber({{ src_L }}, -1));
                }
            } else if (_xfer_t == LUA_TSTRING) {
                size_t _xfer_len = 0;
                const char *_xfer_s = lua_tolstring({{ src_L }}, -1, &_xfer_len);
                if (_xfer_s != NULL) {
                    lua_pushlstring({{ dst_L }}, _xfer_s, _xfer_len);
                } else {
                    lua_pushnil({{ dst_L }});
                }
            } else {
                lua_pushnil({{ dst_L }});
            }
            if (!set_document_global({{ dst_L }}, "{{ dst_name | escape_c }}")) {
                {{ csym_prefix }}{{ model.name }}_raise_platform_error(
                    sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
                    {{ reason("invoke_child_ungiven", dst_name) }});
            }
            lua_pop({{ src_L }}, 1);
        }
{% endmacro %}

{# W3C SCXML 5.5 + 6.3.1 donedata carry out of a machine's script engine.

   Reads `L`'s `_sce_donedata` lua global (the stash populated by a
   `<final><donedata>` entry emit in
   `state_machine.c.jinja2::execute_entry_actions`), serialises it to
   JSON via `_sce_donedata_to_wire`, and copies the resulting string into
   `out`, at most `cap - 1` bytes and then ended (nothing for a `cap` of 0),
   answering in `whole_var` the bytes of the whole text, so a caller tells a
   text that did not fit from one that did and is never handed a cut one as
   whole. A machine's `_done_data_wire` asks it for the `done.invoke` its
   parent raises when the machine holds its done data in its engine; a
   compound final writes its own done.state event's data whole into the
   scratch instead (`lua_donedata_wire_scratch` below).

   The parent's `process_event_queues` external dequeue sees a non-empty
   `evt.data` and PARSES it on its own `sm->L`, producing a typed lua
   value the parent's `done.invoke.<id>` transition cond can dereference
   (`_event.data.result === 42`, `_event.data ===
   'hello_content'`, etc.). Empty `_sce_donedata` (child final
   without `<donedata>`) serialises to '' → `_done_evt.data` zero-init
   stays → receiver skips the override (`_event.data` remains nil),
   matching W3C 5.10 "no donedata → undefined" contract for non-
   donedata invokes (test247-shape children).

   This bridge mirrors cpp `donedataAtFinal()` + `typedDonedataAtFinal()`
   carried on `EventMetadataHelper::createDoneInvokeEvent`
   (invoke_methods.jinja2:189-195), JSON included: `EventWithMetadata`
   crosses engine-agnostic boundaries there, and this `data[]` field is
   the same kind of boundary here — an embedder writes to it too.

   Only a machine that carries an engine has an `L` to ask; one that has
   none holds its done data in its own buffer, which its `_done_data_wire`
   reads instead, so a parent asks every child the same way. #}
{% macro lua_donedata_wire_into(L_var, out_var, cap_expr, whole_var) %}
    {
        (void)luaL_dostring({{ L_var }},
            "_sce_donedata_literal = _sce_donedata_to_wire(_sce_donedata)");
        lua_getglobal({{ L_var }}, "_sce_donedata_literal");
        if (lua_isstring({{ L_var }}, -1)) {
            const char *_lit = lua_tostring({{ L_var }}, -1);
            size_t _lit_n = strlen(_lit);
            {{ whole_var }} = _lit_n;
            if (({{ cap_expr }}) > 0u) {
                if (_lit_n >= ({{ cap_expr }})) {
                    _lit_n = ({{ cap_expr }}) - 1u;
                }
                memcpy({{ out_var }}, _lit, _lit_n);
                ({{ out_var }})[_lit_n] = '\0';
            }
        }
        lua_pop({{ L_var }}, 1);
        (void)luaL_dostring({{ L_var }}, "_sce_donedata_literal = nil");
    }
{% endmacro %}

{# docs/adr/0086, section 8.6 (d): the same done data, written whole into the
   scratch's role `role`, grown in the engine's heap to hold it, for a compound
   final's done.state event. `held_var` is true once the text is there, and
   false when the heap could not hold it: then nothing was written, and the
   caller refuses the event whole. No done data is the empty text. #}
{% macro lua_donedata_wire_scratch(role, held_var) %}
    {
        (void)luaL_dostring(sm->L,
            "_sce_donedata_literal = _sce_donedata_to_wire(_sce_donedata)");
        lua_getglobal(sm->L, "_sce_donedata_literal");
        size_t _lit_n = 0u;
        const char *_lit = lua_isstring(sm->L, -1) ? lua_tolstring(sm->L, -1, &_lit_n) : NULL;
        if (_lit == NULL) {
            _lit = "";
            _lit_n = 0u;
        }
        {{ held_var }} = SCE_SCRATCH_RESERVE({{ role }}, _lit_n + 1u);
        if ({{ held_var }}) {
            memcpy(SCE_SCRATCH_BUF({{ role }}), _lit, _lit_n);
            SCE_SCRATCH_BUF({{ role }})[_lit_n] = '\0';
        }
        lua_pop(sm->L, 1);
        (void)luaL_dostring(sm->L, "_sce_donedata_literal = nil");
    }
{% endmacro %}
