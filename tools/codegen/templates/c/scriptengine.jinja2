{# RFC §5.J.1 — C11 script-engine helpers (lua_State* direct, no abstraction).

   The C++/Rust/Go/Kotlin backends route script execution through an
   IScriptEngine interface (ScriptEngineProvider in C++/Rust/Go,
   ScriptEngineHost in Kotlin) so that a fixture-level test harness can
   swap a mock engine. The C11 backend is AOT-only and bare-metal-bound:
   the embedded target runs Lua 5.4 directly with no allocator hook, no
   futures, no virtual dispatch. So this template emits raw lua C API
   calls inline, and the abstraction layer that the other backends carry
   never appears in the generated `_sm.c`.

   Macros exported:
     - lua_init_engine()         → create lua_State, openlibs, init datamodel
     - lua_destroy_engine()      → close lua_State (idempotent, NULL-safe)
     - lua_assign(loc, expr)     → execute "loc = (transpiled_expr)" chunk
     - lua_eval_guard(cond, var) → set `var` (bool) to truthiness of cond
     - lua_foreach_no_body(...)  → W3C 4.6 foreach with empty body (var decl
                                   + iteration item/index without C body)
     - lua_foreach_body_prologue / _iter / _epilogue → W3C 4.6 foreach with
                                   a C-side body. Prologue caches the array
                                   on lua global `_sce_foreach_arr` and
                                   exposes its length on C local `_sce_n`;
                                   _iter sets item/index for one iteration;
                                   _epilogue clears the cache. Nested foreach
                                   is intentionally left unsupported — the
                                   fixed lua global name would collide; the
                                   first nested fixture forces unique-id work.

   Every macro takes the Lua state pointer as `sm->L`; the calling
   template owns the surrounding block scope and any per-block error
   handling. T3 lock-in (jinja2 inline) per c11_design_decisions.md —
   no helper class, no shared .c file. #}

{% macro lua_init_engine() %}
    /* W3C SCXML 5.10: Open Lua state and register standard libraries. */
    sm->L = luaL_newstate();
    if (sm->L != NULL) {
        luaL_openlibs(sm->L);
        /* W3C SCXML 5.9 / 4.6: ECMAScript truthiness for transition cond
           and <if cond>. Lua's native truthiness only treats nil/false as
           falsy, but ECMAScript additionally treats 0, NaN, empty string,
           null, and undefined as falsy — `lua_transformer::wrap_truthiness`
           wraps cond expressions in `_scxml_truthy(...)` whenever the
           expression is not already a Lua-comparable boolean (no
           ==/~=/</>/etc), and that helper must exist in the lua state
           before any cond is evaluated. Mirrors the C++ `LuaEngine.cpp`
           lua_pushcfunction registration; we use a Lua-script definition
           via luaL_dostring instead so the C11 backend stays free of
           lua_CFunction trampolines (T3 lock-in: jinja2-inline only). */
        (void)luaL_dostring(sm->L,
            "function _scxml_truthy(v)\n"
            "  if v == nil or v == false then return false end\n"
            "  if type(v) == 'number' then return v ~= 0 and v == v end\n"
            "  if type(v) == 'string' then return #v > 0 end\n"
            "  return true\n"
            "end");
        {% for var in model.variables %}
        {% if var.expr %}
        /* W3C SCXML 5.3: <data id="{{ var.id }}" expr="{{ var.expr | escape_c }}">.
           On expression failure the data element is left undefined (lua nil)
           and error.execution is queued so the SM can react. memset on the
           SM struct in `_init` zero-initialised both queues before this
           loop runs, so direct enqueue is safe at this point. */
        if (luaL_dostring(sm->L,
            "{{ var.id }} = ({{ var.expr | to_lua_expr | escape_c }})") != 0) {
            lua_pop(sm->L, 1);
            {{ model.name }}_event_with_meta_t _err_evt;
            memset(&_err_evt, 0, sizeof(_err_evt));
            _err_evt.event = {{ model.name | upper }}_EVENT_ERROR_EXECUTION;
            {{ model.name }}_raise(sm, &_err_evt);
        }
        {% elif var.content %}
        /* W3C SCXML 5.3: <data id="{{ var.id }}"> inline content (eval as expression).
           Mirrors `<data expr="...">` — the trimmed text content is treated as
           an ECMAScript expression and transpiled via `to_lua_expr`. */
        if (luaL_dostring(sm->L,
            "{{ var.id }} = ({{ var.content | to_lua_expr | escape_c }})") != 0) {
            lua_pop(sm->L, 1);
            {{ model.name }}_event_with_meta_t _err_evt;
            memset(&_err_evt, 0, sizeof(_err_evt));
            _err_evt.event = {{ model.name | upper }}_EVENT_ERROR_EXECUTION;
            {{ model.name }}_raise(sm, &_err_evt);
        }
        {% endif %}
        {% endfor %}
        {% if model.binding == 'early' %}
        {# W3C SCXML 5.3 early binding (default per parser.rs:378 unwrap_or("early")):
           state-local <datamodel> variables initialise at startup so that any
           state can read them before its own onentry runs. Mirrors the cpp
           scriptengine_helpers.jinja2 early-binding loop (model.states |
           dictsort + state.datamodel guard). Late binding emit is deferred
           until the first late fixture forces it (built-but-unconsumed
           carve-out — feedback_built_but_unconsumed.md).
           Init-failure error.execution raise is also deferred here — the
           top-level loop above lifts to the rc-checked shape because
           test277 forces it, but no current fixture has a state-local
           <data> with an illegal expr. The first such fixture will lift
           this loop's emit to mirror the top-level shape verbatim. #}
        {% for state_id, state in model.states | dictsort %}
        {% if state.datamodel %}
        {% for var in state.datamodel %}
        {% if var.expr %}
        /* W3C SCXML 5.3 (early): state '{{ state_id }}' <data id="{{ var.id }}" expr="{{ var.expr | escape_c }}"> */
        (void)luaL_dostring(sm->L,
            "{{ var.id }} = ({{ var.expr | to_lua_expr | escape_c }})");
        {% elif var.content %}
        /* W3C SCXML 5.3 (early): state '{{ state_id }}' <data id="{{ var.id }}"> inline content. */
        (void)luaL_dostring(sm->L,
            "{{ var.id }} = ({{ var.content | to_lua_expr | escape_c }})");
        {% endif %}
        {% endfor %}
        {% endif %}
        {% endfor %}
        {% endif %}
    }
{% endmacro %}

{% macro lua_destroy_engine() %}
    if (sm->L != NULL) {
        lua_close(sm->L);
        sm->L = NULL;
    }
{% endmacro %}

{# Emit a bounded block that assigns `loc = (expr)` via luaL_dostring.
   On chunk failure (illegal location, illegal expression, type error)
   the macro pops the lua error message off the stack and enqueues an
   `error.execution` event onto the SM's internal queue — W3C SCXML 5.4
   mandates that an unsuccessful <assign> raise this event so the
   surrounding state's `transition event="error.execution"` can fire.
   The raise emit shape is identical to the <raise> action emit in
   `state_machine.c.jinja2::emit_action`; `_err_evt` is declared inside
   the inner if-block scope so concurrent <assign>s in the same onentry
   block do not collide. The EVENT_ERROR_EXECUTION enum value is always
   present whenever this path runs — `analyzer.rs::apply_script_engine_implications`
   injects "error.execution" into model.events for every fixture that
   sets needs_script_engine, and any fixture using <assign> does. The
   guard/eval failure on cond expressions remains silent-drop until a
   negative-cond fixture forces it. #}
{% macro lua_assign(loc, expr) %}
    if (luaL_dostring(sm->L,
        "{{ loc }} = ({{ expr | to_lua_expr | escape_c }})") != 0) {
        lua_pop(sm->L, 1);
        {{ model.name }}_event_with_meta_t _err_evt;
        memset(&_err_evt, 0, sizeof(_err_evt));
        _err_evt.event = {{ model.name | upper }}_EVENT_ERROR_EXECUTION;
        {{ model.name }}_raise(sm, &_err_evt);
    }
{% endmacro %}

{# In-foreach-body assign variant: same chunk as lua_assign, but the
   luaL_dostring return value is checked and the enclosing C `for` loop
   is broken on failure (W3C SCXML 4.6 — first error inside <foreach>
   body must cease execution of the loop). On error the lua stack carries
   the chunk's error message; pop it so the next caller sees a clean
   stack. The surrounding-block-abort half of the W3C sentence (cease
   "the block that contains it") is deferred until a fixture forces the
   stricter semantics — test156's pass guard only needs loop break.
   This emit path is reachable only when emit_action is invoked with
   `in_foreach=true`; the standalone `lua_assign` path stays silent-drop
   so existing fixtures (test147 outside <foreach>) are unaffected. #}
{% macro lua_assign_in_foreach_body(loc, expr) %}
    if (luaL_dostring(sm->L,
        "{{ loc }} = ({{ expr | to_lua_expr | escape_c }})") != 0) {
        lua_pop(sm->L, 1);
        break;
    }
{% endmacro %}

{# Emit a bounded block that evaluates `cond` and stores its truthiness in
   `result_var` (must be `bool` and already declared by the caller). The
   chunk returns the value, lua_toboolean lifts it, lua_pop drops the
   stack slot. Same drop-on-error policy as lua_assign for now. #}
{% macro lua_eval_guard(cond, result_var) %}
    {{ result_var }} = false;
    if (luaL_dostring(sm->L,
        "return ({{ cond | to_lua_guard | escape_c }})") == 0) {
        {{ result_var }} = (bool)lua_toboolean(sm->L, -1);
    }
    lua_pop(sm->L, 1);
{% endmacro %}

{# Emit a body-empty <foreach>: declare item (and optional index) on the Lua
   datamodel, then iterate through `array` setting item/index each step.
   W3C SCXML 4.6 mandates that even an empty foreach declares its item /
   index variables (so a later state can test them via `typeof`).
   Index is 0-based to mirror cpp `ForeachHelper::setForeachIterationVariables`
   (size_t i passed verbatim). Non-array `array` values silently drop here;
   the error.execution raise on type mismatch lands with the first negative
   fixture. body-bearing foreach (action.actions non-empty) is rejected at
   the call site with `#error` so a fresh consumer cannot land it silently. #}
{% macro lua_foreach_no_body(array, item, index) %}
    (void)luaL_dostring(sm->L,
        "{{ item }} = nil; "
        {% if index %}"{{ index }} = nil; "{% endif %}
        "do local _a = ({{ array | to_lua_expr | escape_c }}); "
        "if type(_a) == 'table' then "
        "for _i, _v in ipairs(_a) do "
        "{{ item }} = _v"
        {% if index %}"; {{ index }} = _i - 1"{% endif %}
        " end end end");
{% endmacro %}

{# Body-bearing foreach prologue: stash the array on `_sce_foreach_arr` and
   the length on local `_sce_n`. Returns -1 for non-table values so the C
   loop is skipped (W3C 4.6 — error.execution raise on illegal array lands
   with the first negative fixture). Caller declares the C-local `_sce_n`. #}
{% macro lua_foreach_body_prologue(array, item, index) %}
    int _sce_n = -1;
    if (luaL_dostring(sm->L,
        "_sce_foreach_arr = ({{ array | to_lua_expr | escape_c }}); "
        "if type(_sce_foreach_arr) == 'table' then return #_sce_foreach_arr "
        "else return -1 end") == 0) {
        _sce_n = (int)lua_tointeger(sm->L, -1);
    }
    lua_pop(sm->L, 1);
    /* W3C 4.6: declare item / index on the datamodel even for empty arrays. */
    (void)luaL_dostring(sm->L,
        "{{ item }} = nil"
        {% if index %}"; {{ index }} = nil"{% endif %});
{% endmacro %}

{# Per-iteration update: set item to `_sce_foreach_arr[_i+1]` (lua is
   1-based, W3C index is 0-based; the C loop counter `_i` is the W3C
   index). Variable names come from the fixture; the snprintf buffer is
   sized for the W3C corpus (≤ 32-char identifiers). #}
{% macro lua_foreach_body_iter(item, index) %}
    {
        char _sce_buf[96];
        (void)snprintf(_sce_buf, sizeof(_sce_buf),
            "{{ item }} = _sce_foreach_arr[%d]"
            {% if index %}"; {{ index }} = %d"{% endif %},
            _i + 1{% if index %}, _i{% endif %});
        (void)luaL_dostring(sm->L, _sce_buf);
    }
{% endmacro %}

{# Tear down the cached array global so a sibling foreach in the same
   onentry block does not pick up a stale reference. #}
{% macro lua_foreach_body_epilogue() %}
    (void)luaL_dostring(sm->L, "_sce_foreach_arr = nil");
{% endmacro %}
