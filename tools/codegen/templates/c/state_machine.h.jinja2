   (test 332); it is the empty string everywhere else. C has no default
   arguments, so the plain form below forwards to this one rather than the
   two spelling the body twice. */
SCE_C_UNUSED static inline void {{ csym_prefix }}{{ model.name }}_raise_platform_error_with_send_id(
        {{ csym_prefix }}{{ model.name }}_t *sm,
        {{ csym_prefix }}{{ model.name }}_event_t event,
        const char *message,
        const char *send_id) {
    {{ csym_prefix }}{{ model.name }}_event_with_meta_t _pe;
    memset(&_pe, 0, sizeof(_pe));
    _pe.event = event;
    sce_copy_bounded_data(_pe.data, message);
    sce_copy_bounded_n(_pe.type, "platform", (size_t)SCE_MAX_EVENT_TYPE_LEN);
    sce_copy_bounded_id(_pe.send_id, send_id);
    {{ csym_prefix }}{{ model.name }}_raise(sm, &_pe);
}

