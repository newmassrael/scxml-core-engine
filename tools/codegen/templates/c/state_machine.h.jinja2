{# RFC §5.J.1 — C11 statechart header (paired with state_machine.c.jinja2).
   Mirrors the C++ state_machine.jinja2 structure with C11 idioms:
     - namespace SCE::Generated::{name}  →  prefix `{name}_` on every symbol
     - enum class State                  →  enum {name}_state_e + UPPER_SNAKE constants
     - template<Policy> + base class     →  flat struct + free functions
     - std::vector / std::optional / std::string  →  static arrays + bool out-params + char[N]
   Capacity defaults come from sce-c-runtime/include/sce/types.h
   (overridable per fixture via -DSCE_MAX_*=N).                              #}

{% include 'license_header.jinja2' %}

#ifndef SCE_GENERATED_{{ model.name | upper }}_SM_H
#define SCE_GENERATED_{{ model.name | upper }}_SM_H

#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>

#include "sce/types.h"

{% if model.needs_script_engine %}
/* RFC §5.J.1: C11 backend embeds Lua 5.4 directly (no abstraction layer).
   The state machine struct owns the lua_State* lifecycle — opened by
   _init, closed by _destroy. ECMAScript datamodel expressions are
   transpiled to Lua at codegen time via the to_lua_expr/guard filters
   and embedded as C string literals passed to luaL_dostring. */
#include "lua.h"
#include "lualib.h"
#include "lauxlib.h"
{% endif %}

#ifdef __cplusplus
extern "C" {
#endif

/* ── W3C SCXML 3.3: State enumeration ─────────────────────────────── */
{# State enum values double as bit indices in the configuration bitmap
   (see SM struct below). The sentinel `_STATE_COUNT` is the first value
   past the last real state and is the array dimension for any future
   per-state codegen-time table; today it gates the 32-state bitmap
   width via _Static_assert at the bottom of this header.                #}
enum {{ model.name }}_state_e {
    {% for state_name in model.states | sort %}
    {{ model.name | upper }}_STATE_{{ state_name | upper | replace('-', '_') | replace('.', '_') }},
    {% endfor %}
    {{ model.name | upper }}_STATE_COUNT
};
typedef enum {{ model.name }}_state_e {{ model.name }}_state_t;

/* ── W3C SCXML 6.2: Event enumeration ─────────────────────────────── */
{# `_NONE` is the scheduler-polling default (W3C 6.2). Enumerated first so
   the underlying integer is 0, matching the C++ `Event::NONE` semantics
   (`process_transition.jinja2` peers compare against the unset event with
   the zero literal). #}
enum {{ model.name }}_event_e {
    {{ model.name | upper }}_EVENT_NONE{{ "," if model.events }}
    {% for event_name in model.events | sort %}
    {{ model.name | upper }}_EVENT_{{ event_name | upper | replace('.', '_') | replace('-', '_') }}{{ "," if not loop.last }}
    {% endfor %}
};
typedef enum {{ model.name }}_event_e {{ model.name }}_event_t;

/* ── W3C SCXML 5.10: Event with metadata ──────────────────────────── */
{# Mirrors `StaticExecutionEngine<P>::EventWithMetadata` (sce/include/static).
   Strings are bounded char arrays sized via `sce/types.h` so the entire
   event record is value-typed and queue storage is statically reservable. #}
typedef struct {{ model.name }}_event_with_meta {
    {{ model.name }}_event_t event;
    char data[SCE_MAX_DATA_LEN];
    char origin[SCE_MAX_ID_LEN];
    char send_id[SCE_MAX_ID_LEN];
    char type[SCE_MAX_EVENT_TYPE_LEN];
    char origin_type[SCE_MAX_ID_LEN];
    char invoke_id[SCE_MAX_ID_LEN];
    char target[SCE_MAX_ID_LEN];
} {{ model.name }}_event_with_meta_t;

/* ── Internal/external event queues — circular buffer ─────────────── */
typedef struct {{ model.name }}_event_queue {
    {{ model.name }}_event_with_meta_t buf[SCE_MAX_EVENTS];
    uint16_t head;
    uint16_t tail;
    uint16_t count;
} {{ model.name }}_event_queue_t;

/* ── Policy state (datamodel + transition tracking) ───────────────── */
{# C++ `{name}Policy` mutable members. E1 minimum keeps only the
   transition-tracking trio that `AOT_EXECUTE_TRANSITION` always writes.
   Datamodel variables, history slots, invoke tables, and parallel
   active-state vectors join in E2-E5 as their owning fixture lands. #}
typedef struct {{ model.name }}_policy {
    {{ model.name }}_state_t last_transition_source_state;
    /* W3C SCXML 3.13: Target captured at process_transition match time so
       handle_hierarchical_transition can run exit→body→entry without
       requiring a separate `current_state` shadow (active configuration
       lives in the bitmap `active`). Unused when last_transition_is_targetless. */
    {{ model.name }}_state_t last_transition_target_state;
    bool last_transition_is_internal;
    bool last_transition_is_targetless;
    /* W3C SCXML 3.13: Transition body actions are deferred to
       execute_transition_actions so they run between the exit and entry
       chains (mirrors the C++ `lastTransitionIndex_` member used by
       `process_transition.jinja2`'s deferred dispatch). The pair
       (source_state, index) keys into the per-state switch the macro
       emits for fixtures that carry transition body actions. */
    uint16_t last_transition_index;
} {{ model.name }}_policy_t;

/* ── State machine instance ───────────────────────────────────────── */
{# Equivalent to `class {name} : StaticExecutionEngine<{name}Policy>` —
   in C11 the engine and policy fields are flattened into a single
   instance struct (the C++ template instantiates a per-fixture base
   class anyway, so there is no shared base layout to share).             #}
typedef struct {{ model.name }} {
    /* W3C SCXML 3.2: configuration bitmap. Bit N (1u << N) corresponds
       to STATE_N in the enum above; entry sets the bit, exit clears it.
       Compound state entry sets both the parent ancestors and the
       descended initial leaf; <parallel> entry will set every region's
       leaf bit simultaneously. Mirrors cpp `StaticExecutionEngine::activeStates_`
       (std::set<State>) — single truth source for the configuration,
       no parallel `current_state` shadow that would drift in parallel
       fixtures. _Static_assert at the bottom of the header pins the
       state count below the bitmap width (32 today, multi-word array
       lands when a fixture forces it). */
    uint32_t active;
    {{ model.name }}_event_queue_t internal_queue;   /* W3C 3.12.1: high-priority FIFO */
    {{ model.name }}_event_queue_t external_queue;   /* W3C 3.12.1: low-priority FIFO  */
    {{ model.name }}_policy_t policy;
    bool is_running;
    bool transition_taken;
    char current_event_invoke_id[SCE_MAX_ID_LEN];
    void (*completion_callback)(void *user_data);
    void *completion_callback_user_data;
    {% if model.needs_script_engine %}
    lua_State *L;                                    /* W3C 5.10: ECMAScript datamodel */
    {% endif %}
} {{ model.name }}_t;

/* ── Public API ───────────────────────────────────────────────────── */

/* Initialize SM to its initial state (W3C SCXML 3.3 + 3.6 compound descend).
   Must be called once before {{ model.name }}_step / {{ model.name }}_run. */
void {{ model.name }}_init({{ model.name }}_t *sm);

/* W3C SCXML 5.10: Tear down any owned datamodel resources. Idempotent —
   safe to call once per _init or zero times if the caller treats the
   instance as bump-allocated. NULL-safe inside (lua_State* is checked).
   Always present in the public API so callers can call uniformly across
   datamodel-using and datamodel-less fixtures. */
void {{ model.name }}_destroy({{ model.name }}_t *sm);

/* W3C SCXML 6.2: Single macrostep — drain queues, run eventless E* loop. */
void {{ model.name }}_step({{ model.name }}_t *sm);

/* W3C SCXML 6.2: Drive the SM until a top-level final state is reached. */
void {{ model.name }}_run({{ model.name }}_t *sm);

/* W3C SCXML 5.3: Enqueue an event onto the internal (high-priority) queue. */
void {{ model.name }}_raise({{ model.name }}_t *sm,
                            const {{ model.name }}_event_with_meta_t *evt);

/* W3C SCXML 6.2: Enqueue an event onto the external (low-priority) queue. */
void {{ model.name }}_raise_external({{ model.name }}_t *sm,
                                     const {{ model.name }}_event_with_meta_t *evt);

/* W3C SCXML 3.2: configuration query helpers. `_active_states` exposes
   the full bitmap; `_in_state(s)` mirrors the SCXML In() predicate (true
   iff s is in the active configuration). `_get_current_state` is gone
   on purpose — single-leaf semantics break for <parallel> where the
   configuration spans multiple leaves simultaneously. */
uint32_t {{ model.name }}_active_states(const {{ model.name }}_t *sm);
bool {{ model.name }}_in_state(const {{ model.name }}_t *sm, {{ model.name }}_state_t s);
bool {{ model.name }}_is_in_final_state(const {{ model.name }}_t *sm);

/* W3C SCXML 3.3: Compile-time policy queries (mirror C++ `*Policy::*`). */
{{ model.name }}_state_t {{ model.name }}_initial_state(void);
bool {{ model.name }}_is_final_state({{ model.name }}_state_t s);

/* ── Compile-time invariants ──────────────────────────────────────── */
_Static_assert(SCE_MAX_EVENTS >= 1u, "SCE_MAX_EVENTS must be >= 1");
_Static_assert(SCE_MAX_ID_LEN >= 16u, "SCE_MAX_ID_LEN too small for W3C event names");
_Static_assert((unsigned){{ model.name | upper }}_STATE_COUNT <= 32u,
               "Configuration bitmap is uint32_t; multi-word array lands when a fixture exceeds 32 states");

#ifdef __cplusplus
}
#endif

#endif  /* SCE_GENERATED_{{ model.name | upper }}_SM_H */
