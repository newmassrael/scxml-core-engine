{# RFC §synth-5-J-1 — C11 statechart header (paired with state_machine.c.jinja2).
   Mirrors the C++ state_machine.jinja2 structure with C11 idioms:
     - namespace SCE::Generated::{name}  →  prefix `{name}_` on every symbol
     - enum class State                  →  enum {name}_state_e + UPPER_SNAKE constants
     - template<Policy> + base class     →  flat struct + free functions
     - std::vector / std::optional / std::string  →  static arrays + bool out-params + char[N]
   Capacity defaults come from backends/c/runtime/include/sce/types.h
   (overridable per fixture via -DSCE_MAX_*=N).                              #}

{% include 'license_header.jinja2' %}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{# SCE Protocol-Synthesis RFC §synth-5-O: SCE-MAP marker anchoring the
   generated C11 header. Module-level form is a comment, not the
   `#line` directive — `#line` in a header would propagate into
   every including translation unit's diagnostics. #}

{{ sce_map.source_marker(model.source_location, "c", module_level=true, symbol_artifact=sce_artifact.machine) }}

#ifndef SCE_GENERATED_{{ csym_prefix | upper }}{{ model.name | upper }}_SM_H
#define SCE_GENERATED_{{ csym_prefix | upper }}{{ model.name | upper }}_SM_H

#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>

#include "sce/types.h"
{# `SCE_STATIC_ASSERT`, used by the compile-time invariants at the
   bottom of this header. This header opens `extern "C"`, so a C++
   application linking the generated machine compiles it as C++ —
   where `_Static_assert` is not a keyword. See
   backends/c/runtime/include/sce/portability.h. #}
#include "sce/portability.h"

{% if model.needs_event_scheduler %}
/* §scxml-6.2.2: `sce_clock_t`, the per-instance seam this machine measures its
   `<send delay>` deadlines from. The link-time `_sce_clock_now_ms()` it falls
   back to is declared in the same header. */
#include "sce/clock.h"
{% endif %}

{% if model.on_sample_links %}
/* SCE Protocol-Synthesis RFC §synth-5-E sample-callback codegen wire-up. `sce_sample_t`
   borrow type + `sce_sub_callback_t` typedef live in the runtime
   header; the per-link `_deliver_link_<X>_sample` declarations
   below take a `const sce_sample_t *sample` borrow. */
#include "sce/sample.h"
{% endif %}

{% if (model.invokes | scxml_family) or (model.invokes | unsupported) %}
/* W3C SCXML 6.4: invoke types + helpers (backends/c/runtime/include/sce/invoke.h).
   Header-only — types and `static inline` helpers (jinja2-inline
   contract, no shared .c). cpp's `core/InvokeHelper.h` template class is the equivalent
   shape. */
#include "sce/invoke.h"
{% for invoke_info in model.invokes | scxml %}
/* W3C SCXML 6.4: child SM declarations for `<invoke>` in this fixture.
   Each invoke target's generated `_sm.h` is included so the parent's
   struct can embed the child instance and call its public `_init`/
   `_step`/`_destroy` API from the invoke lifecycle helpers below. */
#include "{{ invoke_info.child_name }}_sm.h"
{% endfor %}
{% for invoke_info in model.invokes | hybrid %}
/* W3C SCXML 6.4 (test216/530): child SM declarations for hybrid
   `<invoke srcexpr=...>` / `<invoke><content expr=...>`. The child's
   SCXML is a trivial immediate-final stub written by sce-build's
   `generate_hybrid_child_scxmls`; the parent's runtime evaluation of
   srcexpr/contentexpr is validation-only (cpp `test216_sm.inl:166`
   pattern). The child header / struct embed shape is identical to the
   static-scxml case. */
#include "{{ invoke_info.child_name }}_sm.h"
{% endfor %}
{% endif %}

{% if model.needs_script_engine %}
/* RFC §synth-5-J-1: C11 backend embeds Lua 5.4 directly (no abstraction layer).
   The state machine struct owns the lua_State* lifecycle — opened by
   _init, closed by _destroy. ECMAScript datamodel expressions are
   transpiled to Lua at codegen time via the to_lua_expr/guard filters
   and embedded as C string literals passed to luaL_dostring. */
#include "lua.h"
#include "lualib.h"
#include "lauxlib.h"
{% endif %}

#ifdef __cplusplus
extern "C" {
#endif

/* ── W3C SCXML 3.3: State enumeration ─────────────────────────────── */
{# State enum values double as bit indices in the configuration bitmap
   (see SM struct below). The sentinel `_STATE_COUNT` is the first value
   past the last real state and is the array dimension for any future
   per-state codegen-time table; today it gates the 32-state bitmap
   width via SCE_STATIC_ASSERT at the bottom of this header.             #}
enum {{ csym_prefix }}{{ model.name }}_state_e {
    {% for state_name in model.states | sort %}
    {{ csym_prefix | upper }}{{ model.name | upper }}_STATE_{{ state_name | upper | replace('-', '_') | replace('.', '_') }},
    {% endfor %}
    {{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT
};
typedef enum {{ csym_prefix }}{{ model.name }}_state_e {{ csym_prefix }}{{ model.name }}_state_t;

{% if model.has_history_states %}
/* ── W3C SCXML 3.10: History pseudo-state enumeration ─────────────── */
{# History state IDs are not part of the regular state enum (parser.rs
   collapses transition.target to the resolved leaf), so they get their
   own enum here. The `_HIST_NONE` sentinel marks transitions whose
   target is a regular state — every transition_info_t carries this
   field, but only history-targeted transitions set it to a non-NONE
   value. Mirrors the per-history `history_<id>: Option<Vec<State>>`
   shape used by the Rust backend (state_machine.rs.jinja2:163). #}
enum {{ csym_prefix }}{{ model.name }}_history_e {
    {{ csym_prefix | upper }}{{ model.name | upper }}_HIST_NONE,
    {% for hid, _ in model.history_states | dictsort %}
    {{ csym_prefix | upper }}{{ model.name | upper }}_HIST_{{ hid | upper | replace('-', '_') | replace('.', '_') }},
    {% endfor %}
};
typedef enum {{ csym_prefix }}{{ model.name }}_history_e {{ csym_prefix }}{{ model.name }}_history_t;

{% endif %}
/* ── W3C SCXML 6.2: Event enumeration ─────────────────────────────── */
{# `_NONE` is the scheduler-polling default (W3C 6.2). Enumerated first so
   the underlying integer is 0, matching the C++ `Event::NONE` semantics
   (`process_transition.jinja2` peers compare against the unset event with
   the zero literal). #}
enum {{ csym_prefix }}{{ model.name }}_event_e {
    {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_NONE{{ "," if model.events }}
    {% for event_name in model.events | sort %}
    {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_{{ event_name | upper | replace('.', '_') | replace('-', '_') }}{{ "," if not loop.last }}
    {% endfor %}
};
typedef enum {{ csym_prefix }}{{ model.name }}_event_e {{ csym_prefix }}{{ model.name }}_event_t;

{% if event_payload_active %}
/* ── NL→IR Item C1 Path A: typed `_event.data` payload channel ─────── */
{{ event_payload_defs }}
{% endif %}
/* ── W3C SCXML 5.10: Event with metadata ──────────────────────────── */
{# Mirrors `StaticExecutionEngine<P>::EventWithMetadata` (sce/include/static).
   Strings are bounded char arrays sized via `sce/types.h` so the entire
   event record is value-typed and queue storage is statically reservable. #}
typedef struct {{ csym_prefix }}{{ model.name }}_event_with_meta {
    {{ csym_prefix }}{{ model.name }}_event_t event;
    char data[SCE_MAX_DATA_LEN];
    /* §scxml-C-1: `_event.origin` is the location the sending session
       published, so it is sized as a URI rather than as an id — see
       `sce_copy_bounded_origin` in `sce/types.h`. */
    char origin[SCE_MAX_URI_LEN];
    char send_id[SCE_MAX_ID_LEN];
    char type[SCE_MAX_EVENT_TYPE_LEN];
    char origin_type[SCE_MAX_ID_LEN];
    char invoke_id[SCE_MAX_ID_LEN];
    char target[SCE_MAX_ID_LEN];
{% if event_payload_active %}
    /* NL→IR Item C1 Path A: typed `_event.data` payload riding with the
       event through the queue (mirrors the Rust runtime's
       `EventWithMetadata<E, P>.payload`). The `tag` is `_PAYLOAD_NONE` for
       events raised without a typed payload, against which the native
       transition guards simply fail. */
    {{ event_payload_type }} payload;
{% endif %}
} {{ csym_prefix }}{{ model.name }}_event_with_meta_t;

/* ── Appendix D removeConflictingTransitions: Optimal enabled transition set ───────── */
{# Mirrors the C++ `TransitionInfo` struct defined inside the generated
   namespace (process_transition.jinja2 emits it per fixture). The C11
   layout adds a `exit_set` bitmap field — cpp re-computes the exit set
   inside `removeConflictingTransitions` via `ConflictResolutionHelper::
   computeExitSet`, but the C11 backend evaluates it once at collect
   time so conflict checks reduce to bitmap intersection (no helper
   class dispatch — jinja2-inline contract). The struct is fixture-local rather
   than runtime-shared because state_t is per-fixture.

   Fields are read by:
     - process_transition: writes (source, target, index, flags, exit_set)
     - remove_conflicting_transitions: reads exit_set + source for the
       depth-greedy preemption pass
     - handle_microstep: reads (source, target, index, flags) for the
       exit/body/entry sequence
   #}
typedef struct {{ csym_prefix }}{{ model.name }}_transition_info {
    {{ csym_prefix }}{{ model.name }}_state_t source;       /* W3C 3.13: source state of transition */
    {{ csym_prefix }}{{ model.name }}_state_t target;       /* W3C 3.13: target state (== source when targetless) */
    uint16_t index;                        /* W3C 3.13: per-source-state transition index for execute_transition_actions */
    bool is_internal;                      /* W3C 3.13: type="internal" (analyzer.rs has already collapsed not-proper-descendant cases to external) */
    bool is_targetless;                    /* W3C 5.9.2: no target — body fires, no state change */
    uint32_t exit_set;                     /* W3C App.D.2: states this transition would exit (computed at collect time) */
{% if model.has_history_states %}
    {{ csym_prefix }}{{ model.name }}_history_t history_target;  /* W3C 3.10: HIST_NONE for plain transitions; non-NONE = enter via enter_history_state (snapshot or default) */
{% endif %}
} {{ csym_prefix }}{{ model.name }}_transition_info_t;

/* ── Internal/external event queues — circular buffer ─────────────── */
typedef struct {{ csym_prefix }}{{ model.name }}_event_queue {
    {{ csym_prefix }}{{ model.name }}_event_with_meta_t buf[SCE_MAX_EVENTS];
    uint16_t head;
    uint16_t tail;
    uint16_t count;
} {{ csym_prefix }}{{ model.name }}_event_queue_t;

{% if model.needs_event_scheduler %}
/* ── W3C SCXML 6.2: Delayed-send queue entry ──────────────────────── */
{# Mirrors `SchedulerQueueCore::ScheduledEntry` from cpp
   `common/SendSchedulingHelper.h`. Unlike the cpp shape we drop the
   per-entry `eventData` payload until a fixture forces it (test579 +
   test580 use `<send delay event=...>` with no params/content), and we
   bound `send_id` rather than carry an std::string — same reasoning as
   the regular event queue's bounded id slots. The queue is kept sorted
   by `fire_time_ms` so `_tick` can early-exit at the first not-yet-
   ready entry; insertion is O(n) per event which is the same shape as
   the cpp `std::map<OrderKey, …>` for the small N we expect on MCU. #}
typedef struct {{ csym_prefix }}{{ model.name }}_scheduled_entry {
    uint64_t fire_time_ms;
    {{ csym_prefix }}{{ model.name }}_event_t event;
    char send_id[SCE_MAX_ID_LEN];
{% if model.needs_script_engine %}
    /* W3C SCXML 5.10: per-entry payload reference into the lua registry.
       LUA_NOREF (-2) when the <send> carries no <param>/<content>
       (delay-only fixtures schedule with no payload); a positive int when
       scheduled_push stashed a _pending_donedata table via
       luaL_ref(L, LUA_REGISTRYINDEX). The dispatch path in `_tick` reads
       the table back with lua_rawgeti, restores it onto the lua-side
       _pending_donedata slot so set_current_event can promote it to
       _event.data, and releases the registry slot via luaL_unref. Mirrors
       cpp `EventWithMetadata::data` per-entry carry — cpp ships a JSON
       string because its EventWithMetadata must cross engine-agnostic
       boundaries; C11's Lua 5.4-only engine makes the lua-native
       ref the round-trip-free equivalent of the same per-entry carry. */
    int payload_lua_ref;
{% endif %}
{% if model.has_parent_communication %}
    /* W3C SCXML 6.2 + 6.4 (test187): delayed `<send target="#_parent">` —
       the entry carries an event NAME (parent's enum is foreign to this
       SM) plus a `to_parent` flag so `_tick`'s promote loop can dispatch
       through `parent_dispatch` instead of the local `raise_external`
       path. When the child terminates before fire_time_ms is reached,
       `_tick`'s `is_in_final_state` early-return drops the pending entry
       silently — same observable as cpp's per-child `parentSendScheduler_`
       destructor cleaning up its std::map. The `event` enum slot stays
       zero-initialised (`{{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_NONE`) for these
       entries; only `to_parent_event` carries routing information. */
    bool to_parent;
    char to_parent_event[SCE_MAX_ID_LEN];
{% endif %}
} {{ csym_prefix }}{{ model.name }}_scheduled_entry_t;

typedef struct {{ csym_prefix }}{{ model.name }}_scheduled_queue {
    {{ csym_prefix }}{{ model.name }}_scheduled_entry_t buf[SCE_MAX_SCHEDULED];
    uint8_t count;
} {{ csym_prefix }}{{ model.name }}_scheduled_queue_t;
{% endif %}

/* ── Policy state (datamodel + transition tracking) ───────────────── */
{# C++ `{name}Policy` mutable members. E1 minimum keeps only the
   transition-tracking trio that `AOT_EXECUTE_TRANSITION` always writes.
   Datamodel variables, history slots, invoke tables, and parallel
   active-state vectors join in E2-E5 as their owning fixture lands. #}
typedef struct {{ csym_prefix }}{{ model.name }}_policy {
    {{ csym_prefix }}{{ model.name }}_state_t last_transition_source_state;
    /* W3C SCXML 3.13: Target captured at process_transition match time so
       handle_hierarchical_transition can run exit→body→entry without
       requiring a separate `current_state` shadow (active configuration
       lives in the bitmap `active`). Unused when last_transition_is_targetless. */
    {{ csym_prefix }}{{ model.name }}_state_t last_transition_target_state;
    bool last_transition_is_internal;
    bool last_transition_is_targetless;
    /* W3C SCXML 3.13: Transition body actions are deferred to
       execute_transition_actions so they run between the exit and entry
       chains (mirrors the C++ `lastTransitionIndex_` member used by
       `process_transition.jinja2`'s deferred dispatch). The pair
       (source_state, index) keys into the per-state switch the macro
       emits for fixtures that carry transition body actions. */
    uint16_t last_transition_index;
{% if model.has_history_states %}
    {# W3C SCXML 3.10: per-history-state snapshot. `_recorded` distinguishes
       "first entry, use default transition target" from "captured snapshot
       (possibly empty bitmap if all descendants exited)" — relying on the
       bitmap alone would conflate "never visited" with "visited but emptied",
       producing a default-target replay where W3C 3.10 mandates restore.
       Mirrors cpp `HistoryHelper`'s `std::optional<std::vector<State>>`
       shape (the optional's emptiness IS the not-yet-recorded marker). #}
    {% for hid, info in model.history_states | dictsort %}
    uint32_t history_{{ hid }}_snapshot;     /* {{ info.type }} snapshot of <history id="{{ hid }}"> children */
    bool history_{{ hid }}_recorded;
    {% endfor %}
{% endif %}
} {{ csym_prefix }}{{ model.name }}_policy_t;

{% if inline_kind_code %}
/* ── SCE Forge: Inline kind declarations ──────────────────────────── */
{# Free-standing emit (typedef enums + `static
   inline` functions). C11 has no nested types — both lookup enum
   typedefs and transform/condition/codec functions live at file
   scope, prefixed with the policy name to avoid identifier
   collisions across fixtures. The functions take `const <sm>_policy_t
   *_st` so their `_st->{snake}` member access mirrors cpp's implicit
   `this->`. Cpp emits the same fragment inside the Policy struct
   body (state_machine.jinja2 line 291); this is the C11 mirror at the
   only structurally-equivalent point — immediately after the policy
   typedef closes. #}
{{ inline_kind_code }}

{% endif %}
/* ── State machine instance ───────────────────────────────────────── */
{# Equivalent to `class {name} : StaticExecutionEngine<{name}Policy>` —
   in C11 the engine and policy fields are flattened into a single
   instance struct (the C++ template instantiates a per-fixture base
   class anyway, so there is no shared base layout to share).             #}
typedef struct {{ csym_prefix }}{{ model.name }} {
    /* W3C SCXML 3.2: configuration bitmap. Bit N (1u << N) corresponds
       to STATE_N in the enum above; entry sets the bit, exit clears it.
       Compound state entry sets both the parent ancestors and the
       descended initial leaf; <parallel> entry will set every region's
       leaf bit simultaneously. Mirrors cpp `StaticExecutionEngine::activeStates_`
       (std::set<State>) — single truth source for the configuration,
       no parallel `current_state` shadow that would drift in parallel
       fixtures. SCE_STATIC_ASSERT at the bottom of the header pins the
       state count below the bitmap width (32 today, multi-word array
       lands when a fixture forces it). */
    uint32_t active;
{% if event_payload_active %}
    /* NL→IR Item C1 Path A: the current event's typed `_event.data`
       payload, copied from the dequeued event by `process_event_queues`
       and read by native transition guards
       (`sm->pending_payload.as.<event>.<field>`). Mirrors the Rust
       policy's `pending_payload` field. */
    {{ event_payload_type }} pending_payload;
{% endif %}
    {{ csym_prefix }}{{ model.name }}_event_queue_t internal_queue;   /* W3C 3.12.1: high-priority FIFO */
    {{ csym_prefix }}{{ model.name }}_event_queue_t external_queue;   /* W3C 3.12.1: low-priority FIFO  */
{% if model.needs_event_scheduler %}
    {{ csym_prefix }}{{ model.name }}_scheduled_queue_t scheduled_queue;  /* W3C 6.2: delayed <send> queue, drained by _tick */
    /* §scxml-6.2.2: where this machine reads "now" from. Zero-initialised by
       `_init`'s memset, which is the link-time monotonic default; a host that
       owns time installs its own through `_init_with_clock`. */
    sce_clock_t clock;
    /* §scxml-3.13: the reading `clock` gave when the current turn began, valid
       only while `in_turn`. See `_set_clock` in the .c for what reading the
       clock per `<send>` instead did to two of them. */
    uint64_t turn_now_ms;
    bool in_turn;
{% endif %}
    {{ csym_prefix }}{{ model.name }}_policy_t policy;
    bool is_running;
    bool transition_taken;
    /* W3C SCXML 3.1.2: external events no transition matched, and the most
       recent of them. `has_discarded_event` is separate because the event
       enum's zero value is a real event and cannot stand in for "none". */
    uint32_t discarded_external_events;
    {{ csym_prefix }}{{ model.name }}_event_t last_discarded_event;
    bool has_discarded_event;
    /* W3C SCXML 3.12.2: `error.*` events this engine raised that no transition
       matched, and the most recent of them. `has_unhandled_error` is separate
       for the same reason as above: the event enum's zero value is a real
       event and cannot stand in for "none". */
    uint32_t unhandled_error_events;
    {{ csym_prefix }}{{ model.name }}_event_t last_unhandled_error;
    bool has_unhandled_error;
    /* W3C SCXML 3.12.2 from the other side: the drain is running a transition
       an `error.*` event selected, which is the state in which a newly raised
       error is a link in a chain rather than a first failure; how long that
       chain is; and what was refused because of it. See
       `_error_cascade_events` below. */
    bool handling_error_event;
    uint32_t error_cascade_depth;
    uint32_t error_cascade_events;
    {{ csym_prefix }}{{ model.name }}_event_t last_error_cascade_event;
    bool has_error_cascade_event;
    /* W3C SCXML 3.13: macrosteps stopped at SCE_MAX_MACROSTEP_MICROSTEPS with
       the chain still going, the state the drain was in when that last
       happened, and whether the macrostep now in progress is already one of
       them. `has_truncated_macrostep` is separate because the state enum's
       zero value is a real state; `macrostep_truncated` exists because the
       drain is reached more than once per macrostep, and without it each
       caller would get a fresh budget. `macrostep_microsteps_taken` is the
       budget itself, and it lives here rather than in either drain because
       Appendix D's inner loop is one loop: the eventless branch and the
       internal-event branch take turns inside a single macrostep, so a counter
       local to either bounds only half of it. See `_truncated_macrosteps`
       below. */
    uint32_t truncated_macrosteps;
    {{ csym_prefix }}{{ model.name }}_state_t last_truncated_macrostep_state;
    bool has_truncated_macrostep;
    bool macrostep_truncated;
    uint32_t macrostep_microsteps_taken;
    char current_event_invoke_id[SCE_MAX_ID_LEN];
    /* W3C SCXML 5.10 / C.1.1: the id the processor generates for THIS
       session, and the address that reaches it. Issued in `_init` rather
       than baked at codegen time, because the requirement names the id of
       the current SESSION and a document-derived value names the document:
       two instances of one machine are two sessions, and giving them one
       id makes their published `_ioprocessors` locations equal, so a
       `<send>` addressed to one is a send addressed to either. Fixed
       buffers — the profile allocates nothing.

       The id buffer is sized from the machine name it is built out of,
       not from `SCE_MAX_ID_LEN`: names of synthesised invoke children
       (`<doc>__sce_synth_invoke__<invokeid>`) already run past 64
       characters, and a shared cap would silently truncate the tail —
       which is where the ordinal that distinguishes two sessions lives.
       20 digits is `unsigned long`'s widest decimal form, and the
       `sizeof` of the literal carries the terminator. */
    char session_id[sizeof("{{ model.name | escape_c }}_session_") + 20u];
    char scxml_location[sizeof("sce://scxml/{{ model.name | escape_c }}_session_") + 20u];
    void (*completion_callback)(void *user_data);
    void *completion_callback_user_data;
    {% if (model.invokes | scxml_family) or (model.invokes | unsupported) %}
    /* W3C SCXML 6.4: pending invokes deferred to macrostep end + per-site
       child SM instance. cpp uses `std::vector<PendingInvoke>` and
       `std::shared_ptr<ChildSM>`; C11 mirrors with the bounded queue
       from `sce/invoke.h` and value-typed embedded child structs.
       `_active` flips on at execute-pending-invokes, off at destroy /
       cancel. */
    sce_invoke_pending_queue_t pending_invokes;
    {% for invoke_info in model.invokes | scxml %}
    {{ csym_prefix }}{{ invoke_info.child_name }}_t child_{{ invoke_info.field_suffix }};
    bool child_{{ invoke_info.field_suffix }}_active;
    /* W3C SCXML 6.4 / 6.3.1: spawn-time invoke id stamped from
       `sce_invoke_pending_t::invoke_id` so `_drive_active_children`
       can fill `done.invoke.invoke_id` even when the child SM itself
       does not carry parent-routing fields (no `<send target="#_parent">`
       in the child means no `invoke_id` slot on the child struct). */
    char child_{{ invoke_info.field_suffix }}_invoke_id[SCE_MAX_ID_LEN];
    {% endfor %}
    {% for invoke_info in model.invokes | hybrid %}
    /* W3C SCXML 6.4 (test216/530): hybrid invoke child slot. Identical
       struct shape to the static-scxml case — the only runtime
       difference is the eval-validation prelude in
       `execute_pending_invokes` (cpp `test216_sm.inl:166-176` mirror).
       The child SM is the trivial immediate-final stub that sce-build
       writes via `generate_hybrid_child_scxmls`. */
    {{ csym_prefix }}{{ invoke_info.child_name }}_t child_{{ invoke_info.field_suffix }};
    bool child_{{ invoke_info.field_suffix }}_active;
    char child_{{ invoke_info.field_suffix }}_invoke_id[SCE_MAX_ID_LEN];
    {% endfor %}
    {% endif %}
    {% if model.needs_script_engine %}
    lua_State *L;                                    /* W3C 5.10: ECMAScript datamodel */
    /* W3C SCXML C.2.3: inbound BasicHTTP endpoint serving this machine,
       declared by the deployment before `_init` through
       `_set_basic_http_access_uri`. The address belongs to whoever runs the
       listener, so the machine takes it from there rather than baking one in.
       Empty means no such endpoint is deployed, and no BasicHTTP entry is
       published in `_ioprocessors` — a document that reads
       `_ioprocessors['basichttp'].location` then finds nil rather than an
       address nothing answers on. */
    char basic_http_access_uri[SCE_MAX_URI_LEN];
    {% endif %}
    {% if model.has_parent_communication %}
    /* W3C SCXML 6.4: cross-machine event dispatch when this SM is
       invoked as a child. The parent's `execute_pending_invokes` calls
       `_init_with_parent`, which stamps these fields BEFORE the
