/* ── W3C SCXML App.D: optimal enabled transition set helpers ──────── */
{# Mirrors cpp ParallelTransitionHelper + ConflictResolutionHelper. The
   C11 backend inlines the algorithm bodies here (T3 lock-in: no helper
   class dispatch). compute_exit_set is called at collect time so each
   transition_info_t carries its exit_set as a uint32_t — conflict
   detection then reduces to bitmap intersection plus a small parallel-
   ancestor scan, no per-pair LCA recomputation. #}

/* W3C SCXML 3.12: Least Common Compound Ancestor (findLCCA per the
   Algorithms appendix, which is the function `getTransitionDomain` calls
   for external transitions whose source/target hierarchy needs the
   full proper-ancestor walk).
   Walks `getProperAncestors(source)` and returns the first ancestor that
   contains `target` as a STRICT descendant. The strict check is what
   distinguishes findLCCA from the older single-pair `findLCA`: when
   target is itself an ancestor of source (e.g. test579's s03→s0),
   findLCA collapses LCA onto target, so exit set computation excludes
   target's onexit and Var1 never increments — observably wrong. The
   strict-descendant check skips that case and walks one level higher,
   producing the W3C-correct domain (root/no_lca when target sits on
   source's own ancestor chain), at which point compute_exit_set's
   no-lca branch exits the entire configuration so the target gets a
   fresh entry chain (including its onentry and `<initial>` content).
   Returns has_lca=false in two cases: (a) the two states share no
   common ancestor (top-level siblings under an implicit root) and
   (b) target lies on source's ancestor chain (target == anc, never
   strict-descendant). compute_exit_set treats both with the same
   "exit everything active" semantics, matching cpp
   StaticExecutionEngine::handleHierarchicalTransition's no-LCA branch. */
static SCE_C_UNUSED {{ model.name }}_state_t find_lcca({{ model.name }}_state_t source,
                                                        {{ model.name }}_state_t target,
                                                        bool *out_has) {
    bool hp = false;
    {{ model.name }}_state_t cur = state_get_parent(source, &hp);
    while (hp) {
        if (is_descendant_of(target, cur)) {
            *out_has = true;
            return cur;
        }
        cur = state_get_parent(cur, &hp);
    }
    *out_has = false;
    return source;
}

/* W3C SCXML App.D.2: exit set per transition (cpp ParallelTransitionHelper::
   computeStatesToExit mirror). The bitmap returned is the actual set of
   states that will exit when this transition fires, and it doubles as the
   conflict-resolution input — bigger sets mean bigger intersections, so
   removeConflictingTransitions catches every parallel-ancestor conflict
   without a separate ancestor-chain pass.
   - targetless (W3C 5.9.2): empty — body fires, no state change.
   - internal-to-compound-descendant (W3C 3.13): empty. Source stays
     active; intermediate active descendants exit/re-enter via the entry
     phase walk (test505's `<transition type="internal" target="s11">`
     exits s11 so its onexit assigns Var2 each pass).
   - else: active descendants of LCA(source, target) — the LCA itself
     is included only when source==LCA (external self-loop). Cross-
     compound asymmetric transitions (target not a sibling of source) and
     parallel-region transitions both fall through this path, so test403c
     and test505/506 share one implementation. */
static SCE_C_UNUSED uint32_t compute_exit_set(uint32_t active,
                                              {{ model.name }}_state_t source,
                                              {{ model.name }}_state_t target,
                                              bool is_internal, bool is_targetless) {
    if (is_targetless) {
        return 0u;
    }
    bool internal_to_descendant = is_internal
        && state_is_compound(source) && !state_is_parallel(source)
        && is_descendant_of(target, source);
    {{ model.name }}_state_t lca;
    bool has_lca;
    if (internal_to_descendant) {
        lca = source;
        has_lca = true;
    } else {
        lca = find_lcca(source, target, &has_lca);
    }
    if (!has_lca) {
        /* Cross-hierarchy transition (source and target are top-level
           siblings under an implicit root) — exit the entire active
           configuration. cpp StaticExecutionEngine::handleHierarchicalTransition
           walks oldState (= currentState_, the deepest active leaf) up
           to the root; the bitmap equivalent is `active` itself, since
           every active state is on some leaf's ancestor chain. */
        return active;
    }
    bool should_exit_source = !is_internal && (source == lca);
    uint32_t exit_set = 0u;
    for (uint32_t i = 0u; i < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++i) {
        if ((active & ((uint32_t)1u << i)) == 0u) {
            continue;
        }
        {{ model.name }}_state_t s = ({{ model.name }}_state_t)i;
        if (s == lca) {
            if (should_exit_source) {
                exit_set |= state_bit(s);
            }
            continue;
        }
        if (is_descendant_of(s, lca)) {
            exit_set |= state_bit(s);
        }
    }
    return exit_set;
}

/* W3C SCXML App.D removeConflictingTransitions — full algorithm mirror.
   Walks the input list in document order; each new transition t1 is
   compared against the already-filtered list. On conflict, the
   preemption rule decides which side survives:
     - t1.target == t2.source         → drop t2 (t1 enters t2's source, t2's exit absorbed)
     - t2.target == t1.source         → drop t1 (reverse)
     - t1.source descends from t2.src → drop t2 (t1 deeper, preempts)
     - else                           → drop t1 (t2 deeper or equal-depth-doc-prior)
   Conflict criteria (any one):
     a) exit-set bitmap intersection
     b) target/source equality (handles dup parent transitions reached
        from converging region leaves — test403b adversarial fixture)
     c) one transition exits a parallel ancestor of the other's source,
        unless the other is an internal self-loop (W3C 3.13 exception)
   Mirrors cpp ConflictResolutionAlgorithms::removeConflictingTransitions.
   Working buffer reuses the SCE_MAX_ENABLED_TRANSITIONS cap so no
   heap traffic; final result copied back into the caller's list. */
static SCE_C_UNUSED uint8_t remove_conflicting_transitions({{ model.name }}_transition_info_t *list,
                                                            uint8_t count) {
    {{ model.name }}_transition_info_t filtered[SCE_MAX_ENABLED_TRANSITIONS];
    uint8_t filtered_count = 0u;

    for (uint8_t k = 0u; k < count; ++k) {
        {{ model.name }}_transition_info_t t1 = list[k];
        bool t1_preempted = false;
        bool to_remove[SCE_MAX_ENABLED_TRANSITIONS];
        for (uint8_t r = 0u; r < (uint8_t)SCE_MAX_ENABLED_TRANSITIONS; ++r) {
            to_remove[r] = false;
        }

        for (uint8_t i = 0u; i < filtered_count; ++i) {
            {{ model.name }}_transition_info_t *t2 = &filtered[i];
            bool has_conflict = false;

            /* (a) exit-set intersection */
            if ((t1.exit_set & t2->exit_set) != 0u) {
                has_conflict = true;
            }

            /* (b) target/source equality — dedups duplicate parent
                  transitions reached from converging bubble paths. */
            if (!has_conflict) {
                if (t1.target == t2->source || t2->target == t1.source) {
                    has_conflict = true;
                }
            }

            /* (c) t1 exits a <parallel> ancestor of t2->source.
                  Internal self-loops (source==target with type=internal)
                  are exempt — they do not really exit any state. */
            if (!has_conflict && !(t2->is_internal && t2->source == t2->target)) {
                for (uint32_t j = 0u; j < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++j) {
                    if ((t1.exit_set & ((uint32_t)1u << j)) == 0u) {
                        continue;
                    }
                    {{ model.name }}_state_t s = ({{ model.name }}_state_t)j;
                    if (state_is_parallel(s) && is_descendant_of(t2->source, s)) {
                        has_conflict = true;
                        break;
                    }
                }
            }

            /* (c) reverse — t2 exits a <parallel> ancestor of t1.source. */
            if (!has_conflict && !(t1.is_internal && t1.source == t1.target)) {
                for (uint32_t j = 0u; j < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++j) {
                    if ((t2->exit_set & ((uint32_t)1u << j)) == 0u) {
                        continue;
                    }
                    {{ model.name }}_state_t s = ({{ model.name }}_state_t)j;
                    if (state_is_parallel(s) && is_descendant_of(t1.source, s)) {
                        has_conflict = true;
                        break;
                    }
                }
            }

            if (has_conflict) {
                if (t1.target == t2->source) {
                    to_remove[i] = true;
                } else if (t2->target == t1.source) {
                    t1_preempted = true;
                } else if (is_descendant_of(t1.source, t2->source)) {
                    to_remove[i] = true;
                } else {
                    t1_preempted = true;
                }
            }
        }

        if (!t1_preempted) {
            uint8_t kept = 0u;
            for (uint8_t i = 0u; i < filtered_count; ++i) {
                if (!to_remove[i]) {
                    if (kept != i) {
                        filtered[kept] = filtered[i];
                    }
                    kept++;
                }
            }
            if (kept < (uint8_t)SCE_MAX_ENABLED_TRANSITIONS) {
                filtered[kept] = t1;
                filtered_count = (uint8_t)(kept + 1u);
            } else {
                filtered_count = kept;
            }
        }
    }

    for (uint8_t i = 0u; i < filtered_count; ++i) {
        list[i] = filtered[i];
    }
    return filtered_count;
}

/* W3C SCXML 3.13: Per-state collection switch. Mirrors the C++
   `tryTransitionInState` helper (process_transition.jinja2 collect mode):
   evaluate every transition in the state in document order, push the
   first match onto the enabled list, then break out of the do-while so
   later transitions in the same state are not evaluated (preemption).
   Returns true iff this state contributed a transition.
   `(void)sm` and `(void)event` keep the helper warning-free for fixtures
   whose transition graph is sparse — the casts are no-ops once the
   switch arms reference sm->active (compute_exit_set) and `event`
   (matcher branches). */
static bool try_match_in_state({{ model.name }}_t *sm,
                                {{ model.name }}_state_t check_state,
                                {{ model.name }}_event_t event,
                                {{ model.name }}_transition_info_t *out_list,
                                uint8_t *out_count) {
    (void)sm;
    (void)event;
    (void)out_list;
    uint8_t before = *out_count;
    switch (check_state) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.transitions %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        do {
            {% for trans in state.transitions %}
            {{ emit_transition_match_check(trans) }} {
            {% if trans.cond %}
            {% if trans.is_pure_in_predicate %}
                /* W3C SCXML 3.13 + 5.9.2: cond="{{ trans.cond | escape_c }}" pure
                   In() predicate — native C lower via `to_in_predicate_c11`
                   filter (mirrors cpp `parser::convert_in_to_cpp` of `this->
                   isStateActive("...")`). Routes In('xx') → `<machine>_in_state(
                   sm, <MACHINE>_STATE_<XX>)` so the chunk is compiler-checked
                   instead of runtime-resolved through a lua trampoline (T3
                   inline-only lock-in). The filter also unblocks pure-In conds
                   in fixtures that don't otherwise need script-engine. */
                if ({{ trans.cond | to_in_predicate_c11(model.name, model.history_states | list) }}) {
                    {{ emit_transition_body(trans) }}
                }
            {% elif model.needs_script_engine %}
                /* W3C SCXML 3.13: cond="{{ trans.cond | escape_c }}" (lua eval) */
                bool _trans_pass;
{{ se.lua_eval_guard(trans.cond, '_trans_pass') }}
                if (_trans_pass) {
                    {{ emit_transition_body(trans) }}
                }
            {% else %}
                /* W3C SCXML 3.13: cond="{{ trans.cond | escape_c }}" (native C
                   lower; mirrors cpp process_transition.jinja2 else-branch — C
                   compiler dead-code-eliminates `if (false)` arms). */
                if ({{ trans.cond }}) {
                    {{ emit_transition_body(trans) }}
                }
            {% endif %}
            {% else %}
                {{ emit_transition_body(trans) }}
            {% endif %}
            }
            {% endfor %}
        } while (0);
        break;
    {% endif %}
    {% endfor %}
    default:
        break;
    }
    return *out_count > before;
}

/* W3C SCXML App.D: optimal-enabled-set selection. Two branches mirror
   cpp processTransition's eventless / external split:
   - eventless: walk every active state in document order (enum-value
     order = alphabetic = doc-order proxy), no parent bubbling. cpp
     selectEventlessTransitions evaluates every active state including
     compound and parallel ancestors; the C switch's `default: break;`
     arm short-circuits ancestors that declare no transitions.
   - external: walk every active leaf, bubble up the parent chain, stop
     at the first match per leaf. The same parent transition reached
     from two converging bubble paths gets pushed twice — conflict
     resolution dedups via exit-set intersection (test403b adversarial
     fixture pins this dedup behaviour).
   Compound and parallel ancestors are excluded as candidate leaves; a
   future fixture forcing done.state events on a compound/parallel target
   relaxes that filter alongside the cpp `isDoneStateEvent` mirror. */
static bool process_transition({{ model.name }}_t *sm,
                                {{ model.name }}_event_t event,
                                {{ model.name }}_transition_info_t *out_list,
                                uint8_t *out_count) {
    *out_count = 0u;
    sm->transition_taken = false;
    if (event == {{ model.name | upper }}_EVENT_NONE) {
        for (uint32_t i = 0u; i < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++i) {
            if ((sm->active & ((uint32_t)1u << i)) == 0u) {
                continue;
            }
            (void)try_match_in_state(sm, ({{ model.name }}_state_t)i, event, out_list, out_count);
        }
    } else {
        for (uint32_t i = 0u; i < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++i) {
            if ((sm->active & ((uint32_t)1u << i)) == 0u) {
                continue;
            }
            {{ model.name }}_state_t leaf = ({{ model.name }}_state_t)i;
            if (state_is_compound(leaf) || state_is_parallel(leaf)) {
                continue;
            }
            {{ model.name }}_state_t check_state = leaf;
            while (true) {
                if (try_match_in_state(sm, check_state, event, out_list, out_count)) {
                    break;
                }
                bool _hp;
                {{ model.name }}_state_t _p = state_get_parent(check_state, &_hp);
                if (!_hp) {
                    break;
                }
                check_state = _p;
            }
        }
    }
    if (*out_count > 0u) {
        sm->transition_taken = true;
        return true;
    }
    return false;
}

{% if model.has_history_states %}
/* W3C SCXML 3.10: snapshot every history state whose parent is exiting.
   For each `<history>` child of an exiting parent, capture either the
   parent's active immediate child (shallow) or the parent's active
   leaf descendants (deep). Mirrors cpp HistoryHelper::captureHistory.
   Called before the exit loop applies bit-clears so the active bitmap
   still reflects the pre-exit configuration. The `_recorded` flag flips
   to `true` even when the captured bitmap is empty — that is what
   distinguishes "never visited" (default-target replay) from "visited
   but currently empty" (restore-as-empty), per W3C 3.10. */
static void capture_histories({{ model.name }}_t *sm, uint32_t exit_union) {
    {% for hid, info in model.history_states | dictsort %}
    {% set parent_enum = model.name | upper ~ '_STATE_' ~ (info.parent | upper | replace('-', '_') | replace('.', '_')) %}
    /* <history id="{{ hid }}" type="{{ info.type }}"> child of {{ info.parent }} */
    if ((exit_union & state_bit({{ parent_enum }})) != 0u
        && config_in(sm->active, {{ parent_enum }})) {
        uint32_t snap = 0u;
        for (uint32_t i = 0u; i < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++i) {
            if ((sm->active & ((uint32_t)1u << i)) == 0u) continue;
            {{ model.name }}_state_t s = ({{ model.name }}_state_t)i;
            if (s == {{ parent_enum }}) continue;
            {% if info.type == 'shallow' %}
            /* shallow: capture the parent's active immediate child only.
               Compound-state semantics guarantee at most one such child;
               <parallel> would relax that to all region children but the
               first parallel+history fixture forces the generalisation. */
            bool _hp;
            {{ model.name }}_state_t _p = state_get_parent(s, &_hp);
            if (_hp && _p == {{ parent_enum }}) {
                snap |= state_bit(s);
            }
            {% else %}
            /* deep: capture every active descendant that has no further
               active children (= currently a leaf in the active config).
               enter_state_recursive's config_enter_chain re-establishes
               the ancestor bits on restore, so storing leaves alone is
               sufficient. */
            if (!is_descendant_of(s, {{ parent_enum }})) continue;
            bool has_active_child = false;
            for (uint32_t c = 0u; c < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++c) {
                if (c == i || (sm->active & ((uint32_t)1u << c)) == 0u) continue;
                bool _hp;
                {{ model.name }}_state_t _p = state_get_parent(({{ model.name }}_state_t)c, &_hp);
                if (_hp && _p == s) { has_active_child = true; break; }
            }
            if (!has_active_child) snap |= state_bit(s);
            {% endif %}
        }
        sm->policy.history_{{ hid }}_snapshot = snap;
        sm->policy.history_{{ hid }}_recorded = true;
    }
    {% endfor %}
}

/* W3C SCXML 3.10: enter a history pseudo-state — restore the recorded
   snapshot if present, otherwise execute the history's default
   `<transition>` executable content and enter its default target.
   Mirrors cpp HistoryHelper::buildEntryChain. enter_state_recursive is
   idempotent so any ancestor bits already set by an earlier transition
   are not double-fired. The default-actions branch only runs on the
   first entry to the parent state (recorded=false); once a snapshot has
   been captured, subsequent re-entries restore it verbatim, matching
   the W3C "default transition body executes only when no stored history"
   contract that test579 verifies. */
static void enter_history_state({{ model.name }}_t *sm, {{ model.name }}_history_t hid) {
    switch (hid) {
    {% for hid, info in model.history_states | dictsort %}
    case {{ model.name | upper }}_HIST_{{ hid | upper | replace('-', '_') | replace('.', '_') }}:
        if (sm->policy.history_{{ hid }}_recorded) {
            for (uint32_t i = 0u; i < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++i) {
                if ((sm->policy.history_{{ hid }}_snapshot & ((uint32_t)1u << i)) == 0u) continue;
                enter_state_recursive(sm, ({{ model.name }}_state_t)i);
            }
        } else {
            {% for action in info.default_actions %}
            {{ emit_action(action) }}
            {% endfor %}
            enter_state_recursive(sm, {{ model.name | upper }}_STATE_{{ info.default_target | upper | replace('-', '_') | replace('.', '_') }});
        }
        break;
    {% endfor %}
    default:
        break;
    }
}
{% endif %}

/* W3C SCXML App.D.2: Microstep execution.
   - exit:  union of every selected transition's exit_set, walked in
            reverse enum-value order (= reverse doc-order proxy) so the
            deepest active descendant exits first; multi-leaf <parallel>
            configurations drain every region simultaneously
   - body:  transitions sorted by source enum-value, executed in order
   - entry: transitions sorted by target enum-value, enter_state_recursive
            is idempotent so duplicate / converging targets collapse
   Mirrors cpp StaticExecutionEngine::executeMicrostep +
   ParallelTransitionHelper::computeStatesToExit / sortTransitionsBySource /
   sortTransitionsByTarget, inlined into one function per the T3 lock-in.
   compute_exit_set is the LCA-based cpp mirror so the pre-collected
   exit_set bitmap drives both conflict resolution and the actual exit
   walk in one pass. Sort keys use enum-value order — alphabetic sort
   is the doc-order proxy across every currently registered fixture
   (s01p > s01p1 > s01p11 ordering); a fixture whose alphabetic order
   diverges from doc-order will force a codegen-time doc-order table
   (cpp's StateRegistry mirror). */
static void handle_microstep({{ model.name }}_t *sm,
                             {{ model.name }}_transition_info_t *list,
                             uint8_t count) {
    if (count == 0u) {
        return;
    }

    uint32_t exit_union = 0u;
    for (uint8_t i = 0u; i < count; ++i) {
        exit_union |= list[i].exit_set;
    }
{% if model.has_history_states %}
    /* W3C SCXML 3.10: snapshot history states before exit clears any
       bits — capture sees the pre-exit active configuration. */
    capture_histories(sm, exit_union);
{% endif %}
    for (uint32_t bit = (uint32_t){{ model.name | upper }}_STATE_COUNT; bit > 0u; --bit) {
        {{ model.name }}_state_t s = ({{ model.name }}_state_t)(bit - 1u);
        if ((exit_union & state_bit(s)) == 0u) {
            continue;
        }
        if ((sm->active & state_bit(s)) == 0u) {
            continue;
        }
        execute_exit_actions(sm, s);
        sm->active &= ~state_bit(s);
    }

    /* W3C App.D.2 Step 3: bodies in document order. */
    for (uint8_t i = 1u; i < count; ++i) {
        {{ model.name }}_transition_info_t key = list[i];
        uint8_t j = i;
        while (j > 0u && (uint32_t)list[j - 1u].source > (uint32_t)key.source) {
            list[j] = list[j - 1u];
            j--;
        }
        list[j] = key;
    }
    for (uint8_t i = 0u; i < count; ++i) {
        sm->policy.last_transition_source_state = list[i].source;
        sm->policy.last_transition_target_state = list[i].target;
        sm->policy.last_transition_is_internal = list[i].is_internal;
        sm->policy.last_transition_is_targetless = list[i].is_targetless;
        sm->policy.last_transition_index = list[i].index;
        execute_transition_actions(sm);
    }

    /* W3C App.D.2 Step 4-5: entries in document order. */
    for (uint8_t i = 1u; i < count; ++i) {
        {{ model.name }}_transition_info_t key = list[i];
        uint8_t j = i;
        while (j > 0u && (uint32_t)list[j - 1u].target > (uint32_t)key.target) {
            list[j] = list[j - 1u];
            j--;
        }
        list[j] = key;
    }
    for (uint8_t i = 0u; i < count; ++i) {
        if (list[i].is_targetless) {
            continue;
        }
{% if model.has_history_states %}
        if (list[i].history_target != {{ model.name | upper }}_HIST_NONE) {
            enter_history_state(sm, list[i].history_target);
        } else {
            enter_state_recursive(sm, list[i].target);
        }
{% else %}
        enter_state_recursive(sm, list[i].target);
{% endif %}
    }
}

/* ── W3C SCXML 6.2: External-facing raise APIs ────────────────────── */

void {{ model.name }}_raise({{ model.name }}_t *sm,
                            const {{ model.name }}_event_with_meta_t *evt) {
    event_queue_push(&sm->internal_queue, evt);
}

void {{ model.name }}_raise_external({{ model.name }}_t *sm,
                                     const {{ model.name }}_event_with_meta_t *evt) {
    event_queue_push(&sm->external_queue, evt);
}

{% if model.needs_event_scheduler %}
/* ── W3C SCXML 6.2: Delayed-send queue helpers ────────────────────── */

{# Sorted insert keyed on `fire_time_ms`. cpp `SchedulerQueueCore` uses a
   `std::map` whose ordering key is `(fireTime, sequenceNum)`; the C11
   mirror keeps the same fire-time ordering and breaks ties by insertion
   order (the linear scan stops at the first strictly-greater entry, so
   equal-time entries fall in FIFO order — same observable outcome as
   cpp's monotonic `sequenceCounter_`). Overflow raises error.execution
   onto the internal queue per W3C 6.2 (the spec requires a discoverable
   error rather than silent loss); the entry being inserted is the one
   dropped, matching the bounded-resource contract documented at the
   `SCE_MAX_SCHEDULED` define site in `sce/types.h`. #}
static void scheduled_push({{ model.name }}_t *sm,
                           uint64_t fire_time_ms,
                           {{ model.name }}_event_t event,
                           const char *send_id
{%- if model.needs_script_engine %},
                           int payload_lua_ref
{%- endif %}) {
    if (sm->scheduled_queue.count >= (uint8_t)SCE_MAX_SCHEDULED) {
{% if model.needs_script_engine %}
        /* W3C SCXML 6.2: capacity overflow drops the new entry; the caller
           already stashed any payload table into the lua registry so we
           must release it here to avoid a leak that would survive until
           lua_close (and the ref counter would still consume registry
           slots). cpp's bounded-resource path raises the same
           error.execution event but cleans up its EventWithMetadata
           automatically via std::map's erase semantics; C11 mirrors the
           cleanup explicitly here. */
        if (payload_lua_ref != LUA_NOREF) {
            luaL_unref(sm->L, LUA_REGISTRYINDEX, payload_lua_ref);
        }
{% endif %}
        {{ model.name }}_event_with_meta_t _err_evt;
        memset(&_err_evt, 0, sizeof(_err_evt));
        _err_evt.event = {{ model.name | upper }}_EVENT_ERROR_EXECUTION;
        {{ model.name }}_raise(sm, &_err_evt);
        return;
    }

    /* Find insertion index keeping the array sorted by fire_time_ms. */
    uint8_t pos = sm->scheduled_queue.count;
    for (uint8_t i = 0; i < sm->scheduled_queue.count; ++i) {
        if (fire_time_ms < sm->scheduled_queue.buf[i].fire_time_ms) {
            pos = i;
            break;
        }
    }

    /* Shift later entries one slot right. */
    for (uint8_t j = sm->scheduled_queue.count; j > pos; --j) {
        sm->scheduled_queue.buf[j] = sm->scheduled_queue.buf[j - 1u];
    }

    {{ model.name }}_scheduled_entry_t *slot = &sm->scheduled_queue.buf[pos];
    slot->fire_time_ms = fire_time_ms;
    slot->event = event;
    if (send_id != NULL) {
        strncpy(slot->send_id, send_id, (size_t)SCE_MAX_ID_LEN - 1u);
        slot->send_id[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
    } else {
        slot->send_id[0] = '\0';
    }
{% if model.needs_script_engine %}
    slot->payload_lua_ref = payload_lua_ref;
{% endif %}
    sm->scheduled_queue.count++;
}

/* Pop the head entry iff its fire time has elapsed (compared against `now_ms`).
   Returns true and writes the matured entry into `out` when ready, false otherwise.
   Mirrors cpp `SchedulerQueueCore::popReadyEvent(now, …)` — the head element
   is always the earliest-firing thanks to `scheduled_push`'s sorted insert. */
static bool scheduled_pop_ready({{ model.name }}_t *sm,
                                uint64_t now_ms,
                                {{ model.name }}_scheduled_entry_t *out) {
    if (sm->scheduled_queue.count == 0u) {
        return false;
    }
    if (sm->scheduled_queue.buf[0].fire_time_ms > now_ms) {
        return false;
    }

    *out = sm->scheduled_queue.buf[0];
    for (uint8_t k = 1; k < sm->scheduled_queue.count; ++k) {
        sm->scheduled_queue.buf[k - 1u] = sm->scheduled_queue.buf[k];
    }
    sm->scheduled_queue.count--;
    return true;
}

/* W3C SCXML 6.3 (test208/210): remove every scheduled entry whose send_id
   matches `send_id`. The cpp engine routes `<cancel>` to
   `StaticExecutionEngine::cancelEvent` → `PullScheduler::cancelEvent`
   (`sce/include/core/PullScheduler.h`) which iterates the std::map and
   erases matches; C11 walks the bounded array in place per T3 lock-in.
   Multiple entries can share a send_id (cpp guarantees uniqueness via
   `SendHelper::generateSendId`, but a fixture-supplied static `id="foo"`
   could repeat across a parallel region). The compaction loop tolerates
   that — it advances `pos` only on a non-match so the buffer stays
   contiguous. NULL or empty send_id is a no-op (matches cpp's
   `if (sendid.empty()) return`). The action is silent on a miss, mirroring
   the spec: W3C 6.3 doesn't require an error if the send_id is unknown
   (cpp's `cancelEvent` ignores the result of `erase`). */
static SCE_C_UNUSED void scheduled_cancel({{ model.name }}_t *sm, const char *send_id) {
    if (send_id == NULL || send_id[0] == '\0') {
        return;
    }
    uint8_t pos = 0u;
    for (uint8_t i = 0u; i < sm->scheduled_queue.count; ++i) {
        if (strcmp(sm->scheduled_queue.buf[i].send_id, send_id) != 0) {
            if (pos != i) {
                sm->scheduled_queue.buf[pos] = sm->scheduled_queue.buf[i];
            }
            pos++;
        }
{% if model.needs_script_engine %}
        else if (sm->scheduled_queue.buf[i].payload_lua_ref != LUA_NOREF) {
            /* W3C SCXML 6.3: matching entries are dropped via compaction;
               release the lua registry slot here so the cancelled send's
               payload table is reclaimable before lua_close. cpp routes
               cancellation through `PullScheduler::cancelEvent` which
               erases the std::map entry and lets the contained
               EventWithMetadata's destructor handle teardown — C11 mirrors
               that lifecycle ownership explicitly. */
            luaL_unref(sm->L, LUA_REGISTRYINDEX,
                       sm->scheduled_queue.buf[i].payload_lua_ref);
        }
{% endif %}
    }
    sm->scheduled_queue.count = pos;
}
{% endif %}

/* ── RTC core (mirrors StaticExecutionEngine<Policy>::*) ──────────── */

{# W3C SCXML 5.10: Snapshot the dequeued event into the `_event` lua
   table so onentry/onexit/transition cond expressions can read
   `_event.name` / `_event.data`. Mirrors the C++ `LuaEngine::setCurrentEvent`
   overload that pushes a fresh table on every dequeue. The C11 backend
   has the compile-time-known set of event names available, so the
   dispatch is a switch on the enum — no runtime enum→string lookup
   table is carried.

   `.data` is sourced from `_pending_donedata`, the lua-side stash slot
   that the final-state entry emit populates right before raising
   `done.state.<parent>` (or stashing for top-level finals). The promotion
   chunk reads-and-clears in one luaL_dostring so the slot is consumed
   exactly once per dequeue — non-donedata events still see `_event.data
   = nil` because `_pending_donedata` defaults to nil after every promotion
   and after lua_init_engine. The cpp engine carries `eventData` /
   `typedData` on each `EventWithMetadata`; C11 swaps that for a lua
   global to avoid widening every event_with_meta_t entry with a typed
   union, but the observable W3C 5.10 contract (`_event.data` is the
   donedata payload for done.state.<parent> events, nil otherwise) is the
   same.

   The other W3C 5.10.1 metadata fields (.type/.sendid/.origin/
   .origintype/.invokeid) land with the first fixture that reads them
   (built-but-unconsumed carve-out per feedback_built_but_unconsumed.md).
   The helper is emitted only when the fixture uses the script engine;
   datamodel-less fixtures have no lua_State and no consumer for _event.
   The (void) casts keep the helper warning-free under -Wextra when the
   fixture declares no events (then both the switch and the parameters
   fall through unused). #}
{% if model.needs_script_engine %}
static void set_current_event(lua_State *L, const {{ model.name }}_event_with_meta_t *evt) {
    (void)L;
    (void)evt;
    /* W3C SCXML 5.10.1 (test332): expose `evt->send_id` to the lua side
       via a transient global so the dispatch chunk below can embed it
       without per-event snprintf. Empty send_id (i.e. the meta field
       was zero-initialised by `<raise>` or non-`<send>` raises) is set to
       lua nil — test333 verifies that non-error events have `_event.sendid`
       blank, which lua-side reads as nil and ECMAScript surfaces as the
       same `undefined`/falsy contract the cpp engine returns through its
       optional-shaped `pendingEventSendId_` carry.

       W3C SCXML 5.10.1 (test331): `_event.type` is the spec's
       three-way category: 'platform' for events the SCXML processor
       itself raised (error.foo and done.foo families), 'internal'
       for events dispatched off the internal queue (e.g. <raise>),
       'external' for everything off the external queue (bare
       <send>, delayed <send>). cpp carries the literal on
       `EventWithMetadata.type` (StaticExecutionEngine.h:578 default
       'external'); C11 mirrors it via the `_pending_event_type` lua
       global written by process_event_queues' internal/external pop
       sites — the per-enum case below reads it back, with the
       error and done families overriding to 'platform' regardless
       of which queue popped them.

       W3C SCXML 5.10.1 (test336): `_event.origin` and
       `_event.origintype` carry the URL plus processor type the
       receiver can hand back to <send target=...> for bidirectional
       communication. cpp populates them from `EventWithMetadata`
       (StaticExecutionEngine.h:578: raiseExternal default
       `EventWithMetadata(event, data, sessionId, "", "external",
       SCXML_EVENT_PROCESSOR_TYPE)`); C11 mirrors via the
       `_pending_event_origin` / `_pending_event_origintype` lua
       globals seeded by process_event_queues' external pop, with
       the deterministic AOT-binding `_sessionid =
       '<model.name>_session'` (commit ddf5f43f) as the origin
       value. Internal-queue pops leave both nil — W3C 5.10.1 only
       sets origin for events the SCXML processor accepted from an
       external producer.

       W3C SCXML 5.10.1 (.invokeid): cpp `LuaEngine::setCurrentEvent`
       (LuaEngine.cpp:1138-1139) pushes `invokeId.c_str()` onto
       `_event.invokeid` for every event — non-invoke events arrive
       with `Event::getInvokeId()` returning an empty std::string,
       cpp emits an empty lua string, C11 mirrors via the
       `_pending_event_invokeid` lua global with the
       `_pending_event_origin`/`_pending_event_origintype`
       precedent (undef=nil baseline + chunk-end reset). No
       process_event_queues pop site seeds it yet — both internal
       and external dequeues leave it nil, mirroring the empty
       string cpp emits for non-invoke events under the same
       lua-side absence semantic the sibling fields already use.
       The invoke dispatch path lands the seeding when the invoke
       milestone activates (cpp `Event::setInvokeId(invokeId)` at
       the invoke handler is the seed site to mirror). Lifted as
       spec-mirror parity rather than waiting for the first
       force fixture (feedback_built_but_unconsumed.md
       §"Spec-mirror parity (N-backend codegen)" — cpp's branch
       is the contract; missing the field would be silent
       semantic drift on the W3C 5.10.1 metadata family. */
    if (evt->send_id[0] != '\0') {
        lua_pushstring(L, evt->send_id);
    } else {
        lua_pushnil(L);
    }
    lua_setglobal(L, "_pending_send_id");
    switch (evt->event) {
    {% for event_name in model.events | sort %}
    case {{ model.name | upper }}_EVENT_{{ event_name | upper | replace('.', '_') | replace('-', '_') }}:
        (void)luaL_dostring(L,
            "_event = {name = '{{ event_name | escape_c }}', "
              {% if event_name.startswith('error.') or event_name.startswith('done.') %}
              "type = 'platform', "
              {% else %}
              "type = _pending_event_type, "
              {% endif %}
              "origin = _pending_event_origin, "
              "origintype = _pending_event_origintype, "
              "invokeid = _pending_event_invokeid, "
              "data = _pending_donedata, "
              "sendid = _pending_send_id}; "
            "_pending_donedata = nil; "
            "_pending_send_id = nil; "
            "_pending_event_type = nil; "
            "_pending_event_origin = nil; "
            "_pending_event_origintype = nil; "
            "_pending_event_invokeid = nil");
        break;
    {% endfor %}
    default:
        break;
    }
}
{% endif %}

/* W3C SCXML App.D.2 (mainEventLoop): drain internal then external queue,
   interleaving eventless evaluation between every event dispatch. The
   spec's main loop alternates `selectEventlessTransitions` and
   `internalQueue.dequeue` so any eventless transition whose cond depends
   on a transient datamodel snapshot (e.g. test329's `Var2 == _event`,
   where `_event` is re-bound on every dequeue via `set_current_event`)
   gets its chance before the next event overwrites the binding. The
   per-event eventless pass runs to its own quiescence (eventless can
   raise more events that fold back into the queue draining); the cpp
   engine reaches the same shape via `EventProcessingAlgorithms::
   checkEventlessTransitions` calling `processInternalEventQueue` after
   each fired eventless transition. The enabled-list buffer is stack-
   local at the function scope; reused across both queues and the
   eventless interleave per W3C App.D Step 1 (each event drives an
   independent microstep). External-queue processing also interleaves so
   the W3C "external event → microstep → drain internal → eventless"
   sequence matches the cpp `processMacrostep` body. Forward declared
   so the eventless loop and queue drain can call each other; the
   eventless function definition follows. */
static void check_eventless_transitions({{ model.name }}_t *sm);

static void process_event_queues({{ model.name }}_t *sm) {
    {{ model.name }}_event_with_meta_t evt;
    {{ model.name }}_transition_info_t enabled[SCE_MAX_ENABLED_TRANSITIONS];
    uint8_t count;

    while (event_queue_pop(&sm->internal_queue, &evt)) {
        strncpy(sm->current_event_invoke_id, evt.invoke_id, (size_t)SCE_MAX_ID_LEN - 1u);
        sm->current_event_invoke_id[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
        {% if model.needs_script_engine %}
        /* W3C SCXML 5.10.1 (test331): seed `_event.type` carry — internal
           queue pop is the spec's 'internal' category. set_current_event's
           per-enum case reads `_pending_event_type` back, with the
           error and done event families overriding to 'platform'. */
        (void)luaL_dostring(sm->L, "_pending_event_type = 'internal'");
        set_current_event(sm->L, &evt);
        {% endif %}

        if ({{ model.name }}_is_in_final_state(sm)) {
            return;
        }

        if (process_transition(sm, evt.event, enabled, &count)) {
            count = remove_conflicting_transitions(enabled, count);
            handle_microstep(sm, enabled, count);
        }

        /* W3C App.D.2: re-evaluate eventless transitions before the next
           dequeue so cond expressions reading the current `_event`
           binding (test329: `Var2 == _event` where Var2 captured the
           reference) fire while the binding still holds. */
        check_eventless_transitions(sm);
    }

    while (event_queue_pop(&sm->external_queue, &evt)) {
        strncpy(sm->current_event_invoke_id, evt.invoke_id, (size_t)SCE_MAX_ID_LEN - 1u);
        sm->current_event_invoke_id[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
        {% if model.needs_script_engine %}
        /* W3C SCXML 5.10.1 (test331/336): seed `_event.type` /
           `_event.origin` / `_event.origintype` carry — external
           queue pop is the spec's 'external' category (bare <send>,
           scheduled <send>, ECMAScript host events all enqueue
           here); origin is the deterministic AOT-binding session
           URI (lua-side `_sessionid` from lua_init_engine, mirrors
           cpp StaticExecutionEngine raiseExternal default of
           sessionId), origintype is the SCXMLEventProcessor URI
           literal so a receiver's `<send target=_event.origin
           typeexpr=_event.origintype/>` round-trips into the same
           external queue (test336). */
        (void)luaL_dostring(sm->L,
                            "_pending_event_type = 'external'; "
                            "_pending_event_origin = _sessionid; "
                            "_pending_event_origintype = "
                              "'http://www.w3.org/TR/scxml/#SCXMLEventProcessor'");
        set_current_event(sm->L, &evt);
        {% endif %}

        if ({{ model.name }}_is_in_final_state(sm)) {
            return;
        }

        if (process_transition(sm, evt.event, enabled, &count)) {
            count = remove_conflicting_transitions(enabled, count);
            handle_microstep(sm, enabled, count);
        }

        check_eventless_transitions(sm);
    }
}

/* W3C SCXML 6.2 (Appendix D, eventless microstep loop):
   Repeat eventless transitions until the configuration stops changing or
   a top-level final state is reached. The 100-iteration ceiling mirrors
   the C++ guard against pathological cycles (`MAX_ITERATIONS`). Each
   iteration's enabled list is built fresh, conflict-resolved, then
   executed atomically — same shape as cpp's per-microstep collection. */
static void check_eventless_transitions({{ model.name }}_t *sm) {
    {{ model.name }}_transition_info_t enabled[SCE_MAX_ENABLED_TRANSITIONS];
    uint8_t count;
    int iter = 0;
    while (iter < 100) {
        if ({{ model.name }}_is_in_final_state(sm)) {
            return;
        }
        if (!process_transition(sm, {{ model.name | upper }}_EVENT_NONE, enabled, &count)) {
            return;
        }
        count = remove_conflicting_transitions(enabled, count);
        handle_microstep(sm, enabled, count);
        iter++;
    }
}

void {{ model.name }}_step({{ model.name }}_t *sm) {
    process_event_queues(sm);
    check_eventless_transitions(sm);
    if ({{ model.name }}_is_in_final_state(sm) && sm->completion_callback != NULL) {
        sm->completion_callback(sm->completion_callback_user_data);
    }
}

{% if model.needs_event_scheduler %}
/* W3C SCXML 6.2: Polling-loop entry point. Pumps every elapsed scheduled
   `<send delay>` entry onto the external queue, then runs a normal
   macrostep. Mirrors cpp `StaticExecutionEngine::tick()` (see
   `sce/include/static/StaticExecutionEngine.h`) — the same composition
   of `pumpScheduledEvents()` + `step()` that drives `runUntilCompletion`.
   The host calls this in a loop alongside its sleep / poll-interval
   primitive; the W3C spec is silent on poll cadence so the choice
   belongs to the runner. */
void {{ model.name }}_tick({{ model.name }}_t *sm) {
    if (!sm->is_running) {
        return;
    }
    if ({{ model.name }}_is_in_final_state(sm)) {
        if (sm->completion_callback != NULL) {
            sm->completion_callback(sm->completion_callback_user_data);
        }
        return;
    }

    uint64_t now_ms = _sce_clock_now_ms();
    {{ model.name }}_scheduled_entry_t ready;
    while (scheduled_pop_ready(sm, now_ms, &ready)) {
        {{ model.name }}_event_with_meta_t evt;
        memset(&evt, 0, sizeof(evt));
        evt.event = ready.event;
        /* Both arrays are SCE_MAX_ID_LEN-sized and `scheduled_push` always
           writes a terminating NUL inside the buffer, so a verbatim
           memcpy of the whole array transfers the string and its
           terminator without tripping `-Wstringop-truncation` (which
           strncpy would since src is a same-size buffer). */
        memcpy(evt.send_id, ready.send_id, (size_t)SCE_MAX_ID_LEN);
{% if model.needs_script_engine %}
        /* W3C SCXML 5.10 (test186): restore the per-entry payload table
           onto `_pending_donedata` so the next dequeue's set_current_event
           promotes it onto `_event.data` (mirrors cpp's
           EventWithMetadata::data → LuaEngine::setCurrentEvent delivery).
           luaL_unref releases the registry slot synchronously; LUA_NOREF
           entries (delay-only sends, no <param>) bypass the restore. */
        if (ready.payload_lua_ref != LUA_NOREF) {
            lua_rawgeti(sm->L, LUA_REGISTRYINDEX, ready.payload_lua_ref);
            lua_setglobal(sm->L, "_pending_donedata");
            luaL_unref(sm->L, LUA_REGISTRYINDEX, ready.payload_lua_ref);
        }
{% endif %}
        {{ model.name }}_raise_external(sm, &evt);
    }

    {{ model.name }}_step(sm);
}
{% endif %}

void {{ model.name }}_run({{ model.name }}_t *sm) {
    sm->is_running = true;
    while (sm->is_running && !{{ model.name }}_is_in_final_state(sm)) {
        uint32_t before = sm->active;
        {{ model.name }}_step(sm);
        /* True quiescence: configuration unchanged AND both queues empty.
           The queue check covers the exit/entry-action follow-on path —
           an eventless transition can run an <onexit> that <raise>s a
           fresh event leaving the configuration unchanged from the
           run-loop's vantage if the eventless block stops there; we
           must continue so the next step() drains those queued events.
           Comparing `sm->active` (full bitmap) instead of a single-leaf
           `current_state` correctly handles configurations where multiple
           bits change in one step (W3C 3.13 transition body actions
           setting more than one ancestor bit). */
        if (sm->active == before
            && sm->internal_queue.count == 0u
            && sm->external_queue.count == 0u) {
            break;
        }
    }
    sm->is_running = false;
}

void {{ model.name }}_init({{ model.name }}_t *sm) {
    memset(sm, 0, sizeof(*sm));
    /* W3C SCXML 6.2: SM is running from the moment the configuration is
       seeded. cpp `StaticExecutionEngine::initialize` sets `isRunning_`
       around the same point so external pollers — `_tick`, `_run`, and
       any host scheduler harness — observe a live machine immediately.
       Without this flag set _tick early-returns on its `is_running` guard
       and scheduled `<send delay>` events would never promote into the
       internal queue. */
    sm->is_running = true;
    {% if model.needs_script_engine %}
    /* W3C SCXML 5.10: Open Lua engine and seed datamodel before any
       <onentry> body runs (those bodies may reference datamodel vars). */
{{ se.lua_init_engine() }}
    {% endif %}
    /* W3C SCXML 3.2: Configuration entry via the unified
       enter_state_recursive walk — sets the initial root and every
       ancestor / region-child / initial-descendant bit, runs onentry in
       walk order. Mirrors cpp StaticExecutionEngine::initialize entry
       loop. The recursion handles compound, parallel, and leaf states
       uniformly. */
    enter_state_recursive(sm, {{ model.name }}_initial_state());
    /* W3C SCXML 6.4: Macrostep completion loop. Mirrors the cpp
       StaticExecutionEngine::initialize tail: keep firing eventless
       transitions and processing internal/external events until both
       stabilise. Without this loop the first event raised in an
       <onentry> block races ahead of the source state's eventless
       <transition> because step() drains the queue before it checks
       eventless transitions; the queued event then has no matching
       transition in the entered state and is silently dropped
       (test503/505/506 force this). */
    while (true) {
        check_eventless_transitions(sm);
        if (sm->internal_queue.count == 0u && sm->external_queue.count == 0u) {
            break;
        }
        process_event_queues(sm);
    }
}

void {{ model.name }}_destroy({{ model.name }}_t *sm) {
    {% if model.needs_event_scheduler and model.needs_script_engine %}
    /* W3C SCXML 6.2: release lua registry slots held by pending scheduled
       entries before lua_close reclaims the registry as a whole. lua_close
       would GC the slots automatically, but explicit unref keeps the
       send_id ↔ payload pairing observable across destroy phases and
       mirrors cpp's PullScheduler::~PullScheduler implicit cleanup via
       std::map's destructor running before LuaEngine teardown. */
    for (uint8_t i = 0u; i < sm->scheduled_queue.count; ++i) {
        if (sm->scheduled_queue.buf[i].payload_lua_ref != LUA_NOREF) {
            luaL_unref(sm->L, LUA_REGISTRYINDEX,
                       sm->scheduled_queue.buf[i].payload_lua_ref);
        }
    }
    {% endif %}
    {% if model.needs_script_engine %}
{{ se.lua_destroy_engine() }}
    {% else %}
    (void)sm;
    {% endif %}
}

