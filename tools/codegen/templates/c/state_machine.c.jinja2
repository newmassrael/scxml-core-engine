    if (expand_parent_parallel) {
        bool has_parent;
        {{ csym_prefix }}{{ model.name }}_state_t parent = state_get_parent(s, &has_parent);
        if (has_parent && state_is_parallel(parent)
            && config_in(sm->active, parent)) {
