{# W3C SCXML 6.2 — build `{["k1"] = v1, ["k2"] = v2}` in `_ed` from a
   `<send>`'s `<param>` children, as Lua source the receiving side
   assigns to `_event.data`.

   Shared by the `#_parent` and `#_internal` send paths. They differ only
   in where `_ed` goes afterwards — the dispatch shim or the raised
   event's `data` field — so keeping one definition is what stops the two
   from escaping differently, which is exactly how the `#_parent` site
   came to be the last one writing names in Lua field position.

   Names go in index position, never field position: a `<param name>` is
   an arbitrary string (the parser admits `odd"name`), and no escaping
   turns an arbitrary string into a Lua identifier, so field position is
   unrepresentable rather than merely unescaped. `escape_lua | escape_c`
   composes once per boundary — the Lua literal first, then the C literal
   carrying it. Same contract as the `_pending_donedata["..."]` sites in
   scriptengine.jinja2.

   A literal value is formatted at codegen time rather than through the
   runtime formatter, because that formatter needs `sm->L` and a machine
   whose every expression folds has no Lua state to offer — emitting the
   call anyway does not degrade, it fails to compile. Whether an engine
   is needed is a property of the param, not of the machine. `escape_lua`
   yields the same quoted Lua string `string.format('%q', ...)` would.

   The runtime formatter quotes strings (`%q`-style), serialises
   numbers/booleans verbatim, and emits `nil` otherwise. Tables and
   functions are rejected: no W3C corpus fixture forces a nested send
   param payload, and the first one lifts this to the recursive
   cpp-`Json::Value::toStyledString` shape.

   Buffer overflow drops the rest of the payload per W3C 6.2 ("if the
   value of any param cannot be marshalled..."). cpp cancels the message
   wholesale on serialisation error; C11 stops appending after capacity
   and still ships the truncated prefix — a stricter cancel-and-raise
   lands when a fixture forces it.                                        #}
{# `csym_prefix` and `machine` are parameters rather than globals because a
   macro body does not see the render context, and W3C SCXML 5.7.1 needs
   the machine's own `_raise_platform_error` symbol here. #}
{% macro lua_table_from_params(params, csym_prefix, machine) %}
{% if params | rejectattr("is_static_literal") | list | length == 0 %}
                /* W3C SCXML 6.2 + B-2-9: every value is a literal, so the
                   payload is finished at codegen time — and it has to be,
                   because a machine whose params all fold may carry no
                   script engine at all (`sm->L` does not exist on the
                   `send_param_payload` synth-invoke emitter). The Lua-source
                   wire could not do this: reading it back needed an
                   interpreter at the far end even when the sender had none. */
                char _ed[SCE_MAX_DATA_LEN];
                {
                    static const char *_lit = "{{ params | static_params_json | escape_c }}";
                    size_t _ln = strlen(_lit);
                    if (_ln >= sizeof(_ed)) { _ln = sizeof(_ed) - 1; }
                    memcpy(_ed, _lit, _ln);
                    _ed[_ln] = '\0';
                }
{% else %}
                char _ed[SCE_MAX_DATA_LEN];
                int _ed_len = 0;
                /* W3C SCXML 5.7.1: a pair whose expression will not evaluate is
                   left out entirely, so whether a separator is due is a runtime
                   question — the position in the document no longer answers it.
                   `_ed_any` is that answer: it turns 1 only once a pair has
                   actually been written, so a first param that fails does not
                   leave `_scxml_params(,{...})` behind. */
                int _ed_any = 0;
                /* W3C SCXML 6.2: the params go through `_scxml_params`, which
                   is what lets a repeated name become an Array of its values —
                   a table constructor has already collapsed the duplicate by
                   the time anything could look at it, and the last one silently
                   won. Same shared rule every other backend now applies. */
                {
                    static const char *_pf = "_scxml_params(";
                    int _pfl = (int)strlen(_pf);
                    if (_ed_len + _pfl < (int)SCE_MAX_DATA_LEN - 1) {
                        memcpy(_ed + _ed_len, _pf, (size_t)_pfl);
                        _ed_len += _pfl;
                    }
                }
                {% for param in params %}
                {
                    /* Rewind point: everything this pair writes is undone when
                       its value cannot be produced. */
                    int _pstart = _ed_len;
                    if (_ed_any && _ed_len < (int)SCE_MAX_DATA_LEN - 1) { _ed[_ed_len++] = ','; }
                    {
                        static const char *_pn = "{\"{{ param.name | escape_lua | escape_c }}\", ";
                        int _pnl = (int)strlen(_pn);
                        if (_ed_len + _pnl < (int)SCE_MAX_DATA_LEN - 1) {
                            memcpy(_ed + _ed_len, _pn, (size_t)_pnl);
                            _ed_len += _pnl;
                        }
                    }
{% if param.is_static_literal %}
                    {
                        static const char *_pv = "\"{{ param.static_value | escape_lua | escape_c }}\"";
                        int _pvl = (int)strlen(_pv);
                        if (_ed_len + _pvl < (int)SCE_MAX_DATA_LEN - 1) {
                            memcpy(_ed + _ed_len, _pv, (size_t)_pvl);
                            _ed_len += _pvl;
                        }
                    }
                    if (_ed_len < (int)SCE_MAX_DATA_LEN - 1) { _ed[_ed_len++] = '}'; }
                    _ed_any = 1;
                    (void)_pstart;
{% else %}
                    if (luaL_dostring(sm->L,
                        "local _v = ({{ param.expr | to_lua_expr | escape_c }}); "
                        "if type(_v) == 'string' then return string.format('%q', _v) "
                        "elseif type(_v) == 'number' or type(_v) == 'boolean' then return tostring(_v) "
                        "else return 'nil' end") == 0) {
                        const char *_v = lua_tostring(sm->L, -1);
                        if (_v != NULL) {
                            int _vl = (int)strlen(_v);
                            if (_ed_len + _vl < (int)SCE_MAX_DATA_LEN - 1) {
                                memcpy(_ed + _ed_len, _v, (size_t)_vl);
                                _ed_len += _vl;
                            }
                        }
                        lua_pop(sm->L, 1);
                        if (_ed_len < (int)SCE_MAX_DATA_LEN - 1) { _ed[_ed_len++] = '}'; }
                        _ed_any = 1;
                    } else {
                        lua_pop(sm->L, 1);
                        /* W3C SCXML 5.7.1: report the failure and ignore the
                           name and value. The `nil` placeholder this used to
                           write was the opposite of ignoring them — a receiver
                           asking whether the field is there was told yes. */
                        _ed_len = _pstart;
                        {{ csym_prefix }}{{ machine }}_raise_platform_error(
                            sm, {{ csym_prefix | upper }}{{ machine | upper }}_EVENT_ERROR_EXECUTION,
                            "<send> <param name='{{ param.name | escape_c }}'> expr failed to evaluate");
                    }
{% endif %}
                }
                {% endfor %}
                if (_ed_len < (int)SCE_MAX_DATA_LEN - 1) { _ed[_ed_len++] = ')'; }
                _ed[_ed_len] = '\0';
                /* §scxml-B-2-9: the call above is assembled from this
                   document's own escaped literals and evaluated HERE, in the
                   sending machine's engine; what crosses is its JSON. The
                   call text itself used to be the wire, so the receiving
                   machine had to run Lua source that arrived on an event —
                   and every embedder that hands in a payload writes to that
                   same field. `_scxml_params` stays because it owns the
                   repeated-name rule (W3C test178); only its output is
                   serialized rather than shipped as source. */
                {
                    char _edj[SCE_MAX_DATA_LEN + 32];
                    (void)snprintf(_edj, sizeof(_edj), "return JSON.stringify(%s)", _ed);
                    if (luaL_dostring(sm->L, _edj) == 0) {
                        const char *_j = lua_tostring(sm->L, -1);
                        if (_j != NULL) {
                            int _jl = (int)strlen(_j);
                            if (_jl >= (int)SCE_MAX_DATA_LEN) { _jl = (int)SCE_MAX_DATA_LEN - 1; }
                            memcpy(_ed, _j, (size_t)_jl);
                            _ed[_jl] = '\0';
                        }
                        lua_pop(sm->L, 1);
                    } else {
                        lua_pop(sm->L, 1);
                        _ed[0] = '\0';
                    }
                }
{% endif %}
{% endmacro %}
