               bitmap intersection (no helper-class dispatch — T3 lock-in). */
            if (*out_count < (uint8_t)SCE_MAX_ENABLED_TRANSITIONS) {
                {{ model.name }}_transition_info_t *_ti = &out_list[*out_count];
                _ti->source = check_state;
                _ti->target = {% if trans.target %}{{ model.name | upper }}_STATE_{{ trans.target | upper | replace('-', '_') | replace('.', '_') }}{% else %}check_state{% endif %};
