/* The next active state in DOCUMENT order that `walked` does not already
   hold, or false once the walk has seen them all. Written as a resumable step
   rather than as a sorted list because this profile has no allocator and the
   configuration is a bitmap: `walked` is the cursor, and it is a bitmap for
   the same reason the configuration is. */
SCE_SM_FN static SCE_C_UNUSED bool next_active_in_document_order(uint32_t active, uint32_t walked,
                                                        {{ csym_prefix }}{{ model.name }}_state_t *out) {
    bool found = false;
    uint32_t best_rank = 0u;
    for (uint32_t i = 0u; i < (uint32_t){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT; ++i) {
        uint32_t bit = (uint32_t)1u << i;
        if ((active & bit) == 0u || (walked & bit) != 0u) {
            continue;
        }
        {{ csym_prefix }}{{ model.name }}_state_t s = ({{ csym_prefix }}{{ model.name }}_state_t)i;
        uint32_t rank = state_document_order(s);
        if (!found || rank < best_rank) {
            found = true;
            best_rank = rank;
            *out = s;
        }
    }
    return found;
}

/* W3C SCXML App.D: optimal-enabled-set selection. Two branches mirror
   cpp processTransition's eventless / external split:
   - eventless: walk every active state in document order, no parent
     bubbling. cpp selectEventlessTransitions evaluates every active state
     including compound and parallel ancestors; the C switch's
     `default: break;` arm short-circuits ancestors that declare no
     transitions.
   - external: walk every active leaf in document order, bubble up the
     parent chain, stop at the first match per leaf. The same parent
     transition reached from two converging bubble paths gets pushed twice —
     conflict resolution dedups via exit-set intersection (test403b
     adversarial fixture pins this dedup behaviour).
   Compound and parallel ancestors are excluded as candidate leaves; a
   future fixture forcing done.state events on a compound/parallel target
   relaxes that filter alongside the cpp `isDoneStateEvent` mirror.

   Both branches walk `state_document_order`, and the ORDER IS LOAD-BEARING
   rather than cosmetic: `remove_conflicting_transitions` keeps the first of
   two conflicting transitions and preempts the later one unless the later
   one's source is a strict descendant. Hand it the same two transitions
   reversed and it preempts the other side.

   This used to iterate the state enum ascending, on the reasoning that
   "enum-value order = alphabetic = doc-order proxy". The two orders are not
   the same order, and they diverge exactly where the answer matters — sibling
   `<parallel>` regions, whose enabled transitions are the ones that conflict.
   Measured 2026-08-25 on `tests/integration/parallel_region_root_external_domain.scxml`,
   whose regions are `drive` (first in the document) and `watch` (second):
   alphabetically `alive` precedes `working`, so the walk collected `watch`'s
   transition first and preempted `drive`'s — the region that document order
   says wins.

   Ranks are compared, never indexed, so a document whose ranks are sparse
   walks the same as one whose ranks are dense. The scan is quadratic in the
   state count, which is bounded at 32 by the configuration bitmap; the five
   other backends sort a list for this, and a list is what this profile has
   no allocator for. */
{{ sce_map.source_marker(model.source_location, "c", symbol_artifact=sce_artifact.machine) }}
SCE_SM_FN static bool process_transition({{ csym_prefix }}{{ model.name }}_t *sm,
                                {{ csym_prefix }}{{ model.name }}_event_t event,
                                {{ csym_prefix }}{{ model.name }}_transition_info_t *out_list,
                                uint8_t *out_count) {
    *out_count = 0u;
    sm->transition_taken = false;
    uint32_t walked = 0u;
    /* Written by the walk before either branch reads it. The initialiser is
       here for the compiler's sake and not the algorithm's: `-Werror` does not
       see through the helper's bool return that `*out` is set on every true,
       and an uninitialised read is the one thing this must not be. */
    {{ csym_prefix }}{{ model.name }}_state_t s = ({{ csym_prefix }}{{ model.name }}_state_t)0;
    if (event == {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_NONE) {
        while (next_active_in_document_order(sm->active, walked, &s)) {
            walked |= state_bit(s);
            (void)try_match_in_state(sm, s, event, out_list, out_count);
        }
    } else {
        while (next_active_in_document_order(sm->active, walked, &s)) {
            walked |= state_bit(s);
            if (state_is_compound(s) || state_is_parallel(s)) {
                continue;
            }
            {{ csym_prefix }}{{ model.name }}_state_t check_state = s;
            while (true) {
                if (try_match_in_state(sm, check_state, event, out_list, out_count)) {
                    break;
                }
                bool _hp;
                {{ csym_prefix }}{{ model.name }}_state_t _p = state_get_parent(check_state, &_hp);
                if (!_hp) {
                    break;
                }
                check_state = _p;
            }
        }
    }
    if (*out_count > 0u) {
        sm->transition_taken = true;
        return true;
    }
    return false;
}

