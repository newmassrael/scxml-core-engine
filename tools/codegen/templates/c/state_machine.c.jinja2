/* Forward declarations — `scheduled_push` is invoked from inside
   `execute_entry_actions` / `execute_exit_actions` (the action emitter's
   `<send delay>` arm), but the definitions live alongside the rest of
   the RTC core lower in the translation unit so they sit next to the
   queues and macrostep helpers they belong with. The forward decl keeps
   `-Werror=implicit-function-declaration` quiet without reordering the
   logical sections of the generated source. */
static SCE_C_UNUSED SCE_SM_FN void scheduled_push({{ model.name }}_t *sm,
                           uint64_t fire_time_ms,
                           {{ model.name }}_event_t event,
                           const char *send_id
{%- if model.needs_script_engine %},
                           int payload_lua_ref
{%- endif %});
static SCE_C_UNUSED SCE_SM_FN void scheduled_cancel({{ model.name }}_t *sm, const char *send_id);
{% if model.has_parent_communication %}
/* W3C SCXML 6.2 + 6.4 (test187): delayed `<send target="#_parent">` —
   distinct entry-point from `scheduled_push` so the local-event arm
   keeps its enum-typed parameter while the parent-routed arm carries
   an event NAME (the parent's enum is foreign here). Both paths share
   the same `scheduled_queue_t` so `_tick`'s pop-by-fire-time ordering
   stays unified, and `scheduled_cancel`'s send_id walk catches
   to-parent entries the same way as local entries. */
static SCE_C_UNUSED SCE_SM_FN void scheduled_push_parent({{ model.name }}_t *sm,
                                  uint64_t fire_time_ms,
                                  const char *event_name,
                                  const char *send_id);
{% endif %}
{% endif %}
{% if model.needs_http_send %}

/* W3C SCXML C.2: standalone server's response carries the receiving
   event's name as a JSON string (`{"event":"<name>",...}`). The generated
   per-fixture helper below maps that name to the SM's `Event` enum at
   runtime. The mapping is the inverse of the codegen-time
   `EVENT_<UPPER>` synthesis used everywhere else in the source — same
   set of names, same UPPER + dot/dash → underscore transform. Unknown
   names collapse to `EVENT_NONE` and the surrounding arm declines to
   raise. Linear scan is fine: the W3C C.2 corpus events are bounded by
   the document's transition set (≤ ~10 names). The jinja2-inline contract puts
   no helper functions in the runtime; the fixture-side static helper
   is generated source, so it is in scope. */
static {{ model.name }}_event_t SCE_SM_FN {{ model.name }}_event_from_name(const char *name, size_t len) {
    if (name == NULL || len == 0u) {
        return {{ model.name | upper }}_EVENT_NONE;
    }
    {% for event_name in model.events | sort %}
    if (len == {{ event_name | length }}u && memcmp(name, "{{ event_name }}", {{ event_name | length }}u) == 0) {
        return {{ model.name | upper }}_EVENT_{{ event_name | upper | replace('.', '_') | replace('-', '_') }};
    }
    {% endfor %}
    return {{ model.name | upper }}_EVENT_NONE;
}
{% endif %}

{# RFC §synth-5-J-1: recursive action emitter. Mirrors the C++ tree's
   `actions/<type>.jinja2` include dispatch but inlines every variant in
   one local macro so the C11 backend stays a two-template tree (header
   + source) until a second consumer fixture justifies splitting. The
   macro is recursive: <if>'s then_actions / elseif.actions / else_actions
   call back into emit_action, so nested <if>/<assign>/<raise> chains
   render in one pass.

   `bool _if_pass`/`_elif_pass` are intentionally declared inside per-block
   `{ }` scopes so nested <if> chains shadow rather than collide; -Wshadow
   is not enabled in the C11 conformance target so the shadow stays warn-free.
   The caller (execute_entry_actions / execute_exit_actions) supplies the
   surrounding `case` block — we never emit `case`/`break` ourselves.

   `in_foreach` (default false) flips the <assign> dispatch onto the
   error-checking variant (`lua_assign_in_foreach_body`) so a failing
   chunk breaks the enclosing C `for` loop. <if>/<elseif>/<else> propagate
   their caller's `in_foreach` verbatim, so an <assign> nested inside an
   <if> nested inside a <foreach> body still reaches the break path.
   <foreach>'s own sub-action recursion forces `in_foreach=true` — nested
   <foreach> is intentionally unsupported per scriptengine.jinja2 (lua
   global `_sce_foreach_arr` collides), and an inner <foreach>'s own body
   emits its own `for` loop so the outer break is never reached anyway. #}
{% macro emit_action(action, in_foreach=false) %}
{% if action.type == 'raise' %}
        {
            /* W3C SCXML 3.8.1: <raise event="{{ action.event }}"> */
            {{ model.name }}_event_with_meta_t evt;
            memset(&evt, 0, sizeof(evt));
            evt.event = {{ model.name | upper }}_EVENT_{{ action.event | upper | replace('.', '_') | replace('-', '_') }};
            {{ model.name }}_raise(sm, &evt);
        }
{% elif action.type == 'assign' %}
        {
            /* W3C SCXML 5.4: <assign location="{{ action.location }}" expr="{{ action.expr | escape_c }}"> */
{% if action.location in ['_sessionid', '_name', '_ioprocessors', '_event'] %}
            /* W3C SCXML 5.10: assignment to read-only system variable
               '{{ action.location }}' is illegal — raise error.execution
               and skip the lua chunk entirely so the system variable's
               binding remains unchanged for the rest of the session.
               The reserved list covers all four W3C 5.10 system vars:
               `_sessionid` / `_name` / `_ioprocessors` are seeded once
               in scriptengine.jinja2's lua_init_engine; `_event` is
               re-bound by `set_current_event` on every dequeue and is
               never user-writable. cpp `LuaEngine::setupSystemVariables`
               + the protected-assign rejection path mirror this set.
               The EVENT_ERROR_EXECUTION enum value is always present
               whenever this path runs because <assign> sets
               needs_script_engine, which injects "error.execution" into
               model.events via analyzer.rs. */
            {{ model.name }}_event_with_meta_t _err_evt;
            memset(&_err_evt, 0, sizeof(_err_evt));
            _err_evt.event = {{ model.name | upper }}_EVENT_ERROR_EXECUTION;
            {{ model.name }}_raise(sm, &_err_evt);
{% if in_foreach %}
            break;  /* W3C 4.6: error inside <foreach> body breaks the loop */
{% endif %}
{% elif (not action.expr) and action.content %}
            /* W3C SCXML 5.4 (test530-shape): `<assign location="{{ action.location }}">`
               with inline XML child element (no `expr` attribute). The parser's
               `parse_executable_content` arm c14n-serialises the children into
               `action.content` (parser.rs:1383-1391). Mirror cpp
               `actions/assign.jinja2:40-42`: wrap as a Lua single-quoted
               string literal so the datamodel slot holds the SCXML text for
               downstream `<content expr>` evaluation. Lua single-quoted
               strings preserve embedded `"` verbatim — the W3C corpus's
               c14n output for `<scxml ...><final/></scxml>` carries only
               double-quotes in attribute values, no single-quote / backslash
               on this path. The replace-chain stays in for defensive
               escaping should a future fixture introduce them. */
            if (luaL_dostring(sm->L,
                "{{ action.location }} = '{{ action.content | replace('\\', '\\\\') | replace("'", "\\'") | escape_c }}'") != 0) {
                lua_pop(sm->L, 1);
                {{ model.name }}_event_with_meta_t _err_evt;
                memset(&_err_evt, 0, sizeof(_err_evt));
                _err_evt.event = {{ model.name | upper }}_EVENT_ERROR_EXECUTION;
                {{ model.name }}_raise(sm, &_err_evt);
{% if in_foreach %}
                break;
{% endif %}
            }
{% elif in_foreach %}
{{ se.lua_assign_in_foreach_body(action.location, action.expr) }}
{% else %}
{{ se.lua_assign(action.location, action.expr) }}
{% endif %}
        }
{% elif action.type == 'foreach' %}
        {
            /* W3C SCXML 4.6: <foreach array="{{ action.array }}" item="{{ action.item }}"{% if action.index %} index="{{ action.index }}"{% endif %}> */
{% if not action.array or not action.item %}
            /* W3C SCXML 4.6: missing required `array` or `item` attribute — raise
