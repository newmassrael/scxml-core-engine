/* W3C SCXML 3.2/3.4/3.6: Unified entry walk. Walks up to the first
   already-active ancestor (or the root), then walks back down running
   onentry on every state in the chain — so cross-compound entries
   activate every passive ancestor's onentry, not just the leaf's.
   After the chain runs, descend: a <parallel> activates every region,
   a compound state descends through state.initial. Idempotent — the
   walk-up halts at the first active ancestor, so re-entry into an
   already-active subtree does not double-fire onentry.

   W3C SCXML 3.4 parallel-sibling re-entry: when an external transition
   inside a parallel region exits all sibling regions (compute_exit_set
   returns active descendants of the parallel LCA), re-entering the
   target alone leaves the cousin regions inactive. Whenever an entered
   state's parent is an already-active <parallel>, dispatch the parent's
   region children — enter_state_recursive is idempotent on already-active
   regions, so siblings that were never exited are no-ops.

   Mirrors cpp HierarchicalStateHelper::buildEntryChain followed by the
   StaticExecutionEngine::executeMicrostep parallel re-entry pass. */
/* The ordinary entry: a state somebody targeted, whose parent `<parallel>` may
   have lost cousin regions to the exit set and needs them back. */
SCE_SM_FN static void enter_state_recursive({{ csym_prefix }}{{ model.name }}_t *sm, {{ csym_prefix }}{{ model.name }}_state_t s) {
    enter_state_recursive_ex(sm, s, true);
}

SCE_SM_FN static void enter_state_recursive_ex({{ csym_prefix }}{{ model.name }}_t *sm, {{ csym_prefix }}{{ model.name }}_state_t s,
                                               bool expand_parent_parallel) {
    if (config_in(sm->active, s)) {
        return;
    }
    {{ csym_prefix }}{{ model.name }}_state_t chain[{{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT];
    uint32_t depth = 0u;
    {
        {{ csym_prefix }}{{ model.name }}_state_t cur = s;
        while (depth < (uint32_t){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT) {
            chain[depth++] = cur;
            bool has_parent;
            {{ csym_prefix }}{{ model.name }}_state_t p = state_get_parent(cur, &has_parent);
            if (!has_parent || config_in(sm->active, p)) {
                break;
            }
            cur = p;
        }
    }
    /* W3C SCXML 3.6 + 3.4: top-down chain enter. Each compound chain
       element runs its `<initial>` transition's executable content
       between its own onentry and its child's onentry (test412 —
       actions interleave at the parent/child boundary). Each parallel
       chain element activates its sibling regions before the chain
       descends past it (test413/364/576 — multi-target initial enters
       every sibling region, not just the path of model.initial_leaf).
       The chain only carries one path-branch from leaf walk-up; sibling
       regions are expanded via enter_parallel_regions, whose recursive
       enter_state_recursive calls are idempotent on already-active
       states. The idempotent guard at top of the loop catches the
       chain[i] elements that the sibling expansion entered for us
       (regions whose path overlaps the chain). cpp
       HierarchicalStateHelper::buildEntryChain bakes parallel regions
       into the chain itself; C11 expands them inline because the chain
       array is a fixed-depth walk-up, not a tree push. */
