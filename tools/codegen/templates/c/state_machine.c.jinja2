SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_init_with_parent({{ csym_prefix }}{{ model.name }}_t *sm,
                                       void *parent_sm,
                                       void (*dispatch)(void *parent_sm, const char *event_name, const char *invoke_id, const char *event_data),
                                       const char *invoke_id) {
    memset(sm, 0, sizeof(*sm));
