           `resolve_history_targets` collapse — which rewrites
           `state.initial` to the resolved default leaf for the regular
           descend path — would silently bypass the snapshot on
           re-entry (test579's second entry through s0 must restore s03
           from the captured snapshot rather than re-descend to s01). */
        {% set has_initial_history = namespace(v=false) %}
        {% for state_id, state in model.states | dictsort %}{% if state.initial_history_id %}{% set has_initial_history.v = true %}{% endif %}{% endfor %}
        {% if has_initial_history.v %}
        switch (s) {
        {% for state_id, state in model.states | dictsort %}
        {% if state.initial_history_id %}
        case {{ csym_prefix | upper }}{{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
            enter_history_state(sm, {{ csym_prefix | upper }}{{ model.name | upper }}_HIST_{{ state.initial_history_id | upper | replace('-', '_') | replace('.', '_') }});
            return;
        {% endif %}
        {% endfor %}
        default:
            break;
        }
        {% endif %}

        {{ csym_prefix }}{{ model.name }}_state_t child = state_get_initial_child(s);
        if (child != s) {
