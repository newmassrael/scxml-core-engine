        {{ model.name }}_state_t cur = s;
        while (depth < (uint32_t){{ model.name | upper }}_STATE_COUNT) {
            chain[depth++] = cur;
            bool has_parent;
            {{ model.name }}_state_t p = state_get_parent(cur, &has_parent);
            if (!has_parent || config_in(sm->active, p)) {
                break;
