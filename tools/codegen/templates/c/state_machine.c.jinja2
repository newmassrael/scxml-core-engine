        uint32_t snap = 0u;
        for (uint32_t i = 0u; i < (uint32_t){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT; ++i) {
            if ((sm->active & ((uint32_t)1u << i)) == 0u) continue;
            {{ csym_prefix }}{{ model.name }}_state_t s = ({{ csym_prefix }}{{ model.name }}_state_t)i;
            if (s == {{ parent_enum }}) continue;
            {% if info.type == 'shallow' %}
            /* shallow: capture the parent's active immediate child only.
               Compound-state semantics guarantee at most one such child;
               <parallel> would relax that to all region children but the
               first parallel+history fixture forces the generalisation. */
            bool _hp;
            {{ csym_prefix }}{{ model.name }}_state_t _p = state_get_parent(s, &_hp);
            if (_hp && _p == {{ parent_enum }}) {
                snap |= state_bit(s);
            }
            {% else %}
            /* deep: capture every active descendant that has no further
               active children (= currently a leaf in the active config).
               enter_state_recursive's config_enter_chain re-establishes
               the ancestor bits on restore, so storing leaves alone is
               sufficient. */
            if (!is_descendant_of(s, {{ parent_enum }})) continue;
            bool has_active_child = false;
            for (uint32_t c = 0u; c < (uint32_t){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT; ++c) {
                if (c == i || (sm->active & ((uint32_t)1u << c)) == 0u) continue;
                bool _hp;
                {{ csym_prefix }}{{ model.name }}_state_t _p = state_get_parent(({{ csym_prefix }}{{ model.name }}_state_t)c, &_hp);
                if (_hp && _p == s) { has_active_child = true; break; }
            }
            if (!has_active_child) snap |= state_bit(s);
            {% endif %}
        }
        sm->policy.history_{{ hid }}_snapshot = snap;
        sm->policy.history_{{ hid }}_recorded = true;
    }
    {% endfor %}
}

/* W3C SCXML 3.10: enter a history pseudo-state — restore the recorded
   snapshot if present, otherwise execute the history's default
   `<transition>` executable content and enter its default target.
   Mirrors cpp HistoryHelper::buildEntryChain. enter_state_recursive is
   idempotent so any ancestor bits already set by an earlier transition
   are not double-fired. The default-actions branch only runs on the
   first entry to the parent state (recorded=false); once a snapshot has
   been captured, subsequent re-entries restore it verbatim, matching
   the W3C "default transition body executes only when no stored history"
   contract that test579 verifies. */
SCE_SM_FN static void enter_history_state({{ csym_prefix }}{{ model.name }}_t *sm, {{ csym_prefix }}{{ model.name }}_history_t hid) {
    switch (hid) {
    {% for hid, info in model.history_states | dictsort %}
    case {{ csym_prefix | upper }}{{ model.name | upper }}_HIST_{{ hid | upper | replace('-', '_') | replace('.', '_') }}:
        if (sm->policy.history_{{ hid }}_recorded) {
            for (uint32_t i = 0u; i < (uint32_t){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT; ++i) {
                if ((sm->policy.history_{{ hid }}_snapshot & ((uint32_t)1u << i)) == 0u) continue;
                enter_state_recursive(sm, ({{ csym_prefix }}{{ model.name }}_state_t)i);
            }
        } else {
            {% for action in info.default_actions %}
            {{ emit_action(action) }}
            {% endfor %}
            enter_state_recursive(sm, {{ csym_prefix | upper }}{{ model.name | upper }}_STATE_{{ info.default_target | upper | replace('-', '_') | replace('.', '_') }});
        }
        break;
    {% endfor %}
    default:
        break;
    }
}
{% endif %}

/* W3C SCXML App.D.2: Microstep execution.
   - exit:  union of every selected transition's exit_set, walked in
            reverse enum-value order (= reverse doc-order proxy) so the
            deepest active descendant exits first; multi-leaf <parallel>
            configurations drain every region simultaneously
   - body:  transitions sorted by source enum-value, executed in order
   - entry: transitions sorted by target enum-value, enter_state_recursive
            is idempotent so duplicate / converging targets collapse
   Mirrors cpp StaticExecutionEngine::executeMicrostep +
   ParallelTransitionHelper::computeStatesToExit / sortTransitionsBySource /
   sortTransitionsByTarget, inlined into one function (jinja2-inline contract).
   compute_exit_set is the LCA-based cpp mirror so the pre-collected
   exit_set bitmap drives both conflict resolution and the actual exit
   walk in one pass. Sort keys use enum-value order — alphabetic sort
   is the doc-order proxy across every currently registered fixture
   (s01p > s01p1 > s01p11 ordering); a fixture whose alphabetic order
   diverges from doc-order will force a codegen-time doc-order table
   (cpp's StateRegistry mirror). */
SCE_SM_FN static void handle_microstep({{ csym_prefix }}{{ model.name }}_t *sm,
                             {{ csym_prefix }}{{ model.name }}_transition_info_t *list,
                             uint8_t count) {
    if (count == 0u) {
        return;
    }

    uint32_t exit_union = 0u;
    for (uint8_t i = 0u; i < count; ++i) {
        exit_union |= list[i].exit_set;
    }
{% if model.has_history_states %}
    /* W3C SCXML 3.10: snapshot history states before exit clears any
       bits — capture sees the pre-exit active configuration. */
    capture_histories(sm, exit_union);
{% endif %}
    for (uint32_t bit = (uint32_t){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT; bit > 0u; --bit) {
        {{ csym_prefix }}{{ model.name }}_state_t s = ({{ csym_prefix }}{{ model.name }}_state_t)(bit - 1u);
        if ((exit_union & state_bit(s)) == 0u) {
            continue;
        }
        if ((sm->active & state_bit(s)) == 0u) {
            continue;
        }
        execute_exit_actions(sm, s);
        sm->active &= ~state_bit(s);
    }

    /* W3C App.D.2 Step 3: bodies in document order. */
    for (uint8_t i = 1u; i < count; ++i) {
        {{ csym_prefix }}{{ model.name }}_transition_info_t key = list[i];
        uint8_t j = i;
        while (j > 0u && (uint32_t)list[j - 1u].source > (uint32_t)key.source) {
            list[j] = list[j - 1u];
            j--;
        }
        list[j] = key;
    }
    for (uint8_t i = 0u; i < count; ++i) {
        sm->policy.last_transition_source_state = list[i].source;
        sm->policy.last_transition_target_state = list[i].target;
        sm->policy.last_transition_is_internal = list[i].is_internal;
        sm->policy.last_transition_is_targetless = list[i].is_targetless;
        sm->policy.last_transition_index = list[i].index;
        execute_transition_actions(sm);
    }

    /* W3C App.D.2 Step 4-5: entries in document order. */
    for (uint8_t i = 1u; i < count; ++i) {
        {{ csym_prefix }}{{ model.name }}_transition_info_t key = list[i];
        uint8_t j = i;
        while (j > 0u && (uint32_t)list[j - 1u].target > (uint32_t)key.target) {
            list[j] = list[j - 1u];
            j--;
        }
        list[j] = key;
    }
    for (uint8_t i = 0u; i < count; ++i) {
        if (list[i].is_targetless) {
            continue;
        }
{% if model.has_history_states %}
        if (list[i].history_target != {{ csym_prefix | upper }}{{ model.name | upper }}_HIST_NONE) {
            enter_history_state(sm, list[i].history_target);
        } else {
            enter_state_recursive(sm, list[i].target);
        }
{% else %}
        enter_state_recursive(sm, list[i].target);
{% endif %}
    }
}

{% if (model.invokes | scxml_family) or (model.invokes | unsupported) %}
/* ── W3C SCXML 6.4: Invoke lifecycle helpers (per-SM, inline) ──────── */
{% include 'c/invoke_methods.jinja2' %}
{% endif %}

/* ── W3C SCXML 6.2: External-facing raise APIs ────────────────────── */

SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_raise({{ csym_prefix }}{{ model.name }}_t *sm,
                            const {{ csym_prefix }}{{ model.name }}_event_with_meta_t *evt) {
{% if error_events %}
    /* W3C SCXML 3.12.2: the clause bounds what happens to an error event
       nothing matches. It says nothing about one a handler DOES match and
       answers with the same failure -- that failure raises the error, the same
       transition answers it, and this queue never empties. The chain is cut
       here, and `_error_cascade_events` is how the host learns it was.

       Only the engine's own error events are refused: an author's `<raise>`
       inside an error handler is the document doing its job. */
    if (sm->handling_error_event && event_is_error(evt->event)) {
        sm->error_cascade_depth++;
        if (sm->error_cascade_depth >= SCE_MAX_ERROR_CASCADE_DEPTH) {
            sm->error_cascade_events++;
            sm->last_error_cascade_event = evt->event;
            sm->has_error_cascade_event = true;
            return;
        }
    }
{% endif %}
    event_queue_push(&sm->internal_queue, evt);
}

SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_raise_external({{ csym_prefix }}{{ model.name }}_t *sm,
                                     const {{ csym_prefix }}{{ model.name }}_event_with_meta_t *evt) {
    /* ⚠ No `is_running` refusal here, and the reason is that this function is
       NOT the host's door on this backend: the generated `<send>` actions call
       it too (four sites), so a guard here refuses the DOCUMENT's own events.
       Measured 2026-08-23 — seven parallel-region fixtures went red because an
       `e` the document sent to itself was turned away. The refusal belongs
       where only a host arrives; what a stopped machine abandons is recorded by
       `record_unseen_external_events` at the main event loop's exit, which is
       the one place that sees the queue and the stop together. */
    event_queue_push(&sm->external_queue, evt);
}

{% if event_payload_active %}
/* NL→IR Item C1 Path A: per-event typed-payload inject
   entries (see the header decls for the payload ownership
   boundary). Each binds the event enum + payload tag + union member in
   one site, so the name↔type pairing is impossible to construct
   inconsistently. `= {0}` zero-inits the whole record (no <string.h>
   dependency — the datamodel-less native path does not include it). */
{{ event_payload_entry_defs }}
{% endif %}

{% if model.has_parent_communication %}
/* W3C SCXML 6.4 / 3.4 (test236): natural-termination exit walk.
   Called by the invoking parent's invoke helper when the child reaches
   its top-level `<final>` (synchronous-final spawn at
   `execute_pending_invokes` or async-final at `_drive_active_children`).
   Runs `execute_exit_actions` on every still-active state in
   reverse-enum-value order so each state's `<onexit>` block fires —
   in particular, the `<onexit><send target="#_parent">` body on a
   `<final>` state lands on the parent's external queue BEFORE the
   parent helper raises `done.invoke`, satisfying W3C SCXML 6.4's
   "verdict-event before completion-event" ordering (test236). The
   parent CANCEL path (state-exit calls `<sm>_destroy`) does NOT route
   through this helper — `execute_exit_actions` in the parent NULLs
   `parent_dispatch` first so any in-flight child sends drop, mirroring
   W3C 6.4 cancellation drop semantics (test252). */
SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_finalize_session({{ csym_prefix }}{{ model.name }}_t *sm) {
    if (!sm->is_running) {
        return;
    }
    for (int _i = (int){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT - 1; _i >= 0; --_i) {
        {{ csym_prefix }}{{ model.name }}_state_t _s = ({{ csym_prefix }}{{ model.name }}_state_t)_i;
        if (config_in(sm->active, _s)) {
            execute_exit_actions(sm, _s);
        }
    }
    sm->is_running = false;
}

/* W3C SCXML 6.2: String-keyed counterpart for
   `<send target="#_<invokeid>" event="X">` from the invoking parent.
   The parent's per-invoke `_send_to_child` helper resolves the
   `#_<id>` literal to the embedded child instance at codegen time;
   that helper calls this function on the child's struct, which
   converts the event-name string to the child's event enum and
   enqueues onto the child's external queue. Mirrors the parent's
   static `_dispatch_external_by_name` shim (used for the reverse
   direction with an `invoke_id` carry); this public form is the
   minimal entry point for the parent→child path. */
SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_raise_external_by_name({{ csym_prefix }}{{ model.name }}_t *sm, const char *event_name) {
    if (sm == NULL || event_name == NULL) {
        return;
    }
    {{ csym_prefix }}{{ model.name }}_event_with_meta_t evt;
    memset(&evt, 0, sizeof(evt));
    {% for ev_name in model.events | sort %}
    if (strcmp(event_name, "{{ ev_name }}") == 0) {
        evt.event = {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_{{ ev_name | upper | replace('.', '_') | replace('-', '_') }};
        {{ csym_prefix }}{{ model.name }}_raise_external(sm, &evt);
        return;
    }
    {% endfor %}
}

/* W3C SCXML 6.4: autoforward entry point. Same name→enum resolution as the
   shim above, but the source event's `_event` fields ride along because §6.4
   requires the copy be exact. Unknown names fall through silently: a child
   need not declare every event its parent forwards. */
SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_raise_external_forwarded({{ csym_prefix }}{{ model.name }}_t *sm, const sce_forwarded_event_t *fwd) {
    if (sm == NULL || fwd == NULL) {
        return;
    }
    {{ csym_prefix }}{{ model.name }}_event_with_meta_t evt;
    memset(&evt, 0, sizeof(evt));
    sce_copy_bounded_data(evt.data, fwd->data);
    sce_copy_bounded_origin(evt.origin, fwd->origin);
    sce_copy_bounded_id(evt.send_id, fwd->send_id);
    sce_copy_bounded_event_type(evt.type, fwd->type);
    sce_copy_bounded_id(evt.origin_type, fwd->origin_type);
    sce_copy_bounded_id(evt.invoke_id, fwd->invoke_id);
    {% for ev_name in model.events | sort %}
    if (strcmp(fwd->name, "{{ ev_name }}") == 0) {
        evt.event = {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_{{ ev_name | upper | replace('.', '_') | replace('-', '_') }};
        {{ csym_prefix }}{{ model.name }}_raise_external(sm, &evt);
        return;
    }
    {% endfor %}
}
{% endif %}

{% if model.needs_event_scheduler %}
/* ── W3C SCXML 6.2: Delayed-send queue helpers ────────────────────── */

{# Sorted insert keyed on `fire_time_ms`. cpp `SchedulerQueueCore` uses a
   `std::map` whose ordering key is `(fireTime, sequenceNum)`; the C11
   mirror keeps the same fire-time ordering and breaks ties by insertion
   order (the linear scan stops at the first strictly-greater entry, so
   equal-time entries fall in FIFO order — same observable outcome as
   cpp's monotonic `sequenceCounter_`). Overflow raises error.execution
   onto the internal queue per W3C 6.2 (the spec requires a discoverable
   error rather than silent loss); the entry being inserted is the one
   dropped, matching the bounded-resource contract documented at the
   `SCE_MAX_SCHEDULED` define site in `sce/types.h`. #}
SCE_SM_FN static void scheduled_push({{ csym_prefix }}{{ model.name }}_t *sm,
                           uint64_t fire_time_ms,
                           {{ csym_prefix }}{{ model.name }}_event_t event,
                           const char *send_id
{%- if model.needs_script_engine %},
                           int payload_lua_ref
{%- endif %}) {
    if (sm->scheduled_queue.count >= (uint8_t)SCE_MAX_SCHEDULED) {
{% if model.needs_script_engine %}
        /* W3C SCXML 6.2: capacity overflow drops the new entry; the caller
           already stashed any payload table into the lua registry so we
           must release it here to avoid a leak that would survive until
           lua_close (and the ref counter would still consume registry
           slots). cpp's bounded-resource path raises the same
           error.execution event but cleans up its EventWithMetadata
           automatically via std::map's erase semantics; C11 mirrors the
           cleanup explicitly here. */
        if (payload_lua_ref != LUA_NOREF) {
            luaL_unref(sm->L, LUA_REGISTRYINDEX, payload_lua_ref);
        }
{% endif %}
        {{ csym_prefix }}{{ model.name }}_raise_platform_error(
            sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
            "the scheduled-send queue is full, so this <send delay> was dropped");
        return;
    }

    /* Find insertion index keeping the array sorted by fire_time_ms. */
    uint8_t pos = sm->scheduled_queue.count;
    for (uint8_t i = 0; i < sm->scheduled_queue.count; ++i) {
        if (fire_time_ms < sm->scheduled_queue.buf[i].fire_time_ms) {
            pos = i;
            break;
        }
    }

    /* Shift later entries one slot right. */
    for (uint8_t j = sm->scheduled_queue.count; j > pos; --j) {
        sm->scheduled_queue.buf[j] = sm->scheduled_queue.buf[j - 1u];
    }

    {{ csym_prefix }}{{ model.name }}_scheduled_entry_t *slot = &sm->scheduled_queue.buf[pos];
    slot->fire_time_ms = fire_time_ms;
    slot->event = event;
    sce_copy_bounded_id(slot->send_id, send_id);
{% if model.needs_script_engine %}
    slot->payload_lua_ref = payload_lua_ref;
{% endif %}
{% if model.has_parent_communication %}
    slot->to_parent = false;
    slot->to_parent_event[0] = '\0';
{% endif %}
{% if model.has_delayed_host_send %}
    slot->host_send = false;
{% endif %}
    sm->scheduled_queue.count++;
}

{% if model.has_delayed_host_send %}
/* W3C SCXML 6.2.4 + 6.2.5: sorted-insert a `<send delay>` the HOST serves,
   to be PERFORMED when its deadline arrives rather than raised.

   The same queue `scheduled_push` writes into, which is the contract: the
   act is ordered against every other delayed send by deadline, a
   `<cancel sendid>` drops it, and `_time_until_next_scheduled_ms` counts
   it. A private list would answer none of those three.

   The request's strings are COPIED into the slot. W3C SCXML 6.2 evaluates
   a send's fields at send time, so the caller's buffers hold what the
   document computed here — and most of them are stack arrays inside the
   `<send>` block, which is gone long before the deadline.

   A field too long for its slot is truncated rather than dropped, matching
   `sce_copy_bounded_id`'s contract everywhere else in this file; the
   bounds are SCE_MAX_ID_LEN / SCE_MAX_URI_LEN / SCE_MAX_DATA_LEN, the same
   ones every other carried string in the generated machine uses. */
SCE_SM_FN static SCE_C_UNUSED void scheduled_push_host({{ csym_prefix }}{{ model.name }}_t *sm,
                           uint64_t fire_time_ms,
                           const char *send_id,
                           const sce_host_send_request_t *request) {
    if (sm->scheduled_queue.count >= (uint8_t)SCE_MAX_SCHEDULED) {
{% if 'error.execution' in model.events %}
        {{ csym_prefix }}{{ model.name }}_raise_platform_error(
            sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
            "the scheduled-send queue is full, so this <send delay> was dropped");
{% endif %}
        return;
    }

    uint8_t pos = sm->scheduled_queue.count;
    for (uint8_t i = 0; i < sm->scheduled_queue.count; ++i) {
        if (fire_time_ms < sm->scheduled_queue.buf[i].fire_time_ms) {
            pos = i;
            break;
        }
    }
    for (uint8_t j = sm->scheduled_queue.count; j > pos; --j) {
        sm->scheduled_queue.buf[j] = sm->scheduled_queue.buf[j - 1u];
    }

    {{ csym_prefix }}{{ model.name }}_scheduled_entry_t *slot = &sm->scheduled_queue.buf[pos];
    memset(slot, 0, sizeof(*slot));
    slot->fire_time_ms = fire_time_ms;
    slot->event = {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_NONE;
    sce_copy_bounded_id(slot->send_id, send_id);
{% if model.needs_script_engine %}
    slot->payload_lua_ref = LUA_NOREF;
{% endif %}
    slot->host_send = true;
    sce_copy_bounded_id(slot->host_processor_type, request->processor_type);
    sce_copy_bounded_id(slot->host_event_name, request->event_name);
    sce_copy_bounded_n(slot->host_target, request->target, sizeof(slot->host_target));
    sce_copy_bounded_data(slot->host_content, request->content);
{% if model.delayed_host_send_max_params > 0 %}
    slot->host_param_count = 0;
    for (int _p = 0; _p < request->param_count && _p < {{ model.delayed_host_send_max_params }}; ++_p) {
        sce_copy_bounded_id(slot->host_param_names[_p], request->params[_p].name);
        sce_copy_bounded_data(slot->host_param_values[_p], request->params[_p].value);
        slot->host_param_count++;
    }
{% endif %}
    sm->scheduled_queue.count++;
}
{% endif %}

{% if model.has_parent_communication %}
/* W3C SCXML 6.2 + 6.4 (test187): sorted-insert delayed entry whose
   firing routes through `parent_dispatch` instead of the local
   `raise_external` path. Shares the same scheduled_queue buffer as
   `scheduled_push` so a single fire-time ordering covers both arms,
   and `scheduled_cancel` walks the same send_id index. The `event`
   enum slot is left at `_EVENT_NONE` (the to_parent flag is the
   discriminator `_tick` reads) — the parent's enum is foreign to
   this SM, so the routing target travels as an event NAME in
   `to_parent_event`. Capacity overflow drops the entry the same way
   the local arm does (raise error.execution + return). */
SCE_SM_FN static void scheduled_push_parent({{ csym_prefix }}{{ model.name }}_t *sm,
                                  uint64_t fire_time_ms,
                                  const char *event_name,
                                  const char *send_id) {
    if (sm->scheduled_queue.count >= (uint8_t)SCE_MAX_SCHEDULED) {
        {{ csym_prefix }}{{ model.name }}_raise_platform_error(
            sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
            "the scheduled-send queue is full, so this <send delay> was dropped");
        return;
    }

    uint8_t pos = sm->scheduled_queue.count;
    for (uint8_t i = 0; i < sm->scheduled_queue.count; ++i) {
        if (fire_time_ms < sm->scheduled_queue.buf[i].fire_time_ms) {
            pos = i;
            break;
        }
    }
    for (uint8_t j = sm->scheduled_queue.count; j > pos; --j) {
        sm->scheduled_queue.buf[j] = sm->scheduled_queue.buf[j - 1u];
    }

    {{ csym_prefix }}{{ model.name }}_scheduled_entry_t *slot = &sm->scheduled_queue.buf[pos];
    slot->fire_time_ms = fire_time_ms;
    slot->event = {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_NONE;
    sce_copy_bounded_id(slot->send_id, send_id);
{% if model.needs_script_engine %}
    slot->payload_lua_ref = LUA_NOREF;
{% endif %}
    slot->to_parent = true;
    if (event_name != NULL) {
        strncpy(slot->to_parent_event, event_name, (size_t)SCE_MAX_ID_LEN - 1u);
        slot->to_parent_event[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
    } else {
        slot->to_parent_event[0] = '\0';
    }
    sm->scheduled_queue.count++;
}
{% endif %}

/* Pop the head entry iff its fire time has elapsed (compared against `now_ms`).
   Returns true and writes the matured entry into `out` when ready, false otherwise.
   Mirrors cpp `SchedulerQueueCore::popReadyEvent(now, …)` — the head element
   is always the earliest-firing thanks to `scheduled_push`'s sorted insert. */
SCE_SM_FN static bool scheduled_pop_ready({{ csym_prefix }}{{ model.name }}_t *sm,
                                uint64_t now_ms,
                                {{ csym_prefix }}{{ model.name }}_scheduled_entry_t *out) {
    if (sm->scheduled_queue.count == 0u) {
        return false;
    }
    if (sm->scheduled_queue.buf[0].fire_time_ms > now_ms) {
        return false;
    }

    *out = sm->scheduled_queue.buf[0];
    for (uint8_t k = 1; k < sm->scheduled_queue.count; ++k) {
        sm->scheduled_queue.buf[k - 1u] = sm->scheduled_queue.buf[k];
    }
    sm->scheduled_queue.count--;
    return true;
}

/* W3C SCXML 6.3 (test208/210): remove every scheduled entry whose send_id
   matches `send_id`. The cpp engine routes `<cancel>` to
   `StaticExecutionEngine::cancelEvent` → `PullScheduler::cancelEvent`
   (`sce/include/core/PullScheduler.h`) which iterates the std::map and
   erases matches; C11 walks the bounded array in place (jinja2-inline).
   Multiple entries can share a send_id (cpp guarantees uniqueness via
   `SendHelper::generateSendId`, but a fixture-supplied static `id="foo"`
   could repeat across a parallel region). The compaction loop tolerates
   that — it advances `pos` only on a non-match so the buffer stays
   contiguous. NULL or empty send_id is a no-op (matches cpp's
   `if (sendid.empty()) return`). The action is silent on a miss, mirroring
   the spec: W3C 6.3 doesn't require an error if the send_id is unknown
   (cpp's `cancelEvent` ignores the result of `erase`). */
SCE_SM_FN static SCE_C_UNUSED void scheduled_cancel({{ csym_prefix }}{{ model.name }}_t *sm, const char *send_id) {
    if (send_id == NULL || send_id[0] == '\0') {
        return;
    }
    uint8_t pos = 0u;
    for (uint8_t i = 0u; i < sm->scheduled_queue.count; ++i) {
        if (strcmp(sm->scheduled_queue.buf[i].send_id, send_id) != 0) {
            if (pos != i) {
                sm->scheduled_queue.buf[pos] = sm->scheduled_queue.buf[i];
            }
            pos++;
        }
{% if model.needs_script_engine %}
        else if (sm->scheduled_queue.buf[i].payload_lua_ref != LUA_NOREF) {
            /* W3C SCXML 6.3: matching entries are dropped via compaction;
               release the lua registry slot here so the cancelled send's
               payload table is reclaimable before lua_close. cpp routes
               cancellation through `PullScheduler::cancelEvent` which
               erases the std::map entry and lets the contained
               EventWithMetadata's destructor handle teardown — C11 mirrors
               that lifecycle ownership explicitly. */
            luaL_unref(sm->L, LUA_REGISTRYINDEX,
                       sm->scheduled_queue.buf[i].payload_lua_ref);
        }
{% endif %}
    }
    sm->scheduled_queue.count = pos;
}
{% endif %}

/* ── RTC core (mirrors StaticExecutionEngine<Policy>::*) ──────────── */

{# W3C SCXML 5.10: Snapshot the dequeued event into the `_event` lua
   table so onentry/onexit/transition cond expressions can read
   `_event.name` / `_event.data`. Mirrors the C++ `LuaEngine::setCurrentEvent`
   overload that pushes a fresh table on every dequeue. The C11 backend
   has the compile-time-known set of event names available, so the
   dispatch is a switch on the enum — no runtime enum→string lookup
   table is carried.

   `.data` is sourced from `_pending_donedata`, the lua-side stash slot
   that the final-state entry emit populates right before raising
   `done.state.<parent>` (or stashing for top-level finals). The promotion
   chunk reads-and-clears in one luaL_dostring so the slot is consumed
   exactly once per dequeue — non-donedata events still see `_event.data
   = nil` because `_pending_donedata` defaults to nil after every promotion
   and after lua_init_engine. The cpp engine carries `eventData` /
   `typedData` on each `EventWithMetadata`; C11 swaps that for a lua
   global to avoid widening every event_with_meta_t entry with a typed
   union, but the observable W3C 5.10 contract (`_event.data` is the
   donedata payload for done.state.<parent> events, nil otherwise) is the
   same.

   The other W3C 5.10.1 metadata fields (.type/.sendid/.origin/
   .origintype/.invokeid) land with the first fixture that reads them
   (spec-mirror parity carve-out per feedback_spec_mirror_parity.md).
   The helper is emitted only when the fixture uses the script engine;
   datamodel-less fixtures have no lua_State and no consumer for _event.
   The (void) casts keep the helper warning-free under -Wextra when the
   fixture declares no events (then both the switch and the parameters
   fall through unused). #}
{% if model.needs_script_engine %}
{# §scxml-B-2-8-1: the helper RETURNS the reading it gave the payload rather
   than recording it, because this function holds `L` and the event and not the
   machine — and handing it the machine so it can count would give a helper
   named for binding `_event` a second job. The six sibling backends answer the
   same way (rust `set_current_event -> ScriptResult<PayloadReading>`, cpp
   `SetCurrentEventResult`, go `(PayloadReading, error)`), so the caller below
   is the one place a rung becomes a statistic on every channel. #}
SCE_SM_FN static sce_payload_reading_t set_current_event(lua_State *L, const {{ csym_prefix }}{{ model.name }}_event_with_meta_t *evt) {
    (void)L;
    (void)evt;
    /* W3C SCXML 5.10.1 (test332): expose `evt->send_id` to the lua side
       via a transient global so the dispatch chunk below can embed it
       without per-event snprintf. Empty send_id (i.e. the meta field
       was zero-initialised by `<raise>` or non-`<send>` raises) is set to
       lua nil — test333 verifies that non-error events have `_event.sendid`
       blank, which lua-side reads as nil and ECMAScript surfaces as the
       same `undefined`/falsy contract the cpp engine returns through its
       optional-shaped `pendingEventSendId_` carry.

       W3C SCXML 5.10.1 (test331): `_event.type` is the spec's
       three-way category: 'platform' for events the SCXML processor
       itself raised (error.foo and done.foo families), 'internal'
       for events dispatched off the internal queue (e.g. <raise>),
       'external' for everything off the external queue (bare
       <send>, delayed <send>). cpp carries the literal on
       `EventWithMetadata.type` (StaticExecutionEngine.h:578 default
       'external'); C11 mirrors it via the `_pending_event_type` lua
       global written by process_event_queues' internal/external pop
       sites — the per-enum case below reads it back, with the
       error and done families overriding to 'platform' regardless
       of which queue popped them.

       W3C SCXML 5.10.1 (test336): `_event.origin` and
       `_event.origintype` carry the URL plus processor type the
       receiver can hand back to <send target=...> for bidirectional
       communication. cpp populates them from `EventWithMetadata`
       (StaticExecutionEngine.h:578: raiseExternal default
       `EventWithMetadata(event, data, sessionId, "", "external",
       SCXML_EVENT_PROCESSOR_TYPE)`); C11 mirrors via the
       `_pending_event_origin` / `_pending_event_origintype` lua
       globals seeded by process_event_queues' external pop, with
       this session's own published address (`sm->scxml_location`,
       issued alongside `_sessionid` in `_init`) as the origin
       value. Internal-queue pops leave both nil — W3C 5.10.1 only
       sets origin for events the SCXML processor accepted from an
       external producer.

       W3C SCXML 5.10.1 (.invokeid): cpp `LuaEngine::setCurrentEvent`
       (LuaEngine.cpp:1138-1139) pushes `invokeId.c_str()` onto
       `_event.invokeid` for every event — non-invoke events arrive
       with `Event::getInvokeId()` returning an empty std::string,
       cpp emits an empty lua string, C11 mirrors via the
       `_pending_event_invokeid` lua global with the
       `_pending_event_origin`/`_pending_event_origintype`
       precedent (undef=nil baseline + chunk-end reset). No
       process_event_queues pop site seeds it yet — both internal
       and external dequeues leave it nil, mirroring the empty
       string cpp emits for non-invoke events under the same
       lua-side absence semantic the sibling fields already use.
       The invoke dispatch path lands the seeding when the invoke
       milestone activates (cpp `Event::setInvokeId(invokeId)` at
       the invoke handler is the seed site to mirror). Lifted as
       spec-mirror parity rather than waiting for the first
       force fixture (feedback_spec_mirror_parity.md
       §"Spec-mirror parity (N-backend codegen)" — cpp's branch
       is the contract; missing the field would be silent
       semantic drift on the W3C 5.10.1 metadata family. */
    if (evt->send_id[0] != '\0') {
        lua_pushstring(L, evt->send_id);
    } else {
        lua_pushnil(L);
    }
    lua_setglobal(L, "_pending_send_id");
    /* W3C SCXML 5.10.1 (.invokeid, test228/338): seed the lua-side
       carry from the dequeued event's `invoke_id` meta field so the
       per-enum chunk below promotes it onto `_event.invokeid`. cpp's
       `LuaEngine::setCurrentEvent` (LuaEngine.cpp:1138-1139) emits the
       same value via `lua_pushstring(invokeId.c_str())` — non-invoke
       events arrive with an empty C string, which we convert to lua
       nil so the dispatch chunk's `invokeid = _pending_event_invokeid`
       reads as the same `undefined`/falsy contract cpp surfaces for
       `Event::getInvokeId().empty()`. The pop-side `current_event_
       invoke_id` cache (process_event_queues lines below) keeps the
       C-side state for any non-Lua consumers; the lua push here is
       what the ECMAScript datamodel reads. */
    if (evt->invoke_id[0] != '\0') {
        lua_pushstring(L, evt->invoke_id);
    } else {
        lua_pushnil(L);
    }
    lua_setglobal(L, "_pending_event_invokeid");
    /* W3C SCXML testing extension (.raw): cpp `JSEngineImpl.cpp:510` sets
       `_event.raw` to the unparsed event data string before donedata
       evaluation rewrites the slot into a typed table. C11 mirrors via
       `_pending_event_raw` seeded from `evt->data` (the raw bounded
       string buffer in `event_with_meta_t`); the per-enum chunk below
       binds it onto `_event.raw`. Empty data buffer maps to lua nil so
       `_event.raw` reads as the same falsy contract cpp surfaces for
       events arrived without a data payload. */
    if (evt->data[0] != '\0') {
        lua_pushstring(L, evt->data);
    } else {
        lua_pushnil(L);
    }
    lua_setglobal(L, "_pending_event_raw");
    switch (evt->event) {
    {% for event_name in model.events | sort %}
    case {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_{{ event_name | upper | replace('.', '_') | replace('-', '_') }}:
        (void)luaL_dostring(L,
            "_event = {name = '{{ event_name | escape_c }}', "
              {% if event_name.startswith('error.') or event_name.startswith('done.') %}
              "type = 'platform', "
              {% else %}
              "type = _pending_event_type, "
              {% endif %}
              "origin = _pending_event_origin, "
              "origintype = _pending_event_origintype, "
              "invokeid = _pending_event_invokeid, "
              "data = _pending_donedata, "
              "raw = _pending_event_raw, "
              "sendid = _pending_send_id}; "
            "_pending_donedata = nil; "
            "_pending_send_id = nil; "
            "_pending_event_type = nil; "
            "_pending_event_origin = nil; "
            "_pending_event_origintype = nil; "
            "_pending_event_invokeid = nil; "
            "_pending_event_raw = nil");
        break;
    {% endfor %}
    default:
        break;
    }
    /* W3C SCXML 6.2 / 6.4 (test233): hydrate `_event.data` from the
       payload the event itself carried. The per-enum chunk above binds
       `_event.data = _pending_donedata`, which is the right shape when
       the payload was staged in that slot by a same-SM `<send>` /
       `<raise>` / HTTP response (test176/179/519). It is not the right
       shape when the payload rode on the event's own `data` field: a
       cross-SM `parent_dispatch`, or an internal `<send>` with `<param>`
       children. Those carry a Lua table literal, so load it as a return
       expression and override.

       This sits inside `set_current_event` rather than beside one call
       site because every dequeue must apply the same rule. It lived in
       the external drain alone, and the internal drain — reached by
       exactly the `<send target="#_internal">` params path — silently
       kept `_pending_donedata`, which is nil there. Same defect class as
       the sibling emission blocks: one path learned the rule and its
       siblings did not. cpp's equivalent is `EventWithMetadata.data`
       set in `Event::setData`, surfaced via `LuaEngine::setCurrentEvent`
       (LuaEngine.cpp:1138-1159), which is likewise per-dequeue. */
    /* W3C SCXML 5.10 + B.2: the payload is DATA, so it crosses as a Lua
       value and is decoded in Lua — never pasted into Lua source.

       It used to be `snprintf("_event.data = (%s)", evt->data)` followed by an
       unchecked `luaL_dostring`, and that spelling had three separate faults,
       all of them silent. A payload an EMBEDDER hands in — the case
       `watching-zenoh` has on an MCU and `examples/ai_loop` has every turn —
       is normally JSON, and JSON is not a Lua expression: `{"a":1}` parses as
       a Lua ARRAY of "a" and 1, and `{"a": "b"}` does not parse at all, after
       which `_event.data` silently kept the PREVIOUS event's value. Measured
       2026-08-16 by the fixture below — this backend was the only one of six
       that failed it, because every other engine routes a host payload through
       a JSON-then-string decoder (cpp `EventDataHelper::jsonStringToScriptValue`).
       And a payload is host input: as Lua SOURCE it was executed, so an event's
       data could run arbitrary code in the session.

       `lua_pushstring` removes the source boundary, and the decode below
       removes the evaluation. The shape that stood here — a JSON key shim,
       then `load('return (' .. text .. ')')` + `pcall` — still RAN the
       payload: `2 + 3` from a host arrived as the number 5 (the string
       "2 + 3" on cpp and Rhino, which read §scxml-B-2-8-1 instead), and a
       payload that is a call executed, now inside a chunk rather than
       inside interpolated source. What the clause gives the payload is
       three readings — XML → DOM, JSON → value, otherwise a
       space-normalized string — and `JSON.parse` is a parser as of the
       same change, so this is those readings and nothing else. Its second
       return distinguishes a successful `null` from a refusal.

       The chunk is a fixed string with nothing interpolated, so its result
       is checked: a failure here is this engine's own invariant breaking,
       and W3C 4.9's `<log>` seam is where such a thing is said out loud
       rather than swallowed. */
    if (evt->data[0] != '\0') {
        /* §scxml-B-2-8-1's first rung, which this backend did not have: "if
           the Processor can interpret the content as a valid XML document, it
           MUST create the corresponding DOM structure". `sce_lua_dom_push_object`
           was defined, documented and reachable, and its only callers were the
           `<data>` paths — so a document that received an XML payload BY EVENT
           read a space-normalized string here and a DOM on all six siblings.
           Measured 2026-08-19; the same round found three siblings answering
           nil where this one already fell through, so the two halves of the
           clause were each missing from a different set of backends.

           The reporting form is what makes the fall-through possible: it
           pushes nothing when the content is not a document, and the readings
           below run exactly as before. */
        const char *_scan = evt->data;
        while (*_scan == ' ' || *_scan == '\t' || *_scan == '\r' || *_scan == '\n') {
            _scan++;
        }
        if (*_scan == '<' && sce_lua_dom_push_object(L, evt->data) == 1) {
            lua_getglobal(L, "_event");
            lua_pushvalue(L, -2);
            lua_setfield(L, -2, "data");
            lua_pop(L, 2);
            return SCE_PAYLOAD_DOM;
        }
        lua_pushstring(L, evt->data);
        lua_setglobal(L, "_sce_raw_event_data");
        /* §scxml-B-2-8-1: the chunk reports which of the two remaining rungs
           it took, because only the side that ATTEMPTED the structured read
           knows whether it attempted one. A caller inspecting `_event.data`
           afterwards can tell a string from a table, but not a string chosen
           because the content was prose from one chosen because the parse
           refused — and that is exactly the difference a host acts on.

           `_sce_payload_decoded` rather than a return value: `luaL_dostring`
           answers only whether the chunk itself ran, and the chunk running is
           this engine's invariant rather than the payload's reading. */
        if (luaL_dostring(L,
                          "do "
                          "local _c = _sce_raw_event_data; "
                          "local _val, _ok = JSON._parse_document(_c); "
                          "if _ok then _event.data = _val "
                          "else _event.data = _scxml_normalize_ws(_c) end; "
                          "_sce_payload_decoded = _ok and true or false; "
                          "_sce_raw_event_data = nil "
                          "end") != 0) {
            (void)fprintf(stderr, "SCE: event payload decode failed: %s\n",
                          lua_tostring(L, -1) != NULL ? lua_tostring(L, -1) : "unknown error");
            lua_pop(L, 1);
            /* The chunk itself broke, so `_event.data` holds whatever the
               previous delivery left. That is this engine's invariant failing
               rather than the payload's reading, and it is already said out
               loud above; claiming a rung here would file an engine fault
               under the host's payload. */
            return SCE_PAYLOAD_ABSENT;
        }
        lua_getglobal(L, "_sce_payload_decoded");
        const bool _decoded = lua_toboolean(L, -1) != 0;
        lua_pop(L, 1);
        lua_pushnil(L);
        lua_setglobal(L, "_sce_payload_decoded");
        /* The third rung splits in two, and `sce_payload_reading_of_text` is
           where that split is defined for every C11 machine — see the header
           for why only `{` and `[` announce structure. */
        return _decoded ? SCE_PAYLOAD_STRUCTURED : sce_payload_reading_of_text(evt->data);
    }
    return SCE_PAYLOAD_ABSENT;
}

/* §scxml-B-2-8-1: turn the reading above into something the host can read
   back. Called at the dequeue sites rather than inside the helper so that the
   event being recorded is the event being DELIVERED — cpp learned this the
   hard way, where the guard that restores the previous `_event` runs later and
   a count taken after it describes a different delivery.

   Only `SCE_PAYLOAD_UNDECODABLE` is recorded. The other four are the clause
   working, and a statistic that also counts success cannot be used to detect
   failure without the host re-deriving which of the two it was told about. */
SCE_SM_FN static void note_payload_reading({{ csym_prefix }}{{ model.name }}_t *sm,
                            const {{ csym_prefix }}{{ model.name }}_event_with_meta_t *evt,
                            sce_payload_reading_t reading) {
    if (sm == NULL || evt == NULL || reading != SCE_PAYLOAD_UNDECODABLE) {
        return;
    }
    sm->undecodable_payloads++;
    sm->last_undecodable_payload = evt->event;
    sm->has_undecodable_payload = true;
}
{% endif %}

/* W3C SCXML App.D.2 (mainEventLoop): drain internal then external queue,
   interleaving eventless evaluation between every event dispatch. The
   spec's main loop alternates `selectEventlessTransitions` and
   `internalQueue.dequeue` so any eventless transition whose cond depends
   on a transient datamodel snapshot (e.g. test329's `Var2 == _event`,
   where `_event` is re-bound on every dequeue via `set_current_event`)
   gets its chance before the next event overwrites the binding. The
   per-event eventless pass runs to its own quiescence (eventless can
   raise more events that fold back into the queue draining); the cpp
   engine reaches the same shape via `EventProcessingAlgorithms::
   checkEventlessTransitions` calling `processInternalEventQueue` after
   each fired eventless transition. The enabled-list buffer is stack-
   local at the function scope; reused across both queues and the
   eventless interleave per W3C App.D Step 1 (each event drives an
   independent microstep). External-queue processing also interleaves so
   the W3C "external event → microstep → drain internal → eventless"
   sequence matches the cpp `processMacrostep` body. Forward declared
   so the eventless loop and queue drain can call each other; the
   eventless function definition follows. */
SCE_SM_FN static void check_eventless_transitions({{ csym_prefix }}{{ model.name }}_t *sm);

{% if model.has_autoforward_invoke %}
/* W3C SCXML 6.4 (test229): forward each external event to active
   autoforward children, via a per-event switch arm that calls the child's
   `_raise_external_forwarded` shim with the parent-side event-name string.
   The shim ignores names not in the child's enum (silently falls through),
   so a child SM with a smaller event vocabulary than the parent is safely
   tolerated.

   W3C SCXML Appendix D `mainEventLoop` forwards whatever it dequeued from
   the external queue without testing the event's name, so no name-based
   platform-event filter belongs here. `error.*` and `done.state.*` stay
   out of the forwarded set structurally — they are raised onto the
   internal queue, and this function is reachable only from the external
   drain below. `done.invoke.<id>` is in the set by W3C SCXML 6.4.2, which
   returns it "to the external event queue of the invoking process": a
   sibling invoke that is still running must see it.

   The exclusions that remain are not events. `cancel.invoke` mirrors
   Appendix D's `isCancelEvent` arm, which `continue`s past the forward
   block entirely; the wildcard sentinel and the empty-name placeholder are
   codegen bookkeeping with no name to copy. */
SCE_SM_FN static void {{ csym_prefix }}{{ model.name }}_forward_to_autoforward_children({{ csym_prefix }}{{ model.name }}_t *sm,
        const {{ csym_prefix }}{{ model.name }}_event_with_meta_t *evt) {
    /* W3C SCXML 6.4: the copy handed to each child is exact, so the source
       event's fields are packed into the transport-neutral carrier once and
       reused across every autoforward child on this event. The per-event
       switch below fills in the name. */
    sce_forwarded_event_t fwd;
    memset(&fwd, 0, sizeof(fwd));
    sce_copy_bounded_data(fwd.data, evt->data);
    sce_copy_bounded_origin(fwd.origin, evt->origin);
    sce_copy_bounded_id(fwd.send_id, evt->send_id);
    sce_copy_bounded_event_type(fwd.type, evt->type);
    sce_copy_bounded_id(fwd.origin_type, evt->origin_type);
    sce_copy_bounded_id(fwd.invoke_id, evt->invoke_id);
    switch (evt->event) {
        {% for ev_name in model.events | sort %}
        {% if ev_name and ev_name != 'Wildcard' and ev_name != 'cancel.invoke' %}
        case {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_{{ ev_name | upper | replace('.', '_') | replace('-', '_') }}:
            sce_copy_bounded_id(fwd.name, "{{ ev_name }}");
            {% for state_id, state in model.states | dictsort %}
            {% for invoke_info in state.invokes | scxml %}
            {% if invoke_info.autoforward and invoke_info.child_has_send_to_parent %}
            if (sm->child_{{ invoke_info.field_suffix }}_active) {
                {{ csym_prefix }}{{ invoke_info.child_name }}_raise_external_forwarded(
                    &sm->child_{{ invoke_info.field_suffix }}, &fwd);
            }
            {% endif %}
            {% endfor %}
            {% endfor %}
            break;
        {% endif %}
        {% endfor %}
        default: break;
    }
}
{% endif %}

/* W3C SCXML 3.13: publish a macrostep this engine stopped short, from
   whichever branch of Appendix D's inner loop ran out of budget.

   One function, two callers, for the reason the budget is one number: a host
   reads a macrostep that did not reach a stable configuration, and the branch
   it died in is a detail of the document, not of the contract. Two copies of
   this would be two chances for one of them to stop setting the flag that
   keeps the same chain from being handed a second budget. */
SCE_SM_FN static void record_truncated_macrostep({{ csym_prefix }}{{ model.name }}_t *sm,
                                                 {{ csym_prefix }}{{ model.name }}_state_t state) {
    sm->truncated_macrosteps++;
    sm->last_truncated_macrostep_state = state;
    sm->has_truncated_macrostep = true;
    sm->macrostep_truncated = true;
}

/* W3C SCXML C.1: drain the internal queue (high priority).

   Bounded by the same macrostep budget the eventless branch spends, and for
   the same reason: a `<raise>` answered by a transition that raises again is a
   macrostep that never ends, exactly as a cyclic eventless transition is.
   Until 2026-08-20 this branch had no ceiling in any of the seven engines
   here, so that document did not return at all. */
SCE_SM_FN static void process_internal_queue({{ csym_prefix }}{{ model.name }}_t *sm) {
    {{ csym_prefix }}{{ model.name }}_event_with_meta_t evt;
    {{ csym_prefix }}{{ model.name }}_transition_info_t enabled[SCE_MAX_ENABLED_TRANSITIONS];
    uint8_t count;

    if (sm->macrostep_truncated) {
        /* The eventless branch of this same macrostep already ran out of
           budget. Draining now would hand the chain a second one. */
        return;
    }
    while (sm->internal_queue.count != 0u) {
        if (sm->macrostep_microsteps_taken == SCE_MAX_MACROSTEP_MICROSTEPS) {
            /* Work is still queued one microstep past the budget. Refuse the
               microstep rather than take it: the event stays on the queue,
               which is where the next macrostep will find it, and the count
               says the configuration a host reads now is not a stable one.

               The source of the transition this drain last took. This profile
               keeps its configuration in a bitmap rather than a scalar, so
               there is no "state the drain is standing in" to name; the source
               is a state on the chain that could not settle, which is the same
               answer the eventless branch above gives. */
            record_truncated_macrostep(sm, sm->policy.last_transition_source_state);
            return;
        }
        if (!event_queue_pop(&sm->internal_queue, &evt)) {
            break;
        }
        sce_copy_bounded_id(sm->current_event_invoke_id, evt.invoke_id);
        {% if event_payload_active %}
        /* NL→IR Item C1 Path A: lift the dequeued event's typed payload so
           native transition guards read `sm->pending_payload.as.<event>`.
           Twin of the Rust policy's `populate_event_payload`. */
        sm->pending_payload = evt.payload;
        {% endif %}
        {% if model.needs_script_engine %}
        /* W3C SCXML 5.10.1 (test331): seed `_event.type` carry — internal
           queue pop is the spec's 'internal' category. set_current_event's
           per-enum case reads `_pending_event_type` back, with the
           error and done event families overriding to 'platform'. */
        (void)luaL_dostring(sm->L, "_pending_event_type = 'internal'");
        note_payload_reading(sm, &evt, set_current_event(sm->L, &evt));
        {% endif %}

        if ({{ csym_prefix }}{{ model.name }}_is_in_final_state(sm)) {
            return;
        }

{% if error_events %}
        /* W3C SCXML 3.12.2: an error raised from here on is raised BY an error
           handler, which is the one situation the engine cannot leave to the
           document -- the handler that failed is the same one that will answer
           the failure. `_raise` reads this flag to tell that apart from a
           first failure, and it is cleared before anything else runs so a
           chain cannot be attributed to the wrong event.

           A dispatch that is not an error does NOT end the chain. An earlier
           draft reset the depth on every non-error event, which reads as the
           careful choice and is the opposite: a handler that raises its own
           event before failing -- a document that logs, then fails, which is
           most of them -- leaves the queue alternating tick, error, tick,
           error..., and each tick put the ceiling back out of reach. The count
           needs no such guard, because it only ever rises while an error
           handler is running. */
        sm->handling_error_event = event_is_error(evt.event);
{% endif %}
        if (process_transition(sm, evt.event, enabled, &count)) {
            count = remove_conflicting_transitions(enabled, count);
            handle_microstep(sm, enabled, count);
            /* W3C SCXML Appendix D: the loop turn that selects nothing takes
               no microstep, so it spends no budget. Only a turn that answered
               the event moved the machine, and only those are what a ceiling
               on microsteps can be counted in. */
            sm->macrostep_microsteps_taken++;
        }
{% if error_events %}
        /* W3C SCXML 3.12.2: the processor raises `error.*` into this queue and
           the clause says they "are ignored if no transition is found that
           matches them". Ignoring them is the clause; staying silent about it
           is not. `_discarded_external_events` deliberately stops at the
           external queue because an unmatched `<raise>` has both ends inside
           the document -- but the sender of an error event is this engine, so
           that reasoning does not reach it. The host never wrote the document,
           cannot see the failure in the configuration, and is the only party
           able to act on it. */
        else if (event_is_error(evt.event)) {
            sm->unhandled_error_events++;
            sm->last_unhandled_error = evt.event;
            sm->has_unhandled_error = true;
        }
        /* The dispatch is over, so an error raised after this line is a first
           failure again rather than a link in this event's chain. */
        sm->handling_error_event = false;
{% endif %}

        /* W3C App.D.2: re-evaluate eventless transitions before the next
           dequeue so cond expressions reading the current `_event`
           binding (test329: `Var2 == _event` where Var2 captured the
           reference) fire while the binding still holds. */
        check_eventless_transitions(sm);
    }
{% if error_events %}
    /* The queue emptied, so the chain -- refused or merely finished -- is
       over. A machine whose next macrostep starts a new one starts it from
       zero, and the count of what was refused stays where the host reads it. */
    sm->error_cascade_depth = 0u;
{% endif %}
}

/* W3C SCXML Appendix D `mainEventLoop`: take exactly one event off the
   external queue, run the preliminary `<finalize>` / autoforward step
   against it, then select transitions. Reports whether an event was
   processed.

   One event, not a drain: the algorithm returns to the top of the outer
   loop after each external event, so a state entered by this event's
   transition gets its `<invoke>` elements started before the next event is
   dequeued. Draining to exhaustion here consumes what that state's
   `<onentry>` queued while its invoke is still pending, and an autoforward
   child never sees it. */
SCE_SM_FN static bool process_next_external_event({{ csym_prefix }}{{ model.name }}_t *sm) {
    {{ csym_prefix }}{{ model.name }}_event_with_meta_t evt;
    {{ csym_prefix }}{{ model.name }}_transition_info_t enabled[SCE_MAX_ENABLED_TRANSITIONS];
    uint8_t count;

    if (event_queue_pop(&sm->external_queue, &evt)) {
        /* W3C SCXML Appendix D: taking an event off the external queue is
           where a macrostep begins, so it is where the previous one's ceiling
           stops applying. A machine left inside an endless chain gets a full
           budget for each event it is given, and each refusal is counted
           separately — which is what tells a host that spins once from one
           that spins on everything.

           Here and not at the entry to `run_main_event_loop`, which reads like
           the more general boundary and is not one: a machine whose chain was
           refused would spend a whole budget re-walking it before it ever
           looked at the event the host sent to get it out. The refused events
           stay queued either way — this is where the budget that drains them
           comes back. */
        sm->macrostep_truncated = false;
        sm->macrostep_microsteps_taken = 0u;
        sce_copy_bounded_id(sm->current_event_invoke_id, evt.invoke_id);
        {% if event_payload_active %}
        /* NL→IR Item C1 Path A: lift the dequeued event's typed payload so
           native transition guards read `sm->pending_payload.as.<event>`.
           Twin of the Rust policy's `populate_event_payload`. The external
           queue is where the per-event `raise_<event>_typed` entries
           enqueue. */
        sm->pending_payload = evt.payload;
        {% endif %}
        {% if model.needs_script_engine %}
        /* W3C SCXML 5.10.1 (test331/336): seed `_event.type` /
           `_event.origin` / `_event.origintype` carry — external
           queue pop is the spec's 'external' category (bare <send>,
           scheduled <send>, ECMAScript host events all enqueue
           here); origintype is the SCXMLEventProcessor URI literal so a
           receiver's `<send target=_event.origin
           typeexpr=_event.origintype/>` round-trips into the same
           external queue (test336).

           W3C SCXML C.1: origin is the location the SENDING session
           published. An event that arrived from another session carries
           that address in `evt.origin` — overwriting it with this
           machine's own would make every event look self-sent, which is
           indistinguishable from correct only while the sender and the
           receiver are the same session (test336 and test350 are both
           that shape, which is why this held for so long). A bare
           `<send>` with no target IS self-addressed and carries no
           origin, so the fallback is this session's own published
           location — the same `_scxml_location` its `_ioprocessors`
           entry advertises, not the bare `_sessionid`, because C.1
           requires the two to be the same string. */
        if (evt.origin[0] != '\0') {
            lua_pushstring(sm->L, evt.origin);
        } else {
            lua_pushnil(sm->L);
        }
        lua_setglobal(sm->L, "_pending_event_origin_carry");
        (void)luaL_dostring(sm->L,
                            "_pending_event_type = 'external'; "
                            "_pending_event_origin = "
                              "_pending_event_origin_carry or _scxml_location; "
                            "_pending_event_origin_carry = nil; "
                            "_pending_event_origintype = "
                              "'http://www.w3.org/TR/scxml/#SCXMLEventProcessor'");
        /* `_event.data` hydration from `evt.data` now happens inside
           `set_current_event`, so the internal drain gets the same rule
           this site used to hold alone. */
        note_payload_reading(sm, &evt, set_current_event(sm->L, &evt));
        {% endif %}

        if ({{ csym_prefix }}{{ model.name }}_is_in_final_state(sm)) {
            /* The event was removed from the queue, so report it consumed;
               the caller's loop stops on the final-state check either way. */
            return true;
        }

        {% set _has_finalize = namespace(any=false) %}
        {% for state_id, state in model.states | dictsort %}
        {% for invoke_info in state.invokes | scxml %}
        {% if invoke_info.finalize_content %}
        {% set _has_finalize.any = true %}
        {% endif %}
        {% endfor %}
        {% endfor %}
        {% if _has_finalize.any %}
        /* W3C SCXML 6.4 (test233): run the matching invoke's
           `<finalize>` body in the parent's lua_State BEFORE transition
           selection. The finalize body reads `_event.data.<key>` (just
           hydrated above) and writes parent variables — so the
           subsequent transition cond evaluates against post-finalize
           state. The match is by `evt.invoke_id` against the spawn-time
           id stamped by `execute_pending_invokes` so events arriving
           from one invoke don't trigger a sibling's finalize (the
           test234 parallel-finalize fixture pins this isolation). cpp
           `StateMachine::processEvent` runs finalize via the
           `InvokeExecutor::executeFinalize(invokeid)` arm at the
           equivalent point; the same content was lowered to JS by the
           parser, so `to_lua_script` ports it across the syntax overlap
           (Lua and JS both spell `Var = _event.data.aParam` the same). */
        {% for state_id, state in model.states | dictsort %}
        {% for invoke_info in state.invokes | scxml %}
        {% if invoke_info.finalize_content %}
        if (sm->child_{{ invoke_info.field_suffix }}_active
            && evt.invoke_id[0] != '\0'
            && strcmp(evt.invoke_id, sm->child_{{ invoke_info.field_suffix }}_invoke_id) == 0) {
            (void)luaL_dostring(sm->L,
                "{{ invoke_info.finalize_content | to_lua_script | escape_c }}");
        }
        {% endif %}
        {% endfor %}
        {% endfor %}
        {% endif %}

        {% if model.has_autoforward_invoke %}
        /* W3C SCXML 6.4 (test229): forward this external event to any
           active autoforward children BEFORE running parent-side
           transition matching, so the child's enqueued copy is in its
           external queue by the time the post-step `_drive_active_children`
           call drains it inside the same macrostep. The forward and the
           parent's own transition firing are independent — both can match
           the same event (test229's parent has a no-target
           `<transition event="childToParent"/>` that consumes but does not
           change configuration; the forward still delivers a copy to the
           child). cpp orders the same way (StateMachine.cpp:683 runs
           autoforward before findApplicableTransitions). */
        {{ csym_prefix }}{{ model.name }}_forward_to_autoforward_children(sm, &evt);
        {% endif %}

        if (process_transition(sm, evt.event, enabled, &count)) {
            count = remove_conflicting_transitions(enabled, count);
            handle_microstep(sm, enabled, count);
        } else {
            /* W3C SCXML 3.1.2: "If no transition matches in any state, the
               event is discarded." Discarding it is the rule; being unable to
               say so is not part of the rule. The host that queued this event
               is the one party that cannot see the outcome -- a discard leaves
               the configuration exactly as a self transition does -- and the
               party that got the event wrong. Recorded for the external queue
               only: an internal `<raise>` that matches nothing has both its
               ends inside the document. */
            sm->discarded_external_events++;
            sm->last_discarded_event = evt.event;
            sm->has_discarded_event = true;
        }

        check_eventless_transitions(sm);
        return true;
    }
    return false;
}

/* W3C SCXML 3.13 (Appendix D, eventless microstep loop):
   Repeat eventless transitions until the configuration stops changing or a
   top-level final state is reached. Each iteration's enabled list is built
   fresh, conflict-resolved, then executed atomically — same shape as cpp's
   per-microstep collection.

   §scxml-3.13 says the chain ends in a configuration where nothing is enabled
   by NULL, and the specification's Principles and Constraints say that chain
   need not exist ("A macrostep may not [terminate] ... This is currently
   allowed"). SCE_MAX_MACROSTEP_MICROSTEPS is where this engine declines that,
   and `_truncated_macrosteps` is how the host learns it did: the ceiling is on
   microsteps TAKEN, and the refusal is recorded only when a transition was
   still enabled after them, so a document whose chain ends exactly at the
   ceiling passes through untouched.

   The budget is the macrostep's rather than this call's, and it is spent by
   the internal-event branch too — see `process_internal_queue`. */
SCE_SM_FN static void check_eventless_transitions({{ csym_prefix }}{{ model.name }}_t *sm) {
    {{ csym_prefix }}{{ model.name }}_transition_info_t enabled[SCE_MAX_ENABLED_TRANSITIONS];
    uint8_t count;
    if (sm->macrostep_truncated) {
        /* This macrostep was already stopped at the ceiling. Re-entering the
           drain would hand the same chain a second budget, which is the
           runaway the ceiling exists to refuse. */
        return;
    }
    while (true) {
        if ({{ csym_prefix }}{{ model.name }}_is_in_final_state(sm)) {
            return;
        }
        if (!process_transition(sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_NONE, enabled, &count)) {
            /* Nothing is enabled by NULL — the macrostep reached the stable
               configuration the clause describes, and nothing was refused
               however long the chain was. */
            return;
        }
        if (sm->macrostep_microsteps_taken == SCE_MAX_MACROSTEP_MICROSTEPS) {
            /* The chain is still going one microstep past the budget. Refuse
               it rather than take it, and publish the refusal: the
               configuration left behind is not a stable one and only this
               counter says so.

               The source of the transition that was refused. This profile
               keeps its configuration in a bitmap rather than a scalar, and
               the source is the more useful answer anyway: it is a state on
               the cycle that could not settle. */
            record_truncated_macrostep(sm, enabled[0].source);
            return;
        }
        count = remove_conflicting_transitions(enabled, count);
        handle_microstep(sm, enabled, count);
        sm->macrostep_microsteps_taken++;
    }
}

/* W3C SCXML Appendix D `mainEventLoop` — the outer loop, and the only place
   this machine's entry points (`_init`, `_step`, `_tick`) express macrostep
   semantics.

   Appendix D names the external queue exactly once per iteration and it is
   after `invoke(inv)`:

     while running:
         while running and not macrostepDone:      # eventless + internal only
             ... selectEventlessTransitions() / internalQueue.dequeue() ...
         for state in statesToInvoke.sort(entryOrder):
             for inv in state.invoke.sort(documentOrder):
                 invoke(inv)
         statesToInvoke.clear()
         if not internalQueue.isEmpty(): continue
         externalEvent = externalQueue.dequeue()

   Folding the external drain into the macrostep-completion loop instead is a
   different algorithm, not a shorter one. The invoked children do not exist
   yet while that drain runs, so everything `<onentry>` queued for this
   session on the way in is consumed with no autoforward child to receive it
   — and there is no later point at which it is delivered. */
SCE_SM_FN static void run_main_event_loop({{ csym_prefix }}{{ model.name }}_t *sm) {
    while (true) {
        /* W3C SCXML Appendix D: complete the macrostep on eventless
           transitions and internal events alone. */
        while (true) {
            check_eventless_transitions(sm);
            if (sm->internal_queue.count == 0u) {
                break;
            }
            process_internal_queue(sm);
            if (sm->macrostep_truncated) {
                /* Either branch may have spent the last of the budget. Without
                   this the loop turns forever on a chain that is no longer
                   being drained: the queue stays non-empty precisely because
                   the drain refused it. */
                break;
            }
        }

        if ({{ csym_prefix }}{{ model.name }}_is_in_final_state(sm)) {
            /* §scxml-D-mainEventLoop ends here, and whatever the host put on
               the external queue ends with it. That is the clause: a machine
               that reached a top-level final state has exited the interpreter.
               Saying nothing about it is not the clause — see
               `_unseen_external_events`. */
            record_unseen_external_events(sm);
            break;
        }

        {% if (model.invokes | scxml_family) or (model.invokes | unsupported) %}
        /* W3C SCXML 6.4: execute the deferred `<invoke>` elements for states
           entered-and-not-exited during this macrostep. Children that reach
           their top-level <final> synchronously (test247 pattern: child has
           only `<final>` as initial) raise `done.invoke` onto the external
           queue here, which this loop's next iteration drains. */
        {{ csym_prefix }}{{ model.name }}_execute_pending_invokes(sm);
        {% if model.invokes | scxml_family %}
        /* W3C SCXML 6.4 (test192): drive active children so events the parent
           enqueued onto a child's external queue earlier in this macrostep
           (via `<send target="#_<invokeid>">`) get drained inside the same
           loop. A child that reaches `<final>` here has its `done.invoke`
           raised onto the parent's external queue for the next iteration.

           Narrower than the guard above on purpose: a §scxml-6.4.1
           unsupported `type` defers and raises but starts no child, so a
           machine whose only `<invoke>` is unsupported has no active-child
           walk to run — and emitting one would leave `sm` unread under
           `-Wunused-parameter -Werror`. */
        {{ csym_prefix }}{{ model.name }}_drive_active_children(sm);
        {% endif %}
        {% endif %}

        /* W3C SCXML Appendix D: invoking may have raised internal error
           events; handle them before touching the external queue.

           Not when this macrostep was already stopped at the ceiling: the
           queue is non-empty because the drain refused it, so looping back is
           a spin that takes no microstep, records nothing, and never ends.
           Falling through to the external dequeue instead is what keeps a
           machine inside an endless chain reachable at all -- the event that
           rescues it is on that queue, and the clause's priority would
           otherwise hold it behind a chain that never ends. */
        if (!sm->macrostep_truncated && sm->internal_queue.count != 0u) {
            continue;
        }

        if (!process_next_external_event(sm)) {
            break;
        }
    }
}

SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_step({{ csym_prefix }}{{ model.name }}_t *sm) {
{% if model.needs_event_scheduler %}
    /* §scxml-3.13: one host call, one reading. The macrostep below can enter a
       state whose `<onentry>` arms several `<send delay>`s, and they are one
       instant's worth of executable content however long the host takes to run
       them — see `begin_turn`. */
    bool _turn_opened = begin_turn(sm);
{% endif %}
    run_main_event_loop(sm);
    if ({{ csym_prefix }}{{ model.name }}_is_in_final_state(sm) && sm->completion_callback != NULL) {
        sm->completion_callback(sm->completion_callback_user_data);
    }
{% if model.needs_event_scheduler %}
    end_turn(sm, _turn_opened);
{% endif %}
}

{% if model.needs_event_scheduler %}
/* W3C SCXML 6.2: Polling-loop entry point. Pumps every elapsed scheduled
   `<send delay>` entry onto the external queue, then runs a normal
   macrostep. Mirrors cpp `StaticExecutionEngine::tick()` (see
   `sce/include/static/StaticExecutionEngine.h`) — the same composition
   of `pumpScheduledEvents()` + `step()` that drives `runUntilCompletion`.
   The host calls this in a loop alongside its sleep / poll-interval
   primitive; the W3C spec is silent on poll cadence so the choice
   belongs to the runner. */
SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_tick({{ csym_prefix }}{{ model.name }}_t *sm) {
    if (!sm->is_running) {
        return;
    }
    if ({{ csym_prefix }}{{ model.name }}_is_in_final_state(sm)) {
        if (sm->completion_callback != NULL) {
            sm->completion_callback(sm->completion_callback_user_data);
        }
        return;
    }

    /* §scxml-3.13: one turn, one reading. Everything below judges due against
       the instant this tick began, and everything the macrosteps below arm is
       measured from it — so a tick dispatches what was due when the host called
       it, and cannot be extended by how long it takes to run. */
    bool _turn_opened = begin_turn(sm);

    /* W3C SCXML 6.2/6.3: dispatch the elapsed entries one macrostep apart
       rather than pumping them together. `<cancel>` drops an entry that has
       not been dispatched yet, and a host that ticked late holds several past
       their fire times: pumping them all first makes every later one
       undroppable before the earlier one's transitions have run. That is how
       a settle timer — arm a long `<send delay>`, cancel it when the short
       signal arrives first — delivers the event it was told to cancel
       (measured 2026-08-19 on the rust, go and python backends, whose
       scheduler this one mirrors). */
    uint64_t now_ms = sched_now_ms(sm);
    {{ csym_prefix }}{{ model.name }}_scheduled_entry_t ready;
    while (scheduled_pop_ready(sm, now_ms, &ready)) {
{% if model.has_delayed_host_send %}
        /* W3C SCXML 6.2.4: the wait is over, so now the act happens.
           Everything the immediate send site does happens here instead —
           including `_perform_host_send`'s W3C SCXML 6.2 report for a
           declared type nobody registered, which that site cannot make
           for a deferred send because it returned when the send was
           armed. The request is rebuilt over the entry's OWN buffers: the
           values were evaluated at send time and the block that computed
           them is long gone. */
        if (ready.host_send) {
{% if model.delayed_host_send_max_params > 0 %}
            sce_host_send_param_t _ready_params[{{ model.delayed_host_send_max_params }}];
            for (uint8_t _p = 0; _p < ready.host_param_count; ++_p) {
                _ready_params[_p].name = ready.host_param_names[_p];
                _ready_params[_p].value = ready.host_param_values[_p];
            }
{% endif %}
            sce_host_send_request_t _ready_req;
            _ready_req.processor_type = ready.host_processor_type;
            _ready_req.event_name = ready.host_event_name;
            _ready_req.target = ready.host_target;
            _ready_req.content = ready.host_content;
            _ready_req.send_id = ready.send_id;
{% if model.delayed_host_send_max_params > 0 %}
            _ready_req.params = ready.host_param_count > 0u ? _ready_params : NULL;
            _ready_req.param_count = (int)ready.host_param_count;
{% else %}
            _ready_req.params = NULL;
            _ready_req.param_count = 0;
{% endif %}
            {{ csym_prefix }}{{ model.name }}_perform_host_send(sm, &_ready_req);

            /* The macrostep this act drives may `<cancel>` a later entry,
               so the queue is re-consulted after it rather than before. */
            run_main_event_loop(sm);
            if (!sm->is_running || {{ csym_prefix }}{{ model.name }}_is_in_final_state(sm)) {
                break;
            }
            continue;
        }
{% endif %}
{% if model.has_parent_communication %}
        /* W3C SCXML 6.2 + 6.4 (test187): a `to_parent` entry routes
           through `parent_dispatch` instead of the local raise path —
           the parent's enum is foreign to this SM so we carry the
           event NAME and let the parent's `dispatch_external_by_name`
           shim resolve it. The NULL guard mirrors the cancellation
           drop semantics in `_finalize_session`'s sibling cancel arm
           (test252-shape): if the parent already cleared the dispatch
           pointer, the in-flight delayed send falls away silently. */
        if (ready.to_parent) {
            if (sm->parent_dispatch != NULL) {
                /* W3C SCXML 6.2 (test187): delayed `<send target="#_parent">`
                   without `<param>` carries no payload; pass NULL so the
                   parent shim's `event_data` arm is a no-op. The fixture
                   that combines delay + param would land here once the
                   first such fixture exists. */
                sm->parent_dispatch(sm->parent_sm, ready.to_parent_event, sm->invoke_id, NULL);
            }
            continue;
        }
{% endif %}
        {{ csym_prefix }}{{ model.name }}_event_with_meta_t evt;
        memset(&evt, 0, sizeof(evt));
        evt.event = ready.event;
        /* Both arrays are SCE_MAX_ID_LEN-sized and `scheduled_push` always
           writes a terminating NUL inside the buffer, so a verbatim
           memcpy of the whole array transfers the string and its
           terminator without tripping `-Wstringop-truncation` (which
           strncpy would since src is a same-size buffer). */
        memcpy(evt.send_id, ready.send_id, (size_t)SCE_MAX_ID_LEN);
{% if model.needs_script_engine %}
        /* W3C SCXML 5.10 (test186): restore the per-entry payload table
           onto `_pending_donedata` so the next dequeue's set_current_event
           promotes it onto `_event.data` (mirrors cpp's
           EventWithMetadata::data → LuaEngine::setCurrentEvent delivery).
           luaL_unref releases the registry slot synchronously; LUA_NOREF
           entries (delay-only sends, no <param>) bypass the restore. */
        if (ready.payload_lua_ref != LUA_NOREF) {
            lua_rawgeti(sm->L, LUA_REGISTRYINDEX, ready.payload_lua_ref);
            lua_setglobal(sm->L, "_pending_donedata");
            luaL_unref(sm->L, LUA_REGISTRYINDEX, ready.payload_lua_ref);
        }
{% endif %}
        {{ csym_prefix }}{{ model.name }}_raise_external(sm, &evt);

        /* The macrostep this entry drives may `<cancel>` a later one, so the
           queue is re-consulted after it rather than before. The reading is
           not: `now_ms` is this turn's instant, so a tick cannot chase the
           deadlines its own slowness created (see `sched_now_ms`). */
        run_main_event_loop(sm);
        if (!sm->is_running || {{ csym_prefix }}{{ model.name }}_is_in_final_state(sm)) {
            break;
        }
    }

    {{ csym_prefix }}{{ model.name }}_step(sm);
    end_turn(sm, _turn_opened);
}

/* W3C SCXML 6.2: how long until this machine next needs `_tick`, in
   milliseconds; 0 when an entry is due now and -1 when nothing is scheduled.

   `{{ csym_prefix }}{{ model.name }}_needs_event_scheduler` (the generated
   policy constant) says *which* entry point to drive the machine with. This
   says *when*, and a host that cannot ask has only one move left: pick a poll
   interval — which cannot straddle two fire times it was never told about.
   The queue is sorted by fire time, so the answer is its head. */
SCE_SM_FN int64_t {{ csym_prefix }}{{ model.name }}_time_until_next_scheduled_ms(const {{ csym_prefix }}{{ model.name }}_t *sm) {
    if (sm->scheduled_queue.count == 0u) {
        return -1;
    }
    uint64_t now_ms = sched_now_ms(sm);
    uint64_t due = sm->scheduled_queue.buf[0].fire_time_ms;
    if (due <= now_ms) {
        return 0;
    }
    return (int64_t)(due - now_ms);
}

SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_advance_time_ms({{ csym_prefix }}{{ model.name }}_t *sm, uint64_t ms) {
    if (!sm->clock.manual) {
        /* Not a no-op with a shrug: the caller believes it owns time and does
           not, so the events it is waiting for would arrive on a schedule it
           did not choose. The sibling backends throw here; this tier has no
           exception and must not abort a host process, so it says it once and
           refuses to move a clock that is not the host's. */
        static bool _said = false;
        if (!_said) {
            _said = true;
            (void)fprintf(stderr,
                          "[sce] {{ model.name }}_advance_time_ms: this machine's clock is not "
                          "sce_clock_manual, so the host does not own its time. Start it with "
                          "_init_with_clock(sm, sce_clock_manual(0)), or drive it with _tick and "
                          "_time_until_next_scheduled_ms\n");
        }
        return;
    }
    sm->clock.now_ms += ms;
    {{ csym_prefix }}{{ model.name }}_tick(sm);
}

SCE_SM_FN uint64_t {{ csym_prefix }}{{ model.name }}_now_ms(const {{ csym_prefix }}{{ model.name }}_t *sm) {
    return sched_now_ms(sm);
}
{% endif %}

SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_run({{ csym_prefix }}{{ model.name }}_t *sm) {
    sm->is_running = true;
    while (sm->is_running && !{{ csym_prefix }}{{ model.name }}_is_in_final_state(sm)) {
        uint32_t before = sm->active;
        {{ csym_prefix }}{{ model.name }}_step(sm);
        /* True quiescence: configuration unchanged AND both queues empty.
           The queue check covers the exit/entry-action follow-on path —
           an eventless transition can run an <onexit> that <raise>s a
           fresh event leaving the configuration unchanged from the
           run-loop's vantage if the eventless block stops there; we
           must continue so the next step() drains those queued events.
           Comparing `sm->active` (full bitmap) instead of a single-leaf
           `current_state` correctly handles configurations where multiple
           bits change in one step (W3C 3.13 transition body actions
           setting more than one ancestor bit). */
        if (sm->active == before
            && sm->internal_queue.count == 0u
            && sm->external_queue.count == 0u) {
            break;
        }
    }
    sm->is_running = false;
}

{# W3C SCXML 5.10: one place a session's identity is issued. #}
/* W3C SCXML 5.10 / C.1.1: issue this session's id and the address that
   reaches it.

   A session begins in two places on this backend — `_init_impl` for a
   machine a host starts, `_init_with_parent` for one a parent invokes —
   and both zero the struct and then open the datamodel. Issuing from one
   function called by both is what keeps a child from being the case that
   publishes nothing: the first draft of this change wrote the ids inline
   in `_init_impl` and claimed every variant funnelled through it, which
   was true of the host-started variants and false of the invoked one, so
   invoked children carried an empty location and the origin they stamped
   matched nothing they published.

   The counter is file-scope and per machine type, which is what makes the
   id unique across the process without a registry to consult: two sessions
   of this machine differ in the ordinal, and two machines differ in the
   name the ordinal is appended to. A clock would collide inside its own
   resolution and would not be reproducible; an address would be unique
   only by accident. The ordinal keeps the value an NMTOKEN, as
   §scxml-5.10 requires of `_sessionid`. */
SCE_SM_FN static void {{ csym_prefix }}{{ model.name }}_issue_session_identity({{ csym_prefix }}{{ model.name }}_t *sm) {
    static unsigned long _sce_session_seq;
    ++_sce_session_seq;
    (void)snprintf(sm->session_id, sizeof(sm->session_id),
                   "{{ model.name | escape_c }}_session_%lu", _sce_session_seq);
    /* W3C SCXML C.1.1: the published address is the id, spelled as the
       SCXML event processor's URI. Derived here, once, so the address and
       the id cannot disagree — C.1 requires them to name one session. */
    (void)snprintf(sm->scxml_location, sizeof(sm->scxml_location),
                   "sce://scxml/%s", sm->session_id);
}

{% if not model.has_parent_communication %}
{# W3C SCXML G.7: a machine whose document declares `<sce:action>`s cannot
   start without a host, so `_init` returns whether it accepted one. Every
   initialiser below carries the same verdict outward — `void` for every other
   document shape, byte-identical to the pre-feature emit. #}
{% set init_rc = 'bool' if has_native_actions else 'void' %}
{# The construction half of `_init`, shared with `_init_at`.

   Everything a session needs before it is anywhere: the host's wiring, the
   clock, the session identity, the datamodel. What it deliberately does NOT do
   is enter — `_init` walks the initial configuration afterwards and `_init_at`
   sets the one a host recorded. Splitting them is what lets the resume door
   exist at all on a backend where construction and entry are one call.

   Returns false only when the host's act table is incomplete; that check stays
   FIRST, before the memset, so a refused call leaves the caller's storage
   exactly as it was — the same rule the configuration door follows. #}
SCE_SM_FN static bool {{ csym_prefix }}{{ model.name }}_init_construct({{ csym_prefix }}{{ model.name }}_t *sm{% if model.needs_event_scheduler %},
                                                       sce_clock_t clock{% endif %}{% if model.needs_script_engine %},
                                                       const char *basic_http_access_uri{% endif %}{% if model.host_processor_types %},
                                                       const sce_host_processor_registry_t *host_processors{% endif %}{% if has_native_actions %},
                                                       const {{ native_actions_interface }} *actions{% endif %}) {
{% if has_native_actions %}
    /* W3C SCXML G.7: refuse a host that does not perform every act this
       document declares, BEFORE anything is touched — a refused call leaves
       the machine exactly as it was, which is the same rule the configuration
       door follows. The five other backends get this from their type systems
       (an unimplemented interface method does not compile); C has no such
       check, so it moves to the one call a C host has to make. */
    if (actions == NULL{% for op in native_action_ops %} || actions->{{ op }} == NULL{% endfor %}) {
        return false;
    }
{% endif %}
    memset(sm, 0, sizeof(*sm));
{% if has_native_actions %}
    /* Copied in before the entry walk, for the reason the host-processor
       registry below is: the first `<onentry>` body may already perform an
       act, and a vtable written afterwards would arrive one act too late — and
       a value this call MEMSETS cannot be set before it. */
    sm->actions = *actions;
{% endif %}
{% if model.host_processor_types %}
    /* §scxml-6.2.5: the host's wiring is installed BEFORE the entry walk,
       for the reason the BasicHTTP address above it is: the first
       `<onentry>` body may already perform a host-served act, and a handler
       registered afterwards would arrive one act too late — the document
       would have met `error.execution` for an act the host was ready to
       serve.

       Its siblings have no such moment because construction and
       `initialize()` are two calls there, and a registration made between
       them survives. Here `_init` is both, so the registry comes in as an
       argument rather than being written onto the struct first: a value
       this call MEMSETS cannot be set before it. */
    if (host_processors != NULL) {
        sm->host_processors = *host_processors;
    }
{% endif %}
{% if model.needs_event_scheduler %}
    /* §scxml-6.2.2: the clock is stamped before the entry walk, because that
       walk's `<onentry>` can already arm `<send delay>`s and a clock installed
       afterwards would leave the queue holding deadlines from two time bases
       that do not compare. */
    sm->clock = clock;
{% endif %}
    {{ csym_prefix }}{{ model.name }}_issue_session_identity(sm);
{% if model.needs_script_engine %}
    /* W3C SCXML C.2.3: stamp the deployment's inbound BasicHTTP endpoint
       before the Lua state opens. `_ioprocessors` is seeded once at that
       point and the first `<onentry>` body may already read it, so there is
       no later moment the address could still reach the table. NULL or ""
       means no endpoint is deployed and no BasicHTTP entry is published. */
    if (basic_http_access_uri != NULL) {
        size_t _uri_len = strlen(basic_http_access_uri);
        if (_uri_len >= sizeof(sm->basic_http_access_uri)) {
            _uri_len = sizeof(sm->basic_http_access_uri) - 1u;
        }
        memcpy(sm->basic_http_access_uri, basic_http_access_uri, _uri_len);
        sm->basic_http_access_uri[_uri_len] = '\0';
    }
{% endif %}
    /* W3C SCXML 6.2: SM is running from the moment the configuration is
       seeded. cpp `StaticExecutionEngine::initialize` sets `isRunning_`
       around the same point so external pollers — `_tick`, `_run`, and
       any host scheduler harness — observe a live machine immediately.
       Without this flag set _tick early-returns on its `is_running` guard
       and scheduled `<send delay>` events would never promote into the
       internal queue. */
    sm->is_running = true;
    {% if model.needs_script_engine %}
    /* W3C SCXML 5.10: Open Lua engine and seed datamodel before any
       <onentry> body runs (those bodies may reference datamodel vars).
       `_init_at` reaches the same line for the same reason: a `cond` or an
       `assign` evaluated after a resume would otherwise reference variables
       that were never declared. */
{{ se.lua_init_engine() }}
    {% endif %}
    return true;
}

SCE_SM_FN static {{ init_rc }} {{ csym_prefix }}{{ model.name }}_init_impl({{ csym_prefix }}{{ model.name }}_t *sm{% if model.needs_event_scheduler %},
                                                       sce_clock_t clock{% endif %}{% if model.needs_script_engine %},
                                                       const char *basic_http_access_uri{% endif %}{% if model.host_processor_types %},
                                                       const sce_host_processor_registry_t *host_processors{% endif %}{% if has_native_actions %},
                                                       const {{ native_actions_interface }} *actions{% endif %}) {
    if (!{{ csym_prefix }}{{ model.name }}_init_construct(sm{% if model.needs_event_scheduler %}, clock{% endif %}{% if model.needs_script_engine %}, basic_http_access_uri{% endif %}{% if model.host_processor_types %}, host_processors{% endif %}{% if has_native_actions %}, actions{% endif %})) {
{% if has_native_actions %}
        return false;
{% else %}
        return;
{% endif %}
    }
{% if model.needs_event_scheduler %}
    /* §scxml-3.13: entering the initial configuration is one turn, and the
       `<onentry>` handlers it runs arm their `<send delay>`s against one
       instant — see `sched_now_ms` for what reading the clock per `<send>`
       did to two of them. `_init_at` opens no turn: it runs no `<onentry>`,
       so there is no instant's worth of executable content to hold together. */
    bool _turn_opened = begin_turn(sm);
{% endif %}
    /* W3C SCXML 3.2: Configuration entry via the unified
       enter_state_recursive walk — sets the initial root and every
       ancestor / region-child / initial-descendant bit, runs onentry in
       walk order. Mirrors cpp StaticExecutionEngine::initialize entry
       loop. The recursion handles compound, parallel, and leaf states
       uniformly. */
    enter_state_recursive(sm, {{ csym_prefix }}{{ model.name }}_initial_state());
    /* W3C SCXML Appendix D: hand over to the outer loop. It fires eventless
       transitions and internal events to macrostep completion, executes the
       deferred `<invoke>` elements, and only then dequeues one external
       event — so the first event raised in an `<onentry>` block cannot race
       ahead of the source state's eventless `<transition>` (test503/505/506
       force this), and an autoforward child is live for every event
       `<onentry>` queued on the way in. Top-level fixtures only — child SMs
       (which declare `<send target="#_parent">` and emit
       `_init_with_parent` instead) defer macrostep stabilisation to the
       parent's invoke helper, which runs it after stamping parent-routing
       fields and applying `<param>` / `namelist` overrides. */
    run_main_event_loop(sm);
{% if model.needs_event_scheduler %}
    end_turn(sm, _turn_opened);
{% endif %}
{% if has_native_actions %}
    return true;
{% endif %}
}

/* W3C SCXML 3.2 — the resume door. See the header for what it is for, what it
   refuses, and why it is an `_init` variant rather than a call on a live
   machine. */
SCE_SM_FN {{ csym_prefix }}{{ model.name }}_configuration_rejection_t {{ csym_prefix }}{{ model.name }}_init_at(
    {{ csym_prefix }}{{ model.name }}_t *sm,
    const {{ csym_prefix }}{{ model.name }}_state_t *configuration, size_t count{% if model.needs_event_scheduler %},
    sce_clock_t clock{% endif %}{% if model.needs_script_engine %},
    const char *basic_http_access_uri{% endif %}{% if model.host_processor_types %},
    const sce_host_processor_registry_t *host_processors{% endif %}{% if has_native_actions %},
    const {{ native_actions_interface }} *actions{% endif %}) {
    /* Before anything is touched — the memset included: a rejection must not
       half-enter, and on this backend "half" would mean a caller's storage
       zeroed for a set the document never describes. */
    const {{ csym_prefix }}{{ model.name }}_configuration_rejection_t verdict =
        {{ csym_prefix }}{{ model.name }}_validate_configuration(configuration, count);
    if (verdict != {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_NONE) {
        return verdict;
    }

{% if has_native_actions %}
    if (!{{ csym_prefix }}{{ model.name }}_init_construct(sm{% if model.needs_event_scheduler %}, clock{% endif %}{% if model.needs_script_engine %}, basic_http_access_uri{% endif %}{% if model.host_processor_types %}, host_processors{% endif %}, actions)) {
        return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_HOST_ACTIONS_INCOMPLETE;
    }
{% else %}
    /* Cannot fail for this document: the act table is the only thing
       construction refuses, and this document declares no acts. */
    (void){{ csym_prefix }}{{ model.name }}_init_construct(sm{% if model.needs_event_scheduler %}, clock{% endif %}{% if model.needs_script_engine %}, basic_http_access_uri{% endif %}{% if model.host_processor_types %}, host_processors{% endif %});
{% endif %}

    /* W3C SCXML 3.2: the configuration IS the bitmap on this backend, so the
       restore is the set of bits the host recorded — no entry walk, and so no
       `<onentry>`. `_init_construct` has already memset it to zero, which is
       what makes this an assignment of the whole configuration rather than a
       merge with whatever was there. */
    for (size_t i = 0u; i < count; ++i) {
        sm->active |= state_bit(configuration[i]);
    }

    return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_NONE;
}

