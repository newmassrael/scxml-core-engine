/* W3C SCXML 6.2: Monotonic clock binding for delayed `<send>` scheduling.
   The interface lives in `backends/c/runtime/include/sce/clock.h` (sce-c-core
   tier); the link-time impl is supplied by `sce_c_runtime_posix` for
   host runners or by a downstream `sce_c_runtime_<target>` for bare-metal
   consumers (see ARCHITECTURE.md §"C11 backend layering").
   Linking fails if no impl is provided —
   no weak-symbol fallback (silent zero clock would freeze the schedule
   and silently mis-fire timeouts). */
#include <sce/clock.h>


/* Forward declarations — `scheduled_push` is invoked from inside
   `execute_entry_actions` / `execute_exit_actions` (the action emitter's
   `<send delay>` arm), but the definitions live alongside the rest of
   the RTC core lower in the translation unit so they sit next to the
   queues and macrostep helpers they belong with. The forward decl keeps
   `-Werror=implicit-function-declaration` quiet without reordering the
   logical sections of the generated source. */
/* §scxml-3.13: what time it is, for everything this turn arms or judges.

   The clause executes a microstep's executable content as one unit and a
   macrostep as a chain of those, so "now" is a property of the turn the machine
   is in rather than of the statement asking for it. Between turns there is no
   turn for it to be a property of, and the host's queries
   (`_time_until_next_scheduled_ms`, `_now_ms`) read the clock live.

   §scxml-6.2.2 is why it matters: a delay is the wait the DOCUMENT asks for —
   "how long the processor should wait before dispatching the message". Time the
   host spent descheduled between two statements of one microstep is not part of
   any delay the document wrote, so it must not reach the deadline. Reading the
   clock per statement instead was two defects at once, both measured on the
   sibling backends this scheduler mirrors:

     - Two `<send delay>`s executed by one `<onentry>` took a reading each, so a
       host descheduled between them by more than the gap between their delays
       got the later send's deadline first — and the machine then dispatched
       them in that order, so the document's `<cancel>` arrived after the event
       it named.
     - The dispatch loop in `_tick` re-read it on every pass, so a tick slow
       enough to cross the next fire time dispatched that entry too, then the
       one after it — the machine chasing deadlines its own slowness created. */
SCE_SM_FN static SCE_C_UNUSED uint64_t sched_now_ms(const {{ csym_prefix }}{{ model.name }}_t *sm) {
    return sm->in_turn ? sm->turn_now_ms : sce_clock_read(&sm->clock);
}

/* Open a turn: take the single clock reading everything inside it uses.

   Returns whether this call is the one that opened it, which `end_turn` needs
   so a nested entry point (`_tick` delegating to `_step`) does not close the
   outer turn early. */
SCE_SM_FN static SCE_C_UNUSED bool begin_turn({{ csym_prefix }}{{ model.name }}_t *sm) {
    if (sm->in_turn) {
        return false;
    }
    sm->turn_now_ms = sce_clock_read(&sm->clock);
    sm->in_turn = true;
    return true;
}

/* Close a turn opened by `begin_turn`. */
SCE_SM_FN static SCE_C_UNUSED void end_turn({{ csym_prefix }}{{ model.name }}_t *sm, bool opened) {
    if (opened) {
        sm->in_turn = false;
    }
}

