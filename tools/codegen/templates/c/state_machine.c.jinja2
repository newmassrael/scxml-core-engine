                _ti->history_target = {% if trans.history_target %}{{ model.name | upper }}_HIST_{{ trans.history_target | upper | replace('-', '_') | replace('.', '_') }}{% else %}{{ model.name | upper }}_HIST_NONE{% endif %};
{% endif %}
