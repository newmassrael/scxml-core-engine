{{ se.lua_init_engine() }}
    {% endif %}
    /* W3C SCXML 3.2: Configuration entry via the unified
       enter_state_recursive walk — sets the initial root and every
       ancestor / region-child / initial-descendant bit, runs onentry in
       walk order. Mirrors cpp StaticExecutionEngine::initialize entry
       loop. The recursion handles compound, parallel, and leaf states
