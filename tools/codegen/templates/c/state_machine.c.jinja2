    if (state_is_compound(s) && !state_is_parallel(s)) {
        /* W3C SCXML 3.6 + 3.10: when the compound leaf's `<initial>`
           targets a history pseudo-state, route through
           `enter_history_state` so any recorded snapshot wins over the
