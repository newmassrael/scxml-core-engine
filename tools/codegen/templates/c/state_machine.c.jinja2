SCE_SM_FN static {{ csym_prefix }}{{ model.name }}_event_t {{ csym_prefix }}{{ model.name }}_event_from_name(const char *name, size_t len);
{% endif %}
{# §scxml-6.4.1 is in this guard for the reason §scxml-6.2.5 is: a host-run
   invoke answers with a COMPLETION, and `done.invoke.<id>` is a name chosen
   while the machine runs, so the same inverse mapping is what turns it into an
   event. Measured: an invoker-only document compiled with an implicit
   declaration of this function and would have failed at link. #}
{% if model.needs_http_send or model.host_processor_types or model.host_invoker_types %}

/* W3C SCXML C.2: standalone server's response carries the receiving
   event's name as a JSON string (`{"event":"<name>",...}`). The generated
   per-fixture helper below maps that name to the SM's `Event` enum at
   runtime.

   §scxml-6.2.5 gave it a second consumer: a host-served act answers with
   event NAMES, chosen while the machine runs, so the same inverse mapping
   is what turns the host's report into events. One helper for both,
   because two would be two spellings of one document's event set.

   The mapping is the inverse of the codegen-time
   `EVENT_<UPPER>` synthesis used everywhere else in the source — same
   set of names, same UPPER + dot/dash → underscore transform. Unknown
   names collapse to `EVENT_NONE` and the surrounding arm declines to
   raise. Linear scan is fine: the W3C C.2 corpus events are bounded by
   the document's transition set (≤ ~10 names). The jinja2-inline contract puts
   no helper functions in the runtime; the fixture-side static helper
   is generated source, so it is in scope. */
SCE_SM_FN static {{ csym_prefix }}{{ model.name }}_event_t {{ csym_prefix }}{{ model.name }}_event_from_name(const char *name, size_t len) {
    if (name == NULL || len == 0u) {
        return {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_NONE;
    }
    {% for event_name in model.events | sort %}
    if (len == {{ event_name | length }}u && memcmp(name, "{{ event_name }}", {{ event_name | length }}u) == 0) {
        return {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_{{ event_name | upper | replace('.', '_') | replace('-', '_') }};
    }
    {% endfor %}
    return {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_NONE;
}
{% if model.host_processor_types %}

/* §scxml-6.2.5: dispatch one host-served `<send>` and raise, in order,
   every event the handler says the act produced.
   §scxml-C-1: a reply from outside the machine arrives on the EXTERNAL
   queue, like any event a host raises.

   Emitted once per machine rather than inlined at each send site: an MCU
   profile pays for every copy, and the eight sites `examples/ai_loop`
   declares would otherwise be eight copies of this body.

   With nothing registered the send raises `error.execution`, the same
   outcome an undeclared type produces. That is the point: the document
   asked for an act, and from its side "no processor implements this
   type" and "the processor was never wired up" are one fact. Reporting
   them differently would make a wiring mistake look like a document
   error — or worse, look like success.

   A reply naming an event this machine does not declare is dropped,
   which is what the engine does with any such event. A report that did
   not FIT is not dropped: `overflowed` says this build reserved less
   room than the act produced, and an act that reported two events and
   delivered one leaves the machine somewhere the document never
   described. */
SCE_SM_FN static void {{ csym_prefix }}{{ model.name }}_perform_host_send({{ csym_prefix }}{{ model.name }}_t *sm,
                                  const sce_host_send_request_t *request) {
    const sce_host_processor_entry_t *_entry =
        sce_host_registry_find(&sm->host_processors, request->processor_type);
    if (_entry == NULL) {
{% if 'error.execution' in model.events %}
        {{ csym_prefix }}{{ model.name }}_raise_platform_error(
            sm, {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_ERROR_EXECUTION,
            "<send> names a processor the host declared but never registered");
{% endif %}
        return;
    }
    sce_host_send_response_list_t _replies;
    memset(&_replies, 0, sizeof(_replies));
    _entry->handler(_entry->user_data, request, &_replies);
    for (int _i = 0; _i < _replies.count; _i++) {
        const char *_name = _replies.entries[_i].event_name;
        const {{ csym_prefix }}{{ model.name }}_event_t _ev =
            {{ csym_prefix }}{{ model.name }}_event_from_name(_name, strlen(_name));
        if (_ev == {{ csym_prefix | upper }}{{ model.name | upper }}_EVENT_NONE) {
            continue;
        }
        {{ csym_prefix }}{{ model.name }}_event_with_meta_t _reply_evt;
        memset(&_reply_evt, 0, sizeof(_reply_evt));
        _reply_evt.event = _ev;
        {
            /* §scxml-B-2-8-1 reads this field as a host payload — XML to a
               DOM, JSON to a value, anything else to a normalized string —
               so it crosses as the bytes the handler wrote. Copied whole or
               not at all: a truncated payload is one that parses to
               something the host never said. */
            const size_t _dn = strlen(_replies.entries[_i].event_data);
