/* W3C SCXML 6.4: stop a host-run invocation from outside the exit chain.

   Exposed because the exit chain is not the only way an invocation ends: a
   host that tears its own session down needs to say so, and a test needs to
   ask whether "did this one start?" is answered correctly. Returns whether a
   cancel was delivered. */
SCE_SM_FN bool {{ csym_prefix }}{{ model.name }}_cancel_host_invoke({{ csym_prefix }}{{ model.name }}_t *sm, const char *processor_type,
                                                                    const char *invoke_id) {
    const sce_host_invoker_entry_t *entry;
    sce_host_invoke_event_t event;
    sce_host_invoke_response_t out;
    if (sm == NULL) {
        return false;
    }
    if (!sce_host_invocation_take(&sm->started_host_invokes, processor_type, invoke_id)) {
        return false;
    }
    entry = sce_host_invoker_find(&sm->host_invokers, processor_type);
    if (entry == NULL) {
        return false;
    }
    memset(&event, 0, sizeof(event));
    memset(&out, 0, sizeof(out));
    event.phase = SCE_HOST_INVOKE_CANCEL;
    event.processor_type = processor_type;
    event.invoke_id = invoke_id;
    event.src = "";
    event.content = "";
    event.params = NULL;
    event.param_count = 0;
    entry->handler(entry->user_data, &event, &out);
    return true;
}
