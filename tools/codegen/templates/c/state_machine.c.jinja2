/* ── W3C SCXML 3.2: Configuration bitmap helpers ──────────────────── */
{# Each state's enum value doubles as a bit index in `sm->active`. Entry
   sets parent ancestors AND the leaf bit (mirrors cpp activeStates_ which
   holds compound states alongside their leaves). Mirrors of cpp
   StaticExecutionEngine::activeStates_ helpers — bitmap operations are
   inlined (no helper-class dispatch). #}
SCE_SM_FN static SCE_C_UNUSED uint32_t state_bit({{ csym_prefix }}{{ model.name }}_state_t s) {
    return (uint32_t)1u << (uint32_t)s;
}

SCE_SM_FN static SCE_C_UNUSED bool config_in(uint32_t active, {{ csym_prefix }}{{ model.name }}_state_t s) {
    return (active & state_bit(s)) != 0u;
}

/* W3C SCXML 3.2: descendant test via parent walk-up. Used by the exit
   chain to identify the active subtree under a transition's source. */
SCE_SM_FN static SCE_C_UNUSED bool is_descendant_of({{ csym_prefix }}{{ model.name }}_state_t child,
                                         {{ csym_prefix }}{{ model.name }}_state_t ancestor) {
    {{ csym_prefix }}{{ model.name }}_state_t cur = child;
    while (true) {
        bool has_parent;
        {{ csym_prefix }}{{ model.name }}_state_t parent = state_get_parent(cur, &has_parent);
        if (!has_parent) {
            return false;
        }
        if (parent == ancestor) {
            return true;
        }
        cur = parent;
    }
}

/* W3C SCXML 3.2 / 3.3 / 3.4 — is this set of states a CONFIGURATION of the
   document? The rules in one place, reading the same static hierarchy the
   entry walk above reads. See the header for what each refusal names and for
   why this asks nothing about a current state.

   Placed here rather than beside `_state_name`: it reads `state_get_parent`,
   the two shape predicates and the bitmap helpers, and C wants them declared
   first. */
SCE_SM_FN {{ csym_prefix }}{{ model.name }}_configuration_rejection_t {{ csym_prefix }}{{ model.name }}_validate_configuration(
    const {{ csym_prefix }}{{ model.name }}_state_t *configuration, size_t count) {
    if (configuration == NULL || count == 0u) {
        return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_EMPTY;
    }

    /* Before any hierarchy question: a value this document does not have
       cannot be asked one. The five other backends get this from their type
       systems — a member of their configuration is a generated enum or sealed
       object — so here it is the first rule instead. */
    for (size_t i = 0u; i < count; ++i) {
        if ((unsigned)configuration[i] >= (unsigned){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT) {
            return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_UNKNOWN_STATE;
        }
    }

    for (size_t i = 0u; i < count; ++i) {
        for (size_t j = 0u; j < i; ++j) {
            if (configuration[j] == configuration[i]) {
                return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_DUPLICATE;
            }
        }
    }

    /* Every member is in range and named once, so the set is a bitmap now and
       membership is one test rather than a walk. */
    uint32_t held = 0u;
    for (size_t i = 0u; i < count; ++i) {
        held |= state_bit(configuration[i]);
    }

    size_t roots = 0u;
    for (size_t i = 0u; i < count; ++i) {
        bool has_parent = false;
        {{ csym_prefix }}{{ model.name }}_state_t parent = state_get_parent(configuration[i], &has_parent);
        if (!has_parent) {
            ++roots;
        } else if (!config_in(held, parent)) {
            return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_ANCESTOR_MISSING;
        }
    }
    if (roots != 1u) {
        return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_ROOT_COUNT;
    }

    for (size_t i = 0u; i < count; ++i) {
        const {{ csym_prefix }}{{ model.name }}_state_t s = configuration[i];
        size_t children = 0u;
        for (size_t j = 0u; j < count; ++j) {
            bool has_parent = false;
            {{ csym_prefix }}{{ model.name }}_state_t parent = state_get_parent(configuration[j], &has_parent);
            if (has_parent && parent == s) {
                ++children;
            }
        }

        if (state_is_parallel(s)) {
            /* W3C SCXML 3.4: EVERY region, because they are "simultaneously
               active when the parent element is active". The regions are the
               document's children of `s` — the same enumeration
               `enter_parallel_regions` walks. */
            size_t regions = 0u;
            for (uint32_t r = 0u; r < (uint32_t){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT; ++r) {
                bool region_has_parent = false;
                {{ csym_prefix }}{{ model.name }}_state_t region_parent =
                    state_get_parent(({{ csym_prefix }}{{ model.name }}_state_t)r, &region_has_parent);
                if (!region_has_parent || region_parent != s) {
                    continue;
                }
                ++regions;
                if (!config_in(held, ({{ csym_prefix }}{{ model.name }}_state_t)r)) {
                    return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_PARALLEL_REGION_MISSING;
                }
            }
            if (children != regions) {
                return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_PARALLEL_CHILD_COUNT;
            }
            continue;
        }

        if (state_is_compound(s)) {
            if (children != 1u) {
                return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_COMPOUND_CHILD_COUNT;
            }
        } else if (children != 0u) {
            return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_ATOMIC_HAS_CHILDREN;
        }
    }

    return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_NONE;
}

/* W3C SCXML 3.2: leaf extraction. Returns the unique active state with
   no active children (single-leaf invariant; <parallel> generalisation
   lands when its first fixture forces multi-leaf walking — at that point
   process_transition will iterate every leaf instead of just the first). */
SCE_SM_FN static SCE_C_UNUSED {{ csym_prefix }}{{ model.name }}_state_t config_leaf(uint32_t active) {
    for (uint32_t s = 0u; s < (uint32_t){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT; ++s) {
        if ((active & ((uint32_t)1u << s)) == 0u) {
            continue;
        }
        bool has_active_child = false;
        for (uint32_t c = 0u; c < (uint32_t){{ csym_prefix | upper }}{{ model.name | upper }}_STATE_COUNT; ++c) {
            if (c == s || (active & ((uint32_t)1u << c)) == 0u) {
                continue;
            }
            bool hp;
            {{ csym_prefix }}{{ model.name }}_state_t cp = state_get_parent(({{ csym_prefix }}{{ model.name }}_state_t)c, &hp);
            if (hp && cp == ({{ csym_prefix }}{{ model.name }}_state_t)s) {
                has_active_child = true;
                break;
            }
        }
        if (!has_active_child) {
            return ({{ csym_prefix }}{{ model.name }}_state_t)s;
        }
    }
    return ({{ csym_prefix }}{{ model.name }}_state_t)0;  /* unreachable in well-formed config */
}

/* W3C SCXML 3.2: enter `s` and every ancestor on its parent chain. Mirrors
   cpp HierarchicalStateHelper::buildEntryChain followed by the configuration
   set inserts. Idempotent — re-entering an already-active state is a no-op. */
SCE_SM_FN static SCE_C_UNUSED uint32_t config_enter_chain(uint32_t active, {{ csym_prefix }}{{ model.name }}_state_t s) {
    uint32_t out = active | state_bit(s);
    {{ csym_prefix }}{{ model.name }}_state_t cur = s;
    while (true) {
        bool has_parent;
        {{ csym_prefix }}{{ model.name }}_state_t parent = state_get_parent(cur, &has_parent);
        if (!has_parent) {
            break;
        }
        out |= state_bit(parent);
        cur = parent;
    }
    return out;
}

/* W3C SCXML 3.7: codegen-time bitmask of every TOP-LEVEL <final> state.
   `{{ csym_prefix }}{{ model.name }}_is_in_final_state` returns true only when the
