    {% for state_id, state in model.states | dictsort %}{% if state.initial_transition_actions %}{% set has_initial_actions.v = true %}{% endif %}{% endfor %}
    for (uint32_t i = depth; i > 0u; --i) {
        {{ csym_prefix }}{{ model.name }}_state_t e = chain[i - 1u];
        if (config_in(sm->active, e)) {
            continue;
        }
        sm->active |= state_bit(e);
        execute_entry_actions(sm, e);
        {% if has_initial_actions.v %}
        switch (e) {
        {% for state_id, state in model.states | dictsort %}
        {% if state.initial_transition_actions %}
        case {{ csym_prefix | upper }}{{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}: {
            {% for action in state.initial_transition_actions %}
            {{ emit_action(action) }}
            {% endfor %}
            break;
        }
        {% endif %}
        {% endfor %}
        default:
            break;
        }
        {% endif %}
        if (state_is_parallel(e)) {
            /* §scxml-D: chain[i - 2] is the region this chain descends into,
               and it is entered by the next iteration with the target's own
               path rather than with a default. When `e` IS the target (i == 1)
               there is no such region and every one of them takes its default. */
            enter_parallel_regions(sm, e, (i >= 2u) ? chain[i - 2u] : e, i >= 2u);
        }
