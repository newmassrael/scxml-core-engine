{% endif %}

#include <string.h>

/* Watching-zenoh RFC §5.2 — C11 section attribute prefix
   for every statechart function definition emitted below. When
   `deploy.yaml`'s `platform.c11_section_attribute.class` is set, the
   macro expands to `__attribute__((section("<name>")))` so the linker
   places every function in the named section (C11-side wiring;
   non-C11 backends are rejected at the orchestrator
   pass). When unset, the macro expands to nothing — author-side
   override remains possible via a pre-include `#define SCE_SM_FN ...`
   or compiler `-DSCE_SM_FN=...`. The `#ifndef` guard makes the
   override stable across includes / unity builds. */
#ifndef SCE_SM_FN
{% if model.c11_section_attribute_class %}
#define SCE_SM_FN __attribute__((section("{{ model.c11_section_attribute_class }}")))
{% else %}
#define SCE_SM_FN
{% endif %}
#endif

