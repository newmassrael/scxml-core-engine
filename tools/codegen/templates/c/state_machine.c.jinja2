SCE_SM_FN void {{ csym_prefix }}{{ model.name }}_destroy({{ csym_prefix }}{{ model.name }}_t *sm) {
    {% if model.invokes | scxml_family %}
    /* W3C SCXML 6.4: tear down any active invoke children before the
       parent's own resources (lua state, scheduler payload refs) go
       away. cpp's shared_ptr reset in the parent destructor is the
       equivalent — c11 mirrors with the active-flag-gated explicit
       destroy walk. Idempotent on already-destroyed children.

       A §scxml-6.4.1 unsupported `type` starts no child, so a machine
       whose only `<invoke>` is unsupported has nothing to tear down here
       — its pending entry lives in the bounded queue the parent owns
       outright. */
    {{ csym_prefix }}{{ model.name }}_destroy_active_children(sm);
    {% endif %}
    {% if model.needs_event_scheduler and model.needs_script_engine %}
    /* W3C SCXML 6.2: release lua registry slots held by pending scheduled
       entries before lua_close reclaims the registry as a whole. lua_close
       would GC the slots automatically, but explicit unref keeps the
       send_id ↔ payload pairing observable across destroy phases and
       mirrors cpp's PullScheduler::~PullScheduler implicit cleanup via
       std::map's destructor running before LuaEngine teardown. */
    for (uint8_t i = 0u; i < sm->scheduled_queue.count; ++i) {
        if (sm->scheduled_queue.buf[i].payload_lua_ref != LUA_NOREF) {
            luaL_unref(sm->L, LUA_REGISTRYINDEX,
                       sm->scheduled_queue.buf[i].payload_lua_ref);
        }
    }
    {% endif %}
    {% if model.needs_script_engine %}
{{ se.lua_destroy_engine() }}
    {% else %}
    (void)sm;
    {% endif %}
}

{# §scxml-3.13: the refusal bookkeeping lives HERE, past the
   `has_parent_communication` split above, because its callers do. The forward
   declarations near `enter_state_recursive`, the refusal in `raise_external`
   and the drain in `run_main_event_loop` are all unconditional, so a child
   machine — which takes the other arm of that split — declared both functions,
   called both, and defined neither. Measured 2026-08-23: ten synth-invoke
   children failed to compile with "used but never defined", and only a build
   of the WHOLE tree showed it; the integration fixtures are all parents. #}
/* §scxml-3.13: the loop that would have dequeued this event has ended, so the
   event is not "pending" — it is over. Forward-declared above `raise_external`,
   which is its first caller. */
SCE_SM_FN static void note_unseen_event({{ csym_prefix }}{{ model.name }}_t *sm,
                            {{ csym_prefix }}{{ model.name }}_event_t event) {
    if (sm == NULL) {
        return;
    }
    sm->unseen_external_events++;
    sm->last_unseen_event = event;
    sm->has_unseen_event = true;
}

/* §scxml-3.13: empty the external queue into the count above, at the moment
   the main event loop ends.

   Drained rather than left in place so each event is counted exactly once: a
   host that keeps calling `_step` on a halted machine would otherwise re-count
   the same queue on every call, and a count that grows while nothing arrives
   is a count nobody can use. */
SCE_SM_FN static void record_unseen_external_events({{ csym_prefix }}{{ model.name }}_t *sm) {
    {{ csym_prefix }}{{ model.name }}_event_with_meta_t _abandoned;
    while (event_queue_pop(&sm->external_queue, &_abandoned)) {
        note_unseen_event(sm, _abandoned.event);
    }
}

/* W3C SCXML 3.13: external events the host sent that this machine never looked
   at, because it had already stopped.

   §scxml-D-mainEventLoop exits when the machine reaches a top-level final
   state, and the clause is explicit that the interpreter is then done.
   Refusing the event is therefore correct — and, exactly as with
   `_discarded_external_events` and `_undecodable_payloads`, being unable to
   SAY it happened is not part of the clause.

   This is the count that separates the third explanation from the other two. A
   host that sent an event and saw nothing move has three candidates: it was
   dequeued and matched nothing (`_discarded_external_events`), it was dequeued
   and a transition's guard was false (nothing moves), or it was never dequeued
   at all (this).

   This backend has a second reason to answer it: its queues are fixed-size
   arrays, so a host that keeps feeding a halted machine would otherwise
   silently overrun one. */
SCE_SM_FN uint32_t {{ csym_prefix }}{{ model.name }}_unseen_external_events(const {{ csym_prefix }}{{ model.name }}_t *sm) {
    return (sm == NULL) ? 0u : sm->unseen_external_events;
}

/* W3C SCXML 3.13: which event the count above last recorded. Returns false,
   leaving `*out` untouched, while that count is zero. */
SCE_SM_FN bool {{ csym_prefix }}{{ model.name }}_last_unseen_event(const {{ csym_prefix }}{{ model.name }}_t *sm,
                            {{ csym_prefix }}{{ model.name }}_event_t *out) {
    if (sm == NULL || out == NULL || !sm->has_unseen_event) {
        return false;
    }
    *out = sm->last_unseen_event;
    return true;
}

SCE_SM_FN uint32_t {{ csym_prefix }}{{ model.name }}_active_states(const {{ csym_prefix }}{{ model.name }}_t *sm) {
    return sm->active;
}

SCE_SM_FN bool {{ csym_prefix }}{{ model.name }}_in_state(const {{ csym_prefix }}{{ model.name }}_t *sm,
                               {{ csym_prefix }}{{ model.name }}_state_t s) {
    return config_in(sm->active, s);
