            }
{% elif action.event and action.delay and action.params and not action.delayexpr and not action.target and not action.eventexpr and not action.namelist and not action.content and not action.contentexpr and (not action.send_type or action.send_type == 'http://www.w3.org/TR/scxml/#SCXMLEventProcessor') and not action.typeexpr and not action.targetexpr and not action.idlocation and (not in_foreach) %}
            /* W3C SCXML 5.10 + 6.2 (test186): static-event + literal delay
               + `<param>` carry. Per-param `expr` is evaluated against the
               active datamodel **at send time**, not delivery time — the
               surrounding onentry's subsequent <assign> may mutate the
               source variable before the timer fires, but the captured
               value snapshots into `_pending_donedata`. The lua-side
               table is then anchored in the registry via luaL_ref so it
               survives the gap between scheduling and dispatch (immediate
               sends rebind `_pending_donedata` to a fresh table on every
               raise; without the registry anchor a subsequent immediate
               send would clobber the scheduled payload). The `_tick`
