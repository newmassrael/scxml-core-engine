static SCE_C_UNUSED {{ model.name }}_state_t state_get_parent({{ model.name }}_state_t s, bool *has_parent) {
    *has_parent = true;
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.parent %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        return {{ model.name | upper }}_STATE_{{ state.parent | upper | replace('-', '_') | replace('.', '_') }};
    {% endif %}
    {% endfor %}
    default:
        *has_parent = false;
        return s;
    }
}

/* W3C SCXML 3.3: Compound-state predicate (true if state has an
   `initial` attribute or non-empty `<initial>` child). */
static SCE_C_UNUSED bool state_is_compound({{ model.name }}_state_t s) {
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.initial %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        return true;
    {% endif %}
    {% endfor %}
    default:
        return false;
    }
}

/* W3C SCXML 3.4: <parallel> predicate. Entry into a parallel state
   activates every region child simultaneously (mirrors cpp
   StateRegistry::isParallel + the parallel-entry branch in
   HierarchicalStateHelper::buildEntryChain). */
static SCE_C_UNUSED bool state_is_parallel({{ model.name }}_state_t s) {
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.is_parallel %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        return true;
    {% endif %}
    {% endfor %}
    default:
        return false;
    }
}

/* W3C SCXML 3.6: Initial child of a compound state. Returns the state
   itself if not compound (callers loop until `child == self` for descend). */
static SCE_C_UNUSED {{ model.name }}_state_t state_get_initial_child({{ model.name }}_state_t s) {
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.initial_children and state.initial_children | length > 0 %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        return {{ model.name | upper }}_STATE_{{ state.initial_children[0] | upper | replace('-', '_') | replace('.', '_') }};
    {% endif %}
    {% endfor %}
    default:
        return s;
    }
}

/* ── W3C SCXML 3.2: Configuration bitmap helpers ──────────────────── */
{# Each state's enum value doubles as a bit index in `sm->active`. Entry
   sets parent ancestors AND the leaf bit (mirrors cpp activeStates_ which
   holds compound states alongside their leaves). Mirrors of cpp
   StaticExecutionEngine::activeStates_ helpers — bitmap operations are
   inlined per the T3 lock-in (no helper-class dispatch). #}
static SCE_C_UNUSED uint32_t state_bit({{ model.name }}_state_t s) {
    return (uint32_t)1u << (uint32_t)s;
}

static SCE_C_UNUSED bool config_in(uint32_t active, {{ model.name }}_state_t s) {
    return (active & state_bit(s)) != 0u;
}

/* W3C SCXML 3.2: descendant test via parent walk-up. Used by the exit
   chain to identify the active subtree under a transition's source. */
static SCE_C_UNUSED bool is_descendant_of({{ model.name }}_state_t child,
                                         {{ model.name }}_state_t ancestor) {
    {{ model.name }}_state_t cur = child;
    while (true) {
        bool has_parent;
        {{ model.name }}_state_t parent = state_get_parent(cur, &has_parent);
        if (!has_parent) {
            return false;
        }
        if (parent == ancestor) {
            return true;
        }
        cur = parent;
    }
}

/* W3C SCXML 3.2: leaf extraction. Returns the unique active state with
   no active children (single-leaf invariant; <parallel> generalisation
   lands when its first fixture forces multi-leaf walking — at that point
   process_transition will iterate every leaf instead of just the first). */
static SCE_C_UNUSED {{ model.name }}_state_t config_leaf(uint32_t active) {
    for (uint32_t s = 0u; s < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++s) {
        if ((active & ((uint32_t)1u << s)) == 0u) {
            continue;
        }
        bool has_active_child = false;
        for (uint32_t c = 0u; c < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++c) {
            if (c == s || (active & ((uint32_t)1u << c)) == 0u) {
                continue;
            }
            bool hp;
            {{ model.name }}_state_t cp = state_get_parent(({{ model.name }}_state_t)c, &hp);
            if (hp && cp == ({{ model.name }}_state_t)s) {
                has_active_child = true;
                break;
            }
        }
        if (!has_active_child) {
            return ({{ model.name }}_state_t)s;
        }
    }
    return ({{ model.name }}_state_t)0;  /* unreachable in well-formed config */
}

/* W3C SCXML 3.2: enter `s` and every ancestor on its parent chain. Mirrors
   cpp HierarchicalStateHelper::buildEntryChain followed by the configuration
   set inserts. Idempotent — re-entering an already-active state is a no-op. */
static SCE_C_UNUSED uint32_t config_enter_chain(uint32_t active, {{ model.name }}_state_t s) {
    uint32_t out = active | state_bit(s);
    {{ model.name }}_state_t cur = s;
    while (true) {
        bool has_parent;
        {{ model.name }}_state_t parent = state_get_parent(cur, &has_parent);
        if (!has_parent) {
            break;
        }
        out |= state_bit(parent);
        cur = parent;
    }
    return out;
}

/* W3C SCXML 3.7: codegen-time bitmask of every TOP-LEVEL <final> state.
   `{{ model.name }}_is_in_final_state` returns true only when the
   machine reaches a final whose parent is the SCXML root — the spec's
   "machine completion" criterion. Compound `<final>` states (those with
   a `state.parent`) are NOT terminal: their entry raises
   `done.state.<parent>` (W3C SCXML 3.7) and the surrounding compound
   carries on. Mirrors cpp `static/StaticExecutionEngine.h::isInFinalState`
   which checks only against `Policy::isInTopLevelFinalState`. */
#define {{ model.name | upper }}_FINAL_MASK ( \
    (uint32_t)0u{% for state_id, state in model.states | dictsort %}{% if state.is_final and not state.parent %} \
    | ((uint32_t)1u << (uint32_t){{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}){% endif %}{% endfor %})

/* W3C SCXML 3.4: <parallel> region-children dispatch. Forward-declared so
   enter_state_recursive can recurse through it before the function body
   appears (mutual recursion: parallel → regions → enter_state_recursive →
   compound/leaf). The body switches on the parallel state and emits one
   enter_state_recursive call per region child in document order. */
static void enter_state_recursive({{ model.name }}_t *sm, {{ model.name }}_state_t s);
static void execute_entry_actions({{ model.name }}_t *sm, {{ model.name }}_state_t s);
{% if model.has_history_states %}
/* enter_state_recursive's compound-with-history dispatch routes to
   enter_history_state, which is defined alongside the rest of the
   history machinery further down. The forward decl keeps that backward
   call resolved in the same translation unit without reordering the
   logical sections. */
static void enter_history_state({{ model.name }}_t *sm, {{ model.name }}_history_t hid);
{% endif %}

static void enter_parallel_regions({{ model.name }}_t *sm, {{ model.name }}_state_t s) {
    (void)sm;
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.is_parallel %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        {% for child_id, child_state in model.states | dictsort %}
        {% if child_state.parent == state_id %}
        enter_state_recursive(sm, {{ model.name | upper }}_STATE_{{ child_id | upper | replace('-', '_') | replace('.', '_') }});
        {% endif %}
        {% endfor %}
        break;
    {% endif %}
    {% endfor %}
    default:
        break;
    }
}

/* W3C SCXML 3.2/3.4/3.6: Unified entry walk. Walks up to the first
   already-active ancestor (or the root), then walks back down running
   onentry on every state in the chain — so cross-compound entries
   activate every passive ancestor's onentry, not just the leaf's.
   After the chain runs, descend: a <parallel> activates every region,
   a compound state descends through state.initial. Idempotent — the
   walk-up halts at the first active ancestor, so re-entry into an
   already-active subtree does not double-fire onentry.

   W3C SCXML 3.4 parallel-sibling re-entry: when an external transition
   inside a parallel region exits all sibling regions (compute_exit_set
   returns active descendants of the parallel LCA), re-entering the
   target alone leaves the cousin regions inactive. Whenever an entered
   state's parent is an already-active <parallel>, dispatch the parent's
   region children — enter_state_recursive is idempotent on already-active
   regions, so siblings that were never exited are no-ops.

   Mirrors cpp HierarchicalStateHelper::buildEntryChain followed by the
   StaticExecutionEngine::executeMicrostep parallel re-entry pass. */
static void enter_state_recursive({{ model.name }}_t *sm, {{ model.name }}_state_t s) {
    if (config_in(sm->active, s)) {
        return;
    }
    {{ model.name }}_state_t chain[{{ model.name | upper }}_STATE_COUNT];
    uint32_t depth = 0u;
    {
        {{ model.name }}_state_t cur = s;
        while (depth < (uint32_t){{ model.name | upper }}_STATE_COUNT) {
            chain[depth++] = cur;
            bool has_parent;
            {{ model.name }}_state_t p = state_get_parent(cur, &has_parent);
            if (!has_parent || config_in(sm->active, p)) {
                break;
            }
            cur = p;
        }
    }
    for (uint32_t i = depth; i > 0u; --i) {
        {{ model.name }}_state_t e = chain[i - 1u];
        sm->active |= state_bit(e);
        execute_entry_actions(sm, e);
    }
    {
        bool has_parent;
        {{ model.name }}_state_t parent = state_get_parent(s, &has_parent);
        if (has_parent && state_is_parallel(parent)
            && config_in(sm->active, parent)) {
            enter_parallel_regions(sm, parent);
        }
    }
    if (state_is_parallel(s)) {
        enter_parallel_regions(sm, s);
    } else if (state_is_compound(s)) {
        /* W3C SCXML 3.6 (compound entry by default-path): when entering a
           compound state without an explicit deep target, execute its
           `<initial>` transition's executable content (if any) before
           descending. cpp `enterStates` handles this in its initial-default
           branch; we mirror it with a per-state switch over states that
           parser.rs marked with `initial_transition_actions`. The actions
           run between the compound's onentry (already executed in the
           walk-down loop above) and the child entry below — exactly the
           ordering test579 verifies (s0 onentry → raise event2 → history
           default raises event3 → enter s01). */
        {% set has_initial_actions = namespace(v=false) %}
        {% for state_id, state in model.states | dictsort %}{% if state.initial_transition_actions %}{% set has_initial_actions.v = true %}{% endif %}{% endfor %}
        {% if has_initial_actions.v %}
        switch (s) {
        {% for state_id, state in model.states | dictsort %}
        {% if state.initial_transition_actions %}
        case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}: {
            {% for action in state.initial_transition_actions %}
            {{ emit_action(action) }}
            {% endfor %}
            break;
        }
        {% endif %}
        {% endfor %}
        default:
            break;
        }
        {% endif %}

        /* W3C SCXML 3.6 + 3.10: when the compound's `<initial>` targets a
           history pseudo-state, route through `enter_history_state` so any
           recorded snapshot wins over the default leaf. Without this branch
           parser.rs's `resolve_history_targets` collapse — which rewrites
           `state.initial` to the resolved default leaf for the regular
           descend path — would silently bypass the snapshot on re-entry
           (test579's second entry through s0 must restore s03 from the
           captured snapshot rather than re-descend to s01). */
        {% set has_initial_history = namespace(v=false) %}
        {% for state_id, state in model.states | dictsort %}{% if state.initial_history_id %}{% set has_initial_history.v = true %}{% endif %}{% endfor %}
        {% if has_initial_history.v %}
        switch (s) {
        {% for state_id, state in model.states | dictsort %}
        {% if state.initial_history_id %}
        case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
            enter_history_state(sm, {{ model.name | upper }}_HIST_{{ state.initial_history_id | upper | replace('-', '_') | replace('.', '_') }});
            return;
        {% endif %}
        {% endfor %}
        default:
            break;
        }
        {% endif %}

        {{ model.name }}_state_t child = state_get_initial_child(s);
        if (child != s) {
            enter_state_recursive(sm, child);
        }
    }
}

/* ── W3C SCXML 5.9: Action execution (per-state, document-order) ──── */
{# Mirrors the C++ entry_exit_actions.jinja2 dispatch: each `<onentry>` /
   `<onexit>` block lowers via the `emit_action` macro defined above for
   every action it contains. C11 inlines the action body directly (no
   `std::function` wrapper, no EntryExitHelper delegation) — T3 lock-in
   per c11_design_decisions.md.

   The case is emitted whenever a state has either `on_entry_blocks` or
   `<datamodel>` under late binding (W3C 5.3): late-binding init must run
   before any onentry markup, mirroring cpp `entry_exit_actions.jinja2:79-90`
   where `dm.initialize_state_datamodel` is invoked at the top of the
   switch case. States with neither contribute no case (default break).

   The macro splits into per-action-type `c/actions/<type>.jinja2`
   includes only when a second consumer appears; until then keeping all
   variants in one local macro keeps the diff small and the activation
   site explicit.                                                          #}
static void execute_entry_actions({{ model.name }}_t *sm, {{ model.name }}_state_t s) {
    (void)sm;
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% set has_late_init = state.datamodel and model.binding == 'late' %}
    {% set is_compound_final = state.is_final and state.parent %}
    {% set has_donedata = state.is_final and state.donedata %}
    {% if state.on_entry_blocks or has_late_init or is_compound_final or has_donedata %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}: {
        {% if has_late_init %}
        /* W3C SCXML 5.3: late-binding state-local <datamodel> init runs
           before any onentry markup. Mirrors cpp
           `entry_exit_actions.jinja2:79-90` (dm.initialize_state_datamodel
           invoked at the top of the switch case before on_entry_blocks). */
        {{ se.lua_init_state_datamodel(state, state_id) }}
        {% endif %}
        {% for block in state.on_entry_blocks %}
        /* Onentry block {{ loop.index }}/{{ state.on_entry_blocks | length }} */
        {% for action in block %}
        {{ emit_action(action) }}
        {% endfor %}
        {% endfor %}
        {% if has_donedata %}
        /* W3C SCXML 5.5: evaluate <donedata> for final state '{{ state_id }}'
           and stash on `_pending_donedata` so the next dequeue's
           `set_current_event` promotes it onto `_event.data`. Mirrors cpp
           `entry_exit_actions.jinja2:389-460` 4-shape dispatch on
           `donedata.params` / `content.kind == "expression"` /
           `content.kind == "literal"`. The C11 emit collapses the cpp
           SSoT helper calls (DoneDataHelper::evaluateContent /
           evaluateParams / emitContentLiteral) to inline lua chunks per
           T3 lock-in. */
        {% if state.donedata.params %}
        {# Codegen-time structural-error pre-check: W3C 5.7 says an empty
           param `location` (no usable expr fallback either) is a structural
           error — raise error.execution and skip the done.state event. The
           parser stores both attributes verbatim (Option<String>), so jinja2
           sees `param.location == ""` as falsy; cpp picks `param.expr`
           when location is falsy via the `if … else` ternary. If both end
           up empty / None we hit the cpp `paramExpr.empty()` early-return
           false branch (DoneDataHelper.h:203-209). #}
        {% set _structural = namespace(ok=true) %}
        {% for param in state.donedata.params %}
        {% set chosen = param.location if param.location else param.expr %}
        {% if not chosen %}
        {% set _structural.ok = false %}
        {% endif %}
        {% endfor %}
        {% if not _structural.ok %}
        /* W3C SCXML 5.7: structural error — empty `location` (and no
           usable `expr`) on at least one <param>. Raise error.execution
           and skip the done.state.{{ state.parent }} event entirely
           (cpp DoneDataHelper::evaluateParams returns false → the
           caller's `if (!success) break;` short-circuit). */
        {
            {{ model.name }}_event_with_meta_t _err_evt;
            memset(&_err_evt, 0, sizeof(_err_evt));
            _err_evt.event = {{ model.name | upper }}_EVENT_ERROR_EXECUTION;
            {{ model.name }}_raise(sm, &_err_evt);
        }
        (void)luaL_dostring(sm->L, "_pending_donedata = nil");
        break;
        {% else %}
        /* W3C SCXML 5.5: build _pending_donedata as a table of
           name:value pairs. Failed param eval raises error.execution
           and continues with the remaining params (cpp 5.7
           "Continue to next param without adding this one"). */
        (void)luaL_dostring(sm->L, "_pending_donedata = {}");
        {% for param in state.donedata.params %}
        {% set chosen = param.location if param.location else param.expr %}
        {{ se.lua_eval_donedata_param_expr(param.name, chosen) }}
        {% endfor %}
        {% endif %}
        {% elif state.donedata.content.kind == "expression" %}
        /* W3C SCXML 5.5: <content expr="{{ state.donedata.content.text | escape_c }}"/>
           — evaluate against the active datamodel. */
        {{ se.lua_eval_donedata_content_expr(state.donedata.content.text) }}
        {% elif state.donedata.content.kind == "literal" %}
        /* W3C SCXML 5.5 + Appendix B.2.2: <content>literal</content> with
           the "null" datamodel uses the inline text as-is (no evaluation).
           The W3C corpus has no null-datamodel + literal-donedata fixture
           registered for C11, and a null datamodel doesn't even reach this
           emit path because needs_script_engine is false there (no lua_State).
           Mirrors cpp `DoneDataHelper::emitContentLiteral` — which is
           sce_base-linkable precisely because it bypasses the script engine.
           Activation guard is therefore a #error so the first such fixture
           lifts a non-lua emit path explicitly, matching the spec-mirror
           parity carve-out reasoning (the cpp shape is the contract; we
           don't fake-emit a lua chunk that wouldn't represent the literal
           shape correctly). */
#error "C11 backend: <donedata><content>literal</content> with null datamodel has no fixture in the W3C corpus — extend execute_entry_actions's donedata branch with a non-lua emit when the first fixture forces it."
        {% endif %}
        {% endif %}
        {% if is_compound_final %}
        /* W3C SCXML 3.7: raise done.state.{{ state.parent }} for compound
           state completion. The donedata payload (if any) was stashed on
           `_pending_donedata` above; the next dequeue's set_current_event
           promotes it onto `_event.data`. Mirrors cpp
           `entry_exit_actions.jinja2:461-475` raise + `EventWithMetadata
           (Event::Done_state_<parent>, eventData)`. */
        {
            {{ model.name }}_event_with_meta_t _done_evt;
            memset(&_done_evt, 0, sizeof(_done_evt));
            _done_evt.event = {{ model.name | upper }}_EVENT_DONE_STATE_{{ state.parent | upper | replace('-', '_') | replace('.', '_') }};
            {{ model.name }}_raise(sm, &_done_evt);
        }
        {% endif %}
        break;
    }
    {% endif %}
    {% endfor %}
    default:
        break;
    }
}

static void execute_exit_actions({{ model.name }}_t *sm, {{ model.name }}_state_t s) {
    (void)sm;
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.on_exit_blocks %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}: {
        {% for block in state.on_exit_blocks %}
        /* Onexit block {{ loop.index }}/{{ state.on_exit_blocks | length }} */
        {% for action in block %}
        {{ emit_action(action) }}
        {% endfor %}
        {% endfor %}
        break;
    }
    {% endif %}
    {% endfor %}
    default:
        break;
    }
}

{# W3C SCXML 3.13: Deferred transition body executor. Mirrors the C++
   `executeTransitionActions` switch-on-source-state → switch-on-index
   pattern in `process_transition.jinja2`. The body has to run between
   the exit chain and the entry chain (per W3C 3.13 doc-order:
   exit → transition → entry), so `process_transition` only stores
   `(last_transition_source_state, last_transition_index)` when it
   matches and `handle_hierarchical_transition` invokes this dispatcher
   between `execute_exit_actions` and `execute_entry_actions`.

   When no transition in the SM carries a body, the entire dispatch
   collapses to an `(void)sm` stub so we keep one canonical signature
   across fixtures. #}
{% set any_transition_actions = namespace(value=False) %}
{% for state_id, state in model.states | dictsort %}
{% if state.transitions %}
{% for trans in state.transitions %}
{% if trans.actions %}
{% set any_transition_actions.value = True %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
static void execute_transition_actions({{ model.name }}_t *sm) {
{% if any_transition_actions.value %}
    switch (sm->policy.last_transition_source_state) {
    {% for state_id, state in model.states | dictsort %}
    {% set state_has_actions = state.transitions and (state.transitions | selectattr('actions') | list | length > 0) %}
    {% if state_has_actions %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        switch (sm->policy.last_transition_index) {
        {% for trans in state.transitions %}
        {% if trans.actions %}
        case {{ trans.transition_index }}: {
            /* W3C SCXML 3.13: transition body for `<transition{% if trans.event %} event="{{ trans.event }}"{% endif %}{% if trans.target %} target="{{ trans.target }}"{% endif %}>` */
            {% for action in trans.actions %}
            {{ emit_action(action) }}
            {% endfor %}
            break;
        }
        {% endif %}
        {% endfor %}
        default:
            break;
        }
        break;
    {% endif %}
    {% endfor %}
    default:
        break;
    }
{% else %}
    (void)sm;
{% endif %}
}

/* ── W3C SCXML 3.13: Transition processing ────────────────────────── */
{# Mirrors the C++ `tryTransitionInState` switch-on-source-state pattern.
   Guarded transitions evaluate `cond` against the Lua datamodel inline
   (no helper/event_matching split — T3 lock-in). Wildcard `event="*"`
   matches every event except the eventless sentinel `EVENT_NONE`
   (eventless transitions have no `event` attribute and are checked via
   `check_eventless_transitions` with `EVENT_NONE` — wildcard must NOT
   pick up that pass, otherwise it would loop forever). Transitions
   are walked in document order; first match wins (W3C 3.13).            #}
{% macro emit_transition_match_check(trans) %}
{% if not trans.event %}
