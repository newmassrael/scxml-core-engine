            (void)luaL_dostring(sm->L, "_pending_donedata = {}");
{% for param in action.params %}
{{ se.lua_eval_send_param_expr(param.name, param.expr) }}
{% endfor %}
            lua_getglobal(sm->L, "_pending_donedata");
            int _payload_ref = luaL_ref(sm->L, LUA_REGISTRYINDEX);
            scheduled_push(sm,
                           _sce_clock_now_ms() + (uint64_t){{ action.delay_ms }}u,
                           {{ model.name | upper }}_EVENT_{{ action.event | upper | replace('.', '_') | replace('-', '_') }},
                           "{{ action.auto_send_id | escape_c }}",
                           _payload_ref);
{% elif action.event and action.delay and not action.delayexpr and not action.target and not action.params and not action.namelist and not action.content and not action.contentexpr and not action.typeexpr and not action.targetexpr and not action.idlocation %}
