{# RFC §5.J.1 — C11 statechart implementation (paired with state_machine.h.jinja2).
   The C++ codegen splits its output across `_sm.h` (Policy struct + SM
   class shell) and `_sm.inl` (Policy method bodies, textually included
   from inside the struct). C11 has no in-class definitions, so the
   policy methods, the RTC core, and the queue helpers all land in this
   single translation unit alongside the per-fixture data layout. T3
   (jinja2 inline) per c11_design_decisions.md.                            #}

{% include 'license_header.jinja2' %}
{% import 'c/scriptengine.jinja2' as se %}

#include "{{ model.name }}_sm.h"

#include <string.h>
{% if model.needs_script_engine %}
#include <stdio.h>  /* snprintf for body-bearing <foreach> per-iter set */
{% endif %}

{# RFC §5.J.1: recursive action emitter. Mirrors the C++ tree's
   `actions/<type>.jinja2` include dispatch but inlines every variant in
   one local macro so the C11 backend stays a two-template tree (header
   + source) until a second consumer fixture justifies splitting. The
   macro is recursive: <if>'s then_actions / elseif.actions / else_actions
   call back into emit_action, so nested <if>/<assign>/<raise> chains
   render in one pass.

   `bool _if_pass`/`_elif_pass` are intentionally declared inside per-block
   `{ }` scopes so nested <if> chains shadow rather than collide; -Wshadow
   is not enabled in the C11 conformance target so the shadow stays warn-free.
   The caller (execute_entry_actions / execute_exit_actions) supplies the
   surrounding `case` block — we never emit `case`/`break` ourselves.

   `in_foreach` (default false) flips the <assign> dispatch onto the
   error-checking variant (`lua_assign_in_foreach_body`) so a failing
   chunk breaks the enclosing C `for` loop. <if>/<elseif>/<else> propagate
   their caller's `in_foreach` verbatim, so an <assign> nested inside an
   <if> nested inside a <foreach> body still reaches the break path.
   <foreach>'s own sub-action recursion forces `in_foreach=true` — nested
   <foreach> is intentionally unsupported per scriptengine.jinja2 (lua
   global `_sce_foreach_arr` collides), and an inner <foreach>'s own body
   emits its own `for` loop so the outer break is never reached anyway. #}
{% macro emit_action(action, in_foreach=false) %}
{% if action.type == 'raise' %}
        {
            /* W3C SCXML 3.8.1: <raise event="{{ action.event }}"> */
            {{ model.name }}_event_with_meta_t evt;
            memset(&evt, 0, sizeof(evt));
            evt.event = {{ model.name | upper }}_EVENT_{{ action.event | upper | replace('.', '_') | replace('-', '_') }};
            {{ model.name }}_raise(sm, &evt);
        }
{% elif action.type == 'assign' %}
        {
            /* W3C SCXML 5.4: <assign location="{{ action.location }}" expr="{{ action.expr | escape_c }}"> */
{% if action.location in ['_sessionid', '_name', '_ioprocessors'] %}
            /* W3C SCXML 5.10: assignment to read-only system variable
               '{{ action.location }}' is illegal — raise error.execution
               and skip the lua chunk entirely so the system variable's
               binding remains unchanged for the rest of the session.
               The reserved list mirrors the system-var registrations in
               scriptengine.jinja2's lua_init_engine; both lists must be
               extended together when a future system var is added (see
               cpp `LuaEngine::setupSystemVariables` for the canonical
               set). The EVENT_ERROR_EXECUTION enum value is always
               present whenever this path runs because <assign> sets
               needs_script_engine, which injects "error.execution" into
               model.events via analyzer.rs. */
            {{ model.name }}_event_with_meta_t _err_evt;
            memset(&_err_evt, 0, sizeof(_err_evt));
            _err_evt.event = {{ model.name | upper }}_EVENT_ERROR_EXECUTION;
            {{ model.name }}_raise(sm, &_err_evt);
{% if in_foreach %}
            break;  /* W3C 4.6: error inside <foreach> body breaks the loop */
{% endif %}
{% elif in_foreach %}
{{ se.lua_assign_in_foreach_body(action.location, action.expr) }}
{% else %}
{{ se.lua_assign(action.location, action.expr) }}
{% endif %}
        }
{% elif action.type == 'foreach' %}
        {
            /* W3C SCXML 4.6: <foreach array="{{ action.array }}" item="{{ action.item }}"{% if action.index %} index="{{ action.index }}"{% endif %}> */
{% if not action.array or not action.item %}
            /* W3C SCXML 4.6: missing required `array` or `item` attribute — raise
               error.execution and skip the body entirely (the body's executable
               content must NEVER run on an ill-formed foreach). Detected at
               codegen time because the parser preserves empty attributes verbatim
               (`unwrap_or("")` in parser.rs); runtime non-table check on a valid
               array expression that evaluates to a non-list is a separate path
               that lands with the first fixture forcing it. The
               EVENT_ERROR_EXECUTION enum value is always present whenever this
               emit path runs because <foreach> sets needs_script_engine, which
               injects "error.execution" into model.events via analyzer.rs's
               apply_script_engine_implications. */
            {
                {{ model.name }}_event_with_meta_t evt;
                memset(&evt, 0, sizeof(evt));
                evt.event = {{ model.name | upper }}_EVENT_ERROR_EXECUTION;
                {{ model.name }}_raise(sm, &evt);
            }
{% elif action.actions and action.actions | length > 0 %}
{{ se.lua_foreach_body_prologue(action.array, action.item, action.index) }}
            for (int _i = 0; _i < _sce_n; ++_i) {
{{ se.lua_foreach_body_iter(action.item, action.index) }}
                {% for sub in action.actions %}
                {{ emit_action(sub, true) }}
                {% endfor %}
            }
{{ se.lua_foreach_body_epilogue() }}
{% else %}
{{ se.lua_foreach_no_body(action.array, action.item, action.index) }}
{% endif %}
        }
{% elif action.type == 'if' %}
        {
            /* W3C SCXML 4.3: <if cond="{{ action.cond | escape_c }}"> */
            bool _if_pass;
{{ se.lua_eval_guard(action.cond, '_if_pass') }}
            if (_if_pass) {
                {% for sub in action.then_actions %}
                {{ emit_action(sub, in_foreach) }}
                {% endfor %}
            }
{% for elif in action.elseif_branches %}
            else {
                /* W3C SCXML 4.3: <elseif cond="{{ elif.cond | escape_c }}"> */
                bool _elif_pass;
{{ se.lua_eval_guard(elif.cond, '_elif_pass') }}
                if (_elif_pass) {
                    {% for sub in elif.actions %}
                    {{ emit_action(sub, in_foreach) }}
                    {% endfor %}
                }
{% endfor %}
{% if action.else_actions %}
            else {
                /* W3C SCXML 4.3: <else> */
                {% for sub in action.else_actions %}
                {{ emit_action(sub, in_foreach) }}
                {% endfor %}
            }
{% endif %}
{% for elif in action.elseif_branches %}
            }
{% endfor %}
        }
{% endif %}
{% endmacro %}

/* ── Local helpers: bounded event queue (FIFO circular buffer) ────── */
{# C++ `EventQueueManager<EventWithMetadata>` is a class template parameterised
   on capacity-via-policy; the C11 backend instead bakes a per-fixture
   circular buffer with `SCE_MAX_EVENTS` slots. Overflow drops silently —
   matching the C++ behaviour when the underlying queue rejects a push.    #}
static void event_queue_push({{ model.name }}_event_queue_t *q,
                             const {{ model.name }}_event_with_meta_t *evt) {
    if (q->count >= (uint16_t)SCE_MAX_EVENTS) {
        return;
    }
    q->buf[q->tail] = *evt;
    q->tail = (uint16_t)((q->tail + 1u) % (uint16_t)SCE_MAX_EVENTS);
    q->count = (uint16_t)(q->count + 1u);
}

static bool event_queue_pop({{ model.name }}_event_queue_t *q,
                            {{ model.name }}_event_with_meta_t *out) {
    if (q->count == 0u) {
        return false;
    }
    *out = q->buf[q->head];
    q->head = (uint16_t)((q->head + 1u) % (uint16_t)SCE_MAX_EVENTS);
    q->count = (uint16_t)(q->count - 1u);
    return true;
}

/* ── W3C SCXML 3.3: Static state policy ───────────────────────────── */

{# W3C SCXML 3.6/3.7: `_initial_state()` returns the topmost ancestor in
   the initial-state entry chain — i.e. the SCXML's root-level child that
   contains the resolved initial leaf. parser.rs `resolve_deep_initial`
   collapses `model.initial` to the leaf, but that erases the ancestor's
   `<onentry>` blocks. The C++ engine reconstructs the chain at runtime
   via `HierarchicalStateHelper::buildEntryChain`; the C11 backend walks
   `state.parent` at codegen time (jinja2 namespace loop, capped at
   32 levels per the spec's practical depth) and emits the root, then
   relies on the existing compound-descend loop in `_init` to walk back
   down through `state.initial` and execute every ancestor's onentry in
   document order. #}
{% set _entry_root = namespace(value=model.initial) %}
{% for _ in range(32) %}
{% if model.states[_entry_root.value] is defined and model.states[_entry_root.value].parent %}
{% set _entry_root.value = model.states[_entry_root.value].parent %}
{% endif %}
{% endfor %}
{{ model.name }}_state_t {{ model.name }}_initial_state(void) {
    return {{ model.name | upper }}_STATE_{{ _entry_root.value | upper | replace('-', '_') | replace('.', '_') }};
}

bool {{ model.name }}_is_final_state({{ model.name }}_state_t s) {
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.is_final %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        return true;
    {% endif %}
    {% endfor %}
    default:
        return false;
    }
}

/* W3C SCXML 3.3: Parent state mapping. `*has_parent` distinguishes "root
   state, no parent" from "self-parent" (which never occurs in well-formed
   SCXML but the contract is still explicit so callers do not need a
   sentinel value baked into the State enum). */
static SCE_C_UNUSED {{ model.name }}_state_t state_get_parent({{ model.name }}_state_t s, bool *has_parent) {
    *has_parent = true;
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.parent %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        return {{ model.name | upper }}_STATE_{{ state.parent | upper | replace('-', '_') | replace('.', '_') }};
    {% endif %}
    {% endfor %}
    default:
        *has_parent = false;
        return s;
    }
}

/* W3C SCXML 3.3: Compound-state predicate (true if state has an
   `initial` attribute or non-empty `<initial>` child). */
static SCE_C_UNUSED bool state_is_compound({{ model.name }}_state_t s) {
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.initial %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        return true;
    {% endif %}
    {% endfor %}
    default:
        return false;
    }
}

/* W3C SCXML 3.4: <parallel> predicate. Entry into a parallel state
   activates every region child simultaneously (mirrors cpp
   StateRegistry::isParallel + the parallel-entry branch in
   HierarchicalStateHelper::buildEntryChain). */
static SCE_C_UNUSED bool state_is_parallel({{ model.name }}_state_t s) {
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.is_parallel %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        return true;
    {% endif %}
    {% endfor %}
    default:
        return false;
    }
}

/* W3C SCXML 3.6: Initial child of a compound state. Returns the state
   itself if not compound (callers loop until `child == self` for descend). */
static SCE_C_UNUSED {{ model.name }}_state_t state_get_initial_child({{ model.name }}_state_t s) {
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.initial_children and state.initial_children | length > 0 %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        return {{ model.name | upper }}_STATE_{{ state.initial_children[0] | upper | replace('-', '_') | replace('.', '_') }};
    {% endif %}
    {% endfor %}
    default:
        return s;
    }
}

/* ── W3C SCXML 3.2: Configuration bitmap helpers ──────────────────── */
{# Each state's enum value doubles as a bit index in `sm->active`. Entry
   sets parent ancestors AND the leaf bit (mirrors cpp activeStates_ which
   holds compound states alongside their leaves). Mirrors of cpp
   StaticExecutionEngine::activeStates_ helpers — bitmap operations are
   inlined per the T3 lock-in (no helper-class dispatch). #}
static SCE_C_UNUSED uint32_t state_bit({{ model.name }}_state_t s) {
    return (uint32_t)1u << (uint32_t)s;
}

static SCE_C_UNUSED bool config_in(uint32_t active, {{ model.name }}_state_t s) {
    return (active & state_bit(s)) != 0u;
}

/* W3C SCXML 3.2: descendant test via parent walk-up. Used by the exit
   chain to identify the active subtree under a transition's source. */
static SCE_C_UNUSED bool is_descendant_of({{ model.name }}_state_t child,
                                         {{ model.name }}_state_t ancestor) {
    {{ model.name }}_state_t cur = child;
    while (true) {
        bool has_parent;
        {{ model.name }}_state_t parent = state_get_parent(cur, &has_parent);
        if (!has_parent) {
            return false;
        }
        if (parent == ancestor) {
            return true;
        }
        cur = parent;
    }
}

/* W3C SCXML 3.2: leaf extraction. Returns the unique active state with
   no active children (single-leaf invariant; <parallel> generalisation
   lands when its first fixture forces multi-leaf walking — at that point
   process_transition will iterate every leaf instead of just the first). */
static SCE_C_UNUSED {{ model.name }}_state_t config_leaf(uint32_t active) {
    for (uint32_t s = 0u; s < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++s) {
        if ((active & ((uint32_t)1u << s)) == 0u) {
            continue;
        }
        bool has_active_child = false;
        for (uint32_t c = 0u; c < (uint32_t){{ model.name | upper }}_STATE_COUNT; ++c) {
            if (c == s || (active & ((uint32_t)1u << c)) == 0u) {
                continue;
            }
            bool hp;
            {{ model.name }}_state_t cp = state_get_parent(({{ model.name }}_state_t)c, &hp);
            if (hp && cp == ({{ model.name }}_state_t)s) {
                has_active_child = true;
                break;
            }
        }
        if (!has_active_child) {
            return ({{ model.name }}_state_t)s;
        }
    }
    return ({{ model.name }}_state_t)0;  /* unreachable in well-formed config */
}

/* W3C SCXML 3.2: enter `s` and every ancestor on its parent chain. Mirrors
   cpp HierarchicalStateHelper::buildEntryChain followed by the configuration
   set inserts. Idempotent — re-entering an already-active state is a no-op. */
static SCE_C_UNUSED uint32_t config_enter_chain(uint32_t active, {{ model.name }}_state_t s) {
    uint32_t out = active | state_bit(s);
    {{ model.name }}_state_t cur = s;
    while (true) {
        bool has_parent;
        {{ model.name }}_state_t parent = state_get_parent(cur, &has_parent);
        if (!has_parent) {
            break;
        }
        out |= state_bit(parent);
        cur = parent;
    }
    return out;
}

/* W3C SCXML 5.10: codegen-time bitmask of every <final> state. Used by
   {{ model.name }}_is_in_final_state to decide whether the configuration
   has reached a top-level final. */
#define {{ model.name | upper }}_FINAL_MASK ( \
    (uint32_t)0u{% for state_id, state in model.states | dictsort %}{% if state.is_final %} \
    | ((uint32_t)1u << (uint32_t){{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}){% endif %}{% endfor %})

/* W3C SCXML 3.4: <parallel> region-children dispatch. Forward-declared so
   enter_state_recursive can recurse through it before the function body
   appears (mutual recursion: parallel → regions → enter_state_recursive →
   compound/leaf). The body switches on the parallel state and emits one
   enter_state_recursive call per region child in document order. */
static void enter_state_recursive({{ model.name }}_t *sm, {{ model.name }}_state_t s);
static void execute_entry_actions({{ model.name }}_t *sm, {{ model.name }}_state_t s);

static void enter_parallel_regions({{ model.name }}_t *sm, {{ model.name }}_state_t s) {
    (void)sm;
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.is_parallel %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        {% for child_id, child_state in model.states | dictsort %}
        {% if child_state.parent == state_id %}
        enter_state_recursive(sm, {{ model.name | upper }}_STATE_{{ child_id | upper | replace('-', '_') | replace('.', '_') }});
        {% endif %}
        {% endfor %}
        break;
    {% endif %}
    {% endfor %}
    default:
        break;
    }
}

/* W3C SCXML 3.2/3.4/3.6: Unified entry walk. Sets the configuration bit
   chain, runs onentry, then descends — into every region child for a
   <parallel>, into the initial child for a compound state, and stops on
   leaves. Idempotent: re-entering an already-active state is a no-op so
   external transitions whose target's ancestor chain is already partly
   active (cross-compound entry) do not double-fire onentry. */
static void enter_state_recursive({{ model.name }}_t *sm, {{ model.name }}_state_t s) {
    if (config_in(sm->active, s)) {
        return;
    }
    sm->active = config_enter_chain(sm->active, s);
    execute_entry_actions(sm, s);
    if (state_is_parallel(s)) {
        enter_parallel_regions(sm, s);
    } else if (state_is_compound(s)) {
        {{ model.name }}_state_t child = state_get_initial_child(s);
        if (child != s) {
            enter_state_recursive(sm, child);
        }
    }
}

/* ── W3C SCXML 5.9: Action execution (per-state, document-order) ──── */
{# Mirrors the C++ entry_exit_actions.jinja2 dispatch: each `<onentry>` /
   `<onexit>` block lowers via the `emit_action` macro defined above for
   every action it contains. C11 inlines the action body directly (no
   `std::function` wrapper, no EntryExitHelper delegation) — T3 lock-in
   per c11_design_decisions.md.

   The macro splits into per-action-type `c/actions/<type>.jinja2`
   includes only when a second consumer appears; until then keeping all
   variants in one local macro keeps the diff small and the activation
   site explicit.                                                          #}
static void execute_entry_actions({{ model.name }}_t *sm, {{ model.name }}_state_t s) {
    (void)sm;
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.on_entry_blocks %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}: {
        {% for block in state.on_entry_blocks %}
        /* Onentry block {{ loop.index }}/{{ state.on_entry_blocks | length }} */
        {% for action in block %}
        {{ emit_action(action) }}
        {% endfor %}
        {% endfor %}
        break;
    }
    {% endif %}
    {% endfor %}
    default:
        break;
    }
}

static void execute_exit_actions({{ model.name }}_t *sm, {{ model.name }}_state_t s) {
    (void)sm;
    switch (s) {
    {% for state_id, state in model.states | dictsort %}
    {% if state.on_exit_blocks %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}: {
        {% for block in state.on_exit_blocks %}
        /* Onexit block {{ loop.index }}/{{ state.on_exit_blocks | length }} */
        {% for action in block %}
        {{ emit_action(action) }}
        {% endfor %}
        {% endfor %}
        break;
    }
    {% endif %}
    {% endfor %}
    default:
        break;
    }
}

{# W3C SCXML 3.13: Deferred transition body executor. Mirrors the C++
   `executeTransitionActions` switch-on-source-state → switch-on-index
   pattern in `process_transition.jinja2`. The body has to run between
   the exit chain and the entry chain (per W3C 3.13 doc-order:
   exit → transition → entry), so `process_transition` only stores
   `(last_transition_source_state, last_transition_index)` when it
   matches and `handle_hierarchical_transition` invokes this dispatcher
   between `execute_exit_actions` and `execute_entry_actions`.

   When no transition in the SM carries a body, the entire dispatch
   collapses to an `(void)sm` stub so we keep one canonical signature
   across fixtures. #}
{% set any_transition_actions = namespace(value=False) %}
{% for state_id, state in model.states | dictsort %}
{% if state.transitions %}
{% for trans in state.transitions %}
{% if trans.actions %}
{% set any_transition_actions.value = True %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
static void execute_transition_actions({{ model.name }}_t *sm) {
{% if any_transition_actions.value %}
    switch (sm->policy.last_transition_source_state) {
    {% for state_id, state in model.states | dictsort %}
    {% set state_has_actions = state.transitions and (state.transitions | selectattr('actions') | list | length > 0) %}
    {% if state_has_actions %}
    case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}:
        switch (sm->policy.last_transition_index) {
        {% for trans in state.transitions %}
        {% if trans.actions %}
        case {{ trans.transition_index }}: {
            /* W3C SCXML 3.13: transition body for `<transition{% if trans.event %} event="{{ trans.event }}"{% endif %}{% if trans.target %} target="{{ trans.target }}"{% endif %}>` */
            {% for action in trans.actions %}
            {{ emit_action(action) }}
            {% endfor %}
            break;
        }
        {% endif %}
        {% endfor %}
        default:
            break;
        }
        break;
    {% endif %}
    {% endfor %}
    default:
        break;
    }
{% else %}
    (void)sm;
{% endif %}
}

/* ── W3C SCXML 3.13: Transition processing ────────────────────────── */
{# Mirrors the C++ `tryTransitionInState` switch-on-source-state pattern.
   Guarded transitions evaluate `cond` against the Lua datamodel inline
   (no helper/event_matching split — T3 lock-in). Wildcard `event="*"`
   matches every event except the eventless sentinel `EVENT_NONE`
   (eventless transitions have no `event` attribute and are checked via
   `check_eventless_transitions` with `EVENT_NONE` — wildcard must NOT
   pick up that pass, otherwise it would loop forever). Transitions
   are walked in document order; first match wins (W3C 3.13).            #}
{% macro emit_transition_match_check(trans) %}
{% if not trans.event %}
        if (event == {{ model.name | upper }}_EVENT_NONE)
{% elif trans.event == '*' or trans.event == '.*' or trans.event == '_*' %}
        {# W3C SCXML 5.9.3 wildcard: '*' is the spec form; '.*' and '_*'
           are SCE-recognised synonyms in line with analyzer.rs (the same
           three forms register as `has_wildcard`) and parser.rs (the
           same three forms bypass event-name validation). They all
           collapse to "match every non-NONE event" — eventless
           transitions are dispatched separately via EVENT_NONE so the
           wildcard must NOT pick them up, otherwise check_eventless_transitions
           would loop forever. Prefix-suffix wildcards (e.g. "foo.*")
           remain deferred until a fixture forces the prefix-match
           emit shape (cpp/rust use precomputed enum lists or runtime
           string matching; C11 will land that with its first consumer). #}
        if (event != {{ model.name | upper }}_EVENT_NONE)
{% else %}
        if (event == {{ model.name | upper }}_EVENT_{{ trans.event | upper | replace('.', '_') | replace('-', '_') }})
{% endif %}
{% endmacro %}

{# W3C SCXML 3.13: Per-match transition body. Records the source state
   (`check_state` from the surrounding `process_transition` walker, NOT
   `sm->current_state` — for hierarchical bubbling the matching state
   may be an ancestor of the active leaf) plus the precomputed transition
   index, so `execute_transition_actions` can re-find the correct
   action list from `(source, index)` between the exit and entry chains.
   `is_internal` follows `transition_type` after analyzer.rs:423 has
   already collapsed not-proper-descendant `internal` markers down to
   `external` (the spec correction in W3C SCXML 3.13). `transition_type`
   is therefore the only reliable signal — the `trans.is_internal`
   convenience field used previously did not exist on the model and
   silently rendered to `false` for every transition. #}
{% macro emit_transition_body(trans) %}
            sm->policy.last_transition_source_state = check_state;
            sm->policy.last_transition_is_internal = {{ 'true' if trans.type == 'internal' else 'false' }};
            sm->policy.last_transition_is_targetless = {{ 'true' if not trans.target else 'false' }};
            sm->policy.last_transition_index = (uint16_t){{ trans.transition_index }}u;
            {% if trans.target %}
            sm->policy.last_transition_target_state = {{ model.name | upper }}_STATE_{{ trans.target | upper | replace('-', '_') | replace('.', '_') }};
            {% else %}
            sm->policy.last_transition_target_state = check_state;  /* unused for targetless; assigned for switch coverage */
            {% endif %}
            sm->transition_taken = true;
            return true;
{% endmacro %}

static bool process_transition({{ model.name }}_t *sm, {{ model.name }}_event_t event) {
    (void)event;  /* used only inside the per-state switch arms; suppress
                     -Wunused-parameter when no state declares any
                     transitions (e.g. test415: top-level final-only). */
    sm->transition_taken = false;
    /* W3C SCXML 3.13: Walk a single active leaf up the parent chain so
       both event-bound and eventless transitions reach every state in
       the active configuration's spine. cpp selectTransitions /
       selectEventlessTransitions evaluate every active state in
       document order and pick the first match; the leaf-up walk
       achieves the same outcome for single-leaf configurations because
       config_in(active, ancestor) is true for every ancestor of the
       leaf (set by config_enter_chain). For <parallel> configurations
       with transitions inside region children the walk must iterate
       every leaf (test405's region-internal transition forces that
       generalisation); test404 keeps the parallel transition on the
       <parallel> itself, so the leaf-up walk reaches it via either
       region's ancestor path. */
    {{ model.name }}_state_t check_state = config_leaf(sm->active);
    while (true) {
        switch (check_state) {
        {% for state_id, state in model.states | dictsort %}
        {% if state.transitions %}
        case {{ model.name | upper }}_STATE_{{ state_id | upper | replace('-', '_') | replace('.', '_') }}: {
            {% for trans in state.transitions %}
            {{ emit_transition_match_check(trans) }} {
            {% if trans.cond %}
            {% if model.needs_script_engine %}
                /* W3C SCXML 3.13: cond="{{ trans.cond | escape_c }}" (lua eval) */
                bool _trans_pass;
{{ se.lua_eval_guard(trans.cond, '_trans_pass') }}
                if (_trans_pass) {
                    {{ emit_transition_body(trans) }}
                }
            {% else %}
                /* W3C SCXML 3.13: cond="{{ trans.cond | escape_c }}" (native C
                   lower; mirrors cpp process_transition.jinja2 else-branch — C
                   compiler dead-code-eliminates `if (false)` arms). */
                if ({{ trans.cond }}) {
                    {{ emit_transition_body(trans) }}
                }
            {% endif %}
            {% else %}
                {{ emit_transition_body(trans) }}
            {% endif %}
            }
            {% endfor %}
            break;
        }
        {% endif %}
        {% endfor %}
        default:
            break;
        }
        bool _has_parent;
        {{ model.name }}_state_t _parent = state_get_parent(check_state, &_has_parent);
        if (!_has_parent) {
            return false;  /* Reached root, no further bubbling possible. */
        }
        check_state = _parent;
    }
}

/* W3C SCXML 3.13: Hierarchical exit/entry sequence around a transition.
   Reads the transition descriptor from `sm->policy` (source/target/internal/
   targetless flags) populated by emit_transition_body at match time, and
   updates the configuration bitmap `sm->active` directly. Mirrors cpp
   StaticExecutionEngine::handleHierarchicalTransition.
   - targetless: transition body only, no configuration change.
   - internal (target is proper descendant of source — analyzer.rs
     downgrades all other internal markers to external): exit the
     active descendants under source, body, entry-descend onto target.
   - external: exit chain includes the source itself, body, entry-descend
     onto target. The active descendants of the source are identified via
     `is_descendant_of` over the bitmap.

   Full LCA(source, target) computation — the case where the target is
   neither a proper descendant of the source nor a sibling/cousin under
   the same parent — is intentionally deferred. test503/505/506 each
   satisfy LCA == parent(source); a deeper-LCA fixture lands the generalised
   walk alongside the cpp HierarchicalStateHelper mirror. */
static void handle_hierarchical_transition({{ model.name }}_t *sm) {
    if (sm->policy.last_transition_is_targetless) {
        execute_transition_actions(sm);
        return;
    }
    {{ model.name }}_state_t source = sm->policy.last_transition_source_state;
    {{ model.name }}_state_t target = sm->policy.last_transition_target_state;

    /* W3C SCXML 3.13: Exit chain — every active descendant of source plus
       source itself when the transition is external. Iterates the full
       configuration bitmap in reverse enum order so multi-leaf
       (<parallel>) exits drain every region simultaneously. Reverse
       enum-value order approximates reverse document order: the parser
       sorts states alphabetically, child IDs typically extend the parent
       (e.g. s01p2 > s01p1 > s01p), and that ordering is what
       test404/test405 verify for their <parallel> exit sequences. A
       fixture whose alphabetical order diverges from doc order will
       force a codegen-time doc-order list (cpp's StateRegistry mirror). */
    for (uint32_t bit = (uint32_t){{ model.name | upper }}_STATE_COUNT; bit > 0u; --bit) {
        {{ model.name }}_state_t s = ({{ model.name }}_state_t)(bit - 1u);
        if ((sm->active & state_bit(s)) == 0u) {
            continue;
        }
        if (s == source || !is_descendant_of(s, source)) {
            continue;
        }
        execute_exit_actions(sm, s);
        sm->active &= ~state_bit(s);
    }
    if (!sm->policy.last_transition_is_internal) {
        execute_exit_actions(sm, source);
        sm->active &= ~state_bit(source);
    }

    execute_transition_actions(sm);

    /* W3C SCXML 3.13: Entry chain — enter the target and (recursively)
       its initial descendants / parallel region children. Idempotent
       config_enter_chain inside enter_state_recursive ensures ancestors
       already active under an internal transition (source preserved)
       stay set without double onentry. Cross-compound entry that crosses
       inactive ancestors runs per-ancestor onentry only when the deeper
       LCA fixture forces buildEntryChain mirror — current test503/505/506
       and test404/405 all satisfy LCA == parent(source). */
    enter_state_recursive(sm, target);
}

/* ── W3C SCXML 6.2: External-facing raise APIs ────────────────────── */

void {{ model.name }}_raise({{ model.name }}_t *sm,
                            const {{ model.name }}_event_with_meta_t *evt) {
    event_queue_push(&sm->internal_queue, evt);
}

void {{ model.name }}_raise_external({{ model.name }}_t *sm,
                                     const {{ model.name }}_event_with_meta_t *evt) {
    event_queue_push(&sm->external_queue, evt);
}

/* ── RTC core (mirrors StaticExecutionEngine<Policy>::*) ──────────── */

{# W3C SCXML 5.10: Snapshot the dequeued event into the `_event` lua
   table so onentry/onexit/transition cond expressions can read
   `_event.name`. Mirrors the C++ `LuaEngine::setCurrentEvent` overload
   that pushes a fresh table on every dequeue. The C11 backend has the
   compile-time-known set of event names available, so the dispatch is a
   switch on the enum — no runtime enum→string lookup table is carried.
   Only `.name` is populated in this milestone; the other W3C 5.10.1
   metadata fields (.data/.type/.sendid/.origin/.origintype/.invokeid)
   land with the first fixture that reads them (built-but-unconsumed
   carve-out per feedback_built_but_unconsumed.md). The helper is
   emitted only when the fixture uses the script engine; datamodel-less
   fixtures have no lua_State and no consumer for _event. The (void)
   casts keep the helper warning-free under -Wextra when the fixture
   declares no events (then both the switch and the parameters fall
   through unused). #}
{% if model.needs_script_engine %}
static void set_current_event(lua_State *L, {{ model.name }}_event_t e) {
    (void)L;
    (void)e;
    switch (e) {
    {% for event_name in model.events | sort %}
    case {{ model.name | upper }}_EVENT_{{ event_name | upper | replace('.', '_') | replace('-', '_') }}:
        (void)luaL_dostring(L, "_event = {name = '{{ event_name | escape_c }}'}");
        break;
    {% endfor %}
    default:
        break;
    }
}
{% endif %}

/* W3C SCXML 6.2: Drain internal then external queue. The C++ engine
   delegates to `EventProcessingAlgorithms::processInternalEventQueue`
   with a lambda; here that lambda is inlined as the loop body. The
   external pass mirrors the internal one in E1 — finalize / autoforward
   hooks (HasFinalize / HasAutoforward constexpr branches in C++) are
   deferred until E4 lands the invoke surface. */
static void process_event_queues({{ model.name }}_t *sm) {
    {{ model.name }}_event_with_meta_t evt;

    while (event_queue_pop(&sm->internal_queue, &evt)) {
        strncpy(sm->current_event_invoke_id, evt.invoke_id, (size_t)SCE_MAX_ID_LEN - 1u);
        sm->current_event_invoke_id[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
        {% if model.needs_script_engine %}
        set_current_event(sm->L, evt.event);
        {% endif %}

        if ({{ model.name }}_is_in_final_state(sm)) {
            return;
        }

        if (process_transition(sm, evt.event)) {
            handle_hierarchical_transition(sm);
        }
    }

    while (event_queue_pop(&sm->external_queue, &evt)) {
        strncpy(sm->current_event_invoke_id, evt.invoke_id, (size_t)SCE_MAX_ID_LEN - 1u);
        sm->current_event_invoke_id[(size_t)SCE_MAX_ID_LEN - 1u] = '\0';
        {% if model.needs_script_engine %}
        set_current_event(sm->L, evt.event);
        {% endif %}

        if ({{ model.name }}_is_in_final_state(sm)) {
            return;
        }

        if (process_transition(sm, evt.event)) {
            handle_hierarchical_transition(sm);
        }
    }
}

/* W3C SCXML 6.2 (Appendix D, eventless microstep loop):
   Repeat eventless transitions until the configuration stops changing or
   a top-level final state is reached. The 100-iteration ceiling mirrors
   the C++ guard against pathological cycles (`MAX_ITERATIONS`). */
static void check_eventless_transitions({{ model.name }}_t *sm) {
    int iter = 0;
    while (iter < 100) {
        if ({{ model.name }}_is_in_final_state(sm)) {
            return;
        }
        if (!process_transition(sm, {{ model.name | upper }}_EVENT_NONE)) {
            return;
        }
        handle_hierarchical_transition(sm);
        iter++;
    }
}

void {{ model.name }}_step({{ model.name }}_t *sm) {
    process_event_queues(sm);
    check_eventless_transitions(sm);
    if ({{ model.name }}_is_in_final_state(sm) && sm->completion_callback != NULL) {
        sm->completion_callback(sm->completion_callback_user_data);
    }
}

void {{ model.name }}_run({{ model.name }}_t *sm) {
    sm->is_running = true;
    while (sm->is_running && !{{ model.name }}_is_in_final_state(sm)) {
        uint32_t before = sm->active;
        {{ model.name }}_step(sm);
        /* True quiescence: configuration unchanged AND both queues empty.
           The queue check covers the exit/entry-action follow-on path —
           an eventless transition can run an <onexit> that <raise>s a
           fresh event leaving the configuration unchanged from the
           run-loop's vantage if the eventless block stops there; we
           must continue so the next step() drains those queued events.
           Comparing `sm->active` (full bitmap) instead of a single-leaf
           `current_state` correctly handles configurations where multiple
           bits change in one step (W3C 3.13 transition body actions
           setting more than one ancestor bit). */
        if (sm->active == before
            && sm->internal_queue.count == 0u
            && sm->external_queue.count == 0u) {
            break;
        }
    }
    sm->is_running = false;
}

void {{ model.name }}_init({{ model.name }}_t *sm) {
    memset(sm, 0, sizeof(*sm));
    {% if model.needs_script_engine %}
    /* W3C SCXML 5.10: Open Lua engine and seed datamodel before any
       <onentry> body runs (those bodies may reference datamodel vars). */
{{ se.lua_init_engine() }}
    {% endif %}
    /* W3C SCXML 3.2: Configuration entry via the unified
       enter_state_recursive walk — sets the initial root and every
       ancestor / region-child / initial-descendant bit, runs onentry in
       walk order. Mirrors cpp StaticExecutionEngine::initialize entry
       loop. The recursion handles compound, parallel, and leaf states
       uniformly. */
    enter_state_recursive(sm, {{ model.name }}_initial_state());
    /* W3C SCXML 6.4: Macrostep completion loop. Mirrors the cpp
       StaticExecutionEngine::initialize tail: keep firing eventless
       transitions and processing internal/external events until both
       stabilise. Without this loop the first event raised in an
       <onentry> block races ahead of the source state's eventless
       <transition> because step() drains the queue before it checks
       eventless transitions; the queued event then has no matching
       transition in the entered state and is silently dropped
       (test503/505/506 force this). */
    while (true) {
        check_eventless_transitions(sm);
        if (sm->internal_queue.count == 0u && sm->external_queue.count == 0u) {
            break;
        }
        process_event_queues(sm);
    }
}

void {{ model.name }}_destroy({{ model.name }}_t *sm) {
    {% if model.needs_script_engine %}
{{ se.lua_destroy_engine() }}
    {% else %}
    (void)sm;
    {% endif %}
}

uint32_t {{ model.name }}_active_states(const {{ model.name }}_t *sm) {
    return sm->active;
}

bool {{ model.name }}_in_state(const {{ model.name }}_t *sm,
                               {{ model.name }}_state_t s) {
    return config_in(sm->active, s);
}

bool {{ model.name }}_is_in_final_state(const {{ model.name }}_t *sm) {
    return (sm->active & {{ model.name | upper }}_FINAL_MASK) != 0u;
}
