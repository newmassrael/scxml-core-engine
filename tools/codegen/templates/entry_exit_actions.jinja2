                             static_cast<int>(parallelState), "{{ state.parent }}");

                    // W3C SCXML 3.4: Use shared Helper (ARCHITECTURE.md Zero Duplication Principle)
                    if (::SCE::Core::ParallelCompletionHelper::areAllRegionsInFinal<State, {{ model.name }}Policy>(
                            parallelState, activeStates_)) {
                        AOT_DEBUG("All regions of parallel state {} are complete, generating done.state event",
                                 static_cast<int>(parallelState));
                        engine.raise(typename Engine::EventWithMetadata(Event::Done_state_{{ model.states[state.parent].parent }}));
                    }
                }
{% endif %}
{% endif %}
{% endif %}
                }
{% endif %}
                break;
{% endfor %}
        default:
            break;
        }
{% endif %}{# model.has_entry_actions #}
{% if model.has_parallel_states %}

        // W3C SCXML 3.4: If entering parallel state, enter all child regions and their initial children
        // This ensures parallel states behave like Interpreter (auto-enter all regions)
        if (isParallelState(state)) {
            AOT_DEBUG("AOT executeEntryActions: State {} is parallel, entering child regions", static_cast<int>(state));
            auto regions = getParallelRegions(state);
            for (const auto& region : regions) {
                AOT_DEBUG("AOT executeEntryActions: Entering parallel region {}", static_cast<int>(region));
                executeEntryActions(region, engine);

                // W3C SCXML 3.3: If region is compound, enter initial child
                if (isCompoundState(region)) {
                    State initialChild = getInitialChild(region);
                    if (initialChild != region) {
                        AOT_DEBUG("AOT executeEntryActions: Entering initial child {} of region {}",
                                 static_cast<int>(initialChild), static_cast<int>(region));
                        executeEntryActions(initialChild, engine);
                    }
                }
            }
        }

        // W3C SCXML 3.3: If entering compound state (non-parallel), enter initial child
        // W3C SCXML 3.6: Support deep initial targets (space-separated descendant state IDs)
        if (isCompoundState(state) && !isParallelState(state)) {
            // W3C SCXML 3.6: Check if state has multiple or deep initial targets
            switch (state) {
            {% for state_id, state in model.states | dictsort %}
            {% if state.initial_children and state.initial_children|length > 0 %}
            case State::{{ state_id | capitalize }}:
                AOT_DEBUG("AOT executeEntryActions: State {} has initial children, delegating to StateEntryHelper",
                         static_cast<int>(state));
                enterDeepInitialTargets_{{ state_id | capitalize }}(engine);
                break;
            {% endif %}
            {% endfor %}
            default:
                    // No explicit initial children - use single initial child
                    State initialChild = getInitialChild(state);
                    if (initialChild != state) {
                        AOT_DEBUG("AOT executeEntryActions: State {} is compound, entering initial child {}",
                                 static_cast<int>(state), static_cast<int>(initialChild));
                        executeEntryActions(initialChild, engine);
                    }
                    break;
            }
        }
{% endif %}
    }

    template <typename Engine>
{# W3C SCXML 3.11: history recording mutates the non-static history_{id}   #}
{# members declared in the Policy class, so executeExitActions must be an  #}
{# instance method whenever any <history> child exists. Every W3C history  #}
{# test happens to declare a datamodel, so needs_script_engine already     #}
{# lands them on the non-static branch — but a datamodel-less history      #}
{# cross-product would fall through every other flag and select static,    #}
{# triggering "invalid use of non-static member" at instance-write sites.  #}
{# SCE_MESH.md §9.6.2 — remote `<invoke type="scxml">` lands onexit        #}
{# cancel code that reads/erases `activeInvokes_` and                      #}
{# `pendingDoneInvoke_<id>_` (instance members). A parent whose only       #}
{# scxml invoke is remote-mesh drops out of `invokes | scxml` (the         #}
{# W3C-local filter), so the static branch would strand those body         #}
{# references. Mirrors the paired `sessionId_` gate in                     #}
{# `state_machine.jinja2`.                                                 #}
{% if not model.needs_script_engine and not model.invokes | scxml and not model.invokes | scxml_remote and not model.needs_parent_template and not model.needs_event_scheduler and not model.has_parallel_states and not model.context_objects and not model.has_history_states %}    [[gnu::hot]] static void executeExitActions([[maybe_unused]] State state, [[maybe_unused]] Engine& engine, [[maybe_unused]] const std::vector<State>& activeStatesBeforeTransition) {
{% else %}    [[gnu::hot]] void executeExitActions([[maybe_unused]] State state, [[maybe_unused]] Engine& engine, [[maybe_unused]] const std::vector<State>& activeStatesBeforeTransition) {
{% endif %}

{% if model.has_parallel_states %}
        // W3C SCXML 3.4 + 3.13: Parallel state exit order
        // Matches Interpreter's exitParallelStateAndDescendants() logic
        AOT_DEBUG("AOT executeExitActions: Checking if state {} is parallel", static_cast<int>(state));
        if (isParallelState(state)) {
            AOT_DEBUG("AOT executeExitActions: State {} IS parallel, collecting active descendants", static_cast<int>(state));

            // W3C SCXML 3.4: Collect all active descendants of this parallel state
            // Matches Interpreter's collectDescendantStates() - exit ALL active descendants, not just direct regions
            ::std::vector<State> descendantsToExit;
            for (State activeState : activeStates_) {
                if (activeState != state && isDescendantOf(activeState, state)) {
                    descendantsToExit.push_back(activeState);
                    AOT_DEBUG("AOT executeExitActions: Found active descendant {} of parallel state {}",
                             static_cast<int>(activeState), static_cast<int>(state));
                }
            }

            AOT_DEBUG("AOT executeExitActions: Found {} active descendants to exit", descendantsToExit.size());

            // W3C SCXML 3.13: Sort descendants by reverse document order (deepest states exit first)
            ::std::sort(descendantsToExit.begin(), descendantsToExit.end(),
                       [](State a, State b) {
                           return getDocumentOrder(a) > getDocumentOrder(b);
                       });

            // Exit each active descendant (deepest first)
            for (State descendant : descendantsToExit) {
                AOT_DEBUG("AOT executeExitActions: Exiting active descendant {}", static_cast<int>(descendant));
                executeExitActions(descendant, engine, activeStatesBeforeTransition);
            }

            AOT_DEBUG("AOT executeExitActions: All active descendants exited, now exiting parallel state {} itself", static_cast<int>(state));
            // After exiting all descendants, fall through to exit parallel state itself
        } else {
            AOT_DEBUG("AOT executeExitActions: State {} is NOT parallel, proceeding to switch", static_cast<int>(state));
        }
{% endif %}
{% if model.has_parallel_states or model.uses_in_predicate %}
        // W3C SCXML 3.4/3.12.1: Remove state from active configuration (parallel states and In() predicate)
        AOT_DEBUG("AOT executeExitActions: Removing state {} from activeStates", static_cast<int>(state));
        {
            ::std::lock_guard<::std::mutex> lock(activeStatesMutex_);
            activeStates_.erase(
                std::remove(activeStates_.begin(), activeStates_.end(), state),
                activeStates_.end()
            );
        }
{% endif %}
        {% if model.history_states %}
        // W3C SCXML 3.11: Record history before exiting compound states (matches Interpreter logic)
        // Use pre-transition active states (captured before processTransition modified currentState_)
        const std::vector<State>& activeStates = activeStatesBeforeTransition;
        
        {% for history_id, history_info in model.history_states | dictsort %}
        if (state == State::{{ history_info.parent | capitalize }}) {
            // W3C SCXML 3.11: Filter states using HistoryHelper (shared with Interpreter)
            auto filteredStates = ::SCE::Core::HistoryHelper::recordHistory(
                activeStates,
                State::{{ history_info.parent | capitalize }},
                HistoryType::{{ history_info.type.upper() }},
                [](State s) { return {{ model.name }}Policy::getParent(s); }
            );
            
            // W3C SCXML 3.11: Record even if empty (valid scenario - state was active with no children)
            history_{{ history_id }} = filteredStates;
            AOT_DEBUG("Recorded {{ history_info.type }} history for {{ history_id }}: {} states", filteredStates.size());
        }
        {% endfor %}
        {% endif %}
{% if model.has_exit_actions %}
        switch (state) {
{% for state_id, state in model.states | dictsort %}
{% if state.on_exit_blocks or state.invokes | scxml or state.invokes | hybrid or state.invokes | mesh_rpc or state.invokes | scxml_remote %}
        case State::{{ state_id | capitalize }}:
                AOT_DEBUG("AOT executeExitActions: Processing exit actions for state {} ({{ state_id }})", static_cast<int>(state));
{% if state.on_exit_blocks or state.invokes | scxml or state.invokes | hybrid or state.invokes | mesh_rpc or state.invokes | scxml_remote %}
                {
{% if state.invokes | scxml or state.invokes | hybrid %}
                // W3C SCXML 6.4: Cancel pending invokes for exited state (ARCHITECTURE.md Zero Duplication)
                ::SCE::Core::InvokeHelper::cancelInvokesForState(pendingInvokes_, state);
                {% for invoke_info in state.invokes | scxml %}
                if (child_{{ invoke_info.field_suffix }}_) {
{% if 'cancel.invoke' in model.events %}
                    if (!pendingDoneInvoke_{{ invoke_info.invoke_id }}_) {
                        engine.raise(typename Engine::EventWithMetadata(Event::Cancel_invoke));
                    }
{% endif %}
                    child_{{ invoke_info.field_suffix }}_.reset();
                }
                activeInvokes_.erase("{{ invoke_info.invoke_id }}");
{% endfor %}
                {% for invoke_info in state.invokes | hybrid %}
                if (child_{{ invoke_info.field_suffix }}_) {
{% if 'cancel.invoke' in model.events %}
                    if (!pendingDoneInvoke_{{ invoke_info.invoke_id }}_) {
                        engine.raise(typename Engine::EventWithMetadata(Event::Cancel_invoke));
                    }
{% endif %}
                    child_{{ invoke_info.field_suffix }}_.reset();
                }
                activeInvokes_.erase("{{ invoke_info.invoke_id }}");
{% endfor %}
{% endif %}
{% if state.invokes | scxml_remote %}
                // SCE_MESH.md §9.6.2 wire 19 — notify remote child session(s)
                // that the parent is leaving the invoking state (W3C §6.4.5).
                // `pendingDoneInvoke_..._` suppresses the cancel when the
                // child has already signalled `done.invoke` (wire-18 arrived
                // earlier this macrostep) — the session is gone on the
                // worker side, sending a cancel would be a benign no-op but
                // the transport send is skipped for cleanliness.
                {% for invoke_info in state.invokes | scxml_remote %}
                if (activeInvokes_.find("{{ invoke_info.invoke_id }}") != activeInvokes_.end() && !pendingDoneInvoke_{{ invoke_info.invoke_id }}_) {
                    (void)engine.performScxmlInvokeCancel(
                        "{{ invoke_info.remote_mesh_target }}",
                        "{{ invoke_info.invoke_id }}");
                }
                activeInvokes_.erase("{{ invoke_info.invoke_id }}");
                {% endfor %}
{% endif %}
{% if state.invokes | mesh_rpc %}
                // SCE_MESH.md §9.5: cancel pending mesh-rpc invokes on exit.
                // performMeshCancel erases the correlation entry and the
                // armed deadline atomically; no cancel envelope is placed
                // on the wire (late replies are silently dropped). W3C §6.4
                // <cancel> semantics for mesh-rpc do not raise done/error,
                // so no event is emitted here.
                {% for invoke_info in state.invokes | mesh_rpc %}
{% if invoke_info.srcexpr %}
                // SCE_MESH.md §9.5 srcexpr cancel: reuse the literal the
                // entry block resolved (stashed in _mesh_resolved_src_*_).
                // Empty stash means entry failed before registering the
                // correlation entry, so performMeshCancel is skipped.
                if (!this->_mesh_resolved_src_{{ invoke_info.field_suffix }}_.empty()) {
                    (void)engine.performMeshCancel(
                        this->_mesh_resolved_src_{{ invoke_info.field_suffix }}_,
                        "{{ invoke_info.field_suffix }}");
                    this->_mesh_resolved_src_{{ invoke_info.field_suffix }}_.clear();
                }
{% else %}
                (void)engine.performMeshCancel("{{ invoke_info.src }}", "{{ invoke_info.field_suffix }}");
{% endif %}
                {% endfor %}
{% endif %}
{% if state.on_exit_blocks %}
{% set single_cpp_exit_action = (state.on_exit_blocks|length == 1 and state.on_exit_blocks[0]|length == 1 and state.on_exit_blocks[0][0].type == 'script' and state.on_exit_blocks[0][0].is_cpp_function) %}
{% if single_cpp_exit_action %}
                // W3C SCXML 3.9.6: Single <cpp> action - direct call (true Zero Overhead)
                // Optimization: No std::vector, std::function, or EntryExitHelper overhead
                {{ state.on_exit_blocks[0][0].content_transformed | trim }};
{% else %}
                {
                    // W3C SCXML 3.9: Build onexit block lambdas for EntryExitHelper
                    // ARCHITECTURE.md Zero Duplication: Delegate to shared Helper (lines 311-373)
                    std::vector<std::function<void()>> exitBlocks;
{% for block in state.on_exit_blocks %}
                    exitBlocks.push_back([{% if model.needs_nonstatic_method %}this, {% endif %}&engine]() {
                        // Onexit block {{ loop.index }}/{{ state.on_exit_blocks|length }}
{% for action in block %}
                        {% set in_entry_exit = true %}
                        {% include 'actions/' + action.type + '.jinja2' %}

{% endfor %}
                    });
{% endfor %}
                    // W3C SCXML 3.9: Delegate to EntryExitHelper (Single Source of Truth)
                    // This achieves ARCHITECTURE.md Zero Duplication between Interpreter and AOT engines
                    ::SCE::Core::EntryExitHelper<{{ model.name }}Policy, Engine>::executeExitBlocks(
                        exitBlocks, engine, "{{ state_id }}"
                    );
                }
{% endif %}
{% endif %}
                }
{% endif %}
                break;
{% endif %}{# state has exit actions #}
{% endfor %}
        default:
            break;
        }
{% endif %}{# model.has_exit_actions #}
    }
