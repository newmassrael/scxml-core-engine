{#
    Entry/Exit Actions Template (Jinja2)

    Last Modified: 2025-10-26
    ARCHITECTURE.md Version: 2025-10-23

    W3C SCXML 3.7/3.8/3.9: Entry and exit action execution.

    Generates:
    - executeEntryActions(state, engine)
    - executeExitActions(state, engine, preTransitionActive)

    Invoke lifecycle methods (executePendingInvokes, tickChildren, forwardToAutoforward,
    executeFinalizeForChildEvent) are in invoke_methods.jinja2.

    ARCHITECTURE.md Compliance (Lines 311-491):
    - Zero Duplication: Uses shared Helper classes for all W3C SCXML semantics
    - Single Source of Truth: All logic delegated to Helper classes shared with Interpreter
    - Long-Term Correctness: No workarounds, complete W3C SCXML implementation

    Helper Classes Used:
    - ForeachHelper: W3C SCXML 5.6 (ARCHITECTURE.md lines 738-748)
    - SendHelper: W3C SCXML 6.2 (ARCHITECTURE.md lines 750-764)
    - AssignHelper: W3C SCXML 5.3/5.4 (ARCHITECTURE.md lines 766-779)
    - DoneDataHelper: W3C SCXML 5.5/5.7 (ARCHITECTURE.md lines 781-797)
    - NamelistHelper: W3C SCXML C.1/6.2 (ARCHITECTURE.md lines 799-812)
    - InvokeHelper: W3C SCXML 6.4 (ARCHITECTURE.md lines 814-840)
    - HierarchicalStateHelper: W3C SCXML 3.12/3.7/3.8 (ARCHITECTURE.md lines 842-871)
    - SendSchedulingHelper: W3C SCXML 6.2 (ARCHITECTURE.md lines 873-884)

    Features Implemented:
    - W3C SCXML 3.4: Parallel state auto-entry (enter all child regions)
    - W3C SCXML 3.7.1: Parallel state done.state event generation
    - W3C SCXML 3.8: Onexit handlers with datamodel updates
    - W3C SCXML 3.9: Entry/exit action execution
    - W3C SCXML 6.4: Static invoke lifecycle management

    Bug Fixes:
    - 2025-10-26: eventData propagation to done.state events (W3C SCXML test 527)
      Issue: DoneDataHelper evaluated eventData but EventWithMetadata was created without it
      Root Cause: Template generated done.state event without passing evaluated eventData parameter
      Fix: Conditional {% if state.donedata %} to pass eventData to EventWithMetadata constructor
      Impact: W3C SCXML 5.5 _event.data now correctly populated for all donedata content/param tests
      Verification: Test 527 (donedata content expr) passes with _event.data == 'foo' guard evaluation
#}

    template<typename Engine>
{% if not model.needs_script_engine and not model.static_invokes and not model.has_parent_communication and not model.needs_event_scheduler and not model.has_parallel_states and not model.context_objects %}    [[gnu::hot]] static void executeEntryActions([[maybe_unused]] State state, [[maybe_unused]] Engine& engine) {
{% else %}    [[gnu::hot]] void executeEntryActions([[maybe_unused]] State state, [[maybe_unused]] Engine& engine) {
{% endif %}
{% if model.has_parallel_states or model.uses_in_predicate %}
        // W3C SCXML 3.4/3.12.1: Add state to active configuration for parallel states and In() predicate
        {
            ::std::lock_guard<::std::mutex> lock(activeStatesMutex_);
            bool alreadyActive = false;
            for (State s : activeStates_) {
                if (s == state) {
                    alreadyActive = true;
                    break;
                }
            }
            if (!alreadyActive) {
                AOT_DEBUG("AOT executeEntryActions: Adding state {} to activeStates", static_cast<int>(state));
                activeStates_.push_back(state);
            } else {
                return;  // W3C SCXML 3.8: Skip onentry actions for duplicate state entry
            }
        }
{% endif %}
{% if model.has_entry_actions %}
        switch (state) {
{% for state_id, state in model.states.items() %}
            case State::{{ state_id | capitalize }}:
{% if state.datamodel or state.on_entry_blocks or state.static_invokes or state.hybrid_invokes or (state.is_final and state.donedata) or (state.is_final and state.parent) %}
                {
{% if state.datamodel and model.binding == 'late' %}
                // ============================================================
                // W3C SCXML 5.9: LATE BINDING - Initialize datamodel on state entry
                // ARCHITECTURE.md Zero Duplication: DataModelInitHelper shared with Interpreter
                // ARCHITECTURE.md DRY Principle: Uses datamodel_macros.jinja2
                // ============================================================
                ensureScriptEngine();
                auto& scriptEngine = getScriptEngine();
{% import 'datamodel_macros.jinja2' as dm %}
{{ dm.initialize_state_datamodel(state, state_id, "AOT executeEntryActions: Late binding initialized", base_path) }}

{% endif %}
{% if state.static_invokes %}
                // ============================================================
                // W3C SCXML 6.4: STATIC INVOKE - Pure AOT Strategy
                // ARCHITECTURE.md All-or-Nothing: Parent and child both use statically generated code
                // Defer invoke execution until macrostep end (ARCHITECTURE.md Zero Duplication)
                // ============================================================
{% for invoke_info in state.static_invokes %}
                // W3C SCXML 3.12.1: Generate invoke ID in "stateid.platformid.index" format
                // Include invoke index to ensure uniqueness for multiple invokes in same state
                std::string generatedInvokeId_{{ invoke_info.invoke_id }} = "{{ state_id }}." + std::to_string(reinterpret_cast<uintptr_t>(this)) + ".{{ invoke_info.invoke_id }}";

                {% if invoke_info.idlocation %}
                // W3C SCXML 6.4.1: Store generated invokeId in parent datamodel via idlocation (at defer time)
                {
                    ensureScriptEngine();
                    auto& scriptEngine = getScriptEngine();
                    scriptEngine.setVariable(sessionId_.value(), "{{ invoke_info.idlocation }}", generatedInvokeId_{{ invoke_info.invoke_id }}).get();
                    AOT_DEBUG("Set idlocation {{ invoke_info.idlocation }} = {}", generatedInvokeId_{{ invoke_info.invoke_id }});
                }
                {% endif %}

                // Defer invoke: {{ invoke_info.invoke_id }} ({{ invoke_info.src }})
                ::SCE::Core::InvokeHelper::deferInvoke(pendingInvokes_,
                    PendingInvoke{generatedInvokeId_{{ invoke_info.invoke_id }}, State::{{ state_id | capitalize }}});
                AOT_DEBUG("Deferred invoke: {} in state {{ state_id }}", generatedInvokeId_{{ invoke_info.invoke_id }});
{% endfor %}
{% endif %}
{% if state.hybrid_invokes %}
                // ============================================================
                // W3C SCXML 6.4: HYBRID INVOKE - Static Hybrid Strategy
                // ARCHITECTURE.md Hybrid Strategy: AOT parent evaluates expr + creates Interpreter child
                // Defer invoke execution until macrostep end (ARCHITECTURE.md Zero Duplication)
                // ============================================================
                {% for invoke_info in state.hybrid_invokes %}
                // W3C SCXML 3.12.1: Generate invoke ID in "stateid.platformid.index" format
                // Include invoke index to ensure uniqueness for multiple invokes in same state
                std::string generatedInvokeId_{{ invoke_info.invoke_id }} = "{{ state_id }}." + std::to_string(reinterpret_cast<uintptr_t>(this)) + ".{{ invoke_info.invoke_id }}";

                {% if invoke_info.idlocation %}
                // W3C SCXML 6.4.1: Store generated invokeId in parent datamodel via idlocation (at defer time)
                {
                    ensureScriptEngine();
                    auto& scriptEngine = getScriptEngine();
                    scriptEngine.setVariable(sessionId_.value(), "{{ invoke_info.idlocation }}", generatedInvokeId_{{ invoke_info.invoke_id }}).get();
                    AOT_DEBUG("Set idlocation {{ invoke_info.idlocation }} = {}", generatedInvokeId_{{ invoke_info.invoke_id }});
                }
                {% endif %}

                // Defer hybrid invoke: {{ invoke_info.invoke_id }} {% if invoke_info.srcexpr %}(srcexpr: {{ invoke_info.srcexpr }}){% elif invoke_info.contentexpr %}(contentexpr: {{ invoke_info.contentexpr }}){% endif %}

                ::SCE::Core::InvokeHelper::deferInvoke(pendingInvokes_,
                    PendingInvoke{generatedInvokeId_{{ invoke_info.invoke_id }}, State::{{ state_id | capitalize }}});
                AOT_DEBUG("Deferred hybrid invoke: {} in state {{ state_id }}", generatedInvokeId_{{ invoke_info.invoke_id }});
{% endfor %}
{% endif %}
{% if state.on_entry_blocks %}
{% set single_cpp_action = (state.on_entry_blocks|length == 1 and state.on_entry_blocks[0]|length == 1 and state.on_entry_blocks[0][0].type == 'script' and state.on_entry_blocks[0][0].is_cpp_function) %}
{% if single_cpp_action %}
                // W3C SCXML 3.8.6: Single <cpp> action - direct call (true Zero Overhead)
                // Optimization: No std::vector, std::function, or EntryExitHelper overhead
                {{ state.on_entry_blocks[0][0].content_transformed | trim }};
{% else %}
                {
                    // W3C SCXML 3.8: Build onentry block lambdas for EntryExitHelper
                    // ARCHITECTURE.md Zero Duplication: Delegate to shared Helper (lines 311-373)
                    std::vector<std::function<void()>> entryBlocks;
{% for block in state.on_entry_blocks %}
                    entryBlocks.push_back([{% if model.needs_nonstatic_method %}this, {% endif %}&engine]() {
                        // Onentry block {{ loop.index }}/{{ state.on_entry_blocks|length }}
{% for action in block %}
                        {% set in_entry_exit = true %}
                        {% include 'actions/' + action.type + '.jinja2' %}

{% endfor %}
                    });
{% endfor %}
                    // W3C SCXML 3.8: Delegate to EntryExitHelper (Single Source of Truth)
                    // This achieves ARCHITECTURE.md Zero Duplication between Interpreter and AOT engines
                    ::SCE::Core::EntryExitHelper<{{ model.name }}Policy, Engine>::executeEntryBlocks(
                        entryBlocks, engine, "{{ state_id }}"
                    );
                }
{% endif %}
{% endif %}
{% if state.initial_transition_actions %}
                // W3C SCXML 3.3.2: Execute <initial> transition executable content
                // This content executes AFTER parent onentry and BEFORE child state entry
{% for action in state.initial_transition_actions %}
                {% set in_entry_exit = true %}
                {% include 'actions/' + action.type + '.jinja2' %}

{% endfor %}
{% endif %}
{% if state.initial_history_id %}
                // W3C SCXML 3.11: Initial transition targets history state {{ state.initial_history_id }}
                // Execute history default transition executable content if no history is stored
                if (!history_{{ state.initial_history_id }}.has_value() || history_{{ state.initial_history_id }}->empty()) {
                    AOT_DEBUG("AOT history: No stored history for {{ state.initial_history_id }}, executing default transition actions");
{% for action in state.initial_history_default_actions %}
                    {% set in_entry_exit = true %}
                    {% include 'actions/' + action.type + '.jinja2' %}

{% endfor %}
                } else {
                    AOT_DEBUG("AOT history: Found stored history for {{ state.initial_history_id }}, skipping default transition actions");
                }
{% endif %}
{% if state.is_final and state.donedata %}
                // W3C SCXML 5.5: Evaluate donedata for final state
                {
                    std::string eventData;
                    std::optional<ScriptValue> typedData;
{% if state.donedata.params %}
                    // W3C SCXML 5.5: Evaluate <param> elements
                    this->ensureScriptEngine();
                    auto& scriptEngine = getScriptEngine();
                    std::vector<std::pair<std::string, std::string>> params = {
{% for param in state.donedata.params %}
                        {"{{ param.name }}", "{{ param.location if param.location else param.expr }}"}{{ "," if not loop.last }}
{% endfor %}
                    };

                    // W3C SCXML 5.7: "If the location expression does not denote a valid location in the data model..."
                    // Empty param location raises error.execution and prevents done.state event generation
                    bool success = ::SCE::DoneDataHelper::evaluateParams(
                        scriptEngine,
                        sessionId_.value(),
                        params,
                        eventData,
                        [&engine](const std::string& msg) {
                            SCE_LOG_WARN("Donedata param evaluation failed: {}", msg);
                            engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, msg));
                        },
                        &typedData
                    );

                    // W3C SCXML 5.7: If structural error (empty location), skip done.state event
                    if (!success) {
                        AOT_DEBUG("Skipping done.state event due to structural donedata error");
                        break;
                    }
{% elif state.donedata.contentexpr %}
                    // W3C SCXML 5.5: Evaluate <content expr="..."/>
                    this->ensureScriptEngine();
                    auto& scriptEngine = getScriptEngine();
                    ::SCE::DoneDataHelper::evaluateContent(
                        scriptEngine,
                        sessionId_.value(),
                        "{{ state.donedata.contentexpr }}",
                        eventData,
                        [&engine](const std::string& msg) {
                            SCE_LOG_WARN("Donedata content evaluation failed: {}", msg);
                            engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, msg));
                        },
                        &typedData
                    );
{% elif state.donedata.content %}
                    // W3C SCXML 5.5: Evaluate <content> expression
                    this->ensureScriptEngine();
                    auto& scriptEngine = getScriptEngine();
                    ::SCE::DoneDataHelper::evaluateContent(
                        scriptEngine,
                        sessionId_.value(),
                        "{{ state.donedata.content | escape_cpp }}",
                        eventData,
                        [&engine](const std::string& msg) {
                            SCE_LOG_WARN("Donedata content evaluation failed: {}", msg);
                            engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, msg));
                        },
                        &typedData
                    );
{% endif %}

                    AOT_DEBUG("Final state {{ state_id }} reached with event data: {}", eventData);
{% endif %}
{% if state.is_final and state.parent %}
                // W3C SCXML 3.7: Generate done.state.{parentId} event for compound state completion
                {
                    AOT_DEBUG("Final state {{ state_id }} entered, generating done.state.{{ state.parent }}");
{% if state.donedata %}
                    auto doneMeta = typename Engine::EventWithMetadata(Event::Done_state_{{ state.parent }}, eventData);
                    doneMeta.typedData = std::move(typedData);
                    engine.raise(std::move(doneMeta));
{% else %}
                    engine.raise(typename Engine::EventWithMetadata(Event::Done_state_{{ state.parent }}));
{% endif %}
                }
{% if state.donedata %}
                }
{% endif %}
{% if model.states[state.parent].parent and model.states[model.states[state.parent].parent].is_parallel %}
                // W3C SCXML 3.4: Check if parent's parent (parallel state) is complete
                // W3C SCXML 3.7.1: Generate done.state event when all regions reach final states
                // Uses ParallelCompletionHelper (Zero Duplication - shared with Interpreter)
                {
                    const auto parallelState = State::{{ model.states[state.parent].parent | capitalize }};
                    AOT_DEBUG("Checking parallel state {} completion after region {} final",
                             static_cast<int>(parallelState), "{{ state.parent }}");

                    // W3C SCXML 3.4: Use shared Helper (ARCHITECTURE.md Zero Duplication Principle)
                    if (::SCE::Core::ParallelCompletionHelper::areAllRegionsInFinal<State, {{ model.name }}Policy>(
                            parallelState, activeStates_)) {
                        AOT_DEBUG("All regions of parallel state {} are complete, generating done.state event",
                                 static_cast<int>(parallelState));
                        engine.raise(typename Engine::EventWithMetadata(Event::Done_state_{{ model.states[state.parent].parent }}));
                    }
                }
{% endif %}
{% endif %}
                }
{% endif %}
                break;
{% endfor %}
            default:
                break;
        }
{% endif %}{# model.has_entry_actions #}
{% if model.has_parallel_states %}

        // W3C SCXML 3.4: If entering parallel state, enter all child regions and their initial children
        // This ensures parallel states behave like Interpreter (auto-enter all regions)
        if (isParallelState(state)) {
            AOT_DEBUG("AOT executeEntryActions: State {} is parallel, entering child regions", static_cast<int>(state));
            auto regions = getParallelRegions(state);
            for (const auto& region : regions) {
                AOT_DEBUG("AOT executeEntryActions: Entering parallel region {}", static_cast<int>(region));
                executeEntryActions(region, engine);

                // W3C SCXML 3.3: If region is compound, enter initial child
                if (isCompoundState(region)) {
                    State initialChild = getInitialChild(region);
                    if (initialChild != region) {
                        AOT_DEBUG("AOT executeEntryActions: Entering initial child {} of region {}",
                                 static_cast<int>(initialChild), static_cast<int>(region));
                        executeEntryActions(initialChild, engine);
                    }
                }
            }
        }

        // W3C SCXML 3.3: If entering compound state (non-parallel), enter initial child
        // W3C SCXML 3.6: Support deep initial targets (space-separated descendant state IDs)
        if (isCompoundState(state) && !isParallelState(state)) {
            // W3C SCXML 3.6: Check if state has multiple or deep initial targets
            switch (state) {
                {% for state_id, state in model.states.items() %}
                {% if state.initial_children and state.initial_children|length > 0 %}
                case State::{{ state_id | capitalize }}:
                    AOT_DEBUG("AOT executeEntryActions: State {} has initial children, delegating to StateEntryHelper",
                             static_cast<int>(state));
                    enterDeepInitialTargets_{{ state_id | capitalize }}(engine);
                    break;
                {% endif %}
                {% endfor %}
                default:
                    // No explicit initial children - use single initial child
                    State initialChild = getInitialChild(state);
                    if (initialChild != state) {
                        AOT_DEBUG("AOT executeEntryActions: State {} is compound, entering initial child {}",
                                 static_cast<int>(state), static_cast<int>(initialChild));
                        executeEntryActions(initialChild, engine);
                    }
                    break;
            }
        }
{% endif %}
    }

    template<typename Engine>
{% if not model.needs_script_engine and not model.static_invokes and not model.has_parent_communication and not model.needs_event_scheduler and not model.has_parallel_states and not model.context_objects %}    [[gnu::hot]] static void executeExitActions([[maybe_unused]] State state, [[maybe_unused]] Engine& engine, [[maybe_unused]] const std::vector<State>& activeStatesBeforeTransition) {
{% else %}    [[gnu::hot]] void executeExitActions([[maybe_unused]] State state, [[maybe_unused]] Engine& engine, [[maybe_unused]] const std::vector<State>& activeStatesBeforeTransition) {
{% endif %}

{% if model.has_parallel_states %}
        // W3C SCXML 3.4 + 3.13: Parallel state exit order
        // Matches Interpreter's exitParallelStateAndDescendants() logic
        AOT_DEBUG("AOT executeExitActions: Checking if state {} is parallel", static_cast<int>(state));
        if (isParallelState(state)) {
            AOT_DEBUG("AOT executeExitActions: State {} IS parallel, collecting active descendants", static_cast<int>(state));

            // W3C SCXML 3.4: Collect all active descendants of this parallel state
            // Matches Interpreter's collectDescendantStates() - exit ALL active descendants, not just direct regions
            ::std::vector<State> descendantsToExit;
            for (State activeState : activeStates_) {
                if (activeState != state && isDescendantOf(activeState, state)) {
                    descendantsToExit.push_back(activeState);
                    AOT_DEBUG("AOT executeExitActions: Found active descendant {} of parallel state {}",
                             static_cast<int>(activeState), static_cast<int>(state));
                }
            }

            AOT_DEBUG("AOT executeExitActions: Found {} active descendants to exit", descendantsToExit.size());

            // W3C SCXML 3.13: Sort descendants by reverse document order (deepest states exit first)
            ::std::sort(descendantsToExit.begin(), descendantsToExit.end(),
                       [](State a, State b) {
                           return getDocumentOrder(a) > getDocumentOrder(b);
                       });

            // Exit each active descendant (deepest first)
            for (State descendant : descendantsToExit) {
                AOT_DEBUG("AOT executeExitActions: Exiting active descendant {}", static_cast<int>(descendant));
                executeExitActions(descendant, engine, activeStatesBeforeTransition);
            }

            AOT_DEBUG("AOT executeExitActions: All active descendants exited, now exiting parallel state {} itself", static_cast<int>(state));
            // After exiting all descendants, fall through to exit parallel state itself
        } else {
            AOT_DEBUG("AOT executeExitActions: State {} is NOT parallel, proceeding to switch", static_cast<int>(state));
        }
{% endif %}
{% if model.has_parallel_states or model.uses_in_predicate %}
        // W3C SCXML 3.4/3.12.1: Remove state from active configuration (parallel states and In() predicate)
        AOT_DEBUG("AOT executeExitActions: Removing state {} from activeStates", static_cast<int>(state));
        {
            ::std::lock_guard<::std::mutex> lock(activeStatesMutex_);
            activeStates_.erase(
                std::remove(activeStates_.begin(), activeStates_.end(), state),
                activeStates_.end()
            );
        }
{% endif %}
        {% if model.history_states %}
        // W3C SCXML 3.11: Record history before exiting compound states (matches Interpreter logic)
        // Use pre-transition active states (captured before processTransition modified currentState_)
        const std::vector<State>& activeStates = activeStatesBeforeTransition;
        
        {% for history_id, history_info in model.history_states.items() %}
        if (state == State::{{ history_info.parent | capitalize }}) {
            // W3C SCXML 3.11: Filter states using HistoryHelper (shared with Interpreter)
            auto filteredStates = ::SCE::Core::HistoryHelper::recordHistory(
                activeStates,
                State::{{ history_info.parent | capitalize }},
                HistoryType::{{ history_info.type.upper() }},
                [](State s) { return {{ model.name }}Policy::getParent(s); }
            );
            
            // W3C SCXML 3.11: Record even if empty (valid scenario - state was active with no children)
            history_{{ history_id }} = filteredStates;
            AOT_DEBUG("Recorded {{ history_info.type }} history for {{ history_id }}: {} states", filteredStates.size());
        }
        {% endfor %}
        {% endif %}
{% if model.has_exit_actions %}
        switch (state) {
{% for state_id, state in model.states.items() %}
{% if state.on_exit_blocks or state.static_invokes or state.hybrid_invokes %}
            case State::{{ state_id | capitalize }}:
                AOT_DEBUG("AOT executeExitActions: Processing exit actions for state {} ({{ state_id }})", static_cast<int>(state));
{% if state.on_exit_blocks or state.static_invokes or state.hybrid_invokes %}
                {
{% if state.static_invokes or state.hybrid_invokes %}
                // W3C SCXML 6.4: Cancel pending invokes for exited state (ARCHITECTURE.md Zero Duplication)
                ::SCE::Core::InvokeHelper::cancelInvokesForState(pendingInvokes_, state);
                {% for invoke_info in state.static_invokes %}
                if (child_{{ invoke_info.invoke_id }}_) {
{% if 'cancel.invoke' in model.events %}
                    if (!pendingDoneInvoke_{{ invoke_info.invoke_id }}_) {
                        engine.raise(typename Engine::EventWithMetadata(Event::Cancel_invoke));
                    }
{% endif %}
                    child_{{ invoke_info.invoke_id }}_.reset();
                }
                activeInvokes_.erase("{{ invoke_info.invoke_id }}");
{% endfor %}
                {% for invoke_info in state.hybrid_invokes %}
                if (child_{{ invoke_info.invoke_id }}_) {
{% if 'cancel.invoke' in model.events %}
                    if (!pendingDoneInvoke_{{ invoke_info.invoke_id }}_) {
                        engine.raise(typename Engine::EventWithMetadata(Event::Cancel_invoke));
                    }
{% endif %}
                    child_{{ invoke_info.invoke_id }}_.reset();
                }
                activeInvokes_.erase("{{ invoke_info.invoke_id }}");
{% endfor %}
{% endif %}
{% if state.on_exit_blocks %}
{% set single_cpp_exit_action = (state.on_exit_blocks|length == 1 and state.on_exit_blocks[0]|length == 1 and state.on_exit_blocks[0][0].type == 'script' and state.on_exit_blocks[0][0].is_cpp_function) %}
{% if single_cpp_exit_action %}
                // W3C SCXML 3.9.6: Single <cpp> action - direct call (true Zero Overhead)
                // Optimization: No std::vector, std::function, or EntryExitHelper overhead
                {{ state.on_exit_blocks[0][0].content_transformed | trim }};
{% else %}
                {
                    // W3C SCXML 3.9: Build onexit block lambdas for EntryExitHelper
                    // ARCHITECTURE.md Zero Duplication: Delegate to shared Helper (lines 311-373)
                    std::vector<std::function<void()>> exitBlocks;
{% for block in state.on_exit_blocks %}
                    exitBlocks.push_back([{% if model.needs_nonstatic_method %}this, {% endif %}&engine]() {
                        // Onexit block {{ loop.index }}/{{ state.on_exit_blocks|length }}
{% for action in block %}
                        {% set in_entry_exit = true %}
                        {% include 'actions/' + action.type + '.jinja2' %}

{% endfor %}
                    });
{% endfor %}
                    // W3C SCXML 3.9: Delegate to EntryExitHelper (Single Source of Truth)
                    // This achieves ARCHITECTURE.md Zero Duplication between Interpreter and AOT engines
                    ::SCE::Core::EntryExitHelper<{{ model.name }}Policy, Engine>::executeExitBlocks(
                        exitBlocks, engine, "{{ state_id }}"
                    );
                }
{% endif %}
{% endif %}
                }
{% endif %}
                break;
{% endif %}{# state has exit actions #}
{% endfor %}
            default:
                break;
        }
{% endif %}{# model.has_exit_actions #}
    }
