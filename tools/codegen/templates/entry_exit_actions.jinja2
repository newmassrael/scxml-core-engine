                        // entry so finalize / autoforward / cancel match the
                        // child's events via the same sessionId the local
                        // path uses. `sessionId` is filled by onInvokeStarted
                        // when wire-15 arrives (§9.6.3 L1463).
                        activeInvokes_["{{ invoke_info.invoke_id }}"] = ChildSession{
                            "",  // filled on wire-15 InvokeStarted
                            "{{ invoke_info.invoke_id }}",
                            sessionId_.has_value() ? sessionId_.value() : "",
                            {{ 'true' if invoke_info.autoforward else 'false' }},
                            "{{ invoke_info.finalize_content | replace('"', '\"') }}"
                        };
                        pendingDoneInvoke_{{ invoke_info.invoke_id }}_ = false;
