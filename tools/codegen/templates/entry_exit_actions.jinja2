                                ::SCE::ScriptResultUtils::resultToString(_srcexpr_result_{{ invoke_info.invoke_id }});
                            static const std::regex _srcexpr_shape_{{ invoke_info.invoke_id }}(
                                R"(^#[A-Za-z_][A-Za-z0-9_]*$)");
                            if (!std::regex_match(_resolved_src_{{ invoke_info.invoke_id }},
                                                   _srcexpr_shape_{{ invoke_info.invoke_id }})) {
                                engine.raise(typename Engine::EventWithMetadata(
                                    Event::Error_execution,
                                    "mesh-rpc invoke '{{ invoke_info.invoke_id }}' srcexpr produced invalid shape (must match '#<machine_name>'): " + _resolved_src_{{ invoke_info.invoke_id }}));
                                this->_mesh_resolved_src_{{ invoke_info.field_suffix }}_.clear();
                            } else {
                                this->_mesh_resolved_src_{{ invoke_info.field_suffix }}_ =
