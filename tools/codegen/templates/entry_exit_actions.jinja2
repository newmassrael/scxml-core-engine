                        } else {
                            SCE_LOG_ERROR("mesh-rpc invoke {{ invoke_info.invoke_id }} param '{{ param.name }}' expr evaluation failed: {{ param.expr }}");
                            _mesh_params_{{ invoke_info.invoke_id }}["{{ param.name }}"].push_back("");
                        }
                    }
{% endif %}
{% endfor %}
                    std::string _mesh_data_{{ invoke_info.invoke_id }} = ::SCE::EventDataHelper::buildEventDataJson(
                        _mesh_params_{{ invoke_info.invoke_id }},
                        _mesh_typed_params_{{ invoke_info.invoke_id }});
{% else %}
                    std::string _mesh_data_{{ invoke_info.invoke_id }};  // no params → empty payload
{% endif %}

