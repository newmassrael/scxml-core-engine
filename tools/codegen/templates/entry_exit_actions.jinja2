                        if (!::SCE::ScriptResultUtils::isSuccess(_srcexpr_result_{{ invoke_info.invoke_id }})) {
                            engine.raise(typename Engine::EventWithMetadata(
                                Event::Error_execution,
                                "mesh-rpc invoke '{{ invoke_info.invoke_id }}' srcexpr evaluation failed: {{ invoke_info.srcexpr }}"));
                            this->_mesh_resolved_src_{{ invoke_info.field_suffix }}_.clear();
                        } else {
