{% for history_id, history_info in model.history_states | dictsort %}
    // W3C SCXML 3.11: Resolve history target for {{ history_id }}
    fn resolve_history_target_{{ history_id }}(&self) -> {{ machine_name }}State {
        if let Some(ref recorded) = self.history_{{ history_id }} {
            if let Some(&first) = recorded.first() {
                return first;
            }
        }
        // No history recorded - use default transition target
        {{ machine_name }}State::{{ history_info.leaf_target | to_state_variant }}
    }
