// ======================================================================
// SCE Protocol-Synthesis RFC §synth-5-E sample-callback codegen wire-up
// ======================================================================
//
// Per-link Sample delivery surface. The host's link RX task (e.g. a
// Tokio task draining a Zenoh subscriber, an `arm_rx`-style poll
// loop, or the QNX `dispatch_create()` reactor) calls
// `engine.deliver_link_<X>_sample(sample)` for every Sample arriving
// on the named link. The generated method:
//
//   1. Iterates active states whose `<sce:on-sample link="X">` block
//      matches the link.
//   2. For each match: invokes the user-supplied `callback="rust:..."`
//      synchronously with `&sample` (when present), then raises the
//      `event="..."` external event so SCXML transitions react.
//   3. Drops the Sample at method exit, returning the slot to the pool
//      via the embedded `SlotGuard`.
//
// Generic over `M: SampleMeta` so the codegen does not need to learn
// the link's concrete metadata type. The
// user's call site instantiates `M` from their link driver's
// `Sample<'pool, MyMeta>` value; rustc enforces the user-callback
// signature against the borrow contract (spec lines 1513-1519).
//
// The trait declares one delivery method per link; the impl below
// carries the full pipeline: active-config filter, callback
// dispatch, then event raise.
pub trait {{ machine_name }}LinkRx {
{% for link in model.on_sample_links %}
    /// Deliver a Sample arriving on link `{{ link }}`.
    fn deliver_link_{{ link | to_snake_case }}_sample<M>(
        &mut self,
        sample: ::sce_link_runtime::Sample<'_, M>,
    )
    where
        M: ::sce_link_runtime::SampleMeta;
{% endfor %}
}

impl{{ policy_generics_decl }} {{ machine_name }}LinkRx for ::sce_rust_runtime::Engine<{{ machine_name }}Policy{{ policy_generics_use }}> {
{% for link in model.on_sample_links %}
    fn deliver_link_{{ link | to_snake_case }}_sample<M>(
        &mut self,
        sample: ::sce_link_runtime::Sample<'_, M>,
    )
    where
        M: ::sce_link_runtime::SampleMeta,
    {
        // Active-state filter: iterate the engine's current
        // configuration; for every active state that declares
        // `<sce:on-sample link="{{ link }}">`, dispatch into its
        // per-state arm (callback dispatch + event raise). Sample
        // drops at method exit, returning the slot to its pool via
        // the embedded `SlotGuard`.
        let _ = &sample;
        for active in self.get_active_states() {
            match active {
{% for state_id, state in model.states | dictsort %}
{% for block in state.on_sample_blocks %}
{% if block.link == link %}
                {{ machine_name }}State::{{ state_id | to_state_variant }} => {
{% if block.callback and (block.callback | callback_lang) == "rust" %}
                    // Callback dispatch — synchronous extern
                    // call. rustc enforces the user's callback
                    // signature against the borrow contract
                    // (spec lines 1513-1519). A `c:` path names a
                    // flat C identifier with no Rust lowering and is
                    // skipped here, mirroring the C11 backend
                    // skipping a `rust:` one.
                    {{ block.callback | extern_callback_path }}(&sample);
{% endif %}
                    // Event raise: when a callback was present it
                    // fired synchronously above; this raise still
                    // happens so SCXML transitions react to the
                    // sample arrival.
                    // event_data is the empty string
                    // (typed payload flows through the callback
                    // path; the event path is purely for state-
                    // machine reaction).
                    self.raise_external_by_name("{{ block.event | escape_rust }}", "");
                }
{% endif %}
{% endfor %}
{% endfor %}
                _ => {}
            }
        }
    }
{% endfor %}
}
