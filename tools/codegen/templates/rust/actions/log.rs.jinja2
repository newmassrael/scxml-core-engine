{# W3C SCXML 3.8.8: <log> - Logging action #}
{% if action.expr and not model.needs_script_engine %}
// W3C SCXML 3.8.8: <log>
log::info!("{% if action.label %}{{ action.label | escape_rust }}: {% endif %}{}", {{ action.expr | to_rust_string_expr }});
{% elif action.label %}
// W3C SCXML 3.8.8: <log label="{{ action.label | escape_rust }}">
log::info!("{{ action.label | escape_rust }}");
{% else %}
// W3C SCXML 3.8.8: <log> (no label or expr)
{% endif %}
