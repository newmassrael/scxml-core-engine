{# W3C SCXML 5.6: <foreach> - Iterate over array
   1:1 with C++ ForeachHelper::executeForeachWithActions:
   - Returns false on error; stops iteration immediately (W3C 4.6)
   - "If evaluation of any child element causes an error, processor MUST cease execution"
#}
{
    // W3C SCXML 5.6: <foreach array="{{ action.array | default("") }}" item="{{ action.item | default("") }}">
    self.ensure_script_engine();
    let sid = self.session_id.as_ref().unwrap().clone();
    let se = self.script_engine.clone();
    let se: &dyn sce_rust_runtime::IScriptEngine = &*se;

    // Validate item attribute (1:1 with C++ ForeachHelper::isLegalVariableName).
    // The empty-`item` case is decided at codegen time and never reaches the
    // runtime guard; the guard only checks legality of a non-empty name to
    // mirror the C++ helper for fixtures that supply a syntactically invalid
    // identifier.
{% if not action.item %}
    ::sce_rust_runtime::sce_log_error!("Foreach validation failed: missing 'item' attribute");
{# The message below names the construct, not the engine's text: it has to be a
   literal that survives no_std. Same reasoning at every platform_error site. #}
{% if 'error.execution' in model.events %}
    engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<foreach> has no 'item' attribute"));
{% endif %}
{% else %}
    {# W3C SCXML 4.6: `item` is a location expression, so it is lowered by
       the same frontend every other write target goes through. A legal
       identifier lowers to itself; anything else fails the guard below. #}
    let item_name = "{{ action.item | to_lua_location | escape_rust }}";
    if !sce_rust_runtime::helpers::foreach::is_legal_variable_name(item_name) {
        ::sce_rust_runtime::sce_log_error!("Foreach validation failed: '{}' is not a legal variable name", item_name);
{% if 'error.execution' in model.events %}
        engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<foreach item='{{ action.item }}'> is not a legal variable name"));
{% endif %}
    } else {
        // Evaluate array expression
        match se.evaluate_expression(&sid, "{{ action.array | default("") | to_lua_expr | escape_rust }}") {
            Ok(sce_rust_runtime::ScriptValue::Array(arr)) => {
                // W3C SCXML 4.6: Execute foreach loop with error handling
                let mut foreach_success = true;
                for (_idx, item_val) in arr.into_iter().enumerate() {
                    // Set item variable
                    if let Err(e) = se.set_variable(&sid, item_name, item_val) {
                        ::sce_rust_runtime::sce_log_error!("Foreach: failed to set item '{}': {}", item_name, e);
                        foreach_success = false;
                        break;
                    }
{% if action.index %}
                    // Set index variable
                    if let Err(e) = se.set_variable(&sid, "{{ action.index | to_lua_location | escape_rust }}", sce_rust_runtime::ScriptValue::Int(_idx as i64)) {
                        ::sce_rust_runtime::sce_log_error!("Foreach: failed to set index '{{ action.index }}': {}", e);
                        foreach_success = false;
                        break;
                    }
{% endif %}
{% if action.actions and action.actions | length > 0 %}
                    // W3C SCXML 4.6: Execute body actions — stop on first error.
                    // Each body action runs inside a labeled block `'foreach_body`. Action
                    // templates that raise error.execution also `break 'foreach_body` so
                    // subsequent body actions for this iteration are skipped, then the
                    // outer loop is aborted (matches W3C spec and C++ ForeachHelper).
                    let mut iteration_success = true;
                    'foreach_body: {
{% for body_action in action.actions %}
                        {% with action=body_action, in_foreach=true %}
                        {% include 'actions/' ~ body_action.type ~ '.rs.jinja2' %}
                        {% endwith %}
{% endfor %}
                    }
                    if !iteration_success {
                        ::sce_rust_runtime::sce_log_debug!("Foreach: body action failed at iteration {}, stopping loop (W3C SCXML 4.6)", _idx);
                        foreach_success = false;
                        break;
                    }
{% endif %}
                }
                if !foreach_success {
{% if 'error.execution' in model.events %}
                    engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "an action inside <foreach> failed"));
{% endif %}
                }
            }
            Ok(_) => {
                // Not an array — raise error.execution (W3C SCXML 5.6)
                ::sce_rust_runtime::sce_log_error!("Foreach: '{{ action.array | default("") }}' is not an array");
{% if 'error.execution' in model.events %}
                engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<foreach array='{{ action.array | default("") }}'> is not an array"));
{% endif %}
            }
            Err(e) => {
                ::sce_rust_runtime::sce_log_error!("Foreach: failed to evaluate array '{{ action.array | default("") }}': {}", e);
{% if 'error.execution' in model.events %}
                engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<foreach array='{{ action.array | default("") }}'> failed to evaluate"));
{% endif %}
            }
        }
    }
{% endif %}
}
