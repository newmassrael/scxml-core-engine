{# W3C SCXML 5.9.2: <if>/<elseif>/<else> - Conditional execution.
   A condition lowered to Rust at generate time (`native_cond`, a sce-static
   document's) comes first, as a transition's `native_guard` does. #}
{# W3C SCXML 5.9.1 + 4.9: the script-engine arm and a native cond that can fail
   (`native_cond_fails`) can fail. A cond that cannot be evaluated is false, so
   the selection goes on to the next partition; `if_cond_failed` remembers it
   — a native cond sets it itself — and once the chain has run the <if> ends
   its block as any element that raised does. Outside an action block there
   is no block to end: the script-engine arm uses the plain guard, and a
   native cond, which has already set the flag, has nothing to end. #}
{% set if_script_can_fail = model.needs_script_engine and in_action_block is defined and in_action_block and ((not action.native_cond and not action.is_pure_in_predicate) or (action.elseif_branches | rejectattr("native_cond") | rejectattr("is_pure_in_predicate") | list | length > 0)) %}
{% set if_native_can_fail = action.native_cond_fails or (action.elseif_branches | selectattr("native_cond_fails") | list | length > 0) %}
{% set if_can_fail = if_script_can_fail or if_native_can_fail %}
{# Each branch is a list of its own (`block_flow`, rust/entry_exit_actions.rs.jinja2).
   When the <if> has an <else> and every branch ends the block unconditionally,
   whichever branch the selection reaches ends it — a cond that failed only
   moves the selection on — so the chain is itself the end of the block:
   rustc reads an `if`/`else` whose branches all `break` as diverging, and the
   flag check that would follow it, and every element after the <if>, is
   unreachable. `if_flow.ends` records it. A native cond that can fail writes
   the flag, and Rust reports a write nobody reads, so with no check after
   the chain the <else> reads it first: every cond the selection passed
   reaches the <else>. The <else> is rendered before its head is written so
   that the head knows. #}
{% set if_flow = namespace(ends=true) %}
{% if not action.else_actions %}
{% set if_flow.ends = false %}
{% endif %}
{% if if_can_fail %}
{
let mut if_cond_failed = false;
{% endif %}
{% if action.native_cond %}
// W3C SCXML 5.9: cond="{{ action.cond }}"
if {{ action.native_cond }} {
{% elif action.is_pure_in_predicate %}
// W3C SCXML 5.9.2: In() predicate condition
if {{ action.cond_cpp | replace('this->', '') | replace('isStateActive', 'self.is_state_active') }} {
{% elif model.needs_script_engine %}
// W3C SCXML 5.9: Script engine guard ({{ action.cond }})
if {% if if_script_can_fail %}self.evaluate_if_cond("{{ action.cond | to_lua_guard | escape_rust }}", engine, &mut if_cond_failed){% else %}self.safe_evaluate_guard("{{ action.cond | to_lua_guard | escape_rust }}", engine){% endif %} {
{% else %}
// W3C SCXML 4.3: cond="{{ action.cond }}" decided at build time
if {{ 'true' if action.cond_constant else 'false' }} {
{% endif %}
{% with block_flow = namespace(ended=false) %}
{% for then_action in action.then_actions %}
{% if not block_flow.ended %}
    {% with action=then_action %}
    {% include 'actions/' ~ then_action.type ~ '.rs.jinja2' %}
    {% endwith %}
{% endif %}
{% endfor %}
{% if not block_flow.ended %}
{% set if_flow.ends = false %}
{% endif %}
{% endwith %}
{% for elseif in action.elseif_branches %}
} else if {% if elseif.native_cond %}{{ elseif.native_cond }}{% elif elseif.is_pure_in_predicate %}{{ elseif.cond_cpp | replace('this->', '') | replace('isStateActive', 'self.is_state_active') }}{% elif model.needs_script_engine %}{% if if_script_can_fail %}self.evaluate_if_cond("{{ elseif.cond | to_lua_guard | escape_rust }}", engine, &mut if_cond_failed){% else %}self.safe_evaluate_guard("{{ elseif.cond | to_lua_guard | escape_rust }}", engine){% endif %}{% else %}{{ 'true' if elseif.cond_constant else 'false' }}{% endif %} {
{% with block_flow = namespace(ended=false) %}
{% for elseif_action in elseif.actions %}
{% if not block_flow.ended %}
    {% with action=elseif_action %}
    {% include 'actions/' ~ elseif_action.type ~ '.rs.jinja2' %}
    {% endwith %}
{% endif %}
{% endfor %}
{% if not block_flow.ended %}
{% set if_flow.ends = false %}
{% endif %}
{% endwith %}
{% endfor %}
{% if action.else_actions %}
{% with block_flow = namespace(ended=false) %}
{% set else_body %}
{% for else_action in action.else_actions %}
{% if not block_flow.ended %}
    {% with action=else_action %}
    {% include 'actions/' ~ else_action.type ~ '.rs.jinja2' %}
    {% endwith %}
{% endif %}
{% endfor %}
{% endset %}
{% if not block_flow.ended %}
{% set if_flow.ends = false %}
{% endif %}
} else {
{% if if_flow.ends and if_native_can_fail %}
let _ = if_cond_failed;  // every branch ends the block, so no check follows the chain
{% endif %}
{{ else_body }}{% endwith %}
{% endif %}
}
{% if if_can_fail %}
{% if if_flow.ends %}
{# The chain is the end of the block: nothing follows it. #}
{% elif in_action_block is defined and in_action_block %}
if if_cond_failed {
    break 'action_block;
}
{% else %}
let _ = if_cond_failed;
{% endif %}
}
{% endif %}
{% if if_flow.ends %}
{% set block_flow.ended = true %}
{% endif %}
