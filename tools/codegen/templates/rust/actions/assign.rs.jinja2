{# W3C SCXML 5.3/5.4: <assign> - Variable assignment #}
{% if not model.needs_script_engine %}
{% if action.location and action.expr %}
// W3C SCXML 5.3: <assign location="{{ action.location }}" expr="{{ action.expr | escape_rust }}">
self.{{ action.location | to_snake_case }} = {{ action.expr | to_rust_string_expr }};
{% elif action.location and action.content %}
// W3C SCXML 5.3: <assign location="{{ action.location }}"> (inline content)
self.{{ action.location | to_snake_case }} = {{ action.content | to_rust_string_expr }};
{% endif %}
{% else %}
{
    // W3C SCXML 5.3: <assign location="{{ action.location | default("") }}">
    self.ensure_script_engine();
    let sid = self.session_id.as_ref().unwrap().clone();
    let se = sce_rust_runtime::ScriptEngineProvider::get();
{% set loc = action.location | default("") %}
{# W3C SCXML B.2: System variables are read-only (1:1 with C++ AssignHelper::isValidLocation) #}
{% if not loc or loc in ('_sessionid', '_event', '_name', '_ioprocessors') %}
    // W3C SCXML 5.3/B.2: Invalid or read-only location "{{ loc }}"
    log::error!("W3C SCXML 5.3: Invalid assign location '{{ loc }}'");
{% if 'error.execution' in model.events %}
    engine.raise(sce_rust_runtime::EventWithMetadata::new({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}));
{% endif %}
{% else %}
{% if action.content %}
    let expr = "'{{ action.content | escape_rust }}'";
{% else %}
    let expr = "{{ action.expr | default("") | to_lua_expr | escape_rust }}";
{% endif %}
    // W3C SCXML 5.3: Assign via execute_script preserves Lua reference identity for
    // table values (e.g. `Var2 = _event` — test 329 requires `Var2 == _event`). Going
    // through evaluate_expression + set_variable would round-trip through ScriptValue
    // and create a fresh table, breaking reference equality.
    let assign_script = format!("{} = {}", "{{ loc }}", expr);
    if let Err(e) = se.execute_script(&sid, &assign_script) {
        log::error!("Assign failed for '{{ loc }}': {}", e);
{% if 'error.execution' in model.events %}
        engine.raise(sce_rust_runtime::EventWithMetadata::new({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}));
{% endif %}
{% if in_foreach is defined and in_foreach %}
        // W3C SCXML 4.6: Stop current foreach iteration and loop on error
        iteration_success = false;
        break 'foreach_body;
{% elif in_entry_exit is defined and in_entry_exit %}
        // W3C SCXML 3.8/3.9: Error stops subsequent actions in this onentry/onexit block
        break 'action_block;
{% endif %}
    }
{% endif %}
}
{% endif %}
