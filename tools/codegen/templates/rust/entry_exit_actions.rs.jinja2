{#
    Entry/Exit Actions Template (Rust Jinja2)

    W3C SCXML 3.7/3.8/3.9: Entry and exit action execution.

    Generates:
    - execute_entry_actions(&mut self, state, engine, is_default_entry)
    - execute_exit_actions(&mut self, state, engine, configuration_before_exit)
    - execute_history_default_content(&mut self, history, engine)

    Each answers for ONE state. Which states a microstep enters and exits, and
    in which order, is the engine's Appendix D procedure
    (`sce_rust_runtime::helpers::microstep`): it enters its entry set front to
    back and exits its exit set in exit order, so nothing here enters a region,
    descends to an initial child, or exits a descendant. `is_default_entry` is
    the entry set's statesForDefaultEntry answer — whether this state's initial
    transition content runs.

    Ports from C++ entry_exit_actions.jinja2.
    Uses datamodel_macros.rs.jinja2 for Zero Duplication in late binding init.
#}
{% from 'datamodel_macros.rs.jinja2' import initialize_variable, initialize_state_datamodel %}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}

    // W3C SCXML 3.7: Execute <onentry> actions for a state
    {# SCE Protocol-Synthesis RFC §synth-5-O — function-scope SCE-MAP marker
       above `execute_entry_actions`. `#[doc]` attaches to the function
       item; the `//` comment-form survives stable as a grep target. #}
    {{ sce_map.source_marker(model.source_location, "rust", symbol_artifact=sce_artifact.machine) }}
    fn execute_entry_actions(&mut self, state: Self::State, engine: &mut sce_rust_runtime::Engine<Self>, is_default_entry: bool) {
{% if model.has_parallel_states or model.uses_in_predicate %}
        // W3C SCXML 3.4/3.12.1: Add state to active configuration for parallel states and In() predicate
        if !self.activate(state) {
            return;  // W3C SCXML 3.8: Skip onentry actions for duplicate state entry
        }
{% endif %}
{% if model.has_entry_actions %}
        match state {
{% for state_id, state in model.states | dictsort %}
{% if state.on_entry_blocks or state.initial_transition_actions or (state.is_final and state.parent) or (state.is_final and state.donedata) or (state.datamodel and model.binding == 'late') or state.invokes | scxml or state.invokes | hybrid or state.invokes | unsupported %}
            {{ machine_name }}State::{{ state_id | to_state_variant }} => {  {{- annot.annotation_comment(state, "rust", "                ") }}
{% if state.source_location %}
                {{ sce_map.source_marker(state.source_location, "rust", stmt_level=true, symbol_state=state_id, symbol_artifact=sce_artifact.state_body) | trim }}
{% endif %}
{% if state.datamodel and model.binding == 'late' %}
                // W3C SCXML 5.9: Late binding - initialize datamodel on state entry
                {
                    self.ensure_script_engine();
                    let sid = self.session_id.as_ref().unwrap().clone();
                    let se = self.script_engine.clone();
                    let se: &dyn sce_rust_runtime::IScriptEngine = &*se;
{{ initialize_state_datamodel(state, state_id, true, machine_name, model) }}
                }
{% endif %}
{% for block in state.on_entry_blocks %}
                // W3C SCXML 3.8: onentry block {{ loop.index }}/{{ state.on_entry_blocks | length }}
                // Labeled block allows actions to break out on error (W3C 3.8: error stops block)
                'action_block: {
{% for action in block %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "rust", "                ") -}}
{%- endif %}
                {% with in_entry_exit=true %}{% include 'actions/' ~ action.type ~ '.rs.jinja2' %}{% endwith %}

{% endfor %}
                }
{% endfor %}
{% if state.initial_transition_actions %}
                // W3C SCXML 3.3.2 / §scxml-D-enterStates: the <initial>
                // transition's executable content runs after this state's
                // onentry, and only when its initial state is entered by
                // DEFAULT — not when this state is entered as an ancestor of a
                // deeper target, nor when a <history> restores its children.
                if is_default_entry {
                    'action_block: {
{% for action in state.initial_transition_actions %}
                    {% with in_entry_exit=true %}{% include 'actions/' ~ action.type ~ '.rs.jinja2' %}{% endwith %}

{% endfor %}
                    }
                }
{% endif %}
{% if state.invokes | unsupported_refused %}
                // W3C SCXML 6.4.1: `type` names no processor this platform
                // implements. The whole observable is one error.execution at
                // invoke time, so the entry chain only defers — the raise
                // happens in `do_execute_pending_invokes`. Riding the defer
                // queue keeps §scxml-6.4 ordering (invokes run after the
                // macrostep settles) and lets `cancel_invokes_for_state` drop
                // the entry when the state exits first, which is the correct
                // W3C outcome: an invoke that never ran raises nothing.
{% for invoke_info in state.invokes | unsupported_refused %}
                {
                    let generated_invoke_id = format!("{}.{}.{{ invoke_info.invoke_id }}",
                        "{{ state_id }}", self as *const _ as usize);
                    sce_rust_runtime::invoke::defer_invoke(
                        &mut self.pending_invokes,
                        sce_rust_runtime::invoke::PendingInvoke {
                            invoke_id: generated_invoke_id,
                            state: {{ machine_name }}State::{{ state_id | to_state_variant }},
                        },
                    );
                }
{% endfor %}
{% endif %}
{% if state.invokes | host_invoker %}
                // §scxml-6.4.1: `type` names an invoker the HOST declared to
                // this build. Deferred exactly like the refused arm above and
                // for the same reason — §scxml-6.4 orders invokes after the
                // macrostep settles, and a state that exits first must never
                // have started anything. Only the execute step differs: a
                // dispatch into the host's invoker instead of a raise.
{% for invoke_info in state.invokes | host_invoker %}
                {
                    let generated_invoke_id = format!("{}.{}.{{ invoke_info.invoke_id }}",
                        "{{ state_id }}", self as *const _ as usize);
                    sce_rust_runtime::invoke::defer_invoke(
                        &mut self.pending_invokes,
                        sce_rust_runtime::invoke::PendingInvoke {
                            invoke_id: generated_invoke_id,
                            state: {{ machine_name }}State::{{ state_id | to_state_variant }},
                        },
                    );
                }
{% endfor %}
{% endif %}
{% if state.invokes | scxml or state.invokes | hybrid %}
                // W3C SCXML 6.4: Defer invoke execution until macrostep end
{% for invoke_info in state.invokes | scxml %}
                {  {{- annot.annotation_comment(invoke_info, "rust", "                    ") }}
                    let generated_invoke_id = format!("{}.{}.{{ invoke_info.invoke_id }}",
                        "{{ state_id }}", self as *const _ as usize);
{% if invoke_info.idlocation %}
                    // W3C SCXML 6.4.1: Store generated invokeId in datamodel via idlocation
                    // W3C SCXML: Full runtime ID stored (test 224 checks format)
                    self.ensure_script_engine();
                    {
                        let sid = self.session_id.as_ref().unwrap().clone();
                        let se = self.script_engine.clone();
                        let se: &dyn sce_rust_runtime::IScriptEngine = &*se;
                        let _ = se.set_variable(&sid, "{{ invoke_info.idlocation }}",
                            sce_rust_runtime::ScriptValue::String(generated_invoke_id.clone()));
                    }
{% endif %}
                    sce_rust_runtime::invoke::defer_invoke(
                        &mut self.pending_invokes,
                        sce_rust_runtime::invoke::PendingInvoke {
                            invoke_id: generated_invoke_id,
                            state: {{ machine_name }}State::{{ state_id | to_state_variant }},
                        },
                    );
                }
{% endfor %}
{% for invoke_info in state.invokes | hybrid %}
                // W3C SCXML 6.4: Defer hybrid invoke '{{ invoke_info.invoke_id }}' (srcexpr/contentexpr evaluated at macrostep end)
                {  {{- annot.annotation_comment(invoke_info, "rust", "                    ") }}
                    let generated_invoke_id = format!("{}.{}.{{ invoke_info.invoke_id }}",
                        "{{ state_id }}", self as *const _ as usize);
{% if invoke_info.idlocation %}
                    self.ensure_script_engine();
                    {
                        let sid = self.session_id.as_ref().unwrap().clone();
                        let se = self.script_engine.clone();
                        let se: &dyn sce_rust_runtime::IScriptEngine = &*se;
                        let _ = se.set_variable(&sid, "{{ invoke_info.idlocation }}",
                            sce_rust_runtime::ScriptValue::String(generated_invoke_id.clone()));
                    }
{% endif %}
                    sce_rust_runtime::invoke::defer_invoke(
                        &mut self.pending_invokes,
                        sce_rust_runtime::invoke::PendingInvoke {
                            invoke_id: generated_invoke_id,
                            state: {{ machine_name }}State::{{ state_id | to_state_variant }},
                        },
                    );
                }
{% endfor %}
{% endif %}
{% if state.is_final and state.donedata %}
                // W3C SCXML 5.5: Evaluate donedata for final state
                let mut done_event_data = String::new();
                let mut done_data_ok = true;
{% if state.donedata.params %}
                {
                    self.ensure_script_engine();
                    let sid = self.session_id.as_ref().unwrap().clone();
                    let se = self.script_engine.clone();
                    let se: &dyn sce_rust_runtime::IScriptEngine = &*se;
                    let mut json_parts: Vec<String> = Vec::new();
{% for param in state.donedata.params %}
{% set param_expr = param.expr if param.expr else param.location %}
{% if not param_expr %}
                    // W3C SCXML 5.7: Empty location raises error.execution (structural error)
                    ::sce_rust_runtime::sce_log_error!("Donedata param '{{ param.name | escape_rust }}': empty location (structural error)");
{% if 'error.execution' in model.events %}
                    engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<donedata> <param name='{{ param.name | escape_rust }}'> has an empty location"));
{% endif %}
                    done_data_ok = false;
{% else %}
                    match se.evaluate_expression(&sid, "{{ param_expr | to_lua_expr | escape_rust }}") {
                        Ok(val) => {
                            // §scxml-B-2-9: donedata rides an event, so it
                            // leaves the data model and travels as JSON —
                            // the same wire `<send>`'s params take.
                            let mut part = String::from("\"{{ param.name | escape_json_string | escape_rust }}\":");
                            part.push_str(&::sce_rust_runtime::helpers::event_data::script_value_to_json(&val));
                            json_parts.push(part);
                        }
                        Err(e) => {
                            ::sce_rust_runtime::sce_log_error!("Donedata param '{{ param.name | escape_rust }}' eval failed: {}", e);
{% if 'error.execution' in model.events %}
                            engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<donedata> <param name='{{ param.name | escape_rust }}'> failed to evaluate"));
{% endif %}
                        }
                    }
{% endif %}
{% endfor %}
                    if done_data_ok {
                        done_event_data = String::from("{");
                        done_event_data.push_str(&json_parts.join(","));
                        done_event_data.push('}');
                    }
                }
{% elif state.donedata.content.kind == "expression" or state.donedata.content.kind == "inline_text" %}
                {
{% if state.donedata.content.kind == "expression" %}
                    // W3C SCXML 5.5: <content expr="..."/> MUST be evaluated against the datamodel.
{% set donedata_content_lua = state.donedata.content.text | to_lua_expr %}
{% else %}
                    // W3C SCXML B.2: inline text takes the ordered readings —
                    // an expression when it is one, otherwise the string. The
                    // same filter inline `<data>` text goes through decides
                    // which, so the two cannot answer it differently.
{% set donedata_content_lua = state.donedata.content.text | to_lua_data_content %}
{% endif %}
                    self.ensure_script_engine();
                    let sid = self.session_id.as_ref().unwrap().clone();
                    let se = self.script_engine.clone();
                    let se: &dyn sce_rust_runtime::IScriptEngine = &*se;
                    match se.evaluate_expression(&sid, "{{ donedata_content_lua | escape_rust }}") {
                        // §scxml-B-2-9: serialized, not spelled as Lua source
                        // — the reader is the parent's dequeue, which parses.
                        Ok(val) => { done_event_data = ::sce_rust_runtime::helpers::event_data::script_value_to_json(&val); }
                        Err(e) => {
                            ::sce_rust_runtime::sce_log_error!("Donedata content expr eval failed: {}", e);
{% if 'error.execution' in model.events %}
                            engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<donedata> <content expr> failed to evaluate"));
{% endif %}
                        }
                    }
                }
{% elif state.donedata.content.kind == "literal" %}
                {
                    // W3C SCXML 5.5: inline text children are used **as the content
                    // value** — no evaluation, no script engine required.
                    // Delegates to the SSoT helper shared with C++/Go/Kotlin backends.
                    done_event_data = sce_rust_runtime::helpers::done_data::emit_content_literal(
                        "{{ state.donedata.content.text | escape_rust }}",
                    );
                }
{% endif %}
{% endif %}
{% if state.is_final and state.donedata and not state.parent %}
                // W3C SCXML 5.5 + 6.3.1: Top-level <final> — stash donedata so the
                // invoking parent's raise_done_invoke can lift it onto
                // done.invoke.<id>._event.data. Mirrors the C++ AOT
                // stashDonedataAtFinal contract and Kotlin
                // StateMachineEngine.stashDonedataAtFinal.
                if done_data_ok {
                    engine.stash_donedata_at_final(done_event_data);
                }
{% endif %}
{% if state.is_final and state.parent %}
                // W3C SCXML 3.7: Generate done.state.{{ state.parent }} event
{% if 'done.state.' ~ state.parent in model.events %}
{% if state.donedata %}
                // W3C SCXML 5.5: Carry evaluated donedata in done.state event
                if done_data_ok {
                    let mut done_meta = sce_rust_runtime::EventWithMetadata::new({{ machine_name }}Event::{{ ('done.state.' ~ state.parent) | to_event_variant }});
                    done_meta.set_event_data(&done_event_data);
                    engine.raise(done_meta);
                }
{% else %}
                engine.raise(sce_rust_runtime::EventWithMetadata::new({{ machine_name }}Event::{{ ('done.state.' ~ state.parent) | to_event_variant }}));
{% endif %}
{% endif %}
{% if model.has_parallel_states and state.parent in model.states and model.states[state.parent].parent %}
{% set grandparent_id = model.states[state.parent].parent %}
{% if grandparent_id in model.states and model.states[grandparent_id].is_parallel %}
                // W3C SCXML 3.4 / §scxml-D-enterStates: a region of
                // {{ grandparent_id }} has reached a final state, and the
                // <parallel> completes when every one of its child states is in
                // one — Appendix D's isInFinalState, which counts a region that
                // is itself a <parallel> only once all of ITS regions are.
                {
                    let parallel_state = {{ machine_name }}State::{{ grandparent_id | to_state_variant }};
                    if ::sce_rust_runtime::helpers::microstep::is_in_final_state(
                        &::sce_rust_runtime::PolicyDocument(&*self),
                        parallel_state,
                        &self.active_states,
                    ) {
{% if 'done.state.' ~ grandparent_id in model.events %}
                        engine.raise(sce_rust_runtime::EventWithMetadata::new({{ machine_name }}Event::{{ ('done.state.' ~ grandparent_id) | to_event_variant }}));
{% endif %}
                    }
                }
{% endif %}
{% endif %}
{% endif %}
            }
{% endif %}
{% endfor %}
            _ => {}
        }
{% endif %}
    }

    // §scxml-3.10.2: a <history>'s default transition content, run after its
    // parent's onentry (and after the parent's own <initial> content) when the
    // history was taken with nothing recorded. The engine asks for it by the
    // entry set's defaultHistoryContent answer; a history that restored what it
    // recorded runs nothing.
{% set _history_content = namespace(any=false) %}
{% for _history_id, _history_info in model.history_states | dictsort %}
{% if _history_info.default_actions %}
{% set _history_content.any = true %}
{% endif %}
{% endfor %}
{% if _history_content.any %}
    {{ sce_map.source_marker(model.source_location, "rust", symbol_artifact=sce_artifact.machine) }}
    fn execute_history_default_content(&mut self, history: Self::History, engine: &mut sce_rust_runtime::Engine<Self>) {
        match history {
{% for history_id, history_info in model.history_states | dictsort %}
{% if history_info.default_actions %}
            {{ machine_name }}History::{{ history_id | to_state_variant }} => {
{% for action in history_info.default_actions %}
                {% include 'actions/' ~ action.type ~ '.rs.jinja2' %}

{% endfor %}
            }
{% endif %}
{% endfor %}
            _ => {}
        }
    }
{% endif %}

    // W3C SCXML 3.8: Execute <onexit> actions for a state
    {{ sce_map.source_marker(model.source_location, "rust", symbol_artifact=sce_artifact.machine) }}
    fn execute_exit_actions(
        &mut self,
        state: Self::State,
        engine: &mut sce_rust_runtime::Engine<Self>,
        configuration_before_exit: &[Self::State],
    ) {
{% if model.has_parallel_states or model.uses_in_predicate %}
        // W3C SCXML 3.4/3.12.1: Remove state from active configuration
        self.deactivate(state);
{% endif %}
{% if model.history_states %}
        // W3C SCXML 3.10: Record history as this state exits, from the
        // configuration the microstep started from — the engine hands every
        // exit the configuration as it stood before the first one, so every
        // history in one microstep reads the same configuration.
{% for history_id, history_info in model.history_states | dictsort %}
        if state == {{ machine_name }}State::{{ history_info.parent | to_state_variant }} {
            // W3C SCXML 3.11: {{ history_info.type }} history — SCE Protocol-Synthesis
            // RFC §synth-5-J-2: the record is a [`StateChain`] (heapless under
            // no_std), and a subset of the configuration, so it fits the depth bound.
            self.history_{{ history_id }} = Some(::sce_rust_runtime::helpers::microstep::recorded_history(
                &::sce_rust_runtime::PolicyDocument(&*self),
                {{ machine_name }}State::{{ history_info.parent | to_state_variant }},
                {{ 'true' if history_info.type == 'deep' else 'false' }},
                configuration_before_exit,
            ));
        }
{% endfor %}
{% endif %}
{# A host-run invocation ends with the state that started it, so its exit
   chain has to exist. The two kinds above are SCXML child sessions; before
   this a document whose only `<invoke>` was host-served emitted no exit
   `match` at all, and the host was never told to stop. #}
{% set has_invoke_exits = model.invokes | scxml or model.invokes | hybrid or model.invokes | host_invoker %}
{% if has_invoke_exits %}
        // W3C SCXML 6.4: Cancel pending invokes and cleanup active children on state exit
        match state {
{% for state_id, state in model.states | dictsort %}
{% if state.invokes | scxml or state.invokes | hybrid or state.invokes | unsupported %}
            {{ machine_name }}State::{{ state_id | to_state_variant }} => {
                // W3C SCXML 6.4: Cancel pending invokes for exited state.
                // Covers §scxml-6.4.1 entries: an invoke whose state exits
                // before the macrostep ends never runs, so it raises nothing.
                sce_rust_runtime::invoke::cancel_invokes_for_state(
                    &mut self.pending_invokes,
                    {{ machine_name }}State::{{ state_id | to_state_variant }},
                );
{% for invoke_info in state.invokes | host_invoker %}
                // §scxml-6.4: the host's invocation ends with the state that
                // started it. Unconditional here: the engine knows whether
                // this one ever started and stays silent when it did not, so
                // the emitted chain does not need its own bookkeeping.
                engine.cancel_host_invoke(
                    "{{ invoke_info.invoke_type | escape_rust }}",
                    "{{ invoke_info.invoke_id }}",
                );
{% endfor %}
{% for invoke_info in state.invokes | scxml %}
                // W3C SCXML 6.4: Cleanup running static child '{{ invoke_info.invoke_id }}'
                if self.child_{{ invoke_info.field_suffix }}.is_some() {
                    if !self.pending_done_invoke_{{ invoke_info.field_suffix }} {
{% if 'cancel.invoke' in model.events %}
                        engine.raise(sce_rust_runtime::EventWithMetadata::new(
                            {{ machine_name }}Event::{{ 'cancel.invoke' | to_event_variant }}));
{% endif %}
                    }
                    self.child_{{ invoke_info.field_suffix }} = None;
                }
                self.active_invokes.remove("{{ invoke_info.invoke_id }}");
                self.pending_done_invoke_{{ invoke_info.field_suffix }} = false;
{% endfor %}
{% for invoke_info in state.invokes | hybrid %}
                // W3C SCXML 6.4: Cleanup running hybrid child '{{ invoke_info.invoke_id }}'
{% if invoke_info.candidates %}
{# At most one candidate slot holds a child; clearing all of them is the
   same guard the single-slot shape used, once per slot. #}
{% for candidate in invoke_info.candidates %}
                if self.child_{{ invoke_info.field_suffix }}_{{ candidate.stem }}.is_some() {
                    self.child_{{ invoke_info.field_suffix }}_{{ candidate.stem }} = None;
                }
{% endfor %}
{% else %}
                if self.child_{{ invoke_info.field_suffix }}.is_some() {
                    self.child_{{ invoke_info.field_suffix }} = None;
                }
{% endif %}
                self.active_invokes.remove("{{ invoke_info.invoke_id }}");
                self.pending_done_invoke_{{ invoke_info.field_suffix }} = false;
{% endfor %}
            }
{% endif %}
{% endfor %}
            _ => {}
        }
{% endif %}
{% if model.has_exit_actions %}
        match state {
{% for state_id, state in model.states | dictsort %}
{% if state.on_exit_blocks %}
            {{ machine_name }}State::{{ state_id | to_state_variant }} => {  {{- annot.annotation_comment(state, "rust", "                ") }}
{% if state.source_location %}
                {{ sce_map.source_marker(state.source_location, "rust", stmt_level=true, symbol_state=state_id, symbol_artifact=sce_artifact.state_body) | trim }}
{% endif %}
{% for block in state.on_exit_blocks %}
                // W3C SCXML 3.9: onexit block {{ loop.index }}/{{ state.on_exit_blocks | length }}
                // Labeled block allows actions to break out on error (W3C 3.9: error stops block)
                'action_block: {
{% for action in block %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "rust", "                ") -}}
{%- endif %}
                {% with in_entry_exit=true %}{% include 'actions/' ~ action.type ~ '.rs.jinja2' %}{% endwith %}

{% endfor %}
                }
{% endfor %}
            }
{% endif %}
{% endfor %}
            _ => {}
        }
{% endif %}
    }

