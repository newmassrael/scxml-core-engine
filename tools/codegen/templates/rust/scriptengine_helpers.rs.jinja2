{#
    Script Engine Helpers Template (Rust Jinja2)

    W3C SCXML 5.2/5.10: Script engine session lifecycle, system variables,
    datamodel initialization, guard evaluation, event metadata binding.

    docs/adr/0096: the script session is made in one place,
    `do_initialize_data_model`, the first step of every start; what runs after
    the start reads the session that step established.
#}
{% from 'datamodel_macros.rs.jinja2' import initialize_variable, initialize_state_datamodel %}
{% if model.needs_script_engine %}
    // docs/adr/0096: the script session this machine's executable content runs
    // in was established by its start (`do_initialize_data_model`), and a start
    // whose session could not be established was refused before anything
    // could reach here. Reaching here without one is a defect of the generated
    // code, not a condition of the run.
    fn assert_script_session(&self) {
        debug_assert!(
            self.script_engine_initialized,
            "the script session is established by the start, before any executable content runs"
        );
    }

    // W3C SCXML 5.2/5.3 + docs/adr/0096: establish the script session, then
    // initialize the datamodel in it, raising error.execution for a `<data>`
    // or a top-level `<script>` that fails. Called from
    // StatePolicy::initialize_data_model(), the first step of the start and of
    // `enter_at`, before any state is entered.
    //
    // This is the one place a session is made. It is three steps: create it
    // (which loads the shared library into it), then bind the system
    // variables. The session is named by the session's id (W3C SCXML 5.10),
    // which every constructor bound when the policy was built
    // (docs/adr/0045). A step that fails releases what the steps before it
    // made and is the error, so the start is refused with nothing half done.
    fn do_initialize_data_model(&mut self, engine: &mut Engine<Self>) -> Result<(), sce_rust_runtime::ScriptSessionFailure> {
        if self.script_engine_initialized {
            return Ok(());
        }
        let sid = self.session_id.as_ref().unwrap().clone();
        let se = self.script_engine.clone();
        let se: &dyn sce_rust_runtime::IScriptEngine = &*se;
        if let Err(e) = se.create_session(&sid) {
            ::sce_rust_runtime::sce_log_error!("The script session '{}' could not be created: {}", sid, e);
            return Err(sce_rust_runtime::ScriptSessionFailure::of_creation(&e));
        }

        // §scxml-C-1-1 / §scxml-C-2-3: the `_ioprocessors` entries come from the
        // same helper every other backend uses, so a machine reads the same
        // entry names and the same addresses whichever one runs it.
        let io_processors = sce_rust_runtime::helpers::io_processors::build(
            &sid,
            &self.basic_http_access_uri,
        );
        if let Err(e) = se.setup_system_variables(&sid, "{{ model.scxml_name | default('') | w3c_session_name(model.name) | escape_rust }}", &io_processors) {
            ::sce_rust_runtime::sce_log_error!("Failed to setup system variables: {}", e);
            se.destroy_session(&sid);
            return Err(sce_rust_runtime::ScriptSessionFailure::of_system_variables(&e));
        }
        self.script_engine_initialized = true;

        // W3C SCXML 5.3.3: Initialize global datamodel variables (with error events)
{% for var in model.variables %}
{{ initialize_variable(var, 'global', true, machine_name, model) }}
{% endfor %}

{% if model.binding == 'early' %}
{% for state_id, state in model.states | dictsort %}
{% if state.datamodel %}
        // W3C SCXML 5.3: Early binding - Initialize state {{ state_id }} datamodel variables
{{ initialize_state_datamodel(state, state_id, true, machine_name, model) }}
{% endif %}
{% endfor %}
{% endif %}

        // §scxml-6.4.3: the invoke params the parent handed this session, applied
        // after the `<data>` above so that each overrides the default its
        // `<data>` gave, and before the top-level `<script>` below, which runs
        // over the datamodel as initialized (§scxml-D-interpret: the datamodel
        // is initialized, then the global script element is executed). The
        // parent hands them before this session's start
        // (`set_param_value_in_script_engine`) and this session applies them,
        // so the child's session is made by the child.
        for (name, value) in std::mem::take(&mut self.pending_params) {
            let _ = se.set_variable(&sid, &name, value);
        }

{% if model.global_scripts %}
        // W3C SCXML 5.8: Execute global scripts at document load time
{% for script in model.global_scripts %}
        if let Err(e) = se.execute_script(&sid, "{{ script.content | to_lua_script | escape_rust }}") {
            ::sce_rust_runtime::sce_log_error!("Global script execution failed: {}", e);
{% if 'error.execution' in model.events %}
            engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "a top-level <script> failed to execute"));
{% endif %}
        }
{% endfor %}
{% endif %}

{% if model.has_parallel_states or model.uses_in_predicate %}
        // W3C SCXML 5.9.2: Register In() state query callback
        {
            let shared_states = std::sync::Arc::new(std::sync::Mutex::new(Vec::<String>::new()));
            self.in_predicate_states = Some(shared_states.clone());
            // Empty until a hook that can run a script begins, which publishes
            // the engine's configuration (`publish_in_predicate_states`).
            se.set_state_query_callback(
                &sid,
                Some(Box::new(move |state_id: &str| -> bool {
                    if let Ok(states) = shared_states.lock() {
                        states.iter().any(|s| s == state_id)
                    } else {
                        false
                    }
                })),
            );
        }
        self.publish_in_predicate_states(engine);
{% endif %}
        Ok(())
    }

    // W3C SCXML 5.9: Safe guard evaluation with error handling
    fn safe_evaluate_guard(&mut self, cond: &str, engine: &mut Engine<Self>) -> bool {
        self.evaluate_guard_raising(cond, engine, "a <transition> cond failed to evaluate")
            .unwrap_or(false)
    }

    // W3C SCXML 5.9.1 + 4.9: an <if> or <elseif> cond. It is evaluated and
    // reported as a transition guard is, and a failure is also recorded in
    // `cond_failed`: the <if> still selects on `false`, and is then the
    // element whose processing raised, so its block ends after it.
    #[allow(dead_code)]
    fn evaluate_if_cond(&mut self, cond: &str, engine: &mut Engine<Self>, cond_failed: &mut bool) -> bool {
        let result = self.evaluate_guard_raising(cond, engine, "an <if> cond failed to evaluate");
        *cond_failed = *cond_failed || result.is_none();
        result.unwrap_or(false)
    }

    // W3C SCXML 5.9.1: a cond that cannot be evaluated raises error.execution;
    // `None` says so, where a bare `false` could not.
    fn evaluate_guard_raising(&mut self, cond: &str, engine: &mut Engine<Self>, reason: &str) -> Option<bool> {
        self.assert_script_session();
        let sid = self.session_id.as_ref().unwrap().clone();
        let se = self.script_engine.clone();
        let se: &dyn sce_rust_runtime::IScriptEngine = &*se;
        match se.evaluate_expression(&sid, cond) {
            Ok(val) => Some(val.to_bool()),
            Err(e) => {
                ::sce_rust_runtime::sce_log_error!("Guard evaluation failed for '{}': {}", cond, e);
{% if 'error.execution' in model.events %}
                engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, reason));
{% else %}
                let _ = (engine, reason);
{% endif %}
                None
            }
        }
    }

    // W3C SCXML 5.10: Set _event system variable for current event
    //
    // W3C SCXML 5.10.1 + C.1: `_event.origin` and `_event.origintype` are the
    // one pair the processor that delivered the event wrote when it built it
    // (docs/adr/0090) — the sender's published `_ioprocessors` location for a
    // session's send — read here as they are, and both empty for none.
    // Nothing converts at this boundary, so every backend answers the same.
    // Returns which rung of §scxml-B-2-8-1 the payload got, because the
    // binding is the only place that knows. This used to be `let _ = ...`:
    // the ladder decided between a DOM, a value and a space-normalized string,
    // and the decision was dropped one line later. A payload that announced
    // structure and would not parse therefore reached the document as raw
    // characters, every `_event.data.<field>` read empty, and nothing anywhere
    // could say so — see `sce_rust_runtime::PayloadReading`.
    //
    // A session that has not been created yet binds nothing, which is
    // `Absent` rather than a failure: there is no payload in play.
    fn set_current_event_in_script_engine(&self, event_name: &str, event_data: &str,
            event_type: &str, send_id: &str, origin: Option<&sce_rust_runtime::EventOrigin>,
            invoke_id: &str) -> sce_rust_runtime::PayloadReading {
        if let Some(ref sid) = self.session_id {
            let se = self.script_engine.clone();
            let se: &dyn sce_rust_runtime::IScriptEngine = &*se;
            se.set_current_event(sid, sce_rust_runtime::SetCurrentEventArgs {
                event_name,
                event_data,
                event_type,
                send_id,
                origin: origin.map_or("", |origin| origin.address.as_str()),
                origin_type: origin.map_or("", |origin| origin.processor.as_str()),
                invoke_id,
            })
            // An engine that could not bind `_event` at all has a larger
            // problem than an unreadable payload, and reporting `Undecodable`
            // for it would point a host at the wrong thing.
            .unwrap_or(sce_rust_runtime::PayloadReading::Absent)
        } else {
            sce_rust_runtime::PayloadReading::Absent
        }
    }

{% if model.has_parallel_states or model.uses_in_predicate %}
    // W3C SCXML 5.9.2: Check if a state name matches a state variant
    fn state_name_matches(state: {{ machine_name }}State, name: &str) -> bool {
        Self::get_state_name(state) == name
    }
{% endif %}

    // §scxml-6.4.3: hand this (child) session the value the INVOKING session
    // produced for an `<invoke>` `<param>` or namelist location, to seed the
    // `<data>` of that name. The parent calls it before this session's start,
    // and the start applies it once the session is established and its
    // `<data>` initialized (`do_initialize_data_model`): the parent does not
    // make this session's script session on its own stack (docs/adr/0096).
    //
    // The value crosses as a value. This used to take the parent's value
    // rendered as an engine literal and re-evaluate it here, which survived
    // every value a test had tried and lost the ones no Lua grammar can
    // spell: `to_script_literal` renders a non-finite number as `inf`, and
    // `inf` is an undeclared identifier to the engine that reads it back, so
    // an `<invoke>` `<param expr="1/0"/>` arrived as nothing at all. The
    // Interpreter, C++ AOT, C11, Python and Kotlin all pass the value; this
    // is the channel that did not.
    pub fn set_param_value_in_script_engine(&mut self, name: &str, value: sce_rust_runtime::ScriptValue) {
        self.pending_params.push((name.to_string(), value));
    }
{% endif %}
