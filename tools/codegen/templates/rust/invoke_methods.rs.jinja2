{#
    §scxml-6.4.1: under `datamodel="sce-static"`, the values the invoke's
    `<param>`s and `namelist` give the child's variables, into `child_policy`
    before the child initializes. The build lowered each (`Param::native_seed`)
    to a value of the child variable's own type, read from this machine's
    fields now — when the invoke is executed, at the macrostep's end — and the
    child takes them through its `accept_params`.

    A value that cannot be computed costs `error.execution` and that one value
    (§scxml-5.7.1): the child still starts, one value short.

    `seeds` are the arguments the child declares a variable for. `unkept` are
    the ones it declares none for, which a hybrid invoke has because it hands
    every candidate the same arguments: each is evaluated and left out
    (§scxml-6.4.3), and one that cannot be evaluated costs `error.execution`
    all the same, because an argument is the invoke's whatever the child keeps.
#}
{% macro seed_static_child(child_name, seeds, unkept, model, machine_name) %}
{% set ns = namespace(any=false) %}
{% for param in seeds %}
{% if param.native_seed %}
{% set ns.any = true %}
{% endif %}
{% endfor %}
{% if ns.any %}
                // W3C SCXML 6.4.1: hand the child the values this invoke names
                {
                    let mut seed = super::{{ child_name }}_sm::{{ child_name | to_machine_name }}InvokeParams::default();
{% for param in seeds %}
{% if param.native_seed and param.native_fails %}
                    match (|| -> Result<_, sce_forge_runtime::algorithm::AlgorithmError> { Ok({{ param.native_seed }}) })() {
                        Ok(value) => seed.{{ param.name | to_snake_case }} = Some(value),
                        Err(_) => {
                            // W3C SCXML 5.7.1: report the failure and leave the value out.
                            ::sce_rust_runtime::sce_log_error!("invoke param '{{ param.name | escape_rust }}' overflowed or failed");
{% if 'error.execution' in model.events %}
                            engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<invoke> <param name='{{ param.name | escape_rust }}'> expr failed to evaluate"));
{% endif %}
                        }
                    }
{% elif param.native_seed %}
                    seed.{{ param.name | to_snake_case }} = Some({{ param.native_seed }});
{% endif %}
{% endfor %}
                    child_policy.accept_params(seed);
                }
{% endif %}
{% for param in unkept %}
{% if param.native_value and param.native_fails %}
                // W3C SCXML 6.4.3: the child declares no `{{ param.name }}`, so the Processor
                // MUST NOT add it to its data model — but the argument is still
                // the invoke's, evaluated, and a failure of it is reported
                // (§scxml-5.7.1).
                if (|| -> Result<_, sce_forge_runtime::algorithm::AlgorithmError> { Ok({{ param.native_value }}) })().is_err() {
                    ::sce_rust_runtime::sce_log_error!("invoke param '{{ param.name | escape_rust }}' overflowed or failed");
{% if 'error.execution' in model.events %}
                    engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<invoke> <param name='{{ param.name | escape_rust }}'> expr failed to evaluate"));
{% endif %}
                }
{% endif %}
{% endfor %}
