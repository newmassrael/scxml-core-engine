{#
    Invoke Methods Template (Rust Jinja2)

    W3C SCXML 6.4: Invoke lifecycle — execute pending, tick children.
    Included in the inherent impl block (NOT the trait impl).

    Ports from C++ entry_exit_actions.jinja2 executePendingInvokes() and tickChildren().
#}
{% if model.static_invokes %}
    // W3C SCXML 6.4: Execute pending invokes at macrostep end
    // 1:1 port of C++ executePendingInvokes() in entry_exit_actions.jinja2
    fn do_execute_pending_invokes(&mut self, engine: &mut sce_rust_runtime::Engine<Self>) {
        if self.pending_invokes.is_empty() {
            return;
        }

        // W3C SCXML 6.4: Copy-and-clear to prevent iterator invalidation
        let invokes_to_execute: Vec<_> = self.pending_invokes.drain(..).collect();

        for pending in &invokes_to_execute {
{% for state_id, state in model.states.items() | sort %}
{% if state.static_invokes %}
{% for invoke_info in state.static_invokes %}
            if pending.invoke_id.contains(".{{ invoke_info.invoke_id }}") {
                // W3C SCXML 6.5: Generate child session ID for finalize origin matching
                let child_session_id = format!("{}.{}",
                    self.session_id.as_deref().unwrap_or(""),
                    &pending.invoke_id);

                // W3C SCXML 6.4: Create child state machine
                let mut child_policy = super::{{ invoke_info.child_name }}_sm::{{ invoke_info.child_name | to_machine_name }}Policy::new();
                // W3C SCXML 6.4: Pass parent session info to child for #_parent routing
                // (only if child has parent communication support — i.e. uses #_parent)
                child_policy.parent_external_queue = Some(engine.get_external_queue_handle());
                child_policy.invoke_id = pending.invoke_id.clone();
                child_policy.child_session_id = child_session_id.clone();

                // W3C SCXML 6.4: Ensure child session ID for invoke tracking
                if child_policy.session_id.is_none() {
                    static CHILD_SESSION_COUNTER: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
                    let cid = CHILD_SESSION_COUNTER.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
                    child_policy.session_id = Some(format!("child_session_{}", cid));
                }

{% if invoke_info.namelist %}
                // W3C SCXML 6.4.1: Pass namelist values to child datamodel
{% if invoke_info.child_needs_script_engine %}
                {
                    self.ensure_script_engine();
                    let sid = self.session_id.as_ref().unwrap().clone();
                    let se = sce_rust_runtime::ScriptEngineProvider::get();
{% for var_name in invoke_info.namelist.split() %}
                    if se.has_variable(&sid, "{{ var_name }}") {
                        if let Ok(val) = se.evaluate_expression(&sid, "{{ var_name }}") {
                            child_policy.set_param_in_script_engine("{{ var_name }}", &val.to_lua_literal());
                        }
                    } else {
{% if 'error.execution' in model.events %}
                        engine.raise(sce_rust_runtime::EventWithMetadata::new(
                            {{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}));
{% endif %}
                        continue;
                    }
{% endfor %}
                }
{% endif %}
{% endif %}

{% if invoke_info.params %}
                // W3C SCXML 6.4.1: Pass params to child datamodel before initialization
{% if invoke_info.child_needs_script_engine %}
                {
                    self.ensure_script_engine();
                    let sid = self.session_id.as_ref().unwrap().clone();
                    let se = sce_rust_runtime::ScriptEngineProvider::get();
{% for param in invoke_info.params %}
                    if let Ok(val) = se.evaluate_expression(&sid, "{{ param.expr | to_lua_expr | escape_rust }}") {
                        child_policy.set_param_in_script_engine("{{ param.name }}", &val.to_lua_literal());
                    }
{% endfor %}
                }
{% endif %}
{% endif %}

                // W3C SCXML 6.4.6: Track active invoke session BEFORE initialize
                self.active_invokes.insert("{{ invoke_info.invoke_id }}".to_string(),
                    sce_rust_runtime::invoke::ChildSession {
                        session_id: child_session_id,
                        invoke_id: "{{ invoke_info.invoke_id }}".to_string(),
                        parent_session_id: self.session_id.clone().unwrap_or_default(),
                        autoforward: {{ 'true' if invoke_info.autoforward else 'false' }},
                        finalize_script: "{{ invoke_info.finalize_content }}".to_string(),
                    },
                );

                let mut child_engine = sce_rust_runtime::Engine::new(child_policy);
                child_engine.initialize();

                // W3C SCXML 6.4: Check if child completed during initialize (test 236)
                if child_engine.is_in_final_state() {
                    self.pending_done_invoke_{{ invoke_info.invoke_id }} = true;
{% if invoke_info.use_specific_event and ('done.invoke.' + invoke_info.invoke_id) in model.events %}
                    engine.raise_external_with_meta(sce_rust_runtime::EventWithMetadata::new(
                        {{ machine_name }}Event::{{ ('done.invoke.' + invoke_info.invoke_id) | to_event_variant }}));
{% elif 'done.invoke' in model.events %}
                    {
                        let mut done_meta = sce_rust_runtime::EventWithMetadata::new(
                            {{ machine_name }}Event::{{ 'done.invoke' | to_event_variant }});
                        done_meta.metadata.invoke_id = pending.invoke_id.clone();
                        engine.raise_external_with_meta(done_meta);
                    }
{% endif %}
                }

                // W3C SCXML 6.4: Store child for ticking and cancel
                self.child_{{ invoke_info.invoke_id }} = Some(Box::new(child_engine));
                continue;
            }
{% endfor %}
{% endif %}
{% endfor %}
        }
    }

    // W3C SCXML 6.4: Tick child state machines (propagate scheduler ticks)
    fn do_tick_children(&mut self, engine: &mut sce_rust_runtime::Engine<Self>) {
{% for invoke_info in model.static_invokes %}
        if let Some(ref mut child) = self.child_{{ invoke_info.invoke_id }} {
            if !self.pending_done_invoke_{{ invoke_info.invoke_id }} {
                // W3C SCXML 6.4: Drain parent events sent by child via #_parent
                let parent_events: Vec<(String, String)> = {
                    if let Some(ref queue) = child.policy().parent_external_queue {
                        let mut q = queue.lock().unwrap();
                        q.drain(..).collect()
                    } else {
                        Vec::new()
                    }
                };
                for (event_name, event_data) in parent_events {
                    if let Some(event) = Self::get_event_from_name(&event_name) {
                        let mut meta = sce_rust_runtime::EventWithMetadata::new(event);
                        meta.metadata.data = event_data;
                        meta.metadata.invoke_id = self.active_invokes
                            .get("{{ invoke_info.invoke_id }}")
                            .map_or_else(String::new, |cs| cs.invoke_id.clone());
                        meta.metadata.origin = self.active_invokes
                            .get("{{ invoke_info.invoke_id }}")
                            .map_or_else(String::new, |cs| cs.session_id.clone());
                        engine.raise_external_with_meta(meta);
                    }
                }

                child.tick();

                // W3C SCXML 6.4: Check if child reached final state after tick
                if child.is_in_final_state() && !self.pending_done_invoke_{{ invoke_info.invoke_id }} {
                    self.pending_done_invoke_{{ invoke_info.invoke_id }} = true;
{% if invoke_info.use_specific_event and ('done.invoke.' + invoke_info.invoke_id) in model.events %}
                    engine.raise_external_with_meta(sce_rust_runtime::EventWithMetadata::new(
                        {{ machine_name }}Event::{{ ('done.invoke.' + invoke_info.invoke_id) | to_event_variant }}));
{% elif 'done.invoke' in model.events %}
                    {
                        let mut done_meta = sce_rust_runtime::EventWithMetadata::new(
                            {{ machine_name }}Event::{{ 'done.invoke' | to_event_variant }});
                        let invoke_id_str = self.active_invokes
                            .get("{{ invoke_info.invoke_id }}")
                            .map_or_else(String::new, |cs| cs.invoke_id.clone());
                        done_meta.metadata.invoke_id = invoke_id_str;
                        engine.raise_external_with_meta(done_meta);
                    }
{% endif %}
                }
            }
        }
{% endfor %}
    }
{% endif %}
