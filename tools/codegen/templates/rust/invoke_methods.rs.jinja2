{# W3C SCXML 6.4: the parent's tick of the child in `slot`: what an earlier
   drive left settled, the child ticked, and what this tick produced settled. #}
{% macro child_tick(invoke_info, slot) %}
        if !self.pending_done_invoke_{{ invoke_info.field_suffix }} && self.{{ slot }}.is_some() {
            self.settle_{{ slot }}(engine);
            if let Some(child) = self.{{ slot }}.as_mut() {
                // Child sessions in Mesh (SCE_MESH.md): what arrived for the
                // child on the router it was given, before its macrostep.
                child.apply_mesh_calls();
                child.tick();
            }
            self.settle_{{ slot }}(engine);
        }
{% endmacro %}
{#
    W3C SCXML 6.4 + docs/adr/0045: what follows every drive of the child in
    `slot` — its start, its tick, and every delivery this session makes to it —
    so that nothing is between the two sessions when the drive returns: the
    events the child sent `#_parent` while it ran are raised on this session,
    and a child that reached its final state raises `done.invoke` once. One body
    for every drive, so a save at any boundary of this session finds the
    child's buffer empty.
#}
{% macro settle_child_fn(invoke_info, slot) %}
    fn settle_{{ slot }}(&mut self, engine: &mut sce_rust_runtime::Engine<Self>) {
        let Some(child) = self.{{ slot }}.as_mut() else {
            return;
        };
        sce_rust_runtime::helpers::invoke_processing::drain_and_raise_child_events(
            &child.policy().parent_external_queue,
            &self.active_invokes,
            "{{ invoke_info.invoke_id }}",
            engine,
        );
        if child.is_in_final_state() && !self.pending_done_invoke_{{ invoke_info.field_suffix }} {
            self.pending_done_invoke_{{ invoke_info.field_suffix }} = true;
            // The session ended: its Mesh router is told so.
            child.detach_mesh();
            // W3C SCXML 5.5 + 6.3.1: Lift the child's stashed donedata onto
            // done.invoke.<id>._event.data. Mirrors the C++ AOT contract in
            // tools/codegen/templates/invoke_methods.jinja2 (child->donedataAtFinal()
            // + EventMetadataHelper::createDoneInvokeEvent).
            let donedata = child.donedata_at_final().to_string();
            sce_rust_runtime::helpers::invoke_processing::raise_done_invoke(
                "{{ invoke_info.invoke_id }}",
                donedata,
                engine,
            );
        }
    }
{% endmacro %}
{# W3C SCXML 6.4: a running child's nearest timer. A child that has ended
   (`pending_done_invoke`) is skipped — the policy keeps it until its state
   exits, and what it armed is no longer owed. #}
{% macro child_deadline(invoke_info, slot) %}
        if !self.pending_done_invoke_{{ invoke_info.field_suffix }} {
            if let Some(ref child) = self.{{ slot }} {
                if let Some(due) = child.time_until_next_scheduled_ms() {
                    soonest = Some(soonest.map_or(due, |nearest| nearest.min(due)));
                }
            }
        }
