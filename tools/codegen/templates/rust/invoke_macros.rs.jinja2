{# W3C SCXML 6.4.1: an invoke's generated id goes to its `idlocation` when the
   element is evaluated (test 224 checks the stored form), and binds
   `id_stored` for the caller. The write is the assignment `<assign>` makes —
   the location is lowered, so a member path lands, and one that cannot take
   the id raises error.execution and the invocation does not start, as any
   argument of the element that cannot be evaluated does. `model` and
   `machine_name` are parameters because a macro body does not see the render
   context. #}
{% macro store_invoke_idlocation(invoke_info, model, machine_name) %}
{% if invoke_info.native_idlocation %}
                    // docs/adr/0045: under `datamodel="sce-static"` the id is
                    // written to the string variable `idlocation` names, whose
                    // bound the build held to one the id fits.
                    {{ invoke_info.native_idlocation }}
                    let id_stored = true;
{% elif invoke_info.idlocation %}
                    self.ensure_script_engine();
                    let id_stored = {
                        let sid = self.session_id.as_ref().unwrap().clone();
                        let se = self.script_engine.clone();
                        let se: &dyn sce_rust_runtime::IScriptEngine = &*se;
                        ::sce_rust_runtime::helpers::idlocation::store_id_in_location(
                            se, &sid, "{{ invoke_info.idlocation | to_lua_location | escape_rust }}", &generated_invoke_id,
                        )
                    };
                    if !id_stored {
{% if 'error.execution' in model.events %}
                        engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<invoke idlocation='{{ invoke_info.idlocation | escape_rust }}'> could not take the invoke id"));
{% endif %}
                    }
{% else %}
                    let id_stored = true;
{% endif %}
{% endmacro %}

{# docs/adr/0045: the engine of a child session, named by the stem of the
   document it runs and the type of the host it is built with (absent for a
   child that declares no act), as the parent's slot for it names it; and the
   trait that engine is saved and restored through. #}
{% macro child_engine_type(stem, host_type) -%}
::sce_rust_runtime::Engine<super::{{ stem }}_sm::{{ stem | to_machine_name }}Policy{% if host_type %}<{{ host_type }}>{% endif %}>
{%- endmacro %}
{% macro child_persist_trait(stem) -%}
super::{{ stem }}_sm::{{ stem | to_machine_name }}Persist
{%- endmacro %}

{# W3C SCXML 6.4: defer the start of the static `<invoke type="scxml">`
   `invoke_info`, held by the state `state_id`, to the end of the macrostep.

   One body for the two things that start a child. Entering the state defers it
   from `execute_entry_actions`; a restore of a format-1 state (SCE Accepted
   Subset 2.15, "Saving and restoring") defers each running invocation it lists
   from `restart_invoke`. Such a state holds nothing of the child, so what that
   restore needs is exactly what entering the state does, and two spellings of
   it would be two places a change to one is forgotten in the other. A format-2
   state holds the child, which a restore resumes instead (`do_resume_child`).
   A state that exits before the macrostep ends cancels the entry
   (`cancel_invokes_for_state`) in either case.

   Emitted as an inherent method of the policy, once per invoke, named by the
   invoke's `field_suffix`. #}
{% macro defer_scxml_invoke_fn(invoke_info, state_id, model, machine_name) %}
    // W3C SCXML 6.4: Defer the start of invoke '{{ invoke_info.invoke_id }}' of state '{{ state_id }}' to macrostep end
    fn defer_invoke_{{ invoke_info.field_suffix }}(&mut self, {{ 'engine' if (invoke_info.idlocation and not invoke_info.native_idlocation and 'error.execution' in model.events) else '_engine' }}: &mut sce_rust_runtime::Engine<Self>) {
        {
            // docs/adr/0045: the id is the state's, the number of this start and
            // the `<invoke>`'s, so it comes from the tree alone and is the same
            // text on every backend (W3C test 224 reads the state's id and a dot
            // in front of it).
            self.invoke_starts_{{ invoke_info.field_suffix }} += 1;
            let generated_invoke_id = format!("{}.{}.{{ invoke_info.invoke_id }}",
                "{{ state_id }}", self.invoke_starts_{{ invoke_info.field_suffix }});
{{ store_invoke_idlocation(invoke_info, model, machine_name) -}}
            if id_stored {
                sce_rust_runtime::invoke::defer_invoke(
                    &mut self.pending_invokes,
                    sce_rust_runtime::invoke::PendingInvoke {
                        invoke_id: generated_invoke_id,
                        state: {{ machine_name }}State::{{ state_id | to_state_variant }},
                        document_id: "{{ invoke_info.invoke_id }}",
                    },
                );
            }
        }
    }
{% endmacro %}
