{#
    Transition Selection Template (Rust Jinja2)

    What the generated policy knows and the engine does not: whether a
    transition's guard holds, and what each transition's content is. Which of a
    state's transitions an event enables is a row of the document's tables
    (`selection`, state_machine.rs.jinja2), which the runtime's one selection
    reads for every machine (docs/adr/0127). Everything else Appendix D does
    with a transition — the walk from each atomic state up through its
    ancestors, the ordered set, conflict removal,
    the exit set, the entry set — is written once, in
    `sce_rust_runtime::helpers::microstep`, over the structure
    state_machine.rs.jinja2 emits.

    It used to be written here as well, in two shapes: machines with a
    `<parallel>` collected, resolved and ran their own microstep here, while
    every other machine moved `current_state` here and let the engine walk an
    LCA. The two disagreed about eventless selection (one never looked above
    the atomic state, the other looked at every active state without
    walking), about the order transition content runs in, and about how many
    targets a transition has — both kept only the first.

    Generates:
    - bind_current_event(event, engine)             §scxml-5.10 `_event` for the guards
    - guard_holds(transition, sce_event_data, engine)  whether a guard holds, for a guarded document
    - execute_transition_content(transition, sce_event_data, engine)

    `sce_event_data` is the data of the event being processed, the machine's
    `EventData`, handed to each hook by the engine whether a queue owned it or
    a host lent it; a guard or content that reads `_event.data` reads it there,
    and nothing here keeps it (docs/adr/0124).

    A transition reaches the engine as its number in the document's tables
    (docs/adr/0064), the row that holds its source, its targets and its type:
    `tables.written[state][index]` is the number of the `index`-th transition
    written in `state`. The state and the event come in as the numbers of the
    same tables (docs/adr/0123), matched through the `ID_<variant>` constants
    state_machine.rs.jinja2 writes beside each enum.

    The template stays the one judge of which transitions are guarded: the
    rows hold no guard, and `guard_holds` is written over exactly the
    transitions that have one (docs/adr/0127, decision 2).

    The Rust twin of C++ process_transition.jinja2.
#}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}

{# The guard a transition is taken under, in the one form this machine can
   evaluate it: a guard lowered to Rust at generate time (a typed-payload
   comparison, a sce-static condition), a pure In() predicate, the script
   engine, or a value decided at build time. An In() is asked of the engine,
   which keeps the configuration (`rust_in_predicate`). #}
{% macro guard_expr(trans) -%}
{%- if trans.native_guard -%}{{ trans.native_guard | rust_in_predicate }}
{%- elif trans.is_pure_in_predicate -%}{{ trans.cond_cpp | rust_in_predicate }}
{%- elif model.needs_script_engine -%}self.safe_evaluate_guard("{{ trans.cond | to_lua_guard | escape_rust }}", engine)
{%- else -%}{{ 'true' if trans.cond_constant else 'false' }}
{%- endif -%}
{%- endmacro %}

{% if model.needs_script_engine %}
    // §scxml-5.10: the event whose transitions are about to be selected is the
    // `_event` their guards read — bound before the first guard runs, and not
    // for an eventless selection, which has no event of its own.
    {# SCE Protocol-Synthesis RFC §synth-5-O — function-scope SCE-MAP marker
       above each function this template emits. #}
    {{ sce_map.source_marker(model.source_location, "rust", symbol_artifact=sce_artifact.machine) }}
    fn bind_current_event(&mut self, event: ::sce_rust_runtime::EventId, engine: &mut sce_rust_runtime::EngineState<Self>) {
        // W3C SCXML 5.10: set _event for guard evaluation, in the session the
        // start established (docs/adr/0096)
        self.assert_script_session();
{% if model.has_parallel_states or model.uses_in_predicate %}
        // A selection does not change the configuration, so the guards it
        // runs read the one published here.
        self.publish_in_predicate_states(engine);
{% endif %}
{% if model.needs_event_name %}
        if event != {{ machine_name }}Event::ID_Null {
            // §scxml-5.10: the name the event ARRIVED under, which is longer than
            // its member's when a name the document does not write was matched
            // through a prefix (§scxml-3.12.1).
            let arrival = self.pending_event_arrival_name.clone();
            let event_name: &str = if arrival.is_empty() {
                Self::get_event_name(Self::event_of(event))
            } else {
                arrival.as_str()
            };
            self.pending_event_name = event_name.to_string();
            // §scxml-5.10.1: typed by the queue the engine took the event from.
            let event_type = sce_rust_runtime::EventType::classify(
                event_name,
                engine.is_current_event_external(),
            )
            .as_str();
{% if model.needs_event_type %}
            self.pending_event_type = event_type.to_string();
{% endif %}
            // W3C SCXML 5.10: Set _event with all available metadata fields
{% if model.needs_event_data %}
            let ev_data: &str = &self.pending_event_data;
{% else %}
            let ev_data: &str = "";
{% endif %}
{% if model.needs_event_sendid %}
            let ev_sendid: &str = &self.pending_event_sendid;
{% else %}
            let ev_sendid: &str = "";
{% endif %}
{% if model.needs_event_origin or model.needs_event_origintype %}
            let ev_origin: Option<&sce_rust_runtime::EventOrigin> = self.pending_event_origin.as_ref();
{% else %}
            let ev_origin: Option<&sce_rust_runtime::EventOrigin> = None;
{% endif %}
{% if model.needs_event_invokeid %}
            let ev_invokeid: &str = &self.pending_event_invokeid;
{% else %}
            let ev_invokeid: &str = "";
{% endif %}
            // §scxml-B-2-8-1: the rung the payload got, handed to the engine
            // rather than dropped. This is the only frame that has both the
            // reading and the event it belongs to.
            let payload_reading = self.set_current_event_in_script_engine(
                event_name, ev_data, event_type, ev_sendid, ev_origin, ev_invokeid,
            );
            engine.note_payload_reading(event, payload_reading);
        }
{% else %}
        let _ = (event, engine);
{% endif %}
    }

{% endif %}
{# Whether any transition is guarded: only then is `guard_holds` written, and
   the trait's default, which holds, answers for a document with none. #}
{% set guarded = namespace(any=false) %}
{% for state_id, state in model.states | dictsort %}
{% for trans in state.transitions %}
{% if trans.cond or trans.native_guard %}
{% set guarded.any = true %}
{% endif %}
{% endfor %}
{% endfor %}
{% if guarded.any %}
    // §scxml-3.13: whether the guard of `transition`, a written transition the
    // event being selected for enables, holds. Which transitions an event
    // enables is a row of the tables (`selection`), which the runtime's one
    // selection reads for every machine and asks this only for a transition
    // the event enables, in the order its state's transitions are written,
    // until one holds (docs/adr/0127). The transition is its number in the
    // tables, and every other transition has no guard.
    {{ sce_map.source_marker(model.source_location, "rust", symbol_artifact=sce_artifact.machine) }}
    fn guard_holds(
        &mut self,
        transition: ::sce_rust_runtime::TransitionId,
        sce_event_data: Self::EventData<'_>,
        engine: &mut sce_rust_runtime::EngineState<Self>,
    ) -> bool {
        match transition.0 {
{% for state_id, state in model.states | dictsort %}
{% for trans in state.transitions %}
{# A guard lowered with no `cond` written is a branch of a test component's
   match on the round's snapshot (docs/SCE_TEST_PROFILE.md §12.3). #}
{% if trans.cond or trans.native_guard %}
            // {{ state_id }}, transition {{ trans.transition_index }}
            {{ tables.written[state_id][trans.transition_index] }} => {{ guard_expr(trans) }},
{% endif %}
{% endfor %}
{% endfor %}
            _ => true,
        }
    }

{% endif %}
{% if model.test_component %}
    // docs/SCE_TEST_PROFILE.md §4.4 (P4 step 1), §12.3: each selected branch
    // is taken before the microstep exits anything: it removes what it matched
    // from the round's snapshot, writes its record in the test log, and holds
    // a message its content reads in `taken_message`, which the content binds
    // as its `_event.data` (`Transition::native_take`). Both items are
    // the runtime's `test-component` feature, which the crate that compiles a
    // test component names: a build without it has no take step.
    const TAKES_TRANSITIONS: bool = true; // sce-rust-runtime's `test-component` feature

    fn take_transition(
        &mut self,
        transition: ::sce_rust_runtime::TransitionId,
        _engine: &mut sce_rust_runtime::EngineState<Self>,
    ) {
        match transition.0 {
{% for state_id, state in model.states | dictsort %}
{% for trans in state.transitions %}
{% if trans.native_take %}
            // {{ state_id }}, transition {{ trans.transition_index }}
            {{ tables.written[state_id][trans.transition_index] }} => {
{{ trans.native_take }}
            }
{% endif %}
{% endfor %}
{% endfor %}
            _ => {}
        }
    }

{% endif %}
    // W3C SCXML 3.13: a transition's executable content, run by the engine
    // between the microstep's exits and its entries. `transition` is a
    // written transition's row, one whose row says it has content.
    {{ sce_map.source_marker(model.source_location, "rust", symbol_artifact=sce_artifact.machine) }}
    fn execute_transition_content(
        &mut self,
        transition: ::sce_rust_runtime::TransitionId,
        sce_event_data: Self::EventData<'_>,
        engine: &mut sce_rust_runtime::EngineState<Self>,
    ) {
{% if model.needs_script_engine and (model.has_parallel_states or model.uses_in_predicate) %}
        self.publish_in_predicate_states(engine);
{% endif %}
{% if model.has_transition_actions %}
        match transition.0 {
{% for state_id, state in model.states | dictsort %}
{% for trans in state.transitions %}
{% if trans.actions %}
            // {{ state_id }}, transition {{ trans.transition_index }}
            {{ tables.written[state_id][trans.transition_index] }} => {  {{- annot.annotation_comment(trans, "rust", "                ") }}
{% if trans.source_location %}
                {{ sce_map.source_marker(trans.source_location, "rust", stmt_level=true, symbol_state=trans.symbol_state_path, symbol_artifact=trans.symbol_artifact) | trim }}
{% endif %}
                // W3C SCXML 3.13: Transition {{ trans.transition_index }} actions
{#  docs/SCE_TEST_PROFILE.md §12.3: a branch of a test component took its
    message before the microstep exited anything (`take_transition`), and
    held it in `taken_message`; content that reads it binds it as `ev`, its
    `_event.data` (`Transition::native_prelude`). #}
{% if trans.native_prelude %}
{{ trans.native_prelude }}
{% endif %}
{#  SCE Accepted Subset §2.15: content that reads the event's typed payload
    cannot run for a delivery that did not carry one, so it binds the payload
    once, before any of it runs, or does not run. A delivery of this event
    whose data does not fit is refused whole at the door and never reaches it
    (docs/adr/0086, section 4.2); the binding fails here only for an event of
    another name the transition's descriptor also matches, which carries no
    payload of this event, or, on a `no_std` build, which lifts no wire, for
    one sent without its typed payload; nothing is raised. The binding borrows
    the event's data, an argument of this hook and no field of the machine,
    so the statements after it may write the machine's fields (docs/adr/0124). #}
{% if trans.content_reads_payload %}
                let ev = match sce_event_data {
                    {{ machine_name }}EventData::{{ trans.event | to_event_variant }}(ev) => ev,
                    _ => return,
                };
{% endif %}
                // W3C SCXML 4.9: a transition's content is one block; an error ends it.
                'action_block: {
{# `block_flow`: an element that ends the block unconditionally sets it, and
   nothing after that element is emitted (rust/entry_exit_actions.rs.jinja2). #}
{% with block_flow = namespace(ended=false) %}
{% for action in trans.actions %}
{% if not block_flow.ended %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "rust", "                ") -}}
{%- endif %}
                {% with in_action_block=true %}{% include 'actions/' ~ action.type ~ '.rs.jinja2' %}{% endwith %}

{% endif %}
{% endfor %}
{% endwith %}
                }
            }
{% endif %}
{% endfor %}
{% endfor %}
            _ => {}
        }
{% else %}
        // W3C SCXML 3.13: no transition in this document has content.
        let _ = (transition, engine);
{% endif %}
    }
