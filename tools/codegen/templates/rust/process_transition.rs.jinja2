{#
    Process Transition Template (Rust Jinja2)

    W3C SCXML 3.12/3.13/Appendix D: Transition processing.

    Generates:
    - process_transition(&mut self, current_state, event, engine) -> bool
    - execute_transition_actions(&mut self, engine)
    - try_transition_in_state() (helper method in impl block)

    Ports from C++ process_transition.jinja2.
#}

    // W3C SCXML 3.13: Evaluate guards and take a matching transition
    fn process_transition(
        &mut self,
        current_state: &mut Self::State,
        event: Self::Event,
        engine: &mut sce_rust_runtime::Engine<Self>,
    ) -> bool {
        let mut transition_taken = false;

{% if model.needs_script_engine %}
        // W3C SCXML 5.10: Ensure script engine and set _event for guard evaluation
        self.ensure_script_engine();
{% if model.needs_event_name %}
        if event != Self::null_event() {
            let event_name = Self::get_event_name(event);
            self.pending_event_name = event_name.to_string();
{% if model.needs_event_type %}
            // W3C SCXML 5.10.1: Classify event type (ports C++ EventTypeHelper::classifyEventType)
            let event_type = if event_name.starts_with("error.") || event_name.starts_with("done.") {
                "platform"
{% if model.needs_external_flag %}
            } else if self.next_event_is_external {
                self.next_event_is_external = false;
                "external"
{% endif %}
            } else {
                "internal"
            };
            self.pending_event_type = event_type.to_string();
{% elif model.needs_external_flag %}
            let event_type = if self.next_event_is_external {
                self.next_event_is_external = false;
                "external"
            } else {
                "internal"
            };
{% else %}
            let event_type = "internal";
{% endif %}
            // W3C SCXML 5.10: Set _event with all available metadata fields
{% if model.needs_event_data %}
            let ev_data: &str = &self.pending_event_data;
{% else %}
            let ev_data: &str = "";
{% endif %}
{% if model.needs_event_sendid %}
            let ev_sendid: &str = &self.pending_event_sendid;
{% else %}
            let ev_sendid: &str = "";
{% endif %}
{% if model.needs_event_origin %}
            let ev_origin: &str = &self.pending_event_origin;
{% else %}
            let ev_origin: &str = "";
{% endif %}
{% if model.needs_event_origintype %}
            let ev_origintype: &str = &self.pending_event_origintype;
{% else %}
            let ev_origintype: &str = "";
{% endif %}
{% if model.needs_event_invokeid %}
            let ev_invokeid: &str = &self.pending_event_invokeid;
{% else %}
            let ev_invokeid: &str = "";
{% endif %}
            self.set_current_event_in_script_engine(
                event_name, ev_data, event_type, ev_sendid, ev_origin, ev_origintype, ev_invokeid,
            );
        }
{% endif %}
{% if model.has_parallel_states or model.uses_in_predicate %}
        // W3C SCXML 5.9.2: Update shared In() active state snapshot
        if let Some(ref shared) = self.in_predicate_states {
            let mut states = shared.lock().unwrap();
            states.clear();
            states.extend(self.active_states.iter().map(|&s| Self::get_state_name(s).to_string()));
        }
{% endif %}
{% endif %}

{% if model.has_parallel_states %}
        // W3C SCXML 3.4 + 3.12 + Appendix D: Parallel state transition handling
        if event == Self::null_event() {
            // W3C SCXML Appendix D: Eventless transitions - collect then execute
            let mut enabled_transitions: Vec<TransitionInfo> = Vec::new();
            let mut states_to_check = self.active_states.clone();

            // Sort by document order for consistent processing
            states_to_check.sort_by_key(|&s| Self::get_document_order(s));

            for active_state in &states_to_check {
                // W3C SCXML 3.13: Eventless transitions do NOT bubble to parent states
                self.try_transition_in_state(*active_state, event, current_state, &mut transition_taken, engine, Some(&mut enabled_transitions));
            }

            // W3C SCXML Appendix D.2: Remove conflicting transitions
            if !enabled_transitions.is_empty() {
                enabled_transitions = Self::remove_conflicting_transitions(&enabled_transitions);
            }

            // W3C SCXML Appendix D Steps 2-5: Execute as atomic microstep
            if !enabled_transitions.is_empty() {
                self.execute_microstep(&enabled_transitions, current_state, &mut transition_taken, engine);
            }
        } else {
            // W3C SCXML Appendix D: External events - collect then execute
            let mut enabled_transitions: Vec<TransitionInfo> = Vec::new();

            for &active_state in &self.active_states.clone() {
                let is_non_atomic = Self::is_compound_state(active_state) || Self::is_parallel_state(active_state);

                // W3C SCXML 3.13: Check if this is a done.state event
                let event_name = Self::get_event_name(event);
                let is_done_state_event = event != Self::null_event() && event_name.starts_with("done.state.");

                // Skip non-atomic states UNLESS processing done.state event
                if is_non_atomic && !is_done_state_event {
                    continue;
                }

                // W3C SCXML 3.12: Hierarchical event bubbling
                let mut check_state = active_state;
                loop {
                    let found = self.try_transition_in_state(check_state, event, current_state, &mut transition_taken, engine, Some(&mut enabled_transitions));
                    if found {
                        break;
                    }
                    match Self::get_parent(check_state) {
                        Some(parent) => check_state = parent,
                        None => break,
                    }
                }
            }

            // W3C SCXML 3.13: Deduplicate transitions collected from multiple descendants
            // of the same ancestor (e.g., both parallel regions bubble up to the same parent
            // transition; test 504). Preserves first-match document order.
            let mut seen = std::collections::HashSet::new();
            enabled_transitions.retain(|t| {
                seen.insert((t.source, t.transition_index))
            });

            // W3C SCXML Appendix D.2: Remove conflicting transitions
            if !enabled_transitions.is_empty() {
                enabled_transitions = Self::remove_conflicting_transitions(&enabled_transitions);
            }

            // W3C SCXML Appendix D Steps 2-5: Execute as atomic microstep
            if !enabled_transitions.is_empty() {
                self.execute_microstep(&enabled_transitions, current_state, &mut transition_taken, engine);
            }
        }
{% elif model.has_hierarchy %}
        // W3C SCXML 3.12: Hierarchical event processing (innermost to outermost)
        let mut check_state = *current_state;

        loop {
            let found = self.try_transition_in_state(check_state, event, current_state, &mut transition_taken, engine);

            if found {
                break;
            }

            // W3C SCXML 3.13: Eventless transitions do NOT bubble to parent states
            if event == Self::null_event() {
                break;
            }

            // W3C SCXML 3.12: Move to parent state for hierarchical event bubbling
            match Self::get_parent(check_state) {
                Some(parent) => check_state = parent,
                None => break,
            }
        }
{% else %}
        // Flat state machine: no hierarchy, direct transition check
        self.try_transition_in_state(*current_state, event, current_state, &mut transition_taken, engine);
{% endif %}

        transition_taken
    }

    // W3C SCXML 3.13: Execute transition actions (called between exit and entry)
    fn execute_transition_actions(&mut self, engine: &mut sce_rust_runtime::Engine<Self>) {
{% if model.has_transition_actions %}
        if !self.has_transition_actions {
            return;
        }

        // Switch on source state, then transition index
        match self.last_transition_source_state {
{% for state_id, state in model.states | dictsort %}
{% if state.transitions %}
{% if state.transitions | selectattr("actions") | list %}
            {{ machine_name }}State::{{ state_id | to_state_variant }} => {
                match self.last_transition_index {
{% for trans in state.transitions %}
{% if trans.actions %}
                    {{ loop.index0 }} => {
                        // W3C SCXML 3.13: Transition {{ loop.index0 }} actions
{% for action in trans.actions %}
                        {% include 'actions/' ~ action.type ~ '.rs.jinja2' %}

{% endfor %}
                    }
{% endif %}
{% endfor %}
                    _ => {}
                }
            }
{% endif %}
{% endif %}
{% endfor %}
            _ => {}
        }

        // Reset flags after execution
        self.has_transition_actions = false;
{% else %}
        // W3C SCXML 3.13: No transition actions in this state machine
        let _ = engine;
{% endif %}
    }
