{#
    Transition Selection Template (Rust Jinja2)

    What the generated policy knows and the engine does not: which of a
    state's transitions an event enables, and what each transition's content
    is. Everything else Appendix D does with a transition — the walk from each
    atomic state up through its ancestors, the ordered set, conflict removal,
    the exit set, the entry set — is written once, in
    `sce_rust_runtime::helpers::microstep`, over the structure
    state_machine.rs.jinja2 emits.

    It used to be written here as well, in two shapes: machines with a
    `<parallel>` collected, resolved and ran their own microstep here, while
    every other machine moved `current_state` here and let the engine walk an
    LCA. The two disagreed about eventless selection (one never looked above
    the atomic state, the other looked at every active state without
    walking), about the order transition content runs in, and about how many
    targets a transition has — both kept only the first.

    Generates:
    - bind_current_event(event, engine)             §scxml-5.10 `_event` for the guards
    - first_enabled_transition(state, event, engine)  the per-state half of selection
    - execute_transition_content(transition, engine)

    A transition reaches the engine as its number in the document's tables
    (docs/adr/0064), the row that holds its source, its targets and its type:
    `tables.written[state][index]` is the number of the `index`-th transition
    written in `state`.

    The Rust twin of C++ process_transition.jinja2.
#}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}

{# The guard a transition is taken under, in the one form this machine can
   evaluate it: a guard lowered to Rust at generate time (a typed-payload
   comparison, a sce-static condition), a pure In() predicate, the script
   engine, or a value decided at build time. An In() is asked of the engine,
   which keeps the configuration (`rust_in_predicate`). #}
{% macro guard_expr(trans) -%}
{%- if trans.native_guard -%}{{ trans.native_guard | rust_in_predicate }}
{%- elif trans.is_pure_in_predicate -%}{{ trans.cond_cpp | rust_in_predicate }}
{%- elif model.needs_script_engine -%}self.safe_evaluate_guard("{{ trans.cond | to_lua_guard | escape_rust }}", engine)
{%- else -%}{{ 'true' if trans.cond_constant else 'false' }}
{%- endif -%}
{%- endmacro %}

{# Whether `trans` answers `event`: an eventless transition only an eventless
   selection, a transition with an event descriptor only a named event —
   §scxml-3.13 selects the two kinds in separate passes. #}
{% macro event_match(trans) -%}
{%- if not trans.event -%}event == {{ machine_name }}Event::Null
{%- elif trans.needs_string_matching -%}event != {{ machine_name }}Event::Null && sce_rust_runtime::helpers::event_matching::matches_event_descriptor(Self::get_event_name(event), "{{ trans.event }}")
{%- elif trans.matching_enum_values | length > 0 -%}{% for ev in trans.matching_enum_values %}event == {{ machine_name }}Event::{{ ev | to_event_variant }}{{ ' || ' if not loop.last }}{% endfor %}
{%- else -%}false
{%- endif -%}
{%- endmacro %}

{% if model.needs_script_engine %}
    // §scxml-5.10: the event whose transitions are about to be selected is the
    // `_event` their guards read — bound before the first guard runs, and not
    // for an eventless selection, which has no event of its own.
    {# SCE Protocol-Synthesis RFC §synth-5-O — function-scope SCE-MAP marker
       above each function this template emits. #}
    {{ sce_map.source_marker(model.source_location, "rust", symbol_artifact=sce_artifact.machine) }}
    fn bind_current_event(&mut self, event: Self::Event, engine: &mut sce_rust_runtime::Engine<Self>) {
        // W3C SCXML 5.10: Ensure script engine and set _event for guard evaluation
        self.ensure_script_engine();
{% if model.has_parallel_states or model.uses_in_predicate %}
        // A selection does not change the configuration, so the guards it
        // runs read the one published here.
        self.publish_in_predicate_states(engine);
{% endif %}
{% if model.needs_event_name %}
        if event != Self::null_event() {
            // §scxml-5.10: the name the event ARRIVED under, which is longer than
            // its member's when a name the document does not write was matched
            // through a prefix (§scxml-3.12.1).
            let arrival = self.pending_event_arrival_name.clone();
            let event_name: &str = if arrival.is_empty() {
                Self::get_event_name(event)
            } else {
                arrival.as_str()
            };
            self.pending_event_name = event_name.to_string();
            // §scxml-5.10.1: typed by the queue the engine took the event from.
            let event_type = sce_rust_runtime::EventType::classify(
                event_name,
                engine.is_current_event_external(),
            )
            .as_str();
{% if model.needs_event_type %}
            self.pending_event_type = event_type.to_string();
{% endif %}
            // W3C SCXML 5.10: Set _event with all available metadata fields
{% if model.needs_event_data %}
            let ev_data: &str = &self.pending_event_data;
{% else %}
            let ev_data: &str = "";
{% endif %}
{% if model.needs_event_sendid %}
            let ev_sendid: &str = &self.pending_event_sendid;
{% else %}
            let ev_sendid: &str = "";
{% endif %}
{% if model.needs_event_origin %}
            let ev_origin: &str = &self.pending_event_origin;
{% else %}
            let ev_origin: &str = "";
{% endif %}
{% if model.needs_event_origintype %}
            let ev_origintype: &str = &self.pending_event_origintype;
{% else %}
            let ev_origintype: &str = "";
{% endif %}
{% if model.needs_event_invokeid %}
            let ev_invokeid: &str = &self.pending_event_invokeid;
{% else %}
            let ev_invokeid: &str = "";
{% endif %}
            // §scxml-B-2-8-1: the rung the payload got, handed to the engine
            // rather than dropped. This is the only frame that has both the
            // reading and the event it belongs to.
            let payload_reading = self.set_current_event_in_script_engine(
                event_name, ev_data, event_type, ev_sendid, ev_origin, ev_origintype, ev_invokeid,
            );
            engine.note_payload_reading(event, payload_reading);
        }
{% else %}
        let _ = (event, engine);
{% endif %}
    }

{% endif %}
    // Appendix D selectTransitions, the half only this document can answer:
    // the first of `state`'s own transitions, in document order, that `event`
    // enables, as its row of the tables, which holds its targets and its
    // type. The engine walks the atomic states and their ancestors and keeps
    // the ordered set. `Event::Null` asks for eventless transitions.
    {{ sce_map.source_marker(model.source_location, "rust", symbol_artifact=sce_artifact.machine) }}
    fn first_enabled_transition(
        &mut self,
        state: Self::State,
        event: Self::Event,
        engine: &mut sce_rust_runtime::Engine<Self>,
    ) -> Option<::sce_rust_runtime::TransitionId> {
        match state {
{% for state_id, state in model.states | dictsort %}
{% if state.transitions %}
            {{ machine_name }}State::{{ state_id | to_state_variant }} => {
{% for trans in state.transitions %}
                if {{ event_match(trans) }} {
{% if trans.cond %}
                    if {{ guard_expr(trans) }} {
{% else %}
                    {
{% endif %}
                        // {{ state_id }}, transition {{ trans.transition_index }}
                        return Some(::sce_rust_runtime::TransitionId({{ tables.written[state_id][trans.transition_index] }}));
                    }
                }
{% endfor %}
                None
            }
{% endif %}
{% endfor %}
            _ => None,
        }
    }

    // W3C SCXML 3.13: a transition's executable content, run by the engine
    // between the microstep's exits and its entries. `transition` is a
    // written transition's row, one whose row says it has content.
    {{ sce_map.source_marker(model.source_location, "rust", symbol_artifact=sce_artifact.machine) }}
    fn execute_transition_content(
        &mut self,
        transition: ::sce_rust_runtime::TransitionId,
        engine: &mut sce_rust_runtime::Engine<Self>,
    ) {
{% if model.needs_script_engine and (model.has_parallel_states or model.uses_in_predicate) %}
        self.publish_in_predicate_states(engine);
{% endif %}
{% if model.has_transition_actions %}
        match transition.0 {
{% for state_id, state in model.states | dictsort %}
{% for trans in state.transitions %}
{% if trans.actions %}
            // {{ state_id }}, transition {{ trans.transition_index }}
            {{ tables.written[state_id][trans.transition_index] }} => {  {{- annot.annotation_comment(trans, "rust", "                ") }}
{% if trans.source_location %}
                {{ sce_map.source_marker(trans.source_location, "rust", stmt_level=true, symbol_state=trans.symbol_state_path, symbol_artifact=trans.symbol_artifact) | trim }}
{% endif %}
                // W3C SCXML 3.13: Transition {{ trans.transition_index }} actions
{#  SCE Accepted Subset §2.15: content that reads the event's typed payload
    cannot run for a delivery that did not carry one, so it binds the payload
    once, before any of it runs, or does not run — raising nothing: the engine
    already said `error.execution` where it failed to read the delivery, and
    one unreadable delivery is one error (the Kotlin arm's rule). The binding
    is owned, so the statements after it may write the machine's fields. #}
{% if trans.content_reads_payload %}
                let ev = match &self.pending_payload {
                    {{ machine_name }}Payload::{{ trans.event | to_event_variant }}(ev) => ev.clone(),
                    _ => return,
                };
{% endif %}
                // W3C SCXML 4.9: a transition's content is one block; an error ends it.
                'action_block: {
{# `block_flow`: an element that ends the block unconditionally sets it, and
   nothing after that element is emitted (rust/entry_exit_actions.rs.jinja2). #}
{% with block_flow = namespace(ended=false) %}
{% for action in trans.actions %}
{% if not block_flow.ended %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "rust", "                ") -}}
{%- endif %}
                {% with in_action_block=true %}{% include 'actions/' ~ action.type ~ '.rs.jinja2' %}{% endwith %}

{% endif %}
{% endfor %}
{% endwith %}
                }
            }
{% endif %}
{% endfor %}
{% endfor %}
            _ => {}
        }
{% else %}
        // W3C SCXML 3.13: no transition in this document has content.
        let _ = (transition, engine);
{% endif %}
    }
