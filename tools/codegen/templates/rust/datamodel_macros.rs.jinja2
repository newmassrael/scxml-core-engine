{#
    Datamodel Initialization Macros (Rust Jinja2)

    Purpose: Eliminate code duplication between early and late binding initialization
    - DRY Principle: Single definition for datamodel variable initialization
    - Zero Duplication: Shared logic for do_initialize_data_model() (early binding)
      and execute_entry_actions() (late binding)

    Usage:
    - Early binding: Called from scriptengine_helpers.rs.jinja2
    - Late binding: Called from entry_exit_actions.rs.jinja2

    Ports C++ datamodel_macros.jinja2 which calls DataModelInitHelper methods.
    Rust equivalent uses sce_rust_runtime::helpers::datamodel_init functions.
#}

{# Macro: Initialize single datamodel variable (src/expr/content/null) #}
{# Parameters:
     var          - variable object with .id, .src, .expr, .content, .type
     state_id     - state identifier string for log messages
     raise_error  - boolean: whether to raise error.execution events
     machine_name - state machine name for event type references
     model        - full model object for event checks
#}
{% macro initialize_variable(var, state_id, raise_error, machine_name, model) %}
{% if var.src %}
        // W3C SCXML 5.3.1: Load variable '{{ var.id }}' from src ({{ state_id }})
        {
            let base_path = concat!(env!("CARGO_MANIFEST_DIR"), "/../../../{{ model.scxml_base_path }}/");
            if let Err(e) = sce_rust_runtime::helpers::datamodel_init::initialize_variable_from_src(
                se, &sid, "{{ var.id }}", "{{ var.src }}", base_path) {
                ::sce_rust_runtime::sce_log_error!("Failed to init '{{ var.id }}' from src in {{ state_id }}: {}", e);
{% if raise_error and 'error.execution' in model.events %}
                engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id }}' src='{{ var.src }}'> could not be loaded"));
{% endif %}
            }
        }
{% elif var.expr %}
{% set is_function_expr = (var.expr | trim) is startingwith('function') %}
{% if is_function_expr %}
        // W3C SCXML B.2: Function expression for '{{ var.id }}' ({{ state_id }})
        if let Err(e) = se.execute_script(&sid, "{{ var.id }} = {{ var.expr | to_lua_expr | escape_rust }}") {
            ::sce_rust_runtime::sce_log_error!("Failed to init function var '{{ var.id }}' in {{ state_id }}: {}", e);
{% if raise_error and 'error.execution' in model.events %}
            engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id }}'> function expression failed"));
{% endif %}
        }
{% else %}
        // W3C SCXML 5.2/5.3: Initialize '{{ var.id }}' from expr ({{ state_id }})
        if let Err(e) = sce_rust_runtime::helpers::datamodel_init::initialize_variable_from_expr(
            se, &sid, "{{ var.id }}", "{{ var.expr | to_lua_expr | escape_rust }}") {
            ::sce_rust_runtime::sce_log_error!("{{ state_id }}: {}", e);
{% if raise_error and 'error.execution' in model.events %}
            engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id }}'> expr failed to evaluate"));
{% endif %}
        }
{% endif %}
{% elif var.content %}
{% if (var.content | trim) is startingwith('<') %}
        // W3C SCXML B.2: XML inline content for '{{ var.id }}' ({{ state_id }})
{# An escapable literal, not `r#"…"#`: the raw form ends at the first `"#` the
   author's XML carries — `href="#top"` is enough — and no escape exists inside
   it. `register_template` escapes the value for this one (`literal_text`). #}
        if let Err(e) = se.set_variable_as_dom(&sid, "{{ var.id }}", "{{ var.content }}") {
            ::sce_rust_runtime::sce_log_error!("Failed to set DOM variable '{{ var.id }}' in {{ state_id }}: {}", e);
{% if raise_error and 'error.execution' in model.events %}
            engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id }}'> XML content could not be parsed"));
{% endif %}
        }
{% else %}
        // W3C SCXML B.2: Inline content for '{{ var.id }}' ({{ state_id }}, eval with string fallback)
        if let Err(e) = sce_rust_runtime::helpers::datamodel_init::eval_or_set_string(
            se, &sid, "{{ var.id }}",
            "{{ var.content | to_lua_data_content | escape_rust }}",
            "{{ var.content | normalize_ws | escape_rust }}") {
            ::sce_rust_runtime::sce_log_error!("Failed to init '{{ var.id }}' in {{ state_id }}: {}", e);
{% if raise_error and 'error.execution' in model.events %}
            engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id }}'> content failed to initialise"));
{% endif %}
        }
{% endif %}
{% elif var.type == 'runtime' %}
        // W3C SCXML 5.2: Runtime variable '{{ var.id }}' ({{ state_id }}, late binding, init to nil)
        let _ = se.set_variable(&sid, "{{ var.id }}", sce_rust_runtime::ScriptValue::Null);
{% endif %}
{% endmacro %}

{# Macro: Declare one top-level datamodel variable at the start (§scxml-6.4,
   docs/adr/0098). A value the invoking session handed under its id is its
   initial value, in place of its own: the `<data>`'s expr, src or content is
   then not evaluated, raises nothing and has no effect. A handed value the
   session cannot hold is the error of this `<data>`'s initialization, as a
   failing expr of its own would be. Every other `<data>` takes its own value.
   Expects `handed` (the `HandedValues` the start took) in scope, beside
   `se`, `sid` and `engine`.
   Parameters as for `initialize_variable`. #}
{% macro declare_top_level_variable(var, machine_name, model) %}
        // §scxml-6.4: '{{ var.id }}' takes the value its invoke handed under its id, if one did
        if let Some(value) = handed.take("{{ var.id | escape_rust }}") {
            if let Err(e) = se.set_variable(&sid, "{{ var.id | escape_rust }}", value) {
                ::sce_rust_runtime::sce_log_error!("<data id='{{ var.id | escape_rust }}'> could not hold the value its invoke handed it: {}", e);
{% if 'error.execution' in model.events %}
                engine.raise(sce_rust_runtime::EventWithMetadata::platform_error({{ machine_name }}Event::{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id | escape_rust }}'> could not hold the value its invoke handed it"));
{% endif %}
            }
        } else {
{{ initialize_variable(var, 'global', true, machine_name, model) }}
        }
{% endmacro %}

{# Macro: Initialize all datamodel variables for a state #}
{% macro initialize_state_datamodel(state, state_id, raise_error, machine_name, model) %}
{% for var in state.datamodel %}
{{ initialize_variable(var, state_id, raise_error, machine_name, model) }}
{% endfor %}
{% endmacro %}
