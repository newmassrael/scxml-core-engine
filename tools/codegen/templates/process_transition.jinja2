{#
    Transition Selection Template (Jinja2)

    What the generated policy knows and the engine does not: which of a
    state's transitions an event enables, and what each transition's content
    is. Everything else Appendix D does with a transition — the walk from each
    atomic state up through its ancestors, the ordered set, conflict removal,
    the exit set, the entry set — is written once, in StaticExecutionEngine,
    over the structure state_machine_inl.jinja2 emits.

    It used to be written here as well, in two shapes: machines with a
    `<parallel>` collected, resolved and ran their own microstep here, while
    every other machine moved `currentState` here and let the engine walk an
    LCA. The two disagreed about eventless selection (one never looked above
    the atomic state, the other looked at every active state without
    walking), about the order transition content runs in, and about how many
    targets a transition has — both kept only the first.

    Generates:
    - bindCurrentEvent(event, engine)            §scxml-5.10 `_event` for the guards
    - firstEnabledTransition(state, event, engine)  the per-state half of selection
    - executeTransitionActions(source, index, engine)
    - deliverReadyParentSends(engine)            §scxml-6.4.2 delayed sends to #_parent
#}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}
{%- import '_macros/cpp_entry_target.jinja2' as et %}

{# The guard a transition is taken under, in the one form this machine can
   evaluate it: a host C++ expression, a pure In() predicate, a natively
   lowered typed-payload comparison, the script engine, or a value decided at
   build time. #}
{% macro guard_expr(trans) -%}
{%- if trans.is_cpp_condition -%}{{ trans.cond_cpp_transformed }}
{%- elif trans.is_pure_in_predicate -%}{{ trans.cond_cpp }}
{%- elif trans.native_payload_guard -%}{{ trans.native_payload_guard }}
{%- elif model.needs_script_engine -%}this->safeEvaluateGuard(scriptEngine, sessionId_.value(), {{ trans.cond | to_script_source_guard }}, engine)
{%- else -%}{{ 'true' if trans.cond_constant else 'false' }}
{%- endif -%}
{%- endmacro %}

{# Whether `trans` answers `event`: an eventless transition only an eventless
   selection, a transition with an event descriptor only a named event —
   §scxml-3.13 selects the two kinds in separate passes. #}
{% macro event_match(trans) -%}
{%- if not trans.event -%}event == Event::NONE
{%- elif trans.needs_string_matching -%}event != Event::NONE && ::SCE::Core::EventMatchingHelper::matchesEventDescriptor({{ model.name }}Policy::getEventName(event), "{{ trans.event }}")
{%- elif trans.matching_enum_values | length > 0 -%}{% for ev in trans.matching_enum_values %}event == Event::{{ ev | replace('.', '_') | replace('-', '_') | capitalize }}{{ ' || ' if not loop.last }}{% endfor %}
{%- else -%}false
{%- endif -%}
{%- endmacro %}

{# SCE Protocol-Synthesis RFC §synth-5-O — function-scope SCE-MAP markers:
   each function this template emits opens with its own `source_marker`, and
   its `#line` directive remaps the line positions of that function's body,
   so per-function attribution stays coherent across the translation unit. -#}
public:
    {{ sce_map.source_marker(model.source_location, "cpp", symbol_artifact=sce_artifact.machine) }}
    // §scxml-5.10: the event whose transitions are about to be selected is the
    // `_event` their guards read — bound before the first guard runs, and not
    // for an eventless selection, which has no event of its own.
    template <typename Engine>
    void bindCurrentEvent([[maybe_unused]] Event event, [[maybe_unused]] Engine& engine) {
{%- if model.needs_script_engine %}
        this->ensureScriptEngine();
{%- endif %}
{%- if model.needs_event_name or model.needs_event_type %}
        if (event != Event()) {
{% if model.needs_event_name %}
            pendingEventName_ = {{ model.name }}Policy::getEventName(event);
{% endif %}
{% if model.needs_event_type %}
            pendingEventType_ = this->getEventType(pendingEventName_);
{% endif %}
            AOT_DEBUG("AOT bindCurrentEvent: pendingEventName='{}', pendingEventType='{}'", pendingEventName_, pendingEventType_);
        }
{%- endif %}
{%- if model.needs_script_engine and (model.needs_event_name or model.needs_event_data or model.needs_event_origin) %}
        if (event != Event() && (!pendingEventName_.empty() || !pendingEventData_.empty() || !pendingEventOrigin_.empty())) {
            // §scxml-B-2-8-1: the rung the payload got, handed to the engine
            // rather than dropped. This is the only frame that has both the
            // reading and the event it belongs to.
{% if model.needs_event_data %}
            const ::SCE::PayloadReading payloadReading = setCurrentEventInScriptEngine(pendingEventName_, pendingEventData_, pendingEventType_, pendingEventSendId_, pendingEventOrigin_, pendingEventOriginType_, pendingEventInvokeId_, pendingEventTypedData_);
{% else %}
            const ::SCE::PayloadReading payloadReading = setCurrentEventInScriptEngine(pendingEventName_, pendingEventData_, pendingEventType_, pendingEventSendId_, pendingEventOrigin_, pendingEventOriginType_, pendingEventInvokeId_);
{% endif %}
            engine.notePayloadReading(event, payloadReading);
        }
{%- endif %}
    }

    {{ sce_map.source_marker(model.source_location, "cpp", symbol_artifact=sce_artifact.machine) }}
    // Appendix D selectTransitions, the half only this document can answer:
    // the first of `state`'s own transitions, in document order, that `event`
    // enables. The engine walks the atomic states and their ancestors and
    // keeps the ordered set. `Event::NONE` asks for eventless transitions.
    template <typename Engine>
    [[gnu::hot]]
    ::std::optional<TransitionInfo> firstEnabledTransition([[maybe_unused]] State state, [[maybe_unused]] Event event,
                                                          [[maybe_unused]] Engine& engine) {
        switch (state) {
{% for state_id, state in model.states | dictsort %}
{% if state.transitions %}
        case State::{{ state_id | capitalize }}:
{% for trans in state.transitions %}
            if ({{ event_match(trans) }}) {
{% if trans.cond %}
{% if model.needs_script_engine and not trans.is_cpp_condition and not trans.is_pure_in_predicate and not trans.native_payload_guard %}
                this->ensureScriptEngine();
                [[maybe_unused]] auto& scriptEngine = getScriptEngine();
{% endif %}
                if ({{ guard_expr(trans) }}) {
{% else %}
                {
{% endif %}
                    AOT_DEBUG("AOT firstEnabledTransition: {{ state_id }} transition {{ trans.transition_index }} is enabled");
                    return TransitionInfo{State::{{ state_id | capitalize }},
                                          { {%- for t in trans.targets %}{{ et.entry_target(t, model.history_states) }}{{ ", " if not loop.last }}{% endfor -%} },
                                          {{ trans.transition_index }}, {{ 'true' if trans.actions else 'false' }},
                                          {{ 'true' if trans.type == 'internal' else 'false' }}};
                }
            }
{% endfor %}
            return ::std::nullopt;
{% endif %}
{% endfor %}
        default:
            return ::std::nullopt;
        }
    }

    {{ sce_map.source_marker(model.source_location, "cpp", symbol_artifact=sce_artifact.machine) }}
    // W3C SCXML 3.13: a transition's executable content, run by the engine
    // between the microstep's exits and its entries.
    template <typename Engine>
    void executeTransitionActions([[maybe_unused]] State source, [[maybe_unused]] int transitionIndex,
                                  [[maybe_unused]] Engine& engine) {
{% if model.has_transition_actions %}
        switch (source) {
{% for state_id, state in model.states | dictsort %}
{% if state.transitions | selectattr('actions') | list %}
        case State::{{ state_id | capitalize }}:
            switch (transitionIndex) {
{% for trans in state.transitions %}
{% if trans.actions %}
            case {{ trans.transition_index }}:
{{ annot.annotation_block(trans, "cpp", "                ") }}{% if trans.source_location %}
                {{ sce_map.source_marker(trans.source_location, "cpp", stmt_level=true, symbol_state=trans.symbol_state_path, symbol_artifact=trans.symbol_artifact) | trim }}
{% endif %}
                {
                    AOT_DEBUG("AOT executeTransitionActions: {{ state_id }} transition {{ trans.transition_index }}");
{% if model.needs_script_engine %}
                    this->ensureScriptEngine();
                    [[maybe_unused]] auto& scriptEngine = getScriptEngine();
{% endif %}
{% for action in trans.actions %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "cpp", "                    ") -}}
{%- endif %}
{% include 'actions/' + action.type + '.jinja2' %}
{% endfor %}
                }
                break;
{% endif %}
{% endfor %}
            default:
                break;
            }
            break;
{% endif %}
{% endfor %}
        default:
            break;
        }
{% else %}
        // W3C SCXML 3.13: no transition in this document has content.
{% endif %}
    }

    {{ sce_map.source_marker(model.source_location, "cpp", symbol_artifact=sce_artifact.machine) }}
    // W3C SCXML 6.4.2: delayed sends to the parent that have come due. The
    // engine calls this after every selection, microstep or not.
    // SCE_MESH.md §9.6: gated on needs_parent_template — remote invoke workers
    // emit `<send target="#_parent">` through performMeshSend instead.
    //
    // §scxml-6.2.2: due is judged against the engine's clock, the same one
    // the deadline was armed from — a queue that read its own would answer
    // a different question on a host that owns time.
    template <typename Engine>
    void deliverReadyParentSends([[maybe_unused]] Engine& engine) {
{% if model.needs_parent_template %}
        typename ParentStateMachine::Event readyEvent;
        std::string readyEventData;
        while (parentSendScheduler_.popReadyEvent(engine.nowMs(), readyEvent, readyEventData)) {
            AOT_DEBUG("Delivering delayed send to parent");
            parent_->raiseExternal(readyEvent);
        }
{% endif %}
    }
