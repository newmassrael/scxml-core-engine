    template <typename Engine>
    // W3C SCXML 3.13: Always non-static (uses lastTransitionSourceState_ via tryTransitionInState)
    [[gnu::hot]]
    bool processTransition(State& currentState, [[maybe_unused]] Event event, [[maybe_unused]] Engine& engine) {
{%- if model.needs_script_engine %}
        // W3C SCXML 5.3: Ensure JSEngine initialized (lazy init for runtime operations)
        // Note: Datamodel initialization happens in StaticExecutionEngine::initialize()
        this->ensureScriptEngine();
{%- endif %}
{# W3C SCXML 5.10: Event data for scheduled events handled via EventWithMetadata #}
{# scheduledEventData_ map retrieval removed - engine.tick() passes eventData through raiseExternal() #}
{%- if model.needs_event_name or model.needs_event_type %}


        // W3C SCXML 5.10: Store event name and type for _event.name and _event.type binding
        if (event != Event()) {  // Skip for eventless transitions
{% if model.needs_event_name %}
            pendingEventName_ = {{ model.name }}Policy::getEventName(event);
{% endif %}
{% if model.needs_event_type %}
            pendingEventType_ = this->getEventType(pendingEventName_);
{% endif %}
            AOT_DEBUG("AOT processTransition: Set pendingEventName='{}', pendingEventType='{}'", pendingEventName_, pendingEventType_);
        }
{%- endif %}
{%- if model.needs_script_engine and (model.needs_event_name or model.needs_event_data or model.needs_event_origin) %}


        // W3C SCXML 5.10: Set _event variable in JSEngine
        // Only set _event when processing actual events, not during eventless transition checks
        if (event != Event() && (!pendingEventName_.empty() || !pendingEventData_.empty() || !pendingEventOrigin_.empty())) {
            AOT_DEBUG("AOT processTransition: Setting _event (name='{}', data='{}', type='{}', sendId='{}', origin='{}', invokeId='{}')",
                      pendingEventName_, pendingEventData_, pendingEventType_, pendingEventSendId_, pendingEventOrigin_, pendingEventInvokeId_);
{% if model.needs_event_data %}
            setCurrentEventInScriptEngine(pendingEventName_, pendingEventData_, pendingEventType_, pendingEventSendId_, pendingEventOrigin_, pendingEventOriginType_, pendingEventInvokeId_, pendingEventTypedData_);
{% else %}
            setCurrentEventInScriptEngine(pendingEventName_, pendingEventData_, pendingEventType_, pendingEventSendId_, pendingEventOrigin_, pendingEventOriginType_, pendingEventInvokeId_);
{% endif %}
        }
{%- endif %}

        AOT_DEBUG("AOT processTransition: Called with event={}, currentState={}", static_cast<int>(event), static_cast<int>(currentState));
        bool transitionTaken = false;

{% if model.has_parallel_states %}
        // W3C SCXML 3.4 + 3.12 + Appendix D: Parallel state transition handling
        // activeStates_ contains all currently active states (parallel regions have multiple)
        AOT_DEBUG("AOT processTransition: Checking {} active states", activeStates_.size());

        // W3C SCXML Appendix D.2: Different handling for eventless vs external events
        if (event == Event()) {
            // ==================== EVENTLESS TRANSITIONS: Collection → Execution ====================
            // W3C SCXML Appendix D: Collect ALL enabled transitions before executing (optimal transition set)

            ::std::vector<TransitionInfo> enabledTransitions;
            ::std::vector<State> statesToCheck = activeStates_;

            // Sort by document order for consistent processing
            ::std::sort(statesToCheck.begin(), statesToCheck.end(),
                       [](State a, State b) {
                           return getDocumentOrder(a) < getDocumentOrder(b);
                       });
            AOT_DEBUG("AOT processTransition: Collecting eventless transitions from {} active states", statesToCheck.size());

            // W3C SCXML Appendix D Step 1: Collect all enabled eventless transitions (optimal transition set)
            for (State activeState : statesToCheck) {
                // W3C SCXML 3.13: Eventless transitions CAN originate from ANY active state
                // Unlike external events (which require atomic states), eventless transitions
                // are checked on atomic, compound, and parallel states
                // Preemption rule still applies: transitions in child states preempt parent states
                AOT_DEBUG("AOT processTransition: Checking eventless transition in state {} (compound={}, parallel={})",
                         static_cast<int>(activeState), isCompoundState(activeState), isParallelState(activeState));

                // W3C SCXML 3.13: Eventless transitions do NOT bubble to parent states
                // Only check the current active state (not hierarchy)
                tryTransitionInState(activeState, event, currentState, transitionTaken, engine, &enabledTransitions);
            }

            AOT_DEBUG("AOT processTransition: Collected {} enabled eventless transitions", enabledTransitions.size());

            // W3C SCXML Appendix D.2: Remove conflicting transitions (optimal transition set)
            if (!enabledTransitions.empty()) {
                enabledTransitions = removeConflictingTransitions(enabledTransitions);
                AOT_DEBUG("AOT processTransition: After conflict resolution: {} transitions", enabledTransitions.size());
            }

            // W3C SCXML Appendix D Steps 2-5: Execute as atomic microstep (exit → transition → enter)
            if (!enabledTransitions.empty()) {
                executeMicrostep(enabledTransitions, currentState, transitionTaken, engine);
            }
        } else {
            // ==================== EXTERNAL EVENTS: Collection → Execution ====================
            // W3C SCXML Appendix D: For parallel states, ALL events use microstep (not just eventless)
            // Collect ALL enabled transitions before executing (optimal transition set)

            ::std::vector<TransitionInfo> enabledTransitions;

#ifndef NDEBUG
            // Debug: Check activeStates_ for duplicates
            AOT_DEBUG("AOT processTransition: activeStates_ contains {} states", activeStates_.size());
            for (State s : activeStates_) {
                AOT_DEBUG("AOT processTransition: activeStates_ entry: {}", static_cast<int>(s));
            }
#endif

            // W3C SCXML 3.13: Collect transitions from ALL active states (optimal transition set)
            // IMPORTANT: Only check atomic states for normal events (W3C SCXML 3.13: "optimally enabled by E in an atomic state in C")
            // EXCEPTION: done.state events MUST be checked on parallel/compound states (W3C SCXML 3.13 test570)
            // Atomic state = neither compound nor parallel
            for (State activeState : activeStates_) {
                bool isNonAtomic = isCompoundState(activeState) || isParallelState(activeState);
                
                // W3C SCXML 3.13: Check if this is a done.state event
                // done.state events are generated when parallel/compound states complete
                bool isDoneStateEvent = (event != Event::NONE) &&
                    std::string_view({{ model.name }}Policy::getEventName(event)).starts_with("done.state.");
                
                // Skip non-atomic states UNLESS processing done.state event
                if (isNonAtomic && !isDoneStateEvent) {
                    AOT_DEBUG("AOT processTransition: Skipping non-atomic state {} (compound={}, parallel={}) for non-done.state event",
                              static_cast<int>(activeState), isCompoundState(activeState), isParallelState(activeState));
                    continue;
                }

                if (isNonAtomic) {
                    AOT_DEBUG("AOT processTransition: Checking done.state event in non-atomic state {} (compound={}, parallel={})",
                              static_cast<int>(activeState), isCompoundState(activeState), isParallelState(activeState));
                } else {
                    AOT_DEBUG("AOT processTransition: Checking external event in atomic state {}", static_cast<int>(activeState));
                }

                State checkState = activeState;

                // W3C SCXML 3.12: Hierarchical event bubbling (innermost to outermost)
                // Check from current active state up through parent hierarchy
                while (true) {
                    // Try to find a matching transition in checkState (collection mode)
                    bool foundTransition = tryTransitionInState(checkState, event, currentState, transitionTaken, engine, &enabledTransitions);

                    if (foundTransition) {
                        AOT_DEBUG("AOT processTransition: Found transition in state {}", static_cast<int>(checkState));
                        break;  // Transition collected, exit hierarchy check for THIS active state
                    }

                    // W3C SCXML 3.12: Move to parent state for hierarchical event bubbling
                    auto parent = {{ model.name }}Policy::getParent(checkState);
                    if (!parent.has_value()) {
                        // Reached root, no more parents to check
                        break;
                    }

                    AOT_DEBUG("AOT processTransition: No transition in state {}, checking parent state {}",
                              static_cast<int>(checkState), static_cast<int>(parent.value()));
                    checkState = parent.value();
                }

                // W3C SCXML 3.13: Continue checking other active states (parallel regions)
                // Preemption rule applies within each atomic state's hierarchy, not globally
            }

            AOT_DEBUG("AOT processTransition: Collected {} enabled external transitions", enabledTransitions.size());

            // W3C SCXML Appendix D.2: Remove conflicting transitions (optimal transition set)
            if (!enabledTransitions.empty()) {
                enabledTransitions = removeConflictingTransitions(enabledTransitions);
                AOT_DEBUG("AOT processTransition: After conflict resolution: {} transitions", enabledTransitions.size());
            }

            // W3C SCXML Appendix D Steps 2-5: Execute as atomic microstep (exit → transition → enter)
            if (!enabledTransitions.empty()) {
                executeMicrostep(enabledTransitions, currentState, transitionTaken, engine);
            }
        }
{% else %}
{% if model.has_hierarchy %}
        // W3C SCXML 3.12: Hierarchical event processing (innermost to outermost)
        // Check transitions from current state up through parent hierarchy
        State checkState = currentState;

        while (true) {
            // Try to find a matching transition in checkState
            bool foundTransition = tryTransitionInState(checkState, event, currentState, transitionTaken, engine);

            if (foundTransition) SCE_LIKELY {
                break;  // Transition taken, exit hierarchy check
            }

            // W3C SCXML 3.13: Eventless transitions do NOT bubble to parent states
            if (event == Event()) SCE_UNLIKELY {
                break;
            }

            // W3C SCXML 3.12: Move to parent state for hierarchical event bubbling (external events only)
            auto parent = {{ model.name }}Policy::getParent(checkState);
            if (!parent.has_value()) SCE_UNLIKELY {
                break;
            }

            AOT_DEBUG("AOT processTransition: No transition in state {}, checking parent state {}",
                      static_cast<int>(checkState), static_cast<int>(parent.value()));
            checkState = parent.value();
        }
{% else %}
        // Flat state machine: no hierarchy, direct transition check
        tryTransitionInState(currentState, event, currentState, transitionTaken, engine);
{% endif %}
{% endif %}

{% if model.needs_parent_template %}
        // W3C SCXML 6.4.5: Process ready delayed sends to parent
        // ARCHITECTURE.md Zero Duplication: Uses SendSchedulingHelper (Single Source of Truth)
        // SCE_MESH.md §9.6: Gated on needs_parent_template — remote invoke workers
        // emit `<send target="#_parent">` through performMeshSend (no parentSendScheduler_).
        {
            typename ParentStateMachine::Event readyEvent;
            while (parentSendScheduler_.popReadyEvent(readyEvent)) {
                AOT_DEBUG("Delivering delayed send to parent");
                parent_->raiseExternal(readyEvent);
            }
        }

{% endif %}
        {# W3C SCXML 6.2: Scheduled event polling handled by StaticExecutionEngine::tick() #}
        {# Policy-level polling removed - engine.tick() properly polls scheduler_ and calls raiseExternal() #}

        return transitionTaken;
    }

private:
{% if model.has_parallel_states %}
    {% include 'conflict_resolution.jinja2' %}

    // W3C SCXML Appendix D.2: Execute microstep with proper ordering
    // ARCHITECTURE.MD: Zero Duplication Principle - Uses ParallelTransitionHelper (Single Source of Truth)
    // Exit all → Transition content all → Enter all
    {{ sce_map.source_marker(model.source_location, "cpp") }}
    template <typename Engine>
    void executeMicrostep(const ::std::vector<TransitionInfo>& transitions,
                         [[maybe_unused]] State& currentState,
                         bool& transitionTaken,
                         Engine& engine) {
        if (transitions.empty()) {
            return;
        }

        AOT_DEBUG("AOT executeMicrostep: Executing {} transitions as atomic microstep", transitions.size());

        // Convert TransitionInfo to ParallelTransitionHelper::Transition
        ::std::vector<::SCE::Core::ParallelTransitionHelper::Transition<State>> helperTransitions;
        helperTransitions.reserve(transitions.size());  // Pre-allocate capacity
        // W3C SCXML Appendix D: Construct transitions directly in vector to avoid GCC -Warray-bounds false positive
        for (const auto& trans : transitions) {
            helperTransitions.emplace_back(
                trans.source,
                ::std::vector<State>{trans.target},
                trans.transitionIndex,
                trans.hasActions,
                trans.isInternal,
                trans.isTargetless
            );
        }

        // W3C SCXML Appendix D.2 Step 1 & 2: Compute and exit states (Helper)
        auto statesToExit = ::SCE::Core::ParallelTransitionHelper::computeStatesToExit<State, {{ model.name }}Policy>(
            helperTransitions, activeStates_
        );

        AOT_DEBUG("AOT executeMicrostep: Exiting {} states in reverse document order", statesToExit.size());

        ::std::vector<State> activeStatesSnapshot = activeStates_;  // For history tracking
        for (State state : statesToExit) {
            AOT_DEBUG("AOT executeMicrostep: Exiting state {}", static_cast<int>(state));
            {{ model.name }}Policy::executeExitActions(state, engine, activeStatesSnapshot);
            
            // Remove from activeStates_
            activeStates_.erase(
                ::std::remove(activeStates_.begin(), activeStates_.end(), state),
                activeStates_.end()
            );
        }

        // W3C SCXML Appendix D.2 Step 3: Execute transition content in document order (Helper)
        auto sortedBySource = ::SCE::Core::ParallelTransitionHelper::sortTransitionsBySource<State, {{ model.name }}Policy>(
            helperTransitions
        );

        AOT_DEBUG("AOT executeMicrostep: Executing {} transition contents in document order", sortedBySource.size());

        for (const auto& trans : sortedBySource) {
            if (trans.hasActions) {
                AOT_DEBUG("AOT executeMicrostep: Transition {} -> {} (index {}, hasActions={})",
                         static_cast<int>(trans.source), static_cast<int>(trans.targets[0]), 
                         trans.transitionIndex, trans.hasActions);
                
                // Store transition info for executeTransitionActions()
                lastTransitionSourceState_ = trans.source;
{% if model.has_transition_actions %}
                lastTransitionIndex_ = trans.transitionIndex;
                hasTransitionActions_ = true;
{% endif %}
                executeTransitionActions(engine);
{% if model.has_transition_actions %}
                hasTransitionActions_ = false;
{% endif %}
            }
        }

        // W3C SCXML Appendix D.2 Step 4-5: Enter target states with hierarchical entry (Helper)
        auto sortedByTarget = ::SCE::Core::ParallelTransitionHelper::sortTransitionsByTarget<State, {{ model.name }}Policy>(
            helperTransitions
        );

        AOT_DEBUG("AOT executeMicrostep: Entering {} target states in document order", sortedByTarget.size());

        for (const auto& trans : sortedByTarget) {
            if (!trans.targets.empty()) {
                State target = trans.targets[0];

                // W3C SCXML 5.9.2: Targetless internal transitions (consumes event only, no exit/enter)
                // Actions already executed above, skip state entry (no state change)
                if (trans.isTargetless) {
                    AOT_DEBUG("AOT executeMicrostep: Targetless internal transition {} (actions executed, no state change)", static_cast<int>(trans.source));
                    continue;  // Skip entry for targetless transition
                }

                AOT_DEBUG("AOT executeMicrostep: Building hierarchical entry chain for target {}", static_cast<int>(target));
                
                // W3C SCXML 3.13: Build hierarchical entry chain from root to target
                // This ensures parallel parents are re-entered with all their regions
                auto entryChain = ::SCE::Core::HierarchicalStateHelper<{{ model.name }}Policy>::buildEntryChain(target);
                
                for (State state : entryChain) {
                    // Skip if already active (parallel states may have entered this via recursive entry)
                    bool alreadyActive = false;
                    for (State s : activeStates_) {
                        if (s == state) {
                            alreadyActive = true;
                            break;
                        }
                    }
                    if (alreadyActive) {
                        // W3C SCXML 3.13: Internal transitions - parallel state already active
                        // Skip onentry actions, but still enter all parallel regions (they may have been exited)
                        if (isParallelState(state)) {
                            AOT_DEBUG("AOT executeMicrostep: Parallel state {} already active, re-entering regions", static_cast<int>(state));
                            auto regions = getParallelRegions(state);
                            for (const auto& region : regions) {
                                // Check if region needs re-entry (may have been exited by transition)
                                bool regionActive = false;
                                for (State s : activeStates_) {
                                    if (s == region) {
                                        regionActive = true;
                                        break;
                                    }
                                }
                                if (!regionActive) {
                                    AOT_DEBUG("AOT executeMicrostep: Re-entering parallel region {}", static_cast<int>(region));
                                    executeEntryActions(region, engine);
                                    
                                    // W3C SCXML 3.3: If region is compound, enter initial child
                                    if (isCompoundState(region)) {
                                        State initialChild = getInitialChild(region);
                                        if (initialChild != region) {
                                            AOT_DEBUG("AOT executeMicrostep: Entering initial child {} of region {}",
                                                     static_cast<int>(initialChild), static_cast<int>(region));
                                            executeEntryActions(initialChild, engine);
                                        }
                                    }
                                }
                            }
                        } else {
                            AOT_DEBUG("AOT executeMicrostep: State {} already active, skipping entry", static_cast<int>(state));
                        }
                        continue;
                    }
                    
                    AOT_DEBUG("AOT executeMicrostep: Hierarchical entry for state {}", static_cast<int>(state));
                    executeEntryActions(state, engine);
                }

                // W3C SCXML 3.4: For transitions within parallel states, maintain currentState at parallel level
                // In parallel states, multiple regions are active - currentState should be the parallel state context
                State finalState = target;
                auto parentOpt = {{ model.name }}Policy::getParent(target);
                if (parentOpt.has_value()) {
                    State parent = parentOpt.value();
                    if ({{ model.name }}Policy::isParallelState(parent)) {
                        // Target is a child of a parallel state, set currentState to the parallel state
                        finalState = parent;
                        AOT_DEBUG("AOT executeMicrostep: Target {} is child of parallel state {}, setting currentState to parallel",
                                  static_cast<int>(target), static_cast<int>(parent));
                    }
                }
                currentState = finalState;  // Update to deepest entered state (or parallel state if within parallel)
            }
        }

        transitionTaken = true;
        AOT_DEBUG("AOT executeMicrostep: Microstep completed, activeStates count={}", activeStates_.size());
    }
{% endif %}

