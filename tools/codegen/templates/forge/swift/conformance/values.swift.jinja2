{# The values a fragment builds from the oracle, shared by the fragments that
   build one: an algorithm's arguments and answers, and a union fixture's
   values. Imported as a module (`{% import "values.swift.jinja2" as values %}`),
   so each is spelled once. Every scalar goes through the typed oracle readers of
   the scaffold. #}
{# A value of the enum fixture `document`, read from the oracle's `raw`, which holds
   the name a variant declares: the variant of that name. `label` names the value
   in a failure. #}
{% macro enum_value(document, variants, raw, label) %}try { () throws -> {{ document | to_pascal_case }} in switch try oracleText({{ raw }}) { {% for v in variants %}case "{{ v.name }}": return {{ document | to_pascal_case }}.{{ v.ident }}; {% endfor %}default: throw OracleError(description: "{{ label }}: no variant is declared as the name the case writes") } }(){% endmacro %}
{# A record's field, read from the oracle as the struct holds it. A field that holds
   a value of an enum is the enum fixture's own type, which the oracle writes as
   the name a variant declares: the value is the variant of that name, built the
   same way for an expected value and compared as the enum. #}
{% macro field_value(fld, raw, fixture) %}{% if fld.enum_document is defined %}{{ enum_value(fld.enum_document, fld.variants, raw, fixture ~ "." ~ fld.name) }}{% else %}{{ raw | swift_unmarshal(fld.type) }}{% endif %}{% endmacro %}
{# A value of the union `u` (docs/adr/0092), read from the oracle's `raw`, which
   holds the wire's object: the tag under its key, beside the fields of its case
   (section 2). The value is the case of the unit's enum the tag names, holding
   the payload struct of that case's record built with its memberwise
   initializer, or the case alone where it holds none. #}
{% macro union_value(u, raw, label) %}try { () throws -> {{ u.type_name }} in switch try oracleText({{ raw }}.member("{{ u.tag }}")) { {% for c in u.cases %}case "{{ c.variant }}": return {{ u.type_name }}.{{ c.ident }}{% if c.record %}({{ c.record.record | to_pascal_case }}Payload({% for fld in c.record.fields %}{{ fld.ident }}: {{ field_value(fld, raw ~ ".member(\"" ~ fld.name ~ "\")", label) }}{{ ", " if not loop.last }}{% endfor %})){% endif %}; {% endfor %}default: throw OracleError(description: "{{ label }}: no case is the variant the value's tag names") } }(){% endmacro %}
