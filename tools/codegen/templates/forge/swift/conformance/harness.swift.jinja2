// MARK: - The oracle

/// Why a value of the oracle could not be read as the type a call takes. A defect of the
/// oracle or of the manifest, never of the unit under test, and it fails the test that
/// read it.
private struct OracleError: Error, CustomStringConvertible {
    let description: String
}

/// The oracle, read once from the repository this file lies under.
private let oracle: JSONValue = {
    // <root>/backends/swift/tests/Tests/StaticDatamodelTests/NumericalConformanceTests.swift
    var url = URL(fileURLWithPath: #filePath)
    for _ in 0..<6 {
        url.deleteLastPathComponent()
    }
    let path = url.appendingPathComponent("tests/forge/conformance/numerical_reference.json").path
    do {
        return try parseJSON(String(contentsOfFile: path, encoding: .utf8))
    } catch {
        fatalError("the numerical oracle is not readable at \(path): \(error)")
    }
}()

/// The largest difference two reals may have and still be the same value.
private let tolerance: Double = {
    guard case .number(let text)? = oracle.member("float_tolerance"), let value = Double(text) else {
        fatalError("the oracle states no float_tolerance")
    }
    return value
}()

/// The cases the oracle holds for fixture `name` of `section`.
private func oracleCases(_ section: String, _ name: String) throws -> [JSONValue] {
    guard case .array(let cases)? = oracle.member(section)?.member(name)?.member("cases") else {
        throw OracleError(description: "the oracle holds no cases for \(section).\(name)")
    }
    return cases
}

/// The entry the oracle holds for fixture `name` of `section`, for a kind that reads a
/// sequence or a list of variants and not a list of cases.
private func oracleSpec(_ section: String, _ name: String) throws -> JSONValue {
    guard let spec = oracle.member(section)?.member(name) else {
        throw OracleError(description: "the oracle holds no entry for \(section).\(name)")
    }
    return spec
}

/// The text a number was written in, for a comparison that must not pass through a type.
private func oracleNumberText(_ value: JSONValue?) throws -> String {
    guard case .number(let text)? = value else {
        throw OracleError(description: "a number was expected, not \(String(describing: value))")
    }
    return text
}

private func oracleArray(_ value: JSONValue?) throws -> [JSONValue] {
    guard case .array(let items)? = value else {
        throw OracleError(description: "an array was expected, not \(String(describing: value))")
    }
    return items
}

/// An integer, read from the text the number was written in so the whole range of a
/// 64-bit type round-trips.
private func oracleInteger<T: FixedWidthInteger>(_ value: JSONValue?, as: T.Type) throws -> T {
    guard case .number(let text)? = value, let integer = T(text) else {
        throw OracleError(description: "a \(T.self) was expected, not \(String(describing: value))")
    }
    return integer
}

private func oracleReal(_ value: JSONValue?) throws -> Double {
    guard case .number(let text)? = value, let real = Double(text) else {
        throw OracleError(description: "a real was expected, not \(String(describing: value))")
    }
    return real
}

private func oracleTruth(_ value: JSONValue?) throws -> Bool {
    guard case .bool(let truth)? = value else {
        throw OracleError(description: "a truth value was expected, not \(String(describing: value))")
    }
    return truth
}

private func oracleText(_ value: JSONValue?) throws -> String {
    guard case .text(let text)? = value else {
        throw OracleError(description: "a text was expected, not \(String(describing: value))")
    }
    return text
}

/// A byte string, written in the oracle as an array of integers.
private func oracleBytes(_ value: JSONValue?) throws -> [UInt8] {
    try oracleArray(value).map { try oracleInteger($0, as: UInt8.self) }
}

private func expectClose(_ actual: Double, _ expected: Double, _ label: String) {
    #expect(abs(actual - expected) <= tolerance, "\(label): actual=\(actual) expected=\(expected) tol=\(tolerance)")
}

