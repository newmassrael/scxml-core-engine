{# Codec kind: round-trip { decoded, encoded } cases of the oracle. The unit is a struct with a
   memberwise initializer, `encode(into:)` over a sink and `decode(_:)` over a cursor, so each
   case builds the value from its decoded fields, encodes it and holds the bytes to the oracle's,
   then decodes those bytes and holds the value to the one it started from. The cursor must have
   moved past exactly the frame: a decode that read too little or too much is a different frame.

   A fixture whose fields the oracle cannot express (`oracle_eligible` false) is held to the
   compiler alone: the unit's own type is named, which is what the generated file is imported for. #}
{% if not f.oracle_eligible %}
    // Compile-only probe: the oracle holds no case this fixture's field shape can express.
{% if f.cbor %}
    // A map has no fixed length; the type is named by the initializer every codec offers.
    _ = {{ f.name | to_pascal_case }}()
{% else %}
    _ = {{ f.name | to_pascal_case }}.frameLength
{% endif %}
{% else %}
    let cases = try oracleCases("{{ f.ref_section }}", "{{ f.name }}")
    #expect(!cases.isEmpty, "{{ f.name }}: the oracle holds no case")
    for (index, testCase) in cases.enumerated() {
        let decoded = try #require(testCase.member("decoded"), "{{ f.name }} case \(index) has no decoded value")
        let expectedBytes = try oracleBytes(testCase.member("encoded"))

        {# A codec printed from its plan (docs/adr/0081 step 5) holds no element its encode derives
           (§3), so the value is made without it and the decode gives none back, and holds each
           byte string and text in the bounded type it declares, made through its one door. #}
        let value = {{ f.name | to_pascal_case }}(
{% for field in f.fields if not (f.printed and field.derived) %}
{% if f.printed and field.bounded %}
{% set bounded = ("BoundedText" if field.type == "string" else "BoundedBytes") ~ "<" ~ (f.name | to_pascal_case) ~ "." ~ (field.name | to_pascal_case) ~ "Bound>" %}
{% if field.optional %}
            {{ field.name }}: try oracleOptional(decoded.member("{{ field.name }}")) { try #require({{ bounded }}({{ "$0" | swift_unmarshal(field.type) }})) }{{ "," if not loop.last }}
{% else %}
            {{ field.name }}: try #require({{ bounded }}({{ ("decoded.member(\"" ~ field.name ~ "\")") | swift_unmarshal(field.type) }})){{ "," if not loop.last }}
{% endif %}
{% elif field.optional %}
            {{ field.name }}: try oracleOptional(decoded.member("{{ field.name }}")) { {{ "$0" | swift_unmarshal(field.type) }} }{{ "," if not loop.last }}
{% else %}
            {{ field.name }}: {{ ("decoded.member(\"" ~ field.name ~ "\")") | swift_unmarshal(field.type) }}{{ "," if not loop.last }}
{% endif %}
{% endfor %}
        )

        {# A case marked `decode_only` is a wire a peer may send that is not the one this encode
           writes (a VLE padded past its minimal encoding): its bytes decode to the value and are read
           whole, and the encode is not held to them. #}
        var decodeOnly = false
        if case .bool(let flag)? = testCase.member("decode_only") {
            decodeOnly = flag
        }
        if !decodeOnly {
            var sink = BytesSink()
            try value.encode(into: &sink)
            #expect(sink.bytes == expectedBytes, "{{ f.name }} case \(index) encode")
        }

        var cursor = SceCursor(expectedBytes)
        let roundTripped = try {{ f.name | to_pascal_case }}.decode(&cursor)
        #expect(roundTripped == value, "{{ f.name }} case \(index) decode")
        #expect(cursor.remaining == 0, "{{ f.name }} case \(index) decode consumed the frame and nothing else")
    }
{% endif %}

{# Byte cases stated as the codec's interface presents the value (docs/adr/0081 §5), folded only for
   a codec the Swift printer prints from its plan: each `source` is a value its initializer makes,
   written by the case printer from the codec's plan, and its bytes were computed by an independent
   model. The value is encoded through `encodeSource` and compared with the bytes (law 4 of
   docs/adr/0058 §5), and the bytes are decoded and what the decode presents compared with the value,
   element by element (law 1). Independent of `oracle_eligible`, which speaks of the catalog's fields. #}
{% for s in f.sources %}
    do {
{% for b in s.bindings %}
        {{ b }}
{% endfor %}
        let value = {{ s.literal }}
        var sink = BytesSink()
        try {{ f.name | to_pascal_case }}.encodeSource(value, into: &sink{% for v in s.encode_inputs %}, {{ v }}{% endfor %})
        let expected: [UInt8] = [{{ s.encoded | join(", ") }}]
        #expect(sink.bytes == expected, "{{ f.name }} source {{ loop.index0 }}: {{ s.note }}")
        var cursor = SceCursor(sink.bytes)
        let decoded = try {{ f.name | to_pascal_case }}.decode(&cursor{% for v in s.inputs %}, {{ v }}{% endfor %})
        #expect(cursor.remaining == 0, "{{ f.name }} source {{ loop.index0 }}: the decode left bytes of the frame unread")
{% for c in s.checks %}
        #expect({{ c.holds }}, "{{ f.name }} source {{ loop.index0 }}: the decode presents another {{ c.element }}")
{% endfor %}
{% if not s.checks %}
        _ = decoded
{% endif %}
    }
{% endfor %}

{# Refused cases (docs/adr/0081 §5): a value of the codec's interface whose encode the page says
   refuses it (docs/adr/0065 §2), made as a `sources` value is, and `symbol` the case of the
   runtime's typed `CodecError` the encode throws. The encode refuses before its first byte, so the
   sink is left empty. Independent of `oracle_eligible`, as the sources are. #}
{% for r in f.refused %}
    do {
{% for b in r.bindings %}
        {{ b }}
{% endfor %}
        let value = {{ r.literal }}
        var sink = BytesSink()
        #expect(throws: {{ r.symbol }}, "{{ f.name }} refused {{ loop.index0 }}: the encode did not answer {{ r.error }}: {{ r.note }}") {
            try {{ f.name | to_pascal_case }}.encodeSource(value, into: &sink{% for v in r.encode_inputs %}, {{ v }}{% endfor %})
        }
        #expect(sink.bytes.isEmpty, "{{ f.name }} refused {{ loop.index0 }}: the encode wrote bytes before it refused")
    }
{% endfor %}

{# Decode-rejection vectors (RFC synth-5-B): wire this codec MUST refuse, each paired with the failure
   it must refuse with. Independent of `oracle_eligible`, since a vector carries no field values. The
   decode throws the runtime's typed `CodecError` (docs/adr/0099: a refusal is not a value), so the
   vector holds it to the very case `r.symbol` names, and a refused decode to having consumed
   nothing. #}
{% for r in f.rejects %}
    do {
        var rejectCursor = SceCursor([{{ r.encoded | join(", ") }}])
        #expect(throws: {{ r.symbol }}, "{{ f.name }} reject {{ loop.index0 }}: {{ r.why }}") {
            try {{ f.name | to_pascal_case }}.decode(&rejectCursor)
        }
        #expect(rejectCursor.remaining == {{ r.encoded | length }}, "{{ f.name }} reject {{ loop.index0 }}: the refused decode moved the cursor")
    }
{% endfor %}
