/// The test suite `{{ suite_name }}` (docs/SCE_TEST_PROFILE.md §11.8) as the runner reads it
/// (`{{ runtime }}.runSuite`), the member of a caseless enum of the module as every unit's are.
public enum {{ struct_name }} {
    /// The suite: each module parameter at its default, held as the saved value of its declared
    /// type, and each `<sce:execute>` in run order, with its test case, its guard in microseconds
    /// and the selection that runs it in a world of the suite's features.
    public static func suite() -> {{ runtime }}.Suite {
{% if parameters %}
        var moduleParameters = {{ runtime }}.ModuleParameters()
{% for parameter in parameters %}
        moduleParameters.set({{ parameter.id }}, {{ parameter.value }})
{% endfor %}
{% else %}
        let moduleParameters = {{ runtime }}.ModuleParameters()
{% endif %}
        return {{ runtime }}.Suite(
            name: {{ name_literal }},
            moduleParameters: moduleParameters,
{% if executes %}
            executes: [
{% for execute in executes %}
                {{ runtime }}.Execute(
                    {{ execute.test_case }},
                    guardAt: {{ execute.guard }},
                    selection: {{ execute.selection }}),
{% endfor %}
            ])
{% else %}
            executes: [])
{% endif %}
    }
}
