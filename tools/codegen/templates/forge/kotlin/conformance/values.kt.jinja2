{# The values a fragment builds from the oracle's JSON, shared by the fragments
   that build one: an algorithm's arguments and answers, and a union fixture's
   values. Imported as a module (`{% import "values.kt.jinja2" as values %}`),
   so each is spelled once. Every type is named fully qualified, so a fragment
   needs no import of its own. #}
{# A value of the enum fixture `document`, read from the JSON `raw`, which holds the
   name a variant declares: the variant of that name. `label` names the value in a
   failure. #}
{% macro enum_value(document, variants, raw, label) %}when ({{ raw }}.jsonPrimitive.content) { {% for v in variants %}"{{ v.name }}" -> {{ document | kotlin_forge_package }}.{{ document | to_pascal_case }}.{{ v.ident }}; {% endfor %}else -> throw AssertionError("{{ label }}: no variant is declared as the name the case writes") }{% endmacro %}
{# A record's field, read from the JSON `raw` as the data class holds it. A
   field that holds a value of an enum is the enum fixture's own class, which
   the oracle writes as the name a variant declares: the value is the variant
   of that name, built the same way for an expected value and compared as the
   enum. #}
{% macro field_value(fld, raw, fixture) %}{% if fld.enum_document is defined %}{{ enum_value(fld.enum_document, fld.variants, raw, fixture ~ "." ~ fld.name) }}{% else %}{{ raw | kt_unmarshal(fld.type) }}{% endif %}{% endmacro %}
{# A value of the union `u` (docs/adr/0092), read from the JSON `raw`, which holds
   the wire's object: the tag under its key, beside the fields of its case
   (section 2). The value is the class of the case the tag names, nested in the
   unit's sealed interface, holding the record of that case built field by
   field, or the case's object where it holds none. #}
{% macro union_value(u, raw, label) %}when ({{ raw }}.jsonObject["{{ u.tag }}"]!!.jsonPrimitive.content) { {% for c in u.cases %}"{{ c.variant }}" -> {{ u.document | kotlin_forge_package }}.{{ u.type_name }}.{{ c.ident }}{% if c.record %}({{ c.record.record | kotlin_forge_package }}.{{ c.record.record | to_pascal_case }}Payload({% for fld in c.record.fields %}{{ fld.ident }} = {{ field_value(fld, raw ~ ".jsonObject[\"" ~ fld.name ~ "\"]!!", label) }}{% if not loop.last %}, {% endif %}{% endfor %})){% endif %}; {% endfor %}else -> throw AssertionError("{{ label }}: no case is the variant the value's tag names") }{% endmacro %}
