{# Content-line codec kind (SCE_FORGE.md §4.6.4) — { decoded, encoded } cases
   and reject vectors, as the generic codec fragment has them, with what a
   content-line component adds: an entry can be absent (`null`) or a list, a case
   marked `decode_only` is an input the codec reads and does not write, and a
   refused decode leaves the cursor where it found it. Kotlin names no failure
   (the null-sentinel convention), so a reject asserts refusal; the rule that
   refused is `ContentLine.lastError`, which `ContentLineCodecTest` pins.

   An entry that is an enum (docs/adr/0015) is written in a vector as its carrier
   number and held by the codec as the enum's own type. A decoded value is
   compared as the carrier's text (`toUnderlying().toString()`), which is what a
   JSON number's `content` is; a value written into the codec is taken from the
   number by the enum's `fromUnderlying`, which a closed enum answers `null` for a
   carrier it does not declare, so a closed enum is asserted non-null and an open
   one, whose conversion is total, is not. #}
{% macro lift(m, raw) -%}
{{ m.enum_document | to_pascal_case }}.fromUnderlying({{ raw | kt_unmarshal(m.type) }}){% if not m.enum_open %}!!{% endif %}
{%- endmacro %}
{% macro carrier_text(m, expr, optional) -%}
{{ expr }}{% if optional %}?{% endif %}.toUnderlying(){% if optional %}?{% endif %}.toString()
{%- endmacro %}
        val spec = ref["{{ f.ref_section }}"]!!.jsonObject["{{ f.name }}"]!!.jsonObject
        spec["cases"]!!.jsonArray.forEachIndexed { i, caseEl ->
            val decoded = caseEl.jsonObject["decoded"]!!.jsonObject
            val expectedBytes = caseEl.jsonObject["encoded"]!!.jsonArray
                .map { it.jsonPrimitive.int.toByte() }
                .toByteArray()
            caseEl.jsonObject["text"]?.takeIf { it !is kotlinx.serialization.json.JsonNull }?.let { text ->
                assertTrue(
                    text.jsonPrimitive.content.encodeToByteArray().contentEquals(expectedBytes),
                    "{{ f.name }} case $i: `text` and `encoded` disagree",
                )
            }
            val decodeOnly = caseEl.jsonObject["decode_only"]?.jsonPrimitive?.boolean ?: false

            val cursor = com.sce.forge.runtime.SceCursor(expectedBytes)
            val roundTripped = {{ f.name | to_pascal_case }}.decode(cursor)
                ?: error("{{ f.name }} case $i decode returned null")
{% for field in f.fields %}
{% if field.members %}
            // A list of line records (docs/adr/0014), as the vector writes each: an
            // object keyed by the parameter ids, then `value` or `values`.
            assertEquals(
                decoded["{{ field.name }}"]!!.jsonArray.map { r ->
                    r.jsonObject.mapValues { (_, v) ->
                        when (v) {
                            is kotlinx.serialization.json.JsonNull -> null
                            is kotlinx.serialization.json.JsonArray -> v.map { it.jsonPrimitive.content }
                            else -> v.jsonPrimitive.content
                        }
                    }
                },
                roundTripped.{{ field.name }}.map { r ->
                    mapOf(
{% for m in field.members %}
{% if m.enum_document and m.list %}
                        "{{ m.name }}" to r.{{ m.name }}.map { it.toUnderlying().toString() },
{% elif m.enum_document %}
                        "{{ m.name }}" to {{ carrier_text(m, "r." ~ m.name, m.optional) }},
{% else %}
                        "{{ m.name }}" to r.{{ m.name }},
{% endif %}
{% endfor %}
                    )
                },
                "{{ f.name }} case $i decode {{ field.name }}",
            )
{% elif field.list and field.enum_document %}
            assertEquals(
                decoded["{{ field.name }}"]!!.jsonArray.map { it.jsonPrimitive.content },
                roundTripped.{{ field.name }}.map { it.toUnderlying().toString() },
                "{{ f.name }} case $i decode {{ field.name }}",
            )
{% elif field.list %}
            assertEquals(
                decoded["{{ field.name }}"]!!.jsonArray.map { it.jsonPrimitive.content },
                roundTripped.{{ field.name }}.toList(),
                "{{ f.name }} case $i decode {{ field.name }}",
            )
{% elif field.enum_document %}
            assertEquals(
                decoded["{{ field.name }}"]!!.let { el ->
                    if (el is kotlinx.serialization.json.JsonNull) null else el.jsonPrimitive.content
                },
                {{ carrier_text(field, "roundTripped." ~ field.name, field.optional) }},
                "{{ f.name }} case $i decode {{ field.name }}",
            )
{% else %}
            assertEquals(
                decoded["{{ field.name }}"]!!.let { el ->
                    if (el is kotlinx.serialization.json.JsonNull) null else {{ 'el' | kt_unmarshal(field.type) }}
                },
                roundTripped.{{ field.name }},
                "{{ f.name }} case $i decode {{ field.name }}",
            )
{% endif %}
{% endfor %}

            if (!decodeOnly) {
                val valueObj = {{ f.name | to_pascal_case }}()
{% for field in f.fields %}
{% if field.members %}
                decoded["{{ field.name }}"]!!.jsonArray.forEach { r ->
                    val o = r.jsonObject
                    valueObj.{{ field.name }}.add(
                        {{ f.name | to_pascal_case }}{{ field.name | to_pascal_case }}Line(
{% for m in field.members %}
{% if m.enum_document and m.optional %}
                            {{ m.name }} = o["{{ m.name }}"]!!.let { el -> if (el is kotlinx.serialization.json.JsonNull) null else {{ lift(m, "el") }} },
{% elif m.enum_document %}
                            {{ m.name }} = {{ lift(m, 'o["' ~ m.name ~ '"]!!') }},
{% elif m.list %}
                            {{ m.name }} = o["{{ m.name }}"]!!.jsonArray.map { it.jsonPrimitive.content }.toMutableList(),
{% elif m.optional %}
                            {{ m.name }} = o["{{ m.name }}"]!!.let { el -> if (el is kotlinx.serialization.json.JsonNull) null else el.jsonPrimitive.content },
{% else %}
                            {{ m.name }} = o["{{ m.name }}"]!!.jsonPrimitive.content,
{% endif %}
{% endfor %}
                        ),
                    )
                }
{% elif field.list and field.enum_document %}
                valueObj.{{ field.name }}.addAll(decoded["{{ field.name }}"]!!.jsonArray.map { el -> {{ lift(field, "el") }} })
{% elif field.list %}
                valueObj.{{ field.name }}.addAll(decoded["{{ field.name }}"]!!.jsonArray.map { it.jsonPrimitive.content })
{% elif field.enum_document %}
                decoded["{{ field.name }}"]!!.let { el ->
                    if (el !is kotlinx.serialization.json.JsonNull) valueObj.{{ field.name }} = {{ lift(field, "el") }}
                }
{% else %}
                decoded["{{ field.name }}"]!!.let { el ->
                    if (el !is kotlinx.serialization.json.JsonNull) valueObj.{{ field.name }} = {{ 'el' | kt_unmarshal(field.type) }}
                }
{% endif %}
{% endfor %}
                val encoded = valueObj.encodeToByteArray()
                    ?: error("{{ f.name }} case $i encode refused")
                assertTrue(
                    encoded.contentEquals(expectedBytes),
                    "{{ f.name }} case $i encode: actual=${encoded.decodeToString()} expected=${expectedBytes.decodeToString()}",
                )
            }
        }

{# Decode-rejection vectors: the wire this codec MUST refuse, read from the
   reference like the cases are. They are not inlined as byte literals: this
   codec's vectors are whole components, and a test method holds 64 KB of
   bytecode — 77 literals of a few hundred bytes each pass it. A refusal leaves
   the cursor where it found it. #}
        spec["rejects"]!!.jsonArray.forEachIndexed { i, rejectEl ->
            val rejectBytes = rejectEl.jsonObject["encoded"]!!.jsonArray
                .map { it.jsonPrimitive.int.toByte() }
                .toByteArray()
            val rejectCursor = com.sce.forge.runtime.SceCursor(rejectBytes)
            val why = rejectEl.jsonObject["why"]!!.jsonPrimitive.content
            assertTrue(
                {{ f.name | to_pascal_case }}.decode(rejectCursor) == null,
                "{{ f.name }} reject $i: $why",
            )
            assertEquals(
                rejectBytes.size,
                rejectCursor.remaining(),
                "{{ f.name }} reject $i: the cursor moved",
            )
        }
