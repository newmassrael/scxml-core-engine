{# Codec kind — round-trip { decoded, encoded } cases. The Kotlin data
   class keeps the SCXML source case (camelCase) as-is, so field accesses
   use `{{ field.name }}` without a case filter. `decode` is on the
   companion object and takes a `com.sce.forge.runtime.SceCursor`;
   `encode` is an instance method returning ByteArray. #}
{% if not f.oracle_eligible %}
        // Compile-only probe: oracle_eligible=false because the fixture's
        // field shape isn't expressible in the current StructField /
        // CanonicalType schema (typed nested codec, nullable T?, or
        // parent-flag-bearing carrier). The fixture's import was already
        // resolved at module compile time; this no-arg constructor call
        // drags the data class's primary-constructor defaults through
        // kotlinc so the silently-broken-codegen regression class that
        // landed in commit 91ae355a (Kotlin embed default overwriting
        // <EmbedType>() with byteArrayOf()) surfaces here before
        // reaching consumers.
        run {
            val _codecVal = {{ f.name | to_pascal_case }}()
            @Suppress("UNUSED_VARIABLE")
            val _unused = _codecVal
        }
{% else %}
        val spec = ref["{{ f.ref_section }}"]!!.jsonObject["{{ f.name }}"]!!.jsonObject
        spec["cases"]!!.jsonArray.forEachIndexed { i, caseEl ->
{% if f.fields %}
            val decoded = caseEl.jsonObject["decoded"]!!.jsonObject
{% endif %}
{% for field in f.fields %}
{% if field.optional %}
            {# An absent entry is JSON `null` in the case and `null` in the class. #}
            val input{{ field.name | to_pascal_case }} = decoded["{{ field.name }}"]!!.let { el ->
                if (el is kotlinx.serialization.json.JsonNull) null else {{ 'el' | kt_unmarshal(field.type) }}
            }
{% else %}
            val input{{ field.name | to_pascal_case }} = {{ ('decoded["' ~ field.name ~ '"]!!') | kt_unmarshal(field.type) }}
{% endif %}
{% endfor %}
            val expectedBytes = caseEl.jsonObject["encoded"]!!.jsonArray
                .map { it.jsonPrimitive.int.toByte() }
                .toByteArray()
            {# A case marked `decode_only` is a wire a peer may send that is
               not the one this encode writes (a VLE padded past its minimal
               encoding): its bytes decode to the value and are read whole,
               and the encode is not held to them. #}
            val decodeOnly = caseEl.jsonObject["decode_only"]?.jsonPrimitive?.boolean ?: false

            if (!decodeOnly) {
                val valueObj = {{ f.name | to_pascal_case }}(
{% for field in f.fields %}
                    {{ field.name }} = input{{ field.name | to_pascal_case }}{% if not loop.last %},{% endif %}
{% endfor %}
                )
{% if f.cbor or f.encode_refuses_bound %}
                {# A CBOR encode (SCE_FORGE.md §4.6.1), and a binary one with a
                   bounded field (docs/adr/0077 §3), refuses a value past its
                   declared bound with `null`; every case is in bounds. #}
                val encoded = valueObj.encodeToByteArray()
                    ?: error("{{ f.name }} case $i encode refused")
{% else %}
                val encoded = valueObj.encodeToByteArray()
{% endif %}
                assertTrue(
                    encoded.contentEquals(expectedBytes),
                    "{{ f.name }} case $i encode: actual=${encoded.joinToString()} expected=${expectedBytes.joinToString()}",
                )
            }

            val cursor = com.sce.forge.runtime.SceCursor(expectedBytes)
            val roundTripped = {{ f.name | to_pascal_case }}.decode(cursor)
                ?: error("{{ f.name }} case $i decode returned null")
            assertTrue(
                !decodeOnly || cursor.remaining() == 0,
                "{{ f.name }} case $i: a decode-only frame is read whole",
            )
{% for field in f.fields %}
{% if field.type == "bytes" %}
            assertTrue(
                roundTripped.{{ field.name }}.contentEquals(input{{ field.name | to_pascal_case }}),
{% set q = '?' if field.optional else '' %}
                "{{ f.name }} case $i decode {{ field.name }}: actual_size=${roundTripped.{{ field.name }}{{ q }}.size} expected_size=${input{{ field.name | to_pascal_case }}{{ q }}.size}",
            )
{% else %}
            assertEquals(
                input{{ field.name | to_pascal_case }},
                roundTripped.{{ field.name }},
                "{{ f.name }} case $i decode {{ field.name }}",
            )
{% endif %}
{% endfor %}
        }
{% endif %}

{# RFC synth-5-B decode-rejection vectors — see the Rust fragment for the
   shape. Kotlin returns `null` for every failure, so the first assertion is
   that the decode refused. A refusal for a reason the cursor records (a
   bound's, docs/adr/0077 §4) is checked there as `r.cursor_record`, and a
   frame short of bytes is checked to record none. Byte literals go through
   `.toByte()` because Kotlin's Byte is signed and a header with the high bit
   set does not fit an unsuffixed literal. #}
{% for r in f.rejects %}
        run {
            val rejectBytes = byteArrayOf({% for b in r.encoded %}{{ b }}.toByte(){% if not loop.last %}, {% endif %}{% endfor %})
            val rejectCursor = com.sce.forge.runtime.SceCursor(rejectBytes)
            assertTrue(
                {{ f.name | to_pascal_case }}.decode(rejectCursor) == null,
                "{{ f.name }} reject {{ loop.index0 }}: {{ r.why }}",
            )
{% if r.cursor_record %}
            assertTrue(
                rejectCursor.lastRefusal == {{ r.cursor_record }},
                "{{ f.name }} reject {{ loop.index0 }} is refused as {{ r.error }}: {{ r.why }}",
            )
{% elif r.cursor_records_nothing %}
            assertTrue(
                rejectCursor.lastRefusal == null,
                "{{ f.name }} reject {{ loop.index0 }} is a frame short of bytes, not a refusal for a reason: {{ r.why }}",
            )
{% endif %}
{% if r.cursor_flag %}
            {# A reason the cursor keeps in a flag of its own (a VLE's value
               past its width, `lastVleOverflow`). #}
            assertTrue(
                rejectCursor.{{ r.cursor_flag }},
                "{{ f.name }} reject {{ loop.index0 }} is refused as {{ r.error }}: {{ r.why }}",
            )
{% endif %}
        }
{% endfor %}
