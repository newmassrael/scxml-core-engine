{# Codec kind — round-trip { decoded, encoded } cases. The Kotlin data
   class keeps the SCXML source case (camelCase) as-is, so field accesses
   use `{{ field.name }}` without a case filter. `decode` is on the
   companion object and takes a `com.sce.forge.runtime.SceCursor`;
   `encode` is an instance method returning ByteArray. #}
{% if not f.oracle_eligible %}
        // Compile-only probe: oracle_eligible=false because the fixture's
        // field shape isn't expressible in the current StructField /
        // CanonicalType schema (typed nested codec, nullable T?, or
        // parent-flag-bearing carrier). The fixture's import was already
        // resolved at module compile time; this no-arg constructor call
        // drags the data class's primary-constructor defaults through
        // kotlinc so the silently-broken-codegen regression class that
        // landed in commit 91ae355a (Kotlin embed default overwriting
        // <EmbedType>() with byteArrayOf()) surfaces here before
        // reaching consumers.
        run {
            val _codecVal = {{ f.name | to_pascal_case }}()
            @Suppress("UNUSED_VARIABLE")
            val _unused = _codecVal
        }
{% else %}
        val spec = ref["{{ f.ref_section }}"]!!.jsonObject["{{ f.name }}"]!!.jsonObject
        spec["cases"]!!.jsonArray.forEachIndexed { i, caseEl ->
{% if f.fields %}
            val decoded = caseEl.jsonObject["decoded"]!!.jsonObject
{% endif %}
{# A codec printed from its plan holds no element its encode derives
   (docs/adr/0081 §3): the value is made without it, and the decode gives
   none back. A byte string or a text it holds in the class of its bound
   (`field.refined`) is made through the class's checked factory, and read
   back out of the class. #}
{% for field in f.fields if not (f.printed and field.derived) %}
{% if field.optional %}
            {# An absent entry is JSON `null` in the case and `null` in the class. #}
            val input{{ field.name | to_pascal_case }} = decoded["{{ field.name }}"]!!.let { el ->
                if (el is kotlinx.serialization.json.JsonNull) null else {{ 'el' | kt_unmarshal(field.type) }}
            }
{% else %}
            val input{{ field.name | to_pascal_case }} = {{ ('decoded["' ~ field.name ~ '"]!!') | kt_unmarshal(field.type) }}
{% endif %}
{% endfor %}
            val expectedBytes = caseEl.jsonObject["encoded"]!!.jsonArray
                .map { it.jsonPrimitive.int.toByte() }
                .toByteArray()
            {# A case marked `decode_only` is a wire a peer may send that is
               not the one this encode writes (a VLE padded past its minimal
               encoding): its bytes decode to the value and are read whole,
               and the encode is not held to them. #}
            val decodeOnly = caseEl.jsonObject["decode_only"]?.jsonPrimitive?.boolean ?: false

            if (!decodeOnly) {
                val valueObj = {{ f.name | to_pascal_case }}(
{% for field in f.fields if not (f.printed and field.derived) %}
{% if field.refined and field.optional %}
                    {{ field.name }} = input{{ field.name | to_pascal_case }}?.let { {{ f.name | kotlin_forge_package }}.{{ field.refined }}.of(it)!! }{% if not loop.last %},{% endif %}
{% elif field.refined %}
                    {{ field.name }} = {{ f.name | kotlin_forge_package }}.{{ field.refined }}.of(input{{ field.name | to_pascal_case }})!!{% if not loop.last %},{% endif %}
{% else %}
                    {{ field.name }} = input{{ field.name | to_pascal_case }}{% if not loop.last %},{% endif %}
{% endif %}
{% endfor %}
                )
{% if f.cbor or f.encode_refuses_bound or (f.printed and f.encode_may_fail) %}
                {# A CBOR encode (SCE_FORGE.md §4.6.1), and a binary one with a
                   bounded field (docs/adr/0077 §3), refuses a value past its
                   declared bound with `null`, as an encode printed from its
                   plan refuses what its plan names (docs/adr/0081 §4); every
                   case is one a frame carries. #}
                val encoded = valueObj.encodeToByteArray()
                    ?: error("{{ f.name }} case $i encode refused")
{% else %}
                val encoded = valueObj.encodeToByteArray()
{% endif %}
                assertTrue(
                    encoded.contentEquals(expectedBytes),
                    "{{ f.name }} case $i encode: actual=${encoded.joinToString()} expected=${expectedBytes.joinToString()}",
                )
            }

            val cursor = com.sce.forge.runtime.SceCursor(expectedBytes)
            val roundTripped = {{ f.name | to_pascal_case }}.decode(cursor)
                .valueOr { refused -> error("{{ f.name }} case $i decode refused: ${refused.error}") }
            assertTrue(
                !decodeOnly || cursor.remaining() == 0,
                "{{ f.name }} case $i: a decode-only frame is read whole",
            )
{% for field in f.fields if not (f.printed and field.derived) %}
{% set q = '?' if field.optional else '' %}
{% if field.refined and field.type == "bytes" %}
{% set read = 'roundTripped.' ~ field.name ~ q ~ '.bytes' %}
{% elif field.refined %}
{% set read = 'roundTripped.' ~ field.name ~ q ~ '.text' %}
{% else %}
{% set read = 'roundTripped.' ~ field.name %}
{% endif %}
{% if field.type == "bytes" %}
            assertTrue(
                {{ read }}.contentEquals(input{{ field.name | to_pascal_case }}),
                "{{ f.name }} case $i decode {{ field.name }}: actual_size=${ {{- read }}{{ q }}.size} expected_size=${input{{ field.name | to_pascal_case }}{{ q }}.size}",
            )
{% else %}
            assertEquals(
                input{{ field.name | to_pascal_case }},
                {{ read }},
                "{{ f.name }} case $i decode {{ field.name }}",
            )
{% endif %}
{% endfor %}
        }
{% endif %}

{# Byte cases stated as the codec's interface presents the value
   (docs/adr/0081 §5), the same cases the Rust, C++ and Python fragments run,
   for a codec the Kotlin backend prints from its plan: each `source` is the
   printed data class, made by its constructor from the case, written by the
   generator from the codec's plan, and its bytes were computed by an
   independent model. The value is encoded by the companion's `encodeSource`
   and compared with the bytes (law 4 of docs/adr/0058 §5), and the bytes are
   decoded and what the decode presents compared with the value, element by
   element (law 1). Independent of `oracle_eligible`, which speaks of the
   `cases`. #}
{% for s in f.sources %}
        run {
            val value = {{ s.literal }}
            val sink = mutableListOf<Byte>()
            assertTrue(
                {{ f.name | to_pascal_case }}.encodeSource(value, com.sce.forge.runtime.MutableListSink(sink){% for i in s.encode_inputs %}, {{ i }}{% endfor %}) == null,
                "{{ f.name }} source {{ loop.index0 }}: the encode answered an error: {{ s.note }}",
            )
            val expected = byteArrayOf({% for b in s.encoded %}{{ b }}.toByte(){% if not loop.last %}, {% endif %}{% endfor %})
            assertTrue(
                sink.toByteArray().contentEquals(expected),
                "{{ f.name }} source {{ loop.index0 }}: actual=${sink.joinToString()} expected=${expected.joinToString()}: {{ s.note }}",
            )
            val cursor = com.sce.forge.runtime.SceCursor(expected)
{% if s.checks %}
            val decoded = {{ f.name | to_pascal_case }}.decode(cursor{% for i in s.inputs %}, {{ i }}{% endfor %})
                .valueOr { refused -> error("{{ f.name }} source {{ loop.index0 }}: decode refused as ${refused.error}: {{ s.note }}") }
{% else %}
            {# A codec that presents no element has nothing to compare. #}
            val read = {{ f.name | to_pascal_case }}.decode(cursor{% for i in s.inputs %}, {{ i }}{% endfor %})
            assertTrue(
                read is com.sce.forge.runtime.Decoded.Ok,
                "{{ f.name }} source {{ loop.index0 }}: decode refused as ${read.errorOrNull()}: {{ s.note }}",
            )
{% endif %}
            assertEquals(
                0,
                cursor.remaining(),
                "{{ f.name }} source {{ loop.index0 }}: the decode left bytes of the frame unread",
            )
{% for c in s.checks %}
            assertTrue(
                {{ c.holds }},
                "{{ f.name }} source {{ loop.index0 }}: the decode presents another {{ c.element }}",
            )
{% endfor %}
        }
{% endfor %}

{# Refused cases (docs/adr/0081 §5): each `source` is a value of the codec's
   interface its encode refuses, made as a source is, and the encode answers
   exactly the refusal the case names, the runtime's `CodecError` object,
   before it writes a byte, so the sink is left empty. #}
{% for r in f.refused %}
        run {
            val value = {{ r.literal }}
            val sink = mutableListOf<Byte>()
            val refused = {{ f.name | to_pascal_case }}.encodeSource(value, com.sce.forge.runtime.MutableListSink(sink){% for i in r.encode_inputs %}, {{ i }}{% endfor %})
            assertTrue(
                refused == {{ r.symbol }},
                "{{ f.name }} refused {{ loop.index0 }}: the encode answers {{ r.error }}, not $refused: {{ r.note }}",
            )
            assertEquals(
                0,
                sink.size,
                "{{ f.name }} refused {{ loop.index0 }}: the encode wrote bytes before it refused",
            )
        }
{% endfor %}

{# RFC synth-5-B decode-rejection vectors — see the Rust fragment for the
   shape. A Kotlin decode answers `Decoded.Refused` with the kind that refused
   the frame (docs/adr/0099, amendment of 2026-11-16), and `r.symbol` is that
   kind, so the vector asserts the kind and not only that the decode refused.
   Byte literals go through `.toByte()` because Kotlin's Byte is signed and a
   header with the high bit set does not fit an unsuffixed literal. #}
{% for r in f.rejects %}
        run {
            val rejectBytes = byteArrayOf({% for b in r.encoded %}{{ b }}.toByte(){% if not loop.last %}, {% endif %}{% endfor %})
            val rejectCursor = com.sce.forge.runtime.SceCursor(rejectBytes)
            assertEquals(
                com.sce.forge.runtime.Decoded.Refused(com.sce.forge.runtime.{{ r.symbol }}),
                {{ f.name | to_pascal_case }}.decode(rejectCursor),
                "{{ f.name }} reject {{ loop.index0 }} is refused as {{ r.error }}: {{ r.why }}",
            )
        }
{% endfor %}
