{# Enum kind — see the C++ fragment for why the oracle compares VALUES and
   keys on the source spelling; `v.ident` is the member the declaration
   emits. Kotlin carries the number in a `raw` property rather than as the
   constant itself, so the comparison goes through `.raw`. #}
        val spec = ref["{{ f.ref_section }}"]!!.jsonObject["{{ f.name }}"]!!.jsonObject
        val variants = spec["variants"]!!.jsonArray

        // Count first: a vocabulary that gained or lost a variant without the
        // manifest moving would otherwise satisfy every assertion below.
        assertEquals(
            {{ f.variants | length }},
            variants.size,
            "{{ f.name }}: oracle variant count",
        )

{% for v in f.variants %}
        assertEquals(
            "{{ v.name }}",
            variants[{{ loop.index0 }}].jsonObject["name"]!!.jsonPrimitive.content,
            "{{ f.name }} variant {{ loop.index0 }} name",
        )
        assertEquals(
            variants[{{ loop.index0 }}].jsonObject["value"]!!.jsonPrimitive.long,
            {{ f.name | to_pascal_case }}.{{ v.ident }}.raw.toLong(),
            "{{ f.name }}.{{ v.name }}",
        )
        // The name the declaration answers is the one the document wrote.
        assertEquals(
            "{{ v.name }}",
            {{ f.name | to_pascal_case }}.{{ v.ident }}.declaredName(),
            "{{ f.name }}.{{ v.name }} declared name",
        )
{% endfor %}
