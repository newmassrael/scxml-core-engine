{# Filter kind — stateful filter.update(input) over a fixed sequence. #}
        val spec = ref["{{ f.ref_section }}"]!!.jsonObject["{{ f.name }}"]!!.jsonObject
        val filter = {{ f.name | to_pascal_case }}()
        for ((i, step) in spec["sequence"]!!.jsonArray.withIndex()) {
            val input = {{ "step.jsonObject[\"input\"]!!" | kt_unmarshal(f.input) }}
            val expected = {{ "step.jsonObject[\"expected\"]!!" | kt_unmarshal(f.output["type"]) }}
            val actual = filter.update(input)
{% if f.output.compare == "tolerance" %}
            assertClose(actual, expected, "{{ f.name }} step $i input=$input")
{% else %}
            assertEquals(expected, actual, "{{ f.name }} step $i input=$input")
{% endif %}
        }
