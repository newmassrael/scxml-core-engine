{# Procedure kind — execute(handler, args) with payload capture + bytewise oracle. #}
        val cases = ref["{{ f.ref_section }}"]!!.jsonObject["{{ f.name }}"]!!.jsonObject["cases"]!!.jsonArray
        for (case in cases) {
            val args = case.jsonObject["args"]!!.jsonArray
{% for arg_ty in f.args %}
            val arg{{ loop.index0 }} = {{ ("args[" ~ loop.index0 ~ "]") | kt_unmarshal(arg_ty) }}
{% endfor %}
            val expected = case.jsonObject["expected"]!!.jsonObject
            val expectedCompleted = expected["completed"]!!.jsonPrimitive.boolean
            val expectedFinal = expected["final_state"]!!.jsonPrimitive.content
            val handlerResponseData = case.jsonObject["handler_response_data"]
                ?.jsonPrimitive?.content ?: ""
            val captured = mutableListOf<ByteArray>()
            val handler: com.sce.forge.runtime.procedure.ProcedureServiceHandler = { req ->
                req.payload?.let { captured.add(it) }
                com.sce.forge.runtime.procedure.ProcedureServiceResponse(success = true, data = handlerResponseData)
            }
{% for h in f.helpers_ordered %}
{% if h.stub.kind == "xor_bytes" %}
            // <sce:helper name="{{ h.name }}"> stub — XOR every byte with {{ h.stub.mask }}.
            val stub{{ h.name | to_pascal_case }}: (ByteArray) -> ByteArray = { input ->
                ByteArray(input.size) { i -> (input[i].toInt() xor {{ h.stub.mask }}).toByte() }
            }
{% endif %}
{% endfor %}
            val result: com.sce.forge.runtime.procedure.ProcedureRunResult = com.sce.generated.{{ f.name }}.execute(handler{% for h in f.helpers_ordered %}, stub{{ h.name | to_pascal_case }}{% endfor %}{% for arg_ty in f.args %}, arg{{ loop.index0 }}{% endfor %})
            assertEquals(expectedCompleted, result.completed, "{{ f.name }}.completed")
            assertEquals(expectedFinal, result.finalState, "{{ f.name }}.final_state")
            val expectedBytes: List<ByteArray> = expected["dispatched_payload_bytes"]
                ?.jsonArray
                ?.map { inner ->
                    inner.jsonArray.map { it.jsonPrimitive.int.toByte() }.toByteArray()
                }
                ?: emptyList()
            assertEquals(
                expectedBytes.size,
                captured.size,
                "{{ f.name }}.dispatched_payload_bytes count",
            )
            expectedBytes.zip(captured).forEachIndexed { i, (exp, act) ->
                assertContentEquals(exp, act, "{{ f.name }}.dispatched_payload_bytes[$i]")
            }
        }
