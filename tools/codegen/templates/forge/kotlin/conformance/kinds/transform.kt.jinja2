{# Transform kind — pure free function(s), single or compound output. #}
        val cases = ref["{{ f.ref_section }}"]!!.jsonObject["{{ f.name }}"]!!.jsonObject["cases"]!!.jsonArray
        for (case in cases) {
            val args = case.jsonObject["args"]!!.jsonArray
{% for arg_ty in f.args %}
            val arg{{ loop.index0 }} = {{ ("args[" ~ loop.index0 ~ "]") | kt_unmarshal(arg_ty) }}
{% endfor %}
{% if f.output %}
            val expected = case.jsonObject["expected"]!!.jsonPrimitive.double
            val actual = {{ f.output.function | to_camel_case }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
            assertClose(actual, expected, "{{ f.name }}")
{% else %}
            val expected = case.jsonObject["expected"]!!.jsonObject
{% for co in f.compound_outputs %}
            val expected_{{ co.key }} = {{ ("expected[\"" ~ co.key ~ "\"]!!") | kt_unmarshal(co["type"]) }}
            val actual_{{ co.key }} = {{ co.function | to_camel_case }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
{% if co.compare == "tolerance" %}
            assertClose(actual_{{ co.key }}, expected_{{ co.key }}, "{{ f.name }} {{ co.key }}")
{% else %}
            assertEquals(expected_{{ co.key }}, actual_{{ co.key }}, "{{ f.name }} {{ co.key }}")
{% endif %}
{% endfor %}
{% endif %}
        }
