{# Algorithm kind (RFC §synth-5-A) — single-output free function. Cross-language
   byte-equivalence acceptance gate (RFC §A6); Kotlin shipped post-A6
   alongside its byte-golden + matrix flip.

   Bytes args lower to `ByteArray` per RFC §synth-5-J-5. The oracle JSON
   represents each `bytes` argument as an array of integers
   (`[10, 20, 30]`); we materialise it via `kt_unmarshal`'s `bytes` arm
   which produces `ByteArray`. The function-under-test takes the
   ByteArray directly. Numeric scalar args route through `kt_unmarshal`'s
   per-type narrow-cast (`.toUShort()` etc.) so the call boundary types
   line up with the algorithm's signature. #}
        val cases = ref["{{ f.ref_section }}"]!!.jsonObject["{{ f.name }}"]!!.jsonObject["cases"]!!.jsonArray
        for (case in cases) {
            val args = case.jsonObject["args"]!!.jsonArray
{# A record argument or output (SCE_FORGE.md §4.12) is the event-schema's
   data class, named fully qualified so this fragment needs no import of
   its own; `fields` carries each field's Kotlin name, derived from the
   schema document when the harness renders. #}
{% for arg_ty in f.args %}
{% set i = loop.index0 %}
{% if arg_ty.record is defined %}
            val arg{{ i }} = com.sce.generated.{{ arg_ty.record }}.{{ arg_ty.record | to_pascal_case }}Payload(
{% for fld in arg_ty.fields %}
                {{ fld.ident }} = {{ ("args[" ~ i ~ "].jsonObject[\"" ~ fld.name ~ "\"]!!") | kt_unmarshal(fld.type) }},
{% endfor %}
            )
{% else %}
            val arg{{ i }} = {{ ("args[" ~ i ~ "]") | kt_unmarshal(arg_ty) }}
{% endif %}
{% endfor %}
{% if f.output.record is defined %}
            val actual = {{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
            val expected = case.jsonObject["expected"]!!.jsonObject
{% for fld in f.output.fields %}
            assertEquals({{ ("expected[\"" ~ fld.name ~ "\"]!!") | kt_unmarshal(fld.type) }}, actual.{{ fld.ident }}, "{{ f.name }}.{{ fld.name }}")
{% endfor %}
{% elif f.output.list_of is defined %}
{# A `list<T>` return (SCE_FORGE.md §4.12) is the element's primitive array
   (`LongArray`, `UIntArray`, ...). Both sides compare as `List<T>`, so
   one spelling serves every element type; an unsigned array is still an
   experimental type, hence the opt-in on the one local that holds it. #}
            val expected = case.jsonObject["expected"]!!.jsonArray.map { {{ "it" | kt_unmarshal(f.output.list_of) }} }
{% if f.output.list_of in ["u8", "u16", "u32", "u64"] %}
            @OptIn(ExperimentalUnsignedTypes::class)
{% endif %}
            val actual = {{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %}).toList()
{% if f.output.compare == "tolerance" %}
            assertEquals(expected.size, actual.size, "{{ f.name }} length")
            for (i in expected.indices) {
                assertClose(actual[i].toDouble(), expected[i].toDouble(), "{{ f.name }}")
            }
{% else %}
            assertEquals(expected, actual, "{{ f.name }}")
{% endif %}
{% else %}
            val expected = {{ "case.jsonObject[\"expected\"]!!" | kt_unmarshal(f.output.type) }}
            val actual = {{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
{% if f.output.compare == "tolerance" %}
            assertClose(actual.toDouble(), expected.toDouble(), "{{ f.name }}")
{% else %}
            assertEquals(expected, actual, "{{ f.name }}")
{% endif %}
{% endif %}
        }
