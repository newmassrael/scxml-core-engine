{# Timer kind — verify registration metadata and callback dispatch via recording mocks. #}
        val spec = ref["{{ f.ref_section }}"]!!.jsonObject["{{ f.name }}"]!!.jsonObject

        data class TimerReg(var type: String = "", var ms: Long = 0, var cb: (() -> Unit)? = null)
        class RecTimer : com.sce.forge.runtime.Timer {
            val reg = TimerReg()
            override fun startPeriodic(intervalMs: Long, callback: () -> Unit) { reg.type = "periodic"; reg.ms = intervalMs; reg.cb = callback }
            override fun startOneShot(delayMs: Long, callback: () -> Unit) { reg.type = "one_shot"; reg.ms = delayMs; reg.cb = callback }
            override fun cancel() {}
        }
        class RecHandler : {{ f.name | to_pascal_case }}Handler {
            var lastCall = ""
{% for t in f.timers %}
            override fun {{ t.callback | to_camel_case }}() { lastCall = "{{ t.callback }}" }
{% endfor %}
        }

        val handler = RecHandler()
{% for t in f.timers %}
        val timer{{ t.id | to_pascal_case }} = RecTimer()
{% endfor %}
        val scheduler = {{ f.name | to_pascal_case }}(
            handler{% for t in f.timers %}, timer{{ t.id | to_pascal_case }}{% endfor %})
{% for t in f.timers %}
        scheduler.start{{ t.id | to_pascal_case }}()
{% endfor %}

        val oracleTimers = spec["timers"]!!.jsonArray
{% for t in f.timers %}
        run {
            val ot = oracleTimers[{{ loop.index0 }}].jsonObject
            assertEquals(ot["type"]!!.jsonPrimitive.content, timer{{ t.id | to_pascal_case }}.reg.type, "{{ f.name }}: {{ t.id }} type")
            assertEquals(ot["interval_ms"]!!.jsonPrimitive.long, timer{{ t.id | to_pascal_case }}.reg.ms, "{{ f.name }}: {{ t.id }} interval")
            timer{{ t.id | to_pascal_case }}.reg.cb?.invoke()
            assertEquals(ot["callback"]!!.jsonPrimitive.content, handler.lastCall, "{{ f.name }}: {{ t.id }} callback")
        }
{% endfor %}
