impl{{ lifetime }} {{ struct_name }}{{ lifetime }} {
    /// The projection `try_into_owned_in` makes, with the profile's text and byte
    /// containers made from `{{ origin_param }}`, what the decoded bytes were taken
    /// from. A container that shares that buffer refers back to it instead of
    /// copying out of it; what the origin is, and what to do with a slice that
    /// does not come from it, is the profile's to say, field by field.
    ///
    /// Each string and byte string is held at its declared capacity, as in
    /// `try_into_owned_in`; every other entry is moved as that projection moves it.
    pub fn {{ owned_in_origin_fn }}{{ origin_generics_impl }}(self, {{ origin_param }}: {{ origin_ref_type }}) -> Result<{{ struct_name }}Owned{{ owned_generics_args }}, CodecError> {
