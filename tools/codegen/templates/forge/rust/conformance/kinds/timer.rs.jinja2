{# Timer kind — verify registration metadata and callback dispatch via recording mocks. #}
    let spec = &reference["{{ f.ref_section }}"]["{{ f.name }}"];
    let oracle_timers = spec["timers"].as_array().expect("timers must be array");

    use std::cell::RefCell;
    use std::ffi::c_void;

    struct Reg {
        timer_type: String,
        interval_ms: u32,
        cb: Option<sce_forge_runtime::timer::TimerCallback>,
        ctx: *mut c_void,
    }
    impl Default for Reg {
        fn default() -> Self { Self { timer_type: String::new(), interval_ms: 0, cb: None, ctx: std::ptr::null_mut() } }
    }
    struct RecTimer { reg: RefCell<Reg> }
    impl RecTimer { fn new() -> Self { Self { reg: RefCell::new(Reg::default()) } } }
    impl sce_forge_runtime::timer::Timer for RecTimer {
        fn start_periodic(&mut self, ms: u32, cb: sce_forge_runtime::timer::TimerCallback, ctx: *mut c_void) {
            *self.reg.borrow_mut() = Reg { timer_type: "periodic".into(), interval_ms: ms, cb: Some(cb), ctx };
        }
        fn start_one_shot(&mut self, ms: u32, cb: sce_forge_runtime::timer::TimerCallback, ctx: *mut c_void) {
            *self.reg.borrow_mut() = Reg { timer_type: "one_shot".into(), interval_ms: ms, cb: Some(cb), ctx };
        }
        fn cancel(&mut self) {}
    }
    struct RecHandler { last_call: RefCell<String> }
    impl RecHandler { fn new() -> Self { Self { last_call: RefCell::new(String::new()) } } }
    impl fixtures::{{ f.name }}::{{ f.name | to_pascal_case }}Handler for RecHandler {
{% for t in f.timers %}
        fn {{ t.callback | to_snake_case }}(&mut self) { *self.last_call.borrow_mut() = "{{ t.callback }}".into(); }
{% endfor %}
    }

