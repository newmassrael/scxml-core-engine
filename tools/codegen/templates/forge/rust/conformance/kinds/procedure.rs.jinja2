{# Procedure kind — execute(handler, args) with payload capture + bytewise oracle. #}
    let spec = &reference["{{ f.ref_section }}"]["{{ f.name }}"];
    for case in spec["cases"].as_array().expect("cases must be array") {
{% for arg_ty in f.args %}
        let arg{{ loop.index0 }} = {{ ("case[\"args\"][" ~ loop.index0 ~ "]") | rust_unmarshal(arg_ty) }};
{% endfor %}
        let expected_completed = case["expected"]["completed"]
            .as_bool()
            .expect("completed is bool");
        let expected_final = case["expected"]["final_state"]
            .as_str()
            .expect("final_state is string");
        // Optional per-case handler response bytes (string-typed on the wire;
        // the state machine byte-copies this into its `seed`-style internal
        // fields via `pending_event_data.as_bytes()` at assign time). When
        // absent, preserves the legacy empty-data behaviour.
        let handler_response_data = case
            .get("handler_response_data")
            .and_then(|v| v.as_str())
            .unwrap_or("")
            .to_string();
        let captured: std::rc::Rc<std::cell::RefCell<Vec<Vec<u8>>>> =
            std::rc::Rc::new(std::cell::RefCell::new(Vec::new()));
        let handler = {
            let captured = captured.clone();
            let data = handler_response_data.clone();
            move |req: &sce_forge_runtime::procedure::ProcedureServiceRequest| {
                if let Some(ref bytes) = req.payload {
                    captured.borrow_mut().push(bytes.clone());
                }
                sce_forge_runtime::procedure::ProcedureServiceResponse {
                    success: true,
                    data: data.clone(),
                }
            }
        };
{% for h in f.helpers_ordered %}
{% if h.stub.kind == "xor_bytes" %}
        // <sce:helper name="{{ h.name }}"> stub — XOR every byte with {{ h.stub.mask }}.
        let stub_{{ h.name | to_snake_case }} = |input: &[u8]| -> Vec<u8> {
            input.iter().map(|b| b ^ {{ h.stub.mask }}u8).collect()
        };
{% endif %}
{% endfor %}
        let result = fixtures::{{ f.name }}::execute(handler{% for h in f.helpers_ordered %}, stub_{{ h.name | to_snake_case }}{% endfor %}{% for arg_ty in f.args %}, arg{{ loop.index0 }}{% endfor %});
        assert_eq!(
            result.completed, expected_completed,
            "{{ f.name }}.completed"
        );
        assert_eq!(
            result.final_state.as_str(),
            expected_final,
            "{{ f.name }}.final_state"
        );
        let expected_bytes: Vec<Vec<u8>> = case["expected"]
            .get("dispatched_payload_bytes")
            .and_then(|v| v.as_array())
            .map(|arr| {
                arr.iter()
                    .map(|inner| {
                        inner
                            .as_array()
                            .expect("dispatched_payload_bytes inner must be array")
                            .iter()
                            .map(|b| b.as_u64().expect("byte must be u64") as u8)
                            .collect::<Vec<u8>>()
                    })
                    .collect()
            })
            .unwrap_or_default();
        let actual_bytes = captured.borrow().clone();
        assert_eq!(
            actual_bytes, expected_bytes,
            "{{ f.name }}.dispatched_payload_bytes"
        );
    }
