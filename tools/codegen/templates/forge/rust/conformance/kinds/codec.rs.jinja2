{# Codec kind — round-trip { decoded, encoded } cases. Each case binds the
   per-field oracle values under an `input_<field>` prefix, inlines the
   struct literal into the `encode()` call (so no intermediate variable can
   shadow a field name), then wraps `expected_bytes` in `SceCursor` and
   asserts the decoded value matches the input.

   Naming convention is shared with C++/Kotlin/Python codec fragments:
   `input_<field>` for oracle-derived values, `round_tripped` for the
   decoded struct. A codec fixture may declare any field name (including
   common words like `value`, `data`, `result`) without risk of colliding
   with the fragment's local bindings.

   `oracle_eligible: false` fixtures (typed nested struct fields, Option<T>,
   parent-flag-bearing carriers — shapes the StructField/CanonicalType
   schema cannot express) take the `else` branch: the fixture's `pub mod`
   above already pulled the golden into the translation unit, so this body
   only needs a Default::default() probe to drag the type's pub API
   (struct fields, encode, decode, new) through the type checker.
   Catches the silently-broken-codegen class of bug that motivated
   commit 91ae355a (Kotlin embed default + Go pointer/value mismatch).

   A codec whose list the protocol bounds by nothing has no eager form at the
   default profile (`f.grows`, docs/adr/0077 §7): the fragment names it at the
   growing profile, `{Name}In<Lent<'_, Heap>>`, as a type (`eager_ty`) and as a
   path to its functions (`eager`). #}
{% set pascal = f.name | to_pascal_case %}
{% if f.grows %}
{% set eager_ty = pascal ~ "In<::sce_forge_runtime::codec::Lent<'_, ::sce_forge_runtime::codec::Heap>>" %}
{% set eager = pascal ~ "In::<::sce_forge_runtime::codec::Lent<'_, ::sce_forge_runtime::codec::Heap>>" %}
{% else %}
{% set eager_ty = pascal %}
{% set eager = pascal %}
{% endif %}
{% if f.oracle_eligible %}
    let spec = &reference["{{ f.ref_section }}"]["{{ f.name }}"];
    for (i, case) in spec["cases"]
        .as_array()
        .expect("cases must be array")
        .iter()
        .enumerate()
    {
{% if f.fields %}
        let decoded = &case["decoded"];
{% for field in f.fields %}
{% if field.optional %}
        {# An absent entry is JSON `null` in the case and `None` in the struct. #}
        let input_{{ field.name | to_snake_case }} = if decoded["{{ field.name }}"].is_null() {
            None
        } else {
            Some({{ ('decoded["' ~ field.name ~ '"]') | rust_unmarshal(field.type) }})
        };
{% else %}
        let input_{{ field.name | to_snake_case }} = {{ ('decoded["' ~ field.name ~ '"]') | rust_unmarshal(field.type) }};
{% endif %}
{% endfor %}
{% endif %}
        let expected_bytes: Vec<u8> = case["encoded"]
            .as_array()
            .expect("encoded must be array")
            .iter()
            .map(|v| v.as_u64().expect("byte must be u64") as u8)
            .collect();

        let encoded = {{ f.name | to_pascal_case }} {
{% for field in f.fields %}
{% if field.bounded and field.optional %}
            {# A field held within its bound is made through the type's one
               door (docs/adr/0077 §3); every case is a value inside it. #}
            {{ field.name | to_snake_case }}: input_{{ field.name | to_snake_case }}.as_deref().map(|v| {
                ::sce_forge_runtime::codec::Bounded::new(v)
                    .unwrap_or_else(|| panic!("{{ f.name }} case {i}: {{ field.name }} is outside its bound"))
            }),
{% elif field.bounded and field.type == "bytes" %}
            {{ field.name | to_snake_case }}: ::sce_forge_runtime::codec::Bounded::new(input_{{ field.name | to_snake_case }}.as_slice())
                .unwrap_or_else(|| panic!("{{ f.name }} case {i}: {{ field.name }} is outside its bound")),
{% elif field.bounded %}
            {{ field.name | to_snake_case }}: ::sce_forge_runtime::codec::Bounded::new(input_{{ field.name | to_snake_case }})
                .unwrap_or_else(|| panic!("{{ f.name }} case {i}: {{ field.name }} is outside its bound")),
{% elif field.type == "bytes" and field.optional %}
            {{ field.name | to_snake_case }}: input_{{ field.name | to_snake_case }}.as_deref(),
{% elif field.type == "bytes" %}
            {# Borrowed zero-copy: the codec field is `&'a [u8]`, so bind a
               borrow of the owned oracle `Vec<u8>` (alive through the encode
               call) rather than an owned clone. #}
            {{ field.name | to_snake_case }}: input_{{ field.name | to_snake_case }}.as_slice(),
{% elif field.type == "string" %}
            {# `input_X` is already `&str` (unmarshalled via `Value::as_str`)
               and the codec field is `&'a str`, so bind it directly — a
               further `.as_str()` would hit the unstable `str::as_str`. #}
            {{ field.name | to_snake_case }}: input_{{ field.name | to_snake_case }},
{% else %}
            {{ field.name | to_snake_case }}: input_{{ field.name | to_snake_case }},
{% endif %}
{% endfor %}
        }
{% if f.encode_may_fail %}
        {# The document declares that its encode can refuse a value it cannot
           carry (docs/adr/0065), so `encode_to_vec` returns a Result; every
           case is a value the codec carries. #}
        .encode_to_vec()
        .unwrap_or_else(|e| panic!("{{ f.name }} case {i}: encode must succeed, refused with {e:?}"));
{% else %}
        {# An encode that refuses no value returns its bytes (docs/adr/0065). #}
        .encode_to_vec();
{% endif %}
        assert_eq!(
            encoded, expected_bytes,
            "{{ f.name }} case {i} encode"
        );

        let mut cursor = ::sce_forge_runtime::codec::SceCursor::new(&expected_bytes);
{% if f.fields %}
        let round_tripped = {{ f.name | to_pascal_case }}::decode(&mut cursor)
            .expect("{{ f.name }} decode must succeed");
{% for field in f.fields %}
{% if field.bounded and field.optional %}
        {# A field held within its bound compares with the slice or text it
           holds; an absent one is `None` on both sides. #}
        assert_eq!(
            round_tripped.{{ field.name | to_snake_case }}.map(|v| v.into_inner()),
            input_{{ field.name | to_snake_case }}.as_deref(),
            "{{ f.name }} case {i} decode {{ field.name }}"
        );
{% elif field.type == "bytes" %}
        assert_eq!(
            round_tripped.{{ field.name | to_snake_case }},
            input_{{ field.name | to_snake_case }}.{% if field.optional %}as_deref(){% else %}as_slice(){% endif %},
            "{{ f.name }} case {i} decode {{ field.name }}"
        );
{% elif field.type == "string" %}
        assert_eq!(
            round_tripped.{{ field.name | to_snake_case }},
            input_{{ field.name | to_snake_case }},
            "{{ f.name }} case {i} decode {{ field.name }}"
        );
{% else %}
        assert_eq!(
            round_tripped.{{ field.name | to_snake_case }},
            input_{{ field.name | to_snake_case }},
            "{{ f.name }} case {i} decode {{ field.name }}"
        );
{% endif %}
{% endfor %}
{% else %}
        // RFC §synth-5-B empty body — decode must succeed but there are
        // no fields to assert against. The decoded instance round-trips
        // back to the empty byte sequence (verified above via encode).
        {{ f.name | to_pascal_case }}::decode(&mut cursor)
            .expect("{{ f.name }} decode must succeed");
{% endif %}
    }
{% else %}
    // Compile-only probe: oracle_eligible=false because the fixture's
    // field shape isn't expressible in the current StructField /
    // CanonicalType schema (typed nested codec, Option<T>, or
    // parent-flag-bearing carrier). The `include!` in the harness
    // scaffold already proved the file parses + the module compiles.
    // Default::default() additionally drags the struct + encode + new
    // surface through the type checker so a future kotlinc/go-build
    // -class regression of commit 91ae355a's variety surfaces here
    // before reaching consumers.
    let _ = &reference;
    let _val: {{ eager_ty }} = {{ eager }}::default();
    let _val2: {{ eager_ty }} = {{ eager }}::new();
    let _ = (_val, _val2);
{% endif %}

{# Byte cases stated as the codec's interface presents the value
   (docs/adr/0081 §5): each `source` is a literal of the codec's ready-made
   source, written by the generator from the codec's plan, and its bytes were
   computed by an independent model. The literal is encoded and compared with
   the bytes (law 4 of docs/adr/0058 §5), and the bytes are decoded and what the
   decode presents compared with the literal, element by element and, for a
   body or a list, into each element of the codec it holds (law 1). The
   bindings name the bodies and entries the literal holds, which a temporary
   would not keep alive. Independent of `oracle_eligible`, which speaks of the
   builder's struct. #}
{% for s in f.sources %}
    {
{% for b in s.bindings %}
        {{ b }}
{% endfor %}
        let parts = {{ s.literal }};
        let mut encoded: Vec<u8> = Vec::new();
        fixtures::{{ f.name }}::{{ f.name | to_pascal_case }}Wire::encode_source(
            &parts,
            &mut ::sce_forge_runtime::codec::VecSink::new(&mut encoded),
        )
        .unwrap_or_else(|e| panic!("{{ f.name }} source {{ loop.index0 }}: encode refused with {e:?}"));
        {# Typed: an empty frame names no element to infer `u8` from. #}
        let expected: &[u8] = &[{{ s.encoded | join(", ") }}];
        assert_eq!(
            encoded.as_slice(),
            expected,
            "{{ f.name }} source {{ loop.index0 }}: {{ s.note }}"
        );
        let mut cursor = ::sce_forge_runtime::codec::SceCursor::new(&encoded);
        {# A value of no element is compared by its decode being accepted alone. #}
        {# The flag inputs the parent hands the decode, in declaration order. #}
        let {% if not s.checks %}_{% endif %}decoded = {{ eager }}::decode(&mut cursor{% for v in s.inputs %}, {{ v }}{% endfor %})
            .unwrap_or_else(|e| panic!("{{ f.name }} source {{ loop.index0 }}: decode refused with {e:?}"));
        assert_eq!(
            cursor.remaining(),
            0,
            "{{ f.name }} source {{ loop.index0 }}: the decode left bytes of the frame unread"
        );
{% for c in s.checks %}
        assert!(
            {{ c.holds }},
            "{{ f.name }} source {{ loop.index0 }}: the decode presents another {{ c.element }}"
        );
{% endfor %}
    }
{% endfor %}

{# Refused cases (docs/adr/0081 §5): each `source` is a value of the codec's
   interface its encode refuses (docs/adr/0065 §2), spelled as a `sources`
   literal is, and `symbol` the refusal the encode answers it with. The encode
   returns exactly that refusal, and it refuses before its first byte, so the
   sink is left empty. Independent of `oracle_eligible`, as the sources are. #}
{% for r in f.refused %}
    {
{% for b in r.bindings %}
        {{ b }}
{% endfor %}
        let parts = {{ r.literal }};
        let mut encoded: Vec<u8> = Vec::new();
        let refused = fixtures::{{ f.name }}::{{ f.name | to_pascal_case }}Wire::encode_source(
            &parts,
            &mut ::sce_forge_runtime::codec::VecSink::new(&mut encoded),
        );
        assert_eq!(
            refused,
            Err({{ r.symbol }}),
            "{{ f.name }} refused {{ loop.index0 }}: {{ r.note }}"
        );
        assert!(
            encoded.is_empty(),
            "{{ f.name }} refused {{ loop.index0 }}: the encode wrote bytes before it refused"
        );
    }
{% endfor %}

{# RFC synth-5-B decode-rejection vectors — wire this codec MUST refuse,
   paired with the failure it must refuse with. Independent of
   `oracle_eligible`: a reject vector carries no field values, so a codec
   whose field shape the StructField schema cannot express (every tlv-chain
   fixture in the catalog) can still pin exactly which wire it turns away.
   `r.symbol` is the backend's name for the failure; Rust has one, so the
   assertion is on the typed error and not merely on refusal. #}
{% for r in f.rejects %}
    {
        let wire: [u8; {{ r.encoded | length }}] = [{{ r.encoded | join(", ") }}];
        let mut cursor = ::sce_forge_runtime::codec::SceCursor::new(&wire);
        {# Bound before the match so a borrowed codec's temporary is dropped
           with this binding rather than at the end of the enclosing block,
           where `wire` is already gone. #}
        let outcome = {{ eager }}::decode(&mut cursor);
        match outcome {
            Ok(accepted) => panic!(
                "{{ f.name }} reject {{ loop.index0 }} ({{ r.why }}): decode returned Ok({accepted:?})"
            ),
            Err(refused) => assert_eq!(
                refused,
                ::sce_forge_runtime::codec::{{ r.symbol }},
                "{{ f.name }} reject {{ loop.index0 }}: {{ r.why }}"
            ),
        }
    }
{% endfor %}
