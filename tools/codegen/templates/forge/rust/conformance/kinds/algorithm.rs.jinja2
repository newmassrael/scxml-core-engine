{# Algorithm kind (RFC §synth-5-A) — single-output free function. Cross-(Rust,
   C11) byte-equivalence acceptance gate (RFC §A6). The Rust algorithm
   template emits `pub fn <name>(<param>: &[u8], ...) -> T`, so bytes
   args bind to a `Vec<u8>` from the oracle and pass `&arg<i>` at the
   call site; numeric args bind to their native Rust scalar.

   Single-output only — RFC §synth-5-A defines algorithms as one-return-value
   bodies. Compound outputs would require structuring the return type,
   which is Transform's territory.

   A `list<T>` return (SCE_FORGE.md §4.12) is written into the caller's
   `SceOwnedList<T, N>` and the call answers `Result<(), CapacityExceeded>`;
   the oracle's cases stay within N, so the harness unwraps it and compares
   the slice element by element. A `bytes` return is the same bounded storage
   (`SceBytes<N>`), its `expected` a JSON array of byte values.

   A record argument or output (SCE_FORGE.md §4.12) is the event-schema's
   payload struct, built from and compared against a JSON object keyed by
   the schema's field ids; `fields` carries each field's Rust identifier,
   derived from the schema document when the harness renders. A list of
   records is a JSON array of such objects.

   A `may-fail` algorithm (SCE_FORGE.md §3.4.1) returns `Result<T,
   AlgorithmError>`. A case that names a failure (`"fails": "overflow"`)
   carries no `expected`; it is judged by the error's contract name before
   anything reads `expected`, and every other case unwraps the value.

   A value of an enum as an argument is built from the name its variant
   declares, as a record's enum field is. An argument or an answer that may be
   absent (docs/adr/0055) is an `Option` over the value, `None` where the
   oracle writes `null`, and an optional answer is compared whole, so an absent
   answer equals only an absent one.

   A value of a union (docs/adr/0092) is the union's unit's enum, built from
   the wire's object the oracle writes: the case its tag names, holding that
   case's record. The values of a record's field, of an enum and of a union are
   built by `values.rs.jinja2`, which a union fixture's fragment builds its
   values by too. #}
{% import "values.rs.jinja2" as values %}
{# A value that may be absent, read from the oracle's JSON `raw`: `None` for `null`. #}
{% macro optional_value(raw, ty) %}if {{ raw }}.is_null() { None } else { Some({{ raw | rust_unmarshal(ty) }}) }{% endmacro %}
{# A list or bytes output is written into a destination the caller holds
   (docs/adr/0082): the call hands one in and, where the algorithm wrote it,
   yields it, so the call reads as `Result<the list, _>` as it did before. #}
{% set arguments %}{% for arg_ty in f.args %}{% if arg_ty == "bytes" or arg_ty.list_of is defined %}&arg{{ loop.index0 }}{% else %}arg{{ loop.index0 }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}{% endset %}
{% if f.output.list_of is defined or f.output.type == "bytes" %}
{% set call %}{ let mut sce_out = sce_portable_bytes::{% if f.output.type == "bytes" %}SceBytes{% else %}SceOwnedList{% endif %}::new(); let written = fixtures::{{ f.name }}::{{ f.function }}({{ arguments }}{% if f.args %}, {% endif %}&mut sce_out); written.map(|()| sce_out) }{% endset %}
{% else %}
{% set call %}fixtures::{{ f.name }}::{{ f.function }}({{ arguments }}){% endset %}
{% endif %}
{% if f.output.compare == "tolerance" %}
    let tol = tolerance(&reference);
{% endif %}
    let spec = &reference["{{ f.ref_section }}"]["{{ f.name }}"];
    for case in spec["cases"].as_array().expect("cases must be array") {
{% for arg_ty in f.args %}
{% set i = loop.index0 %}
{% if arg_ty.record is defined %}
        let arg{{ i }} = fixtures::{{ arg_ty.record }}::{{ arg_ty.record | to_pascal_case }}Payload {
{% for fld in arg_ty.fields %}
            {{ fld.ident }}: {{ values.field_value(fld, "case[\"args\"][" ~ i ~ "][\"" ~ fld.name ~ "\"]", f.name) }},
{% endfor %}
        };
{% elif arg_ty.list_of is defined and arg_ty.list_of.record is defined %}
{% set r = arg_ty.list_of %}
        let arg{{ i }}: Vec<fixtures::{{ r.record }}::{{ r.record | to_pascal_case }}Payload> = case["args"][{{ i }}]
            .as_array()
            .expect("a list argument is an array")
            .iter()
            .map(|x| fixtures::{{ r.record }}::{{ r.record | to_pascal_case }}Payload {
{% for fld in r.fields %}
                {{ fld.ident }}: {{ values.field_value(fld, "x[\"" ~ fld.name ~ "\"]", f.name) }},
{% endfor %}
            })
            .collect();
{% elif arg_ty.list_of is defined %}
        let arg{{ i }}: Vec<{{ arg_ty.list_of | rust_type }}> = case["args"][{{ i }}]
            .as_array()
            .expect("a list argument is an array")
            .iter()
            .map(|x| {{ "x" | rust_unmarshal(arg_ty.list_of) }})
            .collect();
{% elif arg_ty.enum is defined %}
        let arg{{ i }} = {{ values.enum_value(arg_ty.enum, arg_ty.variants, "case[\"args\"][" ~ i ~ "]", f.name ~ " arg" ~ i) }};
{% elif arg_ty.union is defined %}
        let arg{{ i }} = {{ values.union_value(arg_ty.shape, "case[\"args\"][" ~ i ~ "]", f.name ~ " arg" ~ i) }};
{% elif arg_ty.optional is defined %}
        let arg{{ i }}: Option<{{ arg_ty.optional | rust_type }}> = {{ optional_value("case[\"args\"][" ~ i ~ "]", arg_ty.optional) }};
{% else %}
        let arg{{ i }} = {{ ("case[\"args\"][" ~ i ~ "]") | rust_unmarshal(arg_ty) }};
{% endif %}
{% endfor %}
{% if f.may_fail %}
        let result = {{ call }};
        if let Some(kind) = case.get("fails").and_then(|v| v.as_str()) {
            let err = result.expect_err("{{ f.name }}: the case expects a failure");
            assert_eq!(err.contract_name(), kind, "{{ f.name }}");
            continue;
        }
        let actual = result.expect("{{ f.name }}: the case expects a value");
{% endif %}
{% if f.output.record is defined %}
{% if not f.may_fail %}
        let actual = {{ call }};
{% endif %}
{% for fld in f.output.fields %}
        assert_eq!(
            actual.{{ fld.ident }}{% if fld.type == "string" %}.as_str(){% endif %},
            {% if fld.enum_document is defined %}{{ values.field_value(fld, "case[\"expected\"][\"" ~ fld.name ~ "\"]", f.name) }}{% else %}{{ ("case[\"expected\"][\"" ~ fld.name ~ "\"]") | rust_unmarshal(fld.type) }}{% endif %},
            "{{ f.name }}.{{ fld.name }}"
        );
{% endfor %}
{% elif f.output.list_of is defined and f.output.list_of.record is defined %}
        let expected = case["expected"].as_array().expect("expected must be array");
{% if not f.may_fail %}
        let actual = {{ call }}
            .expect("{{ f.name }}: a case within the declared capacity");
{% endif %}
        let actual = actual.as_slice();
        assert_eq!(actual.len(), expected.len(), "{{ f.name }} length");
        for (a, e) in actual.iter().zip(expected.iter()) {
{% for fld in f.output.list_of.fields %}
            assert_eq!(
                a.{{ fld.ident }}{% if fld.type == "string" %}.as_str(){% endif %},
                {% if fld.enum_document is defined %}{{ values.field_value(fld, "e[\"" ~ fld.name ~ "\"]", f.name) }}{% else %}{{ ("e[\"" ~ fld.name ~ "\"]") | rust_unmarshal(fld.type) }}{% endif %},
                "{{ f.name }}.{{ fld.name }}"
            );
{% endfor %}
        }
{% elif f.output.list_of is defined %}
        let expected: Vec<{{ f.output.list_of | rust_type }}> = case["expected"]
            .as_array()
            .expect("expected must be array")
            .iter()
            .map(|x| {{ "x" | rust_unmarshal(f.output.list_of) }})
            .collect();
{% if not f.may_fail %}
        let actual = {{ call }}
            .expect("{{ f.name }}: a case within the declared capacity");
{% endif %}
        let actual = actual.as_slice();
{% if f.output.compare == "tolerance" %}
        assert_eq!(actual.len(), expected.len(), "{{ f.name }} length");
        for (a, e) in actual.iter().zip(expected.iter()) {
            assert_close(*a as f64, *e as f64, tol, "{{ f.name }}");
        }
{% else %}
        assert_eq!(actual, expected.as_slice(), "{{ f.name }}");
{% endif %}
{% elif f.output.type == "bytes" %}
        let expected = {{ "case[\"expected\"]" | rust_unmarshal("bytes") }};
{% if not f.may_fail %}
        let actual = {{ call }}
            .expect("{{ f.name }}: a case within the declared capacity");
{% endif %}
        assert_eq!(actual.as_slice(), expected.as_slice(), "{{ f.name }}");
{% elif f.output.optional is defined %}
        let expected: Option<{{ f.output.optional | rust_type }}> = {{ optional_value("case[\"expected\"]", f.output.optional) }};
{% if not f.may_fail %}
        let actual = {{ call }};
{% endif %}
        assert_eq!(actual, expected, "{{ f.name }}");
{% else %}
        let expected = {{ "case[\"expected\"]" | rust_unmarshal(f.output.type) }};
{% if not f.may_fail %}
        let actual = {{ call }};
{% endif %}
{% if f.output.compare == "tolerance" %}
        assert_close(actual as f64, expected as f64, tol, "{{ f.name }}");
{% else %}
        assert_eq!(actual, expected, "{{ f.name }}");
{% endif %}
{% endif %}
    }
