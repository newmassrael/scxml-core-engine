{# Union kind (docs/adr/0092) — a sum type and no behaviour. The oracle holds one
   value of each case, in the order of the tag's enum, as the wire writes it;
   each is built as the case its tag names, by the builder an algorithm's union
   argument is built by, and its tag is read back by the member the unit
   declares. The count comes first: a case the union gained without a value
   in the oracle would otherwise pass every assertion below. #}
{% import "values.rs.jinja2" as values %}
{% set u = f.shape %}
    {
        let spec = &reference["{{ f.ref_section }}"]["{{ f.name }}"];
        let cases = spec["cases"].as_array().expect("cases must be array");
        assert_eq!(
            cases.len(),
            {{ u.cases | length }},
            "{{ f.name }}: one oracle value per case"
        );
{% for c in u.cases %}
        {
            let case = &cases[{{ loop.index0 }}];
            assert_eq!(
                case["{{ u.tag }}"].as_str(),
                Some("{{ c.variant }}"),
                "{{ f.name }}: oracle value {{ loop.index0 }} is of the case {{ c.variant }}"
            );
            let value = {{ values.union_value(u, "case", f.name) }};
            assert_eq!(
                value.{{ u.tag_member }}(),
                fixtures::{{ u.tag_enum }}::{{ u.tag_enum | to_pascal_case }}::{{ c.kind }},
                "{{ f.name }}: the case {{ c.variant }} answers its tag"
            );
        }
{% endfor %}
    }
