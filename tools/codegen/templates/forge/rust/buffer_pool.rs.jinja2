#[cfg(test)]
mod generated_tests {
    use super::*;

    #[test]
    fn pool_starts_with_all_slots_free() {
        let pool = {{ pascal_name }}::new();
        assert_eq!(pool.free_count(), SLOT_COUNT);
    }

    #[test]
    fn acquire_promotes_free_to_cpu_mut() {
        let mut pool = {{ pascal_name }}::new();
        let slot = pool.pool_acquire_for_encode().expect("free slot available");
        let idx = slot.idx();
        assert_eq!(pool.slot_state(idx), Some(SlotState::CpuMut));
        assert_eq!(pool.free_count(), SLOT_COUNT - 1);
        slot.pool_return(&mut pool);
        assert_eq!(pool.slot_state(idx), Some(SlotState::Free));
        assert_eq!(pool.free_count(), SLOT_COUNT);
    }

    #[test]
    fn arm_rx_promotes_free_to_dma_armed_rx() {
        let mut pool = {{ pascal_name }}::new();
        let slot = pool.link_arm_rx().expect("free slot available");
        let idx = slot.idx();
        assert_eq!(pool.slot_state(idx), Some(SlotState::DmaArmedRx));
    }

    #[test]
    fn link_arm_tx_promotes_cpu_mut_to_dma_armed_tx_and_consumes_handle() {
        let mut pool = {{ pascal_name }}::new();
        let slot = pool.pool_acquire_for_encode().expect("free slot available");
        let idx = slot.idx();
        slot.link_arm_tx(&mut pool);
        assert_eq!(pool.slot_state(idx), Some(SlotState::DmaArmedTx));
        // The slot handle is moved here; the next line would be
        // a compile error if uncommented:
        //   slot.pool_return(&mut pool);
    }

    #[test]
    fn full_pool_returns_none_from_acquire() {
        let mut pool = {{ pascal_name }}::new();
        let mut held: Vec<Slot<CpuMut>> = Vec::new();
        for _ in 0..SLOT_COUNT {
            held.push(pool.pool_acquire_for_encode().expect("slot available"));
        }
        assert!(pool.pool_acquire_for_encode().is_none(), "pool exhausted");
        for s in held {
            s.pool_return(&mut pool);
        }
        assert_eq!(pool.free_count(), SLOT_COUNT);
    }

    #[test]
    fn cpu_mut_read_and_write_do_not_change_state() {
        let mut pool = {{ pascal_name }}::new();
        let mut slot = pool.pool_acquire_for_encode().expect("free slot available");
        let idx = slot.idx();
        {
            let bytes = slot.write(&mut pool);
            bytes[0] = 0xAB;
        }
        assert_eq!(pool.slot_state(idx), Some(SlotState::CpuMut));
        assert_eq!(slot.read(&pool)[0], 0xAB);
        slot.pool_return(&mut pool);
    }

    #[test]
    fn slot_state_out_of_range_returns_none() {
        let pool = {{ pascal_name }}::new();
        assert!(pool.slot_state(SLOT_COUNT).is_none());
        assert!(pool.slot_state(usize::MAX).is_none());
    }

    // ── Lifecycle closure ────────────────────────────────────────
    // A slot armed for DMA has to come back. These walk the two arms
    // end to end and assert the pool is whole again afterwards, which
    // is exactly what fails when the runtime seam is missing: arming
    // is author-callable, but `dma-busy-tx → free` and
    // `dma-busy-rx → cpu-ref` are the only edges that return a slot,
    // and both are runtime-owned. Without them the pool drains once
    // and never refills.

    #[test]
    fn tx_arm_returns_the_slot_to_the_freelist() {
        let mut pool = {{ pascal_name }}::new();
        let slot = pool.pool_acquire_for_encode().expect("free slot available");
        let idx = slot.idx();
        slot.link_arm_tx(&mut pool);
        assert_eq!(pool.slot_state(idx), Some(SlotState::DmaArmedTx));
        // SAFETY: no DMA controller here; this test *is* the driver.
        assert!(unsafe { pool.dma_start_tx(idx) });
        assert_eq!(pool.slot_state(idx), Some(SlotState::DmaBusyTx));
        assert!(unsafe { pool.tx_complete(idx) });
        assert_eq!(pool.free_count(), SLOT_COUNT, "TX arm must not leak the slot");
    }

    #[test]
    fn rx_arm_returns_the_slot_to_the_freelist() {
        let mut pool = {{ pascal_name }}::new();
        let armed = pool.link_arm_rx().expect("free slot available");
        let idx = armed.idx();
        // SAFETY: standing in for the peripheral and its completion IRQ.
        unsafe { armed.dma_start_rx(&mut pool) };
        assert_eq!(pool.slot_state(idx), Some(SlotState::DmaBusyRx));
        let readable = unsafe { pool.rx_complete(idx) }.expect("rx completion yields cpu-ref");
        assert_eq!(readable.idx(), idx);
        assert_eq!(readable.read(&pool).len(), SLOT_SIZE);
        readable.pool_return(&mut pool);
        assert_eq!(pool.free_count(), SLOT_COUNT, "RX arm must not leak the slot");
    }

    #[test]
    fn the_whole_ring_can_be_armed_and_drained_repeatedly() {
        let mut pool = {{ pascal_name }}::new();
        for _round in 0..3 {
            let mut armed = Vec::new();
            for _ in 0..SLOT_COUNT {
                let slot = pool.link_arm_rx().expect("free slot available");
                armed.push(slot.idx());
                // SAFETY: see above.
                unsafe { slot.dma_start_rx(&mut pool) };
            }
            assert_eq!(pool.free_count(), 0, "ring fully armed");
            for idx in armed {
                unsafe { pool.rx_complete(idx) }
                    .expect("rx completion yields cpu-ref")
                    .pool_return(&mut pool);
            }
            assert_eq!(pool.free_count(), SLOT_COUNT, "ring fully recovered");
        }
    }

    #[test]
    fn un_arm_recovers_a_slot_whose_dma_never_started() {
        let mut pool = {{ pascal_name }}::new();
        let slot = pool.pool_acquire_for_encode().expect("free slot available");
        let idx = slot.idx();
        slot.link_arm_tx(&mut pool);
        // SAFETY: the error path — the driver knows the DMA never started.
        let recovered = unsafe { pool.un_arm_tx(idx) }.expect("un-arm yields cpu-mut");
        recovered.pool_return(&mut pool);
        assert_eq!(pool.free_count(), SLOT_COUNT);
    }

    // ── Address publication ──────────────────────────────────────
    // The lifecycle tests above walk the states; these check the slot
    // can be handed to the bus master that is supposed to fill or
    // drain it. Standing in for the peripheral means touching the
    // slot through the published address only — a test that reached
    // for `read` / `write` instead would be exercising the CPU
    // accessors and would pass with no address accessor at all.

    #[test]
    fn every_slot_starts_on_the_declared_dma_boundary() {
        let pool = {{ pascal_name }}::new();
        // Slot 0 rides the containing allocation's alignment, which
        // the type carries; the later slots are the ones a
        // slot-size-shaped stride would push off the boundary.
        for idx in 0..SLOT_COUNT {
            let addr = &pool.storage[idx] as *const SlotBytes as usize;
            assert_eq!(
                addr % ALIGNMENT as usize,
                0,
                "slot {idx} starts {} bytes past the {ALIGNMENT}-byte boundary the pool declares",
                addr % ALIGNMENT as usize,
            );
        }
        assert_eq!(
            core::mem::align_of::<{{ pascal_name }}>(),
            ALIGNMENT as usize,
            "the pool type must carry the declared alignment so any placement of it is aligned",
        );
    }

    #[test]
    fn an_armed_rx_slot_can_be_filled_through_its_published_address() {
        let mut pool = {{ pascal_name }}::new();
        let armed = pool.link_arm_rx().expect("free slot available");
        let idx = armed.idx();
        let buf = armed.dma_armed_rx_ptr(&mut pool);
        assert_eq!(
            buf as usize % ALIGNMENT as usize,
            0,
            "a published address must satisfy the pool's DMA alignment",
        );
        assert_eq!(
            pool.slot_index_of_ptr(buf),
            Some(idx),
            "the address the driver publishes must name the slot it came from",
        );
        // SAFETY: standing in for the MAC. The slot is armed, this
        // test is the only writer, and nothing reads it until the
        // completion edge below.
        unsafe {
            for i in 0..SLOT_SIZE {
                buf.add(i).write((i % 251) as u8);
            }
            armed.dma_start_rx(&mut pool);
        }
        // SAFETY: standing in for the RX-complete IRQ.
        let filled = unsafe { pool.rx_complete(idx) }.expect("rx completion yields cpu-ref");
        let bytes = filled.read(&pool);
        for i in 0..SLOT_SIZE {
            assert_eq!(
                bytes[i],
                (i % 251) as u8,
                "byte {i} the peripheral wrote must be the byte the CPU reads back",
            );
        }
        filled.pool_return(&mut pool);
        assert_eq!(pool.free_count(), SLOT_COUNT);
    }

    #[test]
    fn an_armed_tx_slot_can_be_drained_through_its_published_address() {
        let mut pool = {{ pascal_name }}::new();
        let mut slot = pool.pool_acquire_for_encode().expect("free slot available");
        let idx = slot.idx();
        for (i, b) in slot.write(&mut pool).iter_mut().enumerate() {
            *b = (i % 241) as u8;
        }
        slot.link_arm_tx(&mut pool);
        let buf = pool
            .dma_armed_tx_ptr(idx)
            .expect("an armed TX slot publishes its address");
        assert_eq!(buf as usize % ALIGNMENT as usize, 0);
        assert_eq!(pool.slot_index_of_ptr(buf), Some(idx));
        // SAFETY: standing in for the DMA controller reading the
        // descriptor it was pointed at. Read-only, and the slot is
        // armed for TX for the duration.
        unsafe {
            for i in 0..SLOT_SIZE {
                assert_eq!(
                    buf.add(i).read(),
                    (i % 241) as u8,
                    "byte {i} the bus master reads must be the byte the CPU encoded",
                );
            }
            assert!(pool.dma_start_tx(idx));
            assert!(pool.tx_complete(idx));
        }
        assert_eq!(pool.free_count(), SLOT_COUNT);
    }

    /// An address is published only while the slot is in the state
    /// that owes one. Lifting one out of a slot in any other state
    /// would hand a bus master a buffer some other owner is using.
    #[test]
    fn the_tx_address_is_refused_outside_the_armed_state() {
        let mut pool = {{ pascal_name }}::new();
        let slot = pool.pool_acquire_for_encode().expect("free slot available");
        let idx = slot.idx();
        assert!(
            pool.dma_armed_tx_ptr(idx).is_none(),
            "cpu-mut is not dma-armed-tx",
        );
        slot.link_arm_tx(&mut pool);
        assert!(pool.dma_armed_tx_ptr(idx).is_some(), "armed slot publishes");
        // SAFETY: this test is the driver.
        unsafe {
            assert!(pool.dma_start_tx(idx));
            assert!(
                pool.dma_armed_tx_ptr(idx).is_none(),
                "dma-busy-tx already holds the address; re-publishing names live memory",
            );
            assert!(pool.tx_complete(idx));
        }
        assert!(
            pool.dma_armed_tx_ptr(idx).is_none(),
            "a free slot publishes no address",
        );
        assert!(pool.dma_armed_tx_ptr(SLOT_COUNT).is_none(), "out of range");
    }

    /// The reverse map resolves exactly the addresses the pool
    /// published and nothing else — an interior or foreign pointer is
    /// a driver bug, and rounding it to the containing slot would
    /// hide one.
    #[test]
    fn slot_index_of_ptr_round_trips_slot_bases_and_refuses_the_rest() {
        let pool = {{ pascal_name }}::new();
        for idx in 0..SLOT_COUNT {
            let base = &pool.storage[idx] as *const SlotBytes as *const u8;
            assert_eq!(pool.slot_index_of_ptr(base), Some(idx));
        }
        if SLOT_SIZE > 1 {
            // SAFETY: one past the base of slot 0, still inside the pool.
            let interior = unsafe { (&pool.storage[0] as *const SlotBytes as *const u8).add(1) };
            assert!(
                pool.slot_index_of_ptr(interior).is_none(),
                "an interior pointer names no slot base",
            );
        }
        // SAFETY: one slot past the end of the table — an address the
        // pool never published.
        let past_end =
            unsafe { (&pool.storage[0] as *const SlotBytes as *const u8).add(SLOT_SIZE * SLOT_COUNT) };
        assert!(pool.slot_index_of_ptr(past_end).is_none(), "past the table");
        // Below the table. Deterministic, unlike borrowing the address
        // of some unrelated local, which could land inside the pool's
        // range by accident and make this check pass for the wrong
        // reason on one run and fail on the next.
        let below = (pool.storage.as_ptr() as usize - 1) as *const u8;
        assert!(pool.slot_index_of_ptr(below).is_none(), "below the table");
        assert_eq!(pool.free_count(), SLOT_COUNT, "no slot was disturbed");
    }

    /// A spurious or replayed interrupt must not advance a slot that
    /// is in some other state. The index-keyed seam has no handle to
    /// tag-check, so this state check is the only thing standing
    /// between a stray IRQ and a slot handed to two owners.
    #[test]
    fn the_seam_refuses_a_slot_in_the_wrong_state() {
        let mut pool = {{ pascal_name }}::new();
        let slot = pool.pool_acquire_for_encode().expect("free slot available");
        let idx = slot.idx();
        // SAFETY: deliberately calling on a cpu-mut slot; the point is
        // that it is refused rather than acted on.
        assert!(!unsafe { pool.dma_start_tx(idx) }, "cpu-mut is not dma-armed-tx");
        assert!(!unsafe { pool.tx_complete(idx) }, "cpu-mut is not dma-busy-tx");
        assert!(unsafe { pool.rx_complete(idx) }.is_none(), "cpu-mut is not dma-busy-rx");
        assert!(unsafe { pool.un_arm_tx(idx) }.is_none(), "cpu-mut is not dma-armed-tx");
        assert_eq!(pool.slot_state(idx), Some(SlotState::CpuMut), "state untouched");
        assert!(unsafe { pool.rx_complete(SLOT_COUNT) }.is_none(), "out of range");
        slot.pool_return(&mut pool);
    }
}
