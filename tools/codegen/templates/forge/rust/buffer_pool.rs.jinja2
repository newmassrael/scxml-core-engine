impl<'a> {{ pascal_name }}<Over<'a>> {
    /// A pool over storage the caller holds (ADR 0082): `bytes` cut into `count`
    /// slots of `len` bytes, each within the build bounds
    /// (`1 <= count <= SLOT_COUNT`, `1 <= len <= SLOT_SIZE`, `len` a multiple of
    /// `ALIGNMENT` so every slot starts on it). The span must hold `count * len`
    /// bytes and start on `ALIGNMENT`; a short or misaligned one is refused.
    /// The book stays the pool's own.
    pub fn over(bytes: &'a mut [u8], count: usize, len: usize) -> Result<Self, PoolRefused> {
        let withheld = withheld_for(count)?;
        if len == 0 || len > SLOT_SIZE || len.checked_rem(ALIGNMENT as usize) != Some(0) {
            return Err(PoolRefused::Length);
        }
        let needed = count.checked_mul(len).ok_or(PoolRefused::Short)?;
        if bytes.len() < needed {
            return Err(PoolRefused::Short);
        }
        if (bytes.as_ptr() as usize).checked_rem(ALIGNMENT as usize) != Some(0) {
            return Err(PoolRefused::Misaligned);
        }
        Ok(Self {
            store: Over {
                base: core::ptr::NonNull::from(bytes).cast::<u8>(),
                stride: len,
                _span: PhantomData,
            },
            book: Book::new(withheld),
        })
    }
}

/// The slots a pool of `count` withholds from `SLOT_COUNT`, or the refusal of a
/// count outside `1..=SLOT_COUNT`.
fn withheld_for(count: usize) -> Result<u32, PoolRefused> {
    if count == 0 {
        return Err(PoolRefused::Count);
    }
    SLOT_COUNT
        .checked_sub(count)
        .and_then(|withheld| u32::try_from(withheld).ok())
        .ok_or(PoolRefused::Count)
}

impl<St: SlotStore> {{ pascal_name }}<St> {
    /// How many slots this pool lends: its run-time count.
    pub fn count(&self) -> usize {
        SLOT_COUNT.saturating_sub(self.book.withheld as usize)
    }

    /// The length of each slot: `SLOT_SIZE` for the pool's own storage, the
    /// length the caller's storage was cut into otherwise. A lending names a
    /// length up to this.
    pub fn slot_len(&self) -> usize {
        self.store.stride()
    }

    /// How many stale, forged or misplaced indices the pool has refused
    /// (`pool/ownership-violation`).
    pub fn ownership_violations(&self) -> u32 {
        word_load(&self.book.violations)
    }

    /// How many takes the pool refused for a prefix wider than the slot's
    /// headroom.
    pub fn refused_prefixes(&self) -> u32 {
        word_load(&self.book.refused_prefixes)
    }

    fn entry(&self, no: SlotNo) -> &Entry {
        no.of(&self.book.entries)
    }

    /// The slots this pool counts, in table order.
    fn live(&self) -> impl Iterator<Item = SlotNo> {
        SlotNo::ALL.into_iter().take(self.count())
    }

    /// The slot at `position`, when the pool counts it.
    fn live_no(&self, position: usize) -> Option<SlotNo> {
        SlotNo::from_index(position).filter(|no| no.index() < self.count())
    }

    /// The first byte of a slot.
    fn slot_ptr(&self, no: SlotNo) -> *mut u8 {
        self.store
            .base()
            .wrapping_add(no.index().wrapping_mul(self.store.stride()))
    }

    /// A handle on a slot this context has just moved into its state.
    fn mint<S>(&self, no: SlotNo) -> Slot<S, u32> {
        Slot {
            no,
            generation: word_load(&self.entry(no).generation),
            _state: PhantomData,
        }
    }

    fn violation(&self) {
        word_bump(&self.book.violations);
    }

    /// The slot `index` names when the pool counts it, its generation is the
    /// index's, and its book word is `word`.
    fn named(&self, index: SlotIndex, word: u32) -> Option<SlotNo> {
        let no = SlotNo::from_number(index.slot).filter(|no| no.index() < self.count())?;
        let entry = self.entry(no);
        (word_load(&entry.generation) == index.generation && word_load(&entry.state) == word)
            .then_some(no)
    }

    /// The slot at `position` when the pool counts it and it is in `state`.
    /// The one place a position-keyed edge or accessor turns the `usize` it was
    /// handed into a slot.
    fn slot_in(&self, position: usize, state: SlotState) -> Option<SlotNo> {
        self.live_no(position)
            .filter(|no| word_load(&self.entry(*no).state) == state.bits())
    }

    /// Return a slot to `free`: its next lending has the next generation, and
    /// every word it was lent with is cleared. The caller is the one context
    /// moving the slot (its handle's owner, or the winner of a claim).
    fn free(&self, no: SlotNo) {
        let entry = self.entry(no);
        word_store(&entry.generation, word_load(&entry.generation).wrapping_add(1));
        word_store(&entry.len, 0);
        word_store(&entry.headroom, 0);
        word_store(&entry.frame, 0);
        word_store(&entry.holds, 0);
        word_store(&entry.state, SlotState::Free.bits());
    }

    /// Move the first free slot the pool counts to `to`, lent `len` bytes long
    /// with `headroom` of them kept in front of the frame.
    fn lend(&self, to: SlotState, len: usize, headroom: usize) -> Result<SlotNo, LendRefused> {
        if len == 0 || len > self.store.stride() {
            return Err(LendRefused::Length);
        }
        if headroom >= len {
            return Err(LendRefused::Headroom);
        }
        for no in self.live() {
            let entry = self.entry(no);
            if word_cas(&entry.state, SlotState::Free.bits(), to.bits()) {
                word_store(&entry.len, len as u32);
                word_store(&entry.headroom, headroom as u32);
                word_store(&entry.frame, 0);
