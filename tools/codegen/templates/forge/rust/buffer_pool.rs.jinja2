            return Err(TakeRefused::Stale);
        };
        let entry = self.entry(no);
        let headroom = word_load(&entry.headroom) as usize;
        let too_wide = prefix.len() > headroom;
        let taken = if too_wide {
            armed | CLAIM
        } else {
            SlotState::DmaBusyTx.bits()
        };
        if !word_cas(&entry.state, armed, taken) {
            self.violation();
            return Err(TakeRefused::Stale);
        }
        if word_load(&entry.generation) != index.generation {
            word_store(&entry.state, armed);
            self.violation();
            return Err(TakeRefused::Stale);
        }
        if too_wide {
            word_bump(&self.book.refused_prefixes);
            self.free(no);
            return Err(TakeRefused::PrefixTooWide);
        }
        let start = self
            .slot_ptr(no)
            .wrapping_add(headroom.wrapping_sub(prefix.len()));
        // SAFETY: `start` is within the slot's headroom, which this take now
        // holds, and `prefix` is a caller's slice no wider than it.
        unsafe {
            core::ptr::copy_nonoverlapping(prefix.as_ptr(), start, prefix.len());
        }
{% if edge_cache["link_arm_tx"].clean %}
        // C5: the prefix was written after `link_arm_tx` cleaned the slot, so
        // it is cleaned before the bus master reads it (spec lines 1186-1188).
        unsafe {
            sce_dcache_clean_by_addr(start as *const core::ffi::c_void, prefix.len());
        }
{% endif %}
        Ok(Span {
            ptr: start as *const u8,
            len: prefix
                .len()
                .saturating_add(word_load(&entry.frame) as usize),
        })
    }

    /// Inspect a slot's current lifecycle state. `None` for a position the
    /// pool does not count, so debug introspection cannot panic.
    pub fn slot_state(&self, idx: usize) -> Option<SlotState> {
        let no = self.live_no(idx)?;
        SlotState::from_bits(word_load(&self.entry(no).state))
    }

    /// Which slot a buffer address names, if any.
    ///
    /// The return leg of address publication. Peripheral completion
    /// callbacks conventionally hand back the buffer address they were
    /// given (`rx_frame_cb(addr, len)`), while every edge back into
    /// the pool is keyed by slot position. Without this the driver keeps
    /// a shadow table of a layout the pool already knows, and a slip
    /// in that table advances the wrong slot.
    ///
    /// Only an exact slot base resolves. An interior or foreign
    /// pointer is `None` rather than being rounded down to the slot
    /// containing it: a completion naming an address the pool never
    /// published is a driver bug, and rounding would turn it into a
    /// plausible-looking index.
    ///
    /// Checked arithmetic throughout, because the consumer denies
    /// `clippy::arithmetic_side_effects`: an address below the table is
    /// the subtraction's `None`, and the remainder and quotient divide
    /// by the stride, the pool's slot length, which is positive by its
    /// construction. `is_multiple_of` would say the remainder test in one
    /// call, but the generated Rust compiles on Rust 1.81, which does not have
    /// it.
    pub fn slot_index_of_ptr(&self, ptr: *const u8) -> Option<usize> {
        let base = self.store.base() as usize;
        let stride = self.store.stride();
        let offset = (ptr as usize).checked_sub(base)?;
        if offset.checked_rem(stride)? != 0 {
            return None;
        }
        let idx = offset.checked_div(stride)?;
        self.live_no(idx).map(SlotNo::index)
    }
{% for a in addresses %}{% if not a.holdable %}

    /// Address of a slot in `{{ a.state_spec }}`, for the descriptor
    /// the bus master reads it from.
    ///
    /// `{{ a.state_spec }}` hands out no handle — the caller reached it
    /// through `{{ a.arm_op }}`, which consumed one — so the slot is
    /// named by position, the same key the completion signal carries.
    /// `None` unless the slot really is in `{{ a.state_spec }}`, so an
    /// address cannot be lifted out of a slot some other owner holds.
    ///
    /// Returning a raw pointer rather than a slice is the point. A
    /// `&{% if a.device_writes %}mut {% endif %}[u8]` handed out here would be a live Rust reference to
    /// memory a peripheral is about to {% if a.device_writes %}write{% else %}read{% endif %}, which is the aliasing
    /// the DMA states exist to deny; a raw pointer carries the address
    /// and no promise about the memory. Obtaining one is safe because
    /// nothing can be read or written through it without an `unsafe`
    /// block at the point of use, which is where the contract actually
    /// binds: the pointer is valid only while the slot stays in
    /// `{{ a.state_spec }}`, and{% if a.device_writes %} the CPU must not read through it
    /// before the completion edge{% else %} the CPU must not write through it while
    /// the transfer runs{% endif %}.
    pub fn {{ a.op_name }}(&self, idx: usize) -> Option<*{% if a.device_writes %}mut{% else %}const{% endif %} u8> {
        let slot = self.slot_in(idx, SlotState::{{ a.state_pascal }})?;
        Some(self.slot_ptr(slot){% if not a.device_writes %} as *const u8{% endif %})
    }
{% endif %}{% endfor %}

    /// Number of slots the pool counts that are on the freelist.
    pub fn free_count(&self) -> usize {
        self.live()
            .filter(|no| word_load(&self.entry(*no).state) == SlotState::Free.bits())
            .count()
    }
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Slot<CpuMut> — the FSM edges leaving cpu-mut that author code can
// directly invoke: `cpu-mut → dma-armed-tx` (link_arm_tx) and
// `cpu-mut → free` (pool_return / abort encode error path).
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

impl Slot<CpuMut, u32> {
    /// Hand the slot off to the link's TX path. Spec §synth-5-E line 1142:
    /// `cpu-mut → dma-armed-tx`. `frame` is how many bytes of the frame's room
    /// ([`Slot::write`]) the holder wrote; a frame larger than the room is
    /// refused and the handle handed back. Consumes the handle and answers the
    /// armed slot's index, which the driver takes it by
    /// ([`{{ pascal_name }}::take_prefixed`]); the slot progresses through
    /// `DmaArmedTx → DmaBusyTx → Free` via the driver and the TX-complete
    /// IRQ. C5: when `cache-policy: maintain`, emits
    /// `sce_dcache_clean_by_addr` before the state transition (spec lines
    /// 1186-1188) so the DMA controller reads the latest CPU writes from main
    /// memory.
    pub fn link_arm_tx(self, pool: &{{ pascal_name }}<impl SlotStore>, frame: usize) -> Result<SlotIndex, Self> {
        let entry = pool.entry(self.no);
        let room = (word_load(&entry.len) as usize).saturating_sub(word_load(&entry.headroom) as usize);
        if frame > room {
            return Err(self);
        }
{% if edge_cache["link_arm_tx"].clean %}
        // C5 cache-clean before TX descriptor publish (spec lines 1186-1188).
        unsafe {
            sce_dcache_clean_by_addr(
                pool.slot_ptr(self.no) as *const core::ffi::c_void,
                pool.store.stride(),
            );
        }
{% endif %}
        word_store(&entry.frame, frame as u32);
        word_store(&entry.state, SlotState::DmaArmedTx.bits());
        Ok(self.index())
    }

    /// Return the slot to the freelist. Spec §synth-5-E line 1155:
    /// `cpu-mut → free` ("abort encode" error path) and the
    /// `cpu-mut|cpu-ref → free` author-visible API on lines
    /// 1232-1237. Consumes the handle.
    pub fn pool_return(self, pool: &{{ pascal_name }}<impl SlotStore>) {
        pool.free(self.no);
    }

    /// Read-only borrow of the frame's room: the slot's bytes after its
    /// headroom, up to the length it was lent with.
    pub fn read<'a>(&'a self, pool: &'a {{ pascal_name }}<impl SlotStore>) -> &'a [u8] {
        let (ptr, len) = pool.frame_room(self.no);
        // SAFETY: the room lies within the slot, which this handle holds in
        // `cpu-mut`; nothing writes it while the handle is borrowed.
        unsafe { core::slice::from_raw_parts(ptr as *const u8, len) }
    }

    /// Mutable borrow of the frame's room.
    pub fn write<'a>(&'a mut self, pool: &'a {{ pascal_name }}<impl SlotStore>) -> &'a mut [u8] {
        let (ptr, len) = pool.frame_room(self.no);
        // SAFETY: the room lies within the slot, which this handle holds in
        // `cpu-mut` and is borrowed mutably for `'a`, so this is the only
        // reference to it.
        unsafe { core::slice::from_raw_parts_mut(ptr, len) }
    }
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Slot<CpuRef> — the FSM edge leaving cpu-ref that author code
// directly invokes: `cpu-ref → free` (pool_return), and the lending of a
// received frame to the events it raised (docs/adr/0111 D4).
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

impl Slot<CpuRef, u32> {
    /// Return the slot to the freelist. Spec §synth-5-E line 1152:
    /// `cpu-ref → free` ("handler complete; pool_return(slot)").
    /// Consumes the handle.
    pub fn pool_return(self, pool: &{{ pascal_name }}<impl SlotStore>) {
        pool.free(self.no);
    }

    /// Read-only borrow of the frame — `cpu-ref` is a shared CPU-read state
    /// per spec line 1135.
    pub fn read<'a>(&'a self, pool: &'a {{ pascal_name }}<impl SlotStore>) -> &'a [u8] {
        let (ptr, len) = pool.frame_room(self.no);
        // SAFETY: the frame lies within the slot, which this handle holds in
        // `cpu-ref`, a state nothing writes.
        unsafe { core::slice::from_raw_parts(ptr as *const u8, len) }
    }

    /// Lend the received frame to the `holds` events it raised (docs/adr/0111
    /// D4): the handle is given up for the index the events carry, each event
    /// and each output that borrows from the frame holds the slot
    /// ([`{{ pascal_name }}::hold`]), and the last [`{{ pascal_name }}::release`] returns it
    /// to the pool. Zero holds is refused and the handle handed back.
    pub fn lend(self, pool: &{{ pascal_name }}<impl SlotStore>, holds: u32) -> Result<SlotIndex, Self> {
        if holds == 0 {
            return Err(self);
        }
        let entry = pool.entry(self.no);
        word_store(&entry.holds, holds);
        word_store(&entry.state, SlotState::CpuRef.bits() | LENT);
        Ok(self.index())
    }
}

