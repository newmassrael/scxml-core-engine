impl Book {
    /// The book of a pool that withholds `withheld` slots, with no slot out.
    const fn new(withheld: u32) -> Self {
        Self {
            entries: [const { Entry::new() }; SLOT_COUNT],
            withheld,
            violations: Word::new(0),
            refused_prefixes: Word::new(0),
        }
    }
}

