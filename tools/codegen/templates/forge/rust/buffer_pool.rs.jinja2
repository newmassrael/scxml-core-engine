        assert_eq!(pool.book.withheld, 0);
        assert_eq!(word_load(&pool.book.violations), 0);
        assert_eq!(word_load(&pool.book.refused_prefixes), 0);
        // SAFETY: nothing else reaches the pool's storage in this test.
        let storage = unsafe { &*pool.store.0.get() };
        assert!(storage.iter().all(|slot| slot.0.iter().all(|b| *b == 0)));
    }

