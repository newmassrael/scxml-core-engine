#[cfg(test)]
mod generated_tests {
    use super::*;

    /// Storage a caller holds, on the pool's alignment, for two slots of the
    /// bound and one alignment unit spare.
    #[repr(C, align({{ alignment }}))]
    struct Arena([u8; 2 * SLOT_SIZE + ALIGNMENT as usize]);

    impl Arena {
        fn new() -> Self {
            Self([0u8; 2 * SLOT_SIZE + ALIGNMENT as usize])
        }
    }

    #[test]
    fn a_pool_over_caller_storage_cuts_it_into_the_slots_it_was_given() {
        let count = SLOT_COUNT.min(2);
        let mut arena = Arena::new();
        let base = arena.0.as_ptr() as usize;
        {
            let pool = {{ pascal_name }}::over(&mut arena.0, count, ALIGNMENT as usize)
                .ok()
                .expect("an aligned span of the count times the length");
            assert_eq!(pool.count(), count);
            assert_eq!(pool.slot_len(), ALIGNMENT as usize);
            let mut slots = Vec::new();
            for n in 0..count {
                let mut slot = pool
                    .pool_acquire_for_encode(ALIGNMENT as usize, 0)
                    .expect("a slot of the span");
                let bytes = slot.write(&pool);
                assert_eq!(bytes.len(), ALIGNMENT as usize);
                assert_eq!(
                    bytes.as_ptr() as usize,
                    base + n * ALIGNMENT as usize,
                    "slot {n} starts its length after the one before",
                );
                bytes[0] = n as u8 + 1;
                slots.push(slot);
            }
            assert_eq!(
                pool.pool_acquire_for_encode(ALIGNMENT as usize, 0).err(),
                Some(LendRefused::Exhausted)
            );
            assert_eq!(
                pool.pool_acquire_for_encode(ALIGNMENT as usize + 1, 0).err(),
                Some(LendRefused::Length),
                "a lending past the length the span was cut into",
            );
            for slot in slots {
                slot.pool_return(&pool);
            }
        }
        assert_eq!(arena.0[0], 1, "the pool wrote the caller's bytes");
    }

    #[test]
    fn a_pool_over_a_short_or_misaligned_span_is_refused() {
        let mut arena = Arena::new();
        let count = SLOT_COUNT.min(2);
        let len = ALIGNMENT as usize;
        assert_eq!(
            {{ pascal_name }}::over(&mut arena.0[..count * len - 1], count, len).err(),
            Some(PoolRefused::Short)
        );
        assert_eq!(
            {{ pascal_name }}::over(&mut arena.0, 0, len).err(),
            Some(PoolRefused::Count)
        );
        assert_eq!(
            {{ pascal_name }}::over(&mut arena.0, SLOT_COUNT + 1, len).err(),
            Some(PoolRefused::Count)
        );
        assert_eq!(
            {{ pascal_name }}::over(&mut arena.0, count, 0).err(),
            Some(PoolRefused::Length)
        );
        assert_eq!(
            {{ pascal_name }}::over(&mut arena.0, count, SLOT_SIZE + ALIGNMENT as usize).err(),
            Some(PoolRefused::Length)
        );
        if ALIGNMENT > 1 {
            assert_eq!(
                {{ pascal_name }}::over(&mut arena.0, count, len + 1).err(),
                Some(PoolRefused::Length),
                "a length that puts the second slot off the alignment",
            );
            assert_eq!(
                {{ pascal_name }}::over(&mut arena.0[1..], 1, len).err(),
                Some(PoolRefused::Misaligned)
            );
        }
    }

