        assert!(
            pool.reclaim::<CpuRef>(index).is_none(),
            "a state the slot was not given up in",
        );
        assert_eq!(pool.ownership_violations(), 2);
        let back: Slot<CpuMut> = pool.reclaim(index).expect("the true index still works");
        back.pool_return(&pool);
