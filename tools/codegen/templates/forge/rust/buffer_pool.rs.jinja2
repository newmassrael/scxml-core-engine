        let Some(no) = self.named(index, parked) else {
            self.violation();
            return None;
        };
        let entry = self.entry(no);
        if !word_cas(&entry.state, parked, S::STATE.bits()) {
            self.violation();
            return None;
        }
        // A slot whose handle was rebuilt, returned and lent again between the
        // check and the claim has another generation: put it back.
        if word_load(&entry.generation) != index.generation {
            word_store(&entry.state, parked);
            self.violation();
            return None;
        }
