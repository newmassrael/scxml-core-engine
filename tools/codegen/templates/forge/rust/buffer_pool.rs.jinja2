    #[test]
    fn a_stale_index_is_refused_and_counted() {
        let pool = {{ pascal_name }}::with_count(1).ok().expect("one slot");
        let slot = pool.pool_acquire_for_encode(SLOT_SIZE, 0).expect("the slot");
        let old = slot.index();
        slot.pool_return(&pool);
        let slot = pool.pool_acquire_for_encode(SLOT_SIZE, 0).expect("the slot again");
        assert_eq!(slot.index().slot, old.slot, "the same slot");
        assert_ne!(slot.index().generation, old.generation, "a later lending of it");
        let current = slot.into_index(&pool);
        assert!(pool.reclaim::<CpuMut>(old).is_none(), "the earlier lending's index");
        assert_eq!(pool.ownership_violations(), 1);
        let back: Slot<CpuMut> = pool.reclaim(current).expect("the current index");
        back.pool_return(&pool);
        assert_eq!(pool.ownership_violations(), 1);
    }

