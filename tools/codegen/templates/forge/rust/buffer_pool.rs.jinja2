    pub fn hold(&self, index: SlotIndex) -> bool {
        let Some(no) = self.named(index, SlotState::CpuRef.bits() | LENT) else {
            self.violation();
            return false;
        };
        let holds = &self.entry(no).holds;
        loop {
            let seen = word_load(holds);
            if seen == 0 {
                self.violation();
                return false;
            }
            if seen == u32::MAX {
                return false;
            }
            if word_cas(holds, seen, seen.wrapping_add(1)) {
                return true;
            }
        }
