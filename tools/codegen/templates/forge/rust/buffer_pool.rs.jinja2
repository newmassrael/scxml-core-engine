    #[test]
    fn an_index_rebuilds_its_handle_once() {
        let pool = {{ pascal_name }}::new();
        let mut slot = pool.pool_acquire_for_encode(SLOT_SIZE, 0).expect("free slot available");
        slot.write(&pool)[0] = 0x5A;
        let index = slot.into_index(&pool);
        assert_eq!(pool.slot_state(index.slot as usize), Some(SlotState::CpuMut));
        let back: Slot<CpuMut> = pool.reclaim(index).expect("the index names the parked slot");
        assert_eq!(back.index(), index);
        assert_eq!(back.read(&pool)[0], 0x5A, "the rebuilt handle holds the same bytes");
        assert!(
            pool.reclaim::<CpuMut>(index).is_none(),
            "a second reclaim of one index rebuilds nothing",
        );
        assert_eq!(pool.ownership_violations(), 1);
        back.pool_return(&pool);
