/// One of the seven slot ownership states. Discriminants match the
/// C11 backend's `sce_slot_state_t` enum so cross-language tracing
/// over a single binary representation stays consistent.
{{ slot_state_derives_attr }}
#[repr(u8)]
pub enum SlotState {
    Free = 0,
    CpuMut = 1,
    DmaArmedTx = 2,
    DmaBusyTx = 3,
    DmaArmedRx = 4,
    DmaBusyRx = 5,
    CpuRef = 6,
}

impl SlotState {
    /// The state a book word holds in its low bits, or `None` for bits no
    /// state has.
    fn from_bits(bits: u32) -> Option<Self> {
        match bits & STATE_BITS {
            0 => Some(Self::Free),
            1 => Some(Self::CpuMut),
            2 => Some(Self::DmaArmedTx),
            3 => Some(Self::DmaBusyTx),
            4 => Some(Self::DmaArmedRx),
            5 => Some(Self::DmaBusyRx),
            6 => Some(Self::CpuRef),
            _ => None,
        }
    }

    /// This state as the low bits of a book word.
    const fn bits(self) -> u32 {
        self as u32
    }
}

/// The bits of a book word that hold its `SlotState`.
const STATE_BITS: u32 = 0x07;

/// Set while a transition that frees a slot no handle holds is under way:
/// whoever set it is the one context moving the slot.
const CLAIM: u32 = 0x20;

/// Set while a receive slot is lent to the events of its frame and the
/// outputs that borrow from it (docs/adr/0111 D4). How many hold it is the
/// slot's `holds` word.
const LENT: u32 = 0x40;

/// Set while a slot's handle has been given up for its `SlotIndex`
/// ([`Slot::into_index`]) and cleared by the [`{{ pascal_name }}::reclaim`] that
/// rebuilds it, so an index rebuilds at most one handle.
const PARKED: u32 = 0x80;

