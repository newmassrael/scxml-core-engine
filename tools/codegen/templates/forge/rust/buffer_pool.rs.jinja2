{% if shared %}

/// One word of the book. The pool is `shared`: the holder of the drive
/// and a driver context (another thread, an interrupt) both move slots, so a
/// word is atomic and a transition is a compare-and-swap from the state it
/// leaves.
type Word = core::sync::atomic::AtomicU32;

fn word_load(word: &Word) -> u32 {
    word.load(core::sync::atomic::Ordering::Acquire)
}

fn word_store(word: &Word, value: u32) {
    word.store(value, core::sync::atomic::Ordering::Release);
}

/// Replace `from` with `to` when the word holds `from`, and say whether it did.
#[cfg(target_has_atomic = "32")]
fn word_cas(word: &Word, from: u32, to: u32) -> bool {
    word.compare_exchange(
        from,
        to,
        core::sync::atomic::Ordering::AcqRel,
        core::sync::atomic::Ordering::Acquire,
    )
    .is_ok()
}

/// Replace `from` with `to` when the word holds `from`, and say whether it did,
/// inside the deployment's critical section: the target has no
/// compare-and-swap (ARMv6-M), and its loads and stores are atomic alone.
#[cfg(not(target_has_atomic = "32"))]
fn word_cas(word: &Word, from: u32, to: u32) -> bool {
    critical_section::with(|_| {
        if word.load(core::sync::atomic::Ordering::Relaxed) == from {
            word.store(to, core::sync::atomic::Ordering::Relaxed);
            true
        } else {
            false
        }
    })
}
{% else %}

/// One word of the book. The pool is the `owner`'s: whoever holds the drive
/// uses it alone, so a word is a plain cell, a transition is a load and a
/// store, and the pool is not `Sync`.
type Word = core::cell::Cell<u32>;

fn word_load(word: &Word) -> u32 {
    word.get()
}

fn word_store(word: &Word, value: u32) {
    word.set(value);
}

/// Replace `from` with `to` when the word holds `from`, and say whether it did.
fn word_cas(word: &Word, from: u32, to: u32) -> bool {
    if word.get() == from {
        word.set(to);
        true
    } else {
        false
    }
}
{% endif %}

/// Add one to a counting word, wrapping.
fn word_bump(word: &Word) {
    loop {
        let seen = word_load(word);
        if word_cas(word, seen, seen.wrapping_add(1)) {
            return;
        }
    }
}

/// One slot's line of the book. Every word is zero for a slot that has never
/// been lent, which is what makes an empty pool all zero bytes.
struct Entry {
    /// The slot's `SlotState` in `STATE_BITS`, with `CLAIM`, `LENT` and
    /// `PARKED` above it.
    state: Word,
    /// Advanced each time the slot returns to `free`, so a `SlotIndex` names
    /// the one lending it was taken from.
    generation: Word,
    /// The length the lending named: the slot is this many bytes long while
    /// it is out.
    len: Word,
    /// The bytes at the slot's start kept for a prefix the link writes when it
    /// takes the slot.
    headroom: Word,
    /// The bytes of the frame the holder armed, after the headroom.
    frame: Word,
    /// While the slot is lent to events: how many events and outputs hold it.
    holds: Word,
}

impl Entry {
    const fn new() -> Self {
        Self {
            state: Word::new(0),
            generation: Word::new(0),
            len: Word::new(0),
            headroom: Word::new(0),
            frame: Word::new(0),
            holds: Word::new(0),
        }
    }
}

