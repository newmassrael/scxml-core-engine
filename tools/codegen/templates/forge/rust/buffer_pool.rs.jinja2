// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// One slot's bytes, carrying the pool's declared DMA alignment.
///
/// `<sce:alignment>` describes every slot, not the table that holds
/// them. A bare `[[u8; SLOT_SIZE]; SLOT_COUNT]` has alignment 1 no
/// matter what the pool declares, so slot 0 landed whereever the
/// containing static did and every later slot sat at a multiple of
/// `SLOT_SIZE` from it — on the boundary only when `SLOT_SIZE` happened to
/// be a multiple of the alignment. Two things ride on getting this right:
/// the address handed to a peripheral, and the per-slot cache maintenance,
/// which operates by cache line and so reaches into a neighbouring slot
/// whenever a slot does not start on one.
///
/// The parser rejects a `slot-size` that is not a multiple of
/// `alignment`, so the padding here is always zero — the assertions
/// below say so where the compiler can check it rather than leaving
/// the reader to trust it.
#[derive(Clone, Copy)]
#[repr(C, align({{ alignment }}))]
struct SlotBytes([u8; SLOT_SIZE]);

const _: () = assert!(
    core::mem::align_of::<SlotBytes>() == ALIGNMENT as usize,
    "slot alignment must be the declared <sce:alignment> (RFC §synth-5-E lines 1024-1073)",
);
const _: () = assert!(
    core::mem::size_of::<SlotBytes>() == SLOT_SIZE,
    "slot stride must equal <sce:slot-size> — padding here would mean the pool \
     silently occupies more SRAM than the author budgeted",
);

/// What a pool keeps of its slots beside their bytes, by the storage it holds
/// them in (docs/adr/0111 D4), as a map's storage decides what its slots keep
/// (docs/adr/0154): the book of every slot's lending for a pool that lends at
/// run time, and one state per slot for one that lends every slot whole, which
/// then pays for no book, no generation and no run-time count or length.
pub trait Storage {
    /// The pool's record of its slots: [`Book`], or `[SlotState; SLOT_COUNT]`.
    type Book;
    /// What a handle carries of its slot's lending: `u32`, the lending's
    /// generation, where a slot crosses an interface by its index, and `()`
    /// where it never does, so the handle is the slot's number alone.
    type Generation: Copy + Eq + core::fmt::Debug;
}

/// Storage a pool lends at run time (docs/adr/0111 D4): slot `n` starts
/// `n * stride()` bytes after `base()`, and the pool keeps the book of its
/// lendings.
///
/// # Safety
///
/// An implementation promises that `base()` is aligned to `ALIGNMENT` and
/// starts at least `count * stride()` bytes, for the count of the pool that
/// holds it, that are valid for reads and writes for as long as the store
/// lives and that nothing but that pool reaches; and that `stride()` is a
/// multiple of `ALIGNMENT` no greater than `SLOT_SIZE`.
pub unsafe trait SlotStore {
    /// The first byte of slot 0.
    fn base(&self) -> *mut u8;
    /// The bytes from one slot to the next: the slot length the storage was
    /// cut into.
    fn stride(&self) -> usize;
}

impl<T: SlotStore> Storage for T {
    type Book = Book;
    type Generation = u32;
}
{% if lends %}

/// Storage the pool owns: `SLOT_COUNT` slots of `SLOT_SIZE` bytes, zero until
/// a slot is written. The document lends at run time (`<sce:lending>` or
/// `<sce:sharing>`, docs/adr/0111 D4), so the pool over it keeps the book.
pub struct Owned(core::cell::UnsafeCell<[SlotBytes; SLOT_COUNT]>);

impl Owned {
    const fn new() -> Self {
        Self(core::cell::UnsafeCell::new(
            [SlotBytes([0u8; SLOT_SIZE]); SLOT_COUNT],
        ))
    }
}

// SAFETY: the array is `SLOT_COUNT` slots of `SLOT_SIZE` bytes each on
// `ALIGNMENT` (`SlotBytes`), inside an `UnsafeCell`, so a pointer taken
// through a shared reference may write it; the pool that owns the store is
// the only thing that reaches it.
unsafe impl SlotStore for Owned {
    fn base(&self) -> *mut u8 {
        self.0.get().cast::<u8>()
    }

    fn stride(&self) -> usize {
        SLOT_SIZE
    }
}
{% else %}

/// Storage the pool owns: `SLOT_COUNT` slots of `SLOT_SIZE` bytes, zero until
/// a slot is written. The document lends every slot whole (docs/adr/0111 D4),
/// so the pool over it keeps one state byte per slot and a handle is the slot's
/// number: the layout, and the code, of a pool before the book.
#[repr(transparent)]
pub struct Owned([SlotBytes; SLOT_COUNT]);

impl Storage for Owned {
    type Book = [SlotState; SLOT_COUNT];
    type Generation = ();
}
{% endif %}

/// Storage the caller holds (ADR 0082), cut into slots of the length
/// [`{{ pascal_name }}::over`] was given. The pool holds the span's unique borrow for
/// `'a` and keeps the book of its lendings.
pub struct Over<'a> {
    base: core::ptr::NonNull<u8>,
    stride: usize,
    _span: PhantomData<&'a mut [u8]>,
}

// SAFETY: `over` checked that the span starts on `ALIGNMENT`, holds the count
// times the length, and that the length is a multiple of `ALIGNMENT` no
// greater than `SLOT_SIZE`; the span's unique borrow is held for `'a`.
unsafe impl SlotStore for Over<'_> {
    fn base(&self) -> *mut u8 {
        self.base.as_ptr()
    }

    fn stride(&self) -> usize {
        self.stride
    }
}

// SAFETY: an `Over` is the unique borrow of a byte span, which may move to
// another thread as the `&mut [u8]` it was made from may.
unsafe impl Send for Over<'_> {}

/// The book of a pool that lends at run time (docs/adr/0111 D4): one line per
/// slot the type can hold, the pool's own whatever its storage, and the
/// counters of what it refused. All zero for the pool of every slot with no
/// slot out.
pub struct Book {
    /// One line per slot of the bound.
    entries: [Entry; SLOT_COUNT],
    /// `SLOT_COUNT` less the run-time count: the slots this pool does not lend.
    /// Kept this way round so the pool of every slot is all zero.
    withheld: u32,
    /// Stale, forged or misplaced indices refused (`pool/ownership-violation`).
