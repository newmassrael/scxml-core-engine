#[test]
fn test_vector_{{ name }}_l{{ tv.source_line }}() {
    let actual = {{ name_pascal }} {
{% for f in tv.fields %}
        {{ f.name_snake }}: {{ f.value_literal_rust }},
{% endfor %}
    };
    let encoded = actual.encode_to_vec();
    let expected: &[u8] = {{ tv.bytes_literal_rust }};
    assert_eq!(
        encoded.as_slice(), expected,
        "<sce:test-vector> at SCXML L{{ tv.source_line }}: encode produced {:?}, expected {:?}",
        encoded, expected
    );
    let mut cursor = SceCursor::new(expected);
    let decoded = {{ name_pascal }}::decode(&mut cursor)
        .expect("<sce:test-vector> at SCXML L{{ tv.source_line }}: decode failed");
    assert_eq!(
        cursor.remaining(), 0,
        "<sce:test-vector> at SCXML L{{ tv.source_line }}: decode left {} bytes unconsumed",
        cursor.remaining()
    );
{% for f in tv.fields %}
    assert_eq!(
        decoded.{{ f.name_snake }}, {{ f.value_literal_rust }},
        "<sce:test-vector> at SCXML L{{ tv.source_line }}: field `{{ f.name_snake }}` mismatch"
    );
{% endfor %}
{% if codec_is_borrowed %}
    // Owned-projection round-trip (acceptance #2): deep-copy the borrowed
    // decode into its no-alloc owned mirror and assert every field still
    // equals the oracle. Owned `heapless::Vec<u8, N>` / `heapless::String<N>`
    // fields compare directly against the `&[u8]` / `&str` literals (both
    // deref to the slice / str). `try_into_owned` is fallible (the bounded
