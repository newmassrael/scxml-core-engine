/// A set of queryables: the ones a query reaches.
{{ queryable_derives_attr }}
pub struct LegSet {
    words: [u32; LEG_SET_WORDS],
}

impl LegSet {
    /// The set with no queryable in it.
    pub const EMPTY: LegSet = LegSet { words: [0; LEG_SET_WORDS] };

    /// Whether `leg` is in the set.
    pub const fn contains(&self, leg: Leg) -> bool {
        let i = leg.index();
        ((self.words[i / 32] >> (i % 32)) & 1) == 1
    }

    /// Put `leg` in the set.
    pub fn insert(&mut self, leg: Leg) {
        let i = leg.index();
        self.words[i / 32] |= 1 << (i % 32);
    }

    /// Whether no queryable is in the set.
    pub fn is_empty(&self) -> bool {
        self.words.iter().all(|w| *w == 0)
    }

    /// How many queryables are in the set.
    pub fn len(&self) -> usize {
        self.words.iter().map(|w| w.count_ones() as usize).sum()
    }

    /// The queryables in the set, in declaration order.
    pub fn iter(&self) -> impl Iterator<Item = Leg> + '_ {
        LEGS.iter().copied().filter(move |leg| self.contains(*leg))
    }
}

/// The queryables that answer a query for `query`, the key expression after
/// the node's own prefix (the empty string is the prefix itself).
///
/// An exact key is one comparison against each declared literal key; a key
/// with `*`, `**` or `$*` is intersected with each declared key chunk by chunk.
/// Neither allocates, and a query of any length costs time linear in its
/// length. A key no queryable answers gives the empty set.
pub fn answering(query: &str) -> LegSet {
    let mut set = LegSet::EMPTY;
    if keyexpr::is_literal(query) {
        match query {
{% for leg in legs %}{% if leg.key_is_literal %}            {{ leg.key_lit }} => set.insert(Leg::{{ leg.pascal }}),
{% endif %}{% endfor %}            _ => {}
        }
{% for leg in legs %}{% if not leg.key_is_literal %}        if keyexpr::intersects(query, {{ leg.key_lit }}) {
            set.insert(Leg::{{ leg.pascal }});
        }
{% endif %}{% endfor %}    } else {
{% for leg in legs %}        if keyexpr::intersects(query, {{ leg.key_lit }}) {
            set.insert(Leg::{{ leg.pascal }});
        }
{% endfor %}    }
    set
}
