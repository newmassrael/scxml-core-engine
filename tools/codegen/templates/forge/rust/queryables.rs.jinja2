{# Writes one value of a document. `n` is the value's context and `x` the expression that is it. #}
{%- macro put(n, x) -%}
{%- if n.kind == "bool" -%}json::put_bool(sink, {{ x }})?;
{%- elif n.kind == "uint" -%}json::put_u64(sink, u64::from({{ x }}))?;
{%- elif n.kind == "int" -%}json::put_i64(sink, i64::from({{ x }}))?;
{%- elif n.kind == "string" -%}{ let s: &str = {{ x }}; if s.len() > {{ n.max_len }} { return Err(WriteError::StringTooLong { field: "{{ n.path }}", max: {{ n.max_len }} }); } json::put_str(sink, s)?; }
{%- else -%}{{ n.fn_name }}({{ x }}, sink)?;
{%- endif -%}
{%- endmacro -%}
{#- Writes a value that may be absent: `null` when it is. `bound` is the expression holding the Option. -#}
{%- macro put_field(n, present_expr, bound) -%}
{%- if n.nullable -%}match {{ bound }} { Some(x) => { {{ put(n, n.some_expr) }} } None => json::put_null(sink)?, }
{%- else -%}{{ put(n, present_expr) }}
{%- endif -%}
{%- endmacro -%}

