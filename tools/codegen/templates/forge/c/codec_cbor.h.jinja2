    convention. Every CBOR item is the runtime's (`sce_forge_cbor_*`). A text that
    may be absent is held as every text of the machine is, a string ended by its
    terminator and with no length beside it, so a text that carries the byte the
    terminator is does not fit its entry. #}
{% macro decode_value(e) %}
{% if e.kind == "bool" %}
            s = sce_forge_cbor_read_bool(&c, &v->{{ e.value_ref }});
{% elif e.kind == "text" %}
            s = sce_forge_cbor_read_text(&c, {{ e.capacity }}, v->{{ e.data_ref }}, &{{ ("v->" ~ e.len_ref) if e.len_ref else "text_len" }});
{% elif e.kind == "bytes" %}
