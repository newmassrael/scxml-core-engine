{% elif e.kind == "bytes_exact" %}
            s = sce_forge_cbor_read_bytes_exact(&c, {{ e.capacity }}, v->{{ e.data_ref }});
            v->{{ e.len_ref }} = {{ e.capacity }};
{% elif e.kind == "enum" %}
            s = sce_forge_cbor_read_uint_upto(&c, {{ e.max }}U, &raw);
            if (s != SCE_FORGE_CODEC_OK) {
                return s;
            }
{% if e.enum_is_open %}
            v->{{ e.value_ref }} = {{ e.enum_from_underlying }}(({{ e.carrier_type }})raw);
{% else %}
            if (!{{ e.enum_from_underlying }}(({{ e.carrier_type }})raw, &v->{{ e.value_ref }})) {
                return SCE_FORGE_CODEC_UNDECLARED_ENUM_VALUE;
            }
{% endif %}
{% elif e.value_type == "uint64_t" %}
            s = sce_forge_cbor_read_uint(&c, &v->{{ e.value_ref }});
{% else %}
            s = sce_forge_cbor_read_uint_upto(&c, {{ e.max }}U, &raw);
            v->{{ e.value_ref }} = ({{ e.value_type }})raw;
{% endif %}
{% if e.kind != "enum" %}
            if (s != SCE_FORGE_CODEC_OK) {
                return s;
            }
{% endif %}
{% if e.kind == "text" and not e.len_ref %}
            if (strlen(v->{{ e.data_ref }}) != text_len) {
                return SCE_FORGE_CODEC_CBOR_OUT_OF_RANGE;
            }
{% endif %}
{% endmacro %}
{#- The write of one entry — its key, then its value — at indent `i`. #}
{% macro encode_entry(e, i) %}
{{ i }}s = sce_forge_cbor_write_uint(w, {{ e.key }}U);
{{ i }}if (s != SCE_FORGE_CODEC_OK) {
{{ i }}    return s;
{{ i }}}
{% if e.kind == "bool" %}
{{ i }}s = sce_forge_cbor_write_bool(w, self->{{ e.value_ref }});
{% elif e.kind == "text" and e.len_ref %}
{{ i }}if (self->{{ e.len_ref }} > {{ e.capacity }}U) {
{{ i }}    return SCE_FORGE_CODEC_CBOR_OUT_OF_RANGE;
{{ i }}}
{{ i }}s = sce_forge_cbor_write_text(w, self->{{ e.data_ref }}, self->{{ e.len_ref }});
{% elif e.kind == "text" %}
{#- A text that may be absent ends at its terminator, which its buffer, one byte
    past its bound, always has room for. #}
{{ i }}s = sce_forge_cbor_write_text(w, self->{{ e.data_ref }}, strlen(self->{{ e.data_ref }}));
{% elif e.kind == "bytes" %}
{{ i }}if (self->{{ e.len_ref }} > {{ e.capacity }}U) {
{{ i }}    return SCE_FORGE_CODEC_CBOR_OUT_OF_RANGE;
{{ i }}}
{{ i }}s = sce_forge_cbor_write_bytes(w, self->{{ e.data_ref }}, self->{{ e.len_ref }});
{% elif e.kind == "bytes_exact" %}
{{ i }}if (self->{{ e.len_ref }} != {{ e.capacity }}U) {
{{ i }}    return SCE_FORGE_CODEC_CBOR_WRONG_LENGTH;
{{ i }}}
{{ i }}s = sce_forge_cbor_write_bytes(w, self->{{ e.data_ref }}, {{ e.capacity }});
{% elif e.kind == "enum" %}
{% if e.carrier_signed %}
{#- A signed carrier's negative number is no CBOR unsigned integer; refused
    as the Rust backend refuses it. #}
{{ i }}if ({{ e.enum_to_underlying }} < 0) {
{{ i }}    return SCE_FORGE_CODEC_CBOR_OUT_OF_RANGE;
{{ i }}}
{% endif %}
{{ i }}s = sce_forge_cbor_write_uint(w, (uint64_t){{ e.enum_to_underlying }});
{% else %}
{{ i }}s = sce_forge_cbor_write_uint(w, (uint64_t)self->{{ e.value_ref }});
{% endif %}
{{ i }}if (s != SCE_FORGE_CODEC_OK) {
{{ i }}    return s;
