    if (count < 1u || count > {{ upper_name }}_SLOT_COUNT) return false;
    if (slot_len < 1u || slot_len > {{ upper_name }}_SLOT_SIZE || slot_len % {{ upper_name }}_ALIGNMENT != 0u) return false;
    if (bytes == NULL || len / slot_len < count) return false;
    if ((uintptr_t)(const void *)bytes % {{ upper_name }}_ALIGNMENT != 0u) return false;
    {{ snake_name }}_reset(count, bytes, slot_len);
    return true;
