    if (idx == SIZE_MAX) {
        SCE_OWNERSHIP_TAG_VIOLATION("{{ snake_name }}_{{ t.op_name }}: handle is not {{ t.from_spec }}");
        return false;
    }
{% if t.cache_clean %}
    /* C5 cache-clean on this edge (spec §synth-5-E line {{ t.spec_line }}). */
    sce_dcache_clean_by_addr({{ snake_name }}_slot_ptr(idx), {{ snake_name }}_slot_len());
{% endif %}
{% if t.cache_invalidate %}
    /* C5 cache-invalidate on this edge (spec §synth-5-E line {{ t.spec_line }}). */
    sce_dcache_invalidate_by_addr({{ snake_name }}_slot_ptr(idx), {{ snake_name }}_slot_len());
{% endif %}
{% if t.to_is_free %}
    {{ snake_name }}_free(idx);
{% else %}
    {{ snake_name }}_word_store(&{{ snake_name }}_book.entries[idx].state, (uint32_t)SCE_SLOT_{{ t.to_c }});
{% endif %}
{% if t.to_holdable %}
    handle->state = SCE_SLOT_{{ t.to_c }};
{% else %}
    /* `{{ t.to_spec }}` hands out no handle — the slot is the
       peripheral's until the completion edge mints a new one. */
    handle->state = SCE_SLOT_INVALID;
    handle->idx = SIZE_MAX;
{% endif %}
