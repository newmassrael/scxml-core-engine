    if (idx == SIZE_MAX) {
        SCE_OWNERSHIP_TAG_VIOLATION("{{ snake_name }}_{{ a.op_name }}: slot is not {{ a.state_spec }} (published before arming, or after the transfer started?)");
        return NULL;
