{% endif %}
{% endfor %}
/* Which slot a buffer address names, or `SIZE_MAX` for none.
 *
 * The return leg of address publication. Peripheral completion
 * callbacks conventionally hand back the buffer address they were
 * given (`rx_frame_cb(addr, len)`), while every edge back into the
 * pool is keyed by slot index. Without this the driver keeps a shadow
 * table of a layout the pool already knows, and a slip in that table
 * advances the wrong slot.
 *
 * Only an exact slot base resolves. An interior or foreign pointer is
 * `SIZE_MAX` rather than being rounded down to the slot containing it:
 * a completion naming an address the pool never published is a driver
 * bug, and rounding would turn it into a plausible-looking index.
 *
 * `SIZE_MAX` is the same not-a-slot sentinel `INVALID_HANDLE` carries,
 * and returning it by value rather than through an out-parameter keeps
 * the function free of a pointer whose ownership contract would have
 * to be either empty or false.
 *
 * Compared as `uintptr_t` rather than as pointers: a relational
 * comparison between pointers into different objects is undefined, and
 * a foreign pointer is precisely the case this has to answer for. */
static inline size_t {{ snake_name }}_slot_index_of_ptr(const void *ptr) {
    uintptr_t base = (uintptr_t)(const void *){{ snake_name }}_base();
    uintptr_t addr = (uintptr_t)ptr;
    size_t stride = {{ snake_name }}_slot_len();
    size_t offset;
    size_t idx;
    if (ptr == NULL || base == 0u || addr < base) return SIZE_MAX;
    offset = (size_t)(addr - base);
    if (offset % stride != 0) return SIZE_MAX;
    idx = offset / stride;
    return idx < {{ snake_name }}_count() ? idx : SIZE_MAX;
}

/* Inspect a slot's current lifecycle state. A slot the pool does not count
 * returns `SCE_SLOT_INVALID` so debug introspection cannot fault. */
static inline sce_slot_state_t {{ snake_name }}_slot_state(size_t idx) {
    if (idx >= {{ snake_name }}_count()) return SCE_SLOT_INVALID;
    return (sce_slot_state_t)({{ snake_name }}_word_load(&{{ snake_name }}_book.entries[idx].state) &
                              {{ upper_name }}_STATE_BITS);
}

/* Number of slots the pool counts that are free. */
static inline size_t {{ snake_name }}_free_count(void) {
    size_t n = 0;
    size_t count = {{ snake_name }}_count();
    for (size_t i = 0; i < count; ++i) {
        if ({{ snake_name }}_word_load(&{{ snake_name }}_book.entries[i].state) == (uint32_t)SCE_SLOT_FREE) {
            ++n;
        }
    }
    return n;
}

