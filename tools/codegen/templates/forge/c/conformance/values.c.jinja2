{# The values a fragment bakes from the oracle's JSON when the harness renders,
   shared by the fragments that bake one: an algorithm's arguments and answers,
   and a union fixture's values. Imported as a module
   (`{% import "values.c.jinja2" as values %}`), so each is spelled once. #}
{# A value of an enum, baked as the constant the enum fixture's header declares
   for the variant the oracle names, and compared as the number it is. #}
{% macro c_enum(variants, raw) %}{% for v in variants %}{% if v.name == raw %}{{ v.ident }}{% endif %}{% endfor %}{% endmacro %}
{# A record's field baked from the oracle's JSON `raw`. A record's text is the
   bounded buffer `{ char data[N + 1]; }`, which a string literal fills as its
   first member; it needs no storage of its own beside the case table. A field
   that holds a value of an enum is baked as the constant the enum fixture's
   header declares for the variant the oracle names. #}
{% macro c_field(fld, raw) %}{% if fld.enum_document is defined %}{{ c_enum(fld.variants, raw) }}{% elif fld.type == "string" %}{ {{ raw | c_literal(fld.type) }} }{% else %}{{ raw | c_literal(fld.type) }}{% endif %}{% endmacro %}
{# A value of the union `u` (docs/adr/0092), baked from the oracle's JSON `raw`,
   which holds the wire's object: the tag under its key, beside the fields of
   its case (section 2). The value is the union's struct with its tag the
   constant of the case the tag names and, where the case holds a record, that
   case's member of the union of records filled field by field; a designated
   initializer, which a static case table can hold, leaves every other byte of
   the value zero, as the unit's constructor of the case does. A tag that names
   no case bakes no value, and the table does not compile. #}
{% macro union_value(u, raw) %}{% for c in u.cases %}{% if c.variant == raw[u.tag] %}{ .{{ u.tag_member }} = {{ c.kind }}{% if c.record %}, .{{ u.cases_member }} = { .{{ c.ident }} = { {% for fld in c.record.fields %}.{{ fld.ident }} = {{ c_field(fld, raw[fld.name]) }}, {% endfor %}} }{% endif %} }{% endif %}{% endfor %}{% endmacro %}
