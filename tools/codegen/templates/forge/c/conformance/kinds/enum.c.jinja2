{# Enum kind — a named value vocabulary; pre-baked oracle.

   C11 has no zero-deps JSON parser inside this backend's dependency rule, so
   the expected values are materialised here as a static table rather than
   read at runtime. That is the same choice every other C11 fragment makes.

   C has no namespaces, so a variant is `<UPPER_FIXTURE>_<UPPER_VARIANT>`.
   The manifest carries the SOURCE spelling and this fragment applies C's
   filter — the contract the codec fragments use for field names, and the
   reason one manifest serves six arms whose conventions disagree.

   ⚠ NOTE THE ASYMMETRY, because it decides how this arm is mutation-tested.
   The other five arms READ the oracle at run time; this one BAKES from the
   MANIFEST, since C11 has no JSON parser here. So editing
   numerical_reference.json alone cannot reach this file — a mutation proof
   for the C11 arm has to move `fixtures.json`. Drift between the two sources
   is still caught, but by the other five: the C++ fragment asserts the
   oracle's variant NAME equals the manifest's at each index. #}
static void test_{{ f.name }}(void) {
    static const struct {
        const char *name;
        long long expected;
        long long actual;
    } variants[] = {
{% for v in f.variants %}
        { "{{ v.name }}", {{ v.value }}LL, (long long){{ f.name | upper }}_{{ v.name | to_upper_snake_case }} },
{% endfor %}
    };
    const size_t n = sizeof(variants) / sizeof(variants[0]);

    /* The count is baked from the manifest, so a vocabulary that gained or
     * lost a variant without the manifest moving fails to compile rather
     * than passing quietly — the table above names each constant. */
    for (size_t i = 0; i < n; ++i) {
        if (variants[i].actual != variants[i].expected) {
            fprintf(stderr,
                    "FAIL: {{ f.name }}.%s = %lld, expected %lld\n",
                    variants[i].name, variants[i].actual, variants[i].expected);
            ++g_failures;
        }
    }
}
