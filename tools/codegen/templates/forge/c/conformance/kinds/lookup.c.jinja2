{# Lookup kind — pre-baked oracle. C11 uses fully-qualified names per
   RFC §5.J.2 §3 D1 (`<m.name>_<output_id>`). For C11 the conformance
   preprocessor sets `f.function` to that composed name, so this
   fragment can use it verbatim for both function calls and the
   string-enum sibling helpers (`<f.function>_t`, `<f.function>_name`). #}
{% if f.output.type != "string" %}
static void test_{{ f.name }}(void) {
    static const struct {
        {{ f.args[0] | c_type }} arg0;
        {{ f.output.type | c_type }} expected;
    } cases[] = {
{% for c in f.cases %}
        { {{ c.args[0] | c_literal(f.args[0]) }}, {{ c.expected | c_literal(f.output.type) }} },
{% endfor %}
    };
    const size_t n = sizeof(cases) / sizeof(cases[0]);
    for (size_t i = 0; i < n; ++i) {
{% if f.on_miss == "error" %}
        {{ f.output.type | c_type }} actual;
        bool ok = {{ f.function }}(cases[i].arg0, &actual);
        if (!ok) {
            fprintf(stderr, "FAIL: {{ f.name }} case %zu: lookup miss on happy-path key\n", i);
            ++g_failures;
            continue;
        }
{% else %}
        {{ f.output.type | c_type }} actual = {{ f.function }}(cases[i].arg0);
{% endif %}
{% if f.output.compare == "tolerance" %}
        if (!close_enough((double)actual, (double)cases[i].expected, FLOAT_TOL)) {
            fprintf(stderr,
                "FAIL: {{ f.name }} case %zu: actual=%.17g expected=%.17g\n",
                i, (double)actual, (double)cases[i].expected);
            ++g_failures;
        }
{% else %}
        if (actual != cases[i].expected) {
            fprintf(stderr,
                "FAIL: {{ f.name }} case %zu: actual=%lld expected=%lld\n",
                i, (long long)actual, (long long)cases[i].expected);
            ++g_failures;
        }
{% endif %}
    }
}
{% else %}
static void test_{{ f.name }}(void) {
    static const struct {
        {{ f.args[0] | c_type }} arg0;
        const char *expected;
    } cases[] = {
{% for c in f.cases %}
        { {{ c.args[0] | c_literal(f.args[0]) }}, {{ c.expected | c_literal("string") }} },
{% endfor %}
    };
    const size_t n = sizeof(cases) / sizeof(cases[0]);
    for (size_t i = 0; i < n; ++i) {
        {{ f.function }}_t actual = {{ f.function }}(cases[i].arg0);
        const char *actual_name = {{ f.function }}_name(actual);
        if (actual_name == (const char *)0 || strcmp(actual_name, cases[i].expected) != 0) {
            fprintf(stderr,
                "FAIL: {{ f.name }} case %zu: actual=%s expected=%s\n",
                i, actual_name ? actual_name : "(null)", cases[i].expected);
            ++g_failures;
        }
    }
}
{% endif %}
