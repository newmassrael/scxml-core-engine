{# Timer kind — verify HAL registration metadata + callback dispatch via
   recording mocks. cpp uses inline-defined `RecTimer : ITimer` and
   `RecHandler` structs; the C11 mirror builds the equivalent with an
   explicit vtable struct embedded as the first member of the recording
   timer (downcast inside the start_periodic / start_one_shot bodies).

   Manifest assumption: `f.timers[*].callback` is unique per fixture
   (one handler slot per timer). The current oracle catalog satisfies
   this; if a future fixture aliases two timers to the same callback,
   add per-fixture dedup at render time and pass `unique_callbacks` to
   the harness context (mirroring render_timer's product-codegen path). #}
{% set _snake = f.name | to_snake_case %}

typedef struct {
    {{ _snake }}_itimer_t base;
    const char *type;
    uint32_t ms;
    {{ _snake }}_timer_cb_t cb;
    void *cb_ctx;
} {{ _snake }}_rec_timer_t;

static void {{ _snake }}_rec_start_periodic({{ _snake }}_itimer_t *base, uint32_t ms,
        {{ _snake }}_timer_cb_t cb, void *ctx) {
    {{ _snake }}_rec_timer_t *self = ({{ _snake }}_rec_timer_t *)base;
    self->type = "periodic";
    self->ms = ms;
    self->cb = cb;
    self->cb_ctx = ctx;
}

static void {{ _snake }}_rec_start_one_shot({{ _snake }}_itimer_t *base, uint32_t ms,
        {{ _snake }}_timer_cb_t cb, void *ctx) {
    {{ _snake }}_rec_timer_t *self = ({{ _snake }}_rec_timer_t *)base;
    self->type = "one_shot";
    self->ms = ms;
    self->cb = cb;
    self->cb_ctx = ctx;
}

static void {{ _snake }}_rec_cancel({{ _snake }}_itimer_t *base) {
    (void)base;
}

static char {{ _snake }}_rec_last_call[64] = "";

{% for t in f.timers %}
static void {{ _snake }}_rec_{{ t.callback | to_snake_case }}(void *user_data) {
    (void)user_data;
    snprintf({{ _snake }}_rec_last_call, sizeof({{ _snake }}_rec_last_call),
             "{{ t.callback }}");
}
{% endfor %}

static void test_{{ f.name }}(void) {
    /* Reset shared recorder so prior fixtures do not bleed. */
    {{ _snake }}_rec_last_call[0] = '\0';

{% for t in f.timers %}
    {{ _snake }}_rec_timer_t {{ t.id | to_snake_case }} = {
        .base = { {{ _snake }}_rec_start_periodic,
                  {{ _snake }}_rec_start_one_shot,
                  {{ _snake }}_rec_cancel },
        .type = NULL, .ms = 0, .cb = NULL, .cb_ctx = NULL,
    };
{% endfor %}

    {{ _snake }}_handler_t handler = {
        .user_data = NULL,
{% for t in f.timers %}
        .{{ t.callback | to_snake_case }} = {{ _snake }}_rec_{{ t.callback | to_snake_case }},
{% endfor %}
    };

    {{ _snake }}_t scheduler;
    {{ _snake }}_init(&scheduler, handler{% for t in f.timers %},
        &{{ t.id | to_snake_case }}.base{% endfor %});

{% for t in f.timers %}
    {{ _snake }}_start_{{ t.id | to_snake_case }}(&scheduler);
{% endfor %}

    /* Per-timer oracle check: registration type + interval + callback dispatch. */
    static const struct {
        const char *type;
        uint32_t interval_ms;
        const char *callback;
    } oracle[] = {
{% for t in f.timers %}
        { "{{ t.timer_type }}", {{ t.interval_ms }}, "{{ t.callback }}" }{% if not loop.last %},{% endif %}

{% endfor %}
    };

{% for t in f.timers %}
    if ({{ t.id | to_snake_case }}.type == NULL
        || strcmp({{ t.id | to_snake_case }}.type, oracle[{{ loop.index0 }}].type) != 0) {
        fprintf(stderr,
            "FAIL: {{ f.name }}: {{ t.id }} type mismatch (got %s, expected %s)\n",
            {{ t.id | to_snake_case }}.type ? {{ t.id | to_snake_case }}.type : "(null)",
            oracle[{{ loop.index0 }}].type);
        ++g_failures;
    }
    if ({{ t.id | to_snake_case }}.ms != oracle[{{ loop.index0 }}].interval_ms) {
        fprintf(stderr,
            "FAIL: {{ f.name }}: {{ t.id }} interval mismatch (got %u, expected %u)\n",
            (unsigned)({{ t.id | to_snake_case }}.ms),
            (unsigned)(oracle[{{ loop.index0 }}].interval_ms));
        ++g_failures;
    }
    {{ _snake }}_rec_last_call[0] = '\0';
    if ({{ t.id | to_snake_case }}.cb != NULL) {
        {{ t.id | to_snake_case }}.cb({{ t.id | to_snake_case }}.cb_ctx);
    }
    if (strcmp({{ _snake }}_rec_last_call, oracle[{{ loop.index0 }}].callback) != 0) {
        fprintf(stderr,
            "FAIL: {{ f.name }}: {{ t.id }} callback mismatch (got %s, expected %s)\n",
            {{ _snake }}_rec_last_call, oracle[{{ loop.index0 }}].callback);
        ++g_failures;
    }
{% endfor %}
}
