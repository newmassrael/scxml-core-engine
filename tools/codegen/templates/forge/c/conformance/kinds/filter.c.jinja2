{# Filter kind — stateful update over a fixed input/expected sequence.
   Oracle is pre-baked into the harness source (RFC §synth-5-J-2 F7). #}
static void test_{{ f.name }}(void) {
    static const struct {
        {{ f.input | c_type }} input;
        {{ f.output["type"] | c_type }} expected;
    } seq[] = {
{% for step in f.sequence %}
        { {{ step.input | c_literal(f.input) }}, {{ step.expected | c_literal(f.output["type"]) }} }{% if not loop.last %},{% endif %}

{% endfor %}
    };
    {{ f.name | to_snake_case }}_t filter = {0};
    const size_t n = sizeof(seq) / sizeof(seq[0]);
    for (size_t i = 0; i < n; ++i) {
        {{ f.output["type"] | c_type }} actual =
            {{ f.name | to_snake_case }}_update(&filter, seq[i].input);
{% if f.output.compare == "tolerance" %}
        if (!close_enough((double)actual, (double)seq[i].expected, FLOAT_TOL)) {
            fprintf(stderr,
                "FAIL: {{ f.name }} step %zu: actual=%.17g expected=%.17g\n",
                i, (double)actual, (double)seq[i].expected);
            ++g_failures;
        }
{% else %}
        if (actual != seq[i].expected) {
            fprintf(stderr,
                "FAIL: {{ f.name }} step %zu: actual=%d expected=%d\n",
                i, (int)actual, (int)seq[i].expected);
            ++g_failures;
        }
{% endif %}
    }
}
