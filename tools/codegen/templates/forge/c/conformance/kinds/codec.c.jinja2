{# Codec kind — round-trip { decoded, encoded } cases. C11 uses the
   header's `<f.name>_t` struct + writer-based encode() per RFC §synth-5-B
   Cursor-based status decode() per RFC §synth-5-B L494-519.

   Bytes / String fields surface as a buffer + len pair on both the
   case struct and the codec struct (V1β); they assign via `memcpy`
   and round-trip via `memcmp` + length compare. Bytes uses
   `uint8_t[256]`; String uses `char[256]` (matches the codec struct's
   UTF-8 storage shape). Buffer width is fixed at the runtime
   `BYTES_DEFAULT_MAX` (256) so the case struct fits every codec
   fixture without per-fixture resizing.

   When a sibling scalar field's name matches `<payload>_len` (e.g. a
   VLE prefix named `locator_len` in front of a string `locator`), the
   case-struct `_len` companion is suppressed — the sibling already
   owns that identifier (mirrors the codec product header's
   `c_emit_len_member` collision-avoidance). #}
static void test_{{ f.name }}(void) {
{% if not f.oracle_eligible %}
    /* Compile-only probe: oracle_eligible=false because the fixture's
     * field shape isn't expressible in the current StructField /
     * CanonicalType schema (typed nested codec, length+ptr-pair
     * optional, or parent-flag-bearing carrier). The fixture's #include
     * in the harness scaffold already proved the header parses. This
     * zero-init drags the per-field offsets and the encode/decode
     * static-inline definitions through the C compiler so a silently-
     * broken-codegen regression of commit 91ae355a's class surfaces
     * here before reaching consumers. */
    {{ f.name }}_t _codec_val;
    memset(&_codec_val, 0, sizeof(_codec_val));
    (void)_codec_val;
{% else %}
    typedef struct {
{% for field in f.fields %}
{% set sibling_owns_len = (f.fields | selectattr('name', 'equalto', field.name + '_len') | list | length) > 0 %}
{% if field.type == "bytes" %}
        uint8_t input_{{ field.name | to_snake_case }}[256];
{% if not sibling_owns_len %}
        size_t  input_{{ field.name | to_snake_case }}_len;
{% endif %}
{% elif field.type == "string" %}
        char    input_{{ field.name | to_snake_case }}[256];
{% if not sibling_owns_len %}
        size_t  input_{{ field.name | to_snake_case }}_len;
{% endif %}
{% else %}
        {{ field.type | c_type }} input_{{ field.name | to_snake_case }};
{% endif %}
{% endfor %}
        size_t expected_len;
        uint8_t expected_bytes[256];
    } {{ f.name }}_case_t;
    static const {{ f.name }}_case_t cases[] = {
{% for c in f.cases %}
        {
{% for field in f.fields %}
{% set sibling_owns_len = (f.fields | selectattr('name', 'equalto', field.name + '_len') | list | length) > 0 %}
{% if field.type == "bytes" %}
            .input_{{ field.name | to_snake_case }} = {{ c.decoded[field.name] | c_literal(field.type) }},
{% if not sibling_owns_len %}
            .input_{{ field.name | to_snake_case }}_len = {{ c.decoded[field.name] | length }},
{% endif %}
{% elif field.type == "string" %}
            .input_{{ field.name | to_snake_case }} = {{ c.decoded[field.name] | c_literal(field.type) }},
{% if not sibling_owns_len %}
            .input_{{ field.name | to_snake_case }}_len = {{ c.decoded[field.name] | length }},
{% endif %}
{% else %}
            .input_{{ field.name | to_snake_case }} = {{ c.decoded[field.name] | c_literal(field.type) }},
{% endif %}
{% endfor %}
            .expected_len = {{ c.encoded | length }},
            .expected_bytes = { {% if c.encoded %}{% for b in c.encoded %}{{ b }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}0{% endif %} },
        },
{% endfor %}
    };
    const size_t n = sizeof(cases) / sizeof(cases[0]);
    for (size_t i = 0; i < n; ++i) {
        {{ f.name }}_t val;
{% for field in f.fields %}
{% set sibling_owns_len = (f.fields | selectattr('name', 'equalto', field.name + '_len') | list | length) > 0 %}
{% if field.type in ("bytes", "string") %}
{% set len_src = "cases[i].input_" + (field.name | to_snake_case) + "_len" %}
{% if sibling_owns_len %}
{% set len_src = "cases[i].input_" + field.name + "_len" %}
{% endif %}
        memcpy(val.{{ field.name | to_snake_case }}, cases[i].input_{{ field.name | to_snake_case }}, {{ len_src }});
        val.{{ field.name | to_snake_case }}_len = {{ len_src }};
{% else %}
        val.{{ field.name | to_snake_case }} = cases[i].input_{{ field.name | to_snake_case }};
{% endif %}
{% endfor %}
{% set max_macro = (f.name | to_upper_snake_case) ~ "_MAX_BYTES" %}
        /* C11 §6.7.6.2: an array size must be non-zero. Empty-body codecs
         * report MAX_BYTES == 0, so floor the encode scratch buffer at 1
         * byte (the encoder writes 0 bytes into it). Mirrors the codec
         * struct's `_reserved` placeholder for the same C11 constraint. */
        uint8_t encoded_buf[{{ max_macro }} > 0u ? {{ max_macro }} : 1u];
        size_t encoded_len = 0;
        sce_forge_codec_status_t _enc_st = {{ f.name }}_encode_to_buf(&val, encoded_buf, sizeof(encoded_buf), &encoded_len);
        if (_enc_st != SCE_FORGE_CODEC_OK ||
            encoded_len != cases[i].expected_len ||
            memcmp(encoded_buf, cases[i].expected_bytes, cases[i].expected_len) != 0) {
            fprintf(stderr,
                "FAIL: {{ f.name }} case %zu encode: len actual=%zu expected=%zu\n",
                i, encoded_len, cases[i].expected_len);
            ++g_failures;
            continue;
        }
        {{ f.name }}_t round_tripped;
        sce_forge_cursor_t cursor = sce_forge_cursor_init(cases[i].expected_bytes, cases[i].expected_len);
        if ({{ f.name }}_decode(&cursor, &round_tripped) != SCE_FORGE_CODEC_OK) {
            fprintf(stderr, "FAIL: {{ f.name }} case %zu decode: returned non-ok\n", i);
            ++g_failures;
            continue;
        }
{% for field in f.fields %}
{% set sibling_owns_len = (f.fields | selectattr('name', 'equalto', field.name + '_len') | list | length) > 0 %}
{% if field.type in ("bytes", "string") %}
{% set len_src = "cases[i].input_" + (field.name | to_snake_case) + "_len" %}
{% if sibling_owns_len %}
{% set len_src = "cases[i].input_" + field.name + "_len" %}
{% endif %}
        if ((size_t)round_tripped.{{ field.name | to_snake_case }}_len != (size_t){{ len_src }} ||
            memcmp(round_tripped.{{ field.name | to_snake_case }}, cases[i].input_{{ field.name | to_snake_case }}, {{ len_src }}) != 0) {
            fprintf(stderr,
                "FAIL: {{ f.name }} case %zu decode field {{ field.name }}: actual_len=%zu expected_len=%zu\n",
                i, (size_t)round_tripped.{{ field.name | to_snake_case }}_len, (size_t){{ len_src }});
            ++g_failures;
        }
{% else %}
        if (round_tripped.{{ field.name | to_snake_case }} != cases[i].input_{{ field.name | to_snake_case }}) {
            fprintf(stderr,
                "FAIL: {{ f.name }} case %zu decode field {{ field.name }}: actual=%lld expected=%lld\n",
                i, (long long)round_tripped.{{ field.name | to_snake_case }}, (long long)cases[i].input_{{ field.name | to_snake_case }});
            ++g_failures;
        }
{% endif %}
{% endfor %}
    }
{% endif %}
}
