{# Interpolation kind — pure <snake>_lookup(args) -> double, tolerance-compared.
   Oracle is pre-baked into the harness source (RFC §5.J.2 F7). #}
static void test_{{ f.name }}(void) {
    static const struct {
{% for arg_ty in f.args %}
        {{ arg_ty | c_type }} arg{{ loop.index0 }};
{% endfor %}
        double expected;
    } cases[] = {
{% for c in f.cases %}
        { {% for arg_ty in f.args %}{{ c.args[loop.index0] | c_literal(arg_ty) }}{% if not loop.last %}, {% endif %}{% endfor %}, {{ c.expected | c_literal("f64") }} }{% if not loop.last %},{% endif %}

{% endfor %}
    };
    const size_t n = sizeof(cases) / sizeof(cases[0]);
    for (size_t i = 0; i < n; ++i) {
        double actual = {{ f.name | to_snake_case }}_lookup({% for arg_ty in f.args %}cases[i].arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %});
        if (!close_enough(actual, cases[i].expected, FLOAT_TOL)) {
            fprintf(stderr,
                "FAIL: {{ f.name }} case %zu: actual=%.17g expected=%.17g\n",
                i, actual, cases[i].expected);
            ++g_failures;
        }
    }
}
