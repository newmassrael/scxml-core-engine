{% endfor %}

static int g_failures = 0;

static const double FLOAT_TOL = {{ float_tolerance }};

static int close_enough(double actual, double expected, double tol) {
    double diff = actual - expected;
    if (diff < 0.0) {
        diff = -diff;
    }
    return diff <= tol;
}

{% for f in fixtures %}
/* ── {{ f.kind }}: {{ f.name }} ──────────────────────────── */
{% set _kind_tmpl = "kinds/" ~ f.kind ~ ".c.jinja2" %}
