/*
 * Cross-language numerical conformance harness (C11 half).
 * AUTO-GENERATED by `sce-codegen generate-conformance` — do not edit.
 *
 * Single source of truth for the fixture catalog is
 * tests/forge/conformance/fixtures.json. The oracle values come from
 * tests/forge/conformance/numerical_reference.json and are pre-baked
 * into this file as `static const` C arrays at codegen time
 * (RFC §5.J.2 F7 — C has no zero-deps JSON parser surviving the R3
 * lock-in, so the oracle is materialised here).
 *
 * This scaffold is kind-agnostic; the body of each test_<fixture>
 * function comes from kinds/<kind>.c.jinja2 via dynamic include.
 * Adding a new fixture kind means one new kind fragment, zero edits
 * to this scaffold.
 */

#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdio.h>
#include <math.h>

{% for f in fixtures %}
