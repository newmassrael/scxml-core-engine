        input.len = sizeof row_bytes;
{% endif %}
{% set call %}{{ primary_symbol }}((sce_forge_bytes_view_t){ input.data, input.len }){% endset %}
{% else %}
{% set call %}{{ primary_symbol }}(){% endset %}
{% endif %}
{% if may_fail %}
        /* SCE_FORGE.md §3.4.1: a row expects a value, so a failure fails it. */
        const {{ primary_symbol }}_result_t result = {{ call }};
        {{ return_type }} actual = result.value;
{% else %}
        {{ return_type }} actual = {{ call }};
{% endif %}
        const {{ return_type }} expected = {{ tv.value_literal_c }};
{% if may_fail %}
        if (!result.ok) {
            sce_text_writer_t _report = sce_forge_test_vector_line(_line, sizeof _line, {{ tv.source_line }}u);
            SCE_TEXT_PUT_LITERAL(&_report, "failed with ");
