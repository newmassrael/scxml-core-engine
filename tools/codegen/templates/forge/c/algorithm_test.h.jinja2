        } else if (actual != expected) {
{% else %}
        if (actual != expected) {
{% endif %}
            sce_text_writer_t _report = sce_forge_test_vector_line(_line, sizeof _line, {{ tv.source_line }}u);
{% if tv.value_text_c == "hex" %}
            SCE_TEXT_PUT_LITERAL(&_report, "actual=0x");
