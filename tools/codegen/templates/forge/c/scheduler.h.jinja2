/* SCE Forge: Auto-generated per-machine cooperative scheduler */
/* Runtime: sce-c-runtime (MCU `bare_metal` target) */
/* Machine: {{ machine_name }} */
/* Do not edit — regenerate from deploy.yaml + the source forge link docs. */
/*
 * watching-zenoh RFC §synth-5-N lines 3050-3055 (item C10, MCU path).
 * The cooperative scheduler's tick loop polls each link's
 * `ops->poll(self, deadline_us)` in a fixed round-robin per spec
 * line 3050; the per-link work cap is `per_link_budget_us = {{ per_link_budget_us }}` µs.
 * Starvation guarantee (spec line 3053-3055): no link can starve
 * another because the round-robin order is deterministic and the
 * budget caps per-link work per tick.
 */

#ifndef {{ guard }}
#define {{ guard }}

#include <stdint.h>
#include <stddef.h>

#include "sce/forge/link.h"

#ifdef __cplusplus
extern "C" {
#endif

/* Cooperative scheduler tick budget — total tick period in
 * microseconds. Sourced from `scheduler.tick_period_us` on this
 * machine's deploy entry. */
#define SCE_FORGE_{{ machine_upper }}_TICK_PERIOD_US ({{ tick_period_us }}u)

/* Per-link work cap per tick — sourced from
 * `scheduler.per_link_budget_us`. Consumed directly by every
 * `ops->poll(self, deadline_us)` call site; deploy parse-time
 * validators pin `per_link_budget_us × links.len() ≤ tick_period_us`. */
#define SCE_FORGE_{{ machine_upper }}_PER_LINK_BUDGET_US ({{ per_link_budget_us }}u)

/* Round-robin link count for this machine. */
#define SCE_FORGE_{{ machine_upper }}_LINK_COUNT ({{ link_count }}u)

/* Round-robin link order — declaration order from deploy.yaml so the
 * starvation guarantee is reproducible across rebuilds. Spec line 3053:
 * "Scheduler emits a round-robin visit-order invariant: no link can
 * starve another." */
static const char *const SCE_FORGE_{{ machine_upper }}_LINK_ORDER[SCE_FORGE_{{ machine_upper }}_LINK_COUNT] = {
{% for link in links %}    "{{ link.name }}",
{% endfor %}};

/* Tick the cooperative scheduler once. The caller passes an array of
 * `sce_forge_link_t` driver handles in `LINK_ORDER` order; the
 * scheduler invokes each driver's `ops->poll(self,
 * PER_LINK_BUDGET_US)` exactly once per tick. Decoded frames stay in
 * the driver's internal queue and are retrieved via `ops->rx` at the
 * SCXML interpreter's cadence (the scheduler does not dispatch
 * frames itself — split responsibility per RFC §synth-5-N + the sce-link-
 * runtime contract).
 *
 * One tick boundary is the caller's responsibility (typical MCU
 * shape: `SysTick` IRQ wakes a main-loop ticker that invokes
 * `{{ machine_snake }}_scheduler_tick()` once per `TICK_PERIOD_US`). */
static inline void {{ machine_snake }}_scheduler_tick(
    sce_forge_link_t *const drivers[SCE_FORGE_{{ machine_upper }}_LINK_COUNT]) {
    for (size_t i = 0; i < SCE_FORGE_{{ machine_upper }}_LINK_COUNT; ++i) {
        sce_forge_link_t *const drv = drivers[i];
        if (drv != NULL && drv->ops != NULL && drv->ops->poll != NULL) {
            drv->ops->poll(drv->self, SCE_FORGE_{{ machine_upper }}_PER_LINK_BUDGET_US);
        }
    }
}

#ifdef __cplusplus
}  /* extern "C" */
#endif

#endif /* {{ guard }} */
