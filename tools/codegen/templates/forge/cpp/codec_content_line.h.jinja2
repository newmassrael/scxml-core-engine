{% macro read_value(e) %}
{% if e.kind == "string" %}
                auto v = line->read_string({{ e.max_size }}, {{ "true" if e.text else "false" }});
                if (!v) return std::nullopt;
                {{ store(e, "std::move(*v)") }}
{% elif e.kind == "bool" %}
                const auto v = line->read_bool();
                if (!v) return std::nullopt;
                {{ store(e, "*v") }}
{% elif e.kind == "uint" %}
                const auto raw = line->read_uint(static_cast<std::uint64_t>(std::numeric_limits<{{ e.value_type }}>::max()));
                if (!raw) return std::nullopt;
                {{ store(e, "static_cast<" ~ e.value_type ~ ">(*raw)") }}
{% else %}
                const auto raw = line->read_int(static_cast<std::int64_t>(std::numeric_limits<{{ e.value_type }}>::min()),
                                                static_cast<std::int64_t>(std::numeric_limits<{{ e.value_type }}>::max()));
                if (!raw) return std::nullopt;
                {{ store(e, "static_cast<" ~ e.value_type ~ ">(*raw)") }}
{% endif %}
{% endmacro %}
{#- The write of one property's value `v`, its name and parameters already
    written. #}
{% macro write_value(e) %}
{% if e.kind == "string" %}
            if (auto e = out.string(v, {{ "true" if e.text else "false" }}, {{ e.max_size }})) return e;
{% elif e.kind == "bool" %}
            if (auto e = out.boolean(v)) return e;
{% elif e.kind == "uint" %}
            if (auto e = out.uint(static_cast<std::uint64_t>(v))) return e;
{% else %}
            if (auto e = out.integer(static_cast<std::int64_t>(v))) return e;
{% endif %}
{% endmacro %}
{#- The parameters of a property, each written when present. #}
{% macro write_params(e) %}
{% for p in e.params %}
{% if p.required %}
            if (auto e = out.param("{{ p.param }}", {{ p.name }}, {{ p.max_size }})) return e;
{% else %}
            if ({{ p.name }}.has_value()) {
                if (auto e = out.param("{{ p.param }}", *{{ p.name }}, {{ p.max_size }})) return e;
            }
{% endif %}
{% endfor %}
{% endmacro %}
