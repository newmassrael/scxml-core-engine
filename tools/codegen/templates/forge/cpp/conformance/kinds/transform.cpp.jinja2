{# Transform kind — pure free function(s), single or compound output; or,
   for a document that reads a field through previous(), its holder driven
   through the oracle's sequence twice: from a new holder, then after
   reset(). Both passes are held to the same oracle, which is what says
   reset() restores every kept value. #}
    const auto &spec = ref["{{ f.ref_section }}"]["{{ f.name }}"];
{% if f.holder %}
    auto holder = SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.holder.new }}();
    for (int pass = 0; pass < 2; ++pass) {
        if (pass == 1) {
            holder.{{ f.holder.reset }}();
        }
        std::size_t i = 0;
        for (const auto &step : spec["sequence"]) {
{% for arg_ty in f.args %}
            auto arg{{ loop.index0 }} = step["args"][{{ loop.index0 }}].get<{{ arg_ty | cpp_type }}>();
{% endfor %}
            const auto out = holder.{{ f.holder.update }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %});
{% for co in f.compound_outputs %}
            auto expected_{{ co.key }} = step["expected"]["{{ co.key }}"].get<{{ co["type"] | cpp_type }}>();
{% if co.compare == "tolerance" %}
            assert_close(out.{{ co.field }}, expected_{{ co.key }}, tol, "{{ f.name }} {{ co.key }}");
{% else %}
            CHECK(out.{{ co.field }} == expected_{{ co.key }},
                  "{{ f.name }} pass %d step %zu {{ co.key }}: actual=%lld expected=%lld",
                  pass, i, static_cast<long long>(out.{{ co.field }}),
                  static_cast<long long>(expected_{{ co.key }}));
{% endif %}
{% endfor %}
            ++i;
        }
    }
{% else %}
    for (const auto &c : spec["cases"]) {
{% for arg_ty in f.args %}
        auto arg{{ loop.index0 }} = c["args"][{{ loop.index0 }}].get<{{ arg_ty | cpp_type }}>();
{% endfor %}
{% if f.output %}
{# ⚠ Honour `compare`. C++ let the single-output arm assume floats for longer
   than the others because `double actual = <int32 returning call>` converts
   implicitly — `transform_rounding` PASSED here while Rust and Kotlin would
   not compile. Passing was the problem: the manifest asked for equality and
   got a tolerance comparison, which is a weaker assertion that would also
   accept an off-by-a-fraction answer. #}
{% if f.output.compare == "tolerance" %}
        auto expected = c["expected"].get<double>();
        double actual = SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.output.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %});
        assert_close(actual, expected, tol, "{{ f.name }}");
{% else %}
        auto expected = c["expected"].get<{{ f.output["type"] | cpp_type }}>();
        auto actual = SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.output.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %});
        CHECK(actual == expected, "{{ f.name }}: actual=%lld expected=%lld",
              static_cast<long long>(actual), static_cast<long long>(expected));
{% endif %}
{% else %}
{% for co in f.compound_outputs %}
        auto expected_{{ co.key }} = c["expected"]["{{ co.key }}"].get<{{ co["type"] | cpp_type }}>();
        auto actual_{{ co.key }} = SCE::Generated::{{ f.name | to_pascal_case }}::{{ co.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %});
{% if co.compare == "tolerance" %}
        assert_close(actual_{{ co.key }}, expected_{{ co.key }}, tol, "{{ f.name }} {{ co.key }}");
{% else %}
        CHECK(actual_{{ co.key }} == expected_{{ co.key }},
              "{{ f.name }} {{ co.key }}: actual=%u expected=%u",
              static_cast<unsigned>(actual_{{ co.key }}),
              static_cast<unsigned>(expected_{{ co.key }}));
{% endif %}
{% endfor %}
{% endif %}
    }
{% endif %}
