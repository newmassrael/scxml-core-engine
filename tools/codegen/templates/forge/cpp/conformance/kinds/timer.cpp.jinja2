{# Timer kind — verify registration metadata and callback dispatch via recording mocks. #}
    const auto &spec = ref["{{ f.ref_section }}"]["{{ f.name }}"];
    const auto &oracle_timers = spec["timers"];

    struct Reg { std::string type; std::uint32_t ms; SCE::Forge::TimerCallback cb; void *ctx; };
    struct RecTimer : SCE::Forge::ITimer {
        Reg reg{};
        void startPeriodic(std::uint32_t ms, SCE::Forge::TimerCallback cb, void *ctx) override {
            reg = {"periodic", ms, cb, ctx};
        }
        void startOneShot(std::uint32_t ms, SCE::Forge::TimerCallback cb, void *ctx) override {
            reg = {"one_shot", ms, cb, ctx};
        }
        void cancel() override {}
    };
    struct RecHandler {
        std::string last_call;
{% for t in f.timers %}
        void {{ t.callback | to_camel_case }}() { last_call = "{{ t.callback }}"; }
{% endfor %}
    };

    RecHandler handler;
{% for t in f.timers %}
    RecTimer timer_{{ t.id | to_snake_case }};
{% endfor %}
    SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.name | to_pascal_case }}<RecHandler> scheduler(
        handler{% for t in f.timers %}, timer_{{ t.id | to_snake_case }}{% endfor %});
{% for t in f.timers %}
    scheduler.start{{ t.id | to_pascal_case }}();
{% endfor %}

    for (std::size_t ti = 0; ti < oracle_timers.size(); ++ti) {
        const auto &ot = oracle_timers[ti];
        std::string exp_type = ot["type"].get<std::string>();
        auto exp_ms = ot["interval_ms"].get<std::uint32_t>();
        std::string exp_cb = ot["callback"].get<std::string>();
{% for t in f.timers %}
{% if loop.index0 == 0 %}
        if (ti == {{ loop.index0 }}) {
{% else %}
        } else if (ti == {{ loop.index0 }}) {
{% endif %}
            CHECK(timer_{{ t.id | to_snake_case }}.reg.type == exp_type,
                  "{{ f.name }}: {{ t.id }} type mismatch");
            CHECK(timer_{{ t.id | to_snake_case }}.reg.ms == exp_ms,
                  "{{ f.name }}: {{ t.id }} interval mismatch");
            timer_{{ t.id | to_snake_case }}.reg.cb(timer_{{ t.id | to_snake_case }}.reg.ctx);
            CHECK(handler.last_call == exp_cb,
                  "{{ f.name }}: {{ t.id }} callback mismatch");
{% endfor %}
        }
    }
