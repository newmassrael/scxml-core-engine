{# Codec kind — round-trip { decoded, encoded } cases. Each case binds the
   per-field oracle values under an `input_<field>` prefix, assigns them
   to a `_codec_val` temporary via member access (C++17-safe, no designated
   initializers), then calls `encode_to_vec()`. `round_tripped` holds the
   `decode()` result for reverse-direction assertions.

   Naming convention matches the Rust/Kotlin/Python codec fragments — any
   SCXML field name (including `value`, `data`, `result`, etc.) is safe
   because local bindings are all `input_<field>` and never bare. #}
{% if not f.oracle_eligible %}
    // Compile-only probe: oracle_eligible=false because the fixture's
    // field shape isn't expressible in the current StructField /
    // CanonicalType schema (typed nested codec, std::optional, or
    // parent-flag-bearing carrier). The fixture's #include in the
    // harness scaffold already proved the header parses; this default
    // construction drags the type's pub API through the C++ type
    // checker so a silently-broken-codegen regression of commit
    // 91ae355a's class surfaces here before reaching consumers.
    // The harness scaffold passes `ref` by reference to every
    // per-fixture test function — silence -Werror=unused-parameter
    // here since the compile-only path doesn't read the oracle.
    (void)ref;
    {
        SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.name | to_pascal_case }} _codec_val{};
        (void)_codec_val;
    }
{% else %}
    const auto &spec = ref["{{ f.ref_section }}"]["{{ f.name }}"];
    int i = 0;
    for (const auto &case_entry : spec["cases"]) {
{% if f.fields %}
        const auto &decoded_json = case_entry["decoded"];
{# A field the encode derives is no element of a printed value, so it is
   neither read from the case nor read back (docs/adr/0081 §3). #}
{% for field in f.fields if not (f.cpp_printed and field.derived) %}
{% if field.optional %}
        {# An absent entry is JSON `null` in the case and empty in the struct. #}
        std::optional<{{ field.type | cpp_type }}> input_{{ field.name }};
        if (!decoded_json["{{ field.name }}"].is_null()) {
            input_{{ field.name }} = decoded_json["{{ field.name }}"].get<{{ field.type | cpp_type }}>();
        }
{% else %}
        auto input_{{ field.name }} = decoded_json["{{ field.name }}"].get<{{ field.type | cpp_type }}>();
{% endif %}
{% endfor %}
{% endif %}
        std::vector<std::uint8_t> expected_bytes;
        for (const auto &b : case_entry["encoded"]) {
            expected_bytes.push_back(static_cast<std::uint8_t>(b.get<unsigned int>()));
        }

{% if f.cpp_printed %}
        {# A codec printed from its plan (docs/adr/0081 step 4) is made by its
           constructor, its elements in declaration order; a field the encode
           derives is no element of it. A byte string is made through its
           bound's one door, the type the value presents it as, where it is
           present for one a gate decides; every case is a value inside it. #}
        using Codec = SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.name | to_pascal_case }};
{% for field in f.fields if field.bounded and not field.derived %}
{% if field.optional %}
        using Bounded_{{ field.name }} =
            typename decltype(std::declval<const Codec &>().{{ field.name }}())::value_type;
        std::optional<Bounded_{{ field.name }}> bounded_{{ field.name }};
        if (input_{{ field.name }}.has_value()) {
            bounded_{{ field.name }} = Bounded_{{ field.name }}::make(*input_{{ field.name }});
            CHECK(bounded_{{ field.name }}.has_value(), "{{ f.name }} case %d: {{ field.name }} is outside its bound", i);
            if (!bounded_{{ field.name }}.has_value()) {
                ++i;
                continue;
            }
        }
{% else %}
        const auto bounded_{{ field.name }} =
            decltype(std::declval<const Codec &>().{{ field.name }}())::make(input_{{ field.name }});
        CHECK(bounded_{{ field.name }}.has_value(), "{{ f.name }} case %d: {{ field.name }} is outside its bound", i);
        if (!bounded_{{ field.name }}.has_value()) {
            ++i;
            continue;
        }
{% endif %}
{% endfor %}
        Codec _codec_val{
{% for field in f.fields if not field.derived %}
{% if field.bounded and field.optional %}
            /*{{ field.name }}=*/bounded_{{ field.name }},
{% elif field.bounded %}
            /*{{ field.name }}=*/*bounded_{{ field.name }},
{% else %}
            /*{{ field.name }}=*/input_{{ field.name }},
{% endif %}
{% endfor %}
        };
{% else %}
        SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.name | to_pascal_case }} _codec_val{};
{% for field in f.fields %}
        _codec_val.{{ field.name }} = input_{{ field.name }};
{% endfor %}
{% endif %}
{% if (f.cbor or f.encode_refuses_bound) and not f.cpp_printed %}
        {# A CBOR encode (SCE_FORGE.md §4.6.1), and a binary one with a bounded
           field (docs/adr/0077 §3), refuses a value past its declared bound
           with `std::nullopt`; every case is in bounds. A printed one is
           handed its entries within their bounds and refuses nothing. #}
        auto encoded_or = _codec_val.encode_to_vec();
        CHECK(encoded_or.has_value(), "{{ f.name }} case %d encode refused", i);
        auto encoded = encoded_or.value_or(std::vector<std::uint8_t>{});
{% else %}
        auto encoded = _codec_val.encode_to_vec();
{% endif %}
        CHECK(encoded == expected_bytes,
              "{{ f.name }} case %d encode: size actual=%zu expected=%zu",
              i, encoded.size(), expected_bytes.size());

        ::SCE::Forge::SceCursor cursor(expected_bytes.data(), expected_bytes.size());
        auto round_tripped = SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.name | to_pascal_case }}::decode(cursor);
        CHECK(round_tripped.has_value(),
              "{{ f.name }} case %d decode returned nullopt", i);
        if (round_tripped.has_value()) {
{# A printed codec's element is read through its accessor. #}
{% set acc = "()" if f.cpp_printed else "" %}
{% for field in f.fields if not (f.cpp_printed and field.derived) %}
{% if field.optional %}
            CHECK(round_tripped->{{ field.name }}{{ acc }} == input_{{ field.name }},
                  "{{ f.name }} case %d decode {{ field.name }}: present actual=%d expected=%d, or the values differ",
                  i, static_cast<int>(round_tripped->{{ field.name }}{{ acc }}.has_value()),
                  static_cast<int>(input_{{ field.name }}.has_value()));
{% elif field.type == "bool" %}
            CHECK(round_tripped->{{ field.name }}{{ acc }} == input_{{ field.name }},
                  "{{ f.name }} case %d decode {{ field.name }}: actual=%d expected=%d",
                  i, static_cast<int>(round_tripped->{{ field.name }}{{ acc }}), static_cast<int>(input_{{ field.name }}));
{% elif field.type == "bytes" %}
            CHECK(round_tripped->{{ field.name }}{{ acc }} == input_{{ field.name }},
                  "{{ f.name }} case %d decode {{ field.name }}: actual_size=%zu expected_size=%zu",
                  i, round_tripped->{{ field.name }}{{ acc }}.size(), input_{{ field.name }}.size());
{% elif field.type == "string" %}
            {# A text is shown by its size and bytes: a printed value presents it
               as a view, which ends at its size and not at a NUL. #}
            CHECK(round_tripped->{{ field.name }}{{ acc }} == input_{{ field.name }},
                  "{{ f.name }} case %d decode {{ field.name }}: actual=\"%.*s\" expected=\"%.*s\"",
                  i, static_cast<int>(round_tripped->{{ field.name }}{{ acc }}.size()),
                  round_tripped->{{ field.name }}{{ acc }}.data(),
                  static_cast<int>(input_{{ field.name }}.size()), input_{{ field.name }}.data());
{% else %}
            CHECK(round_tripped->{{ field.name }}{{ acc }} == input_{{ field.name }},
                  "{{ f.name }} case %d decode {{ field.name }}: actual=%s expected=%s",
                  i, std::to_string(round_tripped->{{ field.name }}{{ acc }}).c_str(), std::to_string(input_{{ field.name }}).c_str());
{% endif %}
{% endfor %}
        }
        ++i;
    }
{% endif %}

{# RFC synth-5-B decode-rejection vectors — see the Rust fragment for the
   shape. C++ returns one sentinel for every failure, so `r.symbol` is absent
   here and the first assertion is that the decode refused. A refusal for a
   reason the cursor records (a bound's, docs/adr/0077 §4) is checked there as
   `r.cursor_record`, and a frame short of bytes is checked to record none. #}
{% for r in f.rejects %}
    {
        const std::vector<std::uint8_t> reject_bytes = { {{ r.encoded | join(", ") }} };
        ::SCE::Forge::SceCursor reject_cursor(reject_bytes.data(), reject_bytes.size());
        auto refused = SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.name | to_pascal_case }}::decode(reject_cursor);
        CHECK(!refused.has_value(),
              "{{ f.name }} reject {{ loop.index0 }}: {{ r.why }}");
{% if r.cursor_record %}
        CHECK(reject_cursor.last_refusal() == std::optional<::SCE::Forge::CodecError>({{ r.cursor_record }}),
              "{{ f.name }} reject {{ loop.index0 }} is refused as {{ r.error }}: {{ r.why }}");
{% elif r.cursor_records_nothing %}
        CHECK(!reject_cursor.last_refusal().has_value(),
              "{{ f.name }} reject {{ loop.index0 }} is a frame short of bytes, not a refusal for a reason: {{ r.why }}");
{% endif %}
    }
{% endfor %}
