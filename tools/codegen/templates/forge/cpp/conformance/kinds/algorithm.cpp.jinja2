{# Algorithm kind (RFC §synth-5-A) — single-output free function. C++ harness
   parity for the §A6 cross-(Rust, C11) byte-equivalence acceptance gate;
   cpp shipped at A3 alongside Rust, so the conformance fragment closes
   with rust+c11 in the same A6 commit.

   Bytes args lower to `std::span<const std::uint8_t>` per RFC §synth-5-J-5
   (algorithm_param_type cpp arm); the oracle JSON delivers each `bytes`
   argument as a JSON array of integers, materialised here into a
   `std::vector<std::uint8_t>` so a `std::span` can borrow into it.

   A `may-fail` algorithm (SCE_FORGE.md §3.4.1) returns an
   `SCE::Forge::AlgorithmResult<T>`. A case that names a failure
   (`"fails": "overflow"`) carries no `expected`; it is judged by the error's
   contract name before anything reads `expected`, and every other case reads
   the value. #}
{% set call %}SCE::Generated::{{ f.name | to_pascal_case }}::{{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %}){% endset %}
    const auto &spec = ref["{{ f.ref_section }}"]["{{ f.name }}"];
    int i = 0;
    for (const auto &c : spec["cases"]) {
{# A record argument or output (SCE_FORGE.md §4.12) is the event-schema's
   payload struct, filled and read field by field from a JSON object keyed
   by the schema's field ids; `fields` carries each field's C++ name,
   derived from the schema document when the harness renders. #}
{% for arg_ty in f.args %}
{% set ai = loop.index0 %}
{% if arg_ty.record is defined %}
        SCE::Generated::{{ arg_ty.record | to_pascal_case }}::{{ arg_ty.record | to_pascal_case }}Payload arg{{ ai }}{};
{% for fld in arg_ty.fields %}
        arg{{ ai }}.{{ fld.ident }} = c["args"][{{ ai }}]["{{ fld.name }}"].get<{{ fld.type | cpp_type }}>();
{% endfor %}
{% elif arg_ty == "bytes" %}
        std::vector<std::uint8_t> arg{{ loop.index0 }}_buf;
        for (const auto &b : c["args"][{{ loop.index0 }}]) {
            arg{{ loop.index0 }}_buf.push_back(static_cast<std::uint8_t>(b.get<unsigned int>()));
        }
        std::span<const std::uint8_t> arg{{ loop.index0 }}{ arg{{ loop.index0 }}_buf };
{% else %}
        auto arg{{ loop.index0 }} = c["args"][{{ loop.index0 }}].get<{{ arg_ty | cpp_type }}>();
{% endif %}
{% endfor %}
{% if f.may_fail %}
        const auto result = {{ call }};
        if (c.contains("fails")) {
            const std::string fails = c["fails"].get<std::string>();
            CHECK(!result.ok() && fails == SCE::Forge::contractName(result.error()),
                  "{{ f.name }} case %d: expected failure %s, got %s",
                  i,
                  fails.c_str(),
                  result.ok() ? "a value" : SCE::Forge::contractName(result.error()));
            ++i;
            continue;
        }
        CHECK(result.ok(),
              "{{ f.name }} case %d: expected a value, failed with %s",
              i,
              SCE::Forge::contractName(result.error()));
        const auto returned = result.value();
{% endif %}
{% if f.output.record is defined %}
        auto actual = {% if f.may_fail %}returned{% else %}{{ call }}{% endif %};
{% for fld in f.output.fields %}
        CHECK(actual.{{ fld.ident }} == c["expected"]["{{ fld.name }}"].get<{{ fld.type | cpp_type }}>(),
              "{{ f.name }} case %d: {{ fld.name }} actual=%s expected=%s",
              i,
              std::to_string(actual.{{ fld.ident }}).c_str(),
              std::to_string(c["expected"]["{{ fld.name }}"].get<{{ fld.type | cpp_type }}>()).c_str());
{% endfor %}
{% elif f.output.list_of is defined %}
{# A `list<T>` return (SCE_FORGE.md §4.12) is a `std::vector<T>`: compared
   by length, then element by element. `std::to_string` prints any element
   type, signed or not, without a per-type format specifier. #}
        auto expected = c["expected"].get<std::vector<{{ f.output.list_of | cpp_type }}>>();
        auto actual = {% if f.may_fail %}returned{% else %}{{ call }}{% endif %};
        CHECK(actual.size() == expected.size(),
              "{{ f.name }} case %d: length actual=%zu expected=%zu",
              i,
              actual.size(),
              expected.size());
        for (std::size_t k = 0; k < expected.size() && k < actual.size(); ++k) {
{% if f.output.compare == "tolerance" %}
            assert_close(static_cast<double>(actual[k]), static_cast<double>(expected[k]), tol, "{{ f.name }}");
{% else %}
            CHECK(actual[k] == expected[k],
                  "{{ f.name }} case %d [%zu]: actual=%s expected=%s",
                  i,
                  k,
                  std::to_string(actual[k]).c_str(),
                  std::to_string(expected[k]).c_str());
{% endif %}
        }
{% else %}
        auto expected = c["expected"].get<{{ f.output.type | cpp_type }}>();
        auto actual = {% if f.may_fail %}returned{% else %}{{ call }}{% endif %};
{% if f.output.compare == "tolerance" %}
        assert_close(static_cast<double>(actual), static_cast<double>(expected), tol, "{{ f.name }}");
{% else %}
        CHECK(actual == expected,
              "{{ f.name }} case %d: actual=%llu expected=%llu",
              i,
              static_cast<unsigned long long>(actual),
              static_cast<unsigned long long>(expected));
{% endif %}
{% endif %}
        ++i;
    }
