{# RFC §synth-5-B test-vector: per-row Go `Test*` sidecar for an
   algorithm fixture. Emitted alongside the algorithm `.go` file
   into the same per-fixture package directory whenever the
   algorithm SCXML carries at least one `<sce:test-vector hex
   value/>` row. The sidecar is `<snake>_test.go` so Go's per-
   directory test discovery picks it up automatically; the existing
   `go test ./sce-forge-runtime/go/conformance/...` recursion runs
   the per-fixture package tests alongside the harness. The sidecar
   shares the per-fixture package, so the algorithm function is
   reachable as `<Pascal>(...)` directly without an import. #}

// SCE Forge: Auto-generated test-vector sidecar (RFC §synth-5-B B2)
// Companion to {{ name }}.go — do not edit; regenerate from the source SCXML.

package {{ name }}

import "testing"

{% for tv in test_vectors %}
func TestVector{{ name_pascal }}L{{ tv.source_line }}(t *testing.T) {
    actual := {{ primary_symbol }}({{ tv.bytes_literal_go }})
    expected := {{ tv.value_literal_go }}
    if actual != expected {
        t.Errorf(
            "<sce:test-vector> at SCXML L{{ tv.source_line }}: {{ primary_symbol }}(<{{ tv.hex }}>) = %v, want %v",
            actual, expected)
    }
}
{% endfor %}
