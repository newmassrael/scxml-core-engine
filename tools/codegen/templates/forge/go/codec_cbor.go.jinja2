{#- The read of one entry's value into `v`, which the caller stores; a
    refusal returns its typed error, this backend's decode convention.
    Every CBOR item is the runtime's (`codec.Cbor*`). #}
{% macro decode_value(e) %}
{% if e.kind == "bool" %}
			v, err := codec.CborReadBool(c)
			if err != nil {
				return nil, err
			}
{% elif e.kind == "text" %}
			v, err := codec.CborReadText(c, {{ e.max_size if e.max_size is not none else "-1" }})
			if err != nil {
				return nil, err
			}
{% elif e.kind == "bytes" %}
			v, err := codec.CborReadBytes(c, {{ e.max_size if e.max_size is not none else "-1" }})
			if err != nil {
				return nil, err
			}
{% elif e.kind == "bytes_exact" %}
			v, err := codec.CborReadBytesExact(c, {{ e.length }})
			if err != nil {
				return nil, err
			}
{% elif e.kind == "enum" %}
			raw, err := codec.CborReadUintUpto(c, {{ e.max }})
			if err != nil {
				return nil, err
			}
{% if e.enum_is_open %}
			v := {{ e.enum_from_underlying }}({{ e.carrier_type }}(raw))
{% else %}
			v, ok := {{ e.enum_from_underlying }}({{ e.carrier_type }}(raw)).Get()
			if !ok {
				return nil, codec.ErrUndeclaredEnumValue
			}
{% endif %}
{% elif e.kind == "record_list" %}
			// A definite-length array within the list's counts, each item
			// one record's map.
			n, err := codec.CborReadArrayLen(c)
			if err != nil {
				return nil, err
			}
			if n > {{ e.list_max }}{% if e.list_min > 0 %} || n < {{ e.list_min }}{% endif %} {
				return nil, codec.ErrCborOutOfRange
			}
			v := make({{ e.value_type }}, 0, n)
			for item := uint64(0); item < n; item++ {
				record, err := {{ e.record_decode_fn }}(c)
				if err != nil {
					return nil, err
				}
				v = append(v, record)
			}
{% else %}
			raw, err := codec.CborReadUintUpto(c, {{ e.max }})
			if err != nil {
				return nil, err
			}
			v := {{ e.value_type }}(raw)
{% endif %}
{% endmacro %}
{#- The read of one field of a record a list holds into `record`. #}
{% macro decode_record_field(f) %}
{% if f.kind == "bool" %}
			v, err := codec.CborReadBool(c)
			if err != nil {
				return record, err
			}
			record.{{ f.name }} = v
{% elif f.kind == "text" or f.kind == "bytes" %}
			v, err := codec.CborRead{% if f.kind == "text" %}Text{% else %}Bytes{% endif %}(c, {{ f.max }})
			if err != nil {
				return record, err
			}
			record.{{ f.name }} = v
{% else %}
			raw, err := codec.CborReadUintUpto(c, {{ f.int_max }})
			if err != nil {
				return record, err
			}
			record.{{ f.name }} = {{ f.value_type }}(raw)
{% endif %}
{% endmacro %}
{#- The write of one field of `record`, its key already written. The
    language's string and slice carry no bound, so a text or a byte string
    past its bound is refused, not written. #}
{% macro encode_record_field(f) %}
{% if f.kind == "bool" %}
	if err := codec.CborWriteBool(w, record.{{ f.name }}); err != nil {
		return err
	}
{% elif f.kind == "text" or f.kind == "bytes" %}
	if len(record.{{ f.name }}) > {{ f.max }} {
		return codec.ErrCborOutOfRange
	}
	if err := codec.CborWrite{% if f.kind == "text" %}Text{% else %}Bytes{% endif %}(w, record.{{ f.name }}); err != nil {
		return err
	}
{% else %}
	if err := codec.CborWriteUint(w, uint64(record.{{ f.name }})); err != nil {
		return err
	}
{% endif %}
{% endmacro %}
{#- The write of one entry's value `v`, key already written. #}
{% macro encode_value(e) %}
{% if e.kind == "bool" %}
		if err := codec.CborWriteBool(w, v); err != nil {
			return err
		}
{% elif e.kind == "text" or e.kind == "bytes" %}
{% if e.max_size is not none %}
		if len(v) > {{ e.max_size }} {
			return codec.ErrCborOutOfRange
		}
{% endif %}
		if err := codec.CborWrite{% if e.kind == "text" %}Text{% else %}Bytes{% endif %}(w, v); err != nil {
			return err
		}
{% elif e.kind == "bytes_exact" %}
		if len(v) != {{ e.length }} {
			return codec.ErrCborWrongLength
		}
		if err := codec.CborWriteBytes(w, v); err != nil {
			return err
		}
{% elif e.kind == "enum" %}
		u := {{ e.enum_to_underlying }}
{% if e.carrier_signed %}
		{# A signed carrier's negative number is no CBOR unsigned integer;
		   refused as the Rust backend refuses it. #}
		if u < 0 {
			return codec.ErrCborOutOfRange
		}
{% endif %}
		if err := codec.CborWriteUint(w, uint64(u)); err != nil {
			return err
		}
{% elif e.kind == "record_list" %}
		{# The language's slice carries no bound, so a count past the list's
		   bound, or short of its lower count, is refused before anything of
		   the list is written. #}
		if len(v) > {{ e.list_max }}{% if e.list_min > 0 %} || len(v) < {{ e.list_min }}{% endif %} {
			return codec.ErrCborOutOfRange
		}
		if err := codec.CborWriteArrayHead(w, uint64(len(v))); err != nil {
			return err
		}
		for item := range v {
			if err := {{ e.record_encode_fn }}(w, &v[item]); err != nil {
				return err
			}
		}
{% else %}
		if err := codec.CborWriteUint(w, uint64(v)); err != nil {
			return err
		}
{% endif %}
{% endmacro %}
