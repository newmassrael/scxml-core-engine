			return err
		}
{% elif e.kind == "uint" %}
		if err := out.Uint(uint64(v)); err != nil {
			return err
		}
{% else %}
		if err := out.Int(int64(v)); err != nil {
			return err
		}
{% endif %}
{% endmacro %}
{#- The parameters of a property, each written when present. #}
{% macro write_params(e) %}
{% for p in e.params %}
{% if p.required %}
		if err := out.Param("{{ p.param }}", s.{{ p.name }}, {{ p.max_size }}); err != nil {
			return err
