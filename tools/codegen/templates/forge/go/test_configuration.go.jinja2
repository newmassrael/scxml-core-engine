}
{% endfor %}

// Input is the reader of the inputs of a recorded trace (docs/SCE_TTCN3_LANE.md §10.2, a
// {{ runtime }}.InputReader): the message an input of the record type typeName on the system port
// systemPort carries, its value read from the canonical form. An error, naming why, where the
// configuration has no such system port, the `in` list of its type does not name the type, or the
// value does not belong to it.
{% if inputs %}
func Input(systemPort, typeName string, value any) ({{ runtime }}.Message, error) {
{% for input in inputs %}
	if systemPort == {{ input.port }} && typeName == {{ input.type }} {
		read, err := {{ input.read }}(value)
		if err != nil {
			return {{ runtime }}.Message{}, err
		}
		return {{ runtime }}.NewMessage({{ input.event }}, read, {{ input.type }}, {{ input.canonical }}), nil
	}
{% endfor %}
	return {{ runtime }}.Message{}, {{ runtime }}.NotAnInput(systemPort, typeName, {{ system_ports }})
}
{% else %}
func Input(systemPort, typeName string, _ any) ({{ runtime }}.Message, error) {
	return {{ runtime }}.Message{}, {{ runtime }}.NotAnInput(systemPort, typeName, {{ system_ports }})
}
{% endif %}
