{% for reader in readers %}

// {{ reader.read }} is the record `{{ reader.type }}` read from the canonical form of the test log
// (docs/SCE_TEST_PROFILE.md §12.5), as a recorded input trace holds it (docs/SCE_TTCN3_LANE.md
// §10.3), or an error naming where its value does not belong to its type. The inverse of
// {{ reader.canonical }}.
func {{ reader.read }}(value any) ({{ reader.payload }}, error) {
	return {{ reader.read_expr }}
}

// {{ reader.canonical }} is the record `{{ reader.type }}` in the canonical form of the test log
// (docs/SCE_TEST_PROFILE.md §12.5), which a message of it a trace hands the run carries.
func {{ reader.canonical }}(value {{ reader.payload }}) any {
