	return {{ runtime }}.TestCase{
		Name:             Name,
		Configuration:    {{ configuration }}(),
		Machines:         {{ machine }},
		ModuleParameters: {{ module_parameters }}(),
		Inputs:           {{ inputs }},
	}
}
