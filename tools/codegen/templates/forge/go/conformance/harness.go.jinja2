// ── Per-kind spec and step types ────────────────────────────────
//
// Each sequence-based kind (filter, observer, validator) gets its own Step
// struct declaring exactly the JSON fields it needs. The older design used
// a single superset sequenceStep struct whose fields were a union of every
// kind's needs, with fragments silently ignoring irrelevant fields — this
// split restores per-kind type safety and lets each fragment's field access
// fail at compile time if the oracle shape ever drifts.

type reference struct {
	Version         int                        `json:"version"`
	FloatTolerance  float64                    `json:"float_tolerance"`
	// Pure-function section is stored as raw JSON per fixture so that
	// different kinds sharing `pure_functions` (interpolation / transform /
	// condition / lookup / procedure) can parse the same entry through
	// different case structs — procedures need `handler_response_data`
	// that other kinds don't care about, and baking it into a shared
	// `pureCase` would leak procedure-specific fields into every pure-kind
	// accessor. Each per-kind accessor below re-unmarshals its fixture's
	// RawMessage into the kind-specific spec type.
	PureFunctions   map[string]json.RawMessage `json:"pure_functions"`
	StatefulFilters map[string]filterSpec      `json:"stateful_filters"`
	Observers       map[string]observerSpec    `json:"observers"`
	Validators      map[string]validatorSpec   `json:"validators"`
	Codecs          map[string]codecSpec       `json:"codecs"`
}

// pureSpec / pureCase cover non-procedure pure-function kinds (interpolation,
// transform, condition, lookup). Procedure kind has its own pair below
// because it carries extra per-case fields that the other kinds don't.
type pureSpec struct {
	Cases []pureCase `json:"cases"`
}

type pureCase struct {
	Args     []json.RawMessage `json:"args"`
	Expected json.RawMessage   `json:"expected"`
}

// procedureSpec / procedureCase live under the same `pure_functions` section
// of the oracle but carry `handler_response_data` — an optional per-case
// string that seeds the conformance handler's response data field so the
// state machine's `<assign location="..." expr="_event.data"/>` transitions
// populate bytes fields. Absent for procedures that don't consume
// `_event.data`.
type procedureSpec struct {
	Cases []procedureCase `json:"cases"`
}

type procedureCase struct {
	Args                []json.RawMessage `json:"args"`
	Expected            json.RawMessage   `json:"expected"`
	HandlerResponseData *string           `json:"handler_response_data,omitempty"`
}

type filterSpec struct {
	Sequence []filterStep `json:"sequence"`
}

type filterStep struct {
	Input    json.RawMessage `json:"input"`
	Expected json.RawMessage `json:"expected"`
}

type observerSpec struct {
	Sequence []observerStep `json:"sequence"`
}

type observerStep struct {
	Input          json.RawMessage `json:"input"`
	ExpectedEvents []string        `json:"expected_events"`
}

type validatorSpec struct {
	Sequence []validatorStep `json:"sequence"`
}

type validatorStep struct {
	Args     []json.RawMessage `json:"args"`
	Expected json.RawMessage   `json:"expected"`
}

type codecSpec struct {
	Cases []codecCase `json:"cases"`
}

// codecCase holds one round-trip pair. `Encoded` is modelled as `[]int`
// rather than `[]byte` because Go's encoding/json treats `[]byte` as a
// base64-encoded string; the oracle stores bytes as a JSON array of
// unsigned integers, which unmarshals cleanly into `[]int` and is
// converted to `[]byte` at use site inside the codec fragment.
type codecCase struct {
	Decoded json.RawMessage `json:"decoded"`
	Encoded []int           `json:"encoded"`
}

// pureCases looks up pure-function cases by the manifest's ref_section
// name. Each kind fragment passes the section name from f.ref_section so
// that drift between fixtures.json and this harness fails loudly at test
// time instead of silently reading the wrong section. The second-stage
// json.Unmarshal into pureSpec lets the shared `pure_functions` map host
// per-kind case shapes (procedure uses procedureCases instead).
func (r *reference) pureCases(t *testing.T, section, fixture string) []pureCase {
	t.Helper()
	if section != "pure_functions" {
		t.Fatalf("fixture %q: pure-function kinds require ref_section=pure_functions, got %q", fixture, section)
	}
	raw, ok := r.PureFunctions[fixture]
	if !ok {
		t.Fatalf("fixture %q: missing entry in pure_functions", fixture)
	}
	var spec pureSpec
	if err := json.Unmarshal(raw, &spec); err != nil {
		t.Fatalf("fixture %q: cannot decode pureSpec: %v", fixture, err)
	}
	return spec.Cases
}

// procedureCases is the procedure-kind analog of pureCases. Same
// `pure_functions` section, different case struct — procedureCase adds
// `handler_response_data` which only procedure fragments consume.
func (r *reference) procedureCases(t *testing.T, section, fixture string) []procedureCase {
	t.Helper()
	if section != "pure_functions" {
		t.Fatalf("fixture %q: procedure kind requires ref_section=pure_functions, got %q", fixture, section)
	}
	raw, ok := r.PureFunctions[fixture]
	if !ok {
		t.Fatalf("fixture %q: missing entry in pure_functions", fixture)
	}
	var spec procedureSpec
	if err := json.Unmarshal(raw, &spec); err != nil {
		t.Fatalf("fixture %q: cannot decode procedureSpec: %v", fixture, err)
	}
	return spec.Cases
}

// filterSteps returns the step sequence for a filter fixture, asserting
// that the manifest's ref_section matches the hard-wired expectation for
// this kind. The assertion is what catches drift — a filter fixture in
// fixtures.json tagged ref_section="observers" fails loudly here rather
// than silently reading from the wrong map.
func (r *reference) filterSteps(t *testing.T, section, fixture string) []filterStep {
	t.Helper()
	if section != "stateful_filters" {
		t.Fatalf("fixture %q: filter kind requires ref_section=stateful_filters, got %q", fixture, section)
	}
	spec, ok := r.StatefulFilters[fixture]
	if !ok {
		t.Fatalf("fixture %q: missing entry in stateful_filters", fixture)
	}
	return spec.Sequence
}

// observerSteps — see filterSteps for the drift-detection contract.
func (r *reference) observerSteps(t *testing.T, section, fixture string) []observerStep {
	t.Helper()
	if section != "observers" {
		t.Fatalf("fixture %q: observer kind requires ref_section=observers, got %q", fixture, section)
	}
	spec, ok := r.Observers[fixture]
	if !ok {
		t.Fatalf("fixture %q: missing entry in observers", fixture)
	}
	return spec.Sequence
}

// validatorSteps — see filterSteps for the drift-detection contract.
func (r *reference) validatorSteps(t *testing.T, section, fixture string) []validatorStep {
	t.Helper()
	if section != "validators" {
		t.Fatalf("fixture %q: validator kind requires ref_section=validators, got %q", fixture, section)
	}
	spec, ok := r.Validators[fixture]
	if !ok {
		t.Fatalf("fixture %q: missing entry in validators", fixture)
	}
	return spec.Sequence
}

// codecCases — see filterSteps for the drift-detection contract. Codec
// cases are independent round-trip pairs rather than an ordered sequence,
// but the ref_section assertion and missing-fixture guard are identical to
// the other kind-specific accessors.
func (r *reference) codecCases(t *testing.T, section, fixture string) []codecCase {
	t.Helper()
	if section != "codecs" {
		t.Fatalf("fixture %q: codec kind requires ref_section=codecs, got %q", fixture, section)
	}
	spec, ok := r.Codecs[fixture]
	if !ok {
		t.Fatalf("fixture %q: missing entry in codecs", fixture)
	}
	return spec.Cases
}

func repoRoot(t *testing.T) string {
	_, thisFile, _, ok := runtime.Caller(0)
	if !ok {
		t.Fatal("runtime.Caller failed")
	}
	return filepath.Clean(filepath.Join(filepath.Dir(thisFile), "..", "..", ".."))
}

func loadReference(t *testing.T) reference {
	t.Helper()
	path := filepath.Join(repoRoot(t), "tests", "forge", "conformance", "numerical_reference.json")
	data, err := os.ReadFile(path)
	if err != nil {
		t.Fatalf("read reference: %v", err)
	}
	var ref reference
	if err := json.Unmarshal(data, &ref); err != nil {
		t.Fatalf("parse reference: %v", err)
	}
	return ref
}

func assertClose(t *testing.T, actual, expected, tol float64, label string) {
	t.Helper()
	if diff := math.Abs(actual - expected); diff > tol {
		t.Errorf("%s: actual=%v expected=%v diff=%v tol=%v", label, actual, expected, diff, tol)
	}
}

func unmarshalOrFatal(t *testing.T, raw json.RawMessage, dst interface{}, label string) {
	t.Helper()
	if err := json.Unmarshal(raw, dst); err != nil {
		t.Fatalf("%s: %v", label, err)
	}
}

