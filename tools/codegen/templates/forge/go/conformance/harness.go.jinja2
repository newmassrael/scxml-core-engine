// Recording mock implementing the timer.Timer interface. File-level
// because Go forbids method-receiver definitions inside function
// bodies — a method's receiver type must live at package scope.
// ⚠ This mock was written for the multi-timer `<data sce:timer=…>` shape
// removed on 2026-05-12: it kept only the LAST registration and its
// `Cancel()` recorded nothing, because the old oracle asked "what type and
// interval was registered" rather than "what sequence of calls happened".
// The kind now emits one timer whose whole observable is that sequence — a
// reset is a cancel THEN a start, and a mock that drops cancels cannot tell
// that from a bare start. `ops` is the recording the oracle compares.
type recTimer struct {
	ops     []string
	regType string
	regMs   uint32
	regCb   func()
}

// Receiver method signatures take the named `timer.Callback` type rather
// than the raw `func()`, since Go interface satisfaction requires
// parameter types to be identical (not merely structurally equivalent
// to the underlying type). Without the named alias the compiler reports
// `*recTimer does not implement timer.Timer`.
func (r *recTimer) StartPeriodic(ms uint32, cb timer.Callback) {
	r.ops = append(r.ops, fmt.Sprintf("start_periodic:%d", ms))
	r.regType = "periodic"
	r.regMs = ms
	r.regCb = cb
}

func (r *recTimer) StartOneShot(ms uint32, cb timer.Callback) {
	// Recorded rather than ignored: no template emits it today, and if one
	// starts, this surfaces as a diff instead of as silence.
	r.ops = append(r.ops, fmt.Sprintf("start_one_shot:%d", ms))
	r.regType = "one_shot"
	r.regMs = ms
	r.regCb = cb
}

func (r *recTimer) Cancel() { r.ops = append(r.ops, "cancel") }

