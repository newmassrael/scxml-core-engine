{# Observer kind — stateful Update(input) producing a tag queue per step. #}
	steps := ref.observerSteps(t, "{{ f.ref_section }}", "{{ f.name }}")
	var observer {{ f.name }}.{{ f.name | to_pascal_case }}
	for i, step := range steps {
		var input {{ f.input | go_type }}
		unmarshalOrFatal(t, step.Input, &input, "{{ f.name }} input")
		queue := observer.Update(input)
		actual := make([]string, 0, queue.Len())
		for _, tag := range queue.AsSlice() {
			actual = append(actual, {{ f.name | to_camel_case }}TagName(tag))
		}
		if len(actual) != len(step.ExpectedEvents) {
			t.Errorf("{{ f.name }} step %d: got %v expected %v", i, actual, step.ExpectedEvents)
			continue
		}
		for j := range actual {
			if actual[j] != step.ExpectedEvents[j] {
				t.Errorf("{{ f.name }} step %d: got %v expected %v", i, actual, step.ExpectedEvents)
				break
			}
		}
	}
