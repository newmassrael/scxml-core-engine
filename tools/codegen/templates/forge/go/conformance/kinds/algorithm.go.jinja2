{# Algorithm kind (RFC §synth-5-A) — single-output free function. Cross-language
   byte-equivalence acceptance gate (RFC §A6); Go shipped post-A6 alongside
   its byte-golden + matrix flip.

   Bytes args lower to `[]byte` per RFC §synth-5-J-5 (algorithm_param_type Go arm
   via the LangCtx::param_type fallback). Go's encoding/json treats `[]byte`
   as a base64-encoded string rather than a JSON array of integers, so the
   oracle's `[10, 20, 30]` array shape unmarshals through `[]int` first and
   is then converted to `[]byte` at the call site — same workaround the
   codec fragment uses for `Encoded []int` (see harness.go.jinja2 codecCase).
   Numeric args unmarshal directly into their canonical Go scalar type. #}
{# A record argument or output (SCE_FORGE.md §4.12) is the event-schema's
   payload struct. The oracle's JSON object unmarshals into an anonymous
   struct whose tags are the schema's field ids, and the payload is filled
   from it field by field; `fields` carries each field's Go name, derived
   from the schema document when the harness renders. #}
	cases := ref.pureCases(t, "{{ f.ref_section }}", "{{ f.name }}")
	for _, c := range cases {
{% for arg_ty in f.args %}
{% set i = loop.index0 %}
{% if arg_ty.record is defined %}
		var arg{{ i }}_src struct {
{% for fld in arg_ty.fields %}
			{{ fld.ident }} {{ fld.type | go_type }} `json:"{{ fld.name }}"`
{% endfor %}
		}
		unmarshalOrFatal(t, c.Args[{{ i }}], &arg{{ i }}_src, "{{ f.name }} arg{{ i }}")
		arg{{ i }} := {{ arg_ty.record }}.{{ arg_ty.record | to_pascal_case }}Payload{
{% for fld in arg_ty.fields %}
			{{ fld.ident }}: arg{{ i }}_src.{{ fld.ident }},
{% endfor %}
		}
{% elif arg_ty == "bytes" %}
		var arg{{ loop.index0 }}_buf []int
		unmarshalOrFatal(t, c.Args[{{ loop.index0 }}], &arg{{ loop.index0 }}_buf, "{{ f.name }} arg{{ loop.index0 }}")
		arg{{ loop.index0 }} := make([]byte, len(arg{{ loop.index0 }}_buf))
		for __i, __v := range arg{{ loop.index0 }}_buf {
			arg{{ loop.index0 }}[__i] = byte(__v)
		}
{% else %}
		var arg{{ loop.index0 }} {{ arg_ty | go_type }}
		unmarshalOrFatal(t, c.Args[{{ loop.index0 }}], &arg{{ loop.index0 }}, "{{ f.name }} arg{{ loop.index0 }}")
{% endif %}
{% endfor %}
{% if f.output.record is defined %}
		var expected struct {
{% for fld in f.output.fields %}
			{{ fld.ident }} {{ fld.type | go_type }} `json:"{{ fld.name }}"`
{% endfor %}
		}
		unmarshalOrFatal(t, c.Expected, &expected, "{{ f.name }} expected")
		actual := {{ f.name }}.{{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
{% for fld in f.output.fields %}
		if actual.{{ fld.ident }} != expected.{{ fld.ident }} {
			t.Errorf("{{ f.name }}.{{ fld.name }}: actual=%v expected=%v", actual.{{ fld.ident }}, expected.{{ fld.ident }})
		}
{% endfor %}
{% elif f.output.list_of is defined %}
{# A `list<T>` return (SCE_FORGE.md §4.12) is a `[]T`: compared by length,
   then element by element. #}
		var expected []{{ f.output.list_of | go_type }}
		unmarshalOrFatal(t, c.Expected, &expected, "{{ f.name }} expected")
		actual := {{ f.name }}.{{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
		if len(actual) != len(expected) {
			t.Errorf("{{ f.name }}: actual=%v expected=%v", actual, expected)
			continue
		}
		for __i := range expected {
{% if f.output.compare == "tolerance" %}
			assertClose(t, float64(actual[__i]), float64(expected[__i]), ref.FloatTolerance, "{{ f.name }}")
{% else %}
			if actual[__i] != expected[__i] {
				t.Errorf("{{ f.name }}[%d]: actual=%v expected=%v", __i, actual[__i], expected[__i])
			}
{% endif %}
		}
{% else %}
		var expected {{ f.output.type | go_type }}
		unmarshalOrFatal(t, c.Expected, &expected, "{{ f.name }} expected")
		actual := {{ f.name }}.{{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
{% if f.output.compare == "tolerance" %}
		assertClose(t, float64(actual), float64(expected), ref.FloatTolerance, "{{ f.name }}")
{% else %}
		if actual != expected {
			t.Errorf("{{ f.name }}: actual=%v expected=%v", actual, expected)
		}
{% endif %}
{% endif %}
	}
