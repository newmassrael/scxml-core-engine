{# Validator kind — stateful Validate(args...) -> ValidationResult{Valid, Reason}. #}
	steps := ref.validatorSteps(t, "{{ f.ref_section }}", "{{ f.name }}")
	var validator {{ f.name }}.{{ f.name | to_pascal_case }}
	type expectedShape struct {
		Valid  bool   `json:"valid"`
		Reason string `json:"reason"`
	}
	for i, step := range steps {
{% for arg_ty in f.args %}
		var arg{{ loop.index0 }} {{ arg_ty | go_type }}
		unmarshalOrFatal(t, step.Args[{{ loop.index0 }}], &arg{{ loop.index0 }}, "{{ f.name }} arg{{ loop.index0 }}")
{% endfor %}
		var expected expectedShape
		unmarshalOrFatal(t, step.Expected, &expected, "{{ f.name }} expected")
		result := validator.Validate({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
		if result.Valid != expected.Valid {
			t.Errorf("{{ f.name }} step %d valid: actual=%v expected=%v", i, result.Valid, expected.Valid)
		}
		if result.Reason != expected.Reason {
			t.Errorf("{{ f.name }} step %d reason: actual=%q expected=%q", i, result.Reason, expected.Reason)
		}
	}
