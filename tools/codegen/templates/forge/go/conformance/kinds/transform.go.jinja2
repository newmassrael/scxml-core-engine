{# Transform kind — pure free function(s), single or compound output; or,
   for a document that reads a field through previous(), its holder driven
   through the oracle's sequence twice: from a new holder, then after
   Reset(). Both passes are held to the same oracle, which is what says
   Reset() restores every kept value.
   ⚠ A tolerance output is compared inline rather than through
   assertClose: every message names the pass and the step, and a label
   built for assertClose would need "fmt", which this scaffold imports only
   for the timer kind. #}
{% if f.holder %}
	steps := ref.transformSteps(t, "{{ f.ref_section }}", "{{ f.name }}")
	holder := {{ f.name }}.{{ f.holder.new }}()
	for pass := 0; pass < 2; pass++ {
		if pass == 1 {
			holder.{{ f.holder.reset }}()
		}
		for i, step := range steps {
{% for arg_ty in f.args %}
			var arg{{ loop.index0 }} {{ arg_ty | go_type }}
			unmarshalOrFatal(t, step.Args[{{ loop.index0 }}], &arg{{ loop.index0 }}, "{{ f.name }} arg{{ loop.index0 }}")
{% endfor %}
			var expected struct {
{% for co in f.compound_outputs %}
				{{ co.key | to_pascal_case }} {{ co["type"] | go_type }} `json:"{{ co.key }}"`
{% endfor %}
			}
			unmarshalOrFatal(t, step.Expected, &expected, "{{ f.name }} expected")
			out := holder.{{ f.holder.update }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
{% for co in f.compound_outputs %}
{% if co.compare == "tolerance" %}
			if diff := math.Abs(float64(out.{{ co.field }}) - float64(expected.{{ co.key | to_pascal_case }})); diff > ref.FloatTolerance {
				t.Errorf("{{ f.name }} pass %d step %d {{ co.key }}: actual=%v expected=%v diff=%v tol=%v", pass, i, out.{{ co.field }}, expected.{{ co.key | to_pascal_case }}, diff, ref.FloatTolerance)
			}
{% else %}
			if out.{{ co.field }} != expected.{{ co.key | to_pascal_case }} {
				t.Errorf("{{ f.name }} pass %d step %d {{ co.key }}: actual=%v expected=%v", pass, i, out.{{ co.field }}, expected.{{ co.key | to_pascal_case }})
			}
{% endif %}
{% endfor %}
		}
	}
{% else %}
	cases := ref.pureCases(t, "{{ f.ref_section }}", "{{ f.name }}")
	for _, c := range cases {
{% for arg_ty in f.args %}
		var arg{{ loop.index0 }} {{ arg_ty | go_type }}
		unmarshalOrFatal(t, c.Args[{{ loop.index0 }}], &arg{{ loop.index0 }}, "{{ f.name }} arg{{ loop.index0 }}")
{% endfor %}
{% if f.output %}
{# ⚠ The single-output arm used to hardcode `float64` + `assertClose`, while
   the compound arm below already honoured `compare`. Every single-output
   transform in the catalog happened to be `tolerance`/`f64`, so the
   assumption held until `transform_rounding` arrived with `equality`/`i32`
   and the generated test would not compile:

       cannot use actual (variable of type int32) as float64 value
       in argument to assertClose

   The two arms now ask the manifest the same question. #}
		var expected {{ f.output["type"] | go_type }}
		unmarshalOrFatal(t, c.Expected, &expected, "{{ f.name }} expected")
		actual := {{ f.name }}.{{ f.output.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
{% if f.output.compare == "tolerance" %}
		assertClose(t, actual, expected, ref.FloatTolerance, "{{ f.name }}")
{% else %}
		if actual != expected {
			t.Errorf("{{ f.name }}: actual=%v expected=%v", actual, expected)
		}
{% endif %}
{% else %}
		var expected struct {
{% for co in f.compound_outputs %}
			{{ co.key | to_pascal_case }} {{ co["type"] | go_type }} `json:"{{ co.key }}"`
{% endfor %}
		}
		unmarshalOrFatal(t, c.Expected, &expected, "{{ f.name }} expected")
{% for co in f.compound_outputs %}
		actual{{ co.key | to_pascal_case }} := {{ f.name }}.{{ co.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
{% if co.compare == "tolerance" %}
		assertClose(t, actual{{ co.key | to_pascal_case }}, expected.{{ co.key | to_pascal_case }}, ref.FloatTolerance, "{{ f.name }} {{ co.key }}")
{% else %}
		if actual{{ co.key | to_pascal_case }} != expected.{{ co.key | to_pascal_case }} {
			t.Errorf("{{ f.name }} {{ co.key }}: actual=%v expected=%v", actual{{ co.key | to_pascal_case }}, expected.{{ co.key | to_pascal_case }})
		}
{% endif %}
{% endfor %}
{% endif %}
	}
{% endif %}
