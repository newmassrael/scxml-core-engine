{# Event-schema kind — see the C++ fragment for why this is a SHAPE claim.

   ⚠ Go EXPORTS the payload fields, so `sensorId` is emitted `SensorId`. The
   manifest keeps the document's spelling and this arm applies the filter —
   the same contract the codec and enum fragments use, and the reason the
   manifest is not written in any one language's convention. #}
	{
		spec := ref.eventSchemaEntry(t, "{{ f.ref_section }}", "{{ f.name }}")

		// Count first: a payload that gained or lost a field without the
		// manifest moving would otherwise satisfy every assertion below.
		if len(spec.Fields) != {{ f.fields | length }} {
			t.Fatalf("{{ f.name }}: oracle has %d fields, manifest has {{ f.fields | length }}",
				len(spec.Fields))
		}

		// Field-keyed construction, because Go vets positional literals for
		// exported structs. The ORDER claim is carried by the per-index name
		// assertions below instead.
		payload := {{ f.name }}.{{ f.name | to_pascal_case }}Payload{
{% for field in f.fields %}
			{{ field.name | to_pascal_case }}: {{ field.value }},
{% endfor %}
		}

{% for field in f.fields %}
		if spec.Fields[{{ loop.index0 }}].Name != "{{ field.name }}" {
			t.Errorf("{{ f.name }} field {{ loop.index0 }}: oracle names %q, manifest %q",
				spec.Fields[{{ loop.index0 }}].Name, "{{ field.name }}")
		}
		if int64(payload.{{ field.name | to_pascal_case }}) != spec.Fields[{{ loop.index0 }}].Value {
			t.Errorf("{{ f.name }}.{{ field.name }} = %d, want %d",
				int64(payload.{{ field.name | to_pascal_case }}),
				spec.Fields[{{ loop.index0 }}].Value)
		}
{% endfor %}
	}
