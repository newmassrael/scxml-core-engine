{# Codec kind — round-trip { decoded, encoded } cases. The generated Go
   package exposes `Decode<PascalName>(cursor *codec.SceCursor) (*<PascalName>, error)`
   and `func (s *<PascalName>) Encode() []byte`. SCXML source case (camelCase)
   is converted to PascalCase for Go struct fields via the `to_pascal_case`
   filter, matching the generator's naming convention. #}
{% if not f.oracle_eligible %}
	// Compile-only probe: oracle_eligible=false because the fixture's
	// field shape isn't expressible in the current StructField /
	// CanonicalType schema (typed nested codec, a field gated by
	// sce:present-if, or parent-flag-bearing carrier). The package
	// import resolved at build time, so a silently-broken
	// kotlinc/go-build-class regression of commit 91ae355a's variety
	// (a Go field type mismatch in struct literals) is already caught
	// upstream by `go build`. This zero-value declaration additionally exercises
	// the type's identity so the unused-import linter stays quiet.
	_ = ref
	var _codecVal {{ f.name }}.{{ f.name | to_pascal_case }}
	_ = _codecVal
{% else %}
	cases := ref.codecCases(t, "{{ f.ref_section }}", "{{ f.name }}")
	type decodedShape struct {
{% for field in f.fields %}
		{# An absent entry is JSON `null`, which the runtime's optional type reads
		   as absent — the generated struct's own type for an optional entry, so
		   the decoded case is handed to the struct as it is. #}
		{{ field.name | to_pascal_case }} {% if field.optional %}optional.Of[{{ field.type | go_type }}]{% else %}{{ field.type | go_type }}{% endif %} `json:"{{ field.name }}"`
{% endfor %}
	}
	for i, c := range cases {
		var d decodedShape
		unmarshalOrFatal(t, c.Decoded, &d, "{{ f.name }} decoded")
		expectedBytes := make([]byte, len(c.Encoded))
		for j, b := range c.Encoded {
			expectedBytes[j] = byte(b)
		}

		{# A case marked `decode_only` is a wire a peer may send that is not the
		   one this encode writes (a VLE padded past its minimal encoding): its
		   bytes decode to the value and are read whole, and the encode is not
		   held to them. #}
		if !c.DecodeOnly {
{% if f.printed %}
			{# A byte string or a text is the runtime's bounded value of the bound
			   type the codec names for it, made first; a case outside its bound
			   is written wrong (docs/adr/0081 step 4). #}
{% for field in f.fields if not field.derived and field.type in ["bytes", "string"] %}
{% set fp = field.name | to_pascal_case %}
			held{{ fp }}, err := codec.Make{{ "Text" if field.type == "string" else "Bytes" }}[{{ f.name }}.{{ f.name | to_pascal_case }}{{ fp }}Bound](d.{{ fp }})
			if err != nil {
				t.Errorf("{{ f.name }} case %d: the {{ field.name }} of the case is outside its bound: %v", i, err)
				continue
			}
{% endfor %}
			{# Made by its constructor, its elements in declaration order, which
			   is the order the catalog lists them in (docs/adr/0081 step 4). #}
			value := {{ f.name }}.Make{{ f.name | to_pascal_case }}({% for field in f.fields if not field.derived %}{% if field.type in ["bytes", "string"] %}held{% else %}d.{% endif %}{{ field.name | to_pascal_case }}{% if not loop.last %}, {% endif %}{% endfor %})
{% else %}
			value := &{{ f.name }}.{{ f.name | to_pascal_case }}{
{% for field in f.fields %}
				{{ field.name | to_pascal_case }}: d.{{ field.name | to_pascal_case }},
{% endfor %}
			}
{% endif %}
{% if f.cbor or f.encode_refuses_bound %}
			{# A CBOR encode (SCE_FORGE.md §4.6.1), and a binary one with a bounded
			   field (docs/adr/0077 §3), refuses a value past its declared bound
			   with an error; every case is in bounds. #}
			encoded, encodeErr := value.EncodeToBytes()
			if encodeErr != nil {
				t.Errorf("{{ f.name }} case %d encode refused: %v", i, encodeErr)
				continue
			}
{% else %}
			encoded := value.EncodeToBytes()
{% endif %}
			if len(encoded) != len(expectedBytes) {
				t.Errorf("{{ f.name }} case %d encode: length actual=%d expected=%d", i, len(encoded), len(expectedBytes))
			} else {
				for j := range expectedBytes {
					if encoded[j] != expectedBytes[j] {
						t.Errorf("{{ f.name }} case %d encode byte %d: actual=%d expected=%d", i, j, encoded[j], expectedBytes[j])
						break
					}
				}
			}
		}

		cursor := codec.NewSceCursor(expectedBytes)
{% if f.fields %}
		roundTripped, err := {{ f.name }}.Decode{{ f.name | to_pascal_case }}(&cursor)
		if err != nil {
			t.Errorf("{{ f.name }} case %d decode returned error: %v", i, err)
			continue
		}
		if c.DecodeOnly && cursor.Remaining() != 0 {
			t.Errorf("{{ f.name }} case %d: a decode-only frame is read whole, %d byte(s) left", i, cursor.Remaining())
		}
{% else %}
		// RFC §synth-5-B empty body — decode must succeed but there
		// are no fields to assert against; the empty-bytes encode
		// above already proves the round-trip.
		if _, err := {{ f.name }}.Decode{{ f.name | to_pascal_case }}(&cursor); err != nil {
			t.Errorf("{{ f.name }} case %d decode returned error: %v", i, err)
			continue
		}
{% endif %}
{# A codec printed from its plan presents each element through its method,
   and holds no element its encode derives, which is neither handed to its
   constructor nor read back (docs/adr/0081 §3). #}
{% for field in f.fields if not (f.printed and field.derived) %}
{% set fp = field.name | to_pascal_case %}
{# A printed byte string or text is read as the slice or the string its
   bounded value holds. #}
{% set got = "roundTripped." ~ fp ~ ("()" if f.printed else "") ~ (".Bytes()" if f.printed and field.type == "bytes" else (".String()" if f.printed and field.type == "string" else "")) %}
{% if field.optional %}
		{# Present on both sides with one value, or absent on both: the optional
		   type's own equality, which compares a byte string as its bytes. #}
		if !{{ got }}.Equal(d.{{ fp }}) {
			t.Errorf("{{ f.name }} case %d decode {{ field.name }}: actual=%v expected=%v", i, {{ got }}, d.{{ fp }})
		}
{% elif field.type == "bytes" %}
		if len({{ got }}) != len(d.{{ fp }}) {
			t.Errorf("{{ f.name }} case %d decode {{ field.name }}: length actual=%d expected=%d", i, len({{ got }}), len(d.{{ fp }}))
		} else {
			for j := range d.{{ fp }} {
				if {{ got }}[j] != d.{{ fp }}[j] {
					t.Errorf("{{ f.name }} case %d decode {{ field.name }} byte %d: actual=%d expected=%d", i, j, {{ got }}[j], d.{{ fp }}[j])
					break
				}
			}
		}
{% else %}
		if {{ got }} != d.{{ fp }} {
			t.Errorf("{{ f.name }} case %d decode {{ field.name }}: actual=%v expected=%v", i, {{ got }}, d.{{ fp }})
		}
{% endif %}
{% endfor %}
	}
{% endif %}

{# RFC synth-5-B decode-rejection vectors — see the Rust fragment for the
   shape. Go has a name for the failure, so the assertion is on the sentinel
   itself. Compared with `!=` rather than errors.Is: the generated decode
   returns these sentinels unwrapped, and if that ever stops being true the
   comparison fails loudly here rather than passing on the wrong refusal. #}
{% for r in f.rejects %}
	{
		rejectBytes := []byte{ {{ r.encoded | join(", ") }} }
		rejectCursor := codec.NewSceCursor(rejectBytes)
		if accepted, refused := {{ f.name }}.Decode{{ f.name | to_pascal_case }}(&rejectCursor); refused != {{ r.symbol }} {
			t.Errorf("{{ f.name }} reject {{ loop.index0 }}: {{ r.why }} (err=%v value=%+v)", refused, accepted)
		}
	}
{% endfor %}
