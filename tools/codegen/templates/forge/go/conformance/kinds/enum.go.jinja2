{# Enum kind — see the C++ fragment for why the oracle compares VALUES and
   keys on the source spelling. Go has no scoped enum, so each constant
   carries the type name; `v.ident` already does, which is why only the
   package qualifies it here. #}
	{
		spec := ref.enumEntry(t, "{{ f.ref_section }}", "{{ f.name }}")

		// Count first: a vocabulary that gained or lost a variant without
		// the manifest moving would otherwise satisfy every assertion below.
		if len(spec.Variants) != {{ f.variants | length }} {
			t.Fatalf("{{ f.name }}: oracle has %d variants, manifest has {{ f.variants | length }}",
				len(spec.Variants))
		}

{% for v in f.variants %}
		if spec.Variants[{{ loop.index0 }}].Name != "{{ v.name }}" {
			t.Errorf("{{ f.name }} variant {{ loop.index0 }}: oracle names %q, manifest %q",
				spec.Variants[{{ loop.index0 }}].Name, "{{ v.name }}")
		}
		if int64({{ f.name }}.{{ v.ident }}) != spec.Variants[{{ loop.index0 }}].Value {
			t.Errorf("{{ f.name }}.{{ v.name }} = %d, want %d",
				int64({{ f.name }}.{{ v.ident }}),
				spec.Variants[{{ loop.index0 }}].Value)
		}
{% endfor %}
	}
