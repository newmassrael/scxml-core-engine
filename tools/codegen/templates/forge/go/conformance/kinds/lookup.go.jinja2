{% if f.output.type != "string" %}
{# Lookup kind — finite key→value mapping. on_miss=error generates (V, bool)
   (false on miss is a hard failure since happy-path fixtures hit every key);
   on_miss=default generates raw V via fallback. #}
	cases := ref.pureCases(t, "{{ f.ref_section }}", "{{ f.name }}")
	for _, c := range cases {
{% for arg_ty in f.args %}
		var arg{{ loop.index0 }} {{ arg_ty | go_type }}
		unmarshalOrFatal(t, c.Args[{{ loop.index0 }}], &arg{{ loop.index0 }}, "{{ f.name }} arg{{ loop.index0 }}")
{% endfor %}
		var expected {{ f.output.type | go_type }}
		unmarshalOrFatal(t, c.Expected, &expected, "{{ f.name }} expected")
{% if f.on_miss == "error" %}
		actual, ok := {{ f.name }}.{{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
		if !ok {
			t.Fatalf("{{ f.name }}: happy-path lookup miss")
		}
{% else %}
		actual := {{ f.name }}.{{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
{% endif %}
{% if f.output.compare == "tolerance" %}
		assertClose(t, float64(actual), float64(expected), ref.FloatTolerance, "{{ f.name }}")
{% else %}
		if actual != expected {
			t.Errorf("{{ f.name }}: actual=%v expected=%v", actual, expected)
		}
{% endif %}
	}
{% else %}
{# String-output lookup — enum-to-string via helper. #}
	cases := ref.stringLookupCases(t, "{{ f.ref_section }}", "{{ f.name }}")
	for _, c := range cases {
{% for arg_ty in f.args %}
		var arg{{ loop.index0 }} {{ arg_ty | go_type }}
		unmarshalOrFatal(t, c.Args[{{ loop.index0 }}], &arg{{ loop.index0 }}, "{{ f.name }} arg{{ loop.index0 }}")
{% endfor %}
		expected := c.Expected
		actual := {{ f.name }}.{{ f.function }}({% for arg_ty in f.args %}arg{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
		actualStr := {{ f.name | to_camel_case }}ValueName(actual)
		if actualStr != expected {
			t.Errorf("{{ f.name }}: actual=%s expected=%s", actualStr, expected)
		}
	}
{% endif %}
