{# Timer kind — verify registration metadata and callback dispatch via recording mocks. #}
        from sce_forge_runtime.timer import Timer as _TimerBase

        class _RecTimer(_TimerBase):
            def __init__(self):
                self.reg_type = ""
                self.reg_ms = 0
                self.reg_cb = None
            def start_periodic(self, interval_ms, callback):
                self.reg_type = "periodic"
                self.reg_ms = interval_ms
                self.reg_cb = callback
            def start_one_shot(self, delay_ms, callback):
                self.reg_type = "one_shot"
                self.reg_ms = delay_ms
                self.reg_cb = callback
            def cancel(self):
                pass

        class _RecHandler({{ f.name }}.{{ f.name | to_pascal_case }}Handler):
            def __init__(self):
                self.last_call = ""
{% for t in f.timers %}
            def {{ t.callback | to_snake_case }}(self):
                self.last_call = "{{ t.callback }}"
{% endfor %}

        handler = _RecHandler()
{% for t in f.timers %}
        timer_{{ t.id | to_snake_case }} = _RecTimer()
{% endfor %}
        scheduler = {{ f.name }}.{{ f.name | to_pascal_case }}(
            handler{% for t in f.timers %}, timer_{{ t.id | to_snake_case }}{% endfor %})
{% for t in f.timers %}
        scheduler.start_{{ t.id | to_snake_case }}()
{% endfor %}

        oracle_timers = spec["timers"]
        timers = [{% for t in f.timers %}timer_{{ t.id | to_snake_case }}{% if not loop.last %}, {% endif %}{% endfor %}]
        for ti, ot in enumerate(oracle_timers):
            rec = timers[ti]
            self.assertEqual(rec.reg_type, ot["type"],
                f"{{ f.name }}: timer {ti} type")
            self.assertEqual(rec.reg_ms, ot["interval_ms"],
                f"{{ f.name }}: timer {ti} interval")
            rec.reg_cb()
            self.assertEqual(handler.last_call, ot["callback"],
                f"{{ f.name }}: timer {ti} callback")
