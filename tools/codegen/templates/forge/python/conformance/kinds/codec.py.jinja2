{# Codec kind — round-trip { decoded, encoded } cases. Python's generated
   dataclass uses snake_case field names, so every SCXML-source-case
   (camelCase) name in fixtures.json is converted via `to_snake_case`.
   `encode_to_bytes()` returns `bytes`; `decode(cursor)` is a classmethod taking
   an `sce_forge_runtime.codec.SceCursor` and returning the value, which raises
   the `CodecError` subclass that names a refusal. #}
{% if not f.oracle_eligible %}
        # Compile-only probe: oracle_eligible=false because the fixture's
        # field shape isn't expressible in the current StructField /
        # CanonicalType schema (typed nested codec, Optional[T], or
        # parent-flag-bearing carrier). The fixture's module import was
        # already resolved at test load; this no-arg dataclass
        # construction drags the @dataclass field defaults through the
        # Python type checker (and through `__init__`'s required-arg
        # check) so a silently-broken-codegen regression class —
        # missing default, dataclass requiring positional args — fails
        # at test time rather than waiting for a future round-trip.
        _codec_val = {{ f.name }}.{{ f.name | to_pascal_case }}()
        del _codec_val
{% else %}
        for i, case in enumerate(spec["cases"]):
{% if f.fields %}
            decoded = case["decoded"]
{% endif %}
{# A codec printed from its plan holds no element its encode derives
   (docs/adr/0081 §3): the value is made without it, and the decode gives
   none back. #}
{% for field in f.fields if not (f.printed and field.derived) %}
{% if field.type == "bytes" and field.optional %}
            {# An absent entry is JSON `null`, `None` here and in the class. #}
            input_{{ field.name | to_snake_case }} = None if decoded["{{ field.name }}"] is None else bytes(decoded["{{ field.name }}"])
{% elif field.type == "bytes" %}
            input_{{ field.name | to_snake_case }} = bytes(decoded["{{ field.name }}"])
{% else %}
            input_{{ field.name | to_snake_case }} = decoded["{{ field.name }}"]
{% endif %}
{% endfor %}
            expected_bytes = bytes(case["encoded"])
            {# A case marked `decode_only` is a wire a peer may send that is
               not the one this encode writes (a VLE padded past its minimal
               encoding): its bytes decode to the value and are read whole,
               and the encode is not held to them. #}
            decode_only = case.get("decode_only", False)

            if not decode_only:
                value = {{ f.name }}.{{ f.name | to_pascal_case }}(
{% for field in f.fields if not (f.printed and field.derived) %}
                    {{ field.name | to_snake_case }}=input_{{ field.name | to_snake_case }}{% if not loop.last %},{% endif %}
{% endfor %}
                )
                encoded = value.encode_to_bytes()
                self.assertEqual(
                    encoded,
                    expected_bytes,
                    f"{{ f.name }} case {i} encode",
                )

            from sce_forge_runtime.codec import SceCursor as _SceCursor
            cursor = _SceCursor(expected_bytes)
            round_tripped = {{ f.name }}.{{ f.name | to_pascal_case }}.decode(cursor)
            if decode_only:
                self.assertEqual(
                    cursor.remaining(),
                    0,
                    f"{{ f.name }} case {i}: a decode-only frame is read whole",
                )
{% for field in f.fields if not (f.printed and field.derived) %}
            self.assertEqual(
                getattr(round_tripped, "{{ field.name | to_snake_case }}"),
                input_{{ field.name | to_snake_case }},
                f"{{ f.name }} case {i} decode {{ field.name }}",
            )
{% endfor %}
{% endif %}

{# Byte cases stated as the codec's interface presents the value
   (docs/adr/0081 §5), the same cases the Rust and C++ fragments run, for a
   codec the Python backend prints from its plan: each `source` is the printed
   dataclass, made by its constructor from the case, written by the generator
   from the codec's plan, and its bytes were computed by an independent model.
   The value is encoded by the module's `encode_source` and compared with the
   bytes (law 4 of docs/adr/0058 §5), and the bytes are decoded and what the
   decode presents compared with the value, element by element (law 1).
   Independent of `oracle_eligible`, which speaks of the `cases`. #}
{% for s in f.sources %}
        from sce_forge_runtime.codec import BytearraySink as _BytearraySink, SceCursor as _SceCursor
        value = {{ s.literal }}
        _encoded = bytearray()
        {{ f.name }}.encode_source(value, _BytearraySink(_encoded){% for i in s.encode_inputs %}, {{ i }}{% endfor %})
        _expected = bytes([{{ s.encoded | join(", ") }}])
        self.assertEqual(
            bytes(_encoded),
            _expected,
            "{{ f.name }} source {{ loop.index0 }}: {{ s.note }}",
        )
        _cursor = _SceCursor(_expected)
{# A refused decode raises the `CodecError` that names why, which fails the
   test with that kind (docs/adr/0099, amendment of 2026-11-16). #}
        decoded = {{ f.name }}.{{ f.name | to_pascal_case }}.decode(_cursor{% for i in s.inputs %}, {{ i }}{% endfor %})
        self.assertEqual(
            _cursor.remaining(),
            0,
            "{{ f.name }} source {{ loop.index0 }}: the decode left bytes of the frame unread",
        )
{% for c in s.checks %}
        self.assertTrue(
            {{ c.holds }},
            "{{ f.name }} source {{ loop.index0 }}: the decode presents another {{ c.element }}",
        )
{% endfor %}
{% endfor %}

{# Refused cases (docs/adr/0081 §5): each `source` is a value of the codec's
   interface its encode refuses, made as a source is, and the encode raises
   exactly the refusal the case names, the runtime's exception class, before it
   writes a byte, so the sink is left empty. #}
{% for r in f.refused %}
        import sce_forge_runtime.codec
        from sce_forge_runtime.codec import BytearraySink as _BytearraySink
        value = {{ r.literal }}
        _encoded = bytearray()
        with self.assertRaises(
            {{ r.symbol }},
            msg="{{ f.name }} refused {{ loop.index0 }}: the encode answers {{ r.error }}: {{ r.note }}",
        ):
            {{ f.name }}.encode_source(value, _BytearraySink(_encoded){% for i in r.encode_inputs %}, {{ i }}{% endfor %})
        self.assertEqual(
            len(_encoded),
            0,
            "{{ f.name }} refused {{ loop.index0 }}: the encode wrote bytes before it refused",
        )
{% endfor %}

{# RFC synth-5-B decode-rejection vectors — see the Rust fragment for the
   shape. The generated Python `decode` raises the `CodecError` subclass that
   names the refusal (docs/adr/0099, amendment of 2026-11-16), and `r.symbol`
   is that class's name, so the vector asserts the kind and not only that the
   decode refused. #}
{% for r in f.rejects %}
        from sce_forge_runtime.codec import CodecError as _CodecError, SceCursor as _SceCursor
        with self.assertRaises(_CodecError, msg="{{ f.name }} reject {{ loop.index0 }}: {{ r.why }}") as _refused:
            {{ f.name }}.{{ f.name | to_pascal_case }}.decode(
                _SceCursor(bytes([{{ r.encoded | join(", ") }}]))
            )
        self.assertEqual(
            type(_refused.exception).__name__,
            "{{ r.symbol }}",
            "{{ f.name }} reject {{ loop.index0 }} is refused as {{ r.error }}: {{ r.why }}",
        )
{% endfor %}
