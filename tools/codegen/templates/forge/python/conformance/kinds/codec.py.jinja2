{# Codec kind — round-trip { decoded, encoded } cases. Python's generated
   dataclass uses snake_case field names, so every SCXML-source-case
   (camelCase) name in fixtures.json is converted via `to_snake_case`.
   `encode()` returns `bytes`; `decode(cursor)` is a classmethod taking
   an `sce_forge_runtime.codec.SceCursor` and returning `Optional[...]`. #}
{% if not f.oracle_eligible %}
        # Compile-only probe: oracle_eligible=false because the fixture's
        # field shape isn't expressible in the current StructField /
        # CanonicalType schema (typed nested codec, Optional[T], or
        # parent-flag-bearing carrier). The fixture's module import was
        # already resolved at test load; this no-arg dataclass
        # construction drags the @dataclass field defaults through the
        # Python type checker (and through `__init__`'s required-arg
        # check) so a silently-broken-codegen regression class —
        # missing default, dataclass requiring positional args — fails
        # at test time rather than waiting for a future round-trip.
        _codec_val = {{ f.name }}.{{ f.name | to_pascal_case }}()
        del _codec_val
{% else %}
        for i, case in enumerate(spec["cases"]):
{% if f.fields %}
            decoded = case["decoded"]
{% endif %}
{% for field in f.fields %}
{% if field.type == "bytes" %}
            input_{{ field.name | to_snake_case }} = bytes(decoded["{{ field.name }}"])
{% else %}
            input_{{ field.name | to_snake_case }} = decoded["{{ field.name }}"]
{% endif %}
{% endfor %}
            expected_bytes = bytes(case["encoded"])

            value = {{ f.name }}.{{ f.name | to_pascal_case }}(
{% for field in f.fields %}
                {{ field.name | to_snake_case }}=input_{{ field.name | to_snake_case }}{% if not loop.last %},{% endif %}
{% endfor %}
            )
            encoded = value.encode()
            self.assertEqual(
                encoded,
                expected_bytes,
                f"{{ f.name }} case {i} encode",
            )

            from sce_forge_runtime.codec import SceCursor as _SceCursor
            cursor = _SceCursor(expected_bytes)
            round_tripped = {{ f.name }}.{{ f.name | to_pascal_case }}.decode(cursor)
            self.assertIsNotNone(
                round_tripped,
                f"{{ f.name }} case {i} decode returned None",
            )
{% for field in f.fields %}
            self.assertEqual(
                getattr(round_tripped, "{{ field.name | to_snake_case }}"),
                input_{{ field.name | to_snake_case }},
                f"{{ f.name }} case {i} decode {{ field.name }}",
            )
{% endfor %}
{% endif %}
