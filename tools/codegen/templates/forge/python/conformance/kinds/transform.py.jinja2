{# Transform kind — pure free function(s), single or compound output; or,
   for a document that reads a field through previous(), its holder driven
   through the oracle's sequence twice: from a new holder, then after
   reset(). Both passes are held to the same oracle, which is what says
   reset() restores every kept value. #}
{% if f.holder %}
        holder = {{ f.name }}.{{ f.holder.new }}()
        for pass_index in range(2):
            if pass_index:
                holder.{{ f.holder.reset }}()
            for i, step in enumerate(spec["sequence"]):
                out = holder.{{ f.holder.update }}(*step["args"])
                expected = step["expected"]
{% for co in f.compound_outputs %}
{% if co.compare == "tolerance" %}
                self.assert_close(out.{{ co.field }}, expected["{{ co.key }}"], f"{{ f.name }} pass {pass_index} step {i} {{ co.key }}")
{% else %}
                self.assertEqual(out.{{ co.field }}, expected["{{ co.key }}"], f"{{ f.name }} pass {pass_index} step {i} {{ co.key }}")
{% endif %}
{% endfor %}
{% else %}
        for case in spec["cases"]:
            args = case["args"]
{% if f.output %}
            expected = case["expected"]
            actual = {{ f.name }}.{{ f.output.function }}(*args)
{% if f.output.compare == "tolerance" %}
            self.assert_close(actual, expected, "{{ f.name }}")
{% else %}
            self.assertEqual(actual, expected, "{{ f.name }}")
{% endif %}
{% else %}
            expected = case["expected"]
{% for co in f.compound_outputs %}
            actual_{{ co.key }} = {{ f.name }}.{{ co.function }}(*args)
{% if co.compare == "tolerance" %}
            self.assert_close(actual_{{ co.key }}, expected["{{ co.key }}"], "{{ f.name }} {{ co.key }}")
{% else %}
            self.assertEqual(actual_{{ co.key }}, expected["{{ co.key }}"], "{{ f.name }} {{ co.key }}")
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
