// Transition execution macro - compresses repetitive transition code
#ifdef AOT_EXECUTE_TRANSITION
#undef AOT_EXECUTE_TRANSITION
#endif
{% if model.has_parallel_states %}
#define AOT_EXECUTE_TRANSITION(SRC, TGT, IDX, HAS_ACTIONS, IS_INTERNAL, IS_TARGETLESS) \
    do { \
        AOT_DEBUG("AOT processTransition: Transition matched in state {}", static_cast<int>(SRC)); \
        lastTransitionSourceState_ = SRC; \
        lastTransitionIsInternal_ = IS_INTERNAL; \
        lastTransitionIsTargetless_ = IS_TARGETLESS; \
        if (collectMode != nullptr) { \
            AOT_DEBUG("AOT processTransition: Collecting transition {} -> {}", static_cast<int>(SRC), static_cast<int>(TGT)); \
            collectMode->push_back(TransitionInfo(SRC, TGT, IDX, HAS_ACTIONS, IS_INTERNAL, IS_TARGETLESS)); \
        } else { \
            AOT_DEBUG("AOT processTransition: State transition {} -> {}", static_cast<int>(currentState), static_cast<int>(TGT)); \
            currentState = TGT; \
            transitionTaken = true; \
        } \
    } while(0)
{% else %}
#define AOT_EXECUTE_TRANSITION(SRC, TGT, IDX, HAS_ACTIONS, IS_INTERNAL, IS_TARGETLESS) \
    do { \
        AOT_DEBUG("AOT processTransition: Transition matched in state {} -> {}", static_cast<int>(SRC), static_cast<int>(TGT)); \
        lastTransitionSourceState_ = SRC; \
        lastTransitionIsInternal_ = IS_INTERNAL; \
        lastTransitionIsTargetless_ = IS_TARGETLESS; \
        currentState = TGT; \
        transitionTaken = true; \
    } while(0)
{% endif %}

