// {{ machine }}'s Mesh peers, as deploy.yaml binds them (SCE_MESH.md §mesh-19),
// generated from {{ document }}.
//
// GENERATED — DO NOT EDIT. `sce-codegen generate --deploy <deploy.yaml> --lang kotlin`.
// A host builds its router with `{{ document_pascal }}MeshPeers.MACHINE.router()` and opens
// one connection per `PeerLink` below; every rule about envelopes lives in `com.sce.mesh`.

package com.sce.generated.{{ document }}

import com.sce.mesh.Delivery
import com.sce.mesh.MeshMachine
import com.sce.mesh.Peer
import com.sce.mesh.PeerConfig
import com.sce.mesh.PeerLink

object {{ document_pascal }}MeshPeers {
    /** {{ machine }}'s side of the deployment. */
    val MACHINE: MeshMachine = MeshMachine(
        name = "{{ machine | escape_kotlin }}",
        dedupWindow = {{ dedup_window }}u,
        gapTimeoutMs = {{ gap_timeout_ms }}L,
        peers = listOf(
{%- for peer in peers %}
            Peer(
                name = "{{ peer.name | escape_kotlin }}",
                config = PeerConfig(
                    transport = "{{ peer.transport }}",
{%- if peer.buffer %}
                    buffer = com.sce.mesh.OutboundBuffer(
                        maxPending = {{ peer.buffer.max_pending }}u,
                        maxAgeMs = {{ peer.buffer.max_age_ms }}L,
                    ),
{%- else %}
                    buffer = null,
{%- endif %}
{%- if peer.retry %}
                    retry = com.sce.mesh.RetryPolicy(
                        maxRetries = {{ peer.retry.max_retries }}u,
                        initialBackoffMs = {{ peer.retry.initial_backoff_ms }}L,
                        backoffMultiplier = {{ peer.retry.backoff_multiplier }},
                        maxBackoffMs = {{ peer.retry.max_backoff_ms }}L,
                        jitterPct = {{ peer.retry.jitter_pct }}L,
                    ),
{%- else %}
                    retry = null,
{%- endif %}
                    stampSequence = {{ peer.stamp_sequence }},
                    delivery = Delivery(dedup = {{ peer.dedup }}, ordered = {{ peer.ordered }}),
                ),
{%- if peer.link.kind == "wss_dial" %}
                link = PeerLink.WssDial(
                    url = "{{ peer.link.url | escape_kotlin }}",
                    keepaliveMs = {% if peer.link.keepalive_ms %}{{ peer.link.keepalive_ms }}u{% else %}null{% endif %},
                ),
{%- else %}
                link = PeerLink.WssAccept(
                    keepaliveMs = {% if peer.link.keepalive_ms %}{{ peer.link.keepalive_ms }}u{% else %}null{% endif %},
                ),
{%- endif %}
            ),
{%- endfor %}
        ),
    )
}
