{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{#- The core's name for deploy.yaml's `authenticator` word of an HTTPS binding (SCE_MESH.md
    section 22.5), spelled in full so that a table without an HTTPS peer imports nothing for it. -#}
{%- macro https_authenticator(word) -%}
sce_rust_mesh::peers::HttpsAuthenticator::{% if word == "bearer" %}Bearer{% elif word == "install" %}Install{% elif word == "key" %}Key{% else %}Mtls{% endif %}
{%- endmacro %}
{#- A key id or a trust set's name the binding may leave out (docs/adr/0109, D9). -#}
{%- macro optional_name(name) -%}
{%- if name %}Some("{{ name | escape_rust }}"){% else %}None{% endif %}
{%- endmacro %}
{#- A binding's receipt (docs/adr/0109, D10): durable, with how the machine's durable bindings
    send, or the transport's. -#}
{%- macro receipt(durable) -%}
{%- if durable %}sce_rust_mesh::peers::Receipt::Durable { window: {{ durable.window }}, retry_ms: {{ durable.retry_ms }} }{% else %}sce_rust_mesh::peers::Receipt::Transport{% endif %}
{%- endmacro %}
{#- One limiter of an HTTPS server's edge (docs/adr/0109, D2), or none. -#}
{%- macro edge_rate(rate) -%}
{%- if rate %}Some(sce_rust_mesh::peers::EdgeRate { interval_ms: {{ rate.interval_ms }}, burst: {{ rate.burst }} }){% else %}None{% endif %}
{%- endmacro %}
{#- SCE_MESH.md §mesh-19: one machine's peer table for the Rust host Mesh
    core (backends/rust/mesh). Data only — every value was decided by
    `mesh::codegen::peer_policy`, the function the C++ router's context is
    built from, so the two cores cannot read one binding two ways.

    `machine` is the deploy.yaml key — the `source` the machine's envelopes
    carry — and `document` the SCXML document it was generated from. A
    host includes the file as a module (`#[path = "…"] mod …;`), which is
    what lets the marker below be an inner attribute. -#}
{{ sce_map.source_marker(source_location, "rust", module_level=true, symbol_artifact=sce_artifact.machine) }}
// {{ machine }}'s Mesh peers, as deploy.yaml binds them (SCE_MESH.md §mesh-19),
// generated from {{ document }}.
//
// GENERATED — DO NOT EDIT. `sce-codegen generate --deploy <deploy.yaml> --lang rust`.
// A host builds its router with `MACHINE.router()` and opens one connection per
// `PeerLink` below; every rule about envelopes lives in `sce_rust_mesh`.

use sce_rust_mesh::inbound::Delivery;
use sce_rust_mesh::peers::{Machine, Peer, PeerLink};
use sce_rust_mesh::router::PeerConfig;

/// {{ machine }}'s side of the deployment.
pub const MACHINE: Machine = Machine {
    name: "{{ machine | escape_rust }}",
    dedup_window: {{ dedup_window }},
    gap_timeout_ms: {{ gap_timeout_ms }},
    peers: &[
{%- for peer in peers %}
        Peer {
            name: "{{ peer.name | escape_rust }}",
            config: PeerConfig {
                transport: "{{ peer.transport }}",
{%- if peer.buffer %}
                buffer: Some(sce_rust_mesh::outbound::OutboundBuffer {
                    max_pending: {{ peer.buffer.max_pending }},
                    max_age_ms: {{ peer.buffer.max_age_ms }},
                }),
{%- else %}
                buffer: None,
{%- endif %}
{%- if peer.retry %}
                retry: Some(sce_rust_mesh::outbound::RetryPolicy {
                    max_retries: {{ peer.retry.max_retries }},
                    initial_backoff_ms: {{ peer.retry.initial_backoff_ms }},
                    backoff_multiplier: {{ peer.retry.backoff_multiplier }}_f64,
                    max_backoff_ms: {{ peer.retry.max_backoff_ms }},
                    jitter_pct: {{ peer.retry.jitter_pct }},
                }),
{%- else %}
                retry: None,
{%- endif %}
                stamp_sequence: {{ peer.stamp_sequence }},
                delivery: Delivery {
                    dedup: {{ peer.dedup }},
                    ordered: {{ peer.ordered }},
                },
                responders: &[{% for r in peer.responders %}"{{ r | escape_rust }}"{% if not loop.last %}, {% endif %}{% endfor %}],
                deadline_ms: {% if peer.deadline_ms is not none %}Some({{ peer.deadline_ms }}){% else %}None{% endif %},
                reply_events: &[{% for e in peer.reply_events %}"{{ e | escape_rust }}"{% if not loop.last %}, {% endif %}{% endfor %}],
{%- if peer.causal %}
                causal: Some(sce_rust_mesh::causal::CausalGroup {
                    name: "{{ peer.causal.name | escape_rust }}",
                    epoch: {{ peer.causal.epoch }},
                    view: &[{% for v in peer.causal.view %}"{{ v | escape_rust }}"{% if not loop.last %}, {% endif %}{% endfor %}],
                }),
{%- else %}
                causal: None,
{%- endif %}
            },
{%- if peer.link.kind == "wss_dial" %}
            link: PeerLink::WssDial {
                url: "{{ peer.link.url | escape_rust }}",
                keepalive_ms: {% if peer.link.keepalive_ms %}Some({{ peer.link.keepalive_ms }}){% else %}None{% endif %},
            },
{%- elif peer.link.kind == "zenoh_inbox" %}
            link: PeerLink::ZenohInbox,
{%- elif peer.link.kind == "https_dial" %}
            link: PeerLink::HttpsDial {
                url: "{{ peer.link.url | escape_rust }}",
                authenticator: {{ https_authenticator(peer.link.authenticator) }},
                hold_ms: {{ peer.link.hold_ms }},
                verify: {{ optional_name(peer.link.verify) }},
                receipt: {{ receipt(peer.link.receipt) }},
            },
{%- elif peer.link.kind == "https_accept" %}
            link: PeerLink::HttpsAccept {
                listen: "{{ peer.link.listen | escape_rust }}",
                authenticator: {{ https_authenticator(peer.link.authenticator) }},
                max_hold_ms: {{ peer.link.max_hold_ms }},
                max_body_bytes: {{ peer.link.max_body_bytes }},
                absence_ms: {{ peer.link.absence_ms }},
                mailbox: {{ peer.link.mailbox }},
                max_clients: {{ peer.link.max_clients }},
                max_response_bytes: {{ peer.link.max_response_bytes }},
                rate: sce_rust_mesh::peers::EdgeRates {
                    address: {{ edge_rate(peer.link.rate.address) }},
                    client: {{ edge_rate(peer.link.rate.client) }},
                    failed_auth: {{ edge_rate(peer.link.rate.failed_auth) }},
                    new_names: {{ edge_rate(peer.link.rate.new_names) }},
                    max_tracked: {{ peer.link.rate.max_tracked }},
                },
                trusted_proxies: &[{% for p in peer.link.trusted_proxies %}"{{ p | escape_rust }}"{% if not loop.last %}, {% endif %}{% endfor %}],
                sign: {{ optional_name(peer.link.sign) }},
                max_skew_ms: {{ peer.link.max_skew_ms }},
                receipt: {{ receipt(peer.link.receipt) }},
                retain_ms: {{ peer.link.retain_ms }},
            },
{%- else %}
            link: PeerLink::WssAccept {
                keepalive_ms: {% if peer.link.keepalive_ms %}Some({{ peer.link.keepalive_ms }}){% else %}None{% endif %},
            },
{%- endif %}
        },
{%- endfor %}
    ],
{#- deploy.yaml `sessions:`: the machine served as a keyed pool of sessions
    (`sce_rust_mesh::pool`), as `topology::resolve_keyed_pool` read it
    against the document. -#}
{%- if sessions %}
    sessions: Some(sce_rust_mesh::peers::Sessions {
{%- if sessions.key_field is not none %}
        key_from: sce_rust_mesh::peers::KeyFrom::Field("{{ sessions.key_field | escape_rust }}"),
{%- else %}
        key_from: sce_rust_mesh::peers::KeyFrom::Client,
{%- endif %}
        max_key_bytes: {{ sessions.max_key_bytes }},
        idle_ms: {{ sessions.idle_ms }},
        max_live: {{ sessions.max_live }},
        max_inbox: {{ sessions.max_inbox }},
    }),
{%- else %}
    sessions: None,
{%- endif %}
};
