{#
    Script engine helpers (Python Jinja2)

    Emits the script/guard execution helpers and the W3C SCXML 5.3 early-binding
    datamodel initialiser. The Python backend evaluates `<script>`, `<assign
    expr>`, and `cond` expressions directly against `self._ns` via `exec` /
    `eval` — there is no separate script-engine indirection. Variable names
    that collide with Python keywords are escaped with a trailing underscore
    via the `escape_python_keyword` filter (load-bearing for `<data id="class"
    expr="42"/>` style fixtures).
#}

    # ── Script helpers ─────────────────────────────────────────────

    def _raise_error_execution(self, engine) -> None:
        """W3C SCXML 3.8 — push `error.execution` onto the internal queue
        when the running document declares the descriptor. Documents
        without an `error.execution` transition still need block-abort
        (per 3.8 "subsequent siblings in the same block are skipped"),
        so the calling helper raises `_ActionAbort` independently of
        whether this method enqueues anything."""
        evt = self.get_event_from_name("error.execution")
        if evt is not None:
            engine.raise_internal(evt)

    def _exec(self, engine, script: str) -> None:
        """W3C SCXML 5.5 — execute a `<script>` statement against the
        user-provided namespace. An uncaught Python exception raises
        `error.execution` on the internal queue (W3C 3.8) and aborts the
        current executable-content block via `_ActionAbort`."""
        try:
            exec(script, self._ns)  # noqa: S102 — script source is statically baked
        except Exception:
            self._raise_error_execution(engine)
            raise _ActionAbort

    def _guard(self, engine, expr: str) -> bool:
        """W3C SCXML 3.13 — evaluate a transition / `<if>` guard. On
        evaluation error the spec requires `error.execution` to land on
        the internal queue and the cond to be treated as `false`. We do
        NOT abort the block here: the caller is either `select_transition`
        (which has no block) or an `<if>`/`<elseif>` cascade (whose
        next-branch evaluation is allowed to proceed per 4.2)."""
        try:
            return bool(eval(expr, self._ns))  # noqa: S307 — guard expression is statically baked
        except Exception:
            self._raise_error_execution(engine)
            return False

    def _assign(self, engine, location: str, expr: str) -> None:
        """W3C SCXML 5.4 — evaluate `expr` and bind the result at
        `location` in the datamodel. Two failure modes both surface as
        `error.execution` + block-abort:
          * `location` is not in `_DECLARED_VARS` (assignment to an
            undeclared name — W3C 5.4 §2);
          * the right-hand `expr` evaluation raises (e.g. attribute access
            on `undefined`).
        On success the namespace is updated in place."""
        if location not in _DECLARED_VARS:
            self._raise_error_execution(engine)
            raise _ActionAbort
        try:
            self._ns[location] = eval(expr, self._ns)  # noqa: S307
        except Exception:
            self._raise_error_execution(engine)
            raise _ActionAbort

    def _assign_runtime(self, location: str, value) -> None:
        """W3C SCXML 5.3 — assign a runtime value (already computed, not a
        text expression) at `location`. Used by `<foreach>` to bind the
        current item/index without re-evaluating it as source text."""
        self._ns[location] = value

    def _log(self, label: str, expr: str) -> None:
        """W3C SCXML 6.4 `<log>` — evaluate `expr` against the datamodel
        and dispatch through the policy's log hook. The default hook
        writes a single line to stdout; callers wanting structured
        logging should override `log_hook` in a subclass."""
        try:
            value = eval(expr, self._ns) if expr else ""  # noqa: S307
        except Exception as exc:  # noqa: BLE001 — surface eval errors
            value = f"<log eval error: {exc!r}>"
        self.log_hook(label, value)

    def log_hook(self, label: str, value) -> None:
        """Override to redirect `<log>` output. Default prints to stdout
        in the form `[label] value` (or just `value` when no label)."""
        if label:
            print(f"[{label}] {value}")
        else:
            print(value)

    def _foreach(self, array_expr: str):
        """W3C SCXML 4.6 `<foreach>` with index binding — yields
        `(index, value)` pairs after evaluating `array_expr` against the
        datamodel. Lists, tuples, and any iterable are accepted; mappings
        iterate as `(key, value)` pairs in insertion order."""
        try:
            collection = eval(array_expr, self._ns)  # noqa: S307
        except Exception:
            return iter(())
        if isinstance(collection, dict):
            return enumerate(collection.items())
        return enumerate(collection)

    def _eval_sendid(self, sendid_expr: str) -> str:
        """W3C SCXML 6.2.2 `<cancel sendidexpr>` — evaluate `sendid_expr`
        against the datamodel and coerce the result to a string. Empty
        / missing values map to the empty string (matches the scheduler
        contract that empty ids cannot be cancelled)."""
        try:
            value = eval(sendid_expr, self._ns)  # noqa: S307
        except Exception:
            return ""
        return "" if value is None else str(value)

    def _eval_event_name(self, event_expr: str):
        """W3C SCXML 6.2 `<send eventexpr>` — evaluate `event_expr`
        against the datamodel and resolve the resulting name to an
        Event enum member. Returns `None` when the name does not match
        any declared event (callers raise `error.execution` per W3C
        6.2)."""
        try:
            name = str(eval(event_expr, self._ns))  # noqa: S307
        except Exception:
            return None
        return _EVENT_BY_NAME.get(name)

    def _eval_delay_ms(self, delay_expr: str) -> int:
        """W3C SCXML 6.2 `<send delayexpr>` — evaluate `delay_expr` and
        coerce the result into milliseconds. Accepts:
          * `int` / `float` — interpreted as milliseconds directly;
          * `str` — parsed via `_parse_delay_text` ("5s", "500ms", "0");
          * anything else — treated as `0` (matches W3C 6.2 "delay must
            be a non-negative integer" with sensible fallback)."""
        try:
            value = eval(delay_expr, self._ns)  # noqa: S307
        except Exception:
            return 0
        if isinstance(value, bool):
            return 0
        if isinstance(value, (int, float)):
            return max(0, int(value))
        if isinstance(value, str):
            return _parse_delay_text(value)
        return 0

    def _build_http_params(self, params_specs, namelist: str):
        """W3C SCXML C.2 — assemble the form-encoded multi-map handed
        to `engine.perform_http_send`. `params_specs` is a sequence of
        `(name, expr)` tuples (one per `<param>`); `namelist` is the
        whitespace-separated variable list. Each value is coerced to
        str so the HTTP layer can urlencode it uniformly. Eval errors
        on individual `<param expr>` skip that param (matches the
        looser W3C "best effort" form-encoding contract — the engine
        does NOT abort the surrounding block for a malformed param)."""
        result = {}
        if namelist:
            for var in namelist.split():
                value = self._ns.get(var)
                result.setdefault(var, []).append(
                    "" if value is None else str(value)
                )
        for name, expr in params_specs:
            try:
                value = eval(expr, self._ns)  # noqa: S307
            except Exception:
                continue
            result.setdefault(name, []).append(
                "" if value is None else str(value)
            )
        return result

    def _eval_send_payload(
        self,
        params,
        content: str,
        content_expr: str,
        namelist: str,
    ):
        """W3C SCXML 5.10 — marshal `<send>` payload into `_event.data`.

        Precedence per W3C 6.2: `<content expr>` > `<content>` literal >
        `<param>` + namelist hybrid. When all three are absent, returns
        `""` so `_event.data` is the empty string (the W3C default).
        `params` is a sequence of `(name, expr)` tuples; `namelist` is
        whitespace-separated variable names whose current bindings join
        the parameter dict."""
        if content_expr:
            try:
                return eval(content_expr, self._ns)  # noqa: S307
            except Exception:
                return ""
        if content:
            return content
        if not params and not namelist:
            return ""
        marshalled = {}
        if namelist:
            for var in namelist.split():
                marshalled[var] = self._ns.get(var)
        for name, expr in params:
            try:
                marshalled[name] = eval(expr, self._ns)  # noqa: S307
            except Exception:
                marshalled[name] = None
        return marshalled

    def set_current_event(self, event, metadata) -> None:
        """W3C SCXML 5.10 — bind `_event` into the datamodel for the
        current microstep so user expressions can read `_event.name`,
        `_event.data.foo`, `_event.sendid`, etc. Engine dispatches one
        call per externally-triggered / internally-raised event before
        transition selection."""
        from types import SimpleNamespace
        self._ns["_event"] = SimpleNamespace(
            name=_EVENT_NAMES.get(event, ""),
            data=_wrap_event_data(metadata.data),
            type=metadata.event_type,
            sendid=metadata.send_id,
            origin=metadata.origin,
            origintype=metadata.origin_type,
            invokeid=metadata.invoke_id,
        )

    def _resolve_send_id(self, engine, idlocation: str, explicit_id: str) -> str:
        """W3C SCXML 6.2 — produce the canonical sendid for a `<send>`.
        When `explicit_id` is non-empty it wins; otherwise the engine
        generates a deterministic auto-id. When `idlocation` is set the
        chosen id is written back into the datamodel so user code can
        `<cancel sendid="..."/>` it later."""
        sid = explicit_id if explicit_id else engine._next_auto_sendid()
        if idlocation:
            self._ns[idlocation] = sid
        return sid

    @staticmethod
    def _event_name_matches(descriptor: str, name: str) -> bool:
        """W3C SCXML 3.13 — a transition's event descriptor matches an
        event when, for any space-separated sub-descriptor, the
        descriptor's dot-tokens are a prefix of the event's dot-tokens.
        Trailing `.*` is spec sugar (`foo.*` is identical to `foo`); a
        bare `*` matches every event (the caller is responsible for
        screening out the NULL eventless sentinel). Used only for
        prefix / multi-token descriptors; exact single-token matches
        keep the byte-stable `event == Event.X` fast path."""
        name_tokens = name.split(".") if name else []
        for desc in descriptor.split():
            if desc == "*":
                return True
            if desc.endswith(".*"):
                desc = desc[:-2]
            desc_tokens = desc.split(".") if desc else []
            if not desc_tokens:
                continue
            if len(desc_tokens) > len(name_tokens):
                continue
            if name_tokens[: len(desc_tokens)] == desc_tokens:
                return True
        return False

    def _foreach_values(self, array_expr: str):
        """W3C SCXML 4.6 `<foreach>` without index binding — yields each
        value in turn. Dict iteration yields keys (mirrors Python
        semantics for `for k in d`)."""
        try:
            collection = eval(array_expr, self._ns)  # noqa: S307
        except Exception:
            return iter(())
        return iter(collection)

    def is_late_binding(self) -> bool:
        return {{ 'True' if model.binding == 'late' else 'False' }}

    def initialize_datamodel(self, engine) -> None:
        # W3C SCXML B.3 ECMAScript datamodel — surface the four bare-name
        # literals that SCXML expressions use in `<cond>` and `<assign expr>`.
        # `setdefault` preserves any user `<data id="null"…>` override so the
        # author still wins; absent that, eval finds the standard ECMAScript
        # values instead of raising `NameError` on `null` / `undefined`.
        self._ns.setdefault("false", False)
        self._ns.setdefault("true", True)
        self._ns.setdefault("null", None)
        self._ns.setdefault("undefined", None)

        # W3C SCXML 5.9.2 `In(state)` predicate — true when `state` (matched
        # by the SCXML `id` text) is in the active configuration, including
        # compound ancestors and parallel siblings. Captured against the
        # engine so guard expressions like `In('s1')` resolve at evaluation
        # time without threading the engine through every `_guard` call.
        def _scxml_In(state_id):
            for active in engine.active_configuration():
                if str(active) == state_id:
                    return True
            return False
        self._ns["In"] = _scxml_In
