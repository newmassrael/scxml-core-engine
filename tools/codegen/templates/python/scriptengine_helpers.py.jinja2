{#
    Script engine helpers (Python Jinja2)

    Emits the executable-content helpers and the W3C SCXML 5.3 early-binding
    datamodel initialiser. The Python backend now matches every other backend
    (Rust / Go / Kotlin / C11 / C++) by routing every author expression through
    the IScriptEngine boundary: each helper hands a Lua text string (the
    `to_lua_expr` / `to_lua_guard` / `to_lua_script` transform output) to the
    process-wide LuaScriptEngine and unwraps the result into a Python value.
    `self._session_id` is bound by the engine at construction so helpers can
    address the right session without an extra parameter on every call site.
#}

    # ── Script helpers ─────────────────────────────────────────────

    def _raise_error_execution(self, engine) -> None:
        """W3C SCXML 3.8 — push `error.execution` onto the internal queue
        when the running document declares the descriptor. The event is
        platform-generated (`<assign>` or `<script>` eval failure), so
        the metadata `event_type` is `"platform"` per W3C 5.10 — guards
        reading `_event.type` distinguish this from `<raise>`-internal
        events (test 331). Documents without an `error.execution`
        transition still need block-abort (W3C 3.8 "subsequent siblings
        in the same block are skipped"), so the calling helper raises
        `_ActionAbort` independently of whether this method enqueues
        anything."""
        evt = self.get_event_from_name("error.execution")
        if evt is not None:
            engine.raise_internal(evt, EventMetadata(event_type="platform"))

    def _exec(self, engine, lua_script: str) -> None:
        """W3C SCXML 5.5 — execute a `<script>` body. The text was
        rewritten from ECMAScript to Lua at codegen time
        (`to_lua_script`). Runtime / syntax errors raise
        `error.execution` and abort the surrounding executable-content
        block via `_ActionAbort` (W3C 3.8)."""
        if not lua_script:
            return
        try:
            engine._script_engine.execute_script(self._session_id, lua_script)
        except _ScriptError:
            self._raise_error_execution(engine)
            raise _ActionAbort

    def _guard(self, engine, lua_expr: str) -> bool:
        """W3C SCXML 3.13 — evaluate a transition / `<if>` guard. The
        spec requires `error.execution` on eval failure plus a `False`
        return; the block-abort sentinel is NOT raised here so an
        `<if>`/`<elseif>` cascade's next branch keeps the opportunity
        to evaluate (W3C 4.2)."""
        if not lua_expr:
            return True
        try:
            result = engine._script_engine.evaluate_expression(
                self._session_id, lua_expr
            )
        except _ScriptError:
            self._raise_error_execution(engine)
            return False
        return result.to_bool()

    def _assign(self, engine, location: str, lua_expr: str) -> None:
        """W3C SCXML 5.4 — evaluate `lua_expr` and bind the result at
        `location` in the datamodel. Three failure modes surface as
        `error.execution` + block-abort:
          * `location` is empty or names a read-only system variable
            (`_event` / `_sessionid` / `_name` / `_ioprocessors`) per
            W3C B.2 — mirrors the Rust assign template's codegen-time
            check at `tools/codegen/templates/rust/actions/assign.rs.jinja2:21`;
          * `lua_expr` is empty (W3C 5.4 — `<assign>` requires expr);
          * the script engine raises during the `<loc> = <expr>` assign.
        Implementation uses `execute_script` (not `set_variable`) so Lua
        reference identity is preserved across the assign — `Var2 =
        _event` keeps `Var2` and `_event` pointing at the same Lua
        table (W3C SCXML test 329 depends on this)."""
        if not location or location in _READONLY_SYSTEM_VARS:
            self._raise_error_execution(engine)
            raise _ActionAbort
        if not lua_expr:
            self._raise_error_execution(engine)
            raise _ActionAbort
        try:
            engine._script_engine.execute_script(
                self._session_id, f"{location} = {lua_expr}"
            )
        except _ScriptError:
            self._raise_error_execution(engine)
            raise _ActionAbort

    def _assign_content(
        self, engine, location: str, lua_expr: str, fallback: str
    ) -> None:
        """W3C SCXML 5.4 — `<assign>` with inline content (XML body or
        literal text). Mirrors `_init_data_with_content`: try Lua eval
        first; on failure (XML element / freeform text) bind the
        whitespace-normalised string. Read-only system vars + empty
        location still raise `error.execution` like the expr-form
        `_assign`."""
        if not location or location in _READONLY_SYSTEM_VARS:
            self._raise_error_execution(engine)
            raise _ActionAbort
        try:
            engine._script_engine.execute_script(
                self._session_id, f"{location} = {lua_expr}"
            )
            return
        except _ScriptError:
            pass
        # W3C SCXML B.2 — fallback to whitespace-normalised string
        # (covers XML element content per test530).
        try:
            engine._script_engine.set_variable(
                self._session_id, location, _ScriptValue.of(fallback)
            )
        except _ScriptError:
            self._raise_error_execution(engine)
            raise _ActionAbort

    def _assign_runtime(self, engine, location: str, value) -> None:
        """W3C SCXML 4.6 / 5.3 — assign a runtime-computed value (e.g.
        a `<foreach>` iteration item/index) at `location`. An empty,
        read-only, or syntactically illegal identifier is illegal per
        W3C 4.6 (test152: `<foreach item="" …>`; test457: `<foreach
        item="'continue'" …>` — quote chars make the name unusable as
        a datamodel location). Mirrors `sce-rust-runtime::helpers::
        foreach::is_legal_variable_name`."""
        if (
            not location
            or location in _READONLY_SYSTEM_VARS
            or not self._is_legal_identifier(location)
        ):
            self._raise_error_execution(engine)
            raise _ActionAbort
        engine._script_engine.set_variable(
            self._session_id, location, _ScriptValue.of(value)
        )

    @staticmethod
    def _is_legal_identifier(name: str) -> bool:
        """W3C SCXML 4.6 — ECMAScript IdentifierName: leading
        letter/underscore/dollar, then alnum/underscore/dollar."""
        if not name:
            return False
        first = name[0]
        if not (first.isalpha() or first == "_" or first == "$"):
            return False
        for ch in name[1:]:
            if not (ch.isalnum() or ch == "_" or ch == "$"):
                return False
        return True

    def _init_data_with_content(
        self, engine, var_id: str, lua_expr: str, fallback: str
    ) -> None:
        """W3C SCXML 5.2.2 — initialise a `<data>` element whose content
        is inline text. Mirrors Rust's `eval_or_set_string`
        (helpers/datamodel_init.rs:107): try Lua eval first, fall back to
        JSON.parse for `[...]` / `{...}` payloads, then XML→DOM
        (`set_variable_as_dom`) for `<…>` content per W3C B.2 (test557 +
        test557 via `src=`), and finally to a whitespace-normalised
        string."""
        try:
            value = engine._script_engine.evaluate_expression(
                self._session_id, lua_expr
            )
            engine._script_engine.declare_variable(self._session_id, var_id, value)
            return
        except _ScriptError:
            pass
        trimmed = lua_expr.strip() if lua_expr else ""
        if trimmed.startswith(("[", "{")):
            try:
                value = engine._script_engine.evaluate_expression(
                    self._session_id,
                    f"JSON.parse([==[{trimmed}]==])",
                )
                engine._script_engine.declare_variable(
                    self._session_id, var_id, value
                )
                return
            except _ScriptError:
                pass
        if trimmed.startswith("<"):
            # W3C SCXML B.2 — XML inline content / `src="file:*.xml"`
            # loaded text binds as a DOM-style value so generated
            # guards can call `:getElementsByTagName(...)` /
            # `:getAttribute(...)`. Mirrors Rust template's
            # `datamodel_macros.rs.jinja2:62-69` XML branch.
            try:
                engine._script_engine.set_variable_as_dom(
                    self._session_id, var_id, trimmed
                )
                return
            except _ScriptError:
                pass
        # W3C SCXML B.2 — final fallback to whitespace-normalised string.
        engine._script_engine.declare_variable(
            self._session_id, var_id, _ScriptValue.of(fallback)
        )

    def _log(self, engine, label: str, lua_expr: str) -> None:
        """W3C SCXML 6.4 `<log>` — evaluate `lua_expr` against the
        datamodel and dispatch through the policy's log hook. The
        default hook writes a single line to stdout; callers wanting
        structured logging should override `log_hook` in a subclass."""
        if not lua_expr:
            self.log_hook(label, "")
            return
        try:
            value = engine._script_engine.evaluate_expression(
                self._session_id, lua_expr
            ).to_python()
        except _ScriptError as exc:
            value = f"<log eval error: {exc!r}>"
        self.log_hook(label, value)

    def log_hook(self, label: str, value) -> None:
        """Override to redirect `<log>` output. Default prints to stdout
        in the form `[label] value` (or just `value` when no label)."""
        if label:
            print(f"[{label}] {value}")
        else:
            print(value)

    def _foreach(self, engine, lua_array_expr: str):
        """W3C SCXML 4.6 `<foreach>` with index binding — yields
        `(index, value)` pairs after evaluating `lua_array_expr`
        against the datamodel. Per the spec, an invalid / non-iterable
        array raises `error.execution` and aborts the surrounding
        executable-content block (the test 152 case)."""
        if not lua_array_expr:
            self._raise_error_execution(engine)
            raise _ActionAbort
        try:
            collection = engine._script_engine.evaluate_expression(
                self._session_id, lua_array_expr
            ).to_python()
        except _ScriptError:
            self._raise_error_execution(engine)
            raise _ActionAbort
        if collection is None:
            self._raise_error_execution(engine)
            raise _ActionAbort
        if isinstance(collection, dict):
            return enumerate(collection.items())
        try:
            return enumerate(collection)
        except TypeError:
            self._raise_error_execution(engine)
            raise _ActionAbort

    def _foreach_values(self, engine, lua_array_expr: str):
        """W3C SCXML 4.6 `<foreach>` without index binding — yields
        each value in turn. Invalid array semantics match `_foreach`
        (raises `error.execution` + block-abort)."""
        if not lua_array_expr:
            self._raise_error_execution(engine)
            raise _ActionAbort
        try:
            collection = engine._script_engine.evaluate_expression(
                self._session_id, lua_array_expr
            ).to_python()
        except _ScriptError:
            self._raise_error_execution(engine)
            raise _ActionAbort
        if collection is None:
            self._raise_error_execution(engine)
            raise _ActionAbort
        try:
            return iter(collection)
        except TypeError:
            self._raise_error_execution(engine)
            raise _ActionAbort

    def _eval_sendid(self, engine, lua_sendid_expr: str) -> str:
        """W3C SCXML 6.2.2 `<cancel sendidexpr>` — evaluate the Lua
        expression and coerce the result to a string. Empty / missing
        values map to the empty string (matches the scheduler contract
        that empty ids cannot be cancelled)."""
        if not lua_sendid_expr:
            return ""
        try:
            value = engine._script_engine.evaluate_expression(
                self._session_id, lua_sendid_expr
            ).to_python()
        except _ScriptError:
            return ""
        return "" if value is None else str(value)

    def _eval_event_name(self, engine, lua_event_expr: str):
        """W3C SCXML 6.2 `<send eventexpr>` — evaluate the Lua
        expression and resolve the resulting name to an Event enum
        member. Returns `None` when the name does not match any
        declared event (callers raise `error.execution` per W3C 6.2)."""
        try:
            value = engine._script_engine.evaluate_expression(
                self._session_id, lua_event_expr
            ).to_python()
        except _ScriptError:
            return None
        if value is None:
            return None
        return _EVENT_BY_NAME.get(str(value))

    def _eval_delay_ms(self, engine, lua_delay_expr: str) -> int:
        """W3C SCXML 6.2 `<send delayexpr>` — evaluate the Lua
        expression and coerce the result into milliseconds. Accepts:
          * `int` / `float` — interpreted as milliseconds directly;
          * `str` — parsed via `_parse_delay_text` ("5s", "500ms", "0");
          * anything else — treated as `0` (matches W3C 6.2 "delay must
            be a non-negative integer" with sensible fallback)."""
        try:
            value = engine._script_engine.evaluate_expression(
                self._session_id, lua_delay_expr
            ).to_python()
        except _ScriptError:
            return 0
        if isinstance(value, bool):
            return 0
        if isinstance(value, (int, float)):
            return max(0, int(value))
        if isinstance(value, str):
            return _parse_delay_text(value)
        return 0

    def _build_http_params(self, engine, params_specs, namelist: str):
        """W3C SCXML C.2 — assemble the form-encoded multi-map handed
        to `engine.perform_http_send`. `params_specs` is a sequence of
        `(name, lua_expr)` tuples (one per `<param>`); `namelist` is
        the whitespace-separated variable list. Eval errors on
        individual `<param>` skip that param (W3C "best effort"
        form-encoding contract — the engine does NOT abort the
        surrounding block for a malformed param)."""
        result = {}
        if namelist:
            for var in namelist.split():
                try:
                    value = engine._script_engine.get_variable(
                        self._session_id, var
                    ).to_python()
                except _ScriptError:
                    continue
                result.setdefault(var, []).append(
                    "" if value is None else str(value)
                )
        for name, lua_expr in params_specs:
            try:
                value = engine._script_engine.evaluate_expression(
                    self._session_id, lua_expr
                ).to_python()
            except _ScriptError:
                continue
            result.setdefault(name, []).append(
                "" if value is None else str(value)
            )
        return result

    def _eval_send_payload(
        self,
        engine,
        params,
        content: str,
        lua_content_expr: str,
        namelist: str,
    ):
        """W3C SCXML 5.10 — marshal `<send>` payload into `_event.data`.

        Precedence per W3C 6.2: `<content expr>` > `<content>` literal >
        `<param>` + namelist hybrid. When all three are absent, returns
        `""` so `_event.data` is the empty string (W3C default).
        `params` is a sequence of `(name, lua_expr)` tuples; `namelist`
        is whitespace-separated variable names whose current bindings
        join the parameter dict.

        W3C SCXML 6.2: "If the evaluation of `<send>`'s arguments produces
        an error, the Processor MUST discard the message without
        attempting to deliver it. Furthermore, it MUST place the error
        'error.execution' on the internal event queue." Implemented by
        raising `error.execution` + `_ActionAbort` so the caller's outer
        `try/except _ActionAbort: pass` swallows the rest of THIS block
        (W3C 3.8) and the surrounding `engine.send_external(...)` call
        does not run. Mirrors the Rust template's `_send_aborted` flag
        in `tools/codegen/templates/rust/actions/send.rs.jinja2`, but
        unified with the W3C 3.8 block-abort contract every other
        Python-AOT helper already uses (`_assign`, `_exec`, `_guard`)."""
        if lua_content_expr:
            try:
                return engine._script_engine.evaluate_expression(
                    self._session_id, lua_content_expr
                ).to_python()
            except _ScriptError:
                self._raise_error_execution(engine)
                raise _ActionAbort
        if content:
            return content
        if not params and not namelist:
            return ""
        marshalled = {}
        if namelist:
            for var in namelist.split():
                if not engine._script_engine.has_variable(
                    self._session_id, var
                ):
                    self._raise_error_execution(engine)
                    raise _ActionAbort
                try:
                    marshalled[var] = engine._script_engine.get_variable(
                        self._session_id, var
                    ).to_python()
                except _ScriptError:
                    self._raise_error_execution(engine)
                    raise _ActionAbort
        for name, lua_expr in params:
            try:
                marshalled[name] = engine._script_engine.evaluate_expression(
                    self._session_id, lua_expr
                ).to_python()
            except _ScriptError:
                self._raise_error_execution(engine)
                raise _ActionAbort
        return marshalled

