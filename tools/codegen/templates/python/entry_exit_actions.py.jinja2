{#
    Entry/Exit Actions (Python Jinja2)

    W3C SCXML 3.8 / 3.9 — emits `execute_entry_actions` and
    `execute_exit_actions`. Supported action kinds in β: `<script>`,
    `<assign location expr>`, `<raise event>` (see `_actions.py.jinja2`).
    Unsupported kinds fall through to an explicit raise so silent
    degradation never occurs ([[feedback-silently-broken-hooks]]).
#}
{%- import '_actions.py.jinja2' as actions %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}

    # ── Entry actions (W3C SCXML 3.8) ─────────────────────────────

    def execute_entry_actions(self, state, engine) -> None:
{# W3C SCXML 3.8 — every `<onentry>` block is wrapped in
   `try/except _ActionAbort` so an `<assign>`/`<script>` failure
   raises `error.execution` and skips the rest of THIS block, while
   the next `<onentry>` block on the same state still runs (each
   `<onentry>` is its own block per W3C 3.8.1).

   W3C SCXML 5.5 + 3.7 + 6.3.1 — `<final>` states with `<donedata>`
   evaluate the data in the final's onentry and either:
     - top-level `<final>` (no parent): stash on the engine so the
       invoking parent's `ScxmlInvoke.done_data()` can lift it into
       `done.invoke.<id>._event.data`;
     - nested `<final>` (parent compound): raise the parent's
       `done.state.<parent>` event with the evaluated data as
       `_event.data` so the parent's transition can read it (test294).
   Mirrors `tools/codegen/templates/rust/entry_exit_actions.rs.jinja2`
   donedata evaluation + done.state branching. #}
{% for state_id, state in model.states | dictsort %}
{% set _has_donedata = state.is_final and state.donedata and (state.donedata.params or state.donedata.content.kind != 'none') %}
{% set _final_with_parent = state.is_final and state.parent and (('done.state.' ~ state.parent) in model.events) %}
{% if state.on_entry_blocks or state.initial_transition_actions or state.initial_history_default_actions or _has_donedata or _final_with_parent %}
        if state == {{ machine_name }}State.{{ state_id | to_python_const }}:{{ annot.annotation_comment(state, "python", "            ") }}
{% for block in state.on_entry_blocks %}
            try:
{% for action in block %}
{{ annot.annotation_block(action, "python", "                ") }}{{ actions.emit(action, '                ', machine_name, model) }}
{% endfor %}
            except _ActionAbort:
                pass
{% endfor %}
{% if state.initial_transition_actions %}
            # W3C SCXML 3.3.2 — `<initial>` transition's executable content
            # runs AFTER the compound's `<onentry>` and BEFORE descent into
            # the default initial child (test412). Block-aborts symmetric
            # to onentry: a failing action raises `error.execution` and
            # discards the remaining actions in this block only.
            try:
{% for action in state.initial_transition_actions %}
{{ actions.emit(action, '                ', machine_name, model) }}
{% endfor %}
            except _ActionAbort:
                pass
{% endif %}
{% if state.initial_history_id and state.initial_history_default_actions %}
            # W3C SCXML 3.11 — `<initial>` targets `<history id="{{ state.initial_history_id }}">`:
            # the history element's default `<transition>` executable
            # content runs only when no snapshot exists. Subsequent
            # entries replay from `engine._history[...]` via the engine's
            # `_enter_from_history_snapshot` so the default actions are
            # suppressed once the compound has been exited at least once.
            # Mirrors Rust template's `entry_exit_actions.rs.jinja2:72-80`.
            if not engine._history.get({{ state.initial_history_id | py_string_literal }}):
                try:
{% for action in state.initial_history_default_actions %}
{{ actions.emit(action, '                    ', machine_name, model) }}
{% endfor %}
                except _ActionAbort:
                    pass
{% endif %}
{% if _has_donedata %}
            # W3C SCXML 5.5: Build donedata as Lua source text so the
            # downstream `set_current_event` dispatch reconstructs an
            # equivalent Lua value via its `return <text>` parse path —
            # `to_lua_literal()` preserves string identity (`'foo'`
            # round-trips, not the bare identifier `foo`). Mirrors the
            # Rust template's `done_event_data = val.to_lua_literal()`
            # at `tools/codegen/templates/rust/entry_exit_actions.rs.jinja2:180`.
            _done_data_ok = True
            _done_data: str = ""
{% if state.donedata.params %}
            _done_parts: List[str] = []
{% for param in state.donedata.params %}
{% set _pexpr = param.expr or param.location %}
{% if not _pexpr %}
            # W3C SCXML 5.7: `<param>` with empty expr/location is a
            # structural error — raise error.execution and skip stash.
            self._raise_error_execution(engine)
            _done_data_ok = False
{% else %}
            try:
                _done_parts.append(
                    '[{{ param.name | py_string_literal }}] = '
                    + engine._script_engine.evaluate_expression(
                        self._session_id,
                        {{ _pexpr | to_lua_expr | py_string_literal }},
                    ).to_lua_literal()
                )
            except _ScriptError:
                self._raise_error_execution(engine)
{% endif %}
{% endfor %}
            if _done_data_ok:
                _done_data = "{" + ", ".join(_done_parts) + "}"
{% elif state.donedata.content.kind == "expression" %}
            try:
                _done_data = engine._script_engine.evaluate_expression(
                    self._session_id,
                    {{ state.donedata.content.text | to_lua_expr | py_string_literal }},
                ).to_lua_literal()
            except _ScriptError:
                _done_data_ok = False
                self._raise_error_execution(engine)
{% elif state.donedata.content.kind == "literal" %}
            # W3C SCXML 5.5: `<content>` literal text is used as the
            # raw `_event.data` value. Wrap the text in a Lua string
            # literal at runtime via `_ScriptValue.of(...).to_lua_literal()`
            # so the dispatch's `return <text>` eval reconstructs an
            # identical string regardless of which characters the
            # literal contains.
            _done_data = _ScriptValue.of(
                {{ state.donedata.content.text | py_string_literal }}
            ).to_lua_literal()
{% endif %}
{% if state.parent and ('done.state.' ~ state.parent) in model.events %}
            # W3C SCXML 5.5 + 3.7: a donedata eval failure raises
            # `error.execution` AND still fires `done.state.<parent>`
            # with empty `_event.data` (test528). The error.execution
            # has already been raised inline; here we always raise the
            # done event, supplying empty data on the failure path so
            # the surrounding transition can still match.
            engine.raise_internal(
                {{ machine_name }}Event.{{ ('done.state.' ~ state.parent) | to_python_const }},
                EventMetadata(data=_done_data if _done_data_ok else "", event_type="internal"),
            )
{% endif %}
{% endif %}
{% if state.is_final and not _has_donedata and state.parent and (('done.state.' ~ state.parent) in model.events) %}
            # W3C SCXML 3.7: entering a `<final>` raises
            # `done.state.<parent_id>` even when no `<donedata>` is
            # present. The engine separately fires
            # `done.state.<parallel_id>` from `_check_done_state_events`
            # once every region of a parallel reaches its final, so
            # this raise covers only the immediate parent (test372).
            engine.raise_internal(
                {{ machine_name }}Event.{{ ('done.state.' ~ state.parent) | to_python_const }},
                EventMetadata(event_type="internal"),
            )
{% endif %}
{% if state.is_final and _has_donedata and not state.parent %}
            # W3C SCXML 5.5 + 6.3.1: top-level `<final>` stashes
            # donedata onto the engine; the invoking parent's
            # `ScxmlInvoke.done_data()` lifts it into
            # `done.invoke.<id>._event.data`.
            if _done_data_ok:
                engine.done_data = _done_data
{% endif %}
            return
{% endif %}
{% endfor %}
        return

    # ── Exit actions (W3C SCXML 3.9) ──────────────────────────────

    def execute_exit_actions(self, state, engine) -> None:
{# W3C SCXML 3.9 — `<onexit>` block-abort symmetric to entry above. #}
{% for state_id, state in model.states | dictsort %}
{% if state.on_exit_blocks %}
        if state == {{ machine_name }}State.{{ state_id | to_python_const }}:{{ annot.annotation_comment(state, "python", "            ") }}
{% for block in state.on_exit_blocks %}
            try:
{% for action in block %}
{{ annot.annotation_block(action, "python", "                ") }}{{ actions.emit(action, '                ', machine_name, model) }}
{% endfor %}
            except _ActionAbort:
                pass
{% endfor %}
            return
{% endif %}
{% endfor %}
        return
