   `send.classify_target` holds (C++ `SendHelper::classifyTarget`). A Mesh peer
   is the host router's (SCE_MESH.md §mesh-19), never this session's. #}
{# The delivery to the address the target produced rests on the TARGET's
   questions, whatever the type's are. #}
{% if dynamic_mesh %}
{{ indent }}if _is_mesh_target(_target_str):
{{ host_send_request(action, indent ~ '    ', 'sce:mesh', has_payload, has_delay, delay_py, machine_name, model, route_ns.target_arg) }}
{{ indent }}else:
{{ routed_to_target(indent ~ '    ', has_delay, delay_py, machine_name, model, route_ns.target_arg) }}
{% else %}
{{ routed_to_target(indent, has_delay, delay_py, machine_name, model, route_ns.target_arg) }}
{% endif %}
{% else %}
{# W3C SCXML 6.2 — this session's external queue, now or after the delay. #}
{% if dyn_event %}
{{ indent }}_evt = self.get_event_from_name(_evt_name)
{{ indent }}if _evt is not None:
{% if has_delay %}
{{ indent }}    engine.schedule_send(_evt, {{ delay_py }}, _sid, _data)
{% else %}
{{ indent }}    engine.send_to_self(_evt, _sid, _data)
{% endif %}
{% elif has_delay %}
{{ indent }}engine.schedule_send({{ machine_name }}Event.{{ action.event | to_python_const }}, {{ delay_py }}, _sid, _data)
{% else %}
{{ indent }}engine.send_to_self({{ machine_name }}Event.{{ action.event | to_python_const }}, _sid, _data)
{% endif %}
{% endif %}
{% if payload_can_fail %}
{{ indent }}if _param_failures:
{{ indent }}    raise _ActionAbort  # W3C SCXML 4.9: the <param> / <content> error ends the block
{% endif %}
{% endif %}{# end of the build-time refusals #}
{% endif -%}
{% endmacro -%}
