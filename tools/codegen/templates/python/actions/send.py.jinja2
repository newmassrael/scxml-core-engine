{# W3C SCXML 6.2 — `<send>`. A send with nothing to evaluate takes the γ-3b
   fast path at the bottom, whose code shape the fast-path goldens pin.
   Every other send is composed from four parts, each decided once: the
   element's own arguments (the prologue), the payload (`_data`), the event,
   and the delivery. Every delivery arm reads the parts; none evaluates
   anything itself, so an argument cannot be read one way for one target and
   another way for the next. #}
{# §scxml-6.2.5 — the act a host-served send performs, for `processor_type`.
   One body for the two ways a send reaches it: a type the build saw served by
   the host (`send_type_host_served`, a Mesh send the build lowered among them)
   and a `targetexpr` that turns out, at run time, to name a Mesh peer. The
   host's text params are the payload read as the wire reads it, so no
   `<param>` is evaluated twice, and its event data is the text `_event.data`
   would hold. #}
{# `route_arg` is `, rests_on=(...)` when this act is the delivery of a route read
   from data the specification leaves open, and empty otherwise: the failure
   below is then the route's, and carries the questions it rests on. #}
{%- macro host_send_request(action, indent, processor_type, has_payload, has_delay, delay_py, machine_name, model, route_arg='') -%}
{{ indent }}_host_request = _HostSendRequest(
{{ indent }}    processor_type={{ processor_type | py_string_literal }},
{{ indent }}    event_name=_evt_name,
{{ indent }}    target={% if action.targetexpr %}_target_str{% else %}{{ action.target | py_string_literal }}{% endif %},
{{ indent }}    content={{ action.content | py_string_literal }},
{{ indent }}    params=self._wire_params_from_payload(_data),
{{ indent }}    send_id=_sid,
{{ indent }}    event_data=self._event_data_text(_data, {{ action.content | to_lua_data_content | py_string_literal }}, {{ 'True' if has_payload else 'False' }}),
{# SCE_MESH.md §mesh-10.7: the invokeid of the event being processed now,
   carried back out as a W3C child's send to its parent carries it
   (§scxml-6.4.1). #}
{{ indent }}    invoke_id=engine.current_event_invoke_id,
{{ indent }})
{% if has_delay %}
{# W3C SCXML 6.2.4: a `delay` is a property of the SEND, not of the processor
   it named. The engine performs the act from its scheduler drain at the
   deadline, including the W3C SCXML 6.2 report for an act nobody performed.
   W3C SCXML 6.3: it lands in the delayed-send queue under `_sid`, so a
   `<cancel>` reaches it and the host never sees the act. The refusal made at
   the deadline is a failure of the route when the act is the delivery of one
   (`route_arg`), and so carries the questions the route rests on. #}
{{ indent }}engine.schedule_host_send(_host_request, {{ delay_py }}, _sid{{ route_arg }})
{% else %}
{{ indent }}_host_served = engine.perform_host_send(_host_request)
{% if 'error.execution' in model.events %}
{# W3C SCXML 6.2 — a declared type with no handler registered is, from the
   document's side, a processor the platform does not support: the act it
   asked for was performed by nobody. #}
{{ indent }}if _host_served is None and not engine.has_event_processor({{ processor_type | py_string_literal }}):
{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.execution' | to_python_const }}, EventMetadata(send_id=_sid, event_type="platform"){{ route_arg }})
{% endif %}
{% endif %}
{%- endmacro -%}
{#- W3C SCXML 6.2.4 + C.1 — a send to the value a `targetexpr` resolved now,
    through `engine.send_to_target`; a value that is not a target is
    error.execution, one naming nothing there error.communication, and either
    ends the block (W3C SCXML 4.9). -#}
{%- macro routed_to_target(indent, has_delay, delay_py, machine_name, model, route_arg='') -%}
{{ indent }}_routed = engine.send_to_target(self.get_event_from_name(_evt_name), _evt_name, _target_str, {% if has_delay %}{{ delay_py }}{% else %}0{% endif %}, _sid, _data{{ route_arg }})
{{ indent }}if _routed == "unsupported":
{% if 'error.execution' in model.events %}
{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.execution' | to_python_const }}, EventMetadata(send_id=_sid, event_type="platform"){{ route_arg }})
{% endif %}
{{ indent }}    raise _ActionAbort  # W3C SCXML 4.9: the error ends the block
{{ indent }}if _routed == "unreachable":
{% if 'error.communication' in model.events %}
{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.communication' | to_python_const }}, EventMetadata(send_id=_sid, event_type="platform"){{ route_arg }})
{% endif %}
{{ indent }}    raise _ActionAbort  # W3C SCXML 4.9: the error ends the block
{%- endmacro -%}
{%- macro emit_send(action, indent, machine_name, model) -%}
{% set has_namelist = action.namelist and action.namelist | trim %}
{% set has_payload = action.params or has_namelist or action.content or action.contentexpr %}
{% set has_delay = action.delayexpr or action.delay_ms > 0 %}
{% set dyn_event = action.eventexpr and not action.event %}
{% set is_http = action.send_type == 'http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor' %}
{# §scxml-6.2.4: a route chosen at run time from data the specification leaves
   open. `route_ns.type_arg` and `route_ns.target_arg` are `, rests_on=(...)`
   naming the questions the `typeexpr` and the `targetexpr` each rest on. The
   type's is passed where the TYPE fails (its evaluation, a processor this
   platform does not support) and the target's where the TARGET does (its
   evaluation, the address it produces, the delivery to it): the two fail
   independently, and a type that names a variable nobody declared is not mended
   by an answer about the target. An event name, a delay, a namelist or a payload
   that fails is a fault of the document that no answer to either question would
   mend, so it is raised without them. A send resting on no question leaves both
   empty and the generated code unchanged. #}
{% set route_ns = namespace(type_arg='', target_arg='', text='') %}
{% for decision in action.type_decisions %}
{% set route_ns.text = route_ns.text ~ (decision | py_string_literal) ~ ', ' %}
{% endfor %}
{% if route_ns.text %}
{% set route_ns.type_arg = ', rests_on=(' ~ route_ns.text ~ ')' %}
{% endif %}
{% set route_ns.text = '' %}
{% for decision in action.target_decisions %}
{% set route_ns.text = route_ns.text ~ (decision | py_string_literal) ~ ', ' %}
{% endfor %}
{% if route_ns.text %}
{% set route_ns.target_arg = ', rests_on=(' ~ route_ns.text ~ ')' %}
{% endif %}
{% set has_dynamic = action.delay_invalid or action.eventexpr or action.targetexpr or action.typeexpr or action.delayexpr or action.idlocation
                     or has_payload or action.send_type_host_served or action.send_type_unsupported
                     or is_http or action.target_unsupported or action.target.startswith('#_')
                     or action.target.startswith('http://') or action.target.startswith('https://') %}
{% if not has_dynamic %}
{# γ-3b fast path: no dynamic attrs, no payload, no idlocation. #}
{% if action.delay_ms > 0 -%}
{{ indent }}engine.schedule_send({{ machine_name }}Event.{{ action.event | to_python_const }}, {{ action.delay_ms }}, {% if action.id %}{{ action.id | py_string_literal }}{% else %}engine._next_auto_sendid(){% endif %})
{% else -%}
{{ indent }}engine.send_to_self({{ machine_name }}Event.{{ action.event | to_python_const }}, {% if action.id %}{{ action.id | py_string_literal }}{% else %}""{% endif %})
{% endif -%}
{% elif action.delay_invalid and not action.delayexpr %}
{# W3C SCXML 6.2: the written delay is not a CSS2 time (ARCHITECTURE.md,
   "Durations"; the build decided it once). It is known before anything is
   evaluated, so the send ends here with the argument error, as it does on
   every engine. #}
{{ indent }}_sid = {{ (action.id | py_string_literal) if action.id else 'engine._next_auto_sendid()' }}
{% if 'error.execution' in model.events %}
{{ indent }}engine.raise_internal({{ machine_name }}Event.{{ 'error.execution' | to_python_const }}, EventMetadata(data="<send> delay is not a CSS2 time", send_id=_sid, event_type="platform"))
{% endif %}
{{ indent }}raise _ActionAbort  # W3C SCXML 4.9: the error ends the block
{% else %}
{# W3C SCXML 5.7.1 + 4.9: a `<param>` that cannot be read is reported and its
   pair left out, and the message still goes; the error ends the block once
   it has. The payload helper appends each failed name here, and the check
   at the end of this macro reads it after the act. A `<content expr>` that
   cannot be read is the same shape (W3C SCXML 5.6.2): reported, the message
   sent with '' as its value, the block ended. #}
{% set payload_can_fail = action.params or action.contentexpr %}
{% if payload_can_fail %}
{{ indent }}_param_failures = []
{% endif %}
{# ── The element's own arguments, evaluated once ──
   W3C SCXML 6.2: "The Processor MUST evaluate all arguments to <send> when the
   <send> element is evaluated", and "if the evaluation of <send>'s arguments
   produces an error, the Processor MUST discard the message without attempting
   to deliver it". The first failure is one error.execution carrying the send
   id and a block abort (`_send_argument_error`, W3C SCXML 4.9). The send id
   comes first, so an `idlocation` holds it even when a later argument fails
   (test332). #}
{{ indent }}_sid = self._resolve_send_id(engine, {{ action.idlocation | to_lua_location | py_string_literal }}, {% if action.id %}{{ action.id | py_string_literal }}{% else %}""{% endif %})
{% if action.eventexpr %}
{# An event name that evaluates to nothing names no event: the same failure as
   one that does not evaluate. #}
{{ indent }}_evt_name = self._eval_send_argument(engine, _sid, {{ action.eventexpr | to_lua_expr | py_string_literal }}, "<send> eventexpr could not be evaluated to an event name").to_wire_string()
{{ indent }}if not _evt_name:
{{ indent }}    self._send_argument_error(engine, _sid, "<send> eventexpr could not be evaluated to an event name")
{% endif %}
{% if action.targetexpr %}
{# §scxml-C-1: a target expression's value is read as text — the same reading
   C++ `resultToString` gives it. A target this processor cannot address is
   refused as a static one is (W3C SCXML 6.2, test194). #}
{{ indent }}_target_value = self._eval_send_argument(engine, _sid, {{ action.targetexpr | to_lua_expr | py_string_literal }}, "<send> targetexpr could not be evaluated"{{ route_ns.target_arg }})
{{ indent }}_target_str = _target_value.to_wire_string()
{{ indent }}if _is_invalid_target(_target_str):
{{ indent }}    self._send_argument_error(engine, _sid, "<send> targetexpr produced a target this processor cannot address"{{ route_ns.target_arg }})
{% endif %}
{% if action.typeexpr %}
{# W3C SCXML 6.2: a type the platform does not support is the same error as
   one that cannot be evaluated. #}
{{ indent }}if not _is_supported_send_type(self._eval_send_argument(engine, _sid, {{ action.typeexpr | to_lua_expr | py_string_literal }}, "<send> typeexpr could not be evaluated"{{ route_ns.type_arg }}).to_wire_string()):
{{ indent }}    self._send_argument_error(engine, _sid, "<send> typeexpr names a processor this platform does not support"{{ route_ns.type_arg }})
{% endif %}
{% if action.delayexpr %}
{# The expression failing is the argument error; the message is not scheduled
   under some default wait. #}
{{ indent }}_delay_ms = self._eval_send_delay(engine, _sid, {{ action.delayexpr | to_lua_expr | py_string_literal }})
{% endif %}
{% if has_namelist %}
{{ indent }}_namelist_values = self._eval_send_namelist(engine, _sid, {{ action.namelist | py_string_literal }})
{% endif %}
{% if action.targetexpr %}
{# W3C SCXML C.1 (test496, test521): a target that evaluates to no value, or to
   text that names nothing (empty or "undefined"), is not reachable —
   error.communication, nothing delivered, and the error ends the block as any
   other would (W3C SCXML 4.9). A self-sent event names its origin, so
   `targetexpr="_event.origin"` (test336) reads this session's location, never
   "". #}
{{ indent }}if _target_value.to_python() is None or _is_unreachable_target(_target_str):
{% if 'error.communication' in model.events %}
{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.communication' | to_python_const }}, EventMetadata(data="<send> targetexpr evaluated to nothing, so there is no target to reach", send_id=_sid, event_type="platform"){{ route_ns.target_arg }})
{% endif %}
{{ indent }}    raise _ActionAbort
{% endif %}
{# ── The refusals a build-time value decides ── W3C SCXML 6.2: a type or a
   target the processor cannot use is one of the element's own arguments, so
   it is refused before the payload is read — one error, nothing delivered,
   the block ended — as the Interpreter refuses it before it reads a <param>.
   Refused after the payload, a failing <param> or <content expr> raised its
   own error first and the element cost two. #}
{% set static_target = action.target if (action.target and not action.targetexpr) else '' %}
{% set child_ns = namespace(named=false) %}
{% for invoke_info in model.invokes | scxml_family %}
{% if static_target == '#_' ~ invoke_info.invoke_id %}
{% set child_ns.named = true %}
{% endif %}
{% endfor %}
{% set names_no_invocation = static_target.startswith('#_') and static_target not in ['#_parent', '#_internal'] and not static_target.startswith('#_scxml_') and not child_ns.named %}
{% set static_refused = not action.send_type_host_served and (action.send_type_unsupported or action.target_unsupported or (is_http and not action.target and not action.targetexpr) or names_no_invocation) %}
{% if static_refused %}
{% if action.send_type_unsupported %}
{# W3C SCXML 6.2 (test199) — a processor the platform does not support. #}
{% if 'error.execution' in model.events %}
{{ indent }}engine.raise_internal({{ machine_name }}Event.{{ 'error.execution' | to_python_const }}, EventMetadata(send_id=_sid, event_type="platform"))
{% endif %}
{% elif action.target_unsupported %}
{# W3C SCXML 6.2.4 (test194) — a target this processor cannot address:
   `Action::target_unsupported`, decided once at build time. The sendid rides
   on the error so the matching transition's `<assign expr="_event.sendid">`
   reads it back (test332). #}
{% if 'error.execution' in model.events %}
{{ indent }}engine.raise_internal({{ machine_name }}Event.{{ 'error.execution' | to_python_const }}, EventMetadata(send_id=_sid, event_type="platform"))
{% endif %}
{% elif names_no_invocation %}
{# W3C SCXML C.1 + 6.4 — no invocation of this document is called
   `{{ static_target | slice_from(2) }}`, so the target reaches nobody. #}
{{ indent }}engine.raise_internal({{ machine_name }}Event.{{ 'error.communication' | to_python_const }}, EventMetadata(send_id=_sid, event_type="platform"))
{% else %}
{# W3C SCXML C.2.2 — "If neither the 'target' nor the 'targetexpr' attribute
   is specified, the SCXML Processor MUST add the event error.communication". #}
{% if 'error.communication' in model.events %}
{{ indent }}engine.raise_internal({{ machine_name }}Event.{{ 'error.communication' | to_python_const }}, EventMetadata(send_id=_sid, event_type="platform"))
{% endif %}
{% endif %}
{{ indent }}raise _ActionAbort  # W3C SCXML 4.9: the error ends the block
{% else %}
{# ── The payload ── W3C SCXML 5.10: evaluated once, by the helper every arm
   reads. #}
{% if action.params and (action.params | selectattr("native_value") | list | length > 0) %}
{# `datamodel="sce-static"`: each param's value is native code
   (`Param::native_value`) reading the policy's own attributes, so no script
   engine is asked for it. A checked operation that fails raises
   `AlgorithmFailure` out of the evaluation: it is reported, the pair is left out
   and the message still goes (§scxml-5.7.1), as the helper below does for a
   value the engine could not compute. The pairs are the helper's dict. #}
{{ indent }}_data = {}
{{ indent }}_data_repeats: dict = {}
{% for param in action.params %}
{{ indent }}try:
{{ indent }}    self._put_param(_data, _data_repeats, {{ param.name | py_string_literal }}, ({{ param.native_value }}).to_python())
{{ indent }}except sce_algorithm.AlgorithmFailure:
{{ indent }}    self._raise_error_execution(engine, "<send> <param name='" + {{ param.name | py_string_literal }} + "'> expr failed to evaluate")
{{ indent }}    _param_failures.append({{ param.name | py_string_literal }})
{% endfor %}
{% elif has_payload %}
{{ indent }}_data = self._eval_send_payload(engine, [
{%- for param in action.params -%}
({{ param.name | py_string_literal }}, {{ (param.expr if param.expr else param.location) | to_lua_expr | py_string_literal }}),
{%- endfor -%}
], {{ action.content | to_lua_data_content | py_string_literal }}, {{ action.contentexpr | to_lua_expr | py_string_literal }}, "", "<send>", {% if payload_can_fail %}_param_failures{% else %}None{% endif %}{% if has_namelist %}, namelist_values=_namelist_values{% endif %})
{% else %}
{{ indent }}_data = ""
{% endif %}
{# ── The event ── the name a remote end resolves, and the event this machine
   raises when it delivers locally. A name no transition of this document can
   match is delivered nowhere, as on every other generated backend. #}
{% if not dyn_event %}
{{ indent }}_evt_name = {{ action.event | py_string_literal }}
{% endif %}
{% if action.delayexpr %}
{% set delay_py = '_delay_ms' %}
{% else %}
{% set delay_py = action.delay_ms | string %}
{% endif %}
{# SCE_MESH.md §mesh-19: a `targetexpr` may name a Mesh peer only once it is
   evaluated, so the build could not lower it; the two `targetexpr` arms below
   choose the same act the lowering arranges for a literal `#peer`. #}
{% set dynamic_mesh = action.targetexpr and not action.typeexpr and not action.send_type_host_served and not action.send_type_unsupported and (not action.send_type or action.send_type == 'http://www.w3.org/TR/scxml/#SCXMLEventProcessor') %}
{# ── The delivery ── #}
{% if action.send_type_host_served %}
{# §scxml-6.2.5 — the `type` is served by the HOST, which declared it to this
   build. Dispatch rather than refuse, and take the whole send: a processor
   the host serves owns delivery, so falling through would also enqueue the
   event locally and the document would see the act twice. #}
{{ host_send_request(action, indent, action.send_type, has_payload, has_delay, delay_py, machine_name, model) }}
{% elif (is_http and action.targetexpr) or (not action.targetexpr and (action.target.startswith('http://') or action.target.startswith('https://'))) %}
{# W3C SCXML C.2 — a BasicHTTP send, to a statically-known absolute URL or to
   the one its `targetexpr` evaluated to (test509: the processor's own access
   URI). The BasicHTTP processor addresses the value, so it never reaches the
   SCXML processor's target table. The form is a rendering of the payload
   evaluated above. A delay postpones the POST, not the processor that makes
   it (W3C SCXML 6.2.4): the request waits in the queue every delayed send
   does, so `<cancel>` reaches it, and its deadline dispatches it. #}
{% if has_delay %}
{{ indent }}engine.schedule_http_send({% if action.targetexpr %}_target_str{% else %}{{ action.target | py_string_literal }}{% endif %}, _evt_name, {% if action.contentexpr and not (action.params or has_namelist or action.content) %}_ScriptValue.of(_data).to_wire_string(){% else %}{{ action.content | py_string_literal }}{% endif %}, self._wire_params_from_payload(_data), {{ delay_py }}, _sid)
{% else %}
{{ indent }}engine.perform_http_send({% if action.targetexpr %}_target_str{% else %}{{ action.target | py_string_literal }}{% endif %}, _evt_name, {% if action.contentexpr and not (action.params or has_namelist or action.content) %}_ScriptValue.of(_data).to_wire_string(){% else %}{{ action.content | py_string_literal }}{% endif %}, self._wire_params_from_payload(_data), _sid)
{% endif %}
{% elif not action.targetexpr and action.target == '#_parent' %}
{% if has_delay %}
{# W3C SCXML 6.2 + 6.4: delayed to the parent. It waits in this child's own
   scheduler, so `<cancel>` reaches it and a child that ends first drops it —
   the "if the sending session terminates first" clause — and it reaches the
   parent, payload included, when the delay has elapsed. #}
{{ indent }}engine.schedule_routed_send(None, {{ delay_py }}, _sid, _data, "parent", event_name=_evt_name)
{% else %}
{# W3C SCXML 6.2 (test233/234): the parent receives the same payload any other
   `<send>` would carry. W3C SCXML C.1: a session its host started, not an
   `<invoke>`, has no parent — error.communication, nothing delivered, and the
   error ends the block (4.9). #}
{{ indent }}if self._parent_queue is None:
{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.communication' | to_python_const }}, EventMetadata(data="<send target='#_parent'> has no parent session to reach", send_id=_sid, event_type="platform"))
{{ indent }}    raise _ActionAbort  # W3C SCXML 4.9: the error ends the block
{{ indent }}self._parent_queue.append((_evt_name, _data))
{% endif %}
{% elif not action.targetexpr and action.target == '#_internal' %}
{# W3C SCXML 6.2 (test189, test495): `<send target="#_internal">` enqueues onto
   this session's internal queue, carrying `_event.data` as an external send
   does. A delay postpones it and does not change the queue (W3C SCXML 6.2). #}
{% if has_delay %}
{% if dyn_event %}
{{ indent }}_evt = self.get_event_from_name(_evt_name)
{{ indent }}if _evt is not None:
{{ indent }}    engine.schedule_routed_send(_evt, {{ delay_py }}, _sid, _data, "internal")
{% else %}
{{ indent }}engine.schedule_routed_send({{ machine_name }}Event.{{ action.event | to_python_const }}, {{ delay_py }}, _sid, _data, "internal")
{% endif %}
{% elif dyn_event %}
{{ indent }}_evt = self.get_event_from_name(_evt_name)
{{ indent }}if _evt is not None:
{% if has_payload %}
{{ indent }}    engine.raise_internal(_evt, EventMetadata(data=_data))
{% else %}
{{ indent }}    engine.raise_internal(_evt)
{% endif %}
{% elif has_payload %}
{{ indent }}engine.raise_internal({{ machine_name }}Event.{{ action.event | to_python_const }}, EventMetadata(data=_data))
{% else %}
{{ indent }}engine.raise_internal({{ machine_name }}Event.{{ action.event | to_python_const }})
{% endif %}
{% elif static_target.startswith('#_scxml_') %}
{# W3C SCXML C.1 — `#_scxml_<sessionid>` names a session, and the only one
   this processor reaches by that name is its own; the bare prefix names it
   too (test 190). Any other is not reachable: error.communication, nothing
   delivered, the block ended (W3C SCXML 4.9). #}
{% if static_target != '#_scxml_' %}
{{ indent }}if self._session_id != {{ static_target | slice_from(8) | py_string_literal }}:
{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.communication' | to_python_const }}, EventMetadata(send_id=_sid, event_type="platform"))
{{ indent }}    raise _ActionAbort  # W3C SCXML 4.9: the error ends the block
{% endif %}
{% set self_call = ('engine.schedule_send', ', ' ~ delay_py ~ ', _sid, _data') if has_delay else ('engine.send_to_self', ', _sid, _data') %}
{% if dyn_event %}
{{ indent }}_evt = self.get_event_from_name(_evt_name)
{{ indent }}if _evt is not None:
{{ indent }}    {{ self_call[0] }}(_evt{{ self_call[1] }})
{% else %}
{{ indent }}{{ self_call[0] }}({{ machine_name }}Event.{{ action.event | to_python_const }}{{ self_call[1] }})
{% endif %}
{% elif static_target.startswith('#_') %}
{# W3C SCXML 6.4 — parent-to-child send. The active `Invoke` looks up the
   wire-format event name on the child policy's enum and pushes into the
   child's external queue, payload included. The build refused a target that
   names no invocation above; one that is not running is not there to reach
   (W3C SCXML C.1). #}
{{ indent }}_inv_target = engine._active_invokes.get({{ action.target | slice_from(2) | py_string_literal }})
{{ indent }}if _inv_target is not None and not _inv_target.is_done():
{% if has_delay %}
{# W3C SCXML 6.2: named now, reached when the delay has elapsed — or reported
   then, if the invocation has ended by that time (W3C SCXML C.1). #}
{{ indent }}    engine.schedule_routed_send(None, {{ delay_py }}, _sid, _data, "invocation", event_name=_evt_name, invoke_id={{ action.target | slice_from(2) | py_string_literal }})
{% else %}
{{ indent }}    _inv_target.forward_event(_evt_name, EventMetadata(event_type="external", data=_data))
{% endif %}
{{ indent }}else:
{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.communication' | to_python_const }}, EventMetadata(send_id=_sid, event_type="platform"))
{{ indent }}    raise _ActionAbort  # W3C SCXML 4.9: the error ends the block
{% elif action.targetexpr %}
