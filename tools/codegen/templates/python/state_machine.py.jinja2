def _coerce_event_data_str(data: Any) -> str:
    """W3C SCXML 5.10 — the script engine's `set_current_event` takes
    `event_data` as a single string (the Lua-side parser then tries
    `return <text>` → JSON-to-Lua → string fallback). Generated Python
    code marshals `<send>` payloads as a dict of named params or a
    bare scalar; we re-serialise them here so the script engine sees
    the same wire format every other backend produces.

    - dict / list → JSON encode (so `_event.data.foo` becomes a real
      Lua table member at the engine's parse stage);
    - str → returned unchanged (the script engine handles the
      `return <text>` round-trip natively);
    - int / float / bool → `str(value)` so a numeric payload still
      parses back to a Lua number;
    - None → `""` so the Lua side leaves `_event.data` unbound."""
    if data is None:
        return ""
    if isinstance(data, str):
        return data
    if isinstance(data, bool):
        return "true" if data else "false"
    if isinstance(data, (int, float)):
        return str(data)
    if isinstance(data, (dict, list)):
        import json
        try:
            return json.dumps(data)
        except (TypeError, ValueError):
            return str(data)
    return str(data)


def _parse_delay_text(text: str) -> int:
    """W3C SCXML 6.2 — convert a `delayexpr` string ("5s", "500ms", "0",
    bare-number) into milliseconds. Used by the policy's `_eval_delay_ms`
    helper; lifted to module scope so an empty / invalid string returns
    0 without needing a class instance.

    Recognised suffixes are `ms` and `s` (case-insensitive); a bare
    integer is interpreted as milliseconds, matching the most common
    fixture convention. Unparseable values map to 0 so a broken
    `delayexpr` never traps the engine (a corresponding error.execution
    would belong on the calling site)."""
    if not text:
        return 0
    s = text.strip().lower()
    if not s:
        return 0
    try:
        if s.endswith("ms"):
            return max(0, int(float(s[:-2])))
        if s.endswith("s"):
            return max(0, int(float(s[:-1]) * 1000))
        return max(0, int(float(s)))
    except (ValueError, TypeError):
        return 0


