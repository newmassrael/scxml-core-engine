def create_engine({% if has_native_actions %}actions: {{ native_actions_interface }}, {% endif %}script_engine=None, *, {% if accepts_simulated_host %}accept_simulated_host: bool = False, {% endif %}session_id: Optional[str] = None) -> Engine[{{ machine_name }}State, {{ machine_name }}Event]:
    """Construct a runnable engine bound to a fresh policy instance.

    Engine DI Parity RFC (Path B+): every Engine instance owns its script
    engine. `create_engine()` instantiates a default `LuaScriptEngine` when
    no engine is supplied; callers swap implementations (QuickJS, test
    stubs) by passing one explicitly.
{% if has_native_actions %}

    W3C SCXML G.7: `actions` is the host implementation of every
    `<sce:action>` this document declares. It leads the parameter list and
    has no default, because the initial state's `<onentry>` may already
    perform an act — a host arriving later would arrive one act too late.
{% endif %}
{% if accepts_simulated_host %}

    docs/adr/0038: `accept_simulated_host=True` states that the machine is built
    for a host that only simulates its duties (a recorder, a test double) on
    purpose. The statement covers the children the machine builds with a host.
{% endif %}

    docs/adr/0045: `session_id` is the id the host has for this session
    (`_sessionid`), in place of the one the engine draws: an XML Nmtoken, since
    another session addresses this one as `#_scxml_<id>` and every child's id is
    this one's and the id the child was started under. Refused with a
    `ValueError` for anything else, never replaced by another.
    """
    if session_id is not None:
        reason = _sce_session_id.refusal_of(session_id)
        if reason is not None:
            raise ValueError(reason)
{% if accepts_simulated_host %}
    policy = {{ machine_name }}Policy(actions, accept_simulated_host=accept_simulated_host)
{% elif has_native_actions %}
    policy = {{ machine_name }}Policy(actions)
{% else %}
    policy = {{ machine_name }}Policy()
{% endif %}
    if script_engine is None:
        script_engine = _LuaScriptEngine()
        script_engine.initialize()
    return Engine(policy, script_engine=script_engine, session_id=session_id)


