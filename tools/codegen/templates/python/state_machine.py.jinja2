def create_engine(script_engine=None) -> Engine[{{ machine_name }}State, {{ machine_name }}Event]:
    """Construct a runnable engine bound to a fresh policy instance.

    Engine DI Parity RFC (Path B+): every Engine instance owns its script
    engine. `create_engine()` instantiates a default `LuaScriptEngine` when
    no engine is supplied; callers swap implementations (QuickJS, test
    stubs) by passing one explicitly.
    """
    policy = {{ machine_name }}Policy()
    if script_engine is None:
        script_engine = _LuaScriptEngine()
        script_engine.initialize()
    return Engine(policy, script_engine=script_engine)


