{#
    Invoke Methods (Python Jinja2)

    W3C SCXML 6.4 — emits the four policy hooks the engine drives:
      - `defer_invokes_on_entry`: queue a PendingInvoke per `<invoke>`
        on the entered state.
      - `execute_pending_invokes`: drain the engine's `_pending_invokes`,
        instantiate each `<invoke>`'s child policy + engine, wrap in
        ScxmlInvoke, register in `engine._active_invokes`. Children
        that complete during their own `initialize()` raise
        `done.invoke.<id>` immediately (per W3C 6.4 the parent must
        observe the event in the same macrostep iteration).
      - `cancel_invokes_for_state`: cancel + drop active invokes
        owned by an exiting state; prune still-pending invokes that
        haven't started yet.
      - `forward_to_autoforward_children`: deliver external events
        into every active child whose `<invoke>` declared
        `autoforward="true"` (W3C 6.4.1).

    `<finalize>` blocks (W3C 6.5) are not yet emitted — the W3C tests
    in γ-4a's scope (test187 etc.) don't exercise finalize. Adding
    finalize is a follow-up because it touches the action emit macro
    AND needs a runtime hook for "finalize body runs in parent
    datamodel" semantics; the default no-op hook in StatePolicy keeps
    the contract sound until that lands.

    Port-of-Go template: tools/codegen/templates/go/invoke_methods.go.jinja2.
#}

{%- import '_macros/sce_annotation_marker.jinja2' as annot %}

    # ── Invokes (W3C SCXML 6.4) ───────────────────────────────────

    def defer_invokes_on_entry(self, state, engine) -> None:
{% for state_id, state in model.states | dictsort %}
{% set scxml_list = state.invokes | scxml_family | list %}
{% if scxml_list %}
        if state == {{ machine_name }}State.{{ state_id | to_python_const }}:
{% for inv in scxml_list %}
{{ annot.annotation_block(inv, "python", "            ") }}            # W3C SCXML 6.4.1: Generate the runtime invoke id with the
            # `<state_id>.<instance>.<element_id>` shape (test224 checks
            # the `stateid.` prefix; test338 compares an `idlocation`
            # binding against `_event.invokeid` on a child-raised event,
            # so both must share the same runtime id). Mirrors Rust's
            # `format!("{}.{}.{invoke_id}", state_id, self as *const _ as usize)`
            # in `tools/codegen/templates/rust/entry_exit_actions.rs.jinja2`.
            _runtime_invoke_id = f"{{ state_id }}.{id(self)}.{{ inv.invoke_id }}"
{% if inv.idlocation %}
            # W3C SCXML 6.4.1: Store the generated id in the datamodel
            # so author expressions (`<assign>` from `_event.invokeid`,
            # transition `cond="Var1==Var2"`) can match against it.
            engine._script_engine.set_variable(
                self._session_id,
                {{ inv.idlocation | py_string_literal }},
                _ScriptValue.of(_runtime_invoke_id),
            )
{% endif %}
            engine._pending_invokes.append(PendingInvoke(
                invoke_id=_runtime_invoke_id,
                owner_state_name={{ state_id | py_string_literal }},
            ))
{% endfor %}
{% endif %}
{% set unsup_list = state.invokes | unsupported | list %}
{% if unsup_list %}
        if state == {{ machine_name }}State.{{ state_id | to_python_const }}:
{% for inv in unsup_list %}
            # W3C SCXML 6.4.1: `type` names no processor this platform
            # implements. Defer only — the error.execution raise happens in
            # `execute_pending_invokes`, so §scxml-6.4 ordering holds and the
            # exit prune drops the entry when the state leaves first.
            engine._pending_invokes.append(PendingInvoke(
                invoke_id=f"{{ state_id }}.{id(self)}.{{ inv.invoke_id }}",
                owner_state_name={{ state_id | py_string_literal }},
            ))
{% endfor %}
{% endif %}
{% endfor %}
        return

    def execute_pending_invokes(self, engine) -> None:
{% set ns_any = namespace(any=false) %}
{% for state_id, state in model.states | dictsort %}
{% for inv in state.invokes | scxml_family %}
{% set ns_any.any = true %}
{% endfor %}
{% for inv in state.invokes | unsupported %}
{% set ns_any.any = true %}
{% endfor %}
{% endfor %}
{% if ns_any.any %}
        # W3C SCXML 6.4 — copy-and-clear so child instantiation cannot
        # observe its own pending entry in `_pending_invokes`.
        pending = list(engine._pending_invokes)
        engine._pending_invokes.clear()
        for entry in pending:
{% for state_id, state in model.states | dictsort %}
{% for inv in state.invokes | scxml_family %}
            # W3C SCXML 6.4.1: Match by `.<element_id>` suffix because
            # `defer_invokes_on_entry` decorates the static id with the
            # owning-state + instance prefix (Rust `contains(".{id}")` parity).
            if entry.invoke_id.endswith({{ ('.' + inv.invoke_id) | py_string_literal }}):
{% if inv.namelist %}
                # W3C SCXML 6.4.1: Validate namelist variables in PARENT
                # before instantiating the child. Missing names raise
                # error.execution and skip the invoke entirely
                # (mirrors `tools/codegen/templates/rust/invoke_methods.rs.jinja2`
                # namelist-validation block).
                _namelist_ok = True
{% for vname in inv.namelist | split %}
                if not engine._script_engine.has_variable(
                    self._session_id, {{ vname | py_string_literal }}
                ):
                    self._raise_error_execution(
                        engine,
                        "<invoke> namelist names '{{ vname }}', which the parent does not declare",
                    )
                    _namelist_ok = False
{% endfor %}
                if not _namelist_ok:
                    continue
{% endif %}
                import {{ inv.child_name }}_sm as _child_module_{{ inv.invoke_id | to_python_const }}
                _child_policy = _child_module_{{ inv.invoke_id | to_python_const }}.Policy()
                # Engine DI Parity RFC (Path B+): forward the parent's
                # script engine so the child shares the same Lua VM /
                # session manager, mirroring Rust + Kotlin invoke parity.
                _child_engine = Engine(_child_policy, script_engine=engine._script_engine)
{% if inv.namelist or inv.params %}
                # W3C SCXML 6.4.1: Stage namelist + `<param>` values for
                # the child's datamodel. The dict is applied by the
                # child's `initialize_datamodel` as a final overlay so
                # any `<data>` default for the same id is overwritten —
                # matches the Rust child policy's
                # `set_param_in_script_engine` semantics
                # (parent-eval → child-side `set_variable`).
                _pre_init: Dict[str, _ScriptValue] = {}
{% if inv.namelist %}
{% if inv.child_datamodel_vars is defined %}
                # W3C SCXML 6.3.2: Only seed names that the child
                # actually declares in its `<datamodel>`.
                _child_vars = { {% for cv in inv.child_datamodel_vars %}{{ cv | py_string_literal }}{{ ", " if not loop.last }}{% endfor %} }
{% for vname in inv.namelist | split %}
                if {{ vname | py_string_literal }} in _child_vars:
                    try:
                        _pre_init[{{ vname | py_string_literal }}] = (
                            engine._script_engine.evaluate_expression(
                                self._session_id, {{ vname | py_string_literal }}
                            )
                        )
                    except _ScriptError:
                        pass
{% endfor %}
{% else %}
{% for vname in inv.namelist | split %}
                try:
                    _pre_init[{{ vname | py_string_literal }}] = (
                        engine._script_engine.evaluate_expression(
                            self._session_id, {{ vname | py_string_literal }}
                        )
                    )
                except _ScriptError:
                    pass
{% endfor %}
{% endif %}
{% endif %}
{% if inv.params %}
{% for param in inv.params %}
{% if inv.child_datamodel_vars is defined and param.name in inv.child_datamodel_vars %}
                try:
                    _pre_init[{{ param.name | py_string_literal }}] = (
                        engine._script_engine.evaluate_expression(
                            self._session_id,
                            {{ param.expr | to_lua_expr | py_string_literal }},
                        )
                    )
                except _ScriptError:
                    # §scxml-5.7.1: BOTH halves — `error.execution` on the
                    # internal queue AND the name and value ignored. Only the
                    # silent half was here (`pass`), so a document that
                    # miscomputed one `<param>` got a child with a `<data>`
                    # nothing explained and no event to act on.
                    #
                    # The clause delegates only the SUCCESSFUL name and value to
                    # the context — "Otherwise the use of the name and value
                    # depends on the context in which the <param> element occurs.
                    # See 5.5 <donedata>, 6.2 <send> and 6.4 <invoke>" — so
                    # §scxml-6.4.2's "terminate the processing of the element" is
                    # not what a failing `<param>` costs: the child still starts,
                    # one pair short, and no `_ActionAbort` is raised here.
                    self._raise_error_execution(
                        engine,
                        {{ ("<invoke> <param name='" ~ param.name ~ "'> expr failed to evaluate") | py_string_literal }},
                    )
{% else %}
                # §scxml-6.4.3: {{ param.name }} matches no top-level `<data>`
                # of the child, so the Processor MUST NOT add it to the
                # invoked session's data model. The namelist arm above
                # already read the child's declarations for the same reason;
                # this arm did not, and a param that named nothing there
                # became a variable in the child anyway.
{% endif %}
{% endfor %}
{% endif %}
                _child_policy._pre_init_vars = _pre_init
{% endif %}
                _invoke = ScxmlInvoke(_child_engine, _child_policy._parent_queue)
                _invoke.start(engine)
                # W3C SCXML 6.4: key `_active_invokes` by the static
                # element id so `<send target="#_<id>">` (explicit id
                # path, test228) resolves regardless of which spawn
                # raised the event. The runtime id only feeds
                # `_event.invokeid` (`_invoke_id_field` below) for the
                # idlocation case (test338).
                engine._active_invokes[{{ inv.invoke_id | py_string_literal }}] = _invoke
{% if inv.idlocation %}
                _invoke_id_field = entry.invoke_id
{% else %}
                _invoke_id_field = {{ inv.invoke_id | py_string_literal }}
{% endif %}
                # Drain any `<send target="#_parent">` raised during the
                # child's initialise onto the parent's external queue
                # BEFORE the done.invoke notification: W3C SCXML 6.3.1
                # transition actions (e.g. `<send target="#_parent"
                # event="varBound"/>`) raise their event on the way to
                # `<final>`, which is what triggers `done.invoke.<id>`
                # — the parent's queue must see them in that order so
                # an `event="varBound"` transition wins over the generic
                # `event="*"` fallback (test226). Mirrors the Rust
                # template's drain-then-raise sequence in
                # `tools/codegen/templates/rust/invoke_methods.rs.jinja2`.
                for _name, _data in _invoke.drain_events():
                    engine.send_external_by_name(
                        _name,
                        data=_data,
                        invoke_id=_invoke_id_field,
                        origin=_invoke.origin(),
                        origin_type="http://www.w3.org/TR/scxml/#SCXMLEventProcessor",
                    )
                # W3C SCXML 6.4 — children that reach final during their
                # own initialise produce `done.invoke.<id>` last, after
                # any `<send target=#_parent>` raised on the way there.
                if _invoke.is_done():
                    engine.send_external_by_name(
                        create_done_invoke_event_name(_invoke_id_field),
                        data=_invoke.done_data() or "",
                        invoke_id=_invoke_id_field,
                    )
                    # W3C SCXML 6.4 — mark the persistent flag so
                    # `_drive_active_children` does not re-raise the
                    # same `done.invoke.<id>` on the next macrostep
                    # tick. The map is keyed by the same id used in
                    # `_active_invokes` (static element id).
                    engine._done_invoke_emitted[{{ inv.invoke_id | py_string_literal }}] = True
                continue
{% endfor %}
{% for inv in state.invokes | unsupported_refused %}
            if entry.invoke_id.endswith({{ ('.' + inv.invoke_id) | py_string_literal }}):
                # W3C SCXML 6.4.1: unsupported `type` — place error.execution
                # on the internal queue and start nothing.
                self._raise_error_execution(
                    engine,
                    {{ ("<invoke type='" ~ inv.invoke_type ~ "'> names an external service this platform does not support") | py_string_literal }},
                )
                continue
{% endfor %}
{% for inv in state.invokes | host_invoker %}
            if entry.invoke_id.endswith({{ ('.' + inv.invoke_id) | py_string_literal }}):
                # W3C SCXML 6.4.1: the host declared this `type`, so START the
                # invocation rather than refusing it. The id handed over is the
                # DOCUMENT's, not the per-instance one the pending queue
                # carries: `done.invoke.<id>` is the name the author wrote a
                # transition for, so it is the name the host must answer on.
                if not engine.perform_host_invoke(_HostInvokeRequest(
                    processor_type={{ inv.invoke_type | py_string_literal }},
                    invoke_id={{ inv.invoke_id | py_string_literal }},
                    src={{ inv.src | default('', true) | py_string_literal }},
                    params={
{% for param in inv.params %}
{% if param.is_static_literal %}
                        {{ param.name | py_string_literal }}: [{{ param.static_value | py_string_literal }}],
{% endif %}
{% endfor %}
                    },
                    content={{ inv.content | default('', true) | py_string_literal }},
                )):
                    # W3C SCXML 6.4.1: declared but no invoker registered. The
                    # document asked for a process to be run and none was,
                    # which is the same fact as an unsupported type — so the
                    # same event, rather than a silence that reads as started.
                    self._raise_error_execution(
                        engine,
                        "<invoke> names an invoker the host declared but never registered",
                    )
                continue
{% endfor %}
{% endfor %}
{% endif %}
        return

    def cancel_invokes_for_state(self, state, engine) -> None:
{% for state_id, state in model.states | dictsort %}
{% set unsup_list = state.invokes | unsupported | list %}
{% if unsup_list %}
        if state == {{ machine_name }}State.{{ state_id | to_python_const }}:
{% for inv in unsup_list %}
            # §scxml-6.4.1: an unsupported-type entry that never ran must
            # raise nothing, so drop it from the pending queue on exit.
            _suffix = {{ ('.' + inv.invoke_id) | py_string_literal }}
            engine._pending_invokes = [
                p for p in engine._pending_invokes
                if not p.invoke_id.endswith(_suffix)
            ]
{% endfor %}
{% endif %}
{% set host_list = state.invokes | host_invoker | list %}
{% if host_list %}
        if state == {{ machine_name }}State.{{ state_id | to_python_const }}:
{% for inv in host_list %}
            # W3C SCXML 6.4: the host's invocation ends with the state that
            # started it. Unconditional here: the engine knows whether this
            # one ever started and stays silent when it did not, so the
            # emitted chain needs no bookkeeping of its own.
            engine.cancel_host_invoke(
                {{ inv.invoke_type | py_string_literal }},
                {{ inv.invoke_id | py_string_literal }},
            )
{% endfor %}
{% endif %}
{% set scxml_list = state.invokes | scxml_family | list %}
{% if scxml_list %}
        if state == {{ machine_name }}State.{{ state_id | to_python_const }}:
{% for inv in scxml_list %}
            # W3C SCXML 6.4.2: `_active_invokes` is keyed by the static
            # element id; `_pending_invokes` carries the runtime
            # `<state>.<instance>.<id>` id (defer_invokes_on_entry),
            # so the pending prune matches by suffix.
            _inv = engine._active_invokes.pop({{ inv.invoke_id | py_string_literal }}, None)
            if _inv is not None:
                _inv.cancel()
            engine._done_invoke_emitted.pop({{ inv.invoke_id | py_string_literal }}, None)
            _suffix = {{ ('.' + inv.invoke_id) | py_string_literal }}
            engine._pending_invokes = [
                p for p in engine._pending_invokes
                if not p.invoke_id.endswith(_suffix)
            ]
{% endfor %}
{% endif %}
{% endfor %}
        return

    def forward_to_autoforward_children(self, event_name: str, metadata, engine) -> None:
        """W3C SCXML 6.4.1 — forward an external event into every active
        ``autoforward`` child.

        The event's name is not consulted. Appendix D ``mainEventLoop``
        forwards whatever it dequeued from the external queue, and 6.4.2 has
        ``done.invoke.<id>`` returned onto that queue, so a sibling invoke
        still running must see it. Internal-queue events — ``error.*``
        (3.12.2) and ``done.state.<id>`` (3.7) — stay out of the forwarded
        set because this method is reached only from the external drain, not
        because of how they are spelled.
        """
{% if ns_any.any %}
{% for state_id, state in model.states | dictsort %}
{% for inv in state.invokes | scxml_family %}
{% if inv.autoforward %}
        _inv = engine._active_invokes.get({{ inv.invoke_id | py_string_literal }})
        if _inv is not None and not _inv.is_done():
            _inv.forward_event(event_name, metadata)
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
        return

{% set ns_fin = namespace(any=false) %}
{% for state_id, state in model.states | dictsort %}
{% for inv in state.invokes | scxml_family %}
{% if inv.finalize_content %}
{% set ns_fin.any = true %}
{% endif %}
{% endfor %}
{% endfor %}
{% if ns_fin.any %}
    def execute_finalize_for_child_event(self, event_with_meta, engine) -> None:
        # W3C SCXML 6.5: `<finalize>` runs in the parent's datamodel
        # before transition selection for events originating from the
        # invoked child, so the finalize body can write child-derived
        # values back into the parent (`<assign location="Var1"
        # expr="_event.data.aParam"/>`). The finalize body was
        # rewritten to JavaScript at parse time
        # (`sce-build/src/parser.rs` `actions_to_javascript`) and is
        # threaded through the ECMAScript→Lua transformer here, the
        # same way Rust / C++ / Go / Kotlin / C11 backends do.
        _ivk = event_with_meta.metadata.invoke_id
        if not _ivk:
            return
{% for state_id, state in model.states | dictsort %}
{% for inv in state.invokes | scxml_family %}
{% if inv.finalize_content %}
        if _ivk == {{ inv.invoke_id | py_string_literal }} or _ivk.endswith({{ ('.' + inv.invoke_id) | py_string_literal }}):
            try:
                engine._script_engine.execute_script(
                    self._session_id,
                    {{ inv.finalize_content | to_lua_script | py_string_literal }},
                )
            except _ScriptError:
                self._raise_error_execution(
                    engine, "<finalize> failed to execute"
                )
            return
{% endif %}
{% endfor %}
{% endfor %}
        return
{% endif %}
