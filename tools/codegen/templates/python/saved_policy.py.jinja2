{% else %}

    def judge_child(self, child) -> None:
        """Refuse a running child, which this document does not start."""
        raise sce_saved_state.StateRefusal(f"the document starts no child session, so '{child.id}' cannot be one it was running")

    def resume_children(self, engine, children, wall_now_ms: int) -> None:
        """Resume no child, which this document does not start."""
        if children:
            self.judge_child(children[0])
{% endif %}

