{#
    Transition Selection Template (Go Jinja2)

    What the generated policy knows and the engine does not: which of a
    state's transitions an event enables, and what each transition's content
    is. Everything else Appendix D does with a transition — the walk from each
    atomic state up through its ancestors, the ordered set, conflict removal,
    the exit set, the entry set — is written once, in the runtime's
    microstep.go, over the structure state_machine.go.jinja2 emits.

    It used to be written here as well, in two shapes: machines with a
    `<parallel>` collected, resolved and ran their own microstep here, while
    every other machine moved `currentState` here and let the engine walk an
    LCA. The two disagreed about eventless selection (one never looked above
    the atomic state, the other looked at every active state without
    walking), about the order transition content runs in, and about how many
    targets a transition has — both kept only the first.

    Generates:
    - BindCurrentEvent(event, engine)                 §scxml-5.10 `_event` for the guards
    - FirstEnabledTransition(state, event, engine)    the per-state half of selection
    - ExecuteTransitionContent(source, index, engine)

    The Go twin of rust/process_transition.rs.jinja2.
#}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}

{# The guard a transition is taken under, in the one form this machine can
   evaluate it: a pure In() predicate, a natively lowered typed-payload
   comparison (NL→IR Item C1 Path A, no script engine), the script engine, or
   a value decided at build time (W3C SCXML 5.9). #}
{% macro guard_expr(trans) -%}
{%- if trans.is_pure_in_predicate -%}{{ trans.cond_cpp | to_in_predicate_go }}
{%- elif trans.native_payload_guard -%}{{ trans.native_payload_guard }}
{%- elif model.needs_script_engine -%}p.evaluateGuard(`{{ trans.cond | to_lua_guard }}`, engine)
{%- else -%}{{ 'true' if trans.cond_constant else 'false' }}
{%- endif -%}
{%- endmacro %}

{# Whether `trans` answers `event`: an eventless transition only an eventless
   selection, a transition with an event descriptor only a named event —
   §scxml-3.13 selects the two kinds in separate passes, and W3C SCXML 5.9.3
   matches a descriptor by direct enum comparison, a precomputed prefix set, or
   at run time. #}
{% macro event_match(trans) -%}
{%- if not trans.event -%}event == {{ machine_name }}EventNull
{%- elif trans.needs_string_matching -%}event != {{ machine_name }}EventNull && sce.MatchesEventDescriptor(p.GetEventName(event), "{{ trans.event }}")
{%- elif trans.matching_enum_values | length > 0 -%}{% for ev in trans.matching_enum_values %}event == {{ machine_name }}Event{{ ev | to_event_variant }}{{ " || " if not loop.last }}{% endfor %}
{%- else -%}false
{%- endif -%}
{%- endmacro %}

// BindCurrentEvent binds the event whose transitions are about to be selected as
// the _event their guards read (W3C SCXML 5.10) — before the first guard runs,
// and not for an eventless selection, which has no event of its own.
{# SCE Protocol-Synthesis RFC §synth-5-O — function-scope SCE-MAP markers
   above each Go transition function. #}
{{ sce_map.source_marker(model.source_location, "go", symbol_artifact=sce_artifact.machine) }}
func (p *{{ machine_name }}Policy) BindCurrentEvent(event {{ machine_name }}Event, engine *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event]) {
{% if model.needs_script_engine %}
	if event != {{ machine_name }}EventNull {
		// §scxml-B-2-8-1: the rung the payload got, handed to the engine
		// rather than dropped. This is the only frame that has both the
		// reading and the event it belongs to.
		engine.NotePayloadReading(event, p.setCurrentEvent(p.GetEventName(event)))
	}
{% else %}
	// This document's guards never read _event, so there is nothing to bind.
{% endif %}
}

// FirstEnabledTransition is Appendix D selectTransitions, the half only this
// document can answer: the first of state's own transitions, in document order,
// that event enables and whose guard holds. The engine walks the atomic states
// and their ancestors and keeps the ordered set; the null event asks for
// eventless transitions.
{{ sce_map.source_marker(model.source_location, "go", symbol_artifact=sce_artifact.machine) }}
func (p *{{ machine_name }}Policy) FirstEnabledTransition(state {{ machine_name }}State, event {{ machine_name }}Event, engine *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event]) (sce.EnabledTransition[{{ machine_name }}State, sce.HistoryID], bool) {
	switch state {
{% for state_id, state in model.states | dictsort %}
{% if state.transitions %}
	case {{ machine_name }}State{{ state_id | to_state_variant }}:
{% for trans in state.transitions %}
		if {{ event_match(trans) }} {
{% if trans.cond %}
{% if trans.native_payload_guard and not trans.is_pure_in_predicate %}
			// NL→IR Item C1 Path A: native typed `_event.data` guard — cond
			// "{{ trans.cond }}" lowered to a tag-checked field comparison on
			// the lifted `pending<Event>Payload` (no script engine).
{% elif not trans.is_pure_in_predicate and not model.needs_script_engine %}
			// W3C SCXML 5.9: cond="{{ trans.cond }}" decided at build time
{% endif %}
			if {{ guard_expr(trans) }} {
{% else %}
			{
{% endif %}
				return sce.EnabledTransition[{{ machine_name }}State, sce.HistoryID]{
					Source:          state,
{% if trans.targets %}
					Targets:         transitionTargetsOf{{ machine_name }}[state][{{ trans.transition_index }}],
{% endif %}
					TransitionIndex: {{ trans.transition_index }},
					HasActions:      {{ 'true' if trans.actions else 'false' }},
					IsInternal:      {{ 'true' if trans.type == 'internal' else 'false' }},
				}, true
			}
		}
{% endfor %}
{% endif %}
{% endfor %}
	}
	return sce.EnabledTransition[{{ machine_name }}State, sce.HistoryID]{}, false
}

// ExecuteTransitionContent runs one transition's executable content (W3C SCXML
// 3.13), between the microstep's exits and its entries.
{{ sce_map.source_marker(model.source_location, "go", symbol_artifact=sce_artifact.machine) }}
func (p *{{ machine_name }}Policy) ExecuteTransitionContent(source {{ machine_name }}State, transitionIndex int, engine *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event]) {
{% if model.has_transition_actions %}
{% if model.needs_script_engine %}
	p.ensureScriptEngine()
{% endif %}
	switch source {
{% for state_id, state in model.states | dictsort %}
{% if state.transitions | selectattr("actions") | list %}
	case {{ machine_name }}State{{ state_id | to_state_variant }}:
		switch transitionIndex {
{% for trans in state.transitions %}
{% if trans.actions %}
		case {{ trans.transition_index }}: {{- annot.annotation_comment(trans, "go", "			") }}
{% if trans.source_location %}
			{{ sce_map.source_marker(trans.source_location, "go", stmt_level=true, symbol_state=trans.symbol_state_path, symbol_artifact=trans.symbol_artifact) | trim }}
{% endif %}
{% for action in trans.actions %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "go", "			") -}}
{%- endif %}
			{% include 'actions/' ~ action.type ~ '.go.jinja2' %}

{% endfor %}
{% endif %}
{% endfor %}
		}
{% endif %}
{% endfor %}
	}
{% else %}
	// W3C SCXML 3.13: no transition in this document has content.
{% endif %}
}
