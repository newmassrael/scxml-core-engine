// ExecuteTransitionActions executes actions for the last taken transition (W3C SCXML 3.13).
{{ sce_map.source_marker(model.source_location, "go") }}
func (p *{{ machine_name }}Policy) ExecuteTransitionActions(engine *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event]) {
{% if model.has_transition_actions %}
{% if model.needs_script_engine %}
	p.ensureScriptEngine()
{% endif %}
	if !p.hasTransitionActions {
		return
	}
	source := p.lastTransitionSourceState
	idx := p.lastTransitionIndex
{% for state_id, state in model.states | dictsort %}
{% for trans in state.transitions %}
{% if trans.actions %}
	if source == {{ machine_name }}State{{ state_id | to_state_variant }} && idx == {{ trans.transition_index | default(loop.index0) }} {  {{- annot.annotation_comment(trans, "go", "		") }}
{% for action in trans.actions %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "go", "		") -}}
{%- endif %}
		{% include 'actions/' ~ action.type ~ '.go.jinja2' %}

{% endfor %}
		return
	}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
}
