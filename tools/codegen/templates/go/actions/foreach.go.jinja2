{# W3C SCXML 4.6: Foreach loop (1:1 with Rust foreach template) #}
{% if model.needs_script_engine %}
	// W3C SCXML 4.6: foreach over {{ action.array }}
	{
		{# W3C SCXML 4.6: `item` is a location expression, lowered by the
		   same frontend every other write target goes through. A legal
		   identifier lowers to itself; anything else fails the guard. #}
		foreachItemName := "{{ action.item | default("") | to_lua_location | escape_go }}"
		if foreachItemName == "" || !sce.IsValidIdentifier(foreachItemName) {
{% if 'error.execution' in model.events %}
			engine.Raise(sce.NewPlatformEvent({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}))
{% endif %}
		} else {
			foreachArrVal, foreachErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.array | to_lua_expr }}`)
			if foreachErr != nil {
{% if 'error.execution' in model.events %}
				engine.Raise(sce.NewPlatformEvent({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}))
{% endif %}
			} else if foreachArr, foreachOk := sce.ToSlice(foreachArrVal); foreachOk {
				foreachSuccess := true
				for foreachIdx, foreachItem := range foreachArr {
					_ = foreachIdx
					if err := p.ScriptEngine.SetVariable(p.SessionID, foreachItemName, foreachItem); err != nil {
						foreachSuccess = false
						break
					}
{% if action.index %}
					{# W3C SCXML B.2: iteration over an array runs from 0 to
					   length-1, so the index starts at 0. `foreachIdx` is
					   already zero-based; the `+1` that used to be here made
					   the Go backend the only one that answered 1 for the
					   first item — Rust, Kotlin, Python and C11 all emit the
					   raw index. W3C test 459 asserts the final index is 2
					   over a three-element array, and it passed only because
					   the `cond` reading the index could not be evaluated. #}
					if err := p.ScriptEngine.SetVariable(p.SessionID, "{{ action.index | to_lua_location | escape_go }}", int64(foreachIdx)); err != nil {
						foreachSuccess = false
						break
					}
{% endif %}
{% for body_action in action.actions %}
					{% with action=body_action %}{% include 'actions/' ~ body_action.type ~ '.go.jinja2' %}{% endwith %}

{% endfor %}
				}
				if !foreachSuccess {
{% if 'error.execution' in model.events %}
					engine.Raise(sce.NewPlatformEvent({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}))
{% endif %}
				}
			} else {
				// Not an array — raise error.execution (W3C SCXML 5.6)
{% if 'error.execution' in model.events %}
				engine.Raise(sce.NewPlatformEvent({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}))
{% endif %}
			}
		}
	}
{% endif %}
