{# W3C SCXML 4.6: Foreach loop (1:1 with Rust foreach template) #}
{% if model.needs_script_engine %}
	// W3C SCXML 4.6: foreach over {{ action.array }}
	{
		foreachItemName := "{{ action.item | default("") }}"
		if foreachItemName == "" || !sce.IsValidIdentifier(foreachItemName) {
{% if 'error.execution' in model.events %}
			engine.Raise(sce.NewPlatformEvent({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}))
{% endif %}
		} else {
			foreachArrVal, foreachErr := sce.GetScriptEngine().EvaluateExpression(p.SessionID, `{{ action.array | to_lua_expr }}`)
			if foreachErr != nil {
{% if 'error.execution' in model.events %}
				engine.Raise(sce.NewPlatformEvent({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}))
{% endif %}
			} else if foreachArr, foreachOk := sce.ToSlice(foreachArrVal); foreachOk {
				foreachSuccess := true
				for foreachIdx, foreachItem := range foreachArr {
					_ = foreachIdx
					if err := sce.GetScriptEngine().SetVariable(p.SessionID, foreachItemName, foreachItem); err != nil {
						foreachSuccess = false
						break
					}
{% if action.index %}
					if err := sce.GetScriptEngine().SetVariable(p.SessionID, "{{ action.index }}", int64(foreachIdx+1)); err != nil {
						foreachSuccess = false
						break
					}
{% endif %}
{% for body_action in action.actions %}
					{% with action=body_action %}{% include 'actions/' ~ body_action.type ~ '.go.jinja2' %}{% endwith %}

{% endfor %}
				}
				if !foreachSuccess {
{% if 'error.execution' in model.events %}
					engine.Raise(sce.NewPlatformEvent({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}))
{% endif %}
				}
			} else {
				// Not an array — raise error.execution (W3C SCXML 5.6)
{% if 'error.execution' in model.events %}
				engine.Raise(sce.NewPlatformEvent({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}))
{% endif %}
			}
		}
	}
{% endif %}
