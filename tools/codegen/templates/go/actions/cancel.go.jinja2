{# W3C SCXML 6.3: Cancel delayed send event #}
{% if action.sendid %}
	engine.CancelEvent("{{ action.sendid | escape_go }}")
{% elif action.sendidexpr and model.needs_script_engine %}
	{
		cancelSendIDVal, cancelErr := sce.GetScriptEngine().EvaluateExpression(p.SessionID, `{{ action.sendidexpr | to_lua_expr }}`)
		if cancelErr == nil && cancelSendIDVal != nil {
			engine.CancelEvent(fmt.Sprintf("%v", cancelSendIDVal))
		}
	}
{% endif %}
