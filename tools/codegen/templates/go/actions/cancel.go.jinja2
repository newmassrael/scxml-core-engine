{# W3C SCXML 6.3: Cancel delayed send event.
   <cancel> MUST carry either sendid or sendidexpr (W3C §6.3); both-empty
   is rejected at parse time by the SCXML parser (parser.rs cancel branch,
   wire `validation/require-either`). No `{% else %}` arm — parser
   guarantees one branch matches. #}
{% if action.sendid %}
	engine.CancelEvent("{{ action.sendid | escape_go }}")
{% elif action.sendidexpr and model.needs_script_engine %}
	{
		cancelSendIDVal, cancelErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.sendidexpr | to_lua_expr }}`)
		if cancelErr != nil {
			// W3C SCXML 5.9: a sendidexpr that fails raises error.execution,
			// and (W3C SCXML 4.9) the error ends the block.
{% if 'error.execution' in model.events %}
			engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<cancel> sendidexpr failed to evaluate"))
{% endif %}
{% if in_action_block is defined and in_action_block %}
			return
{% endif %}
		} else if cancelSendIDVal != nil {
			engine.CancelEvent(fmt.Sprintf("%v", cancelSendIDVal))
		}
	}
{% endif %}
