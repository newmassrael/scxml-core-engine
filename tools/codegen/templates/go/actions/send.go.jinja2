{# W3C SCXML 6.2: Send event (internal, external, delayed, HTTP) #}
{% set send_id = action.id if action.id else action.auto_send_id %}
{% if send_id %}
	// W3C SCXML 6.2: send id="{{ send_id }}"
{% endif %}
{% if action.idlocation and model.needs_script_engine %}
	{
		sendIDStr := "{{ send_id | escape_go }}"
		p.assignVariable(`{{ action.idlocation | to_lua_location }}`, `"` + sendIDStr + `"`)
{% endif %}
{# ── Build event data from <param>, namelist, or <content> ── #}
{% set has_params = action.params and action.params | length > 0 %}
{% set has_namelist = action.namelist and action.namelist | trim %}
{% if has_params %}
{% set has_dynamic_params = action.params | rejectattr("is_static_literal") | list | length > 0 %}
{% else %}
{% set has_dynamic_params = false %}
{% endif %}
{% if has_dynamic_params or has_namelist %}
	// W3C SCXML 6.2: Evaluate <param>/namelist expressions at send time
	{
{% if has_namelist %}
		sendAborted := false
{% endif %}
		p.ensureScriptEngine()
		se := p.ScriptEngine
		// W3C SCXML 6.2 / test178: a name may repeat and every value must be
		// delivered, so this is an ordered list rather than a map. The typed
		// value is kept rather than its text — a receiver reading
		// `_event.data.value === 42` finds the string "42" unequal.
		parts := make([]sce.EventDataParam, 0)
{% if has_params %}
{% for param in action.params %}
{% if param.is_static_literal %}
		parts = append(parts, sce.EventDataParam{Name: "{{ param.name | escape_go }}", Value: "{{ param.static_value | escape_go }}"})
{% elif param.expr %}
		if paramVal, paramErr := se.EvaluateExpression(p.SessionID, `{{ param.expr | to_lua_expr }}`); paramErr == nil {
			parts = append(parts, sce.EventDataParam{Name: "{{ param.name | escape_go }}", Value: paramVal})
		} else {
{% if 'error.execution' in model.events %}
			engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> <param name='{{ param.name | escape_go }}'> expr failed to evaluate"))
{% endif %}
		}
{% elif param.location %}
		if paramVal, paramErr := se.EvaluateExpression(p.SessionID, `{{ param.location }}`); paramErr == nil {
			parts = append(parts, sce.EventDataParam{Name: "{{ param.name | escape_go }}", Value: paramVal})
		} else {
{% if 'error.execution' in model.events %}
			engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> <param name='{{ param.name | escape_go }}'> location could not be read"))
{% endif %}
		}
{% endif %}
{% endfor %}
{% endif %}
{% if has_namelist %}
{% for name in action.namelist | split %}
		// W3C SCXML B.2: Check variable existence before evaluation
		if !se.HasVariable(p.SessionID, "{{ name }}") {
{% if 'error.execution' in model.events %}
			engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> namelist names '{{ name }}', which is not declared"))
{% endif %}
			sendAborted = true
		} else if nlVal, nlErr := se.EvaluateExpression(p.SessionID, `{{ name }}`); nlErr == nil {
			parts = append(parts, sce.EventDataParam{Name: "{{ name }}", Value: nlVal})
		} else {
{% if 'error.execution' in model.events %}
			engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> namelist entry '{{ name }}' failed to evaluate"))
{% endif %}
			sendAborted = true
		}
{% endfor %}
{% endif %}
{% if has_namelist %}
		eventDataStr := ""
		if !sendAborted {
			eventDataStr = sce.BuildJSONFromTypedParams(parts)
		}
{% else %}
		eventDataStr := sce.BuildJSONFromTypedParams(parts)
{% endif %}
		_ = eventDataStr
{% elif has_params %}
	{
		// W3C SCXML 6.2 + B-2-9: every value is a literal, so the payload is
		// finished at codegen time. It has to be — this arm is what a machine
		// with no script engine emits, and the wire it used to write (a
		// `_scxml_params(...)` call in Lua) could only be read back by an
		// interpreter.
		//
		// The author name/value cross two literal boundaries, the JSON text
		// the filter assembles and the Go string literal carrying it, so each
		// is escaped once per boundary.
		eventDataStr := "{{ action.params | static_params_json | escape_go }}"
		_ = eventDataStr
{% elif action.content %}
	{
		// W3C SCXML B.2: inline text takes the ordered readings, decided by
		// the same filter inline `<data>` and `<donedata>` text goes
		// through — see `rust/actions/send.rs.jinja2` for what reading it
		// at run time instead did.
{% if action.content | data_content_is_xml %}
		// XML travels as the document text: §scxml-B-2-8-1 has the RECEIVER
		// build the DOM (W3C test561).
		eventDataStr := "{{ action.content | escape_go }}"
{% elif model.needs_script_engine %}
		// The reading was decided at codegen time; the VALUE is produced
		// here, at send time, and serialized so the far end parses.
		p.ensureScriptEngine()
		eventDataStr := ""
		if contentVal, contentErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.content | to_lua_data_content }}`); contentErr == nil {
			eventDataStr = sce.ScriptValueToJSON(contentVal)
		}
{% else %}
		// No data model, so the text is the value — §scxml-B-2-8-1's last
		// rung, taken at codegen time.
		eventDataStr := "\"{{ action.content | normalize_ws | escape_json_string | escape_go }}\""
{% endif %}
		_ = eventDataStr
{% else %}
	{
		eventDataStr := ""
		_ = eventDataStr
{% endif %}
{% if has_namelist %}
		if !sendAborted {
{% endif %}
{# ── Unsupported send type check ── #}
{% if action.send_type_unsupported %}
	// W3C SCXML 6.2: Unsupported send type "{{ action.send_type }}" raises error.execution
{% if 'error.execution' in model.events %}
	{
		errEvt := sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send type='{{ action.send_type }}'> names a processor this platform does not support")
		errEvt.Metadata.SendID = "{{ send_id | default('') | escape_go }}"
		engine.Raise(errEvt)
	}
{% endif %}
{% if in_entry_exit is defined and in_entry_exit %}
	break
{% endif %}
{% elif action.target and action.target is startingwith('!') %}
	// W3C SCXML 6.2: Invalid target "{{ action.target }}" raises error.execution
{% if 'error.execution' in model.events %}
	{
		errEvt := sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send target='{{ action.target }}'> is not a target this processor can address")
		errEvt.Metadata.SendID = "{{ send_id | default('') | escape_go }}"
		engine.Raise(errEvt)
	}
{% endif %}
{% if in_entry_exit is defined and in_entry_exit %}
	break
{% endif %}
{% elif action.send_type and 'BasicHTTPEventProcessor' in action.send_type %}
	// W3C SCXML C.2: BasicHTTP send
	{
{% if action.targetexpr and model.needs_script_engine %}
		httpTargetVal, httpTargetErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.targetexpr | to_lua_expr }}`)
		httpTarget := ""
		if httpTargetErr == nil && httpTargetVal != nil {
			httpTarget = fmt.Sprintf("%v", httpTargetVal)
		}
{% elif action.target %}
		httpTarget := "{{ action.target | escape_go }}"
{% else %}
		httpTarget := ""
{% endif %}
{% if action.eventexpr and model.needs_script_engine %}
		httpEvtVal, _ := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.eventexpr | to_lua_expr }}`)
		httpEvtName := fmt.Sprintf("%v", httpEvtVal)
{% elif action.event %}
		httpEvtName := "{{ action.event | escape_go }}"
{% else %}
		httpEvtName := ""
{% endif %}
		// W3C SCXML C.2: Validate target before HTTP send
		if httpTarget == "" {
{% if 'error.communication' in model.events %}
			{
				errEvt := sce.NewPlatformError({{ machine_name }}Event{{ 'error.communication' | to_event_variant }}, "<send> over BasicHTTPEventProcessor has no target to post to")
				errEvt.Metadata.SendID = "{{ send_id | default('') | escape_go }}"
				engine.Raise(errEvt)
			}
{% elif 'error.execution' in model.events %}
			{
				errEvt := sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> over BasicHTTPEventProcessor has no target to post to")
				errEvt.Metadata.SendID = "{{ send_id | default('') | escape_go }}"
				engine.Raise(errEvt)
			}
{% endif %}
		} else {
{% if has_params or has_namelist %}
			// W3C SCXML C.2: Build HTTP params map from <param>/namelist elements
			httpParams := make(map[string][]string)
{% if has_params %}
{% for param in action.params %}
{% if param.is_static_literal %}
			httpParams["{{ param.name | escape_go }}"] = append(httpParams["{{ param.name | escape_go }}"], "{{ param.static_value | escape_go }}")
{% elif param.expr and model.needs_script_engine %}
			if httpParamVal, httpParamErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ param.expr | to_lua_expr }}`); httpParamErr == nil {
				// W3C SCXML C.2: the param crosses as text, so the value is
				// rendered by the neutral helper — an engine literal would put
				// this sender's language on the wire.
				httpParams["{{ param.name | escape_go }}"] = append(httpParams["{{ param.name | escape_go }}"], sce.ToWireString(httpParamVal))
			} else {
				// W3C SCXML 5.7.1: the pair is dropped AND the failure is
				// reported. The clause names no processor, so the same
				// document must not go quiet just because this send crosses
				// HTTP instead of reaching an SCXML session.
{% if 'error.execution' in model.events %}
				engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> <param name='{{ param.name | escape_go }}'> expr failed to evaluate"))
{% endif %}
			}
{% elif param.location and model.needs_script_engine %}
			if httpParamVal, httpParamErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ param.location }}`); httpParamErr == nil {
				httpParams["{{ param.name | escape_go }}"] = append(httpParams["{{ param.name | escape_go }}"], sce.ToWireString(httpParamVal))
			} else {
{% if 'error.execution' in model.events %}
				engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> <param name='{{ param.name | escape_go }}'> location could not be read"))
{% endif %}
			}
{% endif %}
{% endfor %}
{% endif %}
{% if has_namelist %}
{% for name in action.namelist | split %}
			if httpNlVal, httpNlErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ name }}`); httpNlErr == nil {
				httpParams["{{ name }}"] = append(httpParams["{{ name }}"], sce.ToWireString(httpNlVal))
			}
{% endfor %}
{% endif %}
			engine.PerformHTTPSend(httpTarget, httpEvtName, "", httpParams, "{{ send_id | default('') | escape_go }}")
{% else %}
			engine.PerformHTTPSend(httpTarget, httpEvtName, eventDataStr, nil, "{{ send_id | default('') | escape_go }}")
{% endif %}
		}
	}
{% elif action.target == '#_internal' %}
	// W3C SCXML 6.2: Internal send (target="#_internal")
{% if action.event %}
	{
		meta := sce.NewEventWithMetadata({{ machine_name }}Event{{ action.event | to_event_variant }})
		meta.Metadata.Data = eventDataStr
		engine.Raise(meta)
	}
{% endif %}
{% elif action.delay or action.delayexpr %}
	// W3C SCXML 6.2: Delayed send
	{
{% if action.delayexpr and model.needs_script_engine %}
		delayVal, _ := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.delayexpr | to_lua_expr }}`)
		delayDur := sce.ParseDelay(fmt.Sprintf("%v", delayVal))
{% elif action.delay %}
		delayDur := sce.ParseDelay("{{ action.delay }}")
{% else %}
		delayDur := time.Duration(0)
{% endif %}
{% if action.eventexpr and model.needs_script_engine %}
		delayEvtVal, _ := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.eventexpr | to_lua_expr }}`)
		delayEvtName := fmt.Sprintf("%v", delayEvtVal)
{% elif action.event %}
		delayEvtName := "{{ action.event | escape_go }}"
{% else %}
		delayEvtName := ""
{% endif %}
		if delayEvt, delayOk := p.GetEventFromName(delayEvtName); delayOk {
			engine.ScheduleEvent(delayEvt, delayDur, "{{ send_id | default('') | escape_go }}", eventDataStr)
		}
	}
{% elif action.target == '#_parent' %}
	// W3C SCXML 6.2: Send to parent
{% if action.event %}
	if p.ParentExternalQueue != nil {
		p.ParentExternalQueue <- sce.ParentEvent{Name: "{{ action.event | escape_go }}", Data: eventDataStr}
	}
{% endif %}
{% elif action.target and action.target is startingwith('#_') and action.target != '#_parent' and action.target != '#_internal' %}
{% set invoke_target_id = action.target | slice_from(2) %}
	// W3C SCXML 6.4: Send to invoked child "{{ invoke_target_id }}"
{% set ns_found = namespace(v=false) %}
{% for invoke_info in model.invokes | scxml %}
{% if invoke_info.invoke_id == invoke_target_id %}
{% set ns_found.v = true %}
	if p.child{{ invoke_info.invoke_id | to_pascal_case }} != nil {
{% if action.event %}
		p.child{{ invoke_info.invoke_id | to_pascal_case }}.RaiseExternalByName("{{ action.event | escape_go }}", eventDataStr)
{% elif action.eventexpr and model.needs_script_engine %}
		{
			childEvtVal, _ := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.eventexpr | to_lua_expr }}`)
			p.child{{ invoke_info.invoke_id | to_pascal_case }}.RaiseExternalByName(fmt.Sprintf("%v", childEvtVal), eventDataStr)
		}
{% endif %}
	}
{% endif %}
{% endfor %}
{% for invoke_info in model.invokes | hybrid %}
{% if invoke_info.invoke_id == invoke_target_id %}
{% set ns_found.v = true %}
	if p.child{{ invoke_info.invoke_id | to_pascal_case }} != nil {
{% if action.event %}
		p.child{{ invoke_info.invoke_id | to_pascal_case }}.RaiseExternalByName("{{ action.event | escape_go }}", eventDataStr)
{% endif %}
	}
{% endif %}
{% endfor %}
{% else %}
	// W3C SCXML 6.2: External send
{% if action.targetexpr and model.needs_script_engine %}
	{
		// W3C SCXML 6.2: Evaluate targetexpr at runtime
		sendTargetVal, sendTargetErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.targetexpr | to_lua_expr }}`)
		if sendTargetErr != nil || sendTargetVal == nil || fmt.Sprintf("%v", sendTargetVal) == "<nil>" {
			// W3C SCXML 6.2.4: If target is not valid, raise error.communication
{% if 'error.communication' in model.events %}
			{
				errEvt := sce.NewPlatformError({{ machine_name }}Event{{ 'error.communication' | to_event_variant }}, "<send> targetexpr evaluated to nothing, so there is no target to reach")
				errEvt.Metadata.SendID = "{{ send_id | default('') | escape_go }}"
				engine.Raise(errEvt)
			}
{% elif 'error.execution' in model.events %}
			engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> targetexpr evaluated to nothing, so there is no target to reach"))
{% endif %}
		} else {
{% if action.eventexpr and model.needs_script_engine %}
			sendEvtVal, _ := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.eventexpr | to_lua_expr }}`)
			sendEvtName := fmt.Sprintf("%v", sendEvtVal)
{% elif action.event %}
			sendEvtName := "{{ action.event | escape_go }}"
{% else %}
			sendEvtName := ""
{% endif %}
{% if model.invokes | scxml %}
			// W3C SCXML C.1: a target that decodes to one of our children's
			// published locations is addressed to that child. Without this the
			// address a peer was told to answer at routes back into the
			// sender's own queue, so the location compares equal and still
			// reaches nobody.
			addressedChild := sce.SessionIDFromScxmlLocation(fmt.Sprintf("%v", sendTargetVal))
			if !p.DeliverToChildSession(addressedChild, sendEvtName, eventDataStr) {
{% endif %}
			if sendEvt, sendOk := p.GetEventFromName(sendEvtName); sendOk {
				meta := sce.NewEventWithMetadata(sendEvt)
				meta.Metadata = sce.ExternalMetadata("{{ send_id | default('') | escape_go }}", "")
				meta.Metadata.Data = eventDataStr
				engine.RaiseExternalWithMeta(meta)
			}
{% if model.invokes | scxml %}
			}
{% endif %}
		}
	}
{% elif action.eventexpr and model.needs_script_engine %}
	{
		sendEvtVal, _ := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.eventexpr | to_lua_expr }}`)
		sendEvtName := fmt.Sprintf("%v", sendEvtVal)
		if sendEvt, sendOk := p.GetEventFromName(sendEvtName); sendOk {
			meta := sce.NewEventWithMetadata(sendEvt)
			meta.Metadata = sce.ExternalMetadata("{{ send_id | default('') | escape_go }}", "")
			meta.Metadata.Data = eventDataStr
			engine.RaiseExternalWithMeta(meta)
		}
	}
{% elif action.event %}
	{
		meta := sce.NewEventWithMetadata({{ machine_name }}Event{{ action.event | to_event_variant }})
		meta.Metadata = sce.ExternalMetadata("{{ send_id | default('') | escape_go }}", "")
		meta.Metadata.Data = eventDataStr
		engine.RaiseExternalWithMeta(meta)
	}
{% endif %}
{% endif %}
{% if has_namelist %}
		}
{% endif %}
	}
{% if action.idlocation and model.needs_script_engine %}
	}
{% endif %}
