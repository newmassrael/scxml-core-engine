{% if 'error.execution' in model.events %}
		engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> <param name='{{ param.name | escape_go }}'> names no location"))
{% endif %}
