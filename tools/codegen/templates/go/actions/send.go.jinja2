	// evaluated, so the send ends here with the argument error, as it does on
	// every engine.
{% if 'error.execution' in model.events %}
	errEvt := sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send> delay is not a CSS2 time")
