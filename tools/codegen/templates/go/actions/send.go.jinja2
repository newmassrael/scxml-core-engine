{# W3C SCXML 6.2: Send event (internal, external, delayed, HTTP) #}
{% import 'param_macros.go.jinja2' as param_macros %}
{# §scxml-6.2.5: the act a host-served send performs, for `processor_type`.
   One body for the two ways a send reaches it: a type the build saw served by
   the host (`send_type_host_served`, a Mesh send the build lowered among them)
   and a `targetexpr` that turns out, at run time, to name a Mesh peer. #}
{% macro host_send_arm(action, model, machine_name, processor_type, event_name_go, send_id_go, has_params, has_dynamic_params, has_namelist) %}
	// §scxml-6.2.5: "{{ processor_type }}" is served by the host, which
	// declared it to this build. Dispatch rather than refuse — and take the
	// whole send, because a processor the host serves owns delivery; falling
	// through would also enqueue the event locally and the document would see
	// the act twice.
	{
{% if has_dynamic_params or has_namelist %}
		hostParams := sce.WireParamsFromTypedParams(parts)
{% elif has_params %}
		hostParams := sce.WireParamsFromTypedParams([]sce.EventDataParam{
{% for param in action.params %}
			{Name: "{{ param.name | escape_go }}", Value: "{{ param.static_value | escape_go }}"},
{% endfor %}
		})
{% else %}
		hostParams := map[string][]string{}
{% endif %}
		hostRequest := sce.HostSendRequest{
			ProcessorType: "{{ processor_type | escape_go }}",
			EventName:     {{ event_name_go }},
			Target:        {% if action.targetexpr and model.needs_script_engine %}sendTarget{% else %}"{{ action.target | default('', true) | escape_go }}"{% endif %},
			Content:       {% if action.native_content_value %}sce.ToWireString(contentValue){% else %}"{{ action.content | default('', true) | escape_go }}"{% endif %},
			Params:        hostParams,
			SendID:        {{ send_id_go }},
			// W3C SCXML 5.10: the payload computed above, once, for every arm.
			EventData: eventDataStr,
			// SCE_MESH.md §mesh-10.7: the invokeid of the event being
			// processed now, carried back out as a W3C child's send to its
			// parent carries it (§scxml-6.4.1). Analysis keeps the field on
			// every machine with a host-served send.
			InvokeID: p.pendingEventInvokeid,
		}
{% set host_delay_ms = action.delay_ms if (action.delay_ms is defined and action.delay_ms is not none and action.delay_ms > 0) else 0 %}
{% if action.delayexpr or host_delay_ms > 0 %}
{% if (action.delayexpr and model.needs_script_engine) or action.native_delay %}
		hostDelayMs := int64(sendDelayMs)
{% else %}
		hostDelayMs := int64({{ host_delay_ms }})
{% endif %}
		// W3C SCXML 6.2.4: arm it. The engine performs the act when the
		// deadline arrives and reports it there if nobody does, so the
		// unregistered-handler branch belongs only to the immediate form —
		// this site has returned long before the deadline. W3C SCXML 6.3: it
		// lands in the delayed-send queue under SendID, so a <cancel> reaches
		// it and the host never sees the act.
		engine.ScheduleHostSend(hostRequest, time.Duration(hostDelayMs)*time.Millisecond, {{ send_id_go }})
{% else %}
		_, hostServed := engine.PerformHostSend(hostRequest)
{% if 'error.execution' in model.events %}
		// W3C SCXML 6.2: a declared type with no handler registered is, from
		// the document's side, a processor the platform does not support — the
		// act it asked for was performed by nobody. Same event as an
		// undeclared type, so a wiring mistake cannot read as success.
		if !hostServed && !engine.HasEventProcessor("{{ processor_type | escape_go }}") {
			errEvt := sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<send type='{{ processor_type }}'> names a processor the host declared but never registered")
			errEvt.Metadata.SendID = {{ send_id_go }}
			engine.Raise(errEvt)
		}
{% else %}
		_ = hostServed
{% endif %}
{% endif %}
	}
{%- endmacro %}
{# W3C SCXML 6.2 / C.1: deliver the event to this session's own external
   queue, carrying this session as its origin. One body for the send with no
   target and the one whose target names this session. #}
{% macro raise_external_here(action, model, machine_name, send_id_go, event_name_go, delay_go=none) %}
{% if delay_go %}
	// W3C SCXML 6.2: delayed to this session's external queue. §scxml-C-1: the
	// origin is this session, as on the immediate path.
{% if (action.eventexpr and model.needs_script_engine) or action.native_event %}
	// W3C SCXML 3.12.1 + 5.10: a computed name is delivered as the event the
	// document's names resolve it to, and `_event.name` is the whole name.
	engine.SendNamedExternal({{ event_name_go }}, {{ delay_go }}, {{ send_id_go }}, eventDataStr, p.SessionID)
{% else %}
	if delayEvt, delayOk := p.GetEventFromName({{ event_name_go }}); delayOk {
		engine.ScheduleEvent(delayEvt, {{ delay_go }}, {{ send_id_go }}, eventDataStr, p.SessionID)
	}
{% endif %}
{% elif (action.eventexpr and model.needs_script_engine) or action.native_event %}
	engine.SendNamedExternal({{ event_name_go }}, 0, {{ send_id_go }}, eventDataStr, p.SessionID)
{% elif action.event %}
	{
		meta := sce.NewEventWithMetadata({{ machine_name }}Event{{ action.event | to_event_variant }})
		meta.Metadata = sce.ExternalMetadata({{ send_id_go }}, p.SessionID)
		meta.Metadata.Data = eventDataStr
		engine.RaiseExternalWithMeta(meta)
	}
{%- endif %}
{%- endmacro %}
