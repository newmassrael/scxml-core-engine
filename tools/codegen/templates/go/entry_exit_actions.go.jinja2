{#
    Entry/Exit Actions Template (Go Jinja2)

    W3C SCXML 3.7/3.8/3.9: Entry and exit action execution.

    Generates:
    - ExecuteEntryActions(state, engine, isDefaultEntry)
    - ExecuteExitActions(state, engine, configurationBeforeExit)
    - ExecuteHistoryDefaultContent(history, engine)

    Each answers for ONE state. Which states a microstep enters and exits, and
    in which order, is the runtime's Appendix D procedure (microstep.go): it
    enters its entry set front to back and exits its exit set in exit order,
    so nothing here enters a region, descends to an initial child, or exits a
    descendant. `isDefaultEntry` is the entry set's statesForDefaultEntry
    answer — whether this state's initial transition content runs.

    NOTE: Uses dynamic {% include %} like the Rust templates to avoid
    minijinja macro+include limitation. Action field is `action.type`
    (serde rename from `action_type`).
#}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}
{# W3C SCXML 6.4.1: an invoke's generated id goes to its `idlocation` when the
   element is evaluated, then the invoke is deferred. The write is the
   assignment `<assign>` makes — the location is lowered, so a member path
   lands, and one that cannot take the id raises error.execution and the
   invocation does not start, as any argument of the element that cannot be
   evaluated does. `model`, `machine_name` and `state_id` are parameters
   because a macro body does not see the render context. #}
{% macro defer_with_idlocation(invoke_info, model, machine_name, state_id) %}
{% if invoke_info.idlocation %}
			if err := p.storeIDInLocation(`{{ invoke_info.idlocation | to_lua_location }}`, generatedInvokeID); err != nil {
{% if 'error.execution' in model.events %}
				engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<invoke idlocation='{{ invoke_info.idlocation | escape_go }}'> could not take the invoke id"))
{% endif %}
			} else {
				sce.DeferInvoke(&p.pendingInvokes, sce.PendingInvoke[{{ machine_name }}State]{
					InvokeID:   generatedInvokeID,
					State:      {{ machine_name }}State{{ state_id | to_state_variant }},
					DocumentID: "{{ invoke_info.invoke_id }}",
				})
			}
{%- else %}
			sce.DeferInvoke(&p.pendingInvokes, sce.PendingInvoke[{{ machine_name }}State]{
				InvokeID:   generatedInvokeID,
				State:      {{ machine_name }}State{{ state_id | to_state_variant }},
				DocumentID: "{{ invoke_info.invoke_id }}",
			})
{%- endif %}
{%- endmacro %}

// ExecuteEntryActions enters one state (W3C SCXML 3.8): adds it to the
// configuration, runs its <onentry>, and its <initial> transition's content when
// its initial state is entered by default.
{# SCE Protocol-Synthesis RFC §synth-5-O — function-scope SCE-MAP marker
   above `ExecuteEntryActions`. `//line file:N` is a Go compiler
   directive recognized by panic stack traces and `go vet`; it must
   start at column 0 (no leading indent). #}
{{ sce_map.source_marker(model.source_location, "go", symbol_artifact=sce_artifact.machine) }}
func (p *{{ machine_name }}Policy) ExecuteEntryActions(state {{ machine_name }}State, engine *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event], isDefaultEntry bool) {
{% if model.needs_script_engine %}
	p.ensureScriptEngine()
{% endif %}
{% if model.has_parallel_states or model.uses_in_predicate %}
	// W3C SCXML 3.4/3.12.1: Add state to active configuration for parallel states and In() predicate
	for _, s := range p.activeStates {
		if s == state {
			return // W3C SCXML 3.8: Skip onentry actions for duplicate state entry
		}
	}
	p.activeStates = append(p.activeStates, state)
{% endif %}
	switch state {
{% for state_id, state in model.states | dictsort %}
{% if state.on_entry_blocks or state.initial_transition_actions or (state.is_final and state.parent) or (state.is_final and state.donedata) or state.invokes | scxml or state.invokes | hybrid or state.invokes | unsupported %}
	case {{ machine_name }}State{{ state_id | to_state_variant }}:{{ annot.annotation_comment(state, "go", "		") }}
{% if state.source_location %}
		{{ sce_map.source_marker(state.source_location, "go", stmt_level=true, symbol_state=state_id, symbol_artifact=sce_artifact.state_body) | trim }}
{% endif %}
{% for block in state.on_entry_blocks %}
		// W3C SCXML 3.8: onentry block {{ loop.index0 }} (break on error stops subsequent actions)
		for actionBlock{{ loop.index0 }} := 0; actionBlock{{ loop.index0 }} < 1; actionBlock{{ loop.index0 }}++ {
			_ = actionBlock{{ loop.index0 }}
{% for action in block %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "go", "			") -}}
{%- endif %}
			{% with in_entry_exit=true %}{% include 'actions/' ~ action.type ~ '.go.jinja2' %}{% endwith %}

{% endfor %}
		}
{% endfor %}
{% if state.initial_transition_actions %}
		// W3C SCXML 3.3.2 / §scxml-D-enterStates: the <initial> transition's
		// content runs when this state's initial state is entered by DEFAULT —
		// not when the state is entered only as an ancestor of a deeper target.
		if isDefaultEntry {
			for initialBlock := 0; initialBlock < 1; initialBlock++ {
				_ = initialBlock
{% for action in state.initial_transition_actions %}
				{% with in_entry_exit=true %}{% include 'actions/' ~ action.type ~ '.go.jinja2' %}{% endwith %}

{% endfor %}
			}
		}
{% endif %}
{% if state.is_final and state.donedata %}
		// W3C SCXML 5.5: Evaluate donedata for final state
		doneEventData := ""
		doneDataOk := true
{% if state.donedata.params %}
		{
			p.ensureScriptEngine()
			se := p.ScriptEngine
			if se != nil {
				var jsonParts []string
{% for param in state.donedata.params %}
{% set param_expr = param.expr if param.expr else param.location %}
{% if not param_expr %}
				// W3C SCXML 5.7: Empty location raises error.execution (structural error)
{% if 'error.execution' in model.events %}
				engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<donedata> <param name='{{ param.name | escape_go }}'> has an empty location"))
{% endif %}
				doneDataOk = false
{% else %}
{# A Go raw string cannot escape its own terminator, so author text in
   one is unfixable by any filter. Interpreted strings take the same
   two-boundary composition the other backends use: escape once for the
   Lua source being assembled, once for the Go literal carrying it. #}
				if val, err := se.EvaluateExpression(p.SessionID, "{{ param_expr | to_lua_expr | escape_go }}"); err == nil {
					// §scxml-B-2-9: donedata rides an event, so it leaves the
					// data model and travels as JSON — the same wire
					// `<send>`'s params take.
					jsonParts = append(jsonParts, "\"{{ param.name | escape_json_string | escape_go }}\":" + sce.ScriptValueToJSON(val))
				} else {
{% if 'error.execution' in model.events %}
					engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<donedata> <param name='{{ param.name | escape_go }}'> failed to evaluate"))
{% endif %}
				}
{% endif %}
{% endfor %}
				if doneDataOk {
					doneEventData = "{" + strings.Join(jsonParts, ",") + "}"
				}
			}
		}
{% elif state.donedata.content.kind == "expression" or state.donedata.content.kind == "inline_text" %}
		{
{% if state.donedata.content.kind == "expression" %}
			// W3C SCXML 5.5: <content expr="..."/> MUST be evaluated against the datamodel.
{% set donedata_content_lua = state.donedata.content.text | to_lua_expr %}
{% else %}
			// W3C SCXML B.2: inline text takes the ordered readings — an
			// expression when it is one, otherwise the string. The same
			// filter inline `<data>` text goes through decides which.
{% set donedata_content_lua = state.donedata.content.text | to_lua_data_content %}
{% endif %}
			p.ensureScriptEngine()
			se := p.ScriptEngine
			if se != nil {
				{# A Go raw string needs no escaping, and applying the
				   quoted-string escape here corrupts it: `escape_go` turns a
				   `"` into `\"`, which a raw string passes to Lua verbatim.
				   The bug was invisible while the emitted Lua quoted its
				   strings with `'`. #}
				if val, err := se.EvaluateExpression(p.SessionID, `{{ donedata_content_lua }}`); err == nil {
					// §scxml-B-2-9: serialized, not spelled as Lua source —
					// the reader is the parent's dequeue, which parses.
					doneEventData = sce.ScriptValueToJSON(val)
				} else {
{% if 'error.execution' in model.events %}
					engine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<donedata> <content expr> failed to evaluate"))
{% endif %}
				}
			}
		}
{% elif state.donedata.content.kind == "literal" %}
		{
			// W3C SCXML 5.5: inline text children are used **as the content
			// value** — no evaluation, no script engine required.
			// Delegates to the SSoT helper shared with C++/Rust/Kotlin backends.
			doneEventData = sce.EmitContentLiteral(`{{ state.donedata.content.text | escape_go }}`)
		}
{% endif %}
		_ = doneEventData
		_ = doneDataOk
{% endif %}
{% if state.is_final and state.donedata and not state.parent %}
		// W3C SCXML 5.5 + 6.3.1: Top-level <final> — stash donedata so the
		// invoking parent's RaiseDoneInvoke can lift it onto
		// done.invoke.<id>._event.data. Mirrors the C++ AOT
		// stashDonedataAtFinal contract and Rust
		// Engine::stash_donedata_at_final.
		if doneDataOk {
			engine.StashDonedataAtFinal(doneEventData)
		}
{% endif %}
{% if state.is_final and state.parent %}
{% set done_event = ("done.state." ~ state.parent) | to_event_variant %}
{% if state.donedata %}
		// W3C SCXML 5.5: Carry evaluated donedata in done.state.{{ state.parent }} event
		if doneDataOk {
			doneMeta := sce.NewEventWithMetadata({{ machine_name }}Event{{ done_event }})
			doneMeta.Metadata.Data = doneEventData
			engine.Raise(doneMeta)
		}
{% else %}
		// W3C SCXML 3.7: Final state reached — raise done.state.{{ state.parent }}
		engine.Raise(sce.NewEventWithMetadata({{ machine_name }}Event{{ done_event }}))
{% endif %}
{% if model.has_parallel_states and state.parent in model.states and model.states[state.parent].parent %}
{% set grandparent_id = model.states[state.parent].parent %}
{% if grandparent_id in model.states and model.states[grandparent_id].is_parallel and ('done.state.' ~ grandparent_id) in model.events %}
		// W3C SCXML 3.4 / §scxml-D-enterStates: a region of {{ grandparent_id }}
		// has reached a final state, and the <parallel> completes when every one
		// of its child states is in one — Appendix D's isInFinalState, which
		// counts a region that is itself a <parallel> only once all of ITS
		// regions are.
		if (sce.PolicyDocument[{{ machine_name }}State, {{ machine_name }}Event]{Policy: p}).IsInFinalState({{ machine_name }}State{{ grandparent_id | to_state_variant }}, p.activeStates) {
			engine.Raise(sce.NewEventWithMetadata({{ machine_name }}Event{{ ('done.state.' ~ grandparent_id) | to_event_variant }}))
		}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% if state.invokes | unsupported %}
		// W3C SCXML 6.4.1: `type` names no processor this platform implements.
		// Defer only — the error.execution raise happens in
		// ExecutePendingInvokes, so §scxml-6.4 ordering holds and
		// CancelInvokesForState drops the entry if the state exits first.
{% for invoke_info in state.invokes | unsupported %}
		{
			generatedInvokeID := fmt.Sprintf("%s.%d.{{ invoke_info.invoke_id }}", "{{ state_id }}", sce.NextInvokeCounter())
			sce.DeferInvoke(&p.pendingInvokes, sce.PendingInvoke[{{ machine_name }}State]{
				InvokeID:   generatedInvokeID,
				State:      {{ machine_name }}State{{ state_id | to_state_variant }},
				DocumentID: "{{ invoke_info.invoke_id }}",
			})
		}
{% endfor %}
{% endif %}
{% if state.invokes | scxml or state.invokes | hybrid %}
		// W3C SCXML 6.4: Defer invoke execution until macrostep end
{% for invoke_info in state.invokes | scxml %}
		{  {{- annot.annotation_comment(invoke_info, "go", "			") }}
			generatedInvokeID := fmt.Sprintf("%s.%d.{{ invoke_info.invoke_id }}", "{{ state_id }}", sce.NextInvokeCounter())
{{ defer_with_idlocation(invoke_info, model, machine_name, state_id) }}
		}
{% endfor %}
{% for invoke_info in state.invokes | hybrid %}
		{  {{- annot.annotation_comment(invoke_info, "go", "			") }}
			generatedInvokeID := fmt.Sprintf("%s.%d.{{ invoke_info.invoke_id }}", "{{ state_id }}", sce.NextInvokeCounter())
{{ defer_with_idlocation(invoke_info, model, machine_name, state_id) }}
		}
{% endfor %}
{% endif %}
{% endfor %}
	default:
		// No entry actions
	}
}

// ExecuteHistoryDefaultContent runs a <history>'s default transition content
// (W3C SCXML 3.10.2), after its parent's onentry (and after the parent's own
// <initial> content) when the history was taken with nothing recorded. The
// engine asks for it by the entry set's defaultHistoryContent answer; a history
// that restored what it recorded runs nothing.
{% set _history_content = namespace(any=false) %}
{% for _history_id, _history_info in model.history_states | dictsort %}
{% if _history_info.default_actions %}
{% set _history_content.any = true %}
{% endif %}
{% endfor %}
{{ sce_map.source_marker(model.source_location, "go", symbol_artifact=sce_artifact.machine) }}
func (p *{{ machine_name }}Policy) ExecuteHistoryDefaultContent(history sce.HistoryID, engine *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event]) {
{% if _history_content.any %}
{% if model.needs_script_engine %}
	p.ensureScriptEngine()
{% endif %}
	switch history {
{% for history_id, history_info in model.history_states | dictsort %}
{% if history_info.default_actions %}
	case {{ machine_name }}History{{ history_id | to_state_variant }}:
{% for action in history_info.default_actions %}
		{% include 'actions/' ~ action.type ~ '.go.jinja2' %}

{% endfor %}
{% endif %}
{% endfor %}
	}
{% else %}
	// W3C SCXML 3.10.2: no <history> in this document has default content.
{% endif %}
}

// ExecuteExitActions exits one state (W3C SCXML 3.9): records its histories,
// runs its <onexit>, cancels its invocations and removes it from the
// configuration — §scxml-D-exitStates's order.
{{ sce_map.source_marker(model.source_location, "go", symbol_artifact=sce_artifact.machine) }}
func (p *{{ machine_name }}Policy) ExecuteExitActions(state {{ machine_name }}State, engine *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event], configurationBeforeExit []{{ machine_name }}State) {
{% if model.needs_script_engine %}
	p.ensureScriptEngine()
{% endif %}
{% if model.history_states %}
	// W3C SCXML 3.10 / §scxml-D-exitStates: record the histories of this state
	// from the configuration the microstep started from — the engine hands
	// every exit the configuration as it stood before the first one, so every
	// history in one microstep reads the same configuration.
{% for history_id, history_info in model.history_states | dictsort %}
	if state == {{ machine_name }}State{{ history_info.parent | to_state_variant }} {
		// W3C SCXML 3.10: {{ history_info.type }} history {{ history_id }}
		p.history{{ history_id | to_pascal_case }} = (sce.PolicyDocument[{{ machine_name }}State, {{ machine_name }}Event]{Policy: p}).RecordedHistory({{ machine_name }}State{{ history_info.parent | to_state_variant }}, {{ 'true' if history_info.type == 'deep' else 'false' }}, configurationBeforeExit)
	}
{% endfor %}
{% endif %}
	// §scxml-D-exitStates orders one state's exit as onexit, then
	// cancelInvoke, then configuration.delete(s), so `In(s)` inside s's own
	// handler is true: the <onexit> switch comes first and the removal from
	// the configuration last.
	switch state {
{% for state_id, state in model.states | dictsort %}
{% if state.on_exit_blocks %}
	case {{ machine_name }}State{{ state_id | to_state_variant }}:{{ annot.annotation_comment(state, "go", "		") }}
{% if state.source_location %}
		{{ sce_map.source_marker(state.source_location, "go", stmt_level=true, symbol_state=state_id, symbol_artifact=sce_artifact.state_body) | trim }}
{% endif %}
{% for block in state.on_exit_blocks %}
		// W3C SCXML 3.9: onexit block {{ loop.index0 }}
		for exitBlock{{ loop.index0 }} := 0; exitBlock{{ loop.index0 }} < 1; exitBlock{{ loop.index0 }}++ {
			_ = exitBlock{{ loop.index0 }}
{% for action in block %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "go", "			") -}}
{%- endif %}
			{% with in_entry_exit=true %}{% include 'actions/' ~ action.type ~ '.go.jinja2' %}{% endwith %}

{% endfor %}
		}
{% endfor %}
{% endif %}
{% endfor %}
	default:
		// No exit actions
	}
{# W3C SCXML 6.4: `host_invoker` is named here as well as inside the loop, and
   that is load-bearing rather than belt-and-braces — the Rust template records
   the measurement. `unsupported` covers a host-served invoke today, but a
   document whose ONLY `<invoke>` is host-served must still emit an exit
   `switch`, or the host is never told to stop the process it was told to
   start. Naming the narrow filter in the guard keeps that true however the
   broad one is later narrowed. #}
{% set has_invoke_exits = model.invokes | scxml or model.invokes | hybrid or model.invokes | unsupported or model.invokes | host_invoker %}
{% if has_invoke_exits %}
	// W3C SCXML 6.4: Cancel pending invokes and cleanup active children on state exit
	switch state {
{% for state_id, state in model.states | dictsort %}
{% if state.invokes | scxml or state.invokes | hybrid or state.invokes | unsupported or state.invokes | host_invoker %}
	case {{ machine_name }}State{{ state_id | to_state_variant }}:
		sce.CancelInvokesForState(&p.pendingInvokes, {{ machine_name }}State{{ state_id | to_state_variant }})
{% for invoke_info in state.invokes | host_invoker %}
		// W3C SCXML 6.4: the host's invocation ends with the state that
		// started it. Unconditional here: the engine knows whether this one
		// ever started and stays silent when it did not, so the emitted chain
		// does not need its own bookkeeping.
		engine.CancelHostInvoke("{{ invoke_info.invoke_type | escape_go }}", "{{ invoke_info.invoke_id }}")
{% endfor %}
{% for invoke_info in state.invokes | scxml %}
		if p.child{{ invoke_info.invoke_id | to_pascal_case }} != nil {
			// §scxml-D-exitInterpreter: a cancelled session is exited -- its
			// states' <onexit> run -- before it is dropped; what that exit
			// sends to #_parent is dropped with it (§scxml-6.4, test252).
			p.child{{ invoke_info.invoke_id | to_pascal_case }}.Stop()
			p.child{{ invoke_info.invoke_id | to_pascal_case }} = nil
		}
		delete(p.activeInvokes, "{{ invoke_info.invoke_id }}")
		p.pendingDoneInvoke{{ invoke_info.invoke_id | to_pascal_case }} = false
{% endfor %}
{% for invoke_info in state.invokes | hybrid %}
		if p.child{{ invoke_info.invoke_id | to_pascal_case }} != nil {
			p.child{{ invoke_info.invoke_id | to_pascal_case }} = nil
		}
		delete(p.activeInvokes, "{{ invoke_info.invoke_id }}")
		p.pendingDoneInvoke{{ invoke_info.invoke_id | to_pascal_case }} = false
{% endfor %}
{% endif %}
{% endfor %}
	default:
	}
{% endif %}
{% if model.has_parallel_states or model.uses_in_predicate %}
	// §scxml-D-exitStates: out of the configuration only after its onexit
	// and invoke cancellation — the configuration.delete(s) step.
	p.activeStates = func() []{{ machine_name }}State {
		var result []{{ machine_name }}State
		for _, s := range p.activeStates {
			if s != state {
				result = append(result, s)
			}
		}
		return result
	}()
{% endif %}
}
