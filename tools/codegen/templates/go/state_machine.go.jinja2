	children := []sce.SavedChild{}
{% for invoke_info in model.invokes | scxml_family %}
	if running := p.child{{ invoke_info.field_suffix | to_pascal_case }}; running != nil && !p.pendingDoneInvoke{{ invoke_info.field_suffix | to_pascal_case }} && !running.IsInFinalState() {
