{% endif %}
{% endfor %}
{% endif %}
}

// IsFinalState returns true if state is a <final> state (W3C SCXML 3.7).
func (p *{{ machine_name }}Policy) IsFinalState(state {{ machine_name }}State) bool {
	switch state {
{% for state_id, state in model.states | dictsort %}
{% if state.is_final %}
