// AcceptParams gives this machine the values params carries, in place of the
// ones its `<data>` gave. Called before it initializes (§scxml-6.4.1).
func (p *{{ machine_name }}Policy) AcceptParams(params {{ machine_name }}InvokeParams) {
{% for field in static_fields %}
{% if field.saved_kind == 'scalar' and field.saved_type != 'bytes' %}
	if params.V{{ field.id | to_pascal_case }} != nil {
		p.{{ field.name }} = *params.V{{ field.id | to_pascal_case }}
