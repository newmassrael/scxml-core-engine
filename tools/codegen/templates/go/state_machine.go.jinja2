// {{ machine_name }}SaveAt is engine's whole state at the macrostep boundary it
// stands at: every variable, the machine's own included, and where it stands, as
// the `sce-saved-state` document every backend reads (sce.SavedState.ToJSON).
// Each delayed `<send>` still waiting is written as the moment it comes due on
// the wall clock whose reading now is wallNowMs, in milliseconds since the Unix
// epoch.
//
// Refused for a machine that is not running, one that has ended, one whose last
// macrostep stopped at the microstep ceiling, and one built around another
// document's policy.
func {{ machine_name }}SaveAt(engine *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event], wallNowMs int64) (*sce.SavedState, error) {
	p, ok := engine.Policy().(*{{ machine_name }}Policy)
	if !ok {
		return nil, sce.Refuse("the engine is not one of {{ machine_name }}")
	}
	variables := sce.NewJSONObject()
{% for field in static_fields %}
	variables.Set("{{ field.id | escape_go }}", {{ saved_write(field) }})
{% endfor %}
{% if model.invokes | scxml_family %}
	// docs/adr/0045: each running child, with its whole state.
	children, err := p.savedChildren(wallNowMs)
	if err != nil {
		return nil, err
	}
{% else %}
	var children []sce.SavedChild
{% endif %}
	return sce.SaveSession(engine, &{{ machine_name }}SavedShape, variables,
		sce.SaveHistory[{{ machine_name }}State, {{ machine_name }}Event](p, {{ machine_name }}Histories),
		children, wallNowMs)
}

