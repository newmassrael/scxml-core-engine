}

// {{ machine_name }}Judge refuses saved unless a machine of this document could
// restore it, building nothing: what a parent's restore asks of each child it
// holds (docs/adr/0045, section 3, step 1).
func {{ machine_name }}Judge(saved *sce.SavedState) error {
	p := &{{ machine_name }}Policy{}
	grown, err := sce.UpgradeSavedState(saved, &{{ machine_name }}SavedShape)
	if err != nil {
		return err
	}
	if _, err := sce.RestoreHistory[{{ machine_name }}State, {{ machine_name }}Event](p, grown, {{ machine_name }}Histories); err != nil {
		return err
	}
{% for field in static_fields %}
	if raw, err := grown.Variable("{{ field.id | escape_go }}"); err != nil {
		return err
	} else if _, err := {{ saved_read(field, 'raw') }}; err != nil {
		return err
	}
{% endfor %}
	return sce.JudgeSession[{{ machine_name }}State, {{ machine_name }}Event](p, grown)
}

// {{ machine_name }}RestoreAt is a machine of policy standing where saved left
// one, measuring time by clock: in place of `Initialize`, so no `<onentry>` runs
// and no `<data>` is evaluated, since the saved run already did both. Every value
// is read and the state judged before any is written, so a refused restore leaves
// policy as it was.
//
// Each delayed `<send>` saved is armed against clock, which is the one the
// machine measures time by; wallNowMs is what time it is on the wall clock the
// saved `due`s were written against. A send comes due when its saved moment does,
// and one already due comes due now.
//
// The host registers its invokers and its processors on the machine this
// returns, and drives it as it would one it had initialized.
func {{ machine_name }}RestoreAt(policy *{{ machine_name }}Policy, saved *sce.SavedState, clock sce.SceClock, wallNowMs int64) (*sce.Engine[{{ machine_name }}State, {{ machine_name }}Event], error) {
	// The state as one of this machine: each record saved at an earlier revision
	// of its schema holds the defaults of the fields added since.
	grown, err := sce.UpgradeSavedState(saved, &{{ machine_name }}SavedShape)
	if err != nil {
		return nil, err
	}
	history, err := sce.RestoreHistory[{{ machine_name }}State, {{ machine_name }}Event](policy, grown, {{ machine_name }}Histories)
	if err != nil {
		return nil, err
	}
{% for field in static_fields %}
	raw{{ loop.index }}, err := grown.Variable("{{ field.id | escape_go }}")
	if err != nil {
		return nil, err
	}
	read{{ loop.index }}, err := {{ saved_read(field, 'raw' ~ loop.index) }}
	if err != nil {
		return nil, err
	}
{% endfor %}
	if err := sce.JudgeSession[{{ machine_name }}State, {{ machine_name }}Event](policy, grown); err != nil {
		return nil, err
	}
{% for field in static_fields %}
	policy.{{ field.name }} = read{{ loop.index }}
{% endfor %}
	for _, recorded := range history {
		policy.SetHistoryValue(recorded.History, recorded.States)
	}
{% for invoke_info in model.invokes | scxml_family %}
	// A start after the restore is numbered on from the saved count.
	policy.invokeStarts{{ invoke_info.field_suffix | to_pascal_case }} = uint64(grown.InvokeStart("{{ invoke_info.invoke_id | escape_go }}"))
{% endfor %}
	return sce.EnterSession[{{ machine_name }}State, {{ machine_name }}Event](policy, grown, clock, wallNowMs)
}

// {{ machine_name }}Restore is {{ machine_name }}RestoreAt at the host's wall
// clock now.
func {{ machine_name }}Restore(policy *{{ machine_name }}Policy, saved *sce.SavedState, clock sce.SceClock) (*sce.Engine[{{ machine_name }}State, {{ machine_name }}Event], error) {
	return {{ machine_name }}RestoreAt(policy, saved, clock, sce.SavedWallClockMs())
}

// SetSessionID gives this session the id its host has for it, in place of the
// one it drew: an XML Nmtoken, since another session addresses this one as
// `#_scxml_<id>` and every child's id is this one's and the id the child was
// started under (docs/adr/0045). Refused for anything else. Called before the
// machine starts, since what it sends names it by the id it began with.
func (p *{{ machine_name }}Policy) SetSessionID(id string) error {
	if reason := sce.SessionIDRefusalOf(id); reason != "" {
		return sce.Refuse(reason)
	}
	p.SessionID = id
