{#
    Script Engine Helpers Template (Go Jinja2)

    W3C SCXML 5.2/5.10: Script engine session lifecycle, system variables,
    datamodel initialization, guard evaluation, event metadata binding.

    docs/adr/0096: the script session is made in one place,
    `InitializeDataModel`, the first step of every start; what runs after the
    start reads the session that step established.
#}
{% if model.needs_script_engine %}

// assertScriptSession holds that the script session this machine's executable
// content runs in was established by its start (InitializeDataModel). A start
// whose session could not be established was refused before anything could
// reach here, so reaching here without one is a defect of the generated code,
// not a condition of the run, and it panics as a missing engine does
// (docs/adr/0096).
func (p *{{ machine_name }}Policy) assertScriptSession() {
	if !p.scriptEngineInitialized {
		panic("{{ machine_name }}Policy: the script session is established by the start, before any executable content runs")
	}
}

// establishScriptSession makes this machine's script session, the first step
// of every start (docs/adr/0096). It is three steps: create the session, which
// loads the shared library into it, then bind the system variables. A step that
// fails releases what the steps before it made and is the answer, and the
// session is not marked established, so the start is refused with nothing half
// done and a later start asks for the session again.
//
// Engine DI Parity RFC: panics if ScriptEngine was not set on the policy
// before Initialize() — mirrors Kotlin's mandatory constructor parameter
// contract. A missing engine is a broken invariant of the host, not a failure
// of the session, so it is not answered as one.
func (p *{{ machine_name }}Policy) establishScriptSession() *sce.ScriptSessionFailure {
	engine := p.ScriptEngine
	if engine == nil {
		panic("{{ machine_name }}Policy: ScriptEngine field must be set before Initialize()")
	}
	sessionID := p.SessionID
	if sessionID == "" {
		sessionID = sce.GenerateSessionID()
		p.SessionID = sessionID
	}
	if err := engine.CreateSession(sessionID); err != nil {
		return sce.ScriptSessionFailureOfCreation(err)
	}
	// W3C SCXML C.1.1 / C.2.3: the _ioprocessors entries come from the same
	// helper every other backend uses, so a machine reads the same entry names
	// and the same addresses whichever one runs it.
	if err := engine.SetupSystemVariables(sessionID, "{{ model.scxml_name | default('') | w3c_session_name(model.name) | escape_go }}",
		sce.BuildIoProcessors(sessionID, p.BasicHTTPAccessURI)); err != nil {
		engine.DestroySession(sessionID)
		return sce.ScriptSessionFailureOfSystemVariables(err)
	}
{% if model.has_parallel_states or model.uses_in_predicate %}
	// W3C SCXML 5.9.2: Register In() predicate callback
	engine.SetStateQueryCallback(sessionID, func(stateID string) bool {
		return p.IsStateActive(stateID)
	})
{% endif %}
{# W3C SCXML 5.3: no pre-seed here. The lazy setup this replaced once wrote
   each constant-folded `<data>` literal into the fresh session from a struct
   field, and `InitializeDataModel` then evaluated the same `<data>`'s `expr`
   and overwrote it. Every backend initialises a variable in exactly one
   place, the `<data>` below. #}
	p.scriptEngineInitialized = true
	return nil
}

{# W3C SCXML 5.2/5.3: bind one state-local `<data>` — what binding means for
   it, whichever binding decides WHEN: early binding runs it for every state at
   document load, late binding on the state's first entry (bindStateData). One
   macro, so the two cannot disagree about a `src`, an `expr` or content.
   Expects `engine`, `sessionID` and `eng` in scope. #}
{% macro bind_state_data_var(var) %}
{% if var.src %}
{% set src_file = var.src | replace("file:", "") %}
	// W3C SCXML 5.3.1: Load {{ var.id }} from src="{{ var.src }}"
	{
		basePath := filepath.Join("..", "..", "..", "..", "..", "{{ model.scxml_base_path }}")
		if srcData, err := sce.LoadFileContent(filepath.Join(basePath, "{{ src_file }}")); err == nil {
			sce.InitializeVariableFromContent(engine, sessionID, "{{ var.id }}", srcData)
		}
	}
{% elif var.expr %}
{% set is_function_expr = (var.expr | trim) is startingwith('function') %}
{% if is_function_expr %}
	if err := engine.ExecuteScript(sessionID, `{{ var.id }} = {{ var.expr | to_lua_expr }}`); err != nil {
{% if 'error.execution' in model.events %}
		eng.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id }}'> function expression failed"))
{% endif %}
	}
{% else %}
	{
		result, err := engine.EvaluateExpression(sessionID, `{{ var.expr | to_lua_expr }}`)
		if err == nil {
			_ = engine.SetVariable(sessionID, "{{ var.id }}", result)
		} else {
{% if 'error.execution' in model.events %}
			eng.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id }}'> expr failed to evaluate"))
{% endif %}
			_ = engine.SetVariable(sessionID, "{{ var.id }}", nil)
		}
	}
{% endif %}
{% elif var.content %}
{% if (var.content | trim) is startingwith('<') %}
	_ = engine.SetVariable(sessionID, "{{ var.id }}", `{{ var.content }}`)
{% else %}
	{
		result, err := engine.EvaluateExpression(sessionID, `{{ var.content | to_lua_data_content }}`)
		if err == nil {
			_ = engine.SetVariable(sessionID, "{{ var.id }}", result)
		} else {
			_ = engine.SetVariable(sessionID, "{{ var.id }}", `{{ var.content | normalize_ws }}`)
		}
	}
{% endif %}
{% else %}
	_ = engine.SetVariable(sessionID, "{{ var.id }}", nil)
{% endif %}
{% endmacro %}

// InitializeDataModel establishes the script session, then initializes the
// datamodel in it (W3C SCXML 5.3), raising error.execution for a `<data>` or a
// top-level `<script>` that fails. Called from Engine.Initialize and
// Engine.EnterAt, the first step of either, before any state is entered.
//
// It is the one place a session is made (establishScriptSession), and a
// session that cannot be established is its answer: nothing of the datamodel is
// touched and the start is refused (docs/adr/0096). The order after it is the
// document's: its `<data>`, then the invoke params its parent handed it, then
// its top-level `<script>`.
func (p *{{ machine_name }}Policy) InitializeDataModel(eng *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event]) *sce.ScriptSessionFailure {
	if !p.scriptEngineInitialized {
		if failure := p.establishScriptSession(); failure != nil {
			return failure
		}
	}
	engine := p.ScriptEngine
	sessionID := p.SessionID

	// `_sessionid` and `_name` are bound by `establishScriptSession`, through
	// `SetupSystemVariables`; they are system variables, which a write by name
	// cannot change (§scxml-5.10), so writing them again here would be refused.

	// W3C SCXML 5.3.3: Initialize global datamodel variables
{% for var in model.variables %}
{% if var.src %}
{% set src_file = var.src | replace("file:", "") %}
	// W3C SCXML 5.3.1: Load {{ var.id }} from src="{{ var.src }}"
	{
		basePath := filepath.Join("..", "..", "..", "..", "..", "{{ model.scxml_base_path }}")
		if srcData, err := sce.LoadFileContent(filepath.Join(basePath, "{{ src_file }}")); err == nil {
			sce.InitializeVariableFromContent(engine, sessionID, "{{ var.id }}", srcData)
		}
	}
{% elif var.expr %}
{% set is_function_expr = (var.expr | trim) is startingwith('function') %}
{% if is_function_expr %}
	// W3C SCXML B.2: Function expression for {{ var.id }}
	if err := engine.ExecuteScript(sessionID, `{{ var.id }} = {{ var.expr | to_lua_expr }}`); err != nil {
{% if 'error.execution' in model.events %}
		eng.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id }}'> function expression failed"))
{% endif %}
	}
{% else %}
	// W3C SCXML 5.2/5.3: Initialize {{ var.id }} from expr="{{ var.expr }}"
	{
		result, err := engine.EvaluateExpression(sessionID, `{{ var.expr | to_lua_expr }}`)
		if err == nil {
			_ = engine.SetVariable(sessionID, "{{ var.id }}", result)
		} else {
{% if 'error.execution' in model.events %}
			eng.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "<data id='{{ var.id }}'> expr failed to evaluate"))
{% endif %}
			_ = engine.SetVariable(sessionID, "{{ var.id }}", nil)
		}
	}
{% endif %}
{% elif var.content %}
{% if (var.content | trim) is startingwith('<') %}
	// W3C SCXML B.2: XML inline content for {{ var.id }}
	_ = engine.SetVariableAsDOM(sessionID, "{{ var.id }}", `{{ var.content }}`)
{% else %}
	// W3C SCXML B.2: Inline content for {{ var.id }} (eval with string fallback)
	{
		result, err := engine.EvaluateExpression(sessionID, `{{ var.content | to_lua_data_content }}`)
		if err == nil {
			_ = engine.SetVariable(sessionID, "{{ var.id }}", result)
		} else {
			_ = engine.SetVariable(sessionID, "{{ var.id }}", `{{ var.content | normalize_ws }}`)
		}
	}
{% endif %}
{% elif var.type == 'runtime' %}
	// W3C SCXML 5.2: Runtime variable {{ var.id }} (init to nil)
	_ = engine.SetVariable(sessionID, "{{ var.id }}", nil)
{% endif %}
{% endfor %}

{% if model.binding == 'early' %}
{% for state_id, state in model.states | dictsort %}
{% if state.datamodel %}
	// W3C SCXML 5.3: Early binding - Initialize state {{ state_id }} datamodel
{% for var in state.datamodel %}
{{ bind_state_data_var(var) }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

	// §scxml-6.4.3: apply the invoke params the parent staged — overriding the
	// `<data>` default this block just seeded, and only for a name the child
	// declares ("if the names do not match, the Processor MUST NOT add the
	// value ... to the invoked session's data model"). `HasVariable` is that
	// filter, and it is this channel's only copy of the rule. They are applied
	// before the top-level `<script>`, which reads the datamodel the invocation
	// started it with. The parent hands them before this session's start
	// (`SetParamValueInScriptEngine`) and this session applies them, so a
	// child's session is made by the child.
	if len(p.pendingParams) > 0 {
		for paramName, paramValue := range p.pendingParams {
			if engine.HasVariable(sessionID, paramName) {
				_ = engine.SetVariable(sessionID, paramName, paramValue)
			}
		}
		p.pendingParams = nil
	}

{% if model.global_scripts %}
	// W3C SCXML 5.8: Execute global scripts at document load time
{% for script in model.global_scripts %}
	if err := engine.ExecuteScript(sessionID, `{{ script.content | to_lua_script }}`); err != nil {
{% if 'error.execution' in model.events %}
		eng.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, "a top-level <script> failed to execute"))
{% endif %}
	}
{% endfor %}
{% endif %}
	return nil
}
{% set late = namespace(any=false) %}
{% for state_id, state in model.states | dictsort %}{% if state.datamodel %}{% set late.any = true %}{% endif %}{% endfor %}
{% if model.binding == 'late' and late.any %}

// bindStateData binds one state's <data> — what late binding runs on the
// state's first entry (§scxml-D-enterStates: `if binding == "late" and
// s.isFirstEntry`). The engine decides WHEN (ClaimLateBindingFirstEntry);
// this is only WHAT, the same per-variable binding early binding runs at load.
func (p *{{ machine_name }}Policy) bindStateData(state {{ machine_name }}State, eng *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event]) {
	p.assertScriptSession()
	engine := p.ScriptEngine
	sessionID := p.SessionID
	switch state {
{% for state_id, state in model.states | dictsort %}
{% if state.datamodel %}
	case {{ machine_name }}State{{ state_id | to_state_variant }}:
{% for var in state.datamodel %}
{{ bind_state_data_var(var) }}
{% endfor %}
{% endif %}
{% endfor %}
	}
}
{% endif %}

// evaluateGuard evaluates a guard condition via script engine.
// W3C SCXML 4.3.2: If a condition expression cannot be evaluated, the processor
// MUST treat it as false and MUST raise error.execution.
func (p *{{ machine_name }}Policy) evaluateGuard(guard string, eng *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event]) bool {
	value, _ := p.evaluateGuardRaising(guard, eng, "a <transition> cond failed to evaluate")
	return value
}

// evaluateIfCond evaluates an <if> or <elseif> cond as evaluateGuard does, and
// also records a failure in condFailed. W3C SCXML 5.9.1 + 4.9: the <if> still
// selects on false, and is then the element whose processing raised, so its
// block ends after it.
func (p *{{ machine_name }}Policy) evaluateIfCond(guard string, eng *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event], condFailed *bool) bool {
	value, ok := p.evaluateGuardRaising(guard, eng, "an <if> cond failed to evaluate")
	if !ok {
		*condFailed = true
	}
	return value
}

// evaluateGuardRaising evaluates a cond, raising error.execution when it cannot
// be evaluated (W3C SCXML 5.9.1); ok is false then, where a bare false could
// not say so.
func (p *{{ machine_name }}Policy) evaluateGuardRaising(guard string, eng *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event], reason string) (value bool, ok bool) {
	p.assertScriptSession()
	engine := p.ScriptEngine
	result, err := engine.EvaluateExpression(p.SessionID, guard)
	if err != nil {
{% if 'error.execution' in model.events %}
		eng.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, reason))
{% endif %}
		return false, false
	}
	return sce.ScriptToBool(result), true
}

// executeScript executes a script block via script engine.
func (p *{{ machine_name }}Policy) executeScript(script string) error {
	p.assertScriptSession()
	engine := p.ScriptEngine
	return engine.ExecuteScript(p.SessionID, script)
}

// setCurrentEvent binds _event system variable (W3C SCXML 5.10) and answers
// which rung of §scxml-B-2-8-1 the payload got, because the binding is the
// only place that knows.
//
// This used to be `_ = engine.SetCurrentEvent(...)`: the ladder decided
// between a DOM, a value and a space-normalized string, and the decision was
// dropped one line later. A payload that announced structure and would not
// parse therefore reached the document as raw characters, every
// _event.data.<field> read empty, and nothing anywhere could say so — see
// sce.PayloadReading.
func (p *{{ machine_name }}Policy) setCurrentEvent(name string) sce.PayloadReading {
	p.assertScriptSession()
	engine := p.ScriptEngine
{% if model.needs_event_data %}
	data := p.pendingEventData
{% else %}
	data := ""
{% endif %}
{% if model.needs_event_type %}
	eventType := p.pendingEventType
{% else %}
	eventType := ""
{% endif %}
{% if model.needs_event_sendid %}
	sendID := p.pendingEventSendid
{% else %}
	sendID := ""
{% endif %}
{% if model.needs_event_origin or model.needs_event_origintype %}
	// W3C SCXML 5.10.1 + C.1: `_event.origin` and `_event.origintype` are the
	// one pair the processor that delivered the event wrote when it built it
	// (docs/adr/0090) — the sender's published `_ioprocessors` location for a
	// session's send — read here as they are, and both empty for none.
	// Nothing converts at this boundary, so every backend answers the same.
	origin := p.pendingEventOrigin.Address()
	originType := p.pendingEventOrigin.Processor()
{% else %}
	origin := ""
	originType := ""
{% endif %}
{% if model.needs_event_invokeid %}
	invokeID := p.pendingEventInvokeid
{% else %}
	invokeID := ""
{% endif %}
	reading, err := engine.SetCurrentEvent(p.SessionID, sce.SetCurrentEventArgs{
		Name:       name,
		Data:       data,
		Type:       eventType,
		SendID:     sendID,
		Origin:     origin,
		OriginType: originType,
		InvokeID:   invokeID,
	})
	if err != nil {
		// An engine that could not bind _event at all has a larger problem
		// than an unreadable payload, and reporting PayloadUndecodable for it
		// would point a host at the wrong thing.
		return sce.PayloadAbsent
	}
	return reading
}

// assignVariable assigns a value to a datamodel variable via script engine.
func (p *{{ machine_name }}Policy) assignVariable(location, expr string) error {
	p.assertScriptSession()
	engine := p.ScriptEngine
	script := location + " = " + expr
	return engine.ExecuteScript(p.SessionID, script)
}
{% if model.needs_idlocation_store %}

// storeIDInLocation writes a generated id to an `idlocation` (W3C SCXML
// 6.2.4, 6.4.1). The location is a location expression, so this is the
// assignment `<assign>` makes: luaLocation is already lowered, so a member
// path lands, and the error is the caller's to report as error.execution
// (W3C SCXML 5.9.2). The id is quoted here because an invoke's is a run-time
// value.
func (p *{{ machine_name }}Policy) storeIDInLocation(luaLocation, id string) error {
	return p.assignVariable(luaLocation, sce.QuoteLuaString(id))
}
{% endif %}

// getVariable reads a datamodel variable from the script engine.
func (p *{{ machine_name }}Policy) getVariable(name string) interface{} {
	p.assertScriptSession()
	engine := p.ScriptEngine
	result, err := engine.GetVariable(p.SessionID, name)
	if err != nil {
		return nil
	}
	return result
}

// SetParamValueInScriptEngine stores an invoke param's VALUE for deferred
// application after datamodel init (§scxml-6.4.3).
//
// Params are applied by InitializeDataModel after the `<data>` and before the
// top-level `<script>`, overriding the `<data>` default only for names the
// child declares, so the session they are applied in is the child's own,
// established by its start (docs/adr/0096). The value crosses as a
// value: this took the parent's value rendered as Lua source and
// re-evaluated it here until 2026-08-21, which survived every value a test
// had tried and lost the ones Lua cannot spell — `ToScriptLiteral` renders a
// non-finite number as `+Inf`, which is not a Lua expression, so an
// `<invoke>` `<param expr="1/0"/>` arrived as nothing at all.
func (p *{{ machine_name }}Policy) SetParamValueInScriptEngine(name string, value interface{}) {
	if p.pendingParams == nil {
		p.pendingParams = make(map[string]interface{})
	}
	p.pendingParams[name] = value
}
{% else %}
// No script engine needed for this state machine, so it has no script session
// to fail and its start is never refused for one.
func (p *{{ machine_name }}Policy) InitializeDataModel(eng *sce.Engine[{{ machine_name }}State, {{ machine_name }}Event]) *sce.ScriptSessionFailure {
	return nil
}

// SetParamValueInScriptEngine is a no-op for state machines without script engine.
func (p *{{ machine_name }}Policy) SetParamValueInScriptEngine(name string, value interface{}) {}
{% endif %}
