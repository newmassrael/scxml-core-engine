{#
    State Machine Implementation Template (.inl)

    This template generates the method implementations for the Policy struct.
    The output is #include'd from the corresponding _sm.h file inside the struct body.

    DO NOT include the output .inl file directly - it is part of the Policy struct.

    Contents:
    - getInitialChildren(), getInitialChild(), getInitialOrHistoryChild()
    - enterDeepInitialTargets_XXX() per compound state
    - Parallel state methods (if applicable)
    - Entry/exit action implementations (entry_exit_actions.jinja2)
    - Invoke lifecycle methods (invoke_methods.jinja2)
    - Transition processing (process_transition.jinja2)
    - Script engine helpers (scriptengine_helpers.jinja2)
    - Utility methods (utility_methods.jinja2)
#}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
    // Watching-zenoh RFC §synth-5-O: SCE-MAP marker anchoring
    // these method implementations to the `<scxml>` root position.
    {{ sce_map.source_marker(model.source_location, "cpp", module_level=true) }}

    // ============================================================================
    // {{ model.name }}Policy method implementations
    // Generated by SCE Code Generator - DO NOT include directly
    // This file is #include'd from the corresponding _sm.h inside the struct body
    // ============================================================================

    // W3C SCXML 3.6: Get initial children of compound state (supports space-separated descendant targets)
    static std::vector<State> getInitialChildren(State state) {
        switch (state) {
        {% for state_id, state in model.states | dictsort %}
        {% if state.initial_children %}
        case State::{{ state_id | capitalize }}:
            return {
                {%- for child in state.initial_children -%}
                State::{{ child | capitalize }}{{ ", " if not loop.last else "" }}
                {%- endfor -%}
            };
        {% endif %}
        {% endfor %}
        default:
            return {};  // Not compound or no initial child
        }
    }

    // W3C SCXML 3.3: Get single initial child (backward compatibility - returns first child)
    static State getInitialChild(State state) {
        auto children = getInitialChildren(state);
        return children.empty() ? state : children[0];
    }

    // W3C SCXML 3.11: Get initial or history-restored child of compound state
    // Non-static version that checks history before returning initial child
    State getInitialOrHistoryChild(State state) const {
        switch (state) {
        {% for state_id, state in model.states | dictsort %}
        {% if state.initial_history_id %}
        case State::{{ state_id | capitalize }}:
            // W3C SCXML 3.11: Check history for {{ state.initial_history_id }}
            if (history_{{ state.initial_history_id }}.has_value() && !history_{{ state.initial_history_id }}->empty()) {
                return history_{{ state.initial_history_id }}->front();  // Restore to first state in history
            }
            return getInitialChild(State::{{ state_id | capitalize }});  // No history, use default
        {% elif state.initial_children %}
        case State::{{ state_id | capitalize }}:
            return getInitialChild(State::{{ state_id | capitalize }});
        {% endif %}
        {% endfor %}
        default:
            return state;  // Not compound or no initial child
        }
    }

    // W3C SCXML 3.6: Enter deep initial targets (delegate to StateEntryHelper)
    {% for state_id, state in model.states | dictsort %}
    {% if state.initial_children and state.initial_children|length > 0 %}
    template <typename Engine>
    void enterDeepInitialTargets_{{ state_id | capitalize }}(Engine& engine) {
        // W3C SCXML 3.6: Deep initial targets for {{ state_id }}: initial="{{ state.initial }}"
        // Delegate to StateEntryHelper (ARCHITECTURE.md Zero Duplication Principle)
        auto targets = getInitialChildren(State::{{ state_id | capitalize }});

        // W3C SCXML 3.6: Use StateEntryHelper as Single Source of Truth
        ::SCE::Core::StateEntryHelper::enterDeepTargets<State>(
            State::{{ state_id | capitalize }},
            targets,
            [](State s) -> std::optional<State> { return {{ model.name }}Policy::getParent(s); },
            [this, &engine](State s) { this->executeEntryActions(s, engine); }
        );
    }
    {% endif %}
    {% endfor %}

{% if model.has_parallel_states %}
    // W3C SCXML 3.4: Check if state is a parallel state
    static bool isParallelState(State state) {
        switch (state) {
        {% for state_id, state in model.states | dictsort %}
        {% if state.is_parallel %}
        case State::{{ state_id | capitalize }}:
            return true;
        {% endif %}
        {% endfor %}
        default:
            return false;
        }
    }

    // W3C SCXML 3.4: Get child regions of a parallel state
    static ::std::vector<State> getParallelRegions(State state) {
        switch (state) {
        {% for parallel_id, regions in model.parallel_regions | dictsort %}
        case State::{{ parallel_id | capitalize }}:
            return { {% for region in regions %}State::{{ region | capitalize }}{{ ", " if not loop.last }}{% endfor %} };
        {% endfor %}
        default:
            return {};
        }
    }

    // W3C SCXML 3.4: Check if descendant is a descendant of ancestor
    // ARCHITECTURE.MD: Zero Duplication - delegates to HierarchicalStateHelper
    static bool isDescendantOf(State descendant, State ancestor) {
        return ::SCE::Core::HierarchicalStateHelper<{{ model.name }}Policy>::isDescendantOf(descendant, ancestor);
    }

    // W3C SCXML 3.13: Get document order for exit order tie-breaking
    static int getDocumentOrder(State state) {
        switch (state) {
        {% for state_id, state in model.states | dictsort %}
        case State::{{ state_id | capitalize }}:
            return {{ state.document_order }};
        {% endfor %}
        default:
            return 0;
        }
    }
{% endif %}

{% include 'entry_exit_actions.jinja2' %}

{% include 'invoke_methods.jinja2' %}

    {% include 'process_transition.jinja2' %}

public:
    {# SCE_MESH.md §9.6.2 — parent with only remote `<invoke type="scxml">`  #}
    {# still needs `ensureSessionId()` so `sessionId_.has_value()` calls in    #}
    {# the remote-invoke onentry block compile. Mirrors the paired field      #}
    {# declaration in `state_machine.jinja2` (`or model.invokes | scxml_remote`). #}
    {% if model.needs_script_engine or model.invokes | scxml or model.invokes | hybrid or model.invokes | scxml_remote %}
    {% include 'scriptengine_helpers.jinja2' %}
    {% endif %}

    {% include 'utility_methods.jinja2' %}

private:
