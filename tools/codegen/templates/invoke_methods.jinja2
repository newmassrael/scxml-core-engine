{#
    Invoke Methods Template (C++ Jinja2)

    W3C SCXML 6.4: Invoke lifecycle — execute pending, tick children, autoforward, finalize.

    Extracted from entry_exit_actions.jinja2 and utility_methods.jinja2 to match the Rust
    invoke_methods.rs.jinja2 separation of concerns pattern.

    Contains:
    - executePendingInvokes()           — execute deferred invokes at macrostep end
    - tickChildren()                    — tick active child state machines
    - forwardToAutoforwardChildren()    — W3C SCXML 6.4.6 event forwarding
    - executeFinalizeForChildEvent()    — W3C SCXML 6.5 finalize execution
#}
{% if (model.invokes | scxml_family) or (model.invokes | scxml_remote) %}

    // W3C SCXML 6.4: Execute pending invokes at macrostep end
    // Uses InvokeHelper defer/cancel/execute pattern (ARCHITECTURE.md Zero Duplication).
    // Remote `<invoke type="scxml">` (SCE_MESH.md §9.6) does not go through
    // the defer queue — wire-14 `InvokeStart` is emitted eagerly from
    // `entry_exit_actions.jinja2` onentry and the activeInvokes_ entry is
    // registered synchronously. Only local scxml and hybrid invokes accumulate
    // in `pendingInvokes_`, so this method still iterates `| scxml` (local) /
    // `| hybrid` exclusively.
    template <typename Engine>
    void executePendingInvokes(Engine& engine) {

        if (pendingInvokes_.empty()) {
            return;
        }

        AOT_DEBUG("Executing {} pending invokes at macrostep end", pendingInvokes_.size());

        // W3C SCXML 6.4: Use InvokeHelper as Single Source of Truth
        ::SCE::Core::InvokeHelper::executePendingInvokes(
            pendingInvokes_,
            [this, &engine](const PendingInvoke& pending) {
                AOT_DEBUG("Executing pending invoke: {} in state {}", pending.invokeId, static_cast<int>(pending.state));

                // Switch on state to find which invoke to execute
                {% for state_id, state in model.states | dictsort %}
                {% if state.invokes | scxml %}
                if (pending.state == State::{{ state_id | capitalize }}) {
                    {% for invoke_info in state.invokes | scxml %}
                    // W3C SCXML 3.12.1: Match runtime-generated invoke ID (stateid.platformid.index format)
                    // Full ID example: "s0.123456789._invoke_0" where 123456789 is runtime platformid (pointer address)
                    // Match on "._invoke_0" suffix to identify this invoke - substring matching required because platformid is runtime-only
                    if (pending.invokeId.find(".{{ invoke_info.invoke_id }}") != std::string::npos) {
                        {% if invoke_info.namelist %}
                        // W3C SCXML 6.4.1: Namelist handling - validate and pass values to child
                        std::map<std::string, std::vector<std::string>> namelistParams;

                        // Step 1: Validate namelist variables before creating child
                        {
                            ensureScriptEngine();
                            auto& scriptEngine = getScriptEngine();

                            bool namelistValid = ::SCE::NamelistHelper::evaluateNamelist(
                                scriptEngine,
                                sessionId_.value(),
                                "{{ invoke_info.namelist }}",
                                namelistParams,
                                [&engine](const std::string& errorMsg) {
                                    SCE_LOG_ERROR("Namelist evaluation failed for invoke {{ invoke_info.invoke_id }}: {}", errorMsg);
                                    // W3C SCXML 6.4.1: Raise error.execution on namelist error
                                    engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, errorMsg));
                                }
                            );

                            if (!namelistValid) {
                                // W3C SCXML 6.4.1: Invoke cancelled due to namelist validation failure
                                AOT_DEBUG("Skipping invoke {{ invoke_info.invoke_id }} due to namelist validation failure");
                                return;  // Skip this invoke - don't create child
                            }

                            AOT_DEBUG("Namelist validation passed for invoke {{ invoke_info.invoke_id }}");
                        }
                        {% endif %}

                        // W3C SCXML 6.4: Instantiate and initialize child state machine
                        AOT_DEBUG("Creating child state machine: {{ invoke_info.child_name }} for invoke {{ invoke_info.invoke_id }}");

                        // W3C SCXML 6.5: Generate child session ID for finalize origin matching
                        // Format: "parentSessionId.invokeId" (e.g., "session123._invoke_0")
                        std::string childSessionId = (sessionId_.has_value() ? sessionId_.value() : "") + "." + pending.invokeId;

                        // Create child instance with parent pointer, invokeId, and childSessionId.
                        //
                        // SCE_MESH §14 arch-debt #4 caveat: this namespace
                        // reference is partition-naive — it assumes the
                        // child machine emits its SM class into the flat
                        // `SCE::Generated::<child_name>` shape, not the
                        // partitioned `SCE::Generated::<child_name>::P_<p>`
                        // shape. Cross-partition `<invoke>` (a partitioned
                        // machine spawned via `<invoke type="scxml">`) is
                        // not a current consumer, so the partition-aware
                        // form would be untested code. When a consumer
                        // arrives, thread `invoke_info.child_partition`
                        // through the model and gate the `::P_<part>`
                        // segment here.
                        child_{{ invoke_info.field_suffix }}_ = std::make_shared<::SCE::Generated::{{ invoke_info.child_name }}::{{ invoke_info.child_name }}<SelfType>>(self_, pending.invokeId, childSessionId);

                        // W3C SCXML B.1: Forward the build-configured script engine
                        // to the child BEFORE namelist/params evaluation. The
                        // child's setParamInScriptEngine() and downstream
                        // initialize() both consult Policy::getScriptEngine(),
                        // which throws when unset. Aliasing shared_ptr + no-op
                        // deleter: lifetime is owned by ScriptEngineProvider.
                        {% if invoke_info.child_needs_script_engine %}
                        child_{{ invoke_info.field_suffix }}_->setScriptEngine(::std::shared_ptr<::SCE::IScriptEngine>(
                            &::SCE::ScriptEngineProvider::getScriptEngine(),
                            [](::SCE::IScriptEngine*){}));
                        {% endif %}

                        {% if invoke_info.namelist %}
                        // W3C SCXML 6.4.1: Pass namelist values to child datamodel (Step 2)
                        {% if invoke_info.child_needs_script_engine %}
                        // W3C SCXML 6.3.2: Child datamodel variables for validation
                        // ARCHITECTURE.md Zero Duplication: Matches InvokeExecutor.cpp:322-359 logic
                        static const std::set<std::string> childDatamodelVars_{{ invoke_info.invoke_id }} = DatamodelValidationHelper::buildChildDatamodelSet({{ '{' }}{% for var in invoke_info.child_datamodel_vars %}"{{ var }}"{{ ", " if not loop.last }}{% endfor %}{{ '}' }});

                        for (const auto& [varName, values] : namelistParams) {
                            // W3C SCXML 6.3.2: Only set variable if it exists in child's datamodel
                            if (!DatamodelValidationHelper::isVariableDeclaredInChild(varName, childDatamodelVars_{{ invoke_info.invoke_id }})) {
                                AOT_DEBUG("Skipping namelist variable '{}' - not defined in child's datamodel", varName);
                                continue;
                            }

                            if (!values.empty()) {
                                AOT_DEBUG("Setting namelist variable '{}' = '{}' in child {{ invoke_info.invoke_id }}", varName, values[0]);
                                child_{{ invoke_info.field_suffix }}_->setParamInScriptEngine(varName, values[0]);
                            }
                        }
                        {% else %}
                        // Child does not use JSEngine - namelist handled via static datamodel
                        AOT_DEBUG("Namelist variables - child uses static datamodel");
                        {% endif %}
                        {% endif %}

                        {% if invoke_info.params %}
                        // W3C SCXML 6.4.1: Pass params to child datamodel before initialization
                        {% for param in invoke_info.params %}
                        {% if invoke_info.child_needs_script_engine %}
                        child_{{ invoke_info.field_suffix }}_->setParamInScriptEngine("{{ param.name }}", "{{ param.expr }}");
                        {% else %}
                        // Child does not use JSEngine - params handled via static datamodel
                        AOT_DEBUG("Param {{ param.name }}={{ param.expr }} - child uses static datamodel");
                        {% endif %}
                        {% endfor %}
                        {% endif %}

                        // W3C SCXML 6.4.6: Track active invoke session BEFORE initialize
                        // Child may send events during initialize() that need autoforward
                        // SCE_MESH.md §16.7 row 5 sub-atomic C — activeInvokes_
                        // is shared with peer-down callback threads; engine-
                        // thread writes also hold activeInvokesMutex_.
                        {
                            std::lock_guard<std::mutex> __sce_active_invokes_lk(activeInvokesMutex_);
                            activeInvokes_["{{ invoke_info.invoke_id }}"] = ChildSession{
                                childSessionId,  // W3C SCXML 6.5: Child session ID for finalize origin matching
                                "{{ invoke_info.invoke_id }}",
                                sessionId_.has_value() ? sessionId_.value() : "",  // Parent session ID
                                {{ 'true' if invoke_info.autoforward else 'false' }},  // W3C SCXML 6.4.6: autoforward
                                "{{ invoke_info.finalize_content | replace('"', '\"') }}"  // W3C SCXML 6.5: finalize
                            };
                        }

                        // W3C SCXML 6.4: Register completion callback BEFORE initialize
                        // Child may reach final state during initialize() and needs callback ready
                        child_{{ invoke_info.field_suffix }}_->setCompletionCallback([this]() {
                            // W3C SCXML 6.4: Send done.invoke immediately (matches Interpreter logic - test 236)
                            // Interpreter sends done.invoke in completion callback, not deferred
                            AOT_DEBUG("Child state machine {{ invoke_info.invoke_id }} completed, sending done.invoke");

                            // Mark as completed (for Cancel_invoke logic - test 236)
                            pendingDoneInvoke_{{ invoke_info.invoke_id }}_ = true;

                            // W3C SCXML 5.5 + 6.3.1: lift the child's donedata payload onto
                            // `done.invoke.<id>._event.data` — stashed on the child engine at
                            // top-level `<final>` entry by `entry_exit_actions.jinja2` via
                            // `stashDonedataAtFinal`. typedData is forwarded in-process to
                            // skip the JSON round-trip; the mesh §9.6.2 wire-18 path instead
                            // rebuilds typedData from `data` bytes on the parent side.
                            // ARCHITECTURE.md Zero Duplication: Single Source of Truth for event metadata
                            // Send done.invoke to external queue (matches Interpreter event ordering)
                            self_->raiseExternal(::SCE::Common::EventMetadataHelper::createDoneInvokeEvent<
                                typename SelfType::Event, typename SelfType::EventWithMetadata>(
                                {% if invoke_info.use_specific_event %}Event::Done_invoke_{{ invoke_info.invoke_id }}{% else %}Event::Done_invoke{% endif %},
                                "{{ invoke_info.invoke_id }}",
                                child_{{ invoke_info.field_suffix }}_->donedataAtFinal(),
                                child_{{ invoke_info.field_suffix }}_->typedDonedataAtFinal()
                            ));
                        });

                        // W3C SCXML 6.4: Initialize child state machine
                        child_{{ invoke_info.field_suffix }}_->initialize();

                        // activeInvokes_ already registered above BEFORE initialize()
                        // This ensures child events during initialize() can use autoforward

                        AOT_DEBUG("Child state machine {{ invoke_info.invoke_id }} initialized and running");
                        return;  // Found and executed the invoke
                    }
                    {% endfor %}
                }
                {% endif %}
                {% if state.invokes | hybrid %}
                if (pending.state == State::{{ state_id | capitalize }}) {
                    {% for invoke_info in state.invokes | hybrid %}
                    if (pending.invokeId.find(".{{ invoke_info.invoke_id }}") != std::string::npos) {
                        // W3C SCXML 6.4: Hybrid invoke — evaluate expression, then run pre-generated AOT child
                        {% if invoke_info.srcexpr %}
                        // W3C SCXML 6.4.3: Evaluate srcexpr at runtime (validation only — child is pre-generated AOT)
                        {
                            ensureScriptEngine();
                            auto& scriptEngine = getScriptEngine();
                            auto pathResult = scriptEngine.evaluateExpression(sessionId_.value(), "{{ invoke_info.srcexpr }}").get();
                            if (!::SCE::ScriptResultUtils::isSuccess(pathResult)) {
                                SCE_LOG_ERROR("Hybrid invoke: srcexpr '{{ invoke_info.srcexpr }}' evaluation failed");
                                engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, "srcexpr evaluation failed"));
                                return;
                            }
                            // `.template getValue<T>()`: `pathResult` is `auto`-deduced
                            // inside this class-template member, so gcc 13.3 with
                            // `-Werror=missing-template-keyword` treats `getValue` as a
                            // dependent member template and requires the disambiguator —
                            // even though `ScriptResult` is a non-template type
                            // (`sce/include/scripting/ScriptResult.h:61` `template <typename T>
                            // T getValue() const`). Older gcc accepted the bare form silently.
                            AOT_DEBUG("Hybrid invoke: srcexpr evaluated to {}", pathResult.template getValue<std::string>());
                        }
                        {% elif invoke_info.contentexpr %}
                        // W3C SCXML 6.4.4: Evaluate contentexpr at runtime (validation only — child is pre-generated AOT)
                        {
                            ensureScriptEngine();
                            auto& scriptEngine = getScriptEngine();
                            auto contentResult = scriptEngine.evaluateExpression(sessionId_.value(), "{{ invoke_info.contentexpr }}").get();
                            if (!::SCE::ScriptResultUtils::isSuccess(contentResult)) {
                                SCE_LOG_ERROR("Hybrid invoke: contentexpr '{{ invoke_info.contentexpr }}' evaluation failed");
                                engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, "contentexpr evaluation failed"));
                                return;
                            }
                            AOT_DEBUG("Hybrid invoke: contentexpr evaluated successfully");
                        }
                        {% endif %}

                        // W3C SCXML 6.5: Generate child session ID
                        std::string childSessionId = (sessionId_.has_value() ? sessionId_.value() : "") + "." + pending.invokeId;

                        // W3C SCXML 6.4: Create pre-generated AOT child (pure AOT — no Interpreter dependency).
                        // SCE_MESH §14 arch-debt #4 caveat: partition-naive
                        // namespace ref — see the sibling create-child site
                        // above for the lift path when a partitioned child
                        // becomes a consumer.
                        child_{{ invoke_info.field_suffix }}_ = std::make_shared<::SCE::Generated::{{ invoke_info.child_name }}::{{ invoke_info.child_name }}<SelfType>>(self_, pending.invokeId, childSessionId);

                        // W3C SCXML B.1: Forward the build-configured script
                        // engine to the child before initialize() — generated
                        // Policy::getScriptEngine() throws when unset.
                        {% if invoke_info.child_needs_script_engine %}
                        child_{{ invoke_info.field_suffix }}_->setScriptEngine(::std::shared_ptr<::SCE::IScriptEngine>(
                            &::SCE::ScriptEngineProvider::getScriptEngine(),
                            [](::SCE::IScriptEngine*){}));
                        {% endif %}

                        // W3C SCXML 6.4.6: Track active invoke session
                        // SCE_MESH.md §16.7 row 5 sub-atomic C — same shared-
                        // access discipline as the scxml-local insert above.
                        {
                            std::lock_guard<std::mutex> __sce_active_invokes_lk(activeInvokesMutex_);
                            activeInvokes_["{{ invoke_info.invoke_id }}"] = ChildSession{
                                childSessionId,
                                "{{ invoke_info.invoke_id }}",
                                sessionId_.has_value() ? sessionId_.value() : "",
                                {{ 'true' if invoke_info.autoforward else 'false' }},
                                ""  // No finalize for hybrid invokes
                            };
                        }

                        // W3C SCXML 6.4: Register completion callback BEFORE initialize
                        child_{{ invoke_info.field_suffix }}_->setCompletionCallback([this]() {
                            AOT_DEBUG("Hybrid child {{ invoke_info.invoke_id }} completed, sending done.invoke");
                            pendingDoneInvoke_{{ invoke_info.invoke_id }}_ = true;
                            // W3C SCXML 5.5 + 6.3.1: lift the hybrid child's donedata payload
                            // onto `done.invoke.<id>._event.data`. Same single-source stash as
                            // the scxml local path — `stashDonedataAtFinal` on
                            // `StaticExecutionEngine` — so the hybrid consumer stays identical.
                            self_->raiseExternal(::SCE::Common::EventMetadataHelper::createDoneInvokeEvent<
                                typename SelfType::Event, typename SelfType::EventWithMetadata>(
                                {% if invoke_info.use_specific_event %}Event::Done_invoke_{{ invoke_info.invoke_id }}{% else %}Event::Done_invoke{% endif %},
                                "{{ invoke_info.invoke_id }}",
                                child_{{ invoke_info.field_suffix }}_->donedataAtFinal(),
                                child_{{ invoke_info.field_suffix }}_->typedDonedataAtFinal()
                            ));
                        });

                        // W3C SCXML 6.4: Initialize child state machine
                        child_{{ invoke_info.field_suffix }}_->initialize();

                        AOT_DEBUG("Hybrid AOT child {{ invoke_info.invoke_id }} initialized and running");
                        return;
                    }
                    {% endfor %}
                }
                {% endif %}
                {% endfor %}

                // No matching static or hybrid invoke found
                SCE_LOG_ERROR("Pending invoke not found: {} in state {}", pending.invokeId, static_cast<int>(pending.state));
            }
        );

        AOT_DEBUG("All pending invokes executed");
    }

    // W3C SCXML 6.4: Tick all active child state machines to process their events
    // Child state machines need to run independently during parent's event loop
    template <typename Engine>
    void tickChildren([[maybe_unused]] Engine& engine) {
        {% for state_id, state in model.states | dictsort %}
        {% if state.invokes | scxml %}
        {% for invoke_info in state.invokes | scxml %}
        if (child_{{ invoke_info.field_suffix }}_) {
            child_{{ invoke_info.field_suffix }}_->tick();
        }
        {% endfor %}
        {% endif %}
        {% if state.invokes | hybrid %}
        {% for invoke_info in state.invokes | hybrid %}
        if (child_{{ invoke_info.field_suffix }}_) {
            child_{{ invoke_info.field_suffix }}_->tick();
        }
        {% endfor %}
        {% endif %}
        {% endfor %}
    }

    // W3C SCXML 6.4.6: Forward external events to children with autoforward=true
    // Called by StaticExecutionEngine::raiseExternal before enqueuing to parent.
    // Local invokes forward via `child_<suffix>_->raiseExternal`; remote
    // scxml invokes (SCE_MESH.md §9.6) forward via wire-17 `ParentEvent`
    // through the engine's registered callback.
    template <typename Engine>
    void forwardToAutoforwardChildren([[maybe_unused]] const std::string& eventName, [[maybe_unused]] Engine& engine) {

        {% for state_id, state in model.states | dictsort %}
        {% if state.invokes | scxml %}
        {% for invoke_info in state.invokes | scxml %}
        // Check if child {{ invoke_info.invoke_id }} has autoforward enabled
        {
            // SCE_MESH.md §16.7 row 5 sub-atomic C — snapshot autoforward
            // under activeInvokesMutex_ and release before delegating to
            // the child's `raiseExternal`. Holding our mutex across the
            // child's queue lock would risk nested-mutex ordering vs the
            // peer-down handler that also touches activeInvokes_. The
            // child pointer (`child_<suffix>_`) is a Policy member with
            // engine-thread-only lifetime, independent of activeInvokes_.
            bool __sce_autoforward_active = false;
            {
                std::lock_guard<std::mutex> __sce_active_invokes_lk(activeInvokesMutex_);
                auto it = activeInvokes_.find("{{ invoke_info.invoke_id }}");
                __sce_autoforward_active =
                    (it != activeInvokes_.end() && it->second.autoforward);
                AOT_DEBUG("AOT autoforward check: invokeId='{{ invoke_info.invoke_id }}', found={}, autoforward={}, childPtr={}",
                          (it != activeInvokes_.end()),
                          __sce_autoforward_active,
                          (child_{{ invoke_info.field_suffix }}_ != nullptr));
            }
            if (__sce_autoforward_active && child_{{ invoke_info.field_suffix }}_) {
                AOT_DEBUG("AOT autoforward: Forwarding event '{}' to child {{ invoke_info.invoke_id }}", eventName);
                // W3C SCXML 6.4.6: Forward by event name string to child
                // Child's raiseExternal(string) will convert to its Event enum and handle gracefully if not found
                child_{{ invoke_info.field_suffix }}_->raiseExternal(eventName);
            }
        }
        {% endfor %}
        {% endif %}
        {% if state.invokes | scxml_remote %}
        {% for invoke_info in state.invokes | scxml_remote %}
        // SCE_MESH.md §9.6.2 wire 17 — remote autoforward. Gate on
        // activeInvokes_ membership (wire-14 was accepted by the transport)
        // AND autoforward=true in the authored attribute. Empty sessionId
        // is tolerated here: wire-15 may not have landed yet when the first
        // external event arrives — the child's worker host has the session
        // ready to receive wire-17 either way because it was instantiated
        // at wire-14 dispatch.
        {
            // SCE_MESH.md §16.7 row 5 sub-atomic C — snapshot autoforward
            // under activeInvokesMutex_ and release before reaching into
            // the engine's mesh-send path. Same mutex-discipline rationale
            // as the local-scxml branch above; the peer-down callback may
            // be removing this entry concurrently with this read.
            bool __sce_autoforward_active = false;
            {
                std::lock_guard<std::mutex> __sce_active_invokes_lk(activeInvokesMutex_);
                auto it = activeInvokes_.find("{{ invoke_info.invoke_id }}");
                __sce_autoforward_active =
                    (it != activeInvokes_.end() && it->second.autoforward);
            }
            if (__sce_autoforward_active) {
                (void)engine.performScxmlInvokeParentEvent(
                    "{{ invoke_info.remote_mesh_target }}",
                    "{{ invoke_info.invoke_id }}",
                    eventName,
                    /*data*/ std::string(),
                    /*sendId*/ std::string());
            }
        }
        {% endfor %}
        {% endif %}
        {% endfor %}
    }

{% if (model.invokes | scxml) or (model.invokes | scxml_remote) %}
    // W3C SCXML 6.5: Execute finalize for events from invoked children
    // Finalize runs BEFORE the event is processed, with _event set to child's event.
    // Matches local and remote (SCE_MESH.md §9.6) invokes uniformly — the
    // parent's activeInvokes_[...].sessionId holds the child's session URI
    // for remote invokes (stamped by onInvokeStarted when wire-15 arrives)
    // and the local-parent-session-prefix.invokeId for local invokes.
    template <typename Engine>
    void executeFinalizeForChildEvent(const typename Engine::EventWithMetadata& eventWithMeta, [[maybe_unused]] Engine& engine) {

        // W3C SCXML 6.5: Only execute finalize for events from child invokes
        // origin field contains child's session ID
        if (eventWithMeta.origin.empty()) {
            return;  // Not from a child
        }

        // Find which invoke sent this event by matching child session ID.
        // SCE_MESH.md §16.7 row 5 sub-atomic C — snapshot matched invokeId
        // + finalize script under activeInvokesMutex_, release, then run
        // FinalizeHelper without the mutex held. FinalizeHelper enters
        // the script engine on the engine thread and may recurse into
        // raiseExternal; holding our mutex across that span would block
        // peer-down callbacks (and could trip nested-mutex ordering).
        std::string __sce_matched_invoke_id;
        std::string __sce_matched_finalize_script;
        {
            std::lock_guard<std::mutex> __sce_active_invokes_lk(activeInvokesMutex_);
            for (const auto& [invokeId, childSession] : activeInvokes_) {
                if (childSession.sessionId == eventWithMeta.origin && !childSession.finalizeScript.empty()) {
                    __sce_matched_invoke_id = invokeId;
                    __sce_matched_finalize_script = childSession.finalizeScript;
                    break;
                }
            }
        }
        if (!__sce_matched_invoke_id.empty()) {
            AOT_DEBUG("AOT finalize: Executing finalize for invoke '{}' before processing event", __sce_matched_invoke_id);

{% if model.needs_script_engine %}
            // W3C SCXML 6.5: Use FinalizeHelper (ARCHITECTURE.md Zero Duplication)
            // Single Source of Truth for finalize execution shared with Interpreter
            std::string eventName = this->getEventName(eventWithMeta.event);

            this->ensureScriptEngine();
            auto& scriptEngine = getScriptEngine();

            ::SCE::FinalizeHelper::executeFinalizeWithEvent(
                scriptEngine,
                sessionId_.value(),
                __sce_matched_finalize_script,
                eventName,
                eventWithMeta.data,
                eventWithMeta.sendId,
                eventWithMeta.origin,
                eventWithMeta.originType,
                eventWithMeta.invokeId
            );
{% else %}
            // Pure Static: finalize script should be empty (no ECMAScript expressions)
            SCE_LOG_WARN("AOT finalize: Finalize script present but JSEngine not available for invoke '{}'", __sce_matched_invoke_id);
{% endif %}
        }
    }
{% endif %}

{% if model.invokes | scxml_remote %}
    // SCE_MESH.md §9.6.2 wire-15 consumer — parent stashes the child's
    // session URI (§9.6.3 L1463 `_event.origin` source). Matched by
    // env.subject against the compile-time invoke_id emitted at wire-14
    // dispatch. Idempotent: a redundant wire-15 is silently replaced;
    // matching against an unregistered invoke_id (e.g. a stale envelope
    // arriving after onexit) is a no-op.
    void onInvokeStarted(const ::SCE::Mesh::MeshEnvelope& env) {
        if (!env.subject || !env.child_session_id) {
            AOT_DEBUG("AOT onInvokeStarted: envelope missing subject/child_session_id — drop");
            return;
        }
        // SCE_MESH.md §16.7 row 5 sub-atomic C — this hook runs on the
        // transport callback thread (Zenoh queryable / SOMEIP receive /
        // shm pump / custom_tcp Server receive), distinct from the
        // engine thread that drives every other activeInvokes_ access.
        // Hold activeInvokesMutex_ across the find + sessionId stamp so
        // a concurrent peer-down handler cannot erase the entry mid-
        // write, and so engine-thread autoforward/finalize readers
        // observe either the pre-wire-15 ChildSession (sessionId="")
        // or the fully-stamped row, never a torn write.
        std::lock_guard<std::mutex> __sce_active_invokes_lk(activeInvokesMutex_);
        auto it = activeInvokes_.find(*env.subject);
        if (it == activeInvokes_.end()) {
            AOT_DEBUG("AOT onInvokeStarted: no active invoke matching subject='{}' — drop", *env.subject);
            return;
        }
        it->second.sessionId = *env.child_session_id;
        AOT_DEBUG("AOT onInvokeStarted: bound invoke='{}' to child sessionId='{}'",
                  *env.subject, *env.child_session_id);
    }

    // SCE_MESH.md §9.6.2 wire-18 consumer — child reached <final>. Raise
    // the W3C `done.invoke.<id>` event and set the pending flag so the
    // paired onexit cancel suppresses a redundant wire-19. The envelope's
    // `data` bytes carry the child's `<donedata>` payload (W3C SCXML 5.5,
    // JSON-encoded by `DoneDataHelper` on the worker); we thread it onto
    // `_event.data` so `done.invoke.<id>` parity with the local-invoke
    // path is byte-for-byte. `typedData` is left unset — the parent's
    // `setPolicyMetadata` hydrates it via `jsonStringToScriptValue`.
    template <typename Engine>
    void onInvokeDone(const ::SCE::Mesh::MeshEnvelope& env, Engine& engine) {
        if (!env.subject) {
            AOT_DEBUG("AOT onInvokeDone: envelope missing subject — drop");
            return;
        }
        const std::string& subject = *env.subject;
        {% for invoke_info in model.invokes | scxml_remote %}
        if (subject == "{{ invoke_info.invoke_id }}") {
            pendingDoneInvoke_{{ invoke_info.invoke_id }}_ = true;
            std::string donedata(env.data.begin(), env.data.end());
            engine.raiseExternal(::SCE::Common::EventMetadataHelper::createDoneInvokeEvent<
                typename Engine::Event, typename Engine::EventWithMetadata>(
                {% if invoke_info.use_specific_event %}Engine::Event::Done_invoke_{{ invoke_info.invoke_id }}{% else %}Engine::Event::Done_invoke{% endif %},
                "{{ invoke_info.invoke_id }}",
                donedata
            ));
            // W3C §6.4.4/§6.4.5 + SCE_MESH.md §9.6.3: do NOT erase activeInvokes_
            // here. The entry must survive so any ChildEvent (wire-16) that
            // reached the external queue earlier in the same drain as this
            // wire-18 still matches by `sessionId == eventWithMeta.origin` in
            // `executeFinalizeForChildEvent`. Ordering in a single parent
            // macrostep: external queue contains [ping, done.invoke.X] →
            // finalize runs on ping → transition selection on ping → (next
            // event) done.invoke.X → transition selection → onexit of the
            // invoking state calls `activeInvokes_.erase` exactly once.
            // Erasing here would race the still-pending ChildEvent and skip
            // its `<finalize>`, silently breaking W3C §6.4.4 ordering.
            AOT_DEBUG("AOT onInvokeDone: raised done.invoke for '{}'", subject);
            return;
        }
        {% endfor %}
        AOT_DEBUG("AOT onInvokeDone: no remote invoke matching subject='{}' — drop", subject);
    }

    // SCE_MESH.md §16.7 row 5 sub-atomic C — §9.6 scxml-invoke peer-down
    // emit. Called from `TransportRouter` peer-down handlers (Zenoh
    // liveliness DELETE on a row-8 machine key; SOMEIP machine-level
    // `register_availability_handler` on `is_available=false`) once per
    // dropped peer, per session. For every statically-declared §9.6
    // invoke whose `remote_mesh_target == peer`, atomically erase the
    // matching `activeInvokes_` entry under `activeInvokesMutex_` and
    // snapshot its `invoke_id` for the post-lock raise loop. Each
    // snapshotted id then raises a single
    // `error.communication{INVOKE_CHILD_LOST, invoke_id, target: peer}`
    // event into THIS session's external queue via `engine.raiseExternal`
    // — `EventQueueManager::raise` is mutex-protected so the
    // callback-thread origin is safe (W3C SCXML 5.10 unhandled events
    // silently drop, so sessions whose state has already passed the
    // invoking state see a benign no-op). `pendingDoneInvoke_*_` flags
    // are intentionally untouched: INVOKE_CHILD_LOST is the spec-named
    // replacement for `done.invoke.<id>` / `error.invoke.<id>` when the
    // child becomes unreachable, so further state cleanup would
    // duplicate the author's transition contract. Non-active invoke
    // targeting `peer` (never started, or already cleaned up via
    // onexit) is a silent no-op — the §16.7 emit contract is
    // "one per active entry that becomes unreachable", not "one per
    // statically-declared invoke targeting the peer".
    //
    // Event-enum resolution is deliberately runtime via
    // `getEventFromName("error.communication")` — symmetric with
    // `MeshDispatch::dispatchEnvelope` (FireForget pattern) and
    // `raiseCommunicationError`, both of which already silently drop
    // when the Policy's Event enum has no `error.communication`
    // mapping (author chose not to write a transition for it). This
    // keeps sub-atomic C from forcing a static enum dependency on
    // every §9.6 outbound fixture; the existing W3C silent-drop
    // semantics for unhandled events handle the no-transition case.
    template <typename Engine>
    void failScxmlRemoteInvokesForPeer(const std::string& peer, Engine& engine) {
        std::vector<std::string> erased_invoke_ids;
        {
            std::lock_guard<std::mutex> lock(activeInvokesMutex_);
            {% for invoke_info in model.invokes | scxml_remote %}
            if (peer == "{{ invoke_info.remote_mesh_target }}") {
                if (auto it = activeInvokes_.find("{{ invoke_info.invoke_id }}");
                    it != activeInvokes_.end()) {
                    activeInvokes_.erase(it);
                    erased_invoke_ids.emplace_back("{{ invoke_info.invoke_id }}");
                }
            }
            {% endfor %}
        }
        if (erased_invoke_ids.empty()) {
            return;
        }
        auto event_opt = getEventFromName("error.communication");
        if (!event_opt) {
            AOT_DEBUG("AOT failScxmlRemoteInvokesForPeer: Policy has no "
                      "Event::Error_communication mapping — silent drop of "
                      "{} entries (peer='{}')", erased_invoke_ids.size(), peer);
            return;
        }
        for (const auto& iid : erased_invoke_ids) {
            ::SCE::Mesh::CommunicationError err;
            err.reason = ::SCE::Mesh::ReasonCode::InvokeChildLost;
            err.invoke_id = iid;
            err.target = peer;
            const auto json_bytes = err.toJsonBytes();
            typename Engine::EventWithMetadata meta;
            meta.event = *event_opt;
            meta.data = std::string(json_bytes.begin(), json_bytes.end());
            engine.raiseExternal(std::move(meta));
            AOT_DEBUG("AOT failScxmlRemoteInvokesForPeer: raised "
                      "error.communication INVOKE_CHILD_LOST for invoke='{}' target='{}'",
                      iid, peer);
        }
    }
{% endif %}

{% endif %}
