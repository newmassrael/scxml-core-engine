{#
    Saved State (Swift Jinja2)

    SCE Accepted Subset, "Saving and restoring" (docs/adr/0045): what a `datamodel="sce-static"`
    machine's policy answers so that its engine saves the machine and restores one.

    The Swift twin of the `save` and `restore` of kotlin/state_machine.kt.jinja2. The engine knows
    where the machine stands (`Engine.save`, `Engine.restore`); this writes what only the document
    knows: the digest of its shape, and each variable, by its document id, in declaration order,
    written and read as its `sce:type` says (`SavedValues`).

    Written only for a machine whose state the Swift runtime holds whole
    (`swift_saved_shape` of the generator): every variable a number, a truth value, a bounded text,
    a byte string, an enum, a record or a list of them, or one of those that may be absent, every
    record schema at any revision, and the `<invoke>`s a static child session, a hybrid one or a declared host
    invoker runs. What each `<history>` recorded is saved and restored through the ids the document gives them,
    and a machine of a product line records the configuration it was built for.
#}
{#- How a variable is written: by `SavedValues.of`, which every scalar, byte string and enum has, and by the
   record's own `toSaved`; a list writes each element so, and a value that may be absent is `null` or as its
   present value is written (docs/adr/0055, section 4). #}
{%- macro saved_write(field) -%}
{%- if field.saved_kind == 'optional' and field.saved_elem in ['record', 'union'] -%}
SavedValues.optional({{ field.name }}) { $0.toSaved() }
{%- elif field.saved_kind == 'optional' -%}
SavedValues.optional({{ field.name }}) { SavedValues.of($0) }
{%- elif field.saved_kind in ['record', 'union'] -%}
{{ field.name }}.toSaved()
{%- elif field.saved_kind == 'record_list' -%}
SavedValues.list({{ field.name }}) { $0.toSaved() }
{%- elif field.saved_kind == 'list' -%}
SavedValues.list({{ field.name }}) { SavedValues.of($0) }
{%- else -%}
SavedValues.of({{ field.name }})
{%- endif -%}
{%- endmacro %}
{#- A present value's saved form, one text with a test component's read of its module parameters
   (`swift/state_machine.swift.jinja2`). #}
{%- from '_macros/swift_saved_value.jinja2' import saved_present %}
{%- macro saved_read(field) -%}
{%- set value -%}try saved.variable("{{ field.id | escape_swift }}"){%- endset -%}
{%- set what -%}"{{ field.id | escape_swift }}"{%- endset -%}
{%- if field.saved_kind == 'optional' -%}
try SavedValues.optional({{ value }}, {{ what }}) { e, w in {{ saved_present(field.saved_type, field.saved_elem, 'e', 'w', field.bound) }} }
{%- elif field.saved_kind == 'list' -%}
try SavedValues.list({{ value }}, {{ what }}, capacity: {{ field.bound if field.bound is not none else '.max' }}) { e, w in {{ saved_present(field.saved_type, 'scalar', 'e', 'w', none) }} }
{%- elif field.saved_kind == 'record_list' -%}
try SavedValues.list({{ value }}, {{ what }}, capacity: {{ field.bound if field.bound is not none else '.max' }}) { e, w in {{ saved_present(field.saved_type, 'record', 'e', 'w', none) }} }
{%- else -%}
{{ saved_present(field.saved_type, field.saved_kind if field.saved_kind in ['enum', 'record', 'union'] else 'scalar', value, what, field.bound) }}
{%- endif -%}
{%- endmacro %}
{#- Builds the session of `<invoke>` `entry` as the saved child names it, of the policy `policy_type`, judges the state it
   holds down to its last grandchild, and returns what resumes it where it stood in place of starting it: no
   `<onentry>` runs, no `<data>` is evaluated and nothing is sent. `mesh_document` is the Swift expression of the
   document a Mesh router is asked for, and `stem` the candidate a hybrid invoke's slot is told it runs. #}
{%- macro resume_child(entry, policy_type, host_call, mesh_document, stem, indent) -%}
{{ indent }}let childPolicy = {{ policy_type }}Policy({{ 'actions: ' ~ host_call if host_call else '' }})
{{ indent }}let session = InvokedSession(
{{ indent }}    policy: childPolicy,
{{ indent }}    sessionID: childSessionID,
{{ indent }}    queue: ParentEventQueue(parentSessionID: parentSessionID)
{{ indent }})
{{ indent }}let resumeChild = try session.prepareSavedChild(child.session, index: index, wallNowMs: wallNowMs)
{{ indent }}return { [self] in
{{ indent }}    // The child's delayed sends are measured on this machine's clock, as the start of one makes them, and
{{ indent }}    // before it is restored, since restoring arms them.
{{ indent }}    session.engine.setClock(engine.clock())
{{ indent }}    engine.startChildMesh(of: session, invokeID: "{{ entry.info.invoke_id | escape_swift }}", document: {{ mesh_document }})
{{ indent }}    resumeChild()
{{ indent }}    activeInvokes["{{ entry.info.invoke_id | escape_swift }}"] = ChildSession(
{{ indent }}        sessionID: childSessionID,
{{ indent }}        invokeID: "{{ entry.info.invoke_id | escape_swift }}",
{{ indent }}        parentSessionID: sessionID,
{{ indent }}        autoforward: {{ 'true' if entry.info.autoforward else 'false' }},
{{ indent }}        finalizeScript: ""
{{ indent }}    )
{{ indent }}    sceInvokeChild{{ entry.info.field_suffix | to_pascal_case }} = session
{% if stem %}
{{ indent }}    sceInvokeStem{{ entry.info.field_suffix | to_pascal_case }} = "{{ stem | escape_swift }}"
{% endif %}
{{ indent }}    sceInvokeDone{{ entry.info.field_suffix | to_pascal_case }} = false
{{ indent }}}
{%- endmacro %}
{#- The `<invoke type="scxml">`s of the document, static and hybrid, in document order, each with the state that holds
   it: the order a saved state lists its running children in. The states are walked by document order, not by id. #}
{%- set ns_order = namespace(max=0, all=[], hosts=[]) -%}
{%- for state_id, state in model.states | dictsort -%}
{%- if state.document_order > ns_order.max -%}{%- set ns_order.max = state.document_order -%}{%- endif -%}
{%- endfor -%}
{%- for order in range(ns_order.max + 1) -%}
{%- for state_id, state in model.states | dictsort -%}
{%- if state.document_order == order -%}
{%- for invoke_info in (state.invokes | scxml) + (state.invokes | hybrid) -%}
{%- set ns_order.all = ns_order.all + [{'info': invoke_info, 'state': state_id}] -%}
{%- endfor -%}
{%- for invoke_info in state.invokes | host_invoker -%}
{%- set ns_order.hosts = ns_order.hosts + [{'info': invoke_info, 'state': state_id}] -%}
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- set saved_invokes = ns_order.all %}
{%- set saved_host_invokes = ns_order.hosts %}
// ======================================================================
// Saved state (docs/adr/0045)
// ======================================================================

extension {{ machine_name }}Policy: SavedPolicy {
    /// What a saved state of this document is bound to: a digest the generator computes of every
    /// state with its kind and parent and every variable with its type, not of the document's text,
    /// so a later build whose guards, actions or comments changed restores it and one that renamed,
    /// re-typed or moved something a saved state names refuses it.
    public static var savedShape: SavedShape {
{% if static_saved_shape.features is not none %}
        // The configuration of a product line this machine was built for (docs/adr/0057, section 7), one feature
        // to a statement, so the machine generated for every build of the line holds each feature under its own
        // condition (section 10).
        let features = SavedFeatures.configured { on in
{% for feature in static_saved_shape.features %}
            on.append("{{ feature | escape_swift }}")
{% endfor %}
        }
        return SavedShape(
{% else %}
        SavedShape(
{% endif %}
            first: "{{ static_saved_shape.first }}",
            revised: "{{ static_saved_shape.revised }}",
            format2First: "{{ static_saved_shape.format2_first }}",
            format2Revised: "{{ static_saved_shape.format2_revised }}"{% if static_saved_shape.records %},
            records: [
{% for record in static_saved_shape.records %}
                SavedRecordLineage(
                    event: "{{ record.event | escape_swift }}", revision: {{ record.revision }},
                    revisions: [{% for fields in record.revisions %}"{{ fields }}"{{ ", " if not loop.last }}{% endfor %}],
                    added: [
{% for field in record.added %}
                        SavedAddedField(id: "{{ field.id | escape_swift }}", since: {{ field.since }}, defaultJSON: "{{ field.default | escape_swift }}"),
{% endfor %}
                    ],
                    widened: [
{% for field in record.widened %}
                        SavedWidenedField(id: "{{ field.id | escape_swift }}", since: {{ field.since }}, optionalSince: {{ field.optional_since }}),
{% endfor %}
                    ],
                    holders: [
{% for holder in record.holders %}
                        SavedRecordHolder(variable: "{{ holder.variable | escape_swift }}", list: {{ "true" if holder.list else "false" }}),
{% endfor %}
                    ]),
{% endfor %}
            ]{% endif %}{% if static_saved_shape.enums %},
            enums: [
{% for lineage in static_saved_shape.enums %}
                SavedEnumLineage(
                    key: "{{ lineage.key | escape_swift }}", revision: {{ lineage.revision }},
                    revisions: [{% for fields in lineage.revisions %}"{{ fields }}"{{ ", " if not loop.last }}{% endfor %}],
                    added: [
{% for variant in lineage.added %}
                        SavedAddedVariant(name: "{{ variant.name | escape_swift }}", since: {{ variant.since }}),
{% endfor %}
                    ],
                    holders: [
{% for holder in lineage.holders %}
                        SavedEnumHolder(variable: "{{ holder.variable | escape_swift }}", field: {% if holder.field is not none %}"{{ holder.field | escape_swift }}"{% else %}nil{% endif %}, list: {{ "true" if holder.list else "false" }}),
{% endfor %}
                    ]),
{% endfor %}
            ]{% endif %}{% if static_saved_shape.features is not none %},
            features: features{% endif %})
    }

{% if model.history_states %}
    /// The document's `<history>`s, ordered by id: the order a saved state keys what each recorded in.
    public static var savedHistories: [SavedHistory] {
        [
{% for history_id in model.history_states | sort %}
            SavedHistory(
                id: "{{ history_id | escape_swift }}", history: {{ machine_name }}History.{{ history_id | to_state_variant }},
                deep: {{ 'true' if model.history_states[history_id]['type'] == 'deep' else 'false' }}),
{% endfor %}
        ]
    }

    /// Gives a `<history>` the states a saved run recorded for it, which the engine judged the
    /// history could have recorded.
    public func restoreHistory(_ history: HistoryID, to states: [{{ machine_name }}State]) {
        switch history {
{% for history_id in model.history_states | sort %}
        case {{ machine_name }}History.{{ history_id | to_state_variant }}:
            history{{ history_id | to_pascal_case }} = states
{% endfor %}
        default:
            break
        }
    }

{% endif %}
    /// Every variable, by document id, in declaration order, each as a saved state holds it: the
    /// machine's own included, and not only the ones it publishes.
    public func savedVariables() -> [SavedEntry<JSONValue>] {
        [
{% for field in static_fields %}
            SavedEntry("{{ field.id | escape_swift }}", {{ saved_write(field) }}),
{% endfor %}
        ]
    }

    /// Reads and judges every variable `saved` holds, the type each is held to and the bound of a
    /// text, and changes none: what it returns writes them, and cannot fail.
    public func readSavedVariables(from saved: SavedState) throws -> () -> Void {
{% for field in static_fields %}
        let value{{ loop.index0 }} = {{ saved_read(field) }}
{% endfor %}
{% if static_fields %}
        return { [self] in
{% for field in static_fields %}
            self.{{ field.name }} = value{{ loop.index0 }}
{% endfor %}
        }
{% else %}
        return {}
{% endif %}
    }
{% if saved_invokes %}

    /// The id the document gives each of its `<invoke type="scxml">`s, in document order.
    public var savedInvokeIDs: [String] {
        [{% for entry in saved_invokes %}"{{ entry.info.invoke_id | escape_swift }}"{{ ", " if not loop.last }}{% endfor %}]
    }

    /// How many times each `<invoke>` has started, which numbers the next start's id.
    public func savedInvokeStarts() -> [SavedEntry<Int64>] {
        var counted: [SavedEntry<Int64>] = []
{% for entry in saved_invokes %}
        if sceInvokeStarts{{ entry.info.field_suffix | to_pascal_case }} > 0 {
            counted.append(SavedEntry("{{ entry.info.invoke_id | escape_swift }}", Int64(sceInvokeStarts{{ entry.info.field_suffix | to_pascal_case }})))
        }
{% endfor %}
        return counted
    }

    /// Every `<invoke>` whose child session is running, each with the child's whole state
    /// (docs/adr/0045). A child that has ended is not running, though its entry stays until its state exits.
    public func savedChildren(wallNowMs: Int64) throws -> [SavedChild] {
        var running: [SavedChild] = []
{% for entry in saved_invokes %}
        if let child = sceInvokeChild{{ entry.info.field_suffix | to_pascal_case }}, !sceInvokeDone{{ entry.info.field_suffix | to_pascal_case }},
            let slot = activeInvokes["{{ entry.info.invoke_id | escape_swift }}"]
        {
{% if entry.info.kind == 'Hybrid' %}
            // The slot holds whichever candidate the `srcexpr` named, by what a parent drives it through.
            guard let saving = child as? any SavedChildEngine else {
                throw StateRefusal("the session of '{{ entry.info.invoke_id | escape_swift }}' is one this runtime cannot save")
            }
{% endif %}
            // The id the child was started under, which its session id derives from this one's: carried, not
            // computed again.
            running.append(
                SavedChild(
                    id: "{{ entry.info.invoke_id | escape_swift }}", start: Int64(sceInvokeStarts{{ entry.info.field_suffix | to_pascal_case }}),
                    invokeID: String(slot.sessionID.dropFirst(sessionID.count + 1)),
{% if entry.info.kind == 'Hybrid' %}
                    document: sceInvokeStem{{ entry.info.field_suffix | to_pascal_case }},
                    session: try saving.saveSession(wallNowMs: wallNowMs)))
{% else %}
                    document: "{{ entry.info.child_name | escape_swift }}",
                    session: try child.engine.save(wallNowMs: wallNowMs)))
{% endif %}
        }
{% endfor %}
        return running
    }

    /// The state that holds the `<invoke>` `id`, which a saved state's children and restarts are held to.
    private func savedInvokeOwner(_ id: String) -> {{ machine_name }}State? {
        switch id {
{% for entry in saved_invokes %}
        case "{{ entry.info.invoke_id | escape_swift }}": return .{{ entry.state | to_state_variant }}
{% endfor %}
        default: return nil
        }
    }

    /// Judges the children and the counts of starts `saved` holds and changes nothing; what it returns puts the
    /// children back once this machine stands where it was saved (docs/adr/0045, section 3).
    public func readSavedChildren(from saved: SavedState, engine: Engine<{{ machine_name }}Policy>, wallNowMs: Int64) throws -> () -> Void {
        for counted in saved.invokeStarts where savedInvokeOwner(counted.key) == nil {
            throw StateRefusal("invokestarts counts '\(counted.key)', which the document does not invoke")
        }
        func counted(_ id: String) -> Int64 { saved.invokeStarts.first { $0.key == id }?.value ?? 0 }
        // The state that holds an `<invoke>` is one the saved configuration stands in, and no `<invoke>` is listed twice.
        func holder(_ id: String, _ what: String, _ seen: inout Set<String>) throws -> {{ machine_name }}State {
            guard let owner = savedInvokeOwner(id) else {
                throw StateRefusal("the saved state holds a running child session '\(id)', which this machine does not start")
            }
            guard saved.configuration.contains(getStateName(owner)) else {
                throw StateRefusal("\(what) is '\(id)', whose state the saved configuration does not stand in")
            }
            guard seen.insert(id).inserted else {
                throw StateRefusal("\(what) is '\(id)', which an earlier entry already names")
            }
            return owner
        }
        var seen: Set<String> = []
        var resume: [() -> Void] = []
        var restart: [String] = []
        switch saved.invokes {
        case .resumed(let children):
            for (index, child) in children.enumerated() {
                _ = try holder(child.id, "invokes[\(index)]", &seen)
                if child.start != counted(child.id) {
                    throw StateRefusal(
                        "invokes[\(index)] is start \(child.start) of '\(child.id)', and the session counts \(counted(child.id)) "
                            + "starts of it: a state re-entered cancels the earlier child before it starts the next one")
                }
                // The id the child would be given where it is built, derived from this session's own, which the
                // restore is about to bind.
                let derived = "\(saved.boundSessionID ?? sessionID).\(child.invokeID)"
                if child.session.sessionID != derived {
                    throw StateRefusal(
                        "invokes[\(index)].session's id is '\(child.session.sessionID)', and a child of "
                            + "'\(saved.boundSessionID ?? sessionID)' started under '\(child.invokeID)' is '\(derived)'")
                }
                switch child.id {
{% for entry in saved_invokes %}
                case "{{ entry.info.invoke_id | escape_swift }}":
                    resume.append(try sceJudgeSavedChild{{ entry.info.field_suffix | to_pascal_case }}(child, index, derived, saved.boundSessionID ?? sessionID, engine: engine, wallNowMs: wallNowMs))
{% endfor %}
                default:
                    break
                }
            }
        case .restarted(let ids):
            for (index, id) in ids.enumerated() {
                _ = try holder(id, "invokes[\(index)]", &seen)
                restart.append(id)
            }
        }
        return { [self] in
{% for entry in saved_invokes %}
            sceInvokeStarts{{ entry.info.field_suffix | to_pascal_case }} = Int(counted("{{ entry.info.invoke_id | escape_swift }}"))
{% endfor %}
            for put in resume { put() }
            // A format-1 state holds a child by its id alone, so each is started again from its beginning, as
            // entering its state starts it, and last, so what a child sends as it starts stands behind what was
            // already waiting.
            for id in restart {
                switch id {
{% for entry in saved_invokes %}
                case "{{ entry.info.invoke_id | escape_swift }}":
                    sceInvokeStarts{{ entry.info.field_suffix | to_pascal_case }} += 1
                    deferInvoke(&pendingInvokes, PendingInvoke(
                        invokeID: "{{ entry.state | escape_swift }}.\(sceInvokeStarts{{ entry.info.field_suffix | to_pascal_case }}).{{ entry.info.invoke_id | escape_swift }}",
                        state: .{{ entry.state | to_state_variant }},
                        documentID: "{{ entry.info.invoke_id | escape_swift }}"))
{% endfor %}
                default:
                    break
                }
            }
            if !restart.isEmpty {
                executePendingInvokes(engine: engine)
            }
        }
    }
{% for entry in saved_invokes %}

    /// Builds the session `<invoke>` `{{ entry.info.invoke_id }}` ran as the saved child names it and judges
    /// the state it holds, down to its last grandchild; what it returns resumes it where it stood, in place of
    /// starting it: no `<onentry>` runs, no `<data>` is evaluated and nothing is sent.
    private func sceJudgeSavedChild{{ entry.info.field_suffix | to_pascal_case }}(
        _ child: SavedChild, _ index: Int, _ childSessionID: String, _ parentSessionID: String,
        engine: Engine<{{ machine_name }}Policy>, wallNowMs: Int64
    ) throws -> () -> Void {
{% if entry.info.kind == 'Hybrid' %}
        // The candidate the saved child names: whatever `srcexpr` reads now, the child that was running resumes.
        switch child.document {
{% for candidate in entry.info.candidates %}
        case "{{ candidate.stem | escape_swift }}":
{{ resume_child(entry, candidate.stem | to_pascal_case, candidate.child_host_call, '"' ~ (candidate.stem | escape_swift) ~ '"', candidate.stem, '            ') }}
{% endfor %}
        default:
            throw StateRefusal("invokes[\(index)] is of '\(child.document)', which '{{ entry.info.invoke_id | escape_swift }}' does not start")
        }
{% else %}
        guard child.document == "{{ entry.info.child_name | escape_swift }}" else {
            throw StateRefusal("invokes[\(index)] is of '\(child.document)', which '{{ entry.info.invoke_id | escape_swift }}' does not start")
        }
{{ resume_child(entry, entry.info.child_name | to_pascal_case, entry.info.child_host_call, 'documentStem("' ~ (entry.info.src | default('', true) | escape_swift) ~ '")', '', '        ') }}
{% endif %}
    }
{% endfor %}
{% endif %}
{% if saved_host_invokes %}

    /// The `<invoke>`s of the document a declared host invoker runs, each by its type and id with the state that
    /// holds it: what a saved state's host-run invocations are held to (docs/adr/0045).
    public var savedHostInvokeSlots: [SavedHostInvokeSlot] {
        [
{% for entry in saved_host_invokes %}
            SavedHostInvokeSlot(processorType: "{{ entry.info.invoke_type | escape_swift }}", invokeID: "{{ entry.info.invoke_id | escape_swift }}", state: "{{ entry.state | escape_swift }}"),
{% endfor %}
        ]
    }
{% endif %}
}
