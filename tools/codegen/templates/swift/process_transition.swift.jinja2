{#
    Transition Selection Template (Swift Jinja2)

    What the generated policy knows and the engine does not: which of a state's
    transitions an event enables, and what each transition's content is.
    Everything else Appendix D does with a transition (the walk from each atomic
    state up through its ancestors, the ordered set, conflict removal, the exit
    set, the entry set) is written once, in the runtime's Microstep.swift, over
    the structure state_machine.swift.jinja2 emits.

    Generates:
    - firstEnabledTransition(_:event:engine:)    the per-state half of selection
    - executeTransitionContent(source:transitionIndex:engine:)

    The Swift twin of go/process_transition.go.jinja2.
#}
{%- import '_macros/swift_entry_target.jinja2' as et %}

{# The guard a transition is taken under, in the one form this machine can
   evaluate it: a pure In() predicate, a condition lowered to Lua and run by the
   script engine (`script_engine.swift.jinja2`), or a value decided at build time
   (W3C SCXML 5.9). A cond the frontend could not decide has no `cond_constant`,
   and printing it as `false` would leave its transition dead and say nothing. #}
{% macro guard_expr(trans) -%}
{%- if trans.is_pure_in_predicate -%}{{ trans.cond_cpp | to_in_predicate_swift }}
{%- elif trans.native_guard -%}{{ trans.native_guard }}
{%- elif model.needs_script_engine and trans.cond_constant is none -%}evaluateGuard("{{ trans.cond | to_lua_guard | escape_swift }}", engine: engine)
{%- else -%}{{ 'true' if trans.cond_constant else 'false' }}
{%- endif -%}
{%- endmacro %}

{# Whether `trans` answers `event`: an eventless transition only an eventless
   selection, a transition with an event descriptor only a named event.
   §scxml-3.13 selects the two kinds in separate passes, and W3C SCXML 5.9.3
   matches a descriptor by direct enum comparison, a precomputed prefix set, or
   at run time. #}
{% macro event_match(trans) -%}
{%- if not trans.event -%}event == .null
{%- elif trans.needs_string_matching -%}event != .null && matchesEventDescriptor(eventName: getEventName(event), descriptor: "{{ trans.event | escape_swift }}")
{%- elif trans.matching_enum_values | length > 0 -%}{% for ev in trans.matching_enum_values %}event == .{{ ev | to_event_variant }}{{ " || " if not loop.last }}{% endfor %}
{%- else -%}false
{%- endif -%}
{%- endmacro %}

    /// Appendix D selectTransitions, the half only this document can answer: the
    /// first of `state`'s own transitions, in document order, that `event` enables
    /// and whose guard holds. The engine walks the atomic states and their
    /// ancestors and keeps the ordered set; the null event asks for eventless
    /// transitions.
    public func firstEnabledTransition(
        _ state: {{ machine_name }}State,
        event: {{ machine_name }}Event,
        engine: Engine<{{ machine_name }}Policy>
    ) -> EnabledTransition<{{ machine_name }}State>? {
        switch state {
{% for state_id, state in model.states | dictsort %}
{% if state.transitions %}
        case .{{ state_id | to_state_variant }}:
{% for trans in state.transitions %}
            if {{ event_match(trans) }} {
{# A guard lowered with no `cond` written is a branch of a test component's
   match on the round's snapshot (docs/SCE_TEST_PROFILE.md §12.3). #}
{% if trans.cond or trans.native_guard %}
{% if trans.native_prelude %}
                // docs/SCE_TEST_PROFILE.md §12.3: a branch of the test component,
                // guarded by its cond and then its match on the round's snapshot.
{% elif trans.native_guard and not trans.is_pure_in_predicate %}
                // W3C SCXML 5.9: cond="{{ trans.cond }}" lowered to Swift at build time
{% elif model.needs_script_engine and trans.cond_constant is none and not trans.is_pure_in_predicate %}
                // W3C SCXML 5.9: cond="{{ trans.cond | replace("\n", " ") }}" lowered to Lua at build time, run by the engine
{% elif not trans.is_pure_in_predicate %}
                // W3C SCXML 5.9: cond="{{ trans.cond }}" decided at build time
{% endif %}
{# The parentheses keep a guard that begins with a closure from being read as
   the block the `if` opens. #}
                if ({{ guard_expr(trans) }}) {
{% else %}
                do {
{% endif %}
                    return EnabledTransition(
                        source: state,
                        targets: {{ et.entry_targets(trans.targets, model.history_states, machine_name) }},
                        transitionIndex: {{ trans.transition_index }},
                        hasActions: {{ 'true' if trans.actions or trans.native_prelude else 'false' }},
                        isInternal: {{ 'true' if trans.type == 'internal' else 'false' }}
                    )
                }
            }
{% endfor %}
{% endif %}
{% endfor %}
        default:
            break
        }
        return nil
    }

    /// Runs one transition's executable content (W3C SCXML 3.13), between the
    /// microstep's exits and its entries.
    public func executeTransitionContent(source: {{ machine_name }}State, transitionIndex: Int, engine: Engine<{{ machine_name }}Policy>) {
{% if model.has_transition_actions %}
        switch source {
{# A transition carries content when the document wrote some, and a branch of
   a test component always does: the statement taking it, which runs before
   what the document wrote (`native_prelude`, docs/SCE_TEST_PROFILE.md §4.4
   (P4 step 1), §12.3). #}
{% for state_id, state in model.states | dictsort %}
{% if state.transitions | selectattr("actions") | list or state.transitions | selectattr("native_prelude") | list %}
        case .{{ state_id | to_state_variant }}:
            switch transitionIndex {
{% for trans in state.transitions %}
{% if trans.actions or trans.native_prelude %}
            case {{ trans.transition_index }}:
{#  docs/SCE_TEST_PROFILE.md §4.4 (P4 step 1), §12.3: taking a branch of a test
    component removes what it matched on the round's snapshot before its
    content runs, and a message the content reads is its `_event.data`, held
    in the payload property of its record's event from here on
    (`Transition::native_prelude`). #}
{% if trans.native_prelude %}
                // docs/SCE_TEST_PROFILE.md §12.3: taking the branch (P4 step 1).
                {{ trans.native_prelude }}
{% endif %}
{% if trans.actions %}
                // W3C SCXML 4.9: a transition's content is one block; an error ends it.
                sceBlock: do {
{# W3C SCXML 3.13: content that reads the event's typed payload cannot run for a
   delivery that did not carry one, and an error stops the block it arose in
   (W3C SCXML 4.9) — so the check guards the whole content, once, before any of it
   runs. A delivery of this event whose data does not fit is refused whole at the
   door and never reaches it (docs/adr/0086, section 4.2); the tag differs here only
   for an event of another name the transition's descriptor also matches, which
   carries no payload of this event. It raises nothing: no delivery was refused. #}
{% if trans.content_reads_payload %}
                    if pendingPayloadTag != .{{ trans.event | to_event_variant }} {
                        break sceBlock
                    }
{% endif %}
{% for action in trans.actions %}
                    {% with in_action_block=true %}{% include 'actions/' ~ action.type ~ '.swift.jinja2' %}{% endwith %}

{% endfor %}
                }
{% endif %}
{% endif %}
{% endfor %}
            default:
                break
            }
{% endif %}
{% endfor %}
        default:
            break
        }
{% else %}
        // W3C SCXML 3.13: no transition in this document has content.
{% endif %}
    }
