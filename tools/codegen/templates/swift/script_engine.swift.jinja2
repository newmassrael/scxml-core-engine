{#
    The script engine of a `datamodel="ecmascript"` document (Swift Jinja2)

    The build lowers every ECMAScript expression to Lua (`to_lua_guard`, `to_lua_expr`), and the
    `SceLua` module's `LuaState` runs it: the engine every other Lua backend runs the same Lua on,
    over the same library, so one document answers one way on every backend
    (docs/SCE_LUA_TRANSLATION_SEAM.md). `SceRuntime` does not import `SceLua`; this machine does,
    and only a document that needs an engine links Lua.

    Included inside the policy class, and only when the model needs a script engine:
    - establishScriptSession()          the session, made by every start before anything runs
                                        (docs/adr/0096), and the one place one is made
    - initializeDataModel(engine:)      each `<data>` initialiser, in document order
    - populateEventMetadata / bindCurrentEvent   `_event`, before the first guard of a selection
    - evaluateGuard(_:engine:)          a `cond`, which raises error.execution when it cannot be run
    - evaluateIfCond(_:failed:engine:)  the same for an `<if>`, which also sets its caller's flag
    - assignData / executeScript        an `<assign>` and a `<script>`, run as the Lua they were lowered to
    - evaluateText(_:)                  the text of an expression (`<log expr>`, a `<send>`'s computed event,
                                        target and delay), or nil when it cannot be run
    - evaluateJSON(_:)                  the value of an expression as typed JSON (a `<send>`'s `<param>`,
                                        namelist and `<content expr>`), or nil when it cannot be run
    - beginForeach / bindForeach        a `<foreach>`: the array read once, then each item and index bound
#}

    // ------------------------------------------------------------------
    // Script engine (W3C SCXML 5.3, 5.9, 5.10; SceLua)
    // ------------------------------------------------------------------

    /// The Lua session this machine's expressions run in. Made by `establishScriptSession`, which
    /// every start runs before anything else, and made again by each later start, which starts
    /// from the document's own values. Nil before the first start and after a start it refused.
    private var lua: LuaState?

    /// The address the host's BasicHTTP listener answers on for this machine (W3C SCXML C.2), which
    /// `_ioprocessors['basichttp'].location` publishes. Support for that processor is per
    /// deployment: a machine whose host declares none publishes no entry, rather than an address
    /// nothing answers on. Set before the machine starts; the session reads it when it is made.
    public var basicHTTPAccessURI = ""

    /// §scxml-6.4: the values a parent's `<param>` and `namelist` hand this machine before it
    /// starts, by name: every name the parent evaluated, since which of them it takes is this
    /// machine's to decide. A top-level `<data>` (one in the `<datamodel>` of `<scxml>` itself) of
    /// one of these names is declared with the value in place of its own; a state's `<data>` never
    /// takes one, and a name no top-level `<data>` declares is never read. The start that declares
    /// the top-level data consumes them, so a later start begins from the document's own values.
    private var invokeSeeds: [String: LuaSeed] = [:]

    /// Hands the machine the values its parent's `<invoke>` names. Called before the machine starts.
    public func acceptSeeds(_ seeds: [String: LuaSeed]) {
        invokeSeeds = seeds
    }

    /// The value of a Lua expression read in this machine's session, for a host or a test that wants
    /// to see what the data model holds (`JSON.stringify(answers)`). Nil when the machine has no
    /// session yet or the expression cannot be evaluated. Reading changes nothing: it does not run
    /// the machine and it does not raise `error.execution`.
    public func readScriptValue(_ expression: String) -> LuaValue? {
        guard let session = lua else {
            return nil
        }
        return try? session.evaluate(expression, name: "=read")
    }

    /// The metadata of the event being handled, kept by `populateEventMetadata` until
    /// `bindCurrentEvent` hands it to the session (§scxml-5.10).
    private var pendingEventMetadata = EventMetadata()

    /// Establishes the session (docs/adr/0096): creates the Lua state, loads the ECMAScript library
    /// into it and binds `_sessionid`, `_name` and `_ioprocessors` (§scxml-5.10), in that order.
    /// The engine asks it first in every start, before the run is marked running and before
    /// anything is entered, and it is the one place a session is made. Answers nil once the session
    /// is held, or the step that failed with the engine's words: a state made by a step before the
    /// one that failed is released with this frame, and none is held, so the start is refused and
    /// the next start makes the session from nothing.
    public func establishScriptSession() -> ScriptSessionFailure? {
        lua = nil
        let session: LuaState
        do {
            try sceScriptSessionFaultInjected(at: .create)
            session = try LuaState()
        } catch {
            return ScriptSessionFailure(stage: .create, message: LuaError.message(of: error))
        }
        do {
            try sceScriptSessionFaultInjected(at: .library)
            try session.loadEcmaScriptLibrary()
        } catch {
            return ScriptSessionFailure(stage: .library, message: LuaError.message(of: error))
        }
        do {
            try sceScriptSessionFaultInjected(at: .systemVariables)
            try session.bindSession(
                LuaSession(
                    sessionID: sessionID,
                    name: "{{ model.scxml_name | default('') | w3c_session_name(model.name) | escape_swift }}",
                    scxmlLocation: scxmlProcessorLocation(sessionID: sessionID),
                    basicHTTPLocation: basicHTTPAccessURI.isEmpty ? nil : basicHTTPAccessURI
                ))
{% if model.has_parallel_states or model.uses_in_predicate %}
            // W3C SCXML 5.9.2: `In()` asks this machine's own configuration. The session is owned by
            // the machine, so the closure does not own it back.
            try session.setStateQuery { [unowned self] in self.isStateActive($0) }
{% endif %}
        } catch {
            return ScriptSessionFailure(stage: .systemVariables, message: LuaError.message(of: error))
        }
        lua = session
        return nil
    }

    /// The session the start established. Every start establishes it before anything here can
    /// run, and a start whose session could not be established runs nothing (docs/adr/0096), so a
    /// session asked for with none held is a defect of the generated code and not a failure a host
    /// can meet: it stops the process, in a release build too, rather than run an expression over
    /// no session.
    private var scriptSession: LuaState {
        guard let lua else {
            preconditionFailure("the script session of {{ machine_name }} was asked for before a start established it")
        }
        return lua
    }

#if DEBUG
    /// Asked before each step of establishing a session (docs/adr/0096), with the id of the session
    /// being established and the step: an answer of true fails that step as a failure of the engine
    /// would, which a real Lua state does only when it cannot allocate. The way a test reaches the
    /// refusal of a start. A parent hands it to every child it starts that runs a script engine, so
    /// a test reaches a child's refusal too. A debug build's alone: a release build has no way to
    /// fail a session on request.
    var sceScriptSessionFault: ((_ sessionID: String, _ stage: ScriptSessionStage) -> Bool)?

    private func sceScriptSessionFaultInjected(at stage: ScriptSessionStage) throws {
        if sceScriptSessionFault?(sessionID, stage) == true {
            throw LuaError.runtime("the step '\(stage)' was failed on request")
        }
    }
#else
    private func sceScriptSessionFaultInjected(at stage: ScriptSessionStage) throws {}
#endif

    /// Says what went wrong where the document can see it: `error.execution` on the internal
    /// queue (§scxml-5.9.1, 5.3).
    private func raiseExecutionError(_ message: String, engine: Engine<{{ machine_name }}Policy>) {
{% if 'error.execution' in model.events %}
        engine.raise(EventWithMetadata.platformError({{ machine_name }}Event.{{ 'error.execution' | to_event_variant }}, message: message))
{% endif %}
    }

{% import 'data_source.swift.jinja2' as ds %}
    /// W3C SCXML 5.3: the `<data id>` `id` takes the value of the lowered expression, or nil when it
    /// declares none. The name crosses as a string and never as source: an XML name is not always
    /// a Lua identifier. An initialiser that fails raises `error.execution` and leaves the
    /// variable nil.
    ///
    /// §scxml-6.4: `handed` is the value the parent's `<invoke>` handed a top-level `<data>` of this
    /// name, which only the declaration of the top-level data passes. It is declared in place of the
    /// `<data>`'s own value, whose expression, `src` or content is then not evaluated: it raises
    /// nothing and has no effect. A handed value the session cannot hold is this `<data>`'s
    /// initialization error, as an initialiser that fails is (§scxml-5.3).
    private func defineData(
        _ id: String,
        handed: LuaSeed? = nil,
        as expression: String?,
        orText fallback: String? = nil,
        engine: Engine<{{ machine_name }}Policy>
    ) {
        let session = scriptSession
        do {
            if let handed {
                switch handed {
                case .scalar(let value):
                    try session.setGlobal(id, value)
                case .json(let text):
                    // The text is parsed where the session reads it, and the global it was carried
                    // in is not left in the datamodel, which declares no such name.
                    try session.setGlobal("_scxml_seed", .string(text))
                    defer { try? session.setGlobal("_scxml_seed", .nilValue) }
                    try session.defineGlobal(id, as: "JSON.parse(_scxml_seed)", chunkName: "=seed")
                }
            } else if let expression {
                do {
                    try session.defineGlobal(id, as: expression, chunkName: "=data")
                } catch {
                    // W3C SCXML B.2: inline content that cannot be read as an expression is the
                    // string it spells, whitespace-normalized (the last of its ordered readings).
                    guard let fallback else {
                        throw error
                    }
                    try session.setGlobal(id, .string(fallback))
                }
            } else {
                try session.setGlobal(id, .nilValue)
            }
        } catch {
            raiseExecutionError(
                handed == nil
                    ? "<data id='\(id)'> expr failed to evaluate"
                    : "<data id='\(id)'> could not hold the value its parent handed it",
                engine: engine)
            _ = try? session.setGlobal(id, .nilValue)
        }
    }

    /// W3C SCXML 5.4: gives the location the value, both already lowered to Lua, and answers whether
    /// the assignment ran. A location that cannot be written, or a value that cannot be computed, is
    /// the caller's `error.execution`.
    private func assignData(_ location: String, _ value: String) -> Bool {
        executeScript("\(location) = \(value)", name: "=assign")
    }

    /// W3C SCXML 5.8: runs a chunk already lowered to Lua in the session, and answers whether it ran.
    /// A chunk that raises is the caller's `error.execution`.
    private func executeScript(_ source: String, name: String) -> Bool {
        do {
            try scriptSession.execute(source, name: name)
            return true
        } catch {
            return false
        }
    }

    /// W3C SCXML 4.7, 6.2: the text of an expression, already lowered to Lua, as ECMAScript converts a
    /// value to a string, or nil when the expression cannot be run (the caller's `error.execution`).
    /// What a `<log expr>` shows and what a `<send>`'s computed event, target and delay say.
    private func evaluateText(_ expression: String) -> String? {
        do {
            if case .string(let text) = try scriptSession.evaluate("_scxml_tostring(\(expression))", name: "=log") {
                return text
            }
            return nil
        } catch {
            return nil
        }
    }

    /// W3C SCXML 4.6: starts a `<foreach>`. The array expression, already lowered to Lua, is read once
    /// and a shallow copy is kept in a variable of the session named for the loop's nesting depth
    /// ("the array is not changed by the loop": a body that changes the variable does not change what the
    /// loop walks). Answers how many items there are, or nil when the value is not an array or cannot be
    /// read (the caller's `error.execution`).
    private func beginForeach(_ depth: Int, _ array: String) -> Int? {
        let slot = "_scxml_foreach_\(depth)"
        let copied = executeScript(
            "local source = \(array); if not _isArray(source) then error('<foreach> array is not an array') end; "
                + "local copy = {}; for i = 1, #source do copy[i] = source[i] end; \(slot) = copy",
            name: "=foreach")
        guard copied, case .integer(let count)? = try? scriptSession.evaluate("#\(slot)", name: "=foreach") else {
            return nil
        }
        return Int(count)
    }

    /// W3C SCXML 4.6: gives the `<foreach>`'s item (and, when it names one, its index) the values of one
    /// iteration, both locations already lowered to Lua. A location that cannot be written is the caller's
    /// `error.execution`.
    private func bindForeach(_ depth: Int, at position: Int, item: String, index: String?) -> Bool {
        guard executeScript("\(item) = _scxml_foreach_\(depth)[\(position + 1)]", name: "=foreach") else {
            return false
        }
        guard let index else {
            return true
        }
        return executeScript("\(index) = \(position)", name: "=foreach")
    }

    /// W3C SCXML 5.7.1, 5.6.2: the value of an expression, already lowered to Lua, as JSON text, which
    /// keeps its type: a number stays one and an object keeps its shape, so a receiver reading
    /// `_event.data.value === 42` finds 42. A value ECMAScript cannot write as JSON (`undefined`, a
    /// function) is `null`, and an expression that cannot be run is nil (the caller's `error.execution`).
    private func evaluateJSON(_ expression: String) -> String? {
        do {
            if case .string(let text) = try scriptSession.evaluate("JSON.stringify(\(expression))", name: "=value") {
                return text
            }
            return "null"
        } catch {
            return nil
        }
    }

    /// W3C SCXML 6.4.1: the value an `<invoke>` hands its child for one of its variables, read once
    /// from a Lua expression already lowered. A scalar is the value itself and anything else (an
    /// object, an array, `undefined`) is its JSON, because JSON writes `Infinity` as `null`
    /// (`LuaSeed`). An expression that cannot be run is nil (the caller's `error.execution`).
    private func evaluateSeed(_ expression: String) -> LuaSeed? {
        let session = scriptSession
        do {
            // One evaluation: an expression with a side effect (`n++`) must run once, so its value
            // is kept in a global the kind and the value are then read from.
            try session.defineGlobal("_scxml_seed_value", as: expression, chunkName: "=seed")
            defer { try? session.setGlobal("_scxml_seed_value", .nilValue) }
            let kind = try session.evaluate("type(_scxml_seed_value)", name: "=seed")
            if case .string(let name) = kind, ["boolean", "number", "string"].contains(name) {
                return .scalar(try session.evaluate("_scxml_seed_value", name: "=seed"))
            }
            if case .string(let text) = try session.evaluate("JSON.stringify(_scxml_seed_value)", name: "=seed") {
                return .json(text)
            }
            return .json("null")
        } catch {
            return nil
        }
    }

{# A machine whose host serves a `<send>` type (a declared one, or the `sce:mesh` the build lowers a
   send to a peer to, and records for a `targetexpr` that may name one) reads each `<param>` of such
   a send in the two spellings its request carries, as a host-run `<invoke>` reads its own. #}
{% if model.invokes | host_invoker or model.host_processor_types %}
    /// W3C SCXML 6.4.1, 6.2.5 + 5.7.1: the value of an expression, already lowered to Lua, as the two
    /// spellings a request to a host (an `<invoke>` it runs, a `<send>` it serves) carries it in: the
    /// text a form carries (ECMAScript's `String(value)`), which the request's `params` hold, and the
    /// JSON that keeps its type, which the request's event data holds.
    /// The expression is run once, so one with a side effect (`n++`) takes effect once and both
    /// spellings are the same value. One that cannot be run is nil (the caller's `error.execution`).
    private func evaluateWire(_ expression: String) -> (text: String, json: String)? {
        let session = scriptSession
        do {
            try session.defineGlobal("_scxml_wire_value", as: expression, chunkName: "=wire")
            defer { try? session.setGlobal("_scxml_wire_value", .nilValue) }
            guard case .string(let text) = try session.evaluate("_scxml_tostring(_scxml_wire_value)", name: "=wire") else {
                return nil
            }
            var json = "null"
            if case .string(let written) = try session.evaluate("JSON.stringify(_scxml_wire_value)", name: "=wire") {
                json = written
            }
            return (text, json)
        } catch {
            return nil
        }
    }

{% endif %}
    /// W3C SCXML 5.3: declares the document's variables. Early binding runs every state's
    /// `<data>` here, at document load, before the state that holds it is visited; late binding
    /// declares a state's own on its first entry (`executeEntryActions`). Runs in the session the
    /// start established just before it (`establishScriptSession`). The order is the one
    /// §scxml-6.4 fixes for a child: the top-level `<data>`, each declared with the value the parent
    /// handed it in place of its own; the early-bound `<data>` of the states, which take none; the
    /// top-level scripts, which read the handed values; then the initial configuration is entered.
    public func initializeDataModel(engine: Engine<{{ machine_name }}Policy>) {
        pendingEventMetadata = EventMetadata()
        // §scxml-6.4: the values the parent handed are this start's, taken once.
{% if model.variables %}
        let handed = invokeSeeds
{% endif %}
        invokeSeeds = [:]
{% for var in model.variables %}
        defineData("{{ var.id | escape_swift }}", handed: handed["{{ var.id | escape_swift }}"], {{ ds.data_source(var, model.scxml_base_path) }}, engine: engine)
{% endfor %}
{% for state_id, state in model.states | dictsort %}
{% if state.datamodel and model.binding != 'late' %}
        // W3C SCXML 5.3: early binding, the data of state {{ state_id }}, which takes no handed value
{% for var in state.datamodel %}
        defineData("{{ var.id | escape_swift }}", {{ ds.data_source(var, model.scxml_base_path) }}, engine: engine)
{% endfor %}
{% endif %}
{% endfor %}
{% if model.global_scripts %}
        // W3C SCXML 5.8: the top-level scripts run at document load, after the data is declared
{% for script in model.global_scripts %}
        if !executeScript("{{ script.content | to_lua_script | escape_swift }}", name: "=script") {
            raiseExecutionError("a top-level <script> failed to execute", engine: engine)
        }
{% endfor %}
{% endif %}
    }

    /// Keeps the metadata of the event about to be selected on (§scxml-5.10).
    public func populateEventMetadata(_ metadata: EventMetadata) {
        pendingEventMetadata = metadata
    }

    /// W3C SCXML 5.10: binds the event whose transitions are about to be selected as the `_event`
    /// their guards read, whole, so a field it does not carry is absent. The null event is an
    /// eventless selection, which has no event of its own, so `_event` stays what it was.
    public func bindCurrentEvent(_ event: {{ machine_name }}Event, engine: Engine<{{ machine_name }}Policy>) {
        guard event != .null else {
            return
        }
        let metadata = pendingEventMetadata
        let name = metadata.name.isEmpty ? getEventName(event) : metadata.name
        do {
            let reading = try scriptSession.bindCurrentEvent(
                LuaEvent(
                    name: name,
                    type: metadata.eventType.description,
                    sendID: metadata.sendID,
                    // W3C SCXML 5.10.1 + C.1 (docs/adr/0090): `_event.origin` and
                    // `_event.origintype` are the two fields of the one pair the delivering
                    // processor wrote where it built the event, read here as they are: for an
                    // event a session sent, the location the sender published (test 336). An
                    // event no processor stamped hands both over as the empty text, which the
                    // binding leaves blank: undefined to the document, never `''`.
                    origin: metadata.originAddress,
                    originType: metadata.originProcessor,
                    invokeID: metadata.invokeID,
                    data: metadata.data
                ))
            // W3C SCXML B.2.8.1: which rung the payload got is known only here, where the ladder was
            // climbed, so the engine is told now. One a host sent as structure and the datamodel
            // refused is the reading the engine counts (`Engine.undecodablePayloads`); without
            // this call the payload is lost to the document and to the host alike.
            engine.notePayloadReading(event, reading: Self.payloadReading(of: reading))
        } catch {
            raiseExecutionError("_event could not be bound for '\(name)'", engine: engine)
        }
    }

    /// The engine's name for a rung the script engine reports: the two modules each declare the
    /// five readings, since the script engine does not depend on the runtime.
    private static func payloadReading(of reading: SceLua.PayloadReading) -> SceRuntime.PayloadReading {
        switch reading {
        case .absent: return .absent
        case .dom: return .dom
        case .structured: return .structured
        case .text: return .text
        case .undecodable: return .undecodable
        }
    }

    /// W3C SCXML 5.9.1: a `cond` that cannot be evaluated is false, and raises `error.execution`.
    private func evaluateGuard(_ condition: String, engine: Engine<{{ machine_name }}Policy>) -> Bool {
        var failed = false
        return evaluateCond(condition, of: "<transition>", failed: &failed, engine: engine)
    }

    /// W3C SCXML 4.3, 5.9.1: the same for the `cond` of an `<if>` or `<elseif>`, which also says that
    /// it failed, because the element that held it ends its block once the chain has run (§scxml-4.9).
    private func evaluateIfCond(_ condition: String, failed: inout Bool, engine: Engine<{{ machine_name }}Policy>) -> Bool {
        evaluateCond(condition, of: "<if>", failed: &failed, engine: engine)
    }

    private func evaluateCond(
        _ condition: String,
        of element: String,
        failed: inout Bool,
        engine: Engine<{{ machine_name }}Policy>
    ) -> Bool {
        do {
            return try scriptSession.evaluateCondition(condition, chunkName: "=cond")
        } catch {
            raiseExecutionError("a \(element) cond failed to evaluate", engine: engine)
            failed = true
            return false
        }
    }
