// ======================================================================
// The test component the profile's runtime drives (docs/SCE_TEST_PROFILE.md §12.3)
// ======================================================================

/// The test component `{{ model.name }}` as the profile's runtime drives it
/// (docs/SCE_TEST_PROFILE.md §12.3).
///
/// It owns the machine of the policy above, unchanged, and reaches it only through
/// the doors the engine already has: the machine's sends on a port leave through
/// the test-port processor and its PTCs through the test-component invoker, both
/// registered here over the component's runtime context (docs/adr/0084), and each
/// round's snapshot is the one external event every branch is a transition on. The
/// runtime never reports a PTC's completion to the engine: a done branch reads it
/// from the snapshot, so the engine cancels every PTC it started when the invoking
/// state is exited, which is P9's kill. One thread; the engine's clock and
/// scheduler take no part, since a component sends nothing delayed.
///
/// The machine is built when the component starts, around a policy the context is
/// already bound to, and there is none before.
public final class {{ machine_name }}Component: {{ test_runtime }}.ComponentMachine {
    private var sceMachine: Engine<{{ machine_name }}Policy>?

    public init() {}

    public func start(_ context: {{ test_runtime }}.ComponentContext) {
        let policy = {{ machine_name }}Policy()
        // The session is named by the component, and named rather than drawn. The
        // name is `mtc` or the id of the `<invoke>` that creates the PTC
        // (`ComponentContext.create`, which creates nothing under a name its
        // configuration has no PTC of), and every `<invoke id>` is refused where its
        // document is parsed unless it is an XML Name, which is an Nmtoken
        // (docs/adr/0045). The refusal below is therefore unreachable for a
        // component a generated one creates.
        do {
            try policy.setSessionID(context.name)
        } catch {
            preconditionFailure("a test component's name is an XML Name, which names a session: \(error)")
        }
        policy.sceTestContextBound = context
{% if model.test_component.module_parameters %}
        // §11.5, §11.8: the module parameters take the suite's values before the machine is
        // built. Without one, or with one not of its type, the run ends in error (P13), and the
        // machine is not started on a value made up in its place: none is built, so the
        // component delivers nothing.
        guard context.readModuleParameters({ given in try policy.sceAcceptModuleParameters(given) }) else {
            return
        }
{% endif %}
        let machine = Engine(policy: policy)
        do {
            // P6: a send on a port is appended to the queue of the port it is
            // connected to, or handed to the system adapter where it is mapped. A
            // test-port send always carries its template's value, with the name of
            // its record type and the writer of its canonical form in the test log
            // (`forge::static_lowering`, `StaticTarget::test_message`;
            // docs/SCE_TEST_PROFILE.md §12.5).
            try machine.registerEventProcessor("{{ test_port_processor | escape_swift }}") { request in
                guard let sent = request.value?.value as? any {{ test_runtime }}.TestValue else {
                    preconditionFailure("a test-port send carries its template's value")
                }
                context.send(request.target, {{ test_runtime }}.Message(event: request.eventName, value: sent))
                return []
            }
            // P9: the start of a PTC's invocation creates and starts it, and its
            // cancel removes it, whether it is still running or already done.
            try machine.registerInvoker("{{ test_component_invoke_type | escape_swift }}") { event in
                switch event {
                case .start(let request):
                    context.create(request.invokeID)
                case .cancel(let cancel):
                    context.kill(cancel.invokeID)
                }
                return nil
            }
        } catch {
            // Neither type is under the prefix the runtime reserves for its own
            // processors (`reservedProcessorTypePrefix`), which is all a
            // registration refuses.
            preconditionFailure("the test profile's doors are no reserved processor type: \(error)")
        }
        // A test component runs no script engine (`test_component::rules::refuse_script_engine`),
        // so its start has no script session to fail and is never refused (docs/adr/0096).
        do {
            try machine.initialize()
        } catch {
            preconditionFailure("a test component runs no script engine, and its start was refused: \(error)")
        }
        sceMachine = machine
    }

    // §3.2 step 3: the round's snapshot, on which the machine takes the first
    // branch whose guard holds (P3) and completes its macrostep (P4), or takes
    // none and discards the event (§7).
    public func deliverSnapshot() {
        sceMachine?.processEvent(.{{ snapshot_event | to_event_variant }})
    }

    // P10: the machine entered a top-level `<final>`.
    public var terminated: Bool {
        sceMachine?.isInFinalState ?? false
    }
}
