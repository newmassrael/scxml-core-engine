{# W3C SCXML 4.6: Foreach loop over a list variable of a `datamodel="sce-static"`
   document: a native `for` over the typed elements, lowered ahead of the template by
   `forge::static_lowering`. "If the evaluation of any child element of foreach
   causes an error, the processor MUST cease execution of the foreach element and the
   block that contains it": a body element that raised its own error leaves the
   enclosing block from inside the loop with `break sceBlock`, which ends the block
   that holds the <foreach> as W3C SCXML 4.9 asks. #}
                // W3C SCXML 4.6: <foreach array="{{ action.array }}" item="{{ action.item }}">, a native loop over a sce-static list
                {{ action.native_loop }} {
{% if action.native_loop_prologue %}
                    {{ action.native_loop_prologue }}
{% endif %}
{% for body_action in action.actions %}
                    {% with action=body_action %}{% include 'actions/' ~ body_action.type ~ '.swift.jinja2' %}{% endwith %}

{% endfor %}
                }
