{# W3C SCXML 6.3: Cancel delayed send event. <cancel> carries either sendid or
   sendidexpr (W3C §6.3); both empty is rejected at parse time. Under
   `datamodel="sce-static"` a sendidexpr is a string computed from the machine's
   fields now (`Action::native_sendid`): an id no send holds cancels nothing, and an
   operation that fails cannot be evaluated, which raises error.execution and ends
   the block. #}
{% if action.sendid %}
                _ = engine.cancelEvent(sendID: "{{ action.sendid | escape_swift }}")
{% elif action.native_sendid %}
                do {
                    let cancelSendID = {{ action.native_sendid }}
                    _ = engine.cancelEvent(sendID: cancelSendID)
{% if action.native_sendid_fails %}
{# docs/adr/0099: the id that failed is thrown before anything is cancelled. #}
                } catch {
{% if 'error.execution' in model.events %}
                    engine.raise(EventWithMetadata.platformError({{ machine_name }}Event.{{ 'error.execution' | to_event_variant }}, message: "<cancel> sendidexpr failed to evaluate"))
{% endif %}
{% if in_action_block is defined and in_action_block %}
                    break sceBlock  // W3C SCXML 4.9: the error ends the block
{% endif %}
{% endif %}
                }
{% elif ecmascript_datamodel and action.sendidexpr %}
                // W3C SCXML 6.3 + 5.9: under `datamodel="ecmascript"` the id is the text of a Lua
                // expression the engine computes (`evaluateText`). One that cannot be evaluated
                // raises error.execution, and the error ends the block (W3C SCXML 4.9); an id no
                // send holds cancels nothing.
                do {
                    if let cancelSendID = evaluateText("{{ action.sendidexpr | to_lua_expr | escape_swift }}") {
                        _ = engine.cancelEvent(sendID: cancelSendID)
                    } else {
{% if 'error.execution' in model.events %}
                        engine.raise(EventWithMetadata.platformError({{ machine_name }}Event.{{ 'error.execution' | to_event_variant }}, message: "<cancel> sendidexpr failed to evaluate"))
{% endif %}
{% if in_action_block is defined and in_action_block %}
                        break sceBlock  // W3C SCXML 4.9: the error ends the block
{% endif %}
                    }
                }
{% endif %}
