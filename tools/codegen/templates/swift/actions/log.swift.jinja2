{# W3C SCXML 4.7: Log action. The label is a string literal, escaped for it where
   the template writes it (`generator::register_template`), and a value is shown
   as Swift shows it, never as a format. #}
{%- set label = action.label | default('') -%}
{% if action.native_code %}
{# `datamodel="sce-static"`: the whole statement was lowered to Swift. #}
{% include 'actions/_native_statement.swift.jinja2' %}
{% else %}
                print("{{ label | escape_swift }}")
{% endif %}
