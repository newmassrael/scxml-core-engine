{% for invoke_info in (state.invokes | scxml) + (state.invokes | hybrid) %}
{% set ns_invokes.all = ns_invokes.all + [invoke_info] %}
{% endfor %}
{% endfor %}
{% set child_invokes = ns_invokes.all %}
{# The `<invoke>`s a host runs (W3C SCXML 6.4.1): deferred and executed beside the child
   sessions, and handed to the invoker the host registered for their type. #}
{% set ns_host = namespace(all=[]) %}
{% for state_id, state in model.states | dictsort %}
{% for invoke_info in state.invokes | host_invoker %}
{% set ns_host.all = ns_host.all + [invoke_info] %}
{% endfor %}
{% endfor %}
{% set host_invokes = ns_host.all %}
