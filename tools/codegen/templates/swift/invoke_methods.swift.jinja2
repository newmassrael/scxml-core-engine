{#
    Invoke Methods Template (Swift Jinja2)

    W3C SCXML 6.4: the child sessions a machine's `<invoke>`s start.

    Generates, for the static child sessions of the document:
    - the pending and the active invocations, and each one's session
    - executePendingInvokes(engine:), tickChildren(engine:), settleChildren(engine:)
    - forwardToAutoforwardChildren(eventName:metadata:engine:)
    - the delivery and the running questions a `<send>` to a child asks
    - nextChildDeadline()

    The Swift twin of go/invoke_methods.go.jinja2. A child is an `InvokedSession`
    of its own policy type, one conformance written once in the runtime where Go
    writes a wrapper type per invoke. The entry that defers an invoke is in
    entry_exit_actions.swift.jinja2, and the exit that cancels it.

    What an invocation hands its child (`<param>`, `namelist`) is the value the static
    lowering wrote for each (`native_seed`), given to the child's `acceptParams`
    before it initializes. An `idlocation` is the id each start is started under, written to
    the string variable it names by the statement the static lowering wrote
    (`native_idlocation`, docs/adr/0045) or, for an `ecmascript` parent, by its engine. What
    the child hands back (`<finalize>`) and every other way of running one are refused
    before this template runs (`swift_invoke_unlowered`).
#}
{# W3C SCXML 6.4.1 + 6.4.3: what an invocation hands the child it starts, before the
   child initializes. `seeds` are the arguments the child declares a variable for: each
   is the value of that variable, in the slot of `InvokeParams` named as the variable's
   property is (`SwiftTarget::field_name`), and a value that cannot be computed is
   reported and left out (5.7.1), so the child starts with the one its `<data>` gave it.
   `unkept` are the arguments it declares none for: a hybrid invoke hands every
   candidate the same arguments, so each is evaluated and left out, and one that cannot
   be evaluated costs `error.execution` all the same, because an argument is the
   invoke's whatever the child keeps. #}
{% macro seed_child(child_type, seeds, unkept, model, machine_name, indent) %}
{% set seeded = seeds | selectattr('native_seed') | list %}
{% if seeded %}
{{ indent }}var seed = {{ child_type }}.InvokeParams()
{% for param in seeded %}
{{ indent }}do {
{% if param.native_fails %}
{{ indent }}    let sceValue: {{ param.native_seed_type }} = {{ param.native_seed }}
{{ indent }}    seed.v{{ param.name | to_pascal_case }} = sceValue
{{ indent }}} catch {
{% if 'error.execution' in model.events %}
{{ indent }}    engine.raise(EventWithMetadata.platformError({{ machine_name }}Event.{{ 'error.execution' | to_event_variant }}, message: "<invoke> <param name='{{ param.name | escape_swift }}'> could not be read"))
{% endif %}
{% else %}
{{ indent }}    seed.v{{ param.name | to_pascal_case }} = {{ param.native_seed }}
{% endif %}
{{ indent }}}
{% endfor %}
{{ indent }}childPolicy.acceptParams(seed)
{% endif %}
{% for param in unkept %}
{% if param.native_value and param.native_fails %}
{{ indent }}do {
{{ indent }}    let _: WireValue = {{ param.native_value }}
{{ indent }}} catch {
{% if 'error.execution' in model.events %}
{{ indent }}    engine.raise(EventWithMetadata.platformError({{ machine_name }}Event.{{ 'error.execution' | to_event_variant }}, message: "<invoke> <param name='{{ param.name | escape_swift }}'> could not be read"))
{% endif %}
{{ indent }}}
{% endif %}
{% endfor %}
{% endmacro %}
{# W3C SCXML 6.4.1 + 6.4.3, under `datamodel="ecmascript"`: the same hand-over, with each value
   read once by the engine (`evaluateSeed`: a scalar as the value itself, anything else as its JSON,
   because JSON cannot write every number) and given to the child's `acceptSeeds` by the name of the
   `<param>` or of the namelist entry. Every name read is handed, and none is filtered here: the
   child alone decides what it takes (§scxml-6.4). Its top-level `<data>` of that name takes it in
   place of its own value; a state's `<data>` never does, and a name no top-level `<data>` of the
   child declares is dropped there. A `<param>` that cannot be
   read is reported and left out (5.7.1); a namelist name the document does not declare is an argument
   error of the element, which ends it (its name is never resolved at build time, as
   `<send namelist>`'s is not). #}
{# W3C SCXML 5.7.1 + 6.4.1: every argument is read when the invocation starts, whether or not the
   child keeps it. A `<param>` that cannot be read (an expression that fails, or `location=""`
   naming no location) costs one error.execution and its pair, and the child still starts. A
   child that runs no script engine has no variable to take a value, so what it is handed is read
   (for its errors) and not given. A namelist that names something other than a declared
   variable ends the element before this macro runs (`namelist_bad`, below). #}
{# The first name of a namelist that is not a declared variable, or nothing: such a name is not a
   readable location, which the build decides once (W3C SCXML 6.4). #}
{% macro first_undeclared_name(namelist) -%}
{%- set found = namespace(name='') -%}
{%- for namelist_id in (namelist or '') | split -%}
{%- if namelist_id is not declared_name and not found.name -%}{%- set found.name = namelist_id -%}{%- endif -%}
{%- endfor -%}
{{- found.name -}}
{%- endmacro %}
{# `child_takes` says whether the child the values go to runs an engine that can take them; it is
   the invoke's own `child_needs_script_engine` unless the caller names the child (a hybrid invoke
   names its candidates one by one). #}
{% macro ecma_seed_child(invoke_info, model, machine_name, indent, child_takes=none) %}
{% set takes = invoke_info.child_needs_script_engine if child_takes is none else child_takes %}
{% if invoke_info.params or (invoke_info.namelist and invoke_info.namelist | trim) %}
{% if takes %}
{{ indent }}var seeds: [String: LuaSeed] = [:]
{% endif %}
{% for param in invoke_info.params %}
{% if param.is_static_literal %}
{% if takes %}
{{ indent }}seeds["{{ param.name | escape_swift }}"] = .scalar(.string("{{ param.static_value | escape_swift }}"))
{% endif %}
{% elif param.expr or param.location %}
{{ indent }}if let seedValue = evaluateSeed("{{ (param.expr or param.location) | to_lua_expr | escape_swift }}") {
{% if takes %}
{{ indent }}    seeds["{{ param.name | escape_swift }}"] = seedValue
{% else %}
{{ indent }}    _ = seedValue
{% endif %}
{{ indent }}} else {
{{ indent }}    raiseExecutionError("<invoke> <param name='{{ param.name | escape_swift }}'> could not be read", engine: engine)
{{ indent }}}
{% else %}
{{ indent }}raiseExecutionError("<invoke> <param name='{{ param.name | escape_swift }}'> names no location", engine: engine)
{% endif %}
{% endfor %}
{% for namelist_id in (invoke_info.namelist or '') | split %}
{{ indent }}if let seedValue = evaluateSeed("{{ namelist_id | to_lua_expr | escape_swift }}") {
{% if takes %}
{{ indent }}    seeds["{{ namelist_id | escape_swift }}"] = seedValue
{% else %}
{{ indent }}    _ = seedValue
{% endif %}
{{ indent }}} else {
{{ indent }}    raiseExecutionError("<invoke> namelist entry '{{ namelist_id | escape_swift }}' could not be read", engine: engine)
{{ indent }}}
{% endfor %}
{% if takes %}
{{ indent }}childPolicy.acceptSeeds(seeds)
{% endif %}
{% endif %}
{% endmacro %}
