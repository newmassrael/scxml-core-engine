        drainAndRaiseChildEvents(
            childEngine: child,
            activeInvokes: activeInvokes,
            invokeKey: "{{ invoke_info.invoke_id | escape_swift }}",
            engine: engine
        )
        if child.isInFinalState {
            sceInvokeDone{{ invoke_info.field_suffix | to_pascal_case }} = true
            // SCE_MESH.md §21.5: the session reached its top-level `<final>`, so its router
            // is told once.
            child.detachMesh()
            raiseDoneInvoke(invokeID: "{{ invoke_info.invoke_id | escape_swift }}", donedata: child.donedataAtFinal, engine: engine)
        }
    }
{% endfor %}
{% for invoke_info in host_invokes %}

    /// Starts `<invoke type="{{ invoke_info.invoke_type }}" id="{{ invoke_info.invoke_id }}">`
    /// (W3C SCXML 6.4.1): the invoker the host registered for the type is handed the
    /// request, under the id the DOCUMENT wrote, which is the name `done.invoke.<id>`
    /// carries. A type the host declared and never registered an invoker for is the same
    /// fact as an unsupported one, so the same event, and not a silence that reads as
    /// started.
    private func sceStartHostInvoke{{ invoke_info.field_suffix | to_pascal_case }}(engine: Engine<{{ machine_name }}Policy>) {
{% set host_namelist_bad = (first_undeclared_name(invoke_info.namelist) | trim) if ecmascript_datamodel else '' %}
{% if host_namelist_bad %}
        // W3C SCXML 6.4: the namelist names a location that cannot be read, so the element ends here: one
        // error.execution however many names are bad, no request is made and no invoker is asked.
        raiseExecutionError("<invoke> namelist names a location that cannot be read", engine: engine)
{% else %}
{% if ecmascript_datamodel %}
        // W3C SCXML 6.4.1: what the request says is evaluated now, when the invocation starts, by the engine
        // that runs the document: the `src` and the `<content>`, then the namelist and the `<param>`s, each
        // run once and read as the text a form carries and as the typed JSON the event data holds. A value
        // that cannot be evaluated is an argument of the element that cannot be, which raises error.execution
        // and starts nothing (W3C SCXML 5.7.1).
{% if invoke_info.idlocation %}
        // W3C SCXML 6.4.1: the id of the invocation goes to the location `idlocation` names before the
        // request is read.
        if !assignData("{{ invoke_info.idlocation | to_lua_location | escape_swift }}", "\"{{ invoke_info.invoke_id | escape_swift }}\"") {
            raiseExecutionError("<invoke> idlocation could not be written", engine: engine)
        }
{% endif %}
{% if invoke_info.srcexpr %}
        guard let hostSrc = evaluateText("{{ invoke_info.srcexpr | to_lua_expr | escape_swift }}") else {
            raiseExecutionError("<invoke> srcexpr failed to evaluate", engine: engine)
            return
        }
{% endif %}
{% if invoke_info.contentexpr %}
        guard let hostContent = evaluateText("{{ invoke_info.contentexpr | to_lua_expr | escape_swift }}") else {
            raiseExecutionError("<invoke> content expr failed to evaluate", engine: engine)
            return
        }
{% endif %}
{% set host_namelist = (invoke_info.namelist or '') | trim %}
{% set host_unnamed = invoke_info.params | rejectattr('is_static_literal') | rejectattr('expr') | rejectattr('location') | list %}
{% if invoke_info.params or host_namelist %}
        var hostParams: [String: [String]] = [:]
        var hostParts: [PayloadPair] = []
{% endif %}
{% if host_unnamed %}
        var requestRefused = false
{% endif %}
{% for namelist_id in (invoke_info.namelist or '') | split %}
        if let wire = evaluateWire("{{ namelist_id | to_lua_expr | escape_swift }}") {
            hostParams["{{ namelist_id | escape_swift }}", default: []].append(wire.text)
            hostParts.append(PayloadPair.json("{{ namelist_id | escape_swift }}", rawJSON: wire.json))
        } else {
            raiseExecutionError("<invoke> namelist entry '{{ namelist_id | escape_swift }}' failed to evaluate", engine: engine)
            return
        }
{% endfor %}
{% for param in invoke_info.params %}
{% if param.is_static_literal %}
        hostParams["{{ param.name | escape_swift }}", default: []].append("{{ param.static_value | escape_swift }}")
{% if not param.envelope_metadata %}
        hostParts.append(PayloadPair("{{ param.name | escape_swift }}", .text("{{ param.static_value | escape_swift }}")))
{% endif %}
{% elif param.expr or param.location %}
        if let wire = evaluateWire("{{ (param.expr or param.location) | to_lua_expr | escape_swift }}") {
            hostParams["{{ param.name | escape_swift }}", default: []].append(wire.text)
{% if not param.envelope_metadata %}
            hostParts.append(PayloadPair.json("{{ param.name | escape_swift }}", rawJSON: wire.json))
{% endif %}
        } else {
            raiseExecutionError("<invoke> <param name='{{ param.name | escape_swift }}'> failed to evaluate", engine: engine)
            return
        }
{% else %}
        raiseExecutionError("<invoke> <param name='{{ param.name | escape_swift }}'> names no location", engine: engine)
        requestRefused = true
{% endif %}
{% endfor %}
{% if host_unnamed %}
        if requestRefused {
            return
        }
{% endif %}
{% elif invoke_info.params %}
{% set refusing = invoke_info.params | selectattr('native_fails') | list %}
        // W3C SCXML 6.4.1: what the request says is evaluated now, when the invocation
        // starts. The text the host reads is the one each value spells; the JSON is the
        // typed pairs, written once, so a host that forwards the request forwards the
        // engine's serialisation. A value that cannot be evaluated starts nothing.
        var hostParams: [String: [String]] = [:]
        var hostParts: [PayloadPair] = []
{% if refusing %}
        var requestRefused = false
{% endif %}
{% for param in invoke_info.params %}
{% if param.is_static_literal %}
        appendFormParam(&hostParams, "{{ param.name | escape_swift }}", .text("{{ param.static_value | escape_swift }}"))
{% if not param.envelope_metadata %}
        hostParts.append(PayloadPair("{{ param.name | escape_swift }}", .text("{{ param.static_value | escape_swift }}")))
{% endif %}
{% elif param.native_value %}
{# `datamodel="sce-static"`: the value is native code over the machine's own fields, shown
   to fit its field where the document was judged, so the only way it fails to be a value is
   a checked operation that overflows: the evaluation that failed, which refuses the request
   as any value its field cannot hold. #}
        do {
            let sceValue: WireValue = {{ param.native_value }}
            appendFormParam(&hostParams, "{{ param.name | escape_swift }}", sceValue)
{% if not param.envelope_metadata %}
            hostParts.append(PayloadPair("{{ param.name | escape_swift }}", sceValue))
{% endif %}
{% if param.native_fails %}
        } catch {
{% if 'error.execution' in model.events %}
            engine.raise(EventWithMetadata.platformError({{ machine_name }}Event.{{ 'error.execution' | to_event_variant }}, message: "<invoke> <param name='{{ param.name | escape_swift }}'> cannot be its request field: it failed to evaluate"))
{% endif %}
            requestRefused = true
{% endif %}
        }
{% endif %}
{% endfor %}
{% if refusing %}
        if requestRefused {
            return
        }
{% endif %}
{% endif %}
{% for attribute, value, fails in [('srcexpr', invoke_info.native_src, invoke_info.native_src_fails), ('content expr', invoke_info.native_content, invoke_info.native_content_fails)] %}
{% if value %}
{% set variable = 'hostSrc' if attribute == 'srcexpr' else 'hostContent' %}
{# `datamodel="sce-static"`: the string is computed from the machine's own fields as the
   invocation starts (`UnsupportedInvokeInfo::native_src`, `native_content`); no script engine
   is asked. One that cannot be computed is an attribute that cannot be evaluated, which
   raises error.execution and starts nothing (W3C SCXML 6.4.1). #}
        let {{ variable }}: String
        do {
{% if fails %}
            let sceValue: String = {{ value }}
            {{ variable }} = sceValue
        } catch {
{% if 'error.execution' in model.events %}
            engine.raise(EventWithMetadata.platformError({{ machine_name }}Event.{{ 'error.execution' | to_event_variant }}, message: "<invoke> {{ attribute }} failed to evaluate"))
{% endif %}
            return
{% else %}
            {{ variable }} = {{ value }}
{% endif %}
        }
{% endif %}
{% endfor %}
        let request = HostInvokeRequest(
            processorType: "{{ invoke_info.invoke_type | escape_swift }}",
            invokeID: "{{ invoke_info.invoke_id | escape_swift }}",
{% if invoke_info.native_src or (ecmascript_datamodel and invoke_info.srcexpr) %}
            src: hostSrc,
{% elif invoke_info.src %}
            src: "{{ invoke_info.src | escape_swift }}",
{% endif %}
{% if invoke_info.params or (ecmascript_datamodel and (invoke_info.namelist or '') | trim) %}
            params: hostParams,
            eventData: hostParts.isEmpty ? "" : payloadJSON(hostParts),
{% endif %}
{% if invoke_info.native_content or (ecmascript_datamodel and invoke_info.contentexpr) %}
            content: hostContent,
{% elif invoke_info.content %}
            content: "{{ invoke_info.content | escape_swift }}",
{% endif %}
            sessionID: sessionID
        )
        if !engine.performHostInvoke(request) {
{% if 'error.execution' in model.events %}
            engine.raise(EventWithMetadata.platformError({{ machine_name }}Event.{{ 'error.execution' | to_event_variant }}, message: "<invoke> names an invoker the host declared but never registered"))
{% endif %}
        }
{% endif %}
    }
{% endfor %}
{% if child_invokes %}

    /// Ticks the running sessions (W3C SCXML 6.4): what a child sent before is taken
    /// first, then the child takes its turn, then what it sent in it.
    public func tickChildren(engine: Engine<{{ machine_name }}Policy>) {
{% for invoke_info in child_invokes %}
        if !sceInvokeDone{{ invoke_info.field_suffix | to_pascal_case }}, let child = sceInvokeChild{{ invoke_info.field_suffix | to_pascal_case }} {
            drainAndRaiseChildEvents(
                childEngine: child,
                activeInvokes: activeInvokes,
                invokeKey: "{{ invoke_info.invoke_id | escape_swift }}",
                engine: engine
            )
            child.applyMeshCalls()
            child.tick()
            sceSettleInvoke{{ invoke_info.field_suffix | to_pascal_case }}(engine: engine)
        }
{% endfor %}
    }

    /// Settles what every running child sent this machine while a delivery drove it
    /// (docs/adr/0045): one body for every drive of a child, so a save at any boundary
    /// of this session finds its buffer empty.
    public func settleChildren(engine: Engine<{{ machine_name }}Policy>) {
{% for invoke_info in child_invokes %}
        sceSettleInvoke{{ invoke_info.field_suffix | to_pascal_case }}(engine: engine)
{% endfor %}
    }

    /// The nearest deadline of a running child (W3C SCXML 6.4), so a host that walks
    /// time by `timeUntilNextScheduled` does not step over a timer a child armed. A
    /// child that has ended is skipped: the policy keeps it until its state exits, and
    /// what it armed is no longer owed.
    public func nextChildDeadline() -> Duration? {
        var soonest: Duration?
{% for invoke_info in child_invokes %}
        if !sceInvokeDone{{ invoke_info.field_suffix | to_pascal_case }}, let due = sceInvokeChild{{ invoke_info.field_suffix | to_pascal_case }}?.timeUntilNextScheduled() {
            soonest = soonest.map { min($0, due) } ?? due
        }
{% endfor %}
        return soonest
    }
{% set autoforward_invokes = child_invokes | selectattr('autoforward') | list %}
{% if autoforward_invokes %}

    /// Forwards what this machine received to the children that autoforward
    /// (W3C SCXML 6.4.1). The copy is exact: the child sees the `_event` fields the
    /// parent saw. The event's name is not consulted, since Appendix D forwards what
    /// it dequeued from the external queue, and `done.invoke.<id>` comes back onto that
    /// queue (6.4.2), so a sibling still running sees it.
    public func forwardToAutoforwardChildren(eventName: String, metadata: EventMetadata, engine: Engine<{{ machine_name }}Policy>) {
{% for invoke_info in autoforward_invokes %}
        if let child = sceInvokeChild{{ invoke_info.field_suffix | to_pascal_case }}, activeInvokes["{{ invoke_info.invoke_id | escape_swift }}"]?.autoforward == true {
            child.raiseExternalByNameWithMeta(eventName, metadata: metadata)
        }
{% endfor %}
    }
{% endif %}
{% set finalize_invokes = child_invokes | selectattr('finalize_content') | list %}
{% if finalize_invokes and ecmascript_datamodel %}

    /// W3C SCXML 6.5: the `<finalize>` of the invocation an event came from runs before the
    /// parent selects transitions on that event, in the parent's data model, with `_event` the
    /// event the child sent. The invocation is the one whose session the event names as its
    /// sender (docs/adr/0090: the session id travels beside the origin, and nothing reads the
    /// origin's address to find a session); an event from anywhere else (the host, this
    /// machine itself) finalizes nothing.
    public func executeFinalizeForChildEvent(_ event: inout EventWithMetadata<{{ machine_name }}Event>, engine: Engine<{{ machine_name }}Policy>) {
        guard let sender = event.metadata.sender, !sender.isEmpty,
            let child = activeInvokes.values.first(where: { $0.sessionID == sender && !$0.finalizeScript.isEmpty })
        else {
            return
        }
        populateEventMetadata(event.metadata)
        bindCurrentEvent(event.event, engine: engine)
        if !executeScript(child.finalizeScript, name: "=finalize") {
            raiseExecutionError("<finalize> failed to execute", engine: engine)
        }
    }
{% endif %}

    /// Delivers a delayed `<send target="#_<invokeid>">` whose wait is over, by name:
    /// a child need not declare every event its parent sends (W3C SCXML 6.2 + 6.4).
    /// Whether the invocation was there to take it: one whose session has reached its
    /// final state has ended, and the engine reports the send it could not deliver
    /// (W3C SCXML C.1).
    public func deliverToInvocation(invokeID: String, eventName: String, eventData: String, sendID: String) -> Bool {
{% for invoke_info in child_invokes %}
        if invokeID.utf8.elementsEqual("{{ invoke_info.invoke_id | escape_swift }}".utf8) {
            if let child = sceInvokeChild{{ invoke_info.field_suffix | to_pascal_case }}, !child.isInFinalState {
                deliverToChild(child, eventName: eventName, eventData: eventData, sender: sessionID)
                return true
            }
            return false
        }
{% endfor %}
        return false
    }

    /// Whether `#_<invokeid>` names an invocation running now (W3C SCXML 6.4 + C.1):
    /// one whose session has reached its final state has ended, and a send naming it
    /// is reported when it is made.
    public func isInvocationRunning(_ invokeID: String) -> Bool {
{% for invoke_info in child_invokes %}
        if invokeID.utf8.elementsEqual("{{ invoke_info.invoke_id | escape_swift }}".utf8) {
            return sceInvokeChild{{ invoke_info.field_suffix | to_pascal_case }}.map { !$0.isInFinalState } ?? false
        }
{% endfor %}
        return false
    }

    /// Whether a session id names a child of this machine that is running now
    /// (W3C SCXML C.1): the test `deliverToChildSession` makes.
    public func isChildSessionRunning(_ childSessionID: String) -> Bool {
        if childSessionID.isEmpty {
            return false
        }
{% for invoke_info in child_invokes %}
        if let session = activeInvokes["{{ invoke_info.invoke_id | escape_swift }}"], session.sessionID.utf8.elementsEqual(childSessionID.utf8) {
            return sceInvokeChild{{ invoke_info.field_suffix | to_pascal_case }}.map { !$0.isInFinalState } ?? false
        }
{% endfor %}
        return false
    }

    /// Delivers an event addressed to a child's published location (W3C SCXML C.1).
    /// The parent mints `parentSession.invokeId` for each child and that id is what the
    /// child's `_ioprocessors` entry names, so a `<send>` whose target decodes to one of
    /// them is addressed to that child and not to this machine. False names no live
    /// child of ours, and the event takes the ordinary external path.
    public func deliverToChildSession(childSessionID: String, eventName: String, eventData: String) -> Bool {
        if !isChildSessionRunning(childSessionID) {
            return false
        }
{% for invoke_info in child_invokes %}
        if let session = activeInvokes["{{ invoke_info.invoke_id | escape_swift }}"], session.sessionID.utf8.elementsEqual(childSessionID.utf8),
           let child = sceInvokeChild{{ invoke_info.field_suffix | to_pascal_case }} {
            deliverToChild(child, eventName: eventName, eventData: eventData, sender: sessionID)
            return true
        }
{% endfor %}
        return false
    }
{% endif %}
{% endif %}
