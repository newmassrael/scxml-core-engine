{%- import '_macros/cpp_invoke_start.jinja2' as invoke_start %}

{#
    What a saved state asks of the policy (SCE Accepted Subset §2.15, docs/adr/0045): the hooks
    `SCE::Saved::EngineAccess` (`saved/SavedEngine.h`) calls on a policy of a document that
    saves, which only the document knows — the children it runs, the counts of their starts,
    the states that hold an `<invoke>`, how a child is judged, resumed and (for a format-1
    state) started again, and the tables of its `<history>` elements. The generated `saveAt`,
    `judge` and `restoreAt` of the machine read the variables.

    Port-of-Go template: `SavedPolicy` of tools/codegen/templates/go/state_machine.go.jinja2,
    and its Python twin `python/saved_policy.py.jinja2`.
#}

{#- docs/adr/0045, section 3, step 3: the child a saved state holds for the invoke `inv`,
    from the document whose stem is `stem`, built as starting it builds it and then restored
    from its saved session in place of initialized: no `<onentry>`, no `<data>`, no argument
    read, no `idlocation` written, nothing sent. `slot` is the member that holds it, `target`
    carries the host the child is built with (the invoke itself for a static child, the
    candidate for a hybrid one) and `mesh_document` is the stem the child's Mesh router is
    asked for. -#}
{% macro resume_child_method(inv, target, stem, slot, slot_suffix, mesh_document, finalize, model, ns_prefix) %}

    // docs/adr/0045: resume the child of the `<invoke>` `{{ inv.invoke_id }}` a saved state holds,
    // from the document `{{ stem }}`, where it stood.
    template <typename Engine>
    void resumeChild_{{ slot_suffix }}(Engine& engine, const ::SCE::Saved::SavedChild& child, std::int64_t wallNowMs) {
        // The id the child is known by: its parent's and the id of the start, which the
        // saved state holds and the judge has held to be so.
        const std::string childSessionId = child.session->sessionId;
        {{ slot }} = std::make_shared<::SCE::Generated::{{ ns_prefix }}{{ stem }}::{{ stem }}<SelfType>>({% if target.child_host_call %}{{ target.child_host_call }}, {% endif %}self_, child.invokeId, childSessionId{% if target.child_declares_host_duties %}, simulatedHost_{% endif %});

        // §scxml-6.4: the child's delayed sends are measured against the same clock as ours.
        {{ slot }}->setClock(engine.clock());

{{ invoke_start.child_session_record(inv, finalize, "        ") }}

{{ invoke_start.child_completion_callback(inv, slot, model, "        ") }}

        // docs/adr/0045: the tree's host invokers, handed on before the child's re-armed
        // invocations start at its first drive.
        engine.shareHostInvokersWith(*{{ slot }});

        {{ slot }}->restoreAt(*child.session, wallNowMs);

        // Child sessions in Mesh (SCE_MESH.md; docs/adr/0043): the router of the resumed
        // child is owed, not asked here. This machine is being restored, and its host
        // registers the factory of its children's routers only once the restore has returned.
        engine.oweChildMesh({{ slot }}, "{{ inv.invoke_id }}", "{{ mesh_document | escape_cpp }}");
    }
{%- endmacro %}

    // ── SCE Accepted Subset §2.15: what a saved state asks of this policy ──

    // The id of each `<invoke>` whose child session is running, in document order: a child
    // that has ended is not running, though the policy keeps it until its state exits, and its
    // `done.invoke` is in the external queue or already taken, so a restore must not bring it
    // back.
    std::vector<std::string> runningInvokes() const {
        std::vector<std::string> running;
{% for invoke_info in model.invokes | scxml_family %}
{% set child_targets = invoke_info.candidates if invoke_info.candidates else [{'stem': invoke_info.child_name}] %}
        if ({% for target in child_targets %}{% set slot = ('child_' ~ (invoke_info.field_suffix | candidate_identifier(target.stem)) ~ '_') if invoke_info.candidates else ('child_' ~ invoke_info.field_suffix ~ '_') %}({{ slot }} && !{{ slot }}->isInFinalState()){{ ' || ' if not loop.last }}{% endfor %}) {
            running.emplace_back("{{ invoke_info.invoke_id }}");
        }
{% endfor %}
        return running;
    }

    // How many times each `<invoke>` has started in this session, for each started at least
    // once, in document order.
    std::vector<::SCE::Saved::SavedInvokeStart> invokeStarts() const {
        std::vector<::SCE::Saved::SavedInvokeStart> starts;
{% for invoke_info in model.invokes | scxml_family %}
        if (invokeStarts_{{ invoke_info.field_suffix }}_ > 0) {
            starts.push_back(::SCE::Saved::SavedInvokeStart{"{{ invoke_info.invoke_id }}", static_cast<std::int64_t>(invokeStarts_{{ invoke_info.field_suffix }}_)});
        }
{% endfor %}
        return starts;
    }

    // The state that holds the `<invoke>` `invokeId`, and none for an id the document does not
    // invoke.
    static std::optional<State> invokeOwner([[maybe_unused]] const std::string& invokeId) {
{% for invoke_info in model.invokes | scxml_family %}
        if (invokeId == "{{ invoke_info.invoke_id }}") {
            return State::{{ invoke_info.state_name | capitalize }};
        }
{% endfor %}
        return std::nullopt;
    }

    // The state that holds the host-run `<invoke>` of this type and id, and none for one the
    // document does not have a host invoker run (§scxml-6.4.1).
    static std::optional<State> hostInvokeOwner([[maybe_unused]] const std::string& processorType,
                                                [[maybe_unused]] const std::string& invokeId) {
{% for invoke_info in model.invokes | host_invoker %}
        if (processorType == "{{ invoke_info.invoke_type | escape_cpp }}" && invokeId == "{{ invoke_info.invoke_id }}") {
            return State::{{ invoke_info.state_name | capitalize }};
        }
{% endfor %}
        return std::nullopt;
    }

    // ── The `<history>` elements, by the id a saved state keys them by ──

    // Their ids, by id.
    static std::vector<std::string> historyIds() {
        return { {% for history_id in model.history_states | list | sort %}"{{ history_id | escape_cpp }}"{{ ", " if not loop.last }}{% endfor %} };
    }

    // The history of the id `id`, and none for an id the document does not declare.
    static std::optional<History> historyFromId([[maybe_unused]] const std::string& id) {
{% for history_id in model.history_states | list | sort %}
        if (id == "{{ history_id | escape_cpp }}") {
            return History::{{ history_id | capitalize }};
        }
{% endfor %}
        return std::nullopt;
    }

    // Whether `history` is a deep history (§scxml-3.10), which records the atomic states below
    // its parent, and not a shallow one, which records its children.
    static bool historyIsDeep([[maybe_unused]] History history) {
{% for history_id, history_info in model.history_states | dictsort %}
{% if history_info.type == 'deep' %}
        if (history == History::{{ history_id | capitalize }}) {
            return true;
        }
{% endif %}
{% endfor %}
        return false;
    }

    // What `history` recorded, as a restore sets it.
    void setHistoryValue([[maybe_unused]] History history, [[maybe_unused]] std::vector<State> states) const {
{% for history_id in model.history_states | list | sort %}
        if (history == History::{{ history_id | capitalize }}) {
            history_{{ history_id }} = std::move(states);
            return;
        }
{% endfor %}
    }
{% if model.invokes | scxml_family %}

    // Each running child, saved through the document it runs with its whole state, in document
    // order: what a saved state holds in place of the ids of format 1, and what a restore
    // resumes (docs/adr/0045, section 1).
    std::vector<::SCE::Saved::SavedChild> savedChildren(std::int64_t wallNowMs) const {
        std::vector<::SCE::Saved::SavedChild> children;
        const std::string parentSessionId = sessionIdText();
{% for invoke_info in model.invokes | scxml_family %}
{% set child_targets = invoke_info.candidates if invoke_info.candidates else [{'stem': invoke_info.child_name}] %}
{% for target in child_targets %}
{% set slot = ('child_' ~ (invoke_info.field_suffix | candidate_identifier(target.stem)) ~ '_') if invoke_info.candidates else ('child_' ~ invoke_info.field_suffix ~ '_') %}
        if ({{ slot }} && !{{ slot }}->isInFinalState()) {
            ::SCE::Saved::SavedChild saved;
            saved.id = "{{ invoke_info.invoke_id }}";
            saved.start = static_cast<std::int64_t>(invokeStarts_{{ invoke_info.field_suffix }}_);
            // The id the child was started under is what follows its parent's id in its own.
            saved.invokeId = {{ slot }}->getPolicy().sessionIdText().substr(parentSessionId.size() + 1);
            saved.document = "{{ target.stem | escape_cpp }}";
            try {
                saved.session = std::make_shared<::SCE::Saved::SavedState>({{ slot }}->saveAt(wallNowMs));
            } catch (const ::SCE::Saved::StateRefusal& refused) {
                throw ::SCE::Saved::refusalWithin(refused, "invokes[" + std::to_string(children.size()) + "].session");
            }
            children.push_back(std::move(saved));
        }
{% endfor %}
{% endfor %}
        return children;
    }

    // Refuse a running child unless its session is a state of the document it names, to any
    // depth.
    static void judgeChild(const ::SCE::Saved::SavedChild& child) {
{% for invoke_info in model.invokes | scxml_family %}
{% set child_targets = invoke_info.candidates if invoke_info.candidates else [{'stem': invoke_info.child_name}] %}
{% for target in child_targets %}
        if (child.id == "{{ invoke_info.invoke_id }}" && child.document == "{{ target.stem | escape_cpp }}") {
            ::SCE::Generated::{{ cpp_ns_prefix }}{{ target.stem }}::{{ target.stem }}<SelfType>::judge(*child.session);
            return;
        }
{% endfor %}
{% endfor %}
        throw ::SCE::Saved::StateRefusal("invokes names '" + child.id + "' running '" + child.document + "', a document that `<invoke>` does not start");
    }

    // Resume each of `children` in the order given, each built as starting it builds it and
    // restored where it stood.
    template <typename Engine>
    void resumeChildren(Engine& engine, const std::vector<::SCE::Saved::SavedChild>& children, std::int64_t wallNowMs) {
        for (const ::SCE::Saved::SavedChild& child : children) {
{% for invoke_info in model.invokes | scxml_family %}
{% set child_targets = invoke_info.candidates if invoke_info.candidates else [{'stem': invoke_info.child_name}] %}
{% for target in child_targets %}
{% set slot_suffix = (invoke_info.field_suffix | candidate_identifier(target.stem)) if invoke_info.candidates else invoke_info.field_suffix %}
            if (child.id == "{{ invoke_info.invoke_id }}" && child.document == "{{ target.stem | escape_cpp }}") {
                resumeChild_{{ slot_suffix }}(engine, child, wallNowMs);
                continue;
            }
{% endfor %}
{% endfor %}
            throw ::SCE::Saved::StateRefusal("invokes names '" + child.id + "' running '" + child.document + "', a document that `<invoke>` does not start");
        }
    }
{% for invoke_info in model.invokes | scxml_family %}
{% if invoke_info.candidates %}
{% for candidate in invoke_info.candidates %}
{% set slot_suffix = invoke_info.field_suffix | candidate_identifier(candidate.stem) %}
{{ resume_child_method(invoke_info, candidate, candidate.stem, "child_" ~ slot_suffix ~ "_", slot_suffix, candidate.stem, "", model, cpp_ns_prefix) }}
{% endfor %}
{% else %}
{% set mesh_document = '' if (invoke_info.src is not defined or not invoke_info.src or invoke_info.src.startswith('#')) else invoke_info.child_name %}
{{ resume_child_method(invoke_info, invoke_info, invoke_info.child_name, "child_" ~ invoke_info.field_suffix ~ "_", invoke_info.field_suffix, mesh_document, invoke_info.finalize_content | default('', true) | replace('"', '\"'), model, cpp_ns_prefix) }}
{% endif %}
{% endfor %}
{% else %}

    // The document starts no child session, so none is saved.
    std::vector<::SCE::Saved::SavedChild> savedChildren([[maybe_unused]] std::int64_t wallNowMs) const {
        return {};
    }

    // Refuse a running child, which this document does not start.
    static void judgeChild(const ::SCE::Saved::SavedChild& child) {
        throw ::SCE::Saved::StateRefusal("the document starts no child session, so '" + child.id + "' cannot be one it was running");
    }

    // Resume no child, which this document does not start.
    template <typename Engine>
    void resumeChildren([[maybe_unused]] Engine& engine, const std::vector<::SCE::Saved::SavedChild>& children,
                        [[maybe_unused]] std::int64_t wallNowMs) {
        if (!children.empty()) {
            judgeChild(children.front());
        }
    }
{% endif %}

    // Start each of `ids` again from its beginning, as entering its state starts it: the start
    // is deferred to the macrostep the host drives next, which runs it, so the restore itself
    // takes no step. What a format-1 saved state holds of a running child is its id alone
    // (docs/adr/0045).
    template <typename Engine>
    void restartInvokes([[maybe_unused]] Engine& engine, [[maybe_unused]] const std::vector<std::string>& ids) {
{% if model.invokes | scxml_family %}
        for (const std::string& id : ids) {
{% for state_id, state in model.states | dictsort %}
{% for invoke_info in state.invokes | scxml %}
            if (id == "{{ invoke_info.invoke_id }}") {
{{ invoke_start.defer_scxml_invoke(invoke_info, state_id, "                ", "restarted") }}
            }
{% endfor %}
{% for invoke_info in state.invokes | hybrid %}
            if (id == "{{ invoke_info.invoke_id }}") {
{{ invoke_start.defer_scxml_invoke(invoke_info, state_id, "                ", "restarted hybrid") }}
            }
{% endfor %}
{% endfor %}
        }
{% endif %}
    }
