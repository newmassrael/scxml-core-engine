{% set event_tables = namespace(by_name=[], names=[]) %}
{% for event_name in leaf_events | sort %}
{% set event_tables.by_name = event_tables.by_name + [['"' ~ (event_name | event_wire_name) ~ '"', machine_name ~ "Event." ~ (event_name | to_event_ref)]] %}
{% set event_tables.names = event_tables.names + [["is " ~ machine_name ~ "Event." ~ (event_name | to_event_ref), '"' ~ (event_name | event_wire_name) ~ '"']] %}
{% endfor %}
{{ dispatch.bounded_when("resolveEventByName", "override fun resolveEventByName(name: String): " ~ machine_name ~ "Event?", "name: String", "name", "name", event_tables.by_name, machine_name ~ "Event?", "null", false) }}

