{#
    Kotlin Entry/Exit Actions Template

    W3C SCXML 3.8/3.9: Entry and exit action rendering, one state at a time.
    Which states a microstep enters and exits, and in which order, is the
    runtime's Appendix D (com.sce.runtime.Microstep): it adds a state to the
    configuration and calls onEntry, records a state's histories and removes it
    before calling onExit. Nothing here enters or exits another state.

    W3C SCXML 3.7: Final state done.state event emission.
    W3C SCXML 3.7.1: Parallel state completion detection.
    W3C SCXML 3.3: `<initial>` transition content, on default entry only.
    W3C SCXML 3.10.2: `<history>` default transition content.

    Uses actions/_render.kt.jinja2 for action dispatch (shared with transition_actions).
#}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}
{%- import 'param_macros.kt.jinja2' as param_macros %}

    // Entry Actions (W3C SCXML 3.8)
    {# SCE Protocol-Synthesis RFC §synth-5-O — function-scope SCE-MAP marker
       above the `onEntry` / `onExit` overrides. Kotlin's macro form is
       a plain `// SCE-MAP:` comment — non-syntactic, no compile cost. #}
    {{ sce_map.source_marker(model.source_location, "kotlin", symbol_artifact=sce_artifact.machine) }}
    override fun onEntry(state: {{ machine_name }}State, isDefaultEntry: Boolean) {
        when (state) {
{% for state_id in model.states | sort %}
{% set state = model.states[state_id] %}
{% set has_done_event = state.is_final and state.parent %}
{% set is_top_final = state.is_final and not state.parent %}
{% set has_invokes = state_id in invoke_entries %}
{% set has_late_datamodel = model.needs_script_engine and model.binding == 'late' and state.datamodel %}
{# W3C SCXML 3.7.1: Check if this final state's grandparent is parallel #}
{% set grandparent_is_parallel = false %}
{% if state.is_final and state.parent %}
{% set parent_state = model.states[state.parent] %}
{% if parent_state.parent and model.states[parent_state.parent].is_parallel %}
{% set grandparent_is_parallel = true %}
{% set parallel_grandparent_id = parent_state.parent %}
{% endif %}
{% endif %}
            is {{ machine_name }}State.{{ state_id | to_state_class_name }} -> {  {{- annot.annotation_comment(state, "kotlin", "                ") }}
{% if state.source_location %}
                {{ sce_map.source_marker(state.source_location, "kotlin", stmt_level=true, symbol_state=state_id, symbol_artifact=sce_artifact.state_body) | trim }}
{% endif %}
{% if has_late_datamodel %}
                // W3C SCXML 5.3: Late binding — initialize state-level datamodel on entry
                run {
                    ensureScriptEngine()
                    val engine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
                    val sid = scriptSessionId ?: error("scriptSessionId must be initialized after ensureScriptEngine() (codegen invariant)")
{% for dm_var in state.datamodel %}
{% if dm_var.expr %}
                    try {
                        val v = engine.evaluateExpr(sid, {{ dm_var.expr | to_script_source_expr }})
                        engine.setVariable(sid, "{{ dm_var.id }}", v)
                    } catch (e: Exception) {
                        raisePlatformError({{ machine_name }}Event.Error.Execution, "<data id='{{ dm_var.id }}'> expr failed to evaluate")
                    }
{% elif dm_var.content %}
                    try {
                        val v = engine.parseDataValue(sid, "{{ dm_var.content | escape_kotlin }}")
                        engine.setVariable(sid, "{{ dm_var.id }}", v)
                    } catch (e: Exception) {
                        raisePlatformError({{ machine_name }}Event.Error.Execution, "<data id='{{ dm_var.id }}'> content failed to initialise")
                    }
{% else %}
                    engine.setVariable(sid, "{{ dm_var.id }}", null)
{% endif %}
{% endfor %}
                }
{% endif %}
{% if state.on_entry_blocks | length > 1 %}
{% for block in state.on_entry_blocks %}
                // W3C SCXML 3.8: Onentry block {{ loop.index }}/{{ state.on_entry_blocks | length }}
                // C++ EntryExitHelper pattern: each block executes independently
                // Action-level error handling (try-catch in each action) provides isolation
                run {
{% set in_run_block = true %}
{% for action in block %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "kotlin", "                    ") -}}
{%- endif %}
    {% include 'actions/_render.kt.jinja2' with context %}
{% endfor %}
                }
{% endfor %}
{% elif state.on_entry_blocks %}
{% set in_run_block = false %}
{% for action in state.on_entry_blocks[0] %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "kotlin", "                ") -}}
{%- endif %}
    {% include 'actions/_render.kt.jinja2' with context %}
{% endfor %}
{% endif %}
{% if has_invokes %}
{% for inv in invoke_entries[state_id] %}
{% if inv.is_unsupported is defined and inv.is_unsupported and inv.host_served is defined and inv.host_served %}
                // W3C SCXML 6.4.1: the host declared this `type`, so the
                // deferred closure STARTS the invocation rather than refusing
                // it. Deferred like its sibling so §scxml-6.4 ordering holds —
                // an invoke runs at macrostep end — and so a state that exits
                // first never starts it at all.
                //
                // The id handed to the host is the DOCUMENT's, not the
                // per-instance one the pending queue carries:
                // `done.invoke.<id>` is the name the author wrote a transition
                // for, so it is the name the host must answer on.
                run {
                    val generatedInvokeId = "{{ inv.state_id }}.${System.identityHashCode(this)}.{{ inv.invoke_id }}"
                    deferInvoke(state, generatedInvokeId) {
{% set host_evaluates = inv.srcexpr or inv.namelist or inv.contentexpr or inv.idlocation or (inv.params | selectattr('is_static_literal', 'equalto', False) | list | length > 0) %}
{% if host_evaluates and model.needs_script_engine %}
                        // W3C SCXML 6.4.1: what the request says is evaluated
                        // now, when the invocation starts. An attribute that
                        // cannot be evaluated raises error.execution and starts
                        // nothing; a `<param>` that cannot is reported and
                        // dropped (W3C SCXML 5.7.1) while the invocation starts.
                        ensureScriptEngine()
                        val hostEngine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
                        val hostSid = scriptSessionId ?: error("scriptSessionId must be initialized after ensureScriptEngine() (codegen invariant)")
{% endif %}
{% if inv.idlocation and model.needs_script_engine %}
                        // W3C SCXML 6.4.1: the invocation's generated id goes
                        // to `idlocation` when the element is evaluated. It is
                        // the id the host is handed and `done.invoke.<id>`
                        // names, so the document can match on what it stored.
                        // The write is the assignment `<assign>` makes, so a
                        // location that cannot take the id starts nothing.
                        if (!storeIdInLocation({{ inv.idlocation | to_script_source_location }}, "{{ inv.invoke_id | escape_kotlin }}", "<invoke>")) return@deferInvoke
{% endif %}
{% if model.needs_script_engine %}
{% for attr, var, expr in [('src', 'hostInvokeSrc', inv.srcexpr), ('content', 'hostInvokeContent', inv.contentexpr)] %}
{% if expr %}
                        val {{ var }} = try {
                            valueToWireString(hostEngine.evaluateExpr(hostSid, {{ expr | to_script_source_expr }}))
                        } catch (_: Exception) {
                            raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke> {{ attr }}expr failed to evaluate")
                            return@deferInvoke
                        }
{% endif %}
{% endfor %}
{% endif %}
                        val hostInvokeParams = mutableMapOf<String, List<String>>()
{% if inv.namelist and model.needs_script_engine %}
{% for var_name in inv.namelist.split() %}
                        if (!hostEngine.hasVariable(hostSid, "{{ var_name }}")) {
                            raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke> namelist names '{{ var_name }}', which is not declared")
                            return@deferInvoke
                        }
                        try {
                            hostInvokeParams["{{ var_name }}"] =
                                (hostInvokeParams["{{ var_name }}"] ?: emptyList()) + valueToWireString(hostEngine.getVariable(hostSid, "{{ var_name }}"))
                        } catch (_: Exception) {
                            raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke> namelist entry '{{ var_name }}' failed to evaluate")
                            return@deferInvoke
                        }
{% endfor %}
{% endif %}
{{ param_macros.collect_wire_params_into(inv.params, model, 'hostInvokeParams', 'hostEngine', 'hostSid', machine_name, '<invoke>', '                        ') -}}
                        val started = performHostInvoke(
                            HostInvokeRequest(
                                processorType = "{{ inv.invoke_type | escape_kotlin }}",
                                invokeId = "{{ inv.invoke_id | escape_kotlin }}",
                                src = {% if inv.srcexpr %}hostInvokeSrc{% else %}"{{ inv.src | default('', true) | escape_kotlin }}"{% endif %},
                                params = hostInvokeParams,
                                content = {% if inv.contentexpr %}hostInvokeContent{% else %}"{{ inv.content | default('', true) | escape_kotlin }}"{% endif %}
                            )
                        )
                        if (!started) {
                            // W3C SCXML 6.4.1: declared but no invoker
                            // registered. The document asked for a process to
                            // be run and none was, which is the same fact as
                            // an unsupported type — so the same event, rather
                            // than a silence that reads as started.
                            raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke> names an invoker the host declared but never registered")
                        }
                    }
                }
{% elif inv.is_unsupported is defined and inv.is_unsupported %}
                // W3C SCXML 6.4.1: `type` names no processor this platform
                // implements. The deferred closure runs at macrostep end and
                // raises error.execution — no child is created, so nothing
                // follows and state exit has nothing to cancel beyond the
                // pending entry `cancelPendingInvokesForState` already drops.
                run {
                    val generatedInvokeId = "{{ inv.state_id }}.${System.identityHashCode(this)}.{{ inv.invoke_id }}"
                    deferInvoke(state, generatedInvokeId) {
                        raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke type='{{ inv.invoke_type | escape_kotlin }}'> names an external service this platform does not support")
                    }
                }
{% elif inv.is_hybrid is defined and inv.is_hybrid %}
                // W3C SCXML 6.4: Hybrid invoke — runtime expression evaluation + dynamic child
                // C++ parity: StateMachine::createFromSCXMLString() / FileLoadingHelper::loadScxmlFile()
                run {
                    val generatedInvokeId = "{{ inv.state_id }}.${System.identityHashCode(this)}.{{ inv.invoke_id }}"
{% if inv.idlocation and model.needs_script_engine %}
                    // W3C SCXML 6.4.1: the generated id goes to `idlocation` when the
                    // element is evaluated — this arm wrote nothing, so a document
                    // matching `_event.invokeid` against it matched an empty slot.
                    // The write is the assignment `<assign>` makes; a location that
                    // cannot take the id raises error.execution and defers nothing.
                    if (!storeIdInLocation({{ inv.idlocation | to_script_source_location }}, generatedInvokeId, "<invoke>")) return@run
{% endif %}
                    deferInvoke(state, generatedInvokeId) {
                        ensureScriptEngine()
                        val eng = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
                        val sid = scriptSessionId ?: error("scriptSessionId must be initialized after ensureScriptEngine() (codegen invariant)")
                        try {
{% if inv.srcexpr %}
                            // W3C SCXML 6.4.3: Evaluate srcexpr → file path → load SCXML → create child.
                            // The evaluation is its own try: the clause it answers is
                            // "the expression could not be evaluated", and until this
                            // split that fact shared a catch — and a wording — with
                            // "the child could not be started". A `null` result took
                            // neither path and returned silently.
                            val filePath = try {
                                eng.evaluateExpr(sid, {{ inv.srcexpr | to_script_source_expr }})?.toString()
                            } catch (_: Exception) {
                                null
                            }
                            if (filePath == null) {
                                raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke srcexpr='{{ inv.srcexpr | escape_kotlin }}'> could not be evaluated")
                                return@deferInvoke
                            }
{% if inv.candidates %}
                            // §scxml-6.4 + SCE_ACCEPTED_SUBSET.md §2.13: the value
                            // chooses among the declared candidates, matched on the
                            // document stem so `file:x.scxml` and `./x.scxml` name
                            // one child. `startInvoke` takes a star-projected
                            // machine, so only the construction differs here.
                            val __sceSelected = filePath
                                .substringAfterLast('/')
                                .substringAfterLast('\\')
                                .removePrefix("file:")
                                .substringBeforeLast('.')
                            val childSM = when (__sceSelected) {
{% for candidate in inv.candidates %}
                                "{{ candidate.stem | escape_kotlin }}" -> {{ candidate.stem | to_pascal_case }}StateMachine({% if inv.child_needs_script_engine %}scriptEngine ?: error("scriptEngine is required for invoke (codegen invariant: parent needs_script_engine == true)"){% endif %})
{% endfor %}
                                else -> {
                                    // The failure the Interpreter reports when a
                                    // document will not load: nothing to create.
                                    raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke srcexpr='{{ inv.srcexpr | escape_kotlin }}'> evaluated to a document it did not declare")
                                    return@deferInvoke
                                }
                            }
{% else %}
                            // §scxml-6.4: the child is the build-time stub, as on
                            // every other AOT backend. `filePath` is not consulted:
                            // the clause this arm answers is that the expression
                            // evaluates, and what the value NAMES is a residue this
                            // path does not honour (SCE_ACCEPTED_SUBSET.md §2.13).
                            @Suppress("UNUSED_VARIABLE") val _evaluated = filePath
                            val childSM = {{ inv.child_class }}StateMachine({% if inv.child_needs_script_engine %}scriptEngine ?: error("scriptEngine is required for invoke (codegen invariant: parent needs_script_engine == true)"){% endif %})
{% endif %}
{% elif inv.contentexpr %}
                            // W3C SCXML 6.4.4: Evaluate contentexpr → SCXML string → create child.
                            // Split for the reason the srcexpr arm above states.
                            val scxmlContent = try {
                                eng.evaluateExpr(sid, {{ inv.contentexpr | to_script_source_expr }})?.toString()
                            } catch (_: Exception) {
                                null
                            }
                            if (scxmlContent == null) {
                                raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke contentexpr='{{ inv.contentexpr | escape_kotlin }}'> could not be evaluated")
                                return@deferInvoke
                            }
                            // The stub, for the reason the srcexpr arm above states.
                            @Suppress("UNUSED_VARIABLE") val _evaluated = scxmlContent
                            val childSM = {{ inv.child_class }}StateMachine({% if inv.child_needs_script_engine %}scriptEngine ?: error("scriptEngine is required for invoke (codegen invariant: parent needs_script_engine == true)"){% endif %})
{% endif %}
                            startInvoke("{{ inv.invoke_id }}", childSM, {{ 'true' if inv.autoforward else 'false' }}, {% if inv.has_done_event %}{{ machine_name }}Event.{{ inv.done_event | to_event_ref }}{% else %}null{% endif %}, "", generatedInvokeId)
                        } catch (_: Exception) {
                            // W3C SCXML 6.4: the child could not be started. Evaluation
                            // failure no longer reaches here — it has its own raise above,
                            // under the one wording every emitter uses for that fact.
                            raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke> could not start a child")
                        }
                    }
                }
{% elif inv.child_class %}
                // W3C SCXML 6.4: Defer invoked child state machine until macrostep end
                run {
                    // W3C SCXML 3.12.1: Generate invoke ID in "stateid.platformid.index" format
                    val generatedInvokeId = "{{ inv.state_id }}.${System.identityHashCode(this)}.{{ inv.invoke_id }}"
{% if inv.idlocation and model.needs_script_engine %}
                    // W3C SCXML 6.4.1: Store generated invokeId in parent datamodel via
                    // idlocation, through the assignment `<assign>` makes — a member
                    // path lands, and a location that cannot take the id raises
                    // error.execution and the invocation is never deferred.
                    if (!storeIdInLocation({{ inv.idlocation | to_script_source_location }}, generatedInvokeId, "<invoke>")) return@run
{% endif %}
{% if (inv.params or inv.namelist) and model.needs_script_engine %}
                    // W3C SCXML 6.4: Evaluate params at defer time (parent context)
                    ensureScriptEngine()
                    val engineInv = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
                    val sidInv = scriptSessionId ?: error("scriptSessionId must be initialized after ensureScriptEngine() (codegen invariant)")
                    val invokeParams = mutableMapOf<String, Any?>()
{% for param in inv.params %}
{% if param.expr %}
                    // §scxml-5.7.1: a `<param>` whose expr will not evaluate costs
                    // `error.execution` on the internal queue AND the name and
                    // value — and nothing else. The clause delegates only the
                    // SUCCESSFUL name and value to the context ("Otherwise the use
                    // of the name and value depends on the context in which the
                    // <param> element occurs. See 5.5 <donedata>, 6.2 <send> and
                    // 6.4 <invoke>"), so §scxml-6.4.2's "terminate the processing
                    // of the element" is not reached by a failing `<param>`.
                    //
                    // This arm used to `return@run`, cancelling the whole invoke
                    // and raising nothing — the strictest reading of 6.4.2 with
                    // 5.7.1's reporting half dropped, so a document lost the child
                    // AND the event that would have explained why. The comment
                    // called that "the C++ pattern"; C++ does not cancel. The map
                    // insert is inside the `try`, so a failure leaves the name
                    // absent, which is the clause's other half.
                    try {
                        invokeParams["{{ param.name | escape_kotlin }}"] = engineInv.evaluateExpr(sidInv, {{ param.expr | to_script_source_expr }})
                    } catch (_: Exception) {
                        raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke> <param name='{{ param.name | escape_kotlin }}'> expr failed to evaluate")
                    }
{% endif %}
{% endfor %}
{% if inv.namelist %}
{% for var_name in inv.namelist.split() %}
                    // W3C SCXML 6.4.1: Namelist variable must exist in parent (C++ NamelistHelper pattern)
                    if (!engineInv.hasVariable(sidInv, "{{ var_name }}")) {
                        raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke> namelist names '{{ var_name }}', which the parent does not declare")
                        return@run  // C++ pattern: invoke cancelled on namelist error
                    }
                    invokeParams["{{ var_name }}"] = engineInv.getVariable(sidInv, "{{ var_name }}")
{% endfor %}
{% endif %}
{% endif %}
                    deferInvoke(state, generatedInvokeId) {
{% if inv.child_needs_script_engine %}
                        val childSM = {{ inv.child_class }}StateMachine(scriptEngine ?: error("scriptEngine is required for invoke (codegen invariant: parent needs_script_engine == true)"))
{% else %}
                        val childSM = {{ inv.child_class }}StateMachine()
{% endif %}
{% if (inv.params or inv.namelist) and model.needs_script_engine %}
                        setInvokeParams(childSM, invokeParams)
{% endif %}
                        // W3C SCXML 6.4: Static ID for done.invoke/cancel, generated ID for child events
{# §scxml-6.5: the `<finalize>` body is authored content, and this channel is
   the one that needs no lowering for it — Kotlin evaluates through Rhino, a
   JavaScript engine, so the parser's JavaScript is already the engine's own
   language. The Lua-backed channels (Rust, Go, cpp-AOT, C11, Python) apply
   `to_lua_script` at their own emission sites for the same reason: authored
   content reaches the engine through the frontend that speaks to it. #}
                        startInvoke("{{ inv.invoke_id }}", childSM, {{ 'true' if inv.autoforward else 'false' }}, {% if inv.has_done_event %}{{ machine_name }}Event.{{ inv.done_event | to_event_ref }}{% else %}null{% endif %}, {% if inv.finalize_content %}"{{ inv.finalize_content | escape_kotlin }}"{% else %}""{% endif %}, generatedInvokeId)
                    }
                }
{% endif %}
{% endfor %}
{% endif %}
{% if state.is_final and state.donedata and state.donedata.content.kind == "literal" and not state.donedata.params %}
                // W3C SCXML 5.5: inline <content> text is the value itself — no script engine needed.
                // Delegates to the SSoT helper shared with C++/Rust/Go backends.
                run {
                    val doneEventData = emitContentLiteral("{{ state.donedata.content.text | escape_kotlin }}")
{% if has_done_event %}
                    raiseInternal({{ machine_name }}Event.{{ ("done.state." ~ state.parent) | to_event_ref }}, EventMetadata.platform(doneEventData))
{% elif is_top_final %}
                    // W3C SCXML 5.5 + 6.3.1: stash onto the engine so the invoking parent's
                    // startInvoke completion callback can lift the payload onto
                    // done.invoke.<id>._event.data. Mirrors C++ AOT stashDonedataAtFinal.
                    stashDonedataAtFinal(doneEventData)
{% endif %}
                }
{% elif state.is_final and state.donedata and model.needs_script_engine %}
                // W3C SCXML 5.5: Evaluate donedata for final state
                run {
                    ensureScriptEngine()
                    val engineDD = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
                    val sidDD = scriptSessionId ?: error("scriptSessionId must be initialized after ensureScriptEngine() (codegen invariant)")
                    var doneEventData = ""
{% if state.donedata.content.kind == "expression" or state.donedata.content.kind == "inline_text" %}
{% if state.donedata.content.kind == "expression" %}
                    // W3C SCXML 5.5: Evaluate <content expr="..."/>
{% set donedata_content = state.donedata.content.text | to_script_source_expr %}
{% else %}
                    // W3C SCXML B.2: inline text takes the ordered readings —
                    // an expression when it is one, otherwise the string. The
                    // reading is decided from the document, so every backend
                    // reaches the same one for the same text.
{% set donedata_content = state.donedata.content.text | to_script_source_data_content %}
{% endif %}
                    try {
                        val contentResult = engineDD.evaluateExpr(sidDD, {{ donedata_content }})
                        // C++ DoneDataHelper::evaluateContent: EventDataHelper::scriptValueToJsonString
                        doneEventData = if (contentResult != null) valueToJson(contentResult) else ""
                    } catch (_: Exception) {
                        raisePlatformError({{ machine_name }}Event.Error.Execution, "<donedata> <content expr> failed to evaluate")
                    }
{% elif state.donedata.content.kind == "literal" %}
                    // W3C SCXML 5.5: inline text is the content value (literal path alongside params).
                    // Delegates to the SSoT helper shared with C++/Rust/Go backends.
                    doneEventData = emitContentLiteral("{{ state.donedata.content.text | escape_kotlin }}")
{% elif state.donedata.params %}
                    // W3C SCXML 5.5: Evaluate <param> elements (C++ DoneDataHelper::evaluateParams pattern)
                    val doneParams = mutableMapOf<String, Any?>()
                    var doneParamStructuralError = false
{% for param in state.donedata.params %}
{% if param.expr is not none %}
                    try {
                        doneParams["{{ param.name | escape_kotlin }}"] = engineDD.evaluateExpr(sidDD, {{ param.expr | to_script_source_expr }})
                    } catch (_: Exception) {
                        // W3C SCXML 5.7: Runtime param error — raise error.execution but continue
                        raisePlatformError({{ machine_name }}Event.Error.Execution, "<donedata> <param name='{{ param.name | escape_kotlin }}'> failed to evaluate")
                    }
{% elif param.location is not none %}
{% if param.location %}
                    try {
                        val locVal = engineDD.evaluateExpr(sidDD, {{ param.location | to_script_source_expr }})
                        doneParams["{{ param.name | escape_kotlin }}"] = locVal
                    } catch (_: Exception) {
                        // W3C SCXML 5.7: Runtime location error — raise error.execution but continue
                        raisePlatformError({{ machine_name }}Event.Error.Execution, "<donedata> <param name='{{ param.name | escape_kotlin }}'> location could not be read")
                    }
{% else %}
                    // W3C SCXML 5.7: Empty location — structural error (C++ DoneDataHelper returns false)
                    raisePlatformError({{ machine_name }}Event.Error.Execution, "<donedata> <param name='{{ param.name | escape_kotlin }}'> has an empty location")
                    doneParamStructuralError = true
{% endif %}
{% endif %}
{% endfor %}
                    // C++ DoneDataHelper pattern: if (!success) break — skip done.state on structural error only
                    if (doneParamStructuralError) return@run
                    if (doneParams.isNotEmpty()) {
                        doneEventData = buildJsonFromParams(doneParams)
                    }
{% endif %}
{% if has_done_event %}
                    // W3C SCXML 3.7: Final child state reached, raise done.state with data
                    raiseInternal({{ machine_name }}Event.{{ ("done.state." ~ state.parent) | to_event_ref }}, EventMetadata.platform(doneEventData))
{% elif is_top_final %}
                    // W3C SCXML 5.5 + 6.3.1: stash onto the engine so the invoking parent's
                    // startInvoke completion callback can lift the payload onto
                    // done.invoke.<id>._event.data. Mirrors C++ AOT stashDonedataAtFinal.
                    stashDonedataAtFinal(doneEventData)
{% endif %}
                }
{% elif has_done_event %}
                // W3C SCXML 3.7: Final child state reached, raise done.state for parent
                raiseInternal({{ machine_name }}Event.{{ ("done.state." ~ state.parent) | to_event_ref }}, EventMetadata.platform())
{% endif %}
{% if is_top_final %}
                // W3C SCXML 3.7: Top-level final state reached
                markFinalStateReached()
{% endif %}
{% if grandparent_is_parallel %}
                // W3C SCXML 3.7.1: this <final> may have completed the
                // <parallel> grandparent — Appendix D's isInFinalState, which
                // counts a region that is itself a <parallel> only once all
                // of ITS regions are final.
                if (isStateInFinalState({{ machine_name }}State.{{ parallel_grandparent_id | to_state_class_name }})) {
                    raiseInternal({{ machine_name }}Event.{{ ("done.state." ~ parallel_grandparent_id) | to_event_ref }})
                }
{% endif %}
