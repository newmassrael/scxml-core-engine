{#
    Kotlin Transition Content Template

    W3C SCXML 3.13: Executable content within <transition> elements, run by the
    runtime's Appendix D microstep (com.sce.runtime.Microstep) between its
    exits and its entries, in the order the transitions were selected.

    Keyed on (source, transitionIndex): the state that OWNS the transition and
    the transition's position among that state's own transitions — exactly the
    pair `first_enabled_transition` hands the runtime. A transition an ancestor
    owns is selected, and so dispatched, under the ancestor.

    Each transition's content is a method of its own,
    `transitionContentOf<State>At<transitionIndex>()`, one function call
    running exactly one block. `executeTransitionContent` dispatches on
    `source` to `transitionContentOf<State>(transitionIndex)`, which
    dispatches on `transitionIndex` to the content: two dispatches of one call
    an arm (dispatch.kt.jinja2).

    ⚠ The content used to sit in the arms of `executeTransitionContent`
    itself, so that one method grew with every transition the document has.
    Measured 2026-11-05, before this shape: a large `sce-static` statechart's
    generated machine did not compile, kotlinc refusing the method past the
    65,535 bytes one JVM method holds (`MethodTooLargeException:
    executeTransitionContent`).

    Uses actions/_render.kt.jinja2 for action dispatch (shared with entry_exit_actions).
#}
{#
    ⚠⚠ THIS FILE USED TO RE-EVALUATE THE GUARD, and that was the defect.
    Every arm below was once keyed on the transition's `cond` and its event
    pattern — the same `cond` the SELECTION had already evaluated to choose the
    transition. For a pure guard that is only wasteful. For a guard with a SIDE
    EFFECT it is wrong, and measured wrong: on 2026-08-30 `cond="++v == 2"` was
    evaluated by the selection (`++v` -> 2, the guard holds, the transition is
    taken) and then evaluated AGAIN here (`++v` -> 3, the guard does not hold),
    so the machine took its transition and ran the OTHER arm's content.
    `ecma262-lowered-kotlin` found it; no W3C fixture guards on a side effect,
    and no engine-level test compiles a machine, so nothing else could.

    The arms are keyed on `transitionIndex` — the selection's own answer,
    carried on the EnabledTransition and handed back by the runtime.

    ⚠ The arms used to be a state's EFFECTIVE transitions — its own followed by
    every ancestor's — under a machine-wide numbering, because the selection
    reported an ancestor's transition under the atomic state it was found from.
    It no longer does, so a transition's content appears once, under its own
    source, and the per-state index the other five backends dispatch on is
    enough.
#}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}
{%- import 'dispatch.kt.jinja2' as dispatch %}
{# A transition carries content when the document wrote some, and a branch of
   a test component always does: the statement taking it, which runs before
   what the document wrote (`native_prelude`, docs/SCE_TEST_PROFILE.md §4.4
   (P4 step 1), §12.3). `carrying.states` holds each state that owns one. #}
{% set carrying = namespace(states=[]) %}
{% for state_id, state in model.states | dictsort %}
{% for trans in state.transitions %}
{% if (trans.actions or trans.native_prelude) and state_id not in carrying.states %}
{% set carrying.states = carrying.states + [state_id] %}
{% endif %}
{% endfor %}
{% endfor %}
{# The `when (source)` is exhaustive over the sealed state hierarchy exactly
   when every state owns a transition that carries content; it takes an `else`
   for the others otherwise, and Kotlin rejects a redundant one under -Werror. #}
{% set source_dispatch = namespace(arms=[]) %}
{% for state_id, state in model.states | dictsort %}
{% if state_id in carrying.states %}
{% set source_dispatch.arms = source_dispatch.arms + [["is " ~ machine_name ~ "State." ~ (state_id | to_state_class_name), "transitionContentOf" ~ (state_id | to_state_class_name) ~ "(transitionIndex)"]] %}
{% endif %}
{% endfor %}

    // Transition Content (W3C SCXML 3.13)
    {# SCE Protocol-Synthesis RFC §synth-5-O — function-scope SCE-MAP marker
       above `executeTransitionContent`. Kotlin comment-form is the only
       safe surface inside a class body. #}
    {{ sce_map.source_marker(model.source_location, "kotlin", symbol_artifact=sce_artifact.machine) }}
{{ dispatch.bounded_when("executeTransitionContent", "override fun executeTransitionContent(source: " ~ machine_name ~ "State, transitionIndex: Int)", "source: " ~ machine_name ~ "State, transitionIndex: Int", "source, transitionIndex", "source", source_dispatch.arms, "", "{}", (source_dispatch.arms | length) == (model.states | length)) }}
{% for state_id, state in model.states | dictsort %}
{% if state_id in carrying.states %}
{% set index_dispatch = namespace(arms=[]) %}
{% for trans in state.transitions %}
{% if trans.actions or trans.native_prelude %}
{% set index_dispatch.arms = index_dispatch.arms + [[trans.transition_index | string, "transitionContentOf" ~ (state_id | to_state_class_name) ~ "At" ~ trans.transition_index ~ "()"]] %}
{% endif %}
{% endfor %}

    // The content of `{{ state_id }}`'s own transitions, by the index the
    // selection answered with. A transition without content is never
    // dispatched here — the microstep asks only for transitions that carry
    // some — so the remaining indices are unreachable, which is what an empty
    // `else` says.
{{ dispatch.bounded_when("transitionContentOf" ~ (state_id | to_state_class_name), "private fun transitionContentOf" ~ (state_id | to_state_class_name) ~ "(transitionIndex: Int)", "transitionIndex: Int", "transitionIndex", "transitionIndex", index_dispatch.arms, "", "{}", false) }}
{% for trans in state.transitions %}
{% if trans.actions or trans.native_prelude %}

    private fun transitionContentOf{{ state_id | to_state_class_name }}At{{ trans.transition_index }}() {  {{- annot.annotation_comment(trans, "kotlin", "                ") }}
{% if trans.source_location %}
                {{ sce_map.source_marker(trans.source_location, "kotlin", stmt_level=true, symbol_state=trans.symbol_state_path, symbol_artifact=trans.symbol_artifact) | trim }}
{% endif %}
{#  docs/SCE_TEST_PROFILE.md §4.4 (P4 step 1), §12.3: taking a branch of a test
    component removes what it matched on the round's snapshot before its
    content runs, and a message the content reads is its `_event.data`, held
    in the payload member of its record's event from here on
    (`Transition::native_prelude`). #}
{% if trans.native_prelude %}
                // docs/SCE_TEST_PROFILE.md §12.3: taking the branch (P4 step 1).
                {{ trans.native_prelude | indent(16) }}
{% endif %}
{#  SCE Accepted Subset §2.15: content that reads the event's typed payload
    cannot run for a delivery that did not carry one, and an error stops the
    block it arose in (W3C SCXML 4.9) — so the check guards the whole content,
    once, before any of it runs. A delivery of this event whose data does not
    fit is refused whole at the door and never reaches it
    (`StateMachineEngine.bindTypedPayload`, docs/adr/0086 section 4.2); the
    payload is null here only for an event of another name the transition's
    descriptor also matches, which carries no payload of this event. It
    raises nothing: no delivery was refused. #}
{% if trans.content_reads_payload %}
                if (pending{{ trans.event | to_event_variant }}Payload == null) {
                    return
                }
{% endif %}
{# `block_flow`: an element that ends the block unconditionally sets it, and
   nothing after that element is emitted (kotlin/entry_exit_actions.kt.jinja2). #}
{% with block_flow = namespace(ended=false) %}
{% for action in trans.actions %}
{% if not block_flow.ended %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "kotlin", "                ") -}}
{%- endif %}
{% include 'actions/_render.kt.jinja2' with context %}
{% endif %}
{% endfor %}
{% endwith %}
    }
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
