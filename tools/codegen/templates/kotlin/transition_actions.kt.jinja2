{#
    Kotlin Transition Content Template

    W3C SCXML 3.13: Executable content within <transition> elements, run by the
    runtime's Appendix D microstep (com.sce.runtime.Microstep) between its
    exits and its entries, in the order the transitions were selected.

    Keyed on (source, transitionIndex): the state that OWNS the transition and
    the transition's position among that state's own transitions — exactly the
    pair `first_enabled_transition` hands the runtime. A transition an ancestor
    owns is selected, and so dispatched, under the ancestor.

    Uses actions/_render.kt.jinja2 for action dispatch (shared with entry_exit_actions).
#}
{#
    ⚠⚠ THIS FILE USED TO RE-EVALUATE THE GUARD, and that was the defect.
    Every arm below was once keyed on the transition's `cond` and its event
    pattern — the same `cond` the SELECTION had already evaluated to choose the
    transition. For a pure guard that is only wasteful. For a guard with a SIDE
    EFFECT it is wrong, and measured wrong: on 2026-08-30 `cond="++v == 2"` was
    evaluated by the selection (`++v` -> 2, the guard holds, the transition is
    taken) and then evaluated AGAIN here (`++v` -> 3, the guard does not hold),
    so the machine took its transition and ran the OTHER arm's content.
    `ecma262-lowered-kotlin` found it; no W3C fixture guards on a side effect,
    and no engine-level test compiles a machine, so nothing else could.

    The arms are keyed on `transitionIndex` — the selection's own answer,
    carried on the EnabledTransition and handed back by the runtime.

    ⚠ The arms used to be a state's EFFECTIVE transitions — its own followed by
    every ancestor's — under a machine-wide numbering, because the selection
    reported an ancestor's transition under the atomic state it was found from.
    It no longer does, so a transition's content appears once, under its own
    source, and the per-state index the other five backends dispatch on is
    enough.
#}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}
{% set ns_content = namespace(states=0) %}
{% for state_id, state in model.states | dictsort %}
{% if state.transitions | selectattr('actions') | list %}
{% set ns_content.states = ns_content.states + 1 %}
{% endif %}
{% endfor %}

    // Transition Content (W3C SCXML 3.13)
    {# SCE Protocol-Synthesis RFC §synth-5-O — function-scope SCE-MAP marker
       above `executeTransitionContent`. Kotlin comment-form is the only
       safe surface inside a class body. #}
    {{ sce_map.source_marker(model.source_location, "kotlin", symbol_artifact=sce_artifact.machine) }}
    override fun executeTransitionContent(source: {{ machine_name }}State, transitionIndex: Int) {
        when (source) {
{% for state_id, state in model.states | dictsort %}
{% if state.transitions | selectattr('actions') | list %}
        is {{ machine_name }}State.{{ state_id | to_state_class_name }} -> when (transitionIndex) {
{% for trans in state.transitions %}
{% if trans.actions %}
            {{ trans.transition_index }} -> {  {{- annot.annotation_comment(trans, "kotlin", "                ") }}
{% if trans.source_location %}
                {{ sce_map.source_marker(trans.source_location, "kotlin", stmt_level=true, symbol_state=trans.symbol_state_path, symbol_artifact=trans.symbol_artifact) | trim }}
{% endif %}
{#  SCE Accepted Subset §2.15: content that reads the event's typed payload
    cannot run for a delivery that did not carry one, and an error stops the
    block it arose in (W3C SCXML 4.9) — so the check guards the whole content,
    once, before any of it runs. It raises nothing: the payload is null only
    when the engine could not read it from the delivery, and the engine has
    already said so with `error.execution` where it read it
    (`StateMachineEngine.bindTypedPayload`). One unreadable delivery is one
    error; a second raise here would report it twice. #}
{% if trans.content_reads_payload %}
                if (pending{{ trans.event | to_event_variant }}Payload == null) {
                    return
                }
{% endif %}
{% for action in trans.actions %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "kotlin", "                ") -}}
{%- endif %}
{% include 'actions/_render.kt.jinja2' with context %}
{% endfor %}
            }
{% endif %}
{% endfor %}
{# A transition without content is never dispatched here — the microstep asks
   only for transitions that carry some — so the remaining indices are
   unreachable, which is what an empty arm says. #}
            else -> {}
        }
{% endif %}
{% endfor %}
{# The `else` arm answers for the states the loop above emitted no branch for —
   the ones none of whose own transitions carry content. A document where
   every state has one leaves this `when` exhaustive over the sealed state
   hierarchy, and Kotlin rejects a redundant `else` under -Werror. #}
{% if ns_content.states < model.states | length %}
        else -> {}
{% endif %}
        }
    }
