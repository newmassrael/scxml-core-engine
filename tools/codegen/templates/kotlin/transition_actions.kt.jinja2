{#
    Kotlin Transition Actions Template

    W3C SCXML 3.13: Executable content within <transition> elements.
    Called between onExit(source) and onEntry(target) by the engine.

    Handles both event-based transitions (event != null) and
    eventless transitions (event == null).

    Uses effective_transitions (self + ancestor transitions) for ancestor routing.
    Uses actions/_render.kt.jinja2 for action dispatch (shared with entry_exit_actions).
    Three-way condition pattern: In() predicate | safeEvaluateGuard() | static Kotlin.
#}
{# --- Condition rendering macro (same as process_event) --- #}
{% macro render_cond(trans) -%}
{% if trans.is_pure_in_predicate -%}
{{ trans.cond_kt }}
{%- elif trans.is_kt_condition -%}
{{ trans.cond_kt }}
{%- elif model.needs_script_engine and trans.cond and not trans.is_cpp_condition -%}
safeEvaluateGuard("{{ trans.cond | escape_kotlin }}")
{%- elif trans.cond and not trans.is_cpp_condition -%}
{{ trans.cond }}
{%- endif -%}
{%- endmacro %}
{%- import '_macros/sce_map_marker.jinja2' as sce_map %}
{%- import '_macros/sce_annotation_marker.jinja2' as annot %}

    // Transition Actions (W3C SCXML 3.13)
    {# Watching-zenoh RFC §synth-5-O — function-scope SCE-MAP marker
       above `executeTransitionActions`. Kotlin comment-form is the only
       safe surface inside a class body. #}
    {{ sce_map.source_marker(model.source_location, "kotlin") }}
    override fun executeTransitionActions(
        source: {{ machine_name }}State,
        event: {{ machine_name }}Event?
    ) {
        when (source) {
{% for state_id in model.states | sort %}
{% set eff_transitions = effective_transitions[state_id] %}
{% set ns = namespace(has_transition_actions=false) %}
{% for trans in eff_transitions %}
{% if trans.actions %}
{% set ns.has_transition_actions = true %}
{% endif %}
{% endfor %}
{% if ns.has_transition_actions %}
        is {{ machine_name }}State.{{ state_id | to_state_class_name }} -> when {
{# --- Event-based transition actions --- #}
{% for trans in eff_transitions %}
{% if trans.actions and trans.event %}
{% if trans.event == '*' %}
            event != null -> {  {{- annot.annotation_comment(trans, "kotlin", "                ") }}
{% elif trans.prefix_matching_events is defined and trans.prefix_matching_events | length > 1 %}
            ({% for matched_event in trans.prefix_matching_events | sort %}event is {{ machine_name }}Event.{{ matched_event | to_event_class_name }}{% if not loop.last %} || {% endif %}{% endfor %})
{%- if trans.cond %} && {{ render_cond(trans) }}{% endif %} -> {  {{- annot.annotation_comment(trans, "kotlin", "                ") }}
{% else %}
{% if trans.prefix_matching_events is defined and trans.prefix_matching_events | length == 1 %}
{% set resolved_event = trans.prefix_matching_events[0] %}
{% else %}
{% set resolved_event = trans.event %}
{% endif %}
{% if trans.cond %}
            event is {{ machine_name }}Event.{{ resolved_event | to_event_class_name }} && {{ render_cond(trans) }} -> {  {{- annot.annotation_comment(trans, "kotlin", "                ") }}
{% else %}
            event is {{ machine_name }}Event.{{ resolved_event | to_event_class_name }} -> {  {{- annot.annotation_comment(trans, "kotlin", "                ") }}
{% endif %}
{% endif %}
{% for action in trans.actions %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "kotlin", "                ") -}}
{%- endif %}
{% include 'actions/_render.kt.jinja2' with context %}
{% endfor %}
            }
{% endif %}
{% endfor %}
{# --- Eventless transition actions (event == null) --- #}
{% for trans in eff_transitions %}
{% if trans.actions and not trans.event %}
{% if trans.cond %}
            event == null && {{ render_cond(trans) }} -> {  {{- annot.annotation_comment(trans, "kotlin", "                ") }}
{% else %}
            event == null -> {  {{- annot.annotation_comment(trans, "kotlin", "                ") }}
{% endif %}
{% for action in trans.actions %}
{%- if action.req or action.unresolved %}
{{ annot.annotation_block(action, "kotlin", "                ") -}}
{%- endif %}
{% include 'actions/_render.kt.jinja2' with context %}
{% endfor %}
            }
{% endif %}
{% endfor %}
            else -> {}
        }
{% endif %}
{% endfor %}
        else -> {}
        }
    }
