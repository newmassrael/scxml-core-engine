{# W3C SCXML 5.7: collect `<param>` values into an already-declared
   `MutableMap<String, List<String>>` named `map`, as text.

   Two consumers hand their params to the host the same way — a `<send>` whose
   type the host serves (W3C 6.2.5) and an `<invoke>` the host runs (W3C
   6.4.1) — and they differ only in the variable they fill and the element a
   refusal names. Written once so a `<param>` shape handled for one is handled
   for the other; the host invoke had received the literal ones alone, and the
   host send kept only the last value of a repeated name.

   A repeated name keeps every value (W3C SCXML 5.7 permits repetition), and a
   failed evaluation drops the pair AND reports it: W3C SCXML 5.7.1 puts both
   halves on one clause and names no processor, so the transport cannot change
   the answer.

   `eng` / `sid` name the script engine and session already bound by the
   caller; they are only read for a param that is not a literal. `element` is
   how a refusal names the element (`<send>`, `<invoke>`). `machine_name` is a
   parameter rather than a global because a macro body does not see the render
   context.

   `failed_flag`, when given, names the `Boolean` a `<send>` declared: the
   error was raised while the element was processed, so the block stops once
   the message has gone (W3C SCXML 4.9). The host-run `<invoke>` passes none:
   a failed `<param>` there costs the error and the pair, and the child still
   starts. Both refuse an empty `location=""`, which names no location.

   `typed`, when given, names a `MutableMap<String, Any?>` that also receives
   each value as the data model holds it, through `putParam` — the one
   evaluation read twice, once as text and once typed — so a consumer that
   needs the pairs as JSON (`buildJsonFromParams`) has them without a second
   evaluation. A param the build marked `envelope_metadata` is text only: it
   is not a value the author sent. Written as a block at each site rather
   than a helper macro, so a site with no typed map renders exactly what it
   rendered before. #}
{% macro collect_wire_params_into(params, model, map, eng, sid, machine_name, element, indent, failed_flag='', typed='') %}
{% for param in params %}
{% if param.is_static_literal %}
{{ indent }}{{ map }}["{{ param.name | escape_kotlin }}"] =
{{ indent }}    ({{ map }}["{{ param.name | escape_kotlin }}"] ?: emptyList()) + "{{ param.static_value | escape_kotlin }}"
{% if typed and not param.envelope_metadata %}
{{ indent }}putParam({{ typed }}, "{{ param.name | escape_kotlin }}", "{{ param.static_value | escape_kotlin }}")
{% endif %}
{% elif param.native_value %}
{# `datamodel="sce-static"`: the value is computed from the machine's own
   fields, widened to what `valueToWireString` and `putParam` read (a `Long`
   for an integer, a `Double` for a real), so it crosses exactly as a script
   engine's would. A checked operation that overflows is the evaluation that
   failed. A block of its own, because the sites that call this macro unroll it
   once per param in one scope. #}
{% if param.native_fails %}
{{ indent }}try {
{% else %}
{{ indent }}run {
{% endif %}
{{ indent }}    val v: Any? = {{ param.native_value }}
{{ indent }}    {{ map }}["{{ param.name | escape_kotlin }}"] =
{{ indent }}        ({{ map }}["{{ param.name | escape_kotlin }}"] ?: emptyList()) + valueToWireString(v)
{% if typed and not param.envelope_metadata %}
{{ indent }}    putParam({{ typed }}, "{{ param.name | escape_kotlin }}", v)
{% endif %}
{% if param.native_fails %}
{{ indent }}} catch (_: com.sce.forge.runtime.AlgorithmFailure) {
{{ indent }}    // W3C SCXML 5.7.1: report the failure and omit the pair.
{% if 'error.execution' in model.events %}
{{ indent }}    raisePlatformError({{ machine_name }}Event.Error.Execution, "{{ element }} <param name='{{ param.name | escape_kotlin }}'> expr failed to evaluate")
{% endif %}
{% if failed_flag %}
{{ indent }}    {{ failed_flag }} = true
{% endif %}
{{ indent }}}
{% else %}
{{ indent }}}
{% endif %}
{% elif (param.expr or param.location) and model.needs_script_engine %}
{{ indent }}try {
{{ indent }}    // The param crosses as text, and `toString()` is the platform's
{{ indent }}    // spelling of the value; this is the document's.
{{ indent }}    val v = {{ eng }}.evaluateExpr({{ sid }}, {% if param.expr %}{{ param.expr | to_script_source_expr }}{% else %}{{ param.location | to_script_source_expr }}{% endif %})
{{ indent }}    {{ map }}["{{ param.name | escape_kotlin }}"] =
{{ indent }}        ({{ map }}["{{ param.name | escape_kotlin }}"] ?: emptyList()) + valueToWireString(v)
{% if typed and not param.envelope_metadata %}
{{ indent }}    putParam({{ typed }}, "{{ param.name | escape_kotlin }}", v)
{% endif %}
{{ indent }}} catch (_: Exception) {
{{ indent }}    // W3C SCXML 5.7.1: report the failure and omit the name and the
{{ indent }}    // value — the act still happens, without a field the document
{{ indent }}    // could not produce.
{{ indent }}    raisePlatformError({{ machine_name }}Event.Error.Execution, "{{ element }} <param name='{{ param.name | escape_kotlin }}'> {% if param.expr %}expr failed to evaluate{% else %}location could not be read{% endif %}")
{% if failed_flag %}
{{ indent }}    {{ failed_flag }} = true
{% endif %}
{{ indent }}}
{% elif model.needs_script_engine and not (param.expr or param.location) %}
{{ indent }}// W3C SCXML 5.7.1: an empty location names no location in the data
{{ indent }}// model — reported, and the pair left out.
{{ indent }}raisePlatformError({{ machine_name }}Event.Error.Execution, "{{ element }} <param name='{{ param.name | escape_kotlin }}'> names no location")
{% if failed_flag %}
{{ indent }}{{ failed_flag }} = true
{% endif %}
{% endif %}
{% endfor %}
{% endmacro %}

{# SCE Accepted Subset 2.12: one `<param>` of a typed host-run `<invoke>`, held
   to the request-record field it supplies (`field_type`, a
   `TypedRequest.FieldType`) and collected into `map`.

   Unlike `collect_wire_params_into`, a value that cannot be evaluated or does
   not fit its field is not left out: the host was promised the whole record,
   so W3C SCXML 6.4.1's rule for an argument that cannot be evaluated applies —
   error.execution, and the invocation starts nothing (the enclosing deferred
   closure returns). A string literal was held to its field at build time
   (`validation/typed-invoke-request`), so it passes as written. #}
{% macro collect_typed_wire_param_into(param, field_type, model, map, eng, sid, machine_name, indent, typed='') %}
{% if param.is_static_literal %}
{{ indent }}{{ map }}["{{ param.name | escape_kotlin }}"] =
{{ indent }}    ({{ map }}["{{ param.name | escape_kotlin }}"] ?: emptyList()) + "{{ param.static_value | escape_kotlin }}"
{% if typed and not param.envelope_metadata %}
{{ indent }}putParam({{ typed }}, "{{ param.name | escape_kotlin }}", "{{ param.static_value | escape_kotlin }}")
{% endif %}
{% elif (param.expr or param.location) and model.needs_script_engine %}
{{ indent }}try {
{{ indent }}    val v = {{ eng }}.evaluateExpr({{ sid }}, {% if param.expr %}{{ param.expr | to_script_source_expr }}{% else %}{{ param.location | to_script_source_expr }}{% endif %})
{{ indent }}    {{ map }}["{{ param.name | escape_kotlin }}"] =
{{ indent }}        ({{ map }}["{{ param.name | escape_kotlin }}"] ?: emptyList()) +
{{ indent }}            TypedRequest.wire(v, "{{ param.name | escape_kotlin }}", {{ field_type }}, ::valueToWireString)
{% if typed and not param.envelope_metadata %}
{{ indent }}    putParam({{ typed }}, "{{ param.name | escape_kotlin }}", v)
{% endif %}
{{ indent }}} catch (refusal: Exception) {
{{ indent }}    raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke> <param name='{{ param.name | escape_kotlin }}'> cannot be its request field: ${refusal.message}")
{{ indent }}    return@deferInvoke
{{ indent }}}
{% endif %}
{% endmacro %}

{# §scxml-6.4.1: under `datamodel="sce-static"`, the values the invoke's
   `<param>`s and `namelist` give the child's variables, into `child` (the
   child machine already built) before it starts. The build lowered each
   (`Param::native_seed`) to a value of the child variable's own type, read
   from this machine's fields now — when the invoke is executed, at the
   macrostep's end — and the child takes them through its `acceptParams`.

   A value that cannot be computed costs `error.execution` and that one value
   (W3C SCXML 5.7.1): the child still starts, one value short. #}
{% macro seed_static_child(inv, child, model, machine_name, indent) %}
{% set ns = namespace(any=false) %}
{% for param in inv.params %}
{% if param.native_seed %}
{% set ns.any = true %}
{% endif %}
{% endfor %}
{% if ns.any %}
{{ indent }}// W3C SCXML 6.4.1: hand the child the values this invoke names
{{ indent }}val childSeed = {{ inv.child_class }}StateMachine.InvokeParams()
{% for param in inv.params %}
{% if param.native_seed and param.native_fails %}
{{ indent }}try {
{{ indent }}    childSeed.{{ param.name | to_camel_case }} = {{ param.native_seed }}
{{ indent }}} catch (_: com.sce.forge.runtime.AlgorithmFailure) {
{{ indent }}    // W3C SCXML 5.7.1: report the failure and leave the value out.
{% if 'error.execution' in model.events %}
{{ indent }}    raisePlatformError({{ machine_name }}Event.Error.Execution, "<invoke> <param name='{{ param.name | escape_kotlin }}'> expr failed to evaluate")
{% endif %}
{{ indent }}}
{% elif param.native_seed %}
{{ indent }}childSeed.{{ param.name | to_camel_case }} = {{ param.native_seed }}
{% endif %}
{% endfor %}
{{ indent }}{{ child }}.acceptParams(childSeed)
{% endif %}
{% endmacro %}
