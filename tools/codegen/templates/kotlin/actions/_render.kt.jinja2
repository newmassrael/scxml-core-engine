{# W3C SCXML: Common action dispatcher for entry/exit/transition contexts.
   Expects `action` and `machine_name` variables in scope.
   Three-way pattern: script engine | static Kotlin | fallback. #}
{% if action.type == 'raise' %}
            raiseInternal({{ machine_name }}Event.{{ action.event | to_event_ref }})
{% elif action.type == 'assign' %}
{% include 'actions/assign.kt.jinja2' with context %}
{% elif action.type == 'log' and action.expr %}
{% if model.needs_script_engine %}
            // W3C SCXML 4.7: Log expression evaluation (non-fatal on error, C++ pattern)
            try {
                println({% if action.label %}"{{ action.label | escape_kotlin }}: " + {% endif %}(scriptEngine?.evaluateExpr(scriptSessionId ?: "", "{{ action.expr | escape_kotlin }}")?.toString() ?: ""))
            } catch (_: Exception) {}
{% else %}
            println({% if action.label %}"{{ action.label | escape_kotlin }}: " + {% endif %}{{ action.expr | to_kotlin_string_expr }})
{% endif %}
{% elif action.type == 'log' and action.label %}
            println("{{ action.label | escape_kotlin }}")
{% elif action.type == 'send' %}
{% include 'actions/send.kt.jinja2' with context %}
{% elif action.type == 'script' %}
{% include 'actions/script.kt.jinja2' with context %}
{% elif action.type == 'cancel' %}
{% include 'actions/cancel.kt.jinja2' with context %}
{% elif action.type == 'if' %}
{% include 'actions/if.kt.jinja2' with context %}
{% elif action.type == 'foreach' %}
{% include 'actions/foreach.kt.jinja2' with context %}
{% elif action.type == 'native_action' %}
{# W3C SCXML G.7: <sce:action> native host dispatch. The call site (including
   the typed `_event.data` null check when the action reads a payload field) is
   lowered ahead of the template by `forge::native_action::render` and stored
   on `action.native_action_rendered`, so this branch only emits it. No script
   engine is involved. #}
            // W3C SCXML G.7: <sce:action name="{{ action.native_action_name }}">
            {{ action.native_action_rendered }}
{% endif %}
