{# W3C SCXML: Common action dispatcher for entry/exit/transition contexts.
   Expects `action` and `machine_name` variables in scope. #}
{% if action.type == 'raise' %}
            raiseInternal({{ machine_name }}Event.{{ action.event | to_event_ref }})
{% elif action.type == 'assign' and action.location and action.expr %}
            {{ action.location | to_camel_case }} = {{ action.expr }}
{% elif action.type == 'log' and action.expr %}
            println({% if action.label %}"{{ action.label | escape_kotlin }}: " + {% endif %}{{ action.expr | to_kotlin_string_expr }})
{% elif action.type == 'log' and action.label %}
            println("{{ action.label | escape_kotlin }}")
{% elif action.type == 'send' %}
{% include 'actions/send.kt.jinja2' with context %}
{% elif action.type == 'script' and action.get('is_kt_function', false) %}
            {{ action.content_kt | trim }}
{% elif action.type == 'cancel' and action.sendid %}
            cancelSend("{{ action.sendid | escape_kotlin }}")
{% elif action.type == 'if' %}
{% include 'actions/if.kt.jinja2' with context %}
{% elif action.type == 'foreach' %}
{% include 'actions/foreach.kt.jinja2' with context %}
{% endif %}
