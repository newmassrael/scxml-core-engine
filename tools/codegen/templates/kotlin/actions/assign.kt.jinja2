{# W3C SCXML 5.3: <assign> — three-way: script engine | static Kotlin | no-op #}
{% if model.needs_script_engine %}
{% if _in_foreach_body is defined and _in_foreach_body %}
{# W3C SCXML 4.6: Inside foreach body, throw on error to stop iteration (C++ in_foreach pattern) #}
{% if not action.location %}
            throw com.sce.runtime.ScriptEngineException("W3C SCXML 5.3: Empty assign location")
{% elif action.content %}
{# W3C SCXML 5.4.2: the children specify the same legal data value `expr`
   would, read once by `to_author_assign_content` so this backend and the
   lowering ones agree about whether `21` is a number. Quoting it made it
   the string "21". #}
            engine.assign(sid, {{ action.location | to_script_source_location }}, {{ action.content | to_script_source_assign_content }})
{% elif action.expr %}
            engine.assign(sid, {{ action.location | to_script_source_location }}, {{ action.expr | to_script_source_expr }})
{% endif %}
{% else %}
{% if not action.location %}
            // W3C SCXML 5.3: Empty location raises error.execution (C++ ActionExecutorImpl pattern)
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<assign> has an invalid or read-only location")
{% elif action.content %}
{# W3C SCXML 5.4.2: the children specify the same legal data value `expr`
   would, read once by `to_author_assign_content` so this backend and the
   lowering ones agree about whether `21` is a number. Quoting it made it
   the string "21". #}
            executeAssign({{ action.location | to_script_source_location }}, {{ action.content | to_script_source_assign_content }})
{% elif action.expr %}
            executeAssign({{ action.location | to_script_source_location }}, {{ action.expr | to_script_source_expr }})
{% endif %}
{% endif %}
{% elif action.location and action.expr %}
            {{ action.location | to_camel_case }} = {{ action.expr }}
{% endif %}
