{# W3C SCXML 6.2: Send action with target/type validation, delay, and invoke routing.
   Expects `action` and `machine_name` variables in scope.
   Uses action.auto_send_id for unique delayed send identification (C++ UniqueIdGenerator pattern).
   Phase 2: Full script engine integration — eventexpr, targetexpr, delayexpr, idlocation, params, namelist. #}
{% if action.idlocation and model.needs_script_engine %}
            // W3C SCXML 6.2.4: Store sendid in idlocation (test183, test332)
            run {
                ensureScriptEngine()
                val eng = scriptEngine ?: return@run
                val sid = scriptSessionId ?: return@run
                try { eng.setVariable(sid, "{{ action.idlocation }}", "{{ action.auto_send_id }}") } catch (_: Exception) {}
            }
{% endif %}
{% if action.send_type and action.send_type not in ['', 'http://www.w3.org/TR/scxml/#SCXMLEventProcessor', 'http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor'] %}
            // W3C SCXML 6.2 (test199): Unsupported send type raises error.execution
            raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata(type = "platform", sendId = "{{ action.auto_send_id }}"))
{% if in_run_block is defined and in_run_block %}
            return@run  // W3C SCXML 5.10: Stop subsequent executable content in this block
{% else %}
            return  // W3C SCXML 5.10: Stop subsequent executable content
{% endif %}
{% elif action.target and action.target.startswith('!') %}
            // W3C SCXML 6.2 (test194): Invalid target raises error.execution
            raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata(type = "platform", sendId = "{{ action.auto_send_id }}"))
{% if in_run_block is defined and in_run_block %}
            return@run  // W3C SCXML 5.10: Stop subsequent executable content in this block
{% else %}
            return  // W3C SCXML 5.10: Stop subsequent executable content
{% endif %}
{% elif action.send_type == 'http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor' and not action.target and not action.targetexpr %}
            // W3C SCXML C.2 (test577): BasicHTTP requires target, missing raises error.communication
            raiseInternal({{ machine_name }}Event.Error.Communication, EventMetadata.platform())
{% if in_run_block is defined and in_run_block %}
            return@run  // W3C SCXML 5.10: Stop subsequent executable content in this block
{% else %}
            return  // W3C SCXML 5.10: Stop subsequent executable content
{% endif %}
{% elif action.eventexpr and model.needs_script_engine %}
            // W3C SCXML 6.2: Dynamic event name evaluation (test172)
            run {
                ensureScriptEngine()
                val engine = scriptEngine ?: return@run
                val sid = scriptSessionId ?: return@run
                val dynamicEventName: String
                try {
                    val v = engine.evaluateExpr(sid, "{{ action.eventexpr | escape_kotlin }}")
                    dynamicEventName = v?.toString() ?: ""
                } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata.platform())
                    return@run
                }
                val resolvedEvent = resolveEventByName(dynamicEventName)
                if (resolvedEvent != null) {
                    send(resolvedEvent, EventMetadata.external(sendId = "{{ action.auto_send_id }}", origin = scriptSessionId ?: ""))
                }
            }
{% elif action.targetexpr and model.needs_script_engine %}
            // W3C SCXML 6.2: Dynamic target evaluation (test173)
            run {
                ensureScriptEngine()
                val engineT = scriptEngine ?: return@run
                val sidT = scriptSessionId ?: return@run
                val dynamicTarget: String
                try {
                    val v = engineT.evaluateExpr(sidT, "{{ action.targetexpr | escape_kotlin }}")
                    dynamicTarget = v?.toString() ?: ""
                } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata.platform())
                    return@run
                }
                // W3C SCXML 6.2 (test194): Invalid target (C++ SendHelper::isInvalidTarget)
                if (dynamicTarget.startsWith("!")) {
                    raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata(type = "platform", sendId = "{{ action.auto_send_id }}"))
                    return@run
                }
                // W3C SCXML C.1 (test496): Unreachable target (C++ SendHelper::isUnreachableTarget)
                if (dynamicTarget.isEmpty() || dynamicTarget == "undefined") {
                    raiseInternal({{ machine_name }}Event.Error.Communication, EventMetadata.platform())
                    return@run
                }
{% if action.event %}
{% set needs_params = action.params or action.namelist %}
{% if needs_params %}
                val paramsT = mutableMapOf<String, Any?>()
{% for param in action.params %}
{% if param.is_static_literal %}
                paramsT["{{ param.name }}"] = "{{ param.static_value }}"
{% elif param.expr %}
                try { paramsT["{{ param.name }}"] = engineT.evaluateExpr(sidT, "{{ param.expr | escape_kotlin }}") } catch (_: Exception) { paramsT["{{ param.name }}"] = "" }
{% endif %}
{% endfor %}
{% if action.namelist %}
                // W3C SCXML C.1: Evaluate namelist — abort send on error (C++ NamelistHelper pattern)
{% for var_name in action.namelist.split() %}
                if (!engineT.hasVariable(sidT, "{{ var_name }}")) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run
                }
                try { paramsT["{{ var_name }}"] = engineT.getVariable(sidT, "{{ var_name }}") } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run
                }
{% endfor %}
{% endif %}
                val eventDataT = buildJsonFromParams(paramsT)
{% endif %}
                if (dynamicTarget == "#_internal") {
                    raiseInternal({{ machine_name }}Event.{{ action.event | to_event_ref }}{% if needs_params %}, EventMetadata(type = "internal", data = eventDataT){% endif %})
                } else if (dynamicTarget == "#_parent") {
                    onSendToParent?.invoke("{{ action.event }}", {% if needs_params %}eventDataT{% else %}""{% endif %})
                } else {
                    send({{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ action.auto_send_id }}", origin = scriptSessionId ?: ""{% if needs_params %}, data = eventDataT{% endif %}))
                }
{% endif %}
            }
{% elif action.target == '#_internal' %}
{% if action.event %}
            raiseInternal({{ machine_name }}Event.{{ action.event | to_event_ref }})
{% endif %}
{% elif action.target == '#_parent' %}
{% if action.event %}
{% set needs_params = action.params or action.namelist %}
{% if needs_params and model.needs_script_engine %}
            // W3C SCXML 5.10: Evaluate params for parent send (test233)
            run {
                ensureScriptEngine()
                val engineP = scriptEngine ?: return@run
                val sidP = scriptSessionId ?: return@run
                val paramsP = mutableMapOf<String, Any?>()
{% for param in action.params %}
{% if param.is_static_literal %}
                paramsP["{{ param.name }}"] = "{{ param.static_value }}"
{% elif param.expr %}
                try { paramsP["{{ param.name }}"] = engineP.evaluateExpr(sidP, "{{ param.expr | escape_kotlin }}") } catch (_: Exception) { paramsP["{{ param.name }}"] = "" }
{% endif %}
{% endfor %}
{% if action.namelist %}
                // W3C SCXML C.1: Evaluate namelist — abort send on error (C++ NamelistHelper pattern)
{% for var_name in action.namelist.split() %}
                if (!engineP.hasVariable(sidP, "{{ var_name }}")) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run
                }
                try { paramsP["{{ var_name }}"] = engineP.getVariable(sidP, "{{ var_name }}") } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run
                }
{% endfor %}
{% endif %}
                val eventDataP = buildJsonFromParams(paramsP)
{% if action.delay or action.delayexpr %}
                scheduleParentSend("{{ action.auto_send_id }}", {{ action.delay_ms | default(0) }}L, "{{ action.event }}", eventDataP)
{% else %}
                onSendToParent?.invoke("{{ action.event }}", eventDataP)
{% endif %}
            }
{% elif action.delay or action.delayexpr %}
            // W3C SCXML 6.4 (test187): Delayed send to parent — cancelled when child stops
            scheduleParentSend("{{ action.auto_send_id }}", {{ action.delay_ms | default(0) }}L, "{{ action.event }}")
{% else %}
            // W3C SCXML 6.4 (test191): Send event to parent via invoke callback
            onSendToParent?.invoke("{{ action.event }}", "")
{% endif %}
{% endif %}
{% elif action.target and action.target.startswith('#_') and action.target not in ['#_internal', '#_parent'] %}
{% if action.event %}
            // W3C SCXML 6.4 (test192): Send event to invoked child
            sendToChild("{{ action.target[2:] }}", "{{ action.event }}")
{% endif %}
{% elif action.send_type == 'http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor' and action.target and (action.target.startswith('http://') or action.target.startswith('https://')) %}
{# W3C SCXML C.2: BasicHTTP send — dispatch via HTTP POST (C++ HttpSendHelper pattern) #}
{% set http_needs_script = (action.params | selectattr('is_static_literal', 'equalto', False) | list | length > 0) or action.namelist or action.contentexpr or action.delayexpr %}
{% if http_needs_script and model.needs_script_engine %}
            // W3C SCXML C.2: BasicHTTP send with script engine evaluation
            run {
                ensureScriptEngine()
                val engineH = scriptEngine ?: return@run
                val sidH = scriptSessionId ?: return@run
                val httpParams = mutableMapOf<String, List<String>>()
{% for param in action.params %}
{% if param.is_static_literal %}
                httpParams["{{ param.name }}"] = listOf("{{ param.static_value }}")
{% elif param.expr %}
                try {
                    val v = engineH.evaluateExpr(sidH, "{{ param.expr | escape_kotlin }}")
                    httpParams["{{ param.name }}"] = listOf(v?.toString() ?: "")
                } catch (_: Exception) {
                    httpParams["{{ param.name }}"] = listOf("")
                }
{% endif %}
{% endfor %}
{% if action.namelist %}
                // W3C SCXML C.1: Evaluate namelist — abort send on error (C++ NamelistHelper pattern)
{% for var_name in action.namelist.split() %}
                if (!engineH.hasVariable(sidH, "{{ var_name }}")) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run
                }
                try {
                    val v = engineH.getVariable(sidH, "{{ var_name }}")
                    httpParams["{{ var_name }}"] = listOf(v?.toString() ?: "")
                } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run
                }
{% endfor %}
{% endif %}
{% if action.contentexpr %}
                // W3C SCXML C.2: Dynamic content expression
                val httpContent: String
                try {
                    val v = engineH.evaluateExpr(sidH, "{{ action.contentexpr | escape_kotlin }}")
                    httpContent = v?.toString() ?: ""
                } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata.platform())
                    return@run
                }
{% else %}
                val httpContent = "{{ action.content | escape_kotlin }}"
{% endif %}
{% if action.delayexpr %}
                // W3C SCXML C.2: Dynamic delay for HTTP send
                val delayStrH: String
                try {
                    val v = engineH.evaluateExpr(sidH, "{{ action.delayexpr | escape_kotlin }}")
                    delayStrH = v?.toString() ?: "0s"
                } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata.platform())
                    return@run
                }
                val delayMsH = parseDelay(delayStrH)
                scheduleHttpSend(delayMsH, "{{ action.target }}", "{{ action.event }}", httpContent, httpParams, "{{ action.auto_send_id }}")
{% elif action.delay %}
                scheduleHttpSend({{ action.delay_ms | default(0) }}L, "{{ action.target }}", "{{ action.event }}", httpContent, httpParams, "{{ action.auto_send_id }}")
{% else %}
                performHttpSend("{{ action.target }}", "{{ action.event }}", httpContent, httpParams, "{{ action.auto_send_id }}")
{% endif %}
            }
{% elif action.params %}
            // W3C SCXML C.2: BasicHTTP send with static params (test 531)
            run {
                val httpParams = mutableMapOf<String, List<String>>()
{% for param in action.params %}
                httpParams["{{ param.name }}"] = listOf("{{ param.static_value }}")
{% endfor %}
{% if action.delay %}
                scheduleHttpSend({{ action.delay_ms | default(0) }}L, "{{ action.target }}", "{{ action.event }}", "", httpParams, "{{ action.auto_send_id }}")
{% else %}
                performHttpSend("{{ action.target }}", "{{ action.event }}", "", httpParams, "{{ action.auto_send_id }}")
{% endif %}
            }
{% elif action.content %}
            // W3C SCXML C.2: BasicHTTP content-only send (test 520, 532)
{% if action.delay %}
            scheduleHttpSend({{ action.delay_ms | default(0) }}L, "{{ action.target }}", "{{ action.event }}", "{{ action.content | escape_kotlin }}", emptyMap(), "{{ action.auto_send_id }}")
{% else %}
            performHttpSend("{{ action.target }}", "{{ action.event }}", "{{ action.content | escape_kotlin }}", emptyMap(), "{{ action.auto_send_id }}")
{% endif %}
{% elif action.event %}
            // W3C SCXML C.2: BasicHTTP event send (test 534)
{% if action.delay %}
            scheduleHttpSend({{ action.delay_ms | default(0) }}L, "{{ action.target }}", "{{ action.event }}", "", emptyMap(), "{{ action.auto_send_id }}")
{% else %}
            performHttpSend("{{ action.target }}", "{{ action.event }}", "", emptyMap(), "{{ action.auto_send_id }}")
{% endif %}
{% else %}
            // W3C SCXML C.2: BasicHTTP send with no event/content/params
            performHttpSend("{{ action.target }}", "", "", emptyMap(), "{{ action.auto_send_id }}")
{% endif %}
{% else %}
{# Default: send to self (external queue) #}
{% set needs_params = action.params or action.namelist %}
{% if needs_params and model.needs_script_engine %}
            // W3C SCXML 5.10: Evaluate params/namelist for event data
            run {
                ensureScriptEngine()
                val engineE = scriptEngine ?: return@run
                val sidE = scriptSessionId ?: return@run
                val paramsE = mutableMapOf<String, Any?>()
{% for param in action.params %}
{% if param.is_static_literal %}
                paramsE["{{ param.name }}"] = "{{ param.static_value }}"
{% elif param.expr %}
                try { paramsE["{{ param.name }}"] = engineE.evaluateExpr(sidE, "{{ param.expr | escape_kotlin }}") } catch (_: Exception) { paramsE["{{ param.name }}"] = "" }
{% endif %}
{% endfor %}
{% if action.namelist %}
                // W3C SCXML C.1: Evaluate namelist — abort send on error (C++ NamelistHelper pattern, test553)
{% for var_name in action.namelist.split() %}
                if (!engineE.hasVariable(sidE, "{{ var_name }}")) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run  // W3C SCXML 6.2: Abort send if namelist variable not found
                }
                try { paramsE["{{ var_name }}"] = engineE.getVariable(sidE, "{{ var_name }}") } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run
                }
{% endfor %}
{% endif %}
                val eventDataE = buildJsonFromParams(paramsE)
{% if action.event %}
{% if action.delay or action.delayexpr %}
                scheduleSend("{{ action.auto_send_id }}", {{ action.delay_ms | default(0) }}L, {{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ action.auto_send_id }}", origin = scriptSessionId ?: "", data = eventDataE))
{% else %}
                send({{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ action.auto_send_id }}", origin = scriptSessionId ?: "", data = eventDataE))
{% endif %}
{% endif %}
            }
{% elif action.content and action.event %}
            // W3C SCXML B.2: Set event data from <content> (C++ EventDataHelper::jsonStringToScriptValue pattern)
{% if action.delay or action.delayexpr %}
            scheduleSend("{{ action.auto_send_id }}", {{ action.delay_ms | default(0) }}L, {{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ action.auto_send_id }}", origin = scriptSessionId ?: "", data = "{{ action.content | escape_kotlin }}"))
{% else %}
            send({{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ action.auto_send_id }}", origin = scriptSessionId ?: "", data = "{{ action.content | escape_kotlin }}"))
{% endif %}
{% elif action.contentexpr and action.event and model.needs_script_engine %}
            // W3C SCXML 5.10: Evaluate content expression
            run {
                ensureScriptEngine()
                val engineC = scriptEngine ?: return@run
                val sidC = scriptSessionId ?: return@run
                val contentData: String
                try {
                    val v = engineC.evaluateExpr(sidC, "{{ action.contentexpr | escape_kotlin }}")
                    contentData = if (v != null) valueToJson(v) else ""
                } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata.platform())
                    return@run
                }
{% if action.delay or action.delayexpr %}
                scheduleSend("{{ action.auto_send_id }}", {{ action.delay_ms | default(0) }}L, {{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ action.auto_send_id }}", origin = scriptSessionId ?: "", data = contentData))
{% else %}
                send({{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ action.auto_send_id }}", origin = scriptSessionId ?: "", data = contentData))
{% endif %}
            }
{% elif action.event %}
{% if action.delay or action.delayexpr %}
{% if action.delayexpr and model.needs_script_engine %}
            // W3C SCXML 6.2: Dynamic delay evaluation
            run {
                ensureScriptEngine()
                val engineDly = scriptEngine ?: return@run
                val sidDly = scriptSessionId ?: return@run
                val delayStrE: String
