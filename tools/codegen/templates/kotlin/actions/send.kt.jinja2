{# W3C SCXML 6.2: Send action with target/type validation, delay, and invoke routing.
   Expects `action` and `machine_name` variables in scope.
   Uses action.auto_send_id for unique delayed send identification (C++ UniqueIdGenerator pattern).

   The send is composed from four parts, each decided once: the element's own
   arguments (the prologue), the payload (`sendData`, and the text form
   `sendWireParams` for a transport that posts a form), the event, and the
   delivery. Every delivery arm reads the parts; none evaluates anything
   itself, so an argument cannot be read one way for one target and another
   way for the next. #}
{# W3C SCXML 5.7.1: one `<param>` arm. The param names its value through
   `expr` or, failing that, `location`. One that cannot be read — an empty
   `location=""` included, which names nothing — raises error.execution and
   its pair is left out; the message still goes, because §6.2's "discard the
   message" governs `<send>`'s own arguments, not its `<param>` children (W3C
   test343 reads the clause the same way under `<donedata>`). `paramFailed`
   records it for the block exit below. #}
{% macro param_expr_arm(param, map, eng, sid, machine_name, indent) %}
{% if param.expr or param.location %}
{{ indent }}try {
{{ indent }}    putParam({{ map }}, "{{ param.name | escape_kotlin }}", {{ eng }}.evaluateExpr({{ sid }}, {{ (param.expr if param.expr else param.location) | to_script_source_expr }}))
{{ indent }}} catch (_: Exception) {
{{ indent }}    raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> <param name='{{ param.name | escape_kotlin }}'> could not be read")
{{ indent }}    paramFailed = true
{{ indent }}}
{% else %}
{{ indent }}raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> <param name='{{ param.name | escape_kotlin }}'> names no location")
{{ indent }}paramFailed = true
{% endif %}
{% endmacro %}
{# W3C SCXML B.2 orders three readings, and only two of them are values this
   side can produce. XML is the first: it becomes a DOM node, which is built by
   whatever binds `_event.data` — both engines this backend runs on open with
   that check — so the source text is what has to arrive, unevaluated. Sending
   it through `JSON.stringify` instead turned W3C 561's `<books>` document into
   a syntax error. #}
{% if action.content %}
{% if (action.content | trim) is startingwith('<') %}
{% set content_data = '"' ~ (action.content | escape_kotlin) ~ '"' %}
{% else %}
{% set content_data = 'evaluateSendContent(' ~ (action.content | to_script_source_data_content) ~ ')' %}
{% endif %}
{% endif %}
{% set send_id_kt = action.auto_send_id | escape_kotlin %}
{% set has_namelist = action.namelist and action.namelist | trim %}
{% set param_ns = namespace(can_fail=false) %}
{% for param in action.params %}
{% if not param.is_static_literal %}
{% set param_ns.can_fail = true %}
{% endif %}
{% endfor %}
{% set dyn_event = action.eventexpr and model.needs_script_engine and not action.event %}
{% set dyn_target = action.targetexpr and model.needs_script_engine %}
{% set dyn_delay = action.delayexpr and model.needs_script_engine %}
{% set has_delay = action.delay or action.delayexpr %}
{% set is_http = action.send_type == 'http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor' %}
{# The form a transport posts is needed only by the two that post one. #}
{% set needs_wire_params = action.send_type_host_served or is_http %}
{# ── The element's own arguments, evaluated once ──
   W3C SCXML 6.2: "The Processor MUST evaluate all arguments to <send> when the
   <send> element is evaluated", and "if the evaluation of <send>'s arguments
   produces an error, the Processor MUST discard the message without attempting
   to deliver it". So every argument is read here, before any arm runs. The
   first failure is one error.execution carrying the send id, the message goes
   nowhere, and — the error having been raised while the element was
   processed — the block ends (W3C SCXML 4.9): `return@send true`. #}
{% set send_prologue = model.needs_script_engine and (action.eventexpr or action.targetexpr or action.typeexpr or action.delayexpr or has_namelist or action.idlocation) %}
            if (run send@{
{% if param_ns.can_fail %}
            var paramFailed = false
{% endif %}
{% if send_prologue %}
            ensureScriptEngine()
            val argEngine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
            val argSid = scriptSessionId ?: error("scriptSessionId must be initialized after ensureScriptEngine() (codegen invariant)")
{% if action.idlocation %}
            // W3C SCXML 6.2.4: the send id goes to `idlocation` first, so it is
            // there even when a later argument fails (test183, test332),
            // through the assignment `<assign>` makes — the location is lowered,
            // so a member path lands. A location that cannot take the id is an
            // argument that cannot be evaluated (W3C SCXML 5.9.2).
            if (!storeIdInLocation({{ action.idlocation | to_script_source_location }}, "{{ send_id_kt }}", "<send>")) return@send true
{% endif %}
{% if action.eventexpr %}
            // An event name that evaluates to nothing names no event: the same
            // failure as one that does not evaluate (test172).
            val sendEventName = try {
                valueToWireString(argEngine.evaluateExpr(argSid, {{ action.eventexpr | to_script_source_expr }}))
            } catch (_: Exception) {
                ""
            }
            if (sendEventName.isEmpty()) {
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> eventexpr could not be evaluated to an event name", "{{ send_id_kt }}")
                return@send true
            }
{% endif %}
{% if action.targetexpr %}
            // §scxml-C-1: a target expression's value is read as text — the
            // same reading C++ `resultToString` gives it.
            val _rt = try {
                valueToWireString(argEngine.evaluateExpr(argSid, {{ action.targetexpr | to_script_source_expr }}))
            } catch (_: Exception) {
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> targetexpr could not be evaluated", "{{ send_id_kt }}")
                return@send true
            }
            if (com.sce.runtime.SendHelper.isInvalidTarget(_rt)) {
                // W3C SCXML 6.2 (test194): refused as a static one is.
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> targetexpr produced a target this processor cannot address", "{{ send_id_kt }}")
                return@send true
            }
{% endif %}
{% if action.typeexpr %}
            // W3C SCXML 6.2: a type the platform does not support is the same
            // error as one that cannot be evaluated.
            val sendTypeValue = try {
                valueToWireString(argEngine.evaluateExpr(argSid, {{ action.typeexpr | to_script_source_expr }}))
            } catch (_: Exception) {
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> typeexpr could not be evaluated", "{{ send_id_kt }}")
                return@send true
            }
            if (!com.sce.runtime.SendHelper.isSupportedSendType(sendTypeValue)) {
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> typeexpr names a processor this platform does not support", "{{ send_id_kt }}")
                return@send true
            }
{% endif %}
{% if action.delayexpr %}
            // The expression failing is the argument error; the message is not
            // scheduled under some default wait. A value that does not read as
            // a duration is sent at once, as the Interpreter reads it.
            val sendDelayMs = try {
                parseDelay(valueToWireString(argEngine.evaluateExpr(argSid, {{ action.delayexpr | to_script_source_expr }})))
            } catch (_: Exception) {
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> delayexpr could not be evaluated", "{{ send_id_kt }}")
                return@send true
            }
{% endif %}
{% if has_namelist %}
            // W3C SCXML 6.2 + B.2 (test553): a namelist names locations, and one
            // that is not declared is an argument that cannot be evaluated —
            // one error however many of its names are bad.
            val sendNamelist = mutableListOf<Pair<String, Any?>>()
{% for var_name in action.namelist.split() %}
            if (!argEngine.hasVariable(argSid, "{{ var_name | escape_kotlin }}")) {
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> namelist names '{{ var_name | escape_kotlin }}', which is not declared", "{{ send_id_kt }}")
                return@send true
            }
            try {
                sendNamelist.add("{{ var_name | escape_kotlin }}" to argEngine.getVariable(argSid, "{{ var_name | escape_kotlin }}"))
            } catch (_: Exception) {
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> namelist entry '{{ var_name | escape_kotlin }}' could not be read", "{{ send_id_kt }}")
                return@send true
            }
{% endfor %}
{% endif %}
{% if action.targetexpr %}
            if (com.sce.runtime.SendHelper.isUnreachableTarget(_rt)) {
                // W3C SCXML C.1 (test496): a target that names nothing is not
                // reachable — error.communication, nothing delivered, and the
                // error ends the block as any other would (W3C SCXML 4.9).
                raisePlatformError({{ machine_name }}Event.Error.Communication, "<send> targetexpr evaluated to nothing, so there is no target to reach", "{{ send_id_kt }}")
                return@send true
            }
{% endif %}
{% endif %}
{# ── The payload ──
   W3C SCXML 5.10 / C.1: the namelist and `<param>` pairs, in the shape
   `buildJsonFromParams` serialises into `_event.data`; or the `<content>`.
   A `<param>` that cannot be read drops its pair (`param_expr_arm`). #}
{% if action.params or has_namelist %}
{% if param_ns.can_fail and model.needs_script_engine %}
            ensureScriptEngine()
            val payloadEngine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
            val payloadSid = scriptSessionId ?: error("scriptSessionId must be initialized after ensureScriptEngine() (codegen invariant)")
{% endif %}
            val sendPayload = mutableMapOf<String, Any?>()
{% for param in action.params %}
{% if param.is_static_literal %}
            putParam(sendPayload, "{{ param.name | escape_kotlin }}", "{{ param.static_value | escape_kotlin }}")
{% elif model.needs_script_engine %}
{{ param_expr_arm(param, 'sendPayload', 'payloadEngine', 'payloadSid', machine_name, '            ') }}
{% endif %}
{% endfor %}
{% if has_namelist and model.needs_script_engine %}
            // W3C SCXML C.1: namelist variables become top-level keys in the
            // data table — the values the prologue read, after the params.
            for ((name, value) in sendNamelist) sendPayload[name] = value
{% endif %}
            val sendData = buildJsonFromParams(sendPayload)
{% if needs_wire_params %}
            // The same pairs as the text a form carries (W3C SCXML C.2), so no
            // `<param>` is evaluated twice.
            val sendWireParams = sendPayload.mapValues { (_, v) ->
                if (v is RepeatedParam) v.values.map { valueToWireString(it) } else listOf(valueToWireString(v))
            }
{% endif %}
{% elif action.content %}
            val sendData = {{ content_data }}
{% if needs_wire_params %}
            val sendWireParams = emptyMap<String, List<String>>()
{% endif %}
{% elif action.contentexpr and model.needs_script_engine %}
            ensureScriptEngine()
            val sendContentValue = try {
                (scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)"))
                    .evaluateExpr(scriptSessionId ?: error("scriptSessionId must be initialized after ensureScriptEngine() (codegen invariant)"), {{ action.contentexpr | to_script_source_expr }})
            } catch (_: Exception) {
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send> contentexpr failed to evaluate", "{{ send_id_kt }}")
                return@send true
            }
            val sendData = if (sendContentValue != null) valueToJson(sendContentValue) else ""
{% if needs_wire_params %}
            val sendWireParams = emptyMap<String, List<String>>()
{% endif %}
{% else %}
            val sendData = ""
{% if needs_wire_params %}
            val sendWireParams = emptyMap<String, List<String>>()
{% endif %}
{% endif %}
{# ── The event ── the name a remote end resolves (`sendEventName`, or the
   literal), and the event this machine raises when it delivers locally. #}
{% if dyn_event %}
            val sendEvent = resolveEventByName(sendEventName)
{% endif %}
{% if dyn_delay %}
{% set delay_kt = 'sendDelayMs' %}
{% else %}
{% set delay_kt = (action.delay_ms | default(0, true)) ~ 'L' %}
{% endif %}
{# ── The delivery ── #}
{% if action.send_type_host_served %}
            // W3C SCXML 6.2.5: "{{ action.send_type }}" is served by the host,
            // which declared it to this build. Dispatch rather than refuse —
            // and take the whole send, because a processor the host serves
            // owns delivery; falling through would also enqueue the event
            // locally and the document would see the act twice.
            val hostRequest = HostSendRequest(
                processorType = "{{ action.send_type | escape_kotlin }}",
                eventName = {% if dyn_event %}sendEventName{% else %}"{{ action.event | default('', true) | escape_kotlin }}"{% endif %},
                target = {% if dyn_target %}_rt{% else %}"{{ action.target | default('', true) | escape_kotlin }}"{% endif %},
                content = "{{ action.content | default('', true) | escape_kotlin }}",
                params = sendWireParams,
                sendId = "{{ send_id_kt }}",
                eventData = sendData
            )
{% set host_delay_ms = action.delay_ms if (action.delay_ms is defined and action.delay_ms is not none and action.delay_ms > 0) else 0 %}
{% if dyn_delay or host_delay_ms > 0 %}
            // W3C SCXML 6.2.4: a `delay` is a property of the SEND, not of the
            // processor it named. The engine performs the act from its
            // scheduler drain at the deadline, including the W3C SCXML 6.2
            // report for an act nobody performed. W3C SCXML 6.3: it lands in
            // the delayed-send queue under the send id, so a `<cancel>`
            // reaches it and the host never sees the act.
            scheduleHostSend("{{ send_id_kt }}", {{ delay_kt }}, hostRequest)
{% else %}
            val hostServed = performHostSend(hostRequest)
            // W3C SCXML 6.2: a declared type with no handler registered is,
            // from the document's side, a processor the platform does not
            // support — the act it asked for was performed by nobody. Same
            // event as an undeclared type, so a wiring mistake cannot read
            // as success.
            if (hostServed == null && !hasEventProcessor("{{ action.send_type | escape_kotlin }}")) {
                raisePlatformError({{ machine_name }}Event.Error.Execution, "<send type='{{ action.send_type }}'> names a processor the host declared but never registered", "{{ send_id_kt }}")
            }
{% endif %}
{% elif action.send_type_unsupported %}
            // W3C SCXML 6.2 (test199): Unsupported send type raises error.execution
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<send type='{{ action.send_type }}'> names a processor this platform does not support", "{{ send_id_kt }}")
            return@send true  // W3C SCXML 5.10: discarded; the block stops below
{% elif not action.targetexpr and action.target and action.target.startswith('!') %}
            // W3C SCXML 6.2 (test194): Invalid target raises error.execution
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<send target='{{ action.target }}'> is not a target this processor can address", "{{ send_id_kt }}")
            return@send true  // W3C SCXML 5.10: discarded; the block stops below
{% elif is_http and not action.target and not action.targetexpr %}
            // W3C SCXML C.2 (test577): BasicHTTP requires target, missing raises error.communication
            raisePlatformError({{ machine_name }}Event.Error.Communication, "<send> over BasicHTTPEventProcessor has no target to post to", "{{ send_id_kt }}")
            return@send true  // W3C SCXML 5.10: discarded; the block stops below
{% elif is_http and (dyn_target or (action.target and (action.target.startswith('http://') or action.target.startswith('https://')))) %}
            // W3C SCXML C.2: BasicHTTP send — one arm for a static and a dynamic target
{% if dyn_target %}
            if (!_rt.startsWith("http://") && !_rt.startsWith("https://")) {
                raisePlatformError({{ machine_name }}Event.Error.Communication, "<send> over BasicHTTPEventProcessor resolved a target that is not an http(s) URL", "{{ send_id_kt }}")
                return@send true
            }
{% endif %}
{% if action.contentexpr and model.needs_script_engine and not (action.params or has_namelist or action.content) %}
            val httpContent = valueToWireString(sendContentValue)
{% else %}
            val httpContent = "{{ action.content | default('', true) | escape_kotlin }}"
{% endif %}
{% if has_delay %}
            scheduleHttpSend({{ delay_kt }}, {% if dyn_target %}_rt{% else %}"{{ action.target | escape_kotlin }}"{% endif %}, {% if dyn_event %}sendEventName{% else %}"{{ action.event | default('', true) | escape_kotlin }}"{% endif %}, httpContent, sendWireParams, "{{ send_id_kt }}")
{% else %}
            performHttpSend({% if dyn_target %}_rt{% else %}"{{ action.target | escape_kotlin }}"{% endif %}, {% if dyn_event %}sendEventName{% else %}"{{ action.event | default('', true) | escape_kotlin }}"{% endif %}, httpContent, sendWireParams, "{{ send_id_kt }}")
{% endif %}
{% elif not (action.event or dyn_event) %}
            // W3C SCXML 6.2: no event to deliver.
{% elif not action.targetexpr and action.target == '#_internal' %}
            // W3C SCXML 5.10: an internal send carries `_event.data` just as an
            // external one does.
{% if dyn_event %}
            if (sendEvent != null) raiseInternal(sendEvent, EventMetadata.internal(sendData))
{% else %}
            raiseInternal({{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.internal(sendData))
{% endif %}
{% elif not action.targetexpr and action.target == '#_parent' %}
{% if has_delay %}
            // W3C SCXML 6.4 (test187): Delayed send to parent — cancelled when child stops
            scheduleParentSend("{{ send_id_kt }}", {{ delay_kt }}, {% if dyn_event %}sendEventName{% else %}"{{ action.event | escape_kotlin }}"{% endif %}, sendData)
{% else %}
            // W3C SCXML 6.4 (test191): Send event to parent via invoke callback
            onSendToParent?.invoke({% if dyn_event %}sendEventName{% else %}"{{ action.event | escape_kotlin }}"{% endif %}, sendData)
{% endif %}
{% elif not action.targetexpr and action.target and action.target.startswith('#_') %}
            // W3C SCXML 6.4 (test192): Send event to invoked child
            sendToChild("{{ action.target[2:] | escape_kotlin }}", {% if dyn_event %}sendEventName{% else %}"{{ action.event | escape_kotlin }}"{% endif %}, sendData)
{% elif dyn_target and has_delay %}
            // W3C SCXML 6.2: a delayed send to a dynamic target is scheduled
            // locally (C++ pattern: delay before target routing).
{% if dyn_event %}
            if (sendEvent != null) scheduleSend("{{ send_id_kt }}", {{ delay_kt }}, sendEvent, EventMetadata.external(sendId = "{{ send_id_kt }}", origin = scriptSessionId ?: "", data = sendData))
{% else %}
            scheduleSend("{{ send_id_kt }}", {{ delay_kt }}, {{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ send_id_kt }}", origin = scriptSessionId ?: "", data = sendData))
{% endif %}
{% elif dyn_target %}
            // W3C SCXML 6.2: Dispatch to dynamically resolved target (C++ unified pattern)
            if (_rt == "#_internal") {
{% if dyn_event %}
                if (sendEvent != null) raiseInternal(sendEvent, EventMetadata.internal(sendData))
{% else %}
                raiseInternal({{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.internal(sendData))
{% endif %}
            } else if (_rt == "#_parent") {
                onSendToParent?.invoke({% if dyn_event %}sendEventName{% else %}"{{ action.event | escape_kotlin }}"{% endif %}, sendData)
            } else if (deliverToChildSession(
                    com.sce.runtime.IoProcessors.sessionIdFromScxmlLocation(_rt),
                    {% if dyn_event %}sendEventName{% else %}"{{ action.event | escape_kotlin }}"{% endif %},
                    sendData)) {
                // W3C SCXML C.1: the target decoded to one of our children's
                // published locations, so it is addressed to that child.
                // Without this arm the address a peer was told to answer at
                // routes back into the sender's own queue, so the location
                // compares equal and still reaches nobody.
            } else {
{% if dyn_event %}
                if (sendEvent != null) send(sendEvent, EventMetadata.external(sendId = "{{ send_id_kt }}", origin = scriptSessionId ?: "", data = sendData))
{% else %}
                send({{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ send_id_kt }}", origin = scriptSessionId ?: "", data = sendData))
{% endif %}
            }
{% elif has_delay %}
            // W3C SCXML 6.2: Delayed send
{% if dyn_event %}
            if (sendEvent != null) scheduleSend("{{ send_id_kt }}", {{ delay_kt }}, sendEvent, EventMetadata.external(sendId = "{{ send_id_kt }}", origin = scriptSessionId ?: "", data = sendData))
{% else %}
            scheduleSend("{{ send_id_kt }}", {{ delay_kt }}, {{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ send_id_kt }}", origin = scriptSessionId ?: "", data = sendData))
{% endif %}
{% else %}
            // W3C SCXML 6.2: send to this session's external queue
{% if dyn_event %}
            if (sendEvent != null) send(sendEvent, EventMetadata.external(sendId = "{{ send_id_kt }}", origin = scriptSessionId ?: "", data = sendData))
{% else %}
            send({{ machine_name }}Event.{{ action.event | to_event_ref }}, EventMetadata.external(sendId = "{{ send_id_kt }}", origin = scriptSessionId ?: "", data = sendData))
{% endif %}
{% endif %}
{% if param_ns.can_fail %}
            paramFailed
{% else %}
            false
{% endif %}
            }) {
                // W3C SCXML 4.9: an error raised while this element was
                // processed ends the block.
{# The closing line sits in both arms so this partial ends on a block tag,
   as every partial `_render` includes does: a render drops its one trailing
   newline, and a partial ending on text glues the includer's next line onto
   its last. #}
{% if _in_foreach_body is defined and _in_foreach_body %}
                throw com.sce.runtime.ActionBlockAbort()
            } // end of run send@ (W3C SCXML 6.2: a discarded message)
{% elif in_run_block is defined and in_run_block %}
                return@run
            } // end of run send@ (W3C SCXML 6.2: a discarded message)
{% else %}
                return
            } // end of run send@ (W3C SCXML 6.2: a discarded message)
{% endif %}
