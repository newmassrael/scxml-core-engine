{# W3C SCXML C.2: Shared BasicHTTP send body (Zero Duplication).
   Called from both targetexpr and static-target branches of send.kt.jinja2.
   Follows C++ send.jinja2 unified http_target_cpp pattern.

   Expects caller to set these Jinja2 variables:
   - http_target: Kotlin expression for target URL (e.g., 'dynamicTarget' or '"http://..."')
   - http_engine: Kotlin variable name for script engine (e.g., 'engineT')
   - http_sid: Kotlin variable name for session ID (e.g., 'sidT')
   - http_in_run_block: true if caller already opened a run {} block with engine/sid
   Standard context (action, machine_name, model) inherited via 'with context'. #}
{% set http_needs_script = (action.params | selectattr('is_static_literal', 'equalto', False) | list | length > 0) or action.namelist or action.contentexpr or action.delayexpr %}
{% set _ind = '                ' if http_in_run_block else '            ' %}
{% if http_needs_script and model.needs_script_engine %}
{% if not http_in_run_block %}
            // W3C SCXML C.2: BasicHTTP send with script engine evaluation
            run {
                ensureScriptEngine()
                val {{ http_engine }} = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
                val {{ http_sid }} = scriptSessionId ?: error("scriptSessionId must be initialized after ensureScriptEngine() (codegen invariant)")
{% endif %}
                val httpParams = mutableMapOf<String, List<String>>()
{% for param in action.params %}
{% if param.is_static_literal %}
                httpParams["{{ param.name }}"] = listOf("{{ param.static_value }}")
{% elif param.expr %}
                try {
                    val v = {{ http_engine }}.evaluateExpr({{ http_sid }}, "{{ param.expr | escape_kotlin }}")
                    httpParams["{{ param.name }}"] = listOf(v?.toString() ?: "")
                } catch (_: Exception) {
                    httpParams["{{ param.name }}"] = listOf("")
                }
{% endif %}
{% endfor %}
{% if action.namelist %}
                // W3C SCXML C.1: Evaluate namelist — abort send on error (C++ NamelistHelper pattern)
{% for var_name in action.namelist.split() %}
                if (!{{ http_engine }}.hasVariable({{ http_sid }}, "{{ var_name }}")) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run
                }
                try {
                    val v = {{ http_engine }}.getVariable({{ http_sid }}, "{{ var_name }}")
                    httpParams["{{ var_name }}"] = listOf(v?.toString() ?: "")
                } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution)
                    return@run
                }
{% endfor %}
{% endif %}
{% if action.contentexpr %}
                // W3C SCXML C.2: Dynamic content expression
                val httpContent: String
                try {
                    val v = {{ http_engine }}.evaluateExpr({{ http_sid }}, "{{ action.contentexpr | escape_kotlin }}")
                    httpContent = v?.toString() ?: ""
                } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata.platform())
                    return@run
                }
{% else %}
                val httpContent = "{{ action.content | escape_kotlin }}"
{% endif %}
{% if action.delayexpr %}
                // W3C SCXML C.2: Dynamic delay for HTTP send
                val delayStr: String
                try {
                    val v = {{ http_engine }}.evaluateExpr({{ http_sid }}, "{{ action.delayexpr | escape_kotlin }}")
                    delayStr = v?.toString() ?: "0s"
                } catch (_: Exception) {
                    raiseInternal({{ machine_name }}Event.Error.Execution, EventMetadata.platform())
                    return@run
                }
                val delayMs = parseDelay(delayStr)
                scheduleHttpSend(delayMs, {{ http_target }}, "{{ action.event }}", httpContent, httpParams, "{{ action.auto_send_id }}")
{% elif action.delay %}
                scheduleHttpSend({{ action.delay_ms | default(0) }}L, {{ http_target }}, "{{ action.event }}", httpContent, httpParams, "{{ action.auto_send_id }}")
{% else %}
                performHttpSend({{ http_target }}, "{{ action.event }}", httpContent, httpParams, "{{ action.auto_send_id }}")
{% endif %}
{% if not http_in_run_block %}
            }
{% endif %}
{% elif action.params %}
{% if not http_in_run_block %}
            // W3C SCXML C.2: BasicHTTP send with static params
            run {
{% endif %}
                val httpParams = mutableMapOf<String, List<String>>()
{% for param in action.params %}
                httpParams["{{ param.name }}"] = listOf("{{ param.static_value }}")
{% endfor %}
{% if action.delay %}
                scheduleHttpSend({{ action.delay_ms | default(0) }}L, {{ http_target }}, "{{ action.event }}", "", httpParams, "{{ action.auto_send_id }}")
{% else %}
                performHttpSend({{ http_target }}, "{{ action.event }}", "", httpParams, "{{ action.auto_send_id }}")
{% endif %}
{% if not http_in_run_block %}
            }
{% endif %}
{% elif action.content %}
{% if action.delay %}
{{ _ind }}scheduleHttpSend({{ action.delay_ms | default(0) }}L, {{ http_target }}, "{{ action.event }}", "{{ action.content | escape_kotlin }}", emptyMap(), "{{ action.auto_send_id }}")
{% else %}
{{ _ind }}performHttpSend({{ http_target }}, "{{ action.event }}", "{{ action.content | escape_kotlin }}", emptyMap(), "{{ action.auto_send_id }}")
{% endif %}
{% elif action.event %}
{% if action.delay %}
{{ _ind }}scheduleHttpSend({{ action.delay_ms | default(0) }}L, {{ http_target }}, "{{ action.event }}", "", emptyMap(), "{{ action.auto_send_id }}")
{% else %}
{{ _ind }}performHttpSend({{ http_target }}, "{{ action.event }}", "", emptyMap(), "{{ action.auto_send_id }}")
{% endif %}
{% else %}
{{ _ind }}performHttpSend({{ http_target }}, "", "", emptyMap(), "{{ action.auto_send_id }}")
{% endif %}
