{#
    Kotlin Script Engine Helpers Template

    W3C SCXML B.1: ECMAScript datamodel support for hybrid (static + script engine) SMs.
    Ported 1:1 from C++ scriptengine_helpers.jinja2 + utility_methods.jinja2.

    Generates:
    - establishScriptSession(): the session, made once, at the start (docs/adr/0096)
    - declareDatamodel(): <data>, early <data>, invoke params, top-level <script>
    - safeEvaluateGuard(): Guard condition evaluation with error.execution on failure
    - executeAssign(): Variable assignment via script engine
    - executeScriptBlock(): <script> block execution via script engine
    - setCurrentEventInScriptEngine(): Set _event before event processing

    docs/adr/0096: the script session is made in one place,
    `establishScriptSession`, the first step of every start; what runs after
    the start reads the session that step established (`assertScriptSession`,
    in the runtime).
#}
{% if model.needs_script_engine %}

    // --- Script Engine Helpers (W3C SCXML B.1) ---

    // docs/adr/0096: make this machine's script session, the first step of
    // every start (`initialize`, `start`, `enterAt`, and the start of a child
    // this machine is). The runtime's `makeScriptSession` takes the three steps
    // (create the session, which loads the shared library into it, then bind
    // the system variables), releases what a failed step made and answers the
    // failure, which refuses the start with nothing entered; a later start
    // asks for the session again.
    override fun establishScriptSession(): com.sce.runtime.ScriptSessionFailure? {
        val engine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
        makeScriptSession(
            engine,
            "{{ model.scxml_name | default('') | w3c_session_name(model.name) | escape_kotlin }}",
        )?.let { return it }
{% if model.has_parallel_states or model.uses_in_predicate %}

        // W3C SCXML 5.9.2: Register In() predicate callback, before any
        // `<data>` or top-level `<script>` can ask it
        val sid = scriptSessionId ?: error("scriptSessionId is established by the start (codegen invariant)")
        engine.setStateQueryCallback(sid) { stateId -> isStateActive(stateId) }
{% endif %}
        return null
    }

    // W3C SCXML 5.3: initialize the datamodel in the session the start
    // established, before any state is entered: the document's <data>, its
    // states' early-bound <data>, the invoke params the parent handed this
    // session, then the top-level <script>s. The params are applied before the
    // scripts, which read the datamodel the invocation started it with: the
    // order of interpret in Appendix D, and that of every other backend.
    override fun declareDatamodel() {
        assertScriptSession()
        val engine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
        val sid = scriptSessionId ?: error("scriptSessionId is established by the start (codegen invariant)")

{# The document's <data>, its states' early-bound <data> and its top-level
   <script>s are run by parts of at most `kotlin_method_items` items, each a
   method of its own (`declareVariablesPart<n>`, `declareStateVariablesPart<n>`,
   `runDocumentScriptsPart<n>`), in document order: one statement each in
   this one method grew with the document past what one JVM method holds
   (dispatch.kt.jinja2). #}
{% set declared_parts = model.variables | batch(kotlin_method_items) | list %}
{% set early_items = namespace(list=[]) %}
{% if model.binding == 'early' %}
{% for state_id, state in model.states | dictsort %}
{% for dm_var in state.datamodel %}
{% set early_items.list = early_items.list + [[state_id, dm_var]] %}
{% endfor %}
{% endfor %}
{% endif %}
{% set early_parts = early_items.list | batch(kotlin_method_items) | list %}
{% set script_parts = model.global_scripts | batch(kotlin_method_items) | list %}
{% for part in declared_parts %}
        declareVariablesPart{{ loop.index0 }}(engine, sid)
{% endfor %}

{% if early_parts %}
        // W3C SCXML 5.3: Early binding — initialize state-level datamodel variables at startup
{% for part in early_parts %}
        declareStateVariablesPart{{ loop.index0 }}(engine, sid)
{% endfor %}
{% endif %}

        // W3C SCXML 6.4: Apply pending invoke params from parent, overriding the
        // <data> default just bound, and only for a name this session declares
        // (C++ DatamodelValidationHelper). The parent hands them before this
        // session's start (`setInvokeParams`) and this session applies them, so
        // a child's session is made by the child.
        if (pendingInvokeParams.isNotEmpty()) {
            for ((pName, pValue) in pendingInvokeParams) {
                if (engine.hasVariable(sid, pName)) {
                    try { engine.setVariable(sid, pName, pValue) } catch (_: Exception) {}
                }
            }
            pendingInvokeParams = emptyMap()
        }
{% if script_parts %}

        // W3C SCXML 5.8: Execute global scripts at document load time
{% for part in script_parts %}
        runDocumentScriptsPart{{ loop.index0 }}(engine, sid)
{% endfor %}
{% endif %}
    }
{% for part in declared_parts %}

    @Suppress("UNUSED_PARAMETER")
    private fun declareVariablesPart{{ loop.index0 }}(engine: ScxmlScriptEngine, sid: String) {
{% for var in part %}
{% if var.expr %}
        // W3C SCXML 5.3: Initialize variable '{{ var.id }}' with expr
        try {
            val initResult_{{ var.id | to_camel_case }} = engine.evaluateExpr(sid, {{ var.expr | to_script_source_expr }})
            engine.setVariable(sid, "{{ var.id }}", initResult_{{ var.id | to_camel_case }})
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<data id='{{ var.id }}'> expr failed to evaluate")
        }
{% elif var.src %}
        // W3C SCXML 5.3.1: Load variable '{{ var.id }}' from external source (C++ DataModelInitHelper pattern)
        try {
            val srcContent_{{ var.id | to_camel_case }} = engine.loadDataFromSrc("{{ var.src }}", "{{ model.scxml_base_path }}")
            if (srcContent_{{ var.id | to_camel_case }} != null) {
                val srcValue_{{ var.id | to_camel_case }} = engine.parseDataValue(sid, srcContent_{{ var.id | to_camel_case }})
                engine.setVariable(sid, "{{ var.id }}", srcValue_{{ var.id | to_camel_case }})
            }
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<data id='{{ var.id }}' src='{{ var.src }}'> could not be loaded")
        }
{% elif var.content %}
        // W3C SCXML B.2: Initialize variable '{{ var.id }}' with inline content (C++ parseEventData pattern)
        try {
            val initResult_{{ var.id | to_camel_case }} = engine.parseDataValue(sid, "{{ var.content | escape_kotlin }}")
            engine.setVariable(sid, "{{ var.id }}", initResult_{{ var.id | to_camel_case }})
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<data id='{{ var.id }}'> content failed to initialise")
        }
{% elif var.type == 'runtime' %}
        // W3C SCXML 5.2: Runtime variable '{{ var.id }}' (late binding, undefined)
        try {
            engine.evaluateExpr(sid, "undefined")
            engine.setVariable(sid, "{{ var.id }}", null)
        } catch (_: Exception) {}
{% endif %}
{% endfor %}
    }
{% endfor %}
{% for part in early_parts %}

    private fun declareStateVariablesPart{{ loop.index0 }}(engine: ScxmlScriptEngine, sid: String) {
{% for item in part %}
{% set state_id = item[0] %}
{% set dm_var = item[1] %}
{% if dm_var.expr %}
        // State '{{ state_id }}' variable '{{ dm_var.id }}'
        try {
            val initResult_{{ dm_var.id | to_camel_case }} = engine.evaluateExpr(sid, {{ dm_var.expr | to_script_source_expr }})
            engine.setVariable(sid, "{{ dm_var.id }}", initResult_{{ dm_var.id | to_camel_case }})
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<data id='{{ dm_var.id }}'> expr failed to evaluate")
        }
{% elif dm_var.content %}
        // State '{{ state_id }}' variable '{{ dm_var.id }}' (inline content, C++ parseEventData pattern)
        try {
            val initResult_{{ dm_var.id | to_camel_case }} = engine.parseDataValue(sid, "{{ dm_var.content | escape_kotlin }}")
            engine.setVariable(sid, "{{ dm_var.id }}", initResult_{{ dm_var.id | to_camel_case }})
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<data id='{{ dm_var.id }}'> content failed to initialise")
        }
{% else %}
        engine.setVariable(sid, "{{ dm_var.id }}", null)
{% endif %}
{% endfor %}
    }
{% endfor %}
{% for part in script_parts %}

    private fun runDocumentScriptsPart{{ loop.index0 }}(engine: ScxmlScriptEngine, sid: String) {
{% for script in part %}
        try {
            engine.executeScript(sid, {{ script.content | to_script_source_script }})
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "a top-level <script> failed to execute")
        }
{% endfor %}
    }
{% endfor %}

    // W3C SCXML 5.9: Guard evaluation with error.execution on failure
    //
    // The guard arrives as a `ScriptSource`, not a `String`: it carries the
    // language its text is in, so a machine generated for a Lua engine hands
    // over Lua the build-time frontend produced and one generated for an
    // ECMAScript engine hands over the author's own text — and the engine is
    // never left to guess which it got. The C++ sibling
    // (`process_transition.jinja2`) takes the same argument for the same
    // reason.
    private fun safeEvaluateGuard(guardExpr: com.sce.runtime.ScriptSource): Boolean =
        evaluateGuardRaising(guardExpr, "a <transition> cond failed to evaluate") ?: false

    // W3C SCXML 5.9.1 + 4.9: an <if> or <elseif> cond, evaluated and reported
    // as a transition guard is. A failure also runs [onFailure]: the <if>
    // still selects on `false`, and is then the element whose processing
    // raised, so its block ends after it.
    @Suppress("unused")
    private inline fun evaluateIfCond(guardExpr: com.sce.runtime.ScriptSource, onFailure: () -> Unit): Boolean {
        val result = evaluateGuardRaising(guardExpr, "an <if> cond failed to evaluate")
        if (result == null) onFailure()
        return result ?: false
    }

    // W3C SCXML 5.9.1: a cond that cannot be evaluated raises error.execution;
    // `null` says so, where a bare `false` could not.
    private fun evaluateGuardRaising(guardExpr: com.sce.runtime.ScriptSource, reason: String): Boolean? {
        assertScriptSession()
        val engine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
        val sid = scriptSessionId ?: error("scriptSessionId is established by the start (codegen invariant)")
        return try {
            engine.evaluateCondition(sid, guardExpr)
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, reason)
            null
        }
    }

    // W3C SCXML B.2: the value of an inline `<content>` body, serialized
    // for transport.
    //
    // The reading is decided at build time — `source` is already the
    // expression or string literal the clause's ordered readings give —
    // and this evaluates it *here*, at send time, rather than handing the
    // expression to whatever reads `_event.data` later. That distinction
    // is not academic: the two engines this backend runs on disagree
    // about what a data string is. QuickJS tries a JS evaluation before
    // falling back; Rhino goes straight from JSON to the normalized
    // string, so an expression handed to it arrives as its own source
    // text. `JSON.stringify` is what both of them can read back, and it
    // is the same shape the C++ backend transports.
    //
    // The serialization wraps BOTH halves, in each half's own language. A
    // wrapper composed around one of them only would build a `ScriptSource`
    // whose two strings no longer say the same thing, and the diagnostic that
    // reads `source` would name an expression the engine never ran. `JSON` is
    // a §scxml-B-2-9 name both engines carry, so the wrapper is the same eight
    // characters on either arm — what differs is what it wraps.
    private fun evaluateSendContent(source: com.sce.runtime.ScriptSource): String {
        assertScriptSession()
        val engine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
        val sid = scriptSessionId ?: error("scriptSessionId is established by the start (codegen invariant)")
        val serialized = when (source.language) {
            com.sce.runtime.ScriptLanguage.ECMAScript ->
                com.sce.runtime.ScriptSource.ecmascript("JSON.stringify((" + source.source + "))")
            com.sce.runtime.ScriptLanguage.Lua ->
                com.sce.runtime.ScriptSource.lua(
                    "JSON.stringify((" + source.text + "))",
                    "JSON.stringify((" + source.source + "))",
                )
        }
        return try {
            engine.evaluateExpr(sid, serialized)?.toString() ?: ""
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "an expression could not be serialised to JSON")
            ""
        }
    }

    // W3C SCXML 5.3: Assignment via script engine
    //
    // Both halves carry a language: this engine's Lua arm splices the location
    // in front of `=` and runs the result, so a write target written in
    // ECMAScript has to have been lowered too. Same split as
    // `ScxmlScriptEngine.assign`.
    // Returns whether the assignment took place; on failure error.execution is
    // already raised, and the caller ends its block (W3C SCXML 4.9).
    private fun executeAssign(location: com.sce.runtime.ScriptSource, expr: com.sce.runtime.ScriptSource): Boolean {
        assertScriptSession()
        val engine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
        val sid = scriptSessionId ?: error("scriptSessionId is established by the start (codegen invariant)")
        return try {
            engine.assign(sid, location, expr)
            true
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<assign> failed")
            false
        }
    }
{% if model.needs_idlocation_store %}

    // W3C SCXML 6.2.4 / 6.4.1: write a generated id to an `idlocation`.
    //
    // The location is a location expression, so this is the assignment
    // `executeAssign` makes: lowered, so a member path lands, and one that
    // cannot take the id raises error.execution (W3C SCXML 5.9.2) and answers
    // false for the caller to abandon the element. The id is quoted here, in
    // the location's own language, because an invoke's is a run-time value.
    private fun storeIdInLocation(location: com.sce.runtime.ScriptSource, id: String, element: String): Boolean {
        assertScriptSession()
        val engine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
        val sid = scriptSessionId ?: error("scriptSessionId is established by the start (codegen invariant)")
        return try {
            engine.assign(sid, location, com.sce.runtime.ScriptSource.stringLiteral(id, location.language))
            true
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "$element idlocation could not take the id")
            false
        }
    }
{% endif %}

    // W3C SCXML 5.8: Script block execution
    // Returns whether the script ran; on failure error.execution is already
    // raised, and the caller ends its block (W3C SCXML 4.9).
    private fun executeScriptBlock(script: com.sce.runtime.ScriptSource): Boolean {
        assertScriptSession()
        val engine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
        val sid = scriptSessionId ?: error("scriptSessionId is established by the start (codegen invariant)")
        return try {
            engine.executeScript(sid, script)
            true
        } catch (e: Exception) {
            raisePlatformError({{ machine_name }}Event.Error.Execution, "<script> failed to execute")
            false
        }
    }

    // W3C SCXML 5.10: Set _event before event processing
    private fun setCurrentEventInScriptEngine(event: {{ machine_name }}Event) {
        assertScriptSession()
        val engine = scriptEngine ?: error("scriptEngine is required (codegen invariant: needs_script_engine == true)")
        val sid = scriptSessionId ?: error("scriptSessionId is established by the start (codegen invariant)")
        val meta = currentEventMetadata
        // §scxml-5.10: the name the event ARRIVED under, which is longer than its
        // member's when a name the document does not write was matched through a
        // prefix (§scxml-3.12.1).
        val eventName = meta.name.ifEmpty { eventNameOf(event) ?: return }
        // W3C SCXML 5.10.1: C++ classifyEventType — platform events override type
        val effectiveType = when {
            eventName.startsWith("done.") || eventName.startsWith("error.") -> "platform"
            else -> meta.type
        }
        // W3C SCXML 5.10.1 + C.1: `_event.origin` and `_event.origintype` are the
        // reply address the processor that delivered the event wrote where it
        // built it, as one value (docs/adr/0090): the SCXML processor's type and
        // the sender's published `_ioprocessors` location for an event a session
        // sent, a host's own pair for what a host named, the Mesh transport's
        // for a peer. Read here as written, with no conversion. An event no
        // processor stamped — an internal or platform event, a host-posted event
        // or reply that names no party, a BasicHTTP request — has none and is
        // handed over as the empty string, which the binding surfaces as blank
        // (undefined, §scxml-B-2-8): nothing is filled in for it, neither this
        // session's own address nor the SCXML processor's type.
        val eventOrigin = meta.origin
        // §scxml-B-2-8-1: the binding answers which rung the payload got, and
        // that answer used to end here. The ladder decided between a DOM, a
        // value and a space-normalized string, and the decision was dropped —
        // so a payload that announced structure and would not parse reached
        // the document as raw characters, every `_event.data.<field>` read
        // empty, and nothing anywhere could say so.
        //
        // Recorded on the spot rather than returned up: this class extends
        // `StateMachineEngine`, so the frame that binds already holds both the
        // reading and the event it belongs to — which is the pairing the count
        // needs.
        val payloadReading = engine.setCurrentEvent(
            sid,
            com.sce.runtime.SetCurrentEventArgs(
                name = eventName,
                data = meta.data,
                type = effectiveType,
                sendId = meta.sendId,
                origin = eventOrigin?.address ?: "",
                originType = eventOrigin?.processor ?: "",
                invokeId = meta.invokeId
            )
        )
        notePayloadReading(event, payloadReading)
    }
{% endif %}
