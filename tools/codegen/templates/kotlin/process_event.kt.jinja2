{#
    Kotlin Transition Selection Template

    What the generated machine knows and the runtime does not: which of a
    state's OWN transitions an event enables. Everything else Appendix D does
    with a transition — the walk from each atomic state up through its
    ancestors, the ordered set, conflict removal, the exit set, the entry set —
    is written once, in the runtime's Microstep.kt, over the structure
    state_machine.kt.jinja2 emits.

    It used to be written here as well: a per-state `processEvent` that routed
    an event through the state's ancestors itself and answered with ONE
    target, a history already dereferenced to a leaf at selection time. The
    runtime then could not see a target set, the domain of an internal
    transition, or that a history's default content was owed.

    Generates:
    - bindCurrentEvent(event)               §scxml-5.10 `_event` for the guards
    - firstEnabledTransition(state, event)  the per-state half of selection

    The transitions it answers with are the ones state_machine.kt.jinja2 builds
    once in the companion object. The Kotlin twin of
    go/process_transition.go.jinja2.
#}
{# --- The guard a transition is taken under (three-way pattern) ---
   A guard lowered to Kotlin at generate time (a typed-payload comparison, a
   sce-static condition), an In() predicate or a native Kotlin condition as
   written, the script engine, or a value decided at build time (W3C SCXML
   5.9). #}
{% macro render_cond(trans) -%}
{% if trans.native_guard -%}
{{ trans.native_guard }}
{%- elif trans.is_pure_in_predicate -%}
{{ trans.cond_kt }}
{%- elif trans.is_kt_condition -%}
{{ trans.cond_kt }}
{%- elif model.needs_script_engine and trans.cond and not trans.is_cpp_condition -%}
safeEvaluateGuard({{ trans.cond | to_script_source_guard }})
{%- elif trans.cond and not trans.is_cpp_condition -%}
{{ 'true' if trans.cond_constant else 'false' }}
{%- endif -%}
{%- endmacro %}
{# --- Whether `trans` answers `event` ---
   An eventless transition answers only the eventless selection (`null`), a
   transition with an event descriptor only a named event: §scxml-3.13 selects
   the two kinds in separate passes. A descriptor that matches every event
   (`*`, and the other spellings analyzer.rs::stamp_wildcard_descriptors
   recognises) answers any named one; otherwise the events the descriptor
   matches by prefix (W3C SCXML 3.12.1), precomputed. An empty list means none of the
   model's events satisfy the descriptor (`never.*` with no matching raise or send): a legal
   document, and a transition that cannot be taken. The IR leaves an empty list out of the
   serialised transition, so the field is undefined there and `not` covers both. Rendering
   the descriptor itself, as the last arm used to, wrote `event is XEvent.Never.*`, which
   is not Kotlin. #}
{% macro event_match(trans) -%}
{%- if not trans.event -%}event == null
{%- elif trans.matches_any_event -%}event != null
{%- elif not trans.prefix_matching_events -%}false
{%- elif trans.prefix_matching_events | length > 1 -%}({% for matched_event in trans.prefix_matching_events | sort %}event is {{ machine_name }}Event.{{ matched_event | to_event_class_name }}{{ " || " if not loop.last }}{% endfor %})
{%- else -%}event is {{ machine_name }}Event.{{ trans.prefix_matching_events[0] | to_event_class_name }}
{%- endif -%}
{%- endmacro %}
{# One method per state that owns a transition (`firstEnabledTransitionOf<State>`), and
   `firstEnabledTransition` dispatches on the state to it with one call an arm
   (dispatch.kt.jinja2): written as one `when`, the selection held every guard
   of the document and grew with it past what one JVM method holds. A state's
   method keeps the parameters `state` and `event` the one `when` had in scope,
   because a native condition (`kt:`) is the author's Kotlin and may read
   either; it is why the method suppresses UNUSED_PARAMETER. The `when (state)`
   is exhaustive over the sealed state hierarchy exactly when every state owns
   a transition, and Kotlin rejects a redundant `else` under -Werror. #}
{%- import 'dispatch.kt.jinja2' as dispatch %}
{% set selection_dispatch = namespace(arms=[]) %}
{% for state_id, state in model.states | dictsort %}
{% if state.transitions %}
{% set selection_dispatch.arms = selection_dispatch.arms + [["is " ~ machine_name ~ "State." ~ (state_id | to_state_class_name), "firstEnabledTransitionOf" ~ (state_id | to_state_class_name) ~ "(state, event)"]] %}
{% endif %}
{% endfor %}
{% set selection_result = "EnabledTransition<" ~ machine_name ~ "State, HistoryId>?" %}
{% set selection_params = "state: " ~ machine_name ~ "State, event: " ~ machine_name ~ "Event?" %}
{% if model.needs_script_engine %}

    // W3C SCXML 5.10: bind the event as the `_event` its transitions' guards
    // read — once, before the first guard runs, and not for an eventless
    // selection, which has no event of its own.
    override fun bindCurrentEvent(event: {{ machine_name }}Event) {
        setCurrentEventInScriptEngine(event)
    }
{% endif %}

    // W3C SCXML Appendix D selectTransitions, the half only this document can
    // answer: the first of `state`'s own transitions, in document order, that
    // `event` enables and whose guard holds; for `null`, its first eventless
    // transition whose guard holds. The runtime walks the atomic states and
    // their ancestors and keeps the ordered set.
{# Document order (W3C SCXML 3.13): transitions are emitted in the order the
   author wrote them, and `when` takes the first branch that holds, so the two
   orders agree by construction rather than by a sort. A wildcard written first
   is taken before a literal written second
   (`integration_resources/event_descriptor_spellings_agree/`), and an
   unguarded one still leaves the eventless transitions after it reachable,
   because it answers only a named event. #}
{# What each arm may say is bounded by what the arms before it already
   settled, because Kotlin's flow analysis reads the `when` as the author's
   document order does and rejects, under -Werror, a condition it can prove:
   past an unguarded `event == null` the event is known to be present, past an
   unguarded `event != null` it is known to be absent. So `arm.known` carries
   that fact ('' / 'absent' / 'present') down the list:

   - an arm the fact rules out can never be taken, and is not written;
   - an arm the fact decides is written without the test that is now certain —
     as the state's last word (`else`) when nothing guards it, since every arm
     after it is unreachable (W3C SCXML 3.13: the first enabled transition in
     document order wins);
   - a guard the frontend decided at build time (`cond_constant`, W3C SCXML
     5.9) is no guard when it holds, and when it does not the transition is
     never enabled and has no arm.

   The old per-state handlers kept the same rule as "first unconditional
   transition wins".

   The arms of one state are gathered first and written by
   `dispatch.bounded_when`, a `when` of conditions answering `null` when none
   holds; a state with more arms than one method holds is asked part by part
   in document order, and a part is reached only when every arm before it
   failed, so what `arm.known` carries holds there too. Each arm answers with
   the transition's constant in the holder state_machine.kt.jinja2 declared
   it in (`transition_part_of`). #}
{{ dispatch.bounded_when("firstEnabledTransition", "override fun firstEnabledTransition(" ~ selection_params ~ "): " ~ selection_result, selection_params, "state, event", "state", selection_dispatch.arms, selection_result, "null", (selection_dispatch.arms | length) == (model.states | length)) }}
{% for state_id, state in model.states | dictsort %}
{% if state.transitions %}
{% set arm = namespace(known='', closed=false, kind='', guard='', decided='', list=[], target='') %}
{% for trans in state.transitions %}
{% if not arm.closed %}
{% set arm.target = "TransitionsPart" ~ transition_part_of[state_id][loop.index0] ~ ".transition" ~ (state_id | to_state_class_name) ~ "At" ~ trans.transition_index %}
{% set arm.kind = 'eventless' if not trans.event else ('any' if trans.matches_any_event else 'named') %}
{# A guard lowered with no `cond` written is a branch of a test component's
   match on the round's snapshot (docs/SCE_TEST_PROFILE.md §12.3). #}
{% if not trans.cond and not trans.native_guard %}
{% set arm.guard = 'none' %}
{% elif trans.is_pure_in_predicate or trans.is_kt_condition or trans.native_guard or trans.is_cpp_condition or model.needs_script_engine %}
{% set arm.guard = 'runtime' %}
{% elif trans.cond_constant %}
{% set arm.guard = 'none' %}
{% else %}
{% set arm.guard = 'never' %}
{% endif %}
{% if arm.known == 'absent' %}
{% set arm.decided = 'true' if arm.kind == 'eventless' else 'false' %}
{% elif arm.known == 'present' %}
{% set arm.decided = 'false' if arm.kind == 'eventless' else ('true' if arm.kind == 'any' else '') %}
{% else %}
{% set arm.decided = '' %}
{% endif %}
{% if arm.decided == 'false' or arm.guard == 'never' %}
{% elif arm.decided == 'true' and arm.guard == 'none' %}
{% set arm.list = arm.list + [["else", arm.target]] %}
{% set arm.closed = true %}
{% elif arm.decided == 'true' %}
{% set arm.list = arm.list + [[render_cond(trans), arm.target]] %}
{% elif arm.guard == 'none' %}
{% set arm.list = arm.list + [[event_match(trans), arm.target]] %}
{% if arm.kind == 'eventless' %}
{% set arm.known = 'present' %}
{% elif arm.kind == 'any' %}
{% set arm.known = 'absent' %}
{% endif %}
{% else %}
{% set arm.list = arm.list + [[event_match(trans) ~ " && " ~ render_cond(trans), arm.target]] %}
{% endif %}
{% endif %}
{% endfor %}

    // {{ state_id }}'s own transitions, in document order.
{{ dispatch.bounded_when("firstEnabledTransitionOf" ~ (state_id | to_state_class_name), "@Suppress(\"UNUSED_PARAMETER\") private fun firstEnabledTransitionOf" ~ (state_id | to_state_class_name) ~ "(" ~ selection_params ~ "): " ~ selection_result, selection_params, "state, event", "", arm.list, selection_result, "null", false) }}
{% endif %}
{% endfor %}
