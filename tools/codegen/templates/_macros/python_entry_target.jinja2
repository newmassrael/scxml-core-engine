{#
   One token of a target list — a transition's `target`, a state's initial
   transition, a `<history>`'s default — as the Python policy spells it.

   A `<history>` is not a state and has no State member: it is named by its
   string id, and the runtime's entry procedures dereference it to what it
   recorded or to its default. Every other token is a State. The Python twin
   of `rust_entry_target.jinja2`.

   `history_states` and `machine_name` are passed in rather than read from the
   caller's context because an imported macro does not see it.
#}
{% macro entry_target(token, history_states, machine_name) -%}
{%- if token in history_states -%}HistoryTarget({{ token | py_string_literal }})
{%- else -%}StateTarget({{ machine_name }}State.{{ token | to_python_const }})
{%- endif -%}
{%- endmacro %}

{# A whole target list, as the tuple the policy hands the runtime. #}
{% macro entry_targets(tokens, history_states, machine_name) -%}
({% for t in tokens %}{{ entry_target(t, history_states, machine_name) }},{{ " " if not loop.last }}{% endfor %})
{%- endmacro %}
