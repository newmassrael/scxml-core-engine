        // header byte (and the wire-protocol layer that demuxes it)
        // already proved this codec was selected, so return the
        // default-constructed envelope without touching the cursor.
        let _ = cursor;
        Ok(Self {})
{% elif has_variant %}
{% if variant.has_streaming_prefix %}
