        {{ field.view_repeat_decode_stmt if view_decode else field.repeat_decode_stmt }}
{% elif field.is_tlv_chain %}
        {{ field.view_tlv_chain_decode_stmt if view_decode else field.tlv_chain_decode_stmt }}
{% elif field.is_embed %}
        {{ field.view_embed_decode_stmt if view_decode else field.embed_decode_stmt }}
{% else %}
        {{ field.present_if_decode_stmt }}
{% endif %}
{% endfor %}
{% for field in fields %}
{% if not (field.is_repeat or field.is_tlv_chain or field.is_embed) %}
        _out.{{ field.id }} = {{ field.id }};
{% endif %}
{% endfor %}
        Ok(())
{% elif has_variable_fields %}
        // Variable-length codec. RFC §synth-5-B B3 stream-correct shape:
        // a codec without `<sce:field sce:bit-size="tail">` consumes
        // only `min_bytes + length_value` rather than the entire
        // cursor remaining. Codecs WITH a tail field still consume
        // to end (tail's definition forces it). The prior
        // "consume entire cursor" behaviour deferred to "the first
        // multi-frame consumer" — the TLV chain is that consumer,
        // so length-ref entry codecs now decode-iterably from a
        // shared cursor without each entry eating the next entry's
        // bytes.
        let _frame_len = cursor.remaining();
{% if min_bytes > 0 %}
        if _frame_len < {{ min_bytes }} {
            return Err(CodecError::NeedMoreBytes);
        }
{% endif %}
        let raw = cursor.peek_slice(_frame_len)?;
{% for field in fields %}
{{ decode_field(field) }}
{% endfor %}
        let value = Self {
{% for field in fields %}
            {{ field.id }},
{% endfor %}
        };
{% if has_tail_fields %}
        cursor.advance(_frame_len)?;
{% else %}
        // Stream-correct: advance only the bytes actually decoded.
        // For each length-ref field, end = byte_off + sibling local
        // value (the sibling let-binding ran before the payload's).
        // Take the max across all length-ref fields; min_bytes is the
        // lower bound.
        let mut _consumed: usize = {{ min_bytes }};
{% for field in fields %}
{% if field.is_variable and field.bit_size_kind == "length-ref" %}
        {
            let _end = {{ field.byte_off }}usize + value.{{ field.id }}.len();
            if _end > _consumed { _consumed = _end; }
        }
{% endif %}
{% endfor %}
        if _consumed > _frame_len {
            return Err(CodecError::NeedMoreBytes);
        }
        cursor.advance(_consumed)?;
{% endif %}
        Ok(value)
{% else %}
        let raw = cursor.peek_slice({{ min_bytes }})?;
{% for field in fields %}
{{ decode_field(field) }}
{% endfor %}
        let value = Self {
{% for field in fields %}
            {{ field.id }},
{% endfor %}
        };
        cursor.advance({{ min_bytes }})?;
        Ok(value)
{% endif %}
