{#- The statements of a Rust codec's `decode` (or `decode_into`), between its
    signature and its closing brace, for the eager struct and for its view.

    Included by `forge/rust/codec.rs.jinja2` twice. `view_decode` is false for
    the eager struct (`{Codec}<'a>`) and true for the view (`{Codec}View`, ADR
    0049), and picks the three things that differ: the statement a list, an
    embedded body renders (`view_*` where the view holds it differently), the
    variant enum an arm is installed in, and the type an arm's body is. Every
    other field is read by the same statement on both. One skeleton, so a
    branch added here reaches both. -#}
{#- One field of the positional prefix, bound to its own local. An
    enum-typed field travels on the wire as the enum's carrier, so
    `decode_expr` reads that carrier and the enum's own conversion
    turns it into a value of the type; a closed set's conversion is
    partial, and a carrier value it does not declare is not a value of
    that type, so the frame does not decode. The statement carries its
    own indentation because the three call sites below share it. #}
{% macro decode_field(field) %}
{% if field.is_enum and field.enum_is_open %}
        let {{ field.id }} = {{ field.enum_from_underlying }}({{ field.decode_expr }});
{%- elif field.is_enum %}
        let {{ field.id }} = {{ field.enum_from_underlying }}({{ field.decode_expr }})
            .ok_or(CodecError::UndeclaredEnumValue)?;
{%- else %}
        let {{ field.id }} = {{ field.decode_expr }};
{%- endif %}
{% endmacro %}
{% set decode_variant_enum = struct_name ~ ('ViewVariant' if view_decode else 'Variant') %}
{% if has_parent_flags %}
        // RFC §synth-5-B: `parent_flags` is the parent codec's flags
        // carrier value, threaded through by the variant arm dispatcher.
        // Body fields gated via `parent.<flag>` predicates read from
        // this parameter; suppress unused-variable warnings when no
        // gated field happens to consume it (defensive guard for
        // codecs that declare `<sce:requires-parent-flags>` but
        // don't yet wire any predicate to it).
        let _ = parent_flags;
{% endif %}
{% if has_flag_inputs %}
        // Declared-but-unconsumed flag inputs: defensive suppress per declared
        // `<sce:flag-input>` so codecs that haven't (yet) consumed an
        // input via `present-if` compile cleanly. The validator enforces
        // declaration; consumption is a per-codec design choice.
{{ flag_input_unused_suppress }}
{% endif %}
{% if has_caller_tag %}
        // Parent-tag dispatch: `tag` is the dispatch value the
        // caller (parent codec) extracted from its own flag carrier
