{% endfor %}
        cursor.advance({{ min_bytes }})?;
{% endif %}
{% endif %}
        // Dispatch on the tag field; each arm decodes its body codec
        // from the cursor. The default arm (when declared) carries the
        // runtime tag value so encode can round-trip it back onto the
        // wire.
        // Each arm is installed in `_out.body` holding its body's default and
        // that body is decoded where it sits, so no arm body is returned up
        // through the variant wrapper.
        match {{ variant.tag_match_expr }} {
{% for arm in variant.arms %}
{% set arm_body = arm.view_body_type if view_decode else arm.body_type %}
            {{ arm.value_literal }} => {
                _out.body = {{ decode_variant_enum }}::{{ arm.variant_name }}({{ arm_body }}::default());
                if let {{ decode_variant_enum }}::{{ arm.variant_name }}(_b) = &mut _out.body {
                    {{ arm_body }}::decode_into(cursor, _b{{ arm.body_decode_args_after_cursor }})?;
                }
            }
{% endfor %}
{% if variant.default_arm %}
{% set default_body = variant.default_arm.view_body_type if view_decode else variant.default_arm.body_type %}
            other => {
                _out.body = {{ decode_variant_enum }}::{{ variant.default_arm.variant_name }} {
                    tag: other,
                    body: {{ default_body }}::default(),
                };
                if let {{ decode_variant_enum }}::{{ variant.default_arm.variant_name }} { body: _b, .. } = &mut _out.body {
                    {{ default_body }}::decode_into(cursor, _b{{ variant.default_arm.body_decode_args_after_cursor }})?;
                }
            }
{% else %}
            // Build-time `codec/variant-arm-unreachable` proves the
            // arm set covers the tag domain without a default.
            _ => unreachable!("variant exhaustiveness gated by codec/variant-arm-unreachable at parse time"),
{% endif %}
        }
{% for field in fields %}
{% if not (field.is_repeat or field.is_tlv_chain or field.is_embed) %}
        _out.{{ field.id }} = {{ field.id }};
{% endif %}
{% endfor %}
