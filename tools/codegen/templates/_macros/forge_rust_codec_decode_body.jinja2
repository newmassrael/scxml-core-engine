{% endif %}
{% endfor %}
{% if variant.has_peek_byte %}
        {{ variant.peek_byte_decode_stmt }}
{% endif %}
{% else %}
{% if fields %}
        // Decode fixed prefix (RFC §synth-5-B variant primitive: fields
        // sit before the variant suffix on the wire).
        let raw = cursor.peek_slice({{ min_bytes }})?;
{% for field in fields %}
