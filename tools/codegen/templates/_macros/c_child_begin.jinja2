{#
    The call that begins a `sce-static` child session of a C11 parent (§scxml-6.4.1):
    the child is constructed and its parent routing stamped, but not entered. The
    start of an `<invoke>` (`c/invoke_methods.jinja2`) enters it after handing it its
    arguments; the restore of a saved tree (`c/saved.c.jinja2`) resumes it where it
    stood instead (SCE Accepted Subset §2.15, docs/adr/0045). One text for both, so
    that the way a child is given its host, its parent and its clock cannot differ
    between a child that is started and one that is resumed.

    `slot` is the embedded child, `stem` its document, `host_call` the expression of
    the table the parent's own table answers for it (empty when the child declares no
    `<sce:action>`s), `declares_duties` whether the child states a duty,
    `sends_to_parent` whether it addresses `#_parent`, `invoke_id` the C expression of
    the id it is started under, and `clock` the expression of the clock it follows.
    The block of a `call` is what runs when a child declaring `<sce:action>`s was given
    no complete host, so that nothing was begun.
#}
{% macro begin_static_child(prefix, parent, slot, stem, host_call, declares_duties, sends_to_parent, invoke_id, clock) -%}
{% if host_call %}
if (!{{ prefix }}{{ stem }}_invoked_begin(
        &{{ slot }},
        {{ host_call }},
{% if declares_duties %}
        sm->accept_simulated_host,
{% endif %}
{% if sends_to_parent %}
        sm,
        {{ prefix }}{{ parent }}_dispatch_external_by_name,
{% else %}
        NULL,
        NULL,
{% endif %}
        {{ invoke_id }},
        {{ clock }})) {
{{ caller() }}
}
{% else %}
{{ prefix }}{{ stem }}_invoked_begin(
    &{{ slot }},
{% if sends_to_parent %}
    sm,
    {{ prefix }}{{ parent }}_dispatch_external_by_name,
{% else %}
    NULL,
    NULL,
{% endif %}
    {{ invoke_id }},
    {{ clock }});
{% endif %}
{%- endmacro %}
