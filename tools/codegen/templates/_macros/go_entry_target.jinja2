{#
   One token of a target list — a transition's `target`, a state's initial
   transition, a `<history>`'s default — as the Go policy spells it.

   A `<history>` is not a state and has no State constant: it is named by the
   machine's `<Machine>History<Id>` sce.HistoryID, and the runtime's entry
   procedures dereference it to what it recorded or to its default. Every
   other token is a State. The Go twin of `rust_entry_target.jinja2`.

   `history_states` and `machine_name` are passed in rather than read from the
   caller's context because an imported macro does not see it.
#}
{% macro entry_target(token, history_states, machine_name) -%}
{%- if token in history_states -%}sce.HistoryTarget[{{ machine_name }}State]({{ machine_name }}History{{ token | to_state_variant }})
{%- else -%}sce.StateTarget[{{ machine_name }}State, sce.HistoryID]({{ machine_name }}State{{ token | to_state_variant }})
{%- endif -%}
{%- endmacro %}

{# A whole target list, as the elements of a composite literal whose type the
   caller spells — the tables it sits in give the element type once. #}
{% macro entry_targets(tokens, history_states, machine_name) -%}
{{ '{' }}{% for t in tokens %}{{ entry_target(t, history_states, machine_name) }}{{ ", " if not loop.last }}{% endfor %}{{ '}' }}
{%- endmacro %}
