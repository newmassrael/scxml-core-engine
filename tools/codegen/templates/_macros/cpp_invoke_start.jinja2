{#
   What the C++ start of a child session writes in more than one place: the entry of its
   state defers it, and so does a restore of a format-1 saved state, which holds a running
   child by id alone (docs/adr/0045); the macrostep that runs a deferred start wires the child
   to its parent, and so does the restore that resumes a child where it stood. One definition
   each, so a start, a restart and a resume cannot disagree about the id a child is started
   under, the record the parent keeps of it, or what it tells the parent when it ends.
#}

{#- W3C SCXML 6.4.1: an invoke's generated id goes to `idlocation` when the
    element is evaluated, as an assignment to a location expression — the one
    `<assign>` makes, so a member path lands. A location that cannot take it
    raises error.execution and the invocation is not started (W3C SCXML
    5.9.2); `flag` names the bool the caller guards the start with. #}
{%- macro store_invoke_idlocation(invoke_info, id_expr, flag, indent) %}
{{ indent }}bool {{ flag }} = true;
{%- if invoke_info.idlocation %}
{{ indent }}{
{{ indent }}    ensureScriptEngine();
{{ indent }}    {{ flag }} = ::SCE::AssignmentExecutionHelper::storeIdInLocation(
{{ indent }}        getScriptEngine(), sessionId_.value(), {{ invoke_info.idlocation | to_script_source_location }}, {{ id_expr }},
{{ indent }}        [&engine](const std::string &error) {
{{ indent }}            engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, error));
{{ indent }}        });
{{ indent }}}
{%- endif %}
{%- endmacro %}

{#- The start of the child session `inv` of `state_id`, deferred to the macrostep that
    ends this one, which runs it: the id it is started under is
    `<state>.<start>.<id>`, the start counted in this session (docs/adr/0045), so the id
    comes from the tree alone and is the text every backend writes. Under
    `datamodel="sce-static"` the id is written to the string variable `idlocation` names,
    whose bound the build held to one the id fits; under a script engine it is stored as
    an assignment, and a location that cannot take it starts nothing. `indent` is what each
    line of the start is indented by. #}
{% macro defer_scxml_invoke(inv, state_id, indent, kind) %}
{{ indent }}{
{{ indent }}    // W3C SCXML 3.12.1: the runtime invoke id, in the "stateid.start.id" shape.
{{ indent }}    std::string generatedInvokeId = "{{ state_id }}." + std::to_string(++invokeStarts_{{ inv.field_suffix }}_) + ".{{ inv.invoke_id }}";
{% if inv.native_idlocation %}
{{ indent }}    {{ inv.native_idlocation }}
{{ indent }}    ::SCE::Core::InvokeHelper::deferInvoke(pendingInvokes_,
{{ indent }}        PendingInvoke{generatedInvokeId, State::{{ state_id | capitalize }}, "{{ inv.invoke_id }}"});
{% else %}
{{ store_invoke_idlocation(inv, "generatedInvokeId", "idStored", indent ~ "    ") }}
{{ indent }}    if (idStored) {
{{ indent }}        ::SCE::Core::InvokeHelper::deferInvoke(pendingInvokes_,
{{ indent }}            PendingInvoke{generatedInvokeId, State::{{ state_id | capitalize }}, "{{ inv.invoke_id }}"});
{{ indent }}    }
{% endif %}
{{ indent }}    AOT_DEBUG("Deferred {{ kind }} invoke: {} in state {{ state_id }}", generatedInvokeId);
{{ indent }}}
{% endmacro %}

{#- W3C SCXML 6.4.1: the parent's record of the child session `inv` runs, which finalize,
    autoforward and an event addressed to the child's published location read. `finalize`
    is the finalize script as the string literal's text. The record is written before the
    child initializes, so an event it sends as it starts can already be autoforwarded.
    SCE_MESH.md §16.7 row 5 sub-atomic C: the table is shared with peer-down callback
    threads, so the write holds the mutex. #}
{% macro child_session_record(inv, finalize, indent) %}
{{ indent }}{
{{ indent }}    std::lock_guard<std::mutex> __sce_active_invokes_lk(activeInvokesMutex_);
{{ indent }}    activeInvokes_["{{ inv.invoke_id }}"] = ChildSession{
{{ indent }}        childSessionId,  // W3C SCXML 6.5: the child's session id, for finalize origin matching
{{ indent }}        "{{ inv.invoke_id }}",
{{ indent }}        sessionId_.has_value() ? sessionId_.value() : "",  // the parent's session id
{{ indent }}        {{ 'true' if inv.autoforward else 'false' }},  // W3C SCXML 6.4.1: autoforward
{{ indent }}        "{{ finalize }}"  // W3C SCXML 6.5: finalize
{{ indent }}    };
{{ indent }}}
{% endmacro %}

{#- W3C SCXML 6.4: what the parent does when the child in `slot` reaches its final state:
    it raises `done.invoke`, carrying the child's donedata (W3C SCXML 5.5 + 6.3.1), which the
    child stashed at its top-level `<final>`. Registered before the child initializes, since
    it may reach its final state as it starts. Only when the document listens for the done
    event: a machine that observes its child another way, by what the child sends it, has no
    `done.invoke` in its Event enum, and naming one here asks the compiler for a member the
    document never declared. #}
{% macro child_completion_callback(inv, slot, model, indent) %}
{% if inv.use_specific_event or 'done.invoke' in model.events %}
{{ indent }}{{ slot }}->setCompletionCallback([this]() {
{{ indent }}    AOT_DEBUG("Child state machine {{ inv.invoke_id }} completed, sending done.invoke");
{{ indent }}    // Mark as completed (test 236).
{{ indent }}    pendingDoneInvoke_{{ inv.invoke_id }}_ = true;
{{ indent }}    // typedData is forwarded in-process to skip the JSON round-trip; the mesh
{{ indent }}    // §9.6.2 wire-18 path instead rebuilds typedData from `data` bytes on the
{{ indent }}    // parent side.
{{ indent }}    self_->raiseExternal(::SCE::Common::EventMetadataHelper::createDoneInvokeEvent<
{{ indent }}        typename SelfType::Event, typename SelfType::EventWithMetadata>(
{{ indent }}        {% if inv.use_specific_event %}Event::Done_invoke_{{ inv.invoke_id }}{% else %}Event::Done_invoke{% endif %},
{{ indent }}        "{{ inv.invoke_id }}",
{{ indent }}        {{ slot }}->donedataAtFinal(),
{{ indent }}        {{ slot }}->typedDonedataAtFinal()
{{ indent }}    ));
{{ indent }}});
{% endif %}
{% endmacro %}
