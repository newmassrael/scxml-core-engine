{#
    A variable's saved form (SCE Accepted Subset §2.15, docs/adr/0045), as a
    Python machine spells it: a record's or an enum's own (`to_saved` /
    `from_saved`, emitted with the type by the static lowering), and every other
    type's by the runtime's `sce_saved` functions (`sce_runtime.saved_values`),
    named for the `sce:type`. What the saved functions of a machine that saves
    write and read each variable by (`python/saved_functions.py.jinja2`), and
    what a test component reads each module parameter by from the run's values
    (docs/SCE_TEST_PROFILE.md §11.8), whether or not the machine saves. The
    Python twin of `_macros/cpp_saved_value.jinja2`.
#}

{#- The variable `field`, held by the policy `source`, as the JSON value a saved state holds. -#}
{% macro write(field, source) -%}
{%- if field.saved_kind == "optional" and (field.saved_elem == "enum" or field.saved_elem == "record") -%}
sce_saved.saved_write_optional({{ source }}.{{ field.name }}, lambda v: v.to_saved())
{%- elif field.saved_kind == "optional" -%}
sce_saved.saved_write_optional({{ source }}.{{ field.name }}, sce_saved.saved_write_{{ field.saved_type }})
{%- elif field.saved_kind == "record" or field.saved_kind == "enum" -%}
{{ source }}.{{ field.name }}.to_saved()
{%- elif field.saved_kind == "list" -%}
sce_saved.saved_write_list({{ source }}.{{ field.name }}, sce_saved.saved_write_{{ field.saved_type }})
{%- elif field.saved_kind == "record_list" -%}
sce_saved.saved_write_list({{ source }}.{{ field.name }}, lambda r: r.to_saved())
{%- else -%}
sce_saved.saved_write_{{ field.saved_type }}({{ source }}.{{ field.name }})
{%- endif -%}
{%- endmacro %}

{#- The value the saved value `raw` holds for the variable `field`, read as the
    field's own type, which raises the runtime's `StateRefusal` naming the
    variable for a value that is not of it or is past its bound. -#}
{% macro read(field, raw) -%}
{%- if field.saved_kind == "optional" and (field.saved_elem == "enum" or field.saved_elem == "record") -%}
sce_saved.saved_read_optional({{ raw }}, {{ field.id | py_string_literal }}, {{ field.saved_type }}.from_saved)
{%- elif field.saved_kind == "optional" and field.saved_type == "bytes" -%}
sce_saved.saved_read_optional({{ raw }}, {{ field.id | py_string_literal }}, sce_saved.saved_bounded_bytes({{ field.bound if field.bound is not none else 2147483647 }}))
{%- elif field.saved_kind == "optional" and field.saved_type == "string" and field.bound is not none -%}
sce_saved.saved_read_optional({{ raw }}, {{ field.id | py_string_literal }}, sce_saved.saved_bounded_string({{ field.bound }}))
{%- elif field.saved_kind == "optional" -%}
sce_saved.saved_read_optional({{ raw }}, {{ field.id | py_string_literal }}, sce_saved.saved_read_{{ field.saved_type }})
{%- elif field.saved_kind == "record" or field.saved_kind == "enum" -%}
{{ field.saved_type }}.from_saved({{ raw }}, {{ field.id | py_string_literal }})
{%- elif field.saved_kind == "list" -%}
sce_saved.saved_read_list({{ raw }}, {{ field.id | py_string_literal }}, {{ field.bound }}, sce_saved.saved_read_{{ field.saved_type }})
{%- elif field.saved_kind == "record_list" -%}
sce_saved.saved_read_list({{ raw }}, {{ field.id | py_string_literal }}, {{ field.bound }}, {{ field.saved_type }}.from_saved)
{%- elif field.saved_type == "bytes" -%}
sce_saved.saved_read_bytes({{ raw }}, {{ field.id | py_string_literal }}, {{ field.bound if field.bound is not none else 2147483647 }})
{%- elif field.saved_type == "string" and field.bound is not none -%}
sce_saved.saved_read_bounded_string({{ raw }}, {{ field.id | py_string_literal }}, {{ field.bound }})
{%- else -%}
sce_saved.saved_read_{{ field.saved_type }}({{ raw }}, {{ field.id | py_string_literal }})
{%- endif -%}
{%- endmacro %}
