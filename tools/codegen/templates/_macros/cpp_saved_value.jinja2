{#
    A variable's saved form (SCE Accepted Subset §2.15, docs/adr/0045), as the generated
    `saveAt`, `judge` and `restoreAt` of a machine spell it: a record's, a union's or an
    enum's own (`<Type>ToSaved` / `<Type>FromSaved`, emitted with the type by the static
    lowering; a union's reads its tag first, docs/adr/0092, section 6.1 item 7), and every
    other type's by the runtime's `SCE::Saved` functions (`sce/include/saved/SavedValues.h`),
    named for the `sce:type`. A value that may be absent is null or its present value as its
    own functions write it, an enum's, a record's and a union's included (docs/adr/0055,
    section 4). The C++ twin of
    `_macros/python_saved_value.jinja2`.
#}

{#- The variable `field`, held by the policy `source`, as the JSON value a saved state holds. -#}
{% macro write(field, source) -%}
{%- if field.saved_kind == "optional" and field.saved_elem in ["enum", "record", "union"] -%}
::SCE::Saved::savedWriteOptional({{ source }}.{{ field.name }}, {{ field.saved_type }}ToSaved)
{%- elif field.saved_kind == "optional" -%}
::SCE::Saved::savedWriteOptional({{ source }}.{{ field.name }}, ::SCE::Saved::savedWrite{{ field.saved_type | capitalize }})
{%- elif field.saved_kind in ["record", "enum", "union"] -%}
{{ field.saved_type }}ToSaved({{ source }}.{{ field.name }})
{%- elif field.saved_kind == "list" -%}
::SCE::Saved::savedWriteList({{ source }}.{{ field.name }}, ::SCE::Saved::savedWrite{{ field.saved_type | capitalize }})
{%- elif field.saved_kind == "record_list" -%}
::SCE::Saved::savedWriteList({{ source }}.{{ field.name }}, {{ field.saved_type }}ToSaved)
{%- else -%}
::SCE::Saved::savedWrite{{ field.saved_type | capitalize }}({{ source }}.{{ field.name }})
{%- endif -%}
{%- endmacro %}

{#- The value of the variable `field` read back from `raw`, the JSON value a saved state holds
    it as, or the refusal naming it: read into the type the machine holds it in, whose bound a
    restored value must not be the first to exceed (docs/adr/0086, section 7.4). -#}
{% macro read(field, raw) -%}
{%- if field.saved_kind == "optional" and field.saved_elem in ["enum", "record", "union"] -%}
::SCE::Saved::savedReadOptional({{ raw }}, "{{ field.id | escape_cpp }}", {{ field.saved_type }}FromSaved)
{%- elif field.saved_kind == "optional" and field.saved_type == "bytes" and field.bound is not none -%}
::SCE::Saved::savedReadOptional({{ raw }}, "{{ field.id | escape_cpp }}", ::SCE::Saved::savedOwnedBytes<{{ field.bound }}>())
{%- elif field.saved_kind == "optional" and field.saved_type == "bytes" -%}
::SCE::Saved::savedReadOptional({{ raw }}, "{{ field.id | escape_cpp }}", ::SCE::Saved::savedBoundedBytes(2147483647u))
{%- elif field.saved_kind == "optional" and field.saved_type == "string" and field.bound is not none -%}
::SCE::Saved::savedReadOptional({{ raw }}, "{{ field.id | escape_cpp }}", ::SCE::Saved::savedOwnedText<{{ field.bound }}>())
{%- elif field.saved_kind == "optional" -%}
::SCE::Saved::savedReadOptional({{ raw }}, "{{ field.id | escape_cpp }}", ::SCE::Saved::savedRead{{ field.saved_type | capitalize }})
{%- elif field.saved_kind in ["record", "enum", "union"] -%}
{{ field.saved_type }}FromSaved({{ raw }}, "{{ field.id | escape_cpp }}")
{%- elif field.saved_kind == "list" -%}
::SCE::Saved::savedReadOwnedList<{{ field.bound }}>({{ raw }}, "{{ field.id | escape_cpp }}", ::SCE::Saved::savedRead{{ field.saved_type | capitalize }})
{%- elif field.saved_kind == "record_list" -%}
::SCE::Saved::savedReadOwnedList<{{ field.bound }}>({{ raw }}, "{{ field.id | escape_cpp }}", {{ field.saved_type }}FromSaved)
{%- elif field.saved_type == "bytes" and field.bound is not none -%}
::SCE::Saved::savedReadOwnedBytes<{{ field.bound }}>({{ raw }}, "{{ field.id | escape_cpp }}")
{%- elif field.saved_type == "bytes" -%}
::SCE::Saved::savedReadBytes({{ raw }}, "{{ field.id | escape_cpp }}", 2147483647u)
{%- elif field.saved_type == "string" and field.bound is not none -%}
::SCE::Saved::savedReadOwnedText<{{ field.bound }}>({{ raw }}, "{{ field.id | escape_cpp }}")
{%- else -%}
::SCE::Saved::savedRead{{ field.saved_type | capitalize }}({{ raw }}, "{{ field.id | escape_cpp }}")
{%- endif -%}
{%- endmacro %}
