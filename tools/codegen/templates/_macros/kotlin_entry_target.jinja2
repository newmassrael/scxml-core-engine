{#
   One token of a target list — a transition's `target`, a state's initial
   transition, a `<history>`'s default — as the Kotlin machine spells it.

   A `<history>` is not a state and has no State object: it is named by the
   machine's private `history<Id>` HistoryId, and the runtime's entry
   procedures dereference it to what it recorded or to its default. Every
   other token is a State. The Kotlin twin of `go_entry_target.jinja2` and
   `rust_entry_target.jinja2`.

   `history_states` and `machine_name` are passed in rather than read from the
   caller's context because an imported macro does not see it.
#}
{% macro entry_target(token, history_states, machine_name) -%}
{%- if token in history_states -%}HistoryTarget(history{{ token | to_state_class_name }})
{%- else -%}StateTarget({{ machine_name }}State.{{ token | to_state_class_name }})
{%- endif -%}
{%- endmacro %}

{# A whole target list, as a list expression typed by the declaration it
   initialises. #}
{% macro entry_targets(tokens, history_states, machine_name) -%}
listOf({% for t in tokens %}{{ entry_target(t, history_states, machine_name) }}{{ ", " if not loop.last }}{% endfor %})
{%- endmacro %}
