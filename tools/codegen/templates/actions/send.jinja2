{# The two local deliveries `send_dispatch_local` chooses between. #}
{% macro send_raise_internal(event_cpp, carries_typed) %}
{
    auto meta = typename Engine::EventWithMetadata({{ event_cpp }}, eventData);
{% if carries_typed %}
    meta.typedData = typedData;
{% endif %}
    engine.raise(std::move(meta));
}
{% endmacro %}
{% macro send_raise_external(action, model, event_cpp, target_cpp, carries_typed) %}
