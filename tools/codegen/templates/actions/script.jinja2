{% if action.is_cpp_function %}
// W3C SCXML 3.8.6: Direct C++ function call (Zero Overhead)
{{ action.content_transformed | trim }};
{% else %}
// W3C SCXML 3.8.6: <script> via JSEngine
{
    this->ensureJSEngine();
    auto& jsEngine = getScriptEngine();
    {% if action.content %}
    auto scriptResult = jsEngine.executeScript(sessionId_.value(), "{{ action.content | escape_cpp }}").get();
    if (!::SCE::ScriptResultUtils::isSuccess(scriptResult)) {
        std::string errorMsg = "Script execution failed";
        SCE_LOG_ERROR("{}", errorMsg);
        engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, errorMsg));
    }
    {% elif action.src %}
    // External script loading not implemented
    SCE_LOG_WARN("External script loading (src attribute) not supported");
    {% endif %}
}
{% endif %}
