{# W3C SCXML 6.3: Cancel delayed send event.
   <cancel> MUST carry either sendid or sendidexpr (W3C §6.3); both-empty
   is rejected at parse time by the SCXML parser (parser.rs cancel branch,
   wire `validation/require-either`). No else arm — parser guarantees one
   branch matches. #}
// W3C SCXML 6.3: Cancel delayed send event
{% if action.sendidexpr %}
{
    this->ensureScriptEngine();
    auto& scriptEngine = getScriptEngine();
    auto sendidResult = scriptEngine.evaluateExpression(sessionId_.value(), {{ action.sendidexpr | to_script_source_expr }}).get();
    if (::SCE::ScriptResultUtils::isSuccess(sendidResult)) {
        std::string sendidToCancel = ::SCE::ScriptResultUtils::resultToString(sendidResult);
        engine.cancelEvent(sendidToCancel);
    } else {
        // W3C SCXML 5.9: a sendidexpr that fails raises error.execution, and
        // (W3C SCXML 4.9) the error ends the block.
        engine.raise(typename Engine::EventWithMetadata(Event::Error_execution,
                                                        "<cancel> sendidexpr failed to evaluate"));
{% if block_exit is defined and block_exit %}
        {{ block_exit }}
{% endif %}
    }
}
{% elif action.sendid %}
engine.cancelEvent("{{ action.sendid }}");
{% endif %}
