// W3C SCXML 4.3: <if>
{#
    The native arm comes first, exactly as it does in
    `process_transition.jinja2`. Without it a `cpp:` cond fell past every
    arm to the constant fold below and emitted `if (false)`, which made the
    branch body dead code and ran any `<else>` beside it unconditionally —
    a wrong output, not a missing one, and with no diagnostic.
#}
{#
    The whole chain sits in a block of its own, as `<assign>` does: the
    script-engine arm declares `scriptEngine`, and two `<if>`s in one action
    list — three transitions of one state each carrying one, say — otherwise
    declared it twice in the same scope and the machine did not compile.
#}
{
{% if action.is_cpp_condition %}
// W3C SCXML 4.2: native guard (cpp: prefix) - direct C++ evaluation
if ({{ action.cond_cpp_transformed }}) SCE_LIKELY {
{% elif action.is_pure_in_predicate %}
// W3C SCXML 5.9.2: Pure In() predicate - direct C++ call (no JSEngine)
if ({{ action.cond_cpp }}) SCE_LIKELY {
{% elif model.needs_script_engine %}
// W3C SCXML 5.9: ECMAScript expression - JSEngine evaluation
// Use safeEvaluateGuard for std::optional<bool> handling and error.execution support
this->ensureScriptEngine();
auto& scriptEngine = getScriptEngine();
if (this->safeEvaluateGuard(scriptEngine, sessionId_.value(), {{ action.cond | to_script_source_guard }}, engine)) SCE_LIKELY {
{% else %}
// W3C SCXML 4.2: cond="{{ action.cond }}" decided at build time
if ({{ 'true' if action.cond_constant else 'false' }}) SCE_LIKELY {
{% endif %}
    {% for then_action in action.then_actions %}
    {% with action=then_action %}
    {% include 'actions/' + then_action.type + '.jinja2' %}
    {% endwith %}
    {% endfor %}
{% for elseif in action.elseif_branches %}
} else if ({% if elseif.is_cpp_condition %}{{ elseif.cond_cpp_transformed }}{% elif elseif.is_pure_in_predicate %}{{ elseif.cond_cpp }}{% elif model.needs_script_engine %}this->safeEvaluateGuard(scriptEngine, sessionId_.value(), {{ elseif.cond | to_script_source_guard }}, engine){% else %}{{ 'true' if elseif.cond_constant else 'false' }}{% endif %}) {
    {% for elseif_action in elseif.actions %}
    {% with action=elseif_action %}
    {% include 'actions/' + elseif_action.type + '.jinja2' %}
    {% endwith %}
    {% endfor %}
{% endfor %}
{% if action.else_actions %}
} else {
    {% for else_action in action.else_actions %}
    {% with action=else_action %}
    {% include 'actions/' + else_action.type + '.jinja2' %}
    {% endwith %}
    {% endfor %}
{% endif %}
}
}
