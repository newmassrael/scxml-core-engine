// W3C SCXML 3.8.8: <log>
{% if action.expr %}
{% if '_event.raw' in action.expr or '_event.invokeid' in action.expr %}
// TODO: log {{ action.expr }}
{% elif model.needs_script_engine %}
{
    this->ensureScriptEngine();
    auto& scriptEngine = getScriptEngine();
    auto logResult = scriptEngine.evaluateExpression(sessionId_.value(), "{{ action.expr | escape_cpp }}").get();
    if (::SCE::ScriptResultUtils::isSuccess(logResult)) {
        SCE_LOG_INFO("{% if action.label %}{{ action.label }}: {% endif %}{}", ::SCE::ScriptResultUtils::resultToString(logResult));
    } else {
        SCE_LOG_ERROR("Failed to evaluate log expression: {{ action.expr | escape_cpp }}");
    }
}
{% else %}
// Convert JavaScript single quotes to C++ double quotes for string literals
SCE_LOG_INFO("{% if action.label %}{{ action.label }}: {% endif %}{}", {{ action.expr | replace("'", '"') }});
{% endif %}
{% else %}
SCE_LOG_INFO("{{ action.label }}");
{% endif %}
