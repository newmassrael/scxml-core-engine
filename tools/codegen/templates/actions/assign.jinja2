{#
    Assign Action Template (Jinja2)

    Last Modified: 2025-10-30
    ARCHITECTURE.md Version: 2025-10-23

    ARCHITECTURE.md Compliance (Lines 311-491):
    - Single Source of Truth: the location is validated at build time from the
      fact every backend reads (`read_only_location`), not by a run-time check
      of a literal
    - Zero Duplication: Uses shared AssignmentExecutionHelper for execution
    - Single Source of Truth: Assignment strategy matches Interpreter engine exactly
    - W3C SCXML 5.3: Data model assignment semantics
    - W3C SCXML 5.10: System variable reference preservation (_event, _sessionid, etc.)
    - W3C SCXML B.2: System variable immutability enforcement

    Helper Classes Used:
    - AssignmentExecutionHelper: W3C SCXML 5.3/5.10 assignment execution strategy

    Critical Fixes:
    - 2025-10-28: Refactored to use shared AssignmentExecutionHelper
    - 2025-10-30: Conditional block scope based on context (foreach vs standalone)
#}
{% if action.native_code %}
// W3C SCXML 5.3: <assign location="{{ action.location }}">, a sce-static statement lowered to C++
{% include 'actions/_native_statement.jinja2' %}
{% elif not action.location or action.location is read_only_location %}
{# W3C SCXML 5.3/5.4/B.2: no location, or a system variable the data model
   keeps read-only. The location is a literal, so the build decides it once,
   from the fact every backend that refuses it reads (`read_only_location`,
   filters::READ_ONLY_LOCATIONS), and the element is its refusal alone:
   error.execution, and the block ends (W3C SCXML 4.9) — `return;` in an
   entry, exit, initial, history or transition block, `return false;` in a
   <foreach> body, as `block_exit` names it. #}
{% set assign_exit = block_exit if block_exit is defined and block_exit else 'return;' %}
{
    // W3C SCXML 5.3/B.2: the build refused this location as invalid or read-only
    SCE_LOG_ERROR("W3C SCXML 5.3: Invalid assign location '{{ action.location | escape_cpp_format }}'");
    engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, "<assign> has an invalid or read-only location '{{ action.location | escape_cpp }}'"));
    {{ assign_exit }}  // W3C SCXML 4.9: the error ends the block
}
{# The exit is unconditional: the action list emits nothing after this
   element (`block_flow`, entry_exit_actions.jinja2). #}
{% set block_flow.ended = true %}
{% else %}
{% if not in_foreach %}{{ '{' }}{% endif %}
{% if not in_foreach %}bool success = false;
{% else %}success = false;  // Use foreach-scope variable
{% endif %}
{
    // W3C SCXML 5.3, 5.4: the location is one an <assign> may write (decided at build time)
    AOT_DEBUG("AOT assign: Before ensureScriptEngine for {{ action.location | escape_cpp_format }}");
    this->ensureScriptEngine();
    AOT_DEBUG("AOT assign: After ensureScriptEngine, sessionId={}", sessionId_.value_or("NONE"));
    auto& scriptEngine = getScriptEngine();

    // ARCHITECTURE.md: Zero Duplication - Use shared AssignmentExecutionHelper
    // W3C SCXML 5.3/5.10: Assignment execution with proper system variable handling
    {% if action.content %}
    // W3C SCXML 5.4.2: the children "provide an in-line specification of the
    // legal data value ... to be inserted into the data model at the specified
    // location" — the same reading <data> content gets, made once by
    // `to_author_assign_content` so this backend and the lowering ones cannot
    // disagree about whether `21` is a number. Quoting it unconditionally, as
    // this line did, made it the string "21".
    ::SCE::ScriptSource expr = {{ action.content | to_script_source_assign_content }};
    {% else %}
    ::SCE::ScriptSource expr = {{ action.expr.rstrip(';') | to_script_source_expr }};
    {% endif %}

    success = ::SCE::AssignmentExecutionHelper::executeAssignment(
        scriptEngine, sessionId_.value(), {{ action.location | to_script_source_location }}, expr,
        [&engine](const std::string& error) {
            SCE_LOG_ERROR("AOT assign: {}", error);
            engine.raise(typename Engine::EventWithMetadata(Event::Error_execution, error));
        }
    );

    if (!success) SCE_UNLIKELY {
        // Assignment failed, error.execution already raised by callback
        {% if action.content %}
        SCE_LOG_ERROR("AOT assign: Failed to assign {{ action.location | escape_cpp_format }} = content");
        {% else %}
        SCE_LOG_ERROR("AOT assign: Failed to assign {{ action.location | escape_cpp_format }} = {{ action.expr.rstrip(';') | escape_cpp_format }}");
        {% endif %}
    } else {
        {% if action.content %}
        AOT_DEBUG("AOT assign: Successfully assigned {{ action.location | escape_cpp_format }} = content");
        {% else %}
        AOT_DEBUG("AOT assign: Successfully assigned {{ action.location | escape_cpp_format }} = {{ action.expr.rstrip(';') | escape_cpp_format }}");
        {% endif %}
    }
}
{# W3C SCXML 4.9: the error ends the block. Inside a <foreach> body the loop
   reads `success` and ends the iteration itself. #}
{% if not in_foreach and block_exit is defined and block_exit %}
if (!success) {
    {{ block_exit }}
}
{% endif %}
{% if not in_foreach %}{{ '}' }}{% endif %}
{% endif %}
