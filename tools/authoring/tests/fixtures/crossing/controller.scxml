<?xml version="1.0" encoding="UTF-8"?>
<!-- Written from the brief the core assembled for this specification, by the
     same route the first subject matter was converted by. It is kept here as
     the other half of the evidence: the questions are only worth having if a
     document comes out at the end of them.

     One output is deliberately NOT decided. The specification never says what
     the train signal shows, the examples read it back, and the core said so.
     The right thing to write for an answer nobody has is the marker that says
     so, rather than a guess that would compile and be wrong. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="transform" name="crossing_controller">
  <!-- What each output can be is a closed set, so each is an enumeration of
       this document's own: a value is written by its name, and the binding
       lands it on the platform's symbol of the same name. The platform's
       number for a symbol appears nowhere in this document. -->
  <sce:import as="RoadSignal" src="road_signal_values.scxml" kind="enum"/>
  <sce:import as="Bell" src="bell_values.scxml" kind="enum"/>
  <sce:import as="Barrier" src="barrier_values.scxml" kind="enum"/>
  <sce:import as="TrainSignal" src="train_signal_values.scxml" kind="enum"/>
  <datamodel>
    <data id="approaching" sce:type="bool" sce:direction="in"/>
    <data id="occupied" sce:type="bool" sce:direction="in"/>
    <data id="clear" sce:type="bool" sce:direction="in"/>
    <data id="obstacleNone" sce:type="bool" sce:direction="in"/>
    <data id="barrierDown" sce:type="bool" sce:direction="in"/>
    <data id="manualOverride" sce:type="bool" sce:direction="in"/>

    <data id="roadSignal" sce:type="enum:RoadSignal" sce:direction="out"
          expr="manualOverride ? RoadSignal.DARK
        : (approaching ? RoadSignal.FLASHING
          : (occupied ? RoadSignal.STEADY : RoadSignal.DARK))"/>

    <!-- The bell follows the signal rather than the detector, because the
         specification defines it that way: it rings whenever the signal is
         not dark. -->
    <data id="bell" sce:type="enum:Bell" sce:direction="out"
          expr="(roadSignal !== RoadSignal.DARK) ? Bell.RINGING : Bell.SILENT"/>

    <data id="barrier" sce:type="enum:Barrier" sce:direction="out"
          expr="manualOverride ? Barrier.STOP
        : (barrierDown ? Barrier.STOP
          : ((approaching &amp;&amp; obstacleNone) ? Barrier.LOWER
            : (clear ? Barrier.RAISE : Barrier.STOP)))"/>

    <data id="trainSignal" sce:type="enum:TrainSignal" sce:direction="out"
          sce:unresolved="CROSSING_TRAIN_SIGNAL_UNDECIDED"
          sce:unresolved-reason="the specification never says what the train signal shows. The commissioning records read it back in every case -- CAUTION while a train approaches, CLEAR once the barrier is down, DANGER when the mains fail -- so the value is load-bearing and cannot be left to a guess. Whoever owns this installation has to say it."/>
  </datamodel>
</scxml>
