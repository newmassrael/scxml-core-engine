# SPDX-FileCopyrightText: Copyright (c) 2026 newmassrael
#
# The image the Linux gates run in, the family `host` (docs/adr/0145, D4),
# wherever they run: a hosted lane, a build machine judging an update to main,
# a workstation. A gate names this file in `container` (its entry under
# tools/git-hooks/gates/), and `scripts/gate` runs the gate inside the image,
# which it pulls as ghcr.io/newmassrael/sce-gate-host:<digest>, the digest
# being that of this directory, and builds only when the registry has none
# ("Gates that run in an image" in tools/git-hooks/gate_registry.py). No lane
# installs a package at job time (D1): what a gate needs of a machine beyond
# Rust is named here, and a change to it is a commit the gates that use it
# judge.
#
# ## What makes a rebuild the same image (D3)
#
# The base is named by its digest, the x86_64 image of ubuntu:24.04 that Docker
# Hub served on 2026-11-26: the runners and the build machines are x86_64
# (`arch` of bx.toml's platform), and the first step refuses any other. The
# package archive is a dated snapshot of the Ubuntu archive, its release,
# update and security pockets alike, so a rebuild resolves every package to
# the version it resolved to on that date. Every toolchain downloaded beside
# the packages is named by its release and the SHA-256 its publisher gives, and
# the archive is refused before it is unpacked when the two differ.
#
# The snapshot service is served over HTTPS only, and the base image carries no
# certificate authority to check it with. The first step fetches the package
# index and `ca-certificates` without checking the server's certificate, which
# leaves what is installed checked as the archive always checks it: the index
# is signed with the Ubuntu archive key the base image carries, and each
# package is held to the hash the signed index gives. Every fetch after it
# checks the certificate.
#
# Moving a version is an edit of this directory: a new digest, a new image, and
# a change every gate that runs here judges.
#
# ## What is not here, and why
#
# Rust: the runner mounts the release it selected, read-only, and the gate
# builds with that one and no other (`gate_in_container` in scripts/gate);
# `a-gate-image-builds-on-the-selected-rust` in the registry's self-test
# refuses a last stage that installs one. The compile cache's sccache, the
# other Rust toolchains a plan names and the rev-pinned Mnemosyne build are
# handed in the same way: their pins are the tree's and the runner provisions
# them. zenoh-c, one of the mesh transport SDKs, is a Rust build: it is built
# in a stage of its own, with the release zenoh-c's own rust-toolchain.toml
# names, and only what it installs is copied into the image.
#
# ## The pins, and where each one is the tree's
#
# A release a script or bx.toml already pins is written here again, because the
# build context is this directory and nothing outside it reaches the build;
# each tool is installed at the root its install script names in a variable
# (GENMC_ROOT, CHROME_ROOT, ...), which ENV below sets, so a gate finds it as
# it finds the copy that script installs on a build machine. The registry's
# self-test holds every copy to its source
# (`an-image-installs-the-releases-the-tree-pins`,
# `a-gate-image-holds-the-pins-its-gate-reads`,
# `the-fleet-and-the-lanes-install-one-emsdk`): Go to
# backends/go/forge-runtime/go.mod and scripts/install_go.sh, the Arm
# toolchain to scripts/install_arm_gnu_toolchain.sh, emsdk to
# scripts/install_emsdk.sh, GenMC to scripts/install_genmc.sh, Chrome to
# scripts/install_chrome.sh, Firefox to scripts/install_firefox.sh,
# wasm-bindgen to scripts/install_wasm_bindgen.sh,
# Bazel to scripts/install_bazel.sh, the mesh SDKs to
# scripts/install_mesh_transports.sh, and the Python packages to
# scripts/install_sce_python.sh and backends/python/runtime/pyproject.toml.
# The JDK, Node and wasm-pack were named by the lanes' setup steps alone, and
# this file is now where they are pinned.
FROM ubuntu:24.04@sha256:9a04f13b3f80ef056361e30868593b1cfd2279fe19e4081cb93a90bf56819d6a AS base

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG UBUNTU_SNAPSHOT=20261126T000000Z

RUN [[ "$(dpkg --print-architecture)" == amd64 ]] \
    || { echo "the image pins the x86_64 archives only" >&2; exit 1; }

# The snapshot as the one package source, and the certificate authorities.
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list \
    && printf '%s\n' \
        'Types: deb' \
        "URIs: https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}" \
        'Suites: noble noble-updates noble-security' \
        'Components: main universe restricted multiverse' \
        'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
        >/etc/apt/sources.list.d/snapshot.sources \
    && apt-get -o Acquire::https::Verify-Peer=false -o Acquire::https::Verify-Host=false update \
    && apt-get -o Acquire::https::Verify-Peer=false -o Acquire::https::Verify-Host=false \
        install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The system packages, one line per group, and the gates that need each:
#
#   1. The tools every gate's run reaches: the runner and the gate library
#      (bash, git, python3, curl, xz, unzip), and `lsof` and `fuser` (psmisc),
#      which the HTTP fixture of the suites reads its port with.
#   2. The C and C++ toolchain and the build tools: a Rust build links with
#      `cc`, so every gate that builds the generator; the CMake trees of
#      cpp-suite, w3c-cpp, w3c-c11, ecma262-lowered-cpp, install-consumer,
#      the embed gates, forge-cpp and forge-c11; `g++` for the library targets
#      builds; meson for the subprojects the CMake tree configures; lld, which
#      the tree links with; `g++-14`, the C++20 compiler GenMC is built with.
#   3. Clang and LLVM: clang-format-19, which `sce-codegen` formats every C++
#      tree it writes with and refuses to run without
#      (docs/SCE_CODEGEN_DETERMINISM.md, section 9), so every gate that
#      generates C++ and the clang-format gate; clang-19, which emits
#      embed/MANIFEST.json (regen-reproduces, the embed-manifest gates);
#      `clang`, the typestate attributes of the workspace suite; llvm-19-dev,
#      GenMC's build; libclang-dev, which the `libxml` crate's bindgen loads
#      to build the generator's XSD validator.
#   4. The libraries the generator and the CMake trees link: libxml2 (the
#      generator's XSD validator, in every gate that builds it); TLS, zlib and
#      brotli (cpp-httplib's client, which the installed package config asks
#      for again in install-consumer); GLib (the dispatcher); spdlog, fmt and
#      Boost (the engine, and vsomeip3 among the mesh SDKs); libsodium (the C++
#      COSE host); SQLite (the Rust session store); libffi and libedit
#      (GenMC).
#   5. What the Swift toolchain links against, as swift.org lists it for
#      Ubuntu 24.04 and bx.toml lists it for the build machines: the Swift
#      rounds of mutation-rounds build the Swift backend.
#   6. Python: the runner and the registry run on python3, the bindings of
#      w3c-python-bindings build against its headers (`python3-config`), and
#      the environment below is a venv of it.
#   7. Emulation: qemu-system-arm runs c11-mcu's images. The cross compiler is
#      Arm's build below, never the distribution's gcc-arm-none-eabi, which
#      is another build than the one c11-mcu's budget is measured with.
#   8. The shared libraries Chrome for Testing links against, as
#      scripts/install_chrome.sh lists them for Ubuntu 24.04: wasm32-scenarios
#      replays its scenarios in it.
#   9. What Firefox links against beside them, as scripts/install_firefox.sh
#      lists it for Ubuntu 24.04: wasm32-scenarios runs the browser node's kit
#      in Firefox as well as in Chrome.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git xz-utils unzip zstd file lsof psmisc procps tzdata \
        build-essential g++ g++-14 cmake ninja-build meson lld pkg-config binutils \
        clang clang-19 clang-format-19 llvm-19-dev libclang-dev \
        libxml2 libxml2-dev libssl-dev zlib1g-dev libbrotli-dev libglib2.0-dev libspdlog-dev libfmt-dev libboost-dev libboost-system-dev libboost-thread-dev libboost-filesystem-dev libsodium-dev libsqlite3-dev libsqlite3-0 libffi-dev libedit-dev \
        libc6-dev libcurl4-openssl-dev libedit2 libncurses-dev libpython3-dev libz3-dev \
        python3 python3-dev python3-venv python3-pip \
        qemu-system-arm \
        libnss3 libgbm1 libxkbcommon0 libxcomposite1 libxdamage1 libxrandr2 libxfixes3 libdrm2 libpango-1.0-0 libcairo2 libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libatspi2.0-0t64 libgtk-3-0t64 \
        libdbus-glib-1-2 libx11-xcb1 libxtst6 \
    && rm -rf /var/lib/apt/lists/*

# ── The mesh transport SDKs, built apart ────────────────────────────────
#
# vsomeip3, zenohcxx and CycloneDDS with their C++ bindings, at the tags
# scripts/install_mesh_transports.sh pins and the commits those tags name,
# built with the options and into the one prefix that script uses: the
# C++ suites register their transport suites only where find_package finds
# all three. zenoh-c is a Rust build, so this stage, and only this one, holds
# the Rust release zenoh-c's rust-toolchain.toml names at its tag (1.85.0),
# installed by rustup-init of a pinned release and SHA-256; the image below
# copies the prefix and nothing of this stage's toolchain.
FROM base AS mesh-transports

ARG RUSTUP_INIT_RELEASE=1.28.2
ARG RUSTUP_INIT_SHA256=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c
ARG ZENOH_C_RUST=1.85.0
ENV RUSTUP_HOME=/tmp/sce-rust/rustup \
    CARGO_HOME=/tmp/sce-rust/cargo \
    PATH=/tmp/sce-rust/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN curl -fsSL --retry 3 --retry-all-errors -o /tmp/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_INIT_RELEASE}/x86_64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum --check --strict - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "${ZENOH_C_RUST}" \
    && rm /tmp/rustup-init

# How many compiles a build step runs at once. `nproc` counts the machine's
# cores, not the memory a build was given: vsomeip's units take about 1.5 GB
# each, and at 28 at once a build held to 10 GB was killed (2026-11-27). The
# runner that builds the image passes the count it can hold
# (`gate_image_build_jobs` in scripts/gate); a bare `docker build` gets nproc.
ARG BUILD_JOBS=
ARG MESH_TRANSPORTS_REV=1
ARG CYCLONEDDS_TAG=11.0.1
ARG CYCLONEDDS_COMMIT=e54e991f75a3e67f8e628da3171122e36ea5b872
ARG CYCLONEDDS_CXX_TAG=11.0.1
ARG CYCLONEDDS_CXX_COMMIT=20ccaa519ca09a7b1776b8630389aa19ce8da61a
ARG VSOMEIP_TAG=3.7.3
ARG VSOMEIP_COMMIT=6171fdfe109a3af8fb64190136029aadd1fa0c6f
ARG ZENOH_C_TAG=1.5.0
ARG ZENOH_C_COMMIT=f5d5a90d720d96d50f13b2718c4e1acd6714682a
ARG ZENOH_CPP_TAG=1.5.0
ARG ZENOH_CPP_COMMIT=a96589bfabce428fca1f915a8aa51dc4340545f9
RUN prefix=/opt/sce-mesh-transports \
    && fetch() { git clone --quiet --depth 1 --branch "$2" "https://github.com/$1" "/tmp/mesh/$4" \
        && [[ "$(git -C "/tmp/mesh/$4" rev-parse HEAD)" == "$3" ]]; } \
    && build() { local src="/tmp/mesh/$1"; shift; \
        cmake -S "$src" -B "$src/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$prefix" "$@" \
        && cmake --build "$src/build" --parallel "${BUILD_JOBS:-$(nproc)}" \
        && cmake --install "$src/build"; } \
    && fetch eclipse-cyclonedds/cyclonedds "${CYCLONEDDS_TAG}" "${CYCLONEDDS_COMMIT}" cyclonedds \
    && build cyclonedds -DBUILD_EXAMPLES=OFF -DBUILD_TESTING=OFF \
    && fetch eclipse-cyclonedds/cyclonedds-cxx "${CYCLONEDDS_CXX_TAG}" "${CYCLONEDDS_CXX_COMMIT}" cyclonedds-cxx \
    && build cyclonedds-cxx -DBUILD_EXAMPLES=OFF -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH="$prefix" \
    && fetch COVESA/vsomeip "${VSOMEIP_TAG}" "${VSOMEIP_COMMIT}" vsomeip \
    && build vsomeip -DENABLE_SIGNAL_HANDLING=1 \
    && fetch eclipse-zenoh/zenoh-c "${ZENOH_C_TAG}" "${ZENOH_C_COMMIT}" zenoh-c \
    && build zenoh-c -DZENOHC_BUILD_WITH_UNSTABLE_API=TRUE \
    && fetch eclipse-zenoh/zenoh-cpp "${ZENOH_CPP_TAG}" "${ZENOH_CPP_COMMIT}" zenoh-cpp \
    && build zenoh-cpp -DZENOHCXX_ZENOHC=ON -DZENOHCXX_ZENOHPICO=OFF -DCMAKE_PREFIX_PATH="$prefix" \
    && mkdir -p "$prefix/bin" \
    && printf '#!/bin/sh\necho "sce-mesh-transports %s"\n' "${MESH_TRANSPORTS_REV}" >"$prefix/bin/sce-mesh-transports" \
    && chmod +x "$prefix/bin/sce-mesh-transports" \
    && rm -rf /tmp/mesh

# ── The image the gates run in ──────────────────────────────────────
FROM base

# Go, the release every backends/go/*/go.mod declares (`go 1.23.0`), with the
# SHA-256 go.dev publishes, which scripts/install_go.sh pins. forge-go, w3c-go,
# workspace-tests, mutation-rounds' Go rounds and regen-reproduces run it.
# GOTOOLCHAIN=local below: a module asking for another release fails here
# rather than fetching one at run time.
ARG GO_RELEASE=1.23.0
ARG GO_SHA256=905a297f19ead44780548933e0ff1a1b86e8327bb459e92f9c0012569f76f5e3
RUN curl -fsSL --retry 3 --retry-all-errors -o /tmp/go.tar.gz "https://go.dev/dl/go${GO_RELEASE}.linux-amd64.tar.gz" \
    && echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum --check --strict - \
    && tar -xzf /tmp/go.tar.gz -C /usr/local \
    && rm /tmp/go.tar.gz \
    && [[ "$(GOTOOLCHAIN=local /usr/local/go/bin/go version)" == "go version go${GO_RELEASE} "* ]]

# The JDK the Kotlin lanes run Gradle on: Eclipse Temurin 17, the distribution
# and the major their `setup-java` names, at the release Adoptium published as
# the newest 17 on 2026-11-26, with its SHA-256. w3c-kotlin,
# ecma262-lowered-kotlin, forge-kotlin, formal-models and workspace-tests (the
# Kotlin jars its suites start) run it; `sce_gate_require_jdk` in
# scripts/gates/lib.sh takes JAVA_HOME below.
ARG JDK_RELEASE=17.0.21.1+2
ARG JDK_ARCHIVE=OpenJDK17U-jdk_x64_linux_hotspot_17.0.21.1_2.tar.gz
ARG JDK_SHA256=0b0ac5eab6db6abaec68c9913bcddb31321e5da411c45073d520d9c125e6f7b4
RUN curl -fsSL --retry 3 --retry-all-errors -o /tmp/jdk.tar.gz \
        "https://github.com/adoptium/temurin17-binaries/releases/download/jdk-${JDK_RELEASE/+/%2B}/${JDK_ARCHIVE}" \
    && echo "${JDK_SHA256}  /tmp/jdk.tar.gz" | sha256sum --check --strict - \
    && mkdir -p /opt/jdk-17 \
    && tar -xzf /tmp/jdk.tar.gz -C /opt/jdk-17 --strip-components=1 \
    && rm /tmp/jdk.tar.gz \
    && /opt/jdk-17/bin/javac -version

# Node, the major wasm32-scenarios' `setup-node` names (22), at the release
# nodejs.org published as the newest 22 on 2026-11-26, with the SHA-256 of its
# SHASUMS256.txt. wasm32-scenarios runs the wasm32 machines on it, and the
# suites' BasicHTTP fixtures post to the echo server it runs.
ARG NODE_RELEASE=22.23.5
ARG NODE_SHA256=cdeb8670a0c81f51b4dc4ac61919f9b1ad917b304bf8221eb939570663d240f8
RUN curl -fsSL --retry 3 --retry-all-errors -o /tmp/node.tar.xz \
        "https://nodejs.org/dist/v${NODE_RELEASE}/node-v${NODE_RELEASE}-linux-x64.tar.xz" \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict - \
    && mkdir -p /opt/node \
    && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && [[ "$(/opt/node/bin/node --version)" == "v${NODE_RELEASE}" ]]

# The Arm cross compiler c11-mcu builds its images with: Arm's own build of
# the release its footprint budget is measured with, and the SHA-256 Arm
# publishes, both of which scripts/install_arm_gnu_toolchain.sh pins
# (docs/adr/0110, D4). The gate refuses a compiler that is not Arm's build.
ARG ARM_GNU_TOOLCHAIN_REV=13.2.rel1
ARG ARM_GNU_TOOLCHAIN_SHA256=6cd1bbc1d9ae57312bcd169ae283153a9572bd6a8e4eeae2fedfbc33b115fdbb
RUN archive="arm-gnu-toolchain-${ARM_GNU_TOOLCHAIN_REV}-x86_64-arm-none-eabi.tar.xz" \
    && curl -fsSL --retry 3 --retry-all-errors -o "/tmp/${archive}" \
        "https://developer.arm.com/-/media/Files/downloads/gnu/${ARM_GNU_TOOLCHAIN_REV}/binrel/${archive}" \
    && echo "${ARM_GNU_TOOLCHAIN_SHA256}  /tmp/${archive}" | sha256sum --check --strict - \
    && mkdir -p /opt/arm-gnu-toolchain \
    && tar -xJf "/tmp/${archive}" -C /opt/arm-gnu-toolchain --strip-components=1 \
    && rm "/tmp/${archive}" \
    && /opt/arm-gnu-toolchain/bin/arm-none-eabi-gcc --version | grep -F "Arm GNU Toolchain ${ARM_GNU_TOOLCHAIN_REV}" >/dev/null

# The Emscripten SDK at the release scripts/install_emsdk.sh pins, from the
# emsdk repository at the commit its tag of that release names: w3c-wasm,
# cpp-suite-wasm, visualizer-wasm and visualizer-layout build with it. As that
# script does, the cache is frozen and a program is linked from it, so an SDK
# that would build its system libraries at the first link fails here. The gate
# library finds it at EMSDK_ROOT below (`sce_gate_activate_emsdk`) and moves
# its cache where the gate's account can write (`sce_gate_writable_em_cache`).
# The release is written on the install line itself, which
# `the-fleet-and-the-lanes-install-one-emsdk` reads.
ARG EMSDK_COMMIT=35659964bc2762fffec0d257997fb61475f765b7
RUN git clone --quiet https://github.com/emscripten-core/emsdk.git /opt/emsdk \
    && git -C /opt/emsdk checkout --quiet "${EMSDK_COMMIT}" \
    && /opt/emsdk/emsdk install 6.0.13 \
    && /opt/emsdk/emsdk activate 6.0.13 \
    && printf '\nFROZEN_CACHE = True\n' >>/opt/emsdk/.emscripten \
    && rm -rf /opt/emsdk/.git /opt/emsdk/downloads \
    && /opt/emsdk/upstream/emscripten/emcc --version | grep -F " 6.0.13 " >/dev/null \
    && printf '#include <pthread.h>\nint main(void) { return 0; }\n' >/tmp/probe.c \
    && EM_CONFIG=/opt/emsdk/.emscripten /opt/emsdk/upstream/emscripten/emcc /tmp/probe.c -o /tmp/probe.js \
    && rm -f /tmp/probe.c /tmp/probe.js /tmp/probe.wasm

# GenMC, the C11 memory-model checker genmc-queue runs, at the release
# scripts/install_genmc.sh pins and the commit its tag names, built the way
# that script builds it (g++-14, LLVM 19) and installed at GENMC_ROOT below.
ARG GENMC_REV=v0.19.0
ARG GENMC_COMMIT=9f6c4c0772d0c42b325681581acc6a0f3eb9b5f7
RUN git clone --quiet --depth 1 --branch "${GENMC_REV}" https://github.com/MPI-SWS/genmc /tmp/genmc \
    && [[ "$(git -C /tmp/genmc rev-parse HEAD)" == "${GENMC_COMMIT}" ]] \
    && cmake -S /tmp/genmc -B /tmp/genmc/build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_CXX_COMPILER=g++-14 \
        -DCMAKE_PREFIX_PATH=/usr/lib/llvm-19 \
        -DCMAKE_INSTALL_PREFIX=/opt/genmc >/dev/null \
    && cmake --build /tmp/genmc/build \
    && cmake --install /tmp/genmc/build >/dev/null \
    && rm -rf /tmp/genmc \
    && /opt/genmc/bin/genmc --version

# Chrome for Testing, the browser wasm32-scenarios replays its scenarios in,
# at the release scripts/install_chrome.sh pins and with the SHA-256 that
# script records for its linux64 archive, unpacked at CHROME_ROOT below as
# that script unpacks it. Its shared libraries are group 8 above.
ARG CHROME_REV=157.0.8103.38
ARG CHROME_ZIP_SHA256=8cdeb344e9b2cefe59f4aea8d1d93d5d93054c03cde217665c16fc1f62e72a66
RUN curl -fsSL --retry 3 --retry-all-errors -o /tmp/chrome-linux64.zip \
        "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_REV}/linux64/chrome-linux64.zip" \
    && echo "${CHROME_ZIP_SHA256}  /tmp/chrome-linux64.zip" | sha256sum --check --strict - \
    && mkdir -p /opt/chrome-for-testing \
    && unzip -q -o /tmp/chrome-linux64.zip -d /opt/chrome-for-testing \
    && rm /tmp/chrome-linux64.zip \
    && /opt/chrome-for-testing/chrome-linux64/chrome --version | grep -F " ${CHROME_REV}" >/dev/null

# Firefox, the second engine wasm32-scenarios runs the browser node's kit in,
# at the release scripts/install_firefox.sh pins and with the SHA-256 Mozilla
# publishes for its linux-x86_64 archive, which that script records, unpacked
# at FIREFOX_ROOT below as that script unpacks it. Its shared libraries are
# groups 8 and 9 above.
ARG FIREFOX_REV=161.0
ARG FIREFOX_SHA256=3e9b1e5132d7b53b1ad968c7300281e90e6a0ef57d0656b1516202d686d25733
RUN curl -fsSL --retry 3 --retry-all-errors -o /tmp/firefox.tar.xz \
        "https://archive.mozilla.org/pub/firefox/releases/${FIREFOX_REV}/linux-x86_64/en-US/firefox-${FIREFOX_REV}.tar.xz" \
    && echo "${FIREFOX_SHA256}  /tmp/firefox.tar.xz" | sha256sum --check --strict - \
    && mkdir -p /opt/firefox \
    && tar -xJf /tmp/firefox.tar.xz -C /opt/firefox \
    && rm /tmp/firefox.tar.xz \
    && /opt/firefox/firefox/firefox --version | grep -F " ${FIREFOX_REV}" >/dev/null

# wasm-bindgen, the tool wasm32-scenarios binds the module with, at the release
# scripts/install_wasm_bindgen.sh pins (the version Cargo.lock holds, which the
# gate refuses any other than). The script builds it from source, which needs a
# Rust this image does not carry; the release's own x86_64 build is unpacked
# here instead, held to the SHA-256 its release publishes, at
# WASM_BINDGEN_ROOT below.
ARG WASM_BINDGEN_REV=0.2.117
ARG WASM_BINDGEN_SHA256=97f527f7c7956f69a88a4bdb5176142ebc4e255c2dbe3805ec4f373421028240
RUN archive="wasm-bindgen-${WASM_BINDGEN_REV}-x86_64-unknown-linux-musl.tar.gz" \
    && curl -fsSL --retry 3 --retry-all-errors -o "/tmp/${archive}" \
        "https://github.com/wasm-bindgen/wasm-bindgen/releases/download/${WASM_BINDGEN_REV}/${archive}" \
    && echo "${WASM_BINDGEN_SHA256}  /tmp/${archive}" | sha256sum --check --strict - \
    && mkdir -p /opt/wasm-bindgen/bin \
    && tar -xzf "/tmp/${archive}" -C /opt/wasm-bindgen/bin --strip-components=1 \
    && rm "/tmp/${archive}" \
    && [[ "$(/opt/wasm-bindgen/bin/wasm-bindgen --version)" == "wasm-bindgen ${WASM_BINDGEN_REV}" ]]

# wasm-pack, which visualizer-wasm builds the codegen WASM with, at the release
# deploy-visualizer.yml installed before this image held it, with the SHA-256
# its release publishes for the x86_64 build.
ARG WASM_PACK_RELEASE=v0.15.0
ARG WASM_PACK_SHA256=c09f971ecaed9a2efc80fdcea7a00ef6b53c7fadc8c57d1f61b53a6aa66b668a
RUN archive="wasm-pack-${WASM_PACK_RELEASE}-x86_64-unknown-linux-musl.tar.gz" \
    && curl -fsSL --retry 3 --retry-all-errors -o "/tmp/${archive}" \
        "https://github.com/wasm-bindgen/wasm-pack/releases/download/${WASM_PACK_RELEASE}/${archive}" \
    && echo "${WASM_PACK_SHA256}  /tmp/${archive}" | sha256sum --check --strict - \
    && mkdir -p /tmp/wasm-pack \
    && tar -xzf "/tmp/${archive}" -C /tmp/wasm-pack --strip-components=1 \
    && install -m 0755 /tmp/wasm-pack/wasm-pack /usr/local/bin/wasm-pack \
    && rm -rf /tmp/wasm-pack "/tmp/${archive}" \
    && wasm-pack --version

# Bazel, which the Bazel consumer smoke of the embed gates builds with, at the
# release scripts/lib/bazel_pins.sh pins and the SHA-256 scripts/install_bazel.sh
# records for its x86_64 binary, installed at BAZEL_ROOT below.
ARG BAZEL_RELEASE=9.3.1
ARG BAZEL_SHA256=7f775b54bbec487efaf0f49ccda1d2ed02cd34f582edfdd6aeeec76e39ef585c
RUN curl --proto =https --tlsv1.2 -fsSL --retry 3 --retry-all-errors -o /tmp/bazel \
        "https://github.com/bazelbuild/bazel/releases/download/${BAZEL_RELEASE}/bazel-${BAZEL_RELEASE}-linux-x86_64" \
    && echo "${BAZEL_SHA256}  /tmp/bazel" | sha256sum --check --strict - \
    && mkdir -p /opt/bazel/bin \
    && install -m 0755 /tmp/bazel /opt/bazel/bin/bazel \
    && rm /tmp/bazel

# The mesh transport SDKs, built in the stage above.
COPY --from=mesh-transports /opt/sce-mesh-transports /opt/sce-mesh-transports

# The Python environment the Python suites run in: what
# scripts/install_sce_python.sh puts in the repository's environment (the
# runtime's `lupa`, pytest, PyYAML, jsonschema, pypdfium2), every distribution
# at one version with the SHA-256 of its wheel, and nothing resolved at build
# time that the file does not name (`--require-hashes`). authoring-core,
# targets, w3c-python and workspace-tests run on it: it is first on PATH, so it
# is the `python3` of `sce_gate_python` here.
COPY python-requirements.txt /tmp/python-requirements.txt
RUN python3 -m venv /opt/sce-python \
    && /opt/sce-python/bin/python -m pip install --no-cache-dir --disable-pip-version-check \
        --require-hashes --only-binary :all: -r /tmp/python-requirements.txt \
    && /opt/sce-python/bin/python -m pip check \
    && /opt/sce-python/bin/python -c 'import lupa.lua54, pytest, yaml, jsonschema, pypdfium2' \
    && rm /tmp/python-requirements.txt

# The toolchain roots, under the names their install scripts read
# (scripts/install_*.sh) and the gates look for them by; the mesh SDKs where
# CMake's find_package and the loader look, as the hosted lane exported them.
ENV PATH=/opt/sce-python/bin:/opt/arm-gnu-toolchain/bin:/opt/node/bin:/opt/jdk-17/bin:/usr/local/go/bin:/opt/wasm-bindgen/bin:/opt/bazel/bin:/opt/genmc/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    GOROOT=/usr/local/go \
    GOTOOLCHAIN=local \
    JAVA_HOME=/opt/jdk-17 \
    ARM_GNU_TOOLCHAIN_ROOT=/opt/arm-gnu-toolchain \
    EMSDK=/opt/emsdk \
    EMSDK_ROOT=/opt/emsdk \
    GENMC_ROOT=/opt/genmc \
    CHROME_ROOT=/opt/chrome-for-testing \
    CHROME_BIN=/opt/chrome-for-testing/chrome-linux64/chrome \
    FIREFOX_ROOT=/opt/firefox \
    FIREFOX_BIN=/opt/firefox/firefox/firefox \
    WASM_BINDGEN_ROOT=/opt/wasm-bindgen \
    BAZEL_ROOT=/opt/bazel \
    CMAKE_PREFIX_PATH=/opt/sce-mesh-transports \
    LD_LIBRARY_PATH=/opt/sce-mesh-transports/lib \
    LANG=C.UTF-8
