#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only WITH AdditionRef-SCE-Linking-Exception OR LicenseRef-SCE-Commercial
# SPDX-FileCopyrightText: Copyright (c) 2026 newmassrael
#
# Run the repository's CI-mirroring gates.
#
#   scripts/gate <slug> [<slug>...]   run named gates (plus their deps)
#   scripts/gate --all                run every gate
#   scripts/gate --changed-from FILE  run the gates a change set requires
#   scripts/gate --changed-in A..B    the same, the set being what A..B changes
#   scripts/gate --list               show every gate in run order
#   scripts/gate --measure --all      run and report each gate's wall clock
#   scripts/gate --plan <selection>   print the bx check units for a selection
#   scripts/gate --landing ...        run or plan as the judgment of an update
#                                     to main: the push's gates, no skip
#   scripts/gate --rust <release> ... run on that installed Rust release only
#   scripts/gate --at <commit> ...    refuse to run unless HEAD is that commit
#   scripts/gate --change-set A..B <slug>...
#                                     run named gates, handing them what A..B
#                                     changes as the set they read
#   scripts/gate --unit ...           run as a unit of a plan: no registry self-test
#   scripts/gate --shard k/N <slug>   run part k of N of a gate that declares
#                                     `shard_env`, as a plan's shard unit does
#
# The order is derived, never typed: each gate's entry
# (`tools/git-hooks/gates/<slug>.py`, which `tools/git-hooks/gate_registry.py`
# reads) holds its dependencies and measured cost, and the runner sorts by
# dependencies first, cheapest first within that. A gate added tomorrow
# lands in the right place without anyone rearranging a script.
#
# `--measure` is how `cost_s` in the registry gets its values. They are
# measurements, not estimates, and re-measuring is a matter of running this.
#
# `--plan` runs no gate. It takes the same selection as a run (`--all`,
# `--changed-in`, `--changed-from`, slugs), reads the pinned Rust release, and
# prints the units bx runs for it, one JSON object a line: the plan of
# the set `[checks.prepush]` in bx.toml, which the push hook hands to bx.
# Each unit is this runner on one gate at that release
# (`--rust`), so the release is in the unit's argv and therefore in the key bx
# keeps the unit's pass under. A unit whose gate reads HEAD carries HEAD's id
# too (`--at`), and runs only on that commit. See "Whether a gate's verdict may
# be kept" and `plan_units` in the registry for when a unit's pass is kept.
#
# `--landing` is the judgment of an update to main, which only the landing
# queue's integrator can make. A change set selects what it selects for any
# push (the registry's `select`; the `ci_only` gates are hosted CI's to audit
# after landing, and the plan names them), and `--all` selects every gate
# the fleet can run. A landing's plan puts the flag in every unit, and it
# makes a skip a refusal: a gate that would skip and exit 0 for want of a
# tool ends with 3, could not run, instead.
#
# `--change-set` is how a plan's unit hands a gate that works per changed path
# (`commits: ["CHANGES"]` in the registry) the push's ranges. It selects
# nothing, unlike `--changed-in`: the plan already chose the gate, and the
# ranges are only what the gate reads (`SCE_GATE_CHANGED_FILE`).
#
# `--unit` is how a plan's unit runs (`plan_units` puts it in every argv). The
# plan ran the registry's self-test over the same tree before it named the
# unit, and the self-test reads the whole repository (every workflow, hook and
# gate script), so a unit that ran it again would read the whole tree whatever
# its gate reads, and no narrowed key could hold it (ADR 0120, D2). For the same
# reason a unit reads none of the registry: what it asks of its gates (their
# closure and order, where each runs, a shard's variable, the submodules each
# needs) it asks `tools/git-hooks/gate_table.py`, which reads the entries of
# those gates alone ("One file per gate" there), and it leaves the drift
# report below to a run that is not a unit, since the budget it checks is a
# sum over the whole table and bx keeps a unit's timing itself.
#
# A gate that fails ends the run with the smallest command that reproduces
# each thing it found, under one heading ("What a red gate ends with" below),
# and in a hosted lane adds the same to the job's step summary.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

REGISTRY="$REPO_ROOT/tools/git-hooks/gate_registry.py"
# What this runner asks of the gates it runs, answered from their entries
# alone (`--unit` above). `-I` puts no directory on Python's path, so the
# interpreter lists neither tools/git-hooks/ nor the checkout's root.
TABLE="$REPO_ROOT/tools/git-hooks/gate_table.py"
MEASURE=0
SLUGS=()
ORDER=()
MODE=""
CHANGED_FILE=""
CHANGED_RANGES=()
CHANGE_SET_RANGES=()
PLAN=0
RUST_WANT=""
AT_WANT=""
LANDING=0
UNIT=0
SHARD_WANT=""
# What this run made and removes when it ends, whatever the end.
GATE_TEMPORARY=()
trap 'rm -rf ${GATE_TEMPORARY[@]+"${GATE_TEMPORARY[@]}"}' EXIT

while (( $# )); do
    case "$1" in
        --all)          MODE="all" ;;
        --list)         MODE="list" ;;
        --measure)      MEASURE=1 ;;
        --plan)         PLAN=1 ;;
        --landing)      LANDING=1 ;;
        --unit)         UNIT=1 ;;
        --rust)         RUST_WANT="${2:-}"; shift ;;
        --at)           AT_WANT="${2:-}"; shift ;;
        --changed-from) MODE="changed"; CHANGED_FILE="$2"; shift ;;
        --changed-in)   MODE="changed"; CHANGED_RANGES+=("$2"); shift ;;
        --change-set)   CHANGE_SET_RANGES+=("${2:-}"); shift ;;
        --shard)        SHARD_WANT="${2:-}"; shift ;;
        -h|--help)      sed -n '5,52p' "$0"; exit 0 ;;
        -*)             printf 'gate: unknown option %s\n' "$1" >&2; exit 2 ;;
        *)              SLUGS+=("$1"); MODE="${MODE:-named}" ;;
    esac
    shift
done

# A release is three numbers, the second word of `rustc --version`. Anything
# else is refused here: a channel name (`stable`, `nightly`) names no one
# compiler, and a unit's kept pass would float with it.
if [[ -n "$RUST_WANT" && ! "$RUST_WANT" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'gate: --rust takes a release such as 1.91.0, got %q\n' "$RUST_WANT" >&2
    exit 2
fi
# A plan names the release itself, from the pin; one handed in would be a
# second answer to the question the plan exists to ask once.
if (( PLAN )) && [[ -n "$RUST_WANT" ]]; then
    printf 'gate: --plan reads the Rust release itself; do not pass --rust with it\n' >&2
    exit 2
fi
if (( PLAN )) && [[ "$MODE" == "list" || $MEASURE -eq 1 ]]; then
    printf 'gate: --plan runs nothing, so it takes neither --list nor --measure\n' >&2
    exit 2
fi
# A landing changes two things, and a list does neither: which gates a change
# set or `--all` selects, and what a skip means. Named gates run what they
# name, so for them the flag says only the second; that is the form a
# landing's unit takes (`bash scripts/gate --rust R --landing <slug>`).
if (( LANDING )) && [[ "$MODE" == "list" ]]; then
    printf 'gate: --landing runs or plans gates; --list shows them and takes no landing\n' >&2
    exit 2
fi
LANDING_ARGS=()
if (( LANDING )); then
    LANDING_ARGS=(--landing)
    # A skip is not a pass in a landing: every skip site in
    # scripts/gates/lib.sh reads this and ends with 3, could not run, where it
    # would otherwise exit 0. Exported, so a gate's own sub-scripts see it.
    export SCE_GATE_LANDING=1
fi
# The set a named gate reads is not a selection, so it goes with named gates
# only; a run that selects by a change already hands its gates that change.
if (( ${#CHANGE_SET_RANGES[@]} )) && [[ $PLAN -eq 1 || "$MODE" != "named" ]]; then
    printf 'gate: --change-set hands named gates the set they read; it takes slugs, and not --plan, --all, --list or a selection by change\n' >&2
    exit 2
fi

# ── One part of a gate planned as shards ──────────────────────────────
#
# A plan runs a gate that declares `shard_env` as N units, each
# `--shard k/N <slug>` ("A gate planned as shards" in the registry). The part
# is handed to the gate in the variable its entry names, which its script
# reads; a gate that names none has no parts, and asking for one is refused
# rather than running the whole gate under a part's name.
if [[ -n "$SHARD_WANT" ]]; then
    if (( PLAN )) || [[ "$MODE" != "named" || ${#SLUGS[@]} -ne 1 ]]; then
        printf 'gate: --shard runs one part of one named gate; it takes a single slug, and not --plan, --all, --list or a selection by change\n' >&2
        exit 2
    fi
    if [[ ! "$SHARD_WANT" =~ ^([0-9]+)/([0-9]+)$ ]] \
            || (( BASH_REMATCH[1] < 1 || BASH_REMATCH[1] > BASH_REMATCH[2] )); then
        printf 'gate: --shard takes k/N with 1 <= k <= N, got %q\n' "$SHARD_WANT" >&2
        exit 2
    fi
    SHARD_ENV="$(python3 -I "$TABLE" shard-env "${SLUGS[0]}")" || exit 2
    if [[ -z "$SHARD_ENV" ]]; then
        printf 'gate: %s declares no shard_env, so it has no parts to run one of\n' "${SLUGS[0]}" >&2
        exit 2
    fi
    export "$SHARD_ENV=$SHARD_WANT"
fi

# ── The commit a plan named, and no other ──────────────────────────────
#
# A unit whose gate reads HEAD (its objects, its history, the submodule
# commits it records) carries HEAD's id, because bx keeps the unit's pass
# under a key that holds the tree and the argv but no commit. Run on another
# commit, the unit would keep a verdict about one history under the name of
# another. So it runs only where HEAD is that commit, and anywhere else ends
# with 3, "could not run": bx reads that as a unit it could not measure, never
# as a pass. A plan resolves HEAD itself, so it takes no `--at`.
if [[ -n "$AT_WANT" ]]; then
    if (( PLAN )); then
        printf 'gate: --plan reads HEAD itself; do not pass --at with it\n' >&2
        exit 2
    fi
    if [[ ! "$AT_WANT" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]; then
        printf 'gate: --at takes a full commit id, got %q\n' "$AT_WANT" >&2
        exit 2
    fi
    AT_HAVE="$(git rev-parse --verify 'HEAD^{commit}' 2>/dev/null || true)"
    if [[ "$AT_HAVE" != "$AT_WANT" ]]; then
        printf '\nERROR gate: the plan was made for commit %s and this checkout is at %s.\n' \
            "$AT_WANT" "${AT_HAVE:-no commit}" >&2
        printf 'The gate reads HEAD, so a verdict here would be about another commit;\n' >&2
        printf 'nothing runs and nothing is claimed about the tree.\n' >&2
        exit 3
    fi
fi

# ── A change set named by commits rather than by a file ────────────────
#
# `--changed-from` names a file on the machine that wrote it, so it cannot
# travel: the push hook hands its gates to a build machine through bx, and bx
# keeps a command that names a path only this machine has (`/tmp`, the home
# directory) on this machine — correctly, since the far side has no such file
# or a different one. Two commits mean the same thing everywhere the history
# went, and bx sends the history, so the set is derived where the gates run.
#
# A range that does not resolve is refused, not widened to every gate: the
# caller resolved both ends before handing them over, so a missing commit here
# means the history did not arrive, and that is the thing to report.
#
# `--change-set` ranges are resolved the same way; the two never meet, since
# `--change-set` goes only with named gates and `--changed-in` selects.
RANGE_FLAG="--changed-in"
RANGES=(${CHANGED_RANGES[@]+"${CHANGED_RANGES[@]}"})
if (( ${#CHANGE_SET_RANGES[@]} )); then
    RANGE_FLAG="--change-set"
    RANGES=("${CHANGE_SET_RANGES[@]}")
fi
if (( ${#RANGES[@]} )); then
    if [[ -n "$CHANGED_FILE" ]]; then
        printf 'gate: --changed-from and --changed-in name the change set twice; pass one\n' >&2
        exit 2
    fi
    CHANGED_FILE="$(mktemp)"
    GATE_TEMPORARY+=("$CHANGED_FILE")
    for range in "${RANGES[@]}"; do
        base="${range%%..*}"
        tip="${range#*..}"
        if [[ "$range" != *..* || -z "$base" || -z "$tip" || "$tip" == *..* ]]; then
            printf 'gate: %s takes <base>..<tip>, got %q\n' "$RANGE_FLAG" "$range" >&2
            exit 2
        fi
        for end in "$base" "$tip"; do
            if ! git cat-file -e "${end}^{commit}" 2>/dev/null; then
                printf 'gate: %s %s: %s is no commit this checkout has\n' "$RANGE_FLAG" "$range" "$end" >&2
                exit 2
            fi
        done
        git diff --name-only "$base" "$tip" >>"$CHANGED_FILE"
    done
    sort -u "$CHANGED_FILE" -o "$CHANGED_FILE"
    printf 'gate: %s changed path(s) in %s\n' \
        "$(wc -l <"$CHANGED_FILE" | tr -d ' ')" "${RANGES[*]}" >&2
fi

# ── The Rust release the gates run on ──────────────────────────────
#
# PINNED AND DECLARED, NEVER SYNCED. The release is `channel` in
# `rust-toolchain.toml`, which `SCE_RUST_RELEASE` in
# `scripts/lib/rust_toolchains.sh` reads, and bx.toml declares it to bx
# (`[platform.linux.tools.rust]` reads it from that line): provision installs
# it once per build machine at ~/.local/rust/<release>, bx checks it there, and
# a unit (`--rust <release>`) is placed only on a machine that has it. This
# runner installs nothing. Until 2026-11-10 it synced "stable" itself with
# rustup, in the account where a build machine runs the units of a set side by
# side, and rustup is not safe against that: on 2026-10-20 a build machine's
# `stable` was left with rustc and rust-std and no cargo, and a landing was
# refused over a target one unit had and another had not added yet.
#
# Which compiler a run gets:
#   a unit of a plan (`--rust <release>`)   that release at ~/.local/rust/<release>
#       and no other, since bx keeps the unit's pass under a key that holds the
#       argv, and a verdict taken on another compiler would be kept under the
#       name of this one. Where it is absent the run ends with 3, "could not
#       run", which bx reads as a unit it could not measure, never as a pass.
#   a run by hand, or in a hosted lane       the pinned release where it is
#       installed (`scripts/install_rust.sh --declared <release>` puts it there),
#       else the cargo on PATH, said by its version. A hosted lane's is its own
#       setup (`.github/actions/install-rust`, the same release, pinned in
#       rust-toolchain.toml), which this runner leaves alone; anywhere in the
#       checkout rustup's proxy runs that release too.
#
# The release's `bin/` goes first on PATH, so cargo, rustc, clippy and rustfmt
# are its own and no rustup proxy is asked which toolchain is meant. The other
# toolchains the gates use (the pinned nightly, the release each package names
# as its `rust-version`) are declared beside it and found the same way, by the
# gate that needs one (`sce_gate_require_rust` in scripts/gates/lib.sh).
# shellcheck source=lib/rust_toolchains.sh
source "$REPO_ROOT/scripts/lib/rust_toolchains.sh"
if [[ ! "$SCE_RUST_RELEASE" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'gate: rust-toolchain.toml pins %q (SCE_RUST_RELEASE), not a release on a `channel = "1.91.0"` line\n' \
        "$SCE_RUST_RELEASE" >&2
    exit 2
fi

# Puts declared release `$1` first on PATH; status 1, and PATH untouched, when it
# is not installed or its rustc is another release.
gate_use_rust() {
    local want="$1" bin got
    bin="$(sce_rust_toolchain_bin "$want")" || return 1
    got="$("$bin/rustc" --version 2>/dev/null)" || return 1
    [[ "$got" == "rustc $want "* ]] || return 1
    PATH="$bin:$PATH"
    export PATH
    printf '\ngate: %s from %s\n' "$got" "$(sce_rust_toolchain_dir "$want")" >&2
}

# The release of a run: the one a plan named, else the pin where it is
# installed, else the cargo on PATH.
gate_select_rust() {
    local version
    if [[ -n "$RUST_WANT" ]]; then
        gate_use_rust "$RUST_WANT" && return 0
        printf '\nERROR gate: the plan named Rust %s and it is not installed at %s.\n' \
            "$RUST_WANT" "$(sce_rust_toolchain_dir "$RUST_WANT")" >&2
        printf 'A build machine gets it from bx.toml (bx-provision <alias> --apply); anywhere\n' >&2
        printf 'else: scripts/install_rust.sh --declared %s\n' "$RUST_WANT" >&2
        printf 'A verdict taken on another release would be kept under the wrong key, so\n' >&2
        printf 'nothing runs here and nothing is claimed about the tree.\n' >&2
        exit 3
    fi
    gate_use_rust "$SCE_RUST_RELEASE" && return 0
    if version="$(rustc --version 2>/dev/null)" && cargo --version >/dev/null 2>&1; then
        printf '\ngate: %s, the cargo on PATH: the pinned Rust %s is not installed at %s\n' \
            "$version" "$SCE_RUST_RELEASE" "$(sce_rust_toolchain_dir "$SCE_RUST_RELEASE")" >&2
        printf '  (scripts/install_rust.sh --declared %s installs the one the build machines run)\n' \
            "$SCE_RUST_RELEASE" >&2
    else
        printf '\ngate: WARNING: no cargo on PATH and the pinned Rust %s is not installed at %s;\n  every gate that runs cargo will fail. Install it with: scripts/install_rust.sh --declared %s\n' \
            "$SCE_RUST_RELEASE" "$(sce_rust_toolchain_dir "$SCE_RUST_RELEASE")" "$SCE_RUST_RELEASE" >&2
    fi
}

# The registry decides what runs and in what order, so a broken registry is
# a silent coverage loss rather than a loud failure. Exercise its own cases
# first — it is the only thing standing between a table typo and a gate that
# quietly stops running. A unit (`--unit`) skips it: its plan ran it.
if (( ! UNIT )) && ! python3 "$REGISTRY" --self-test --repo-root "$REPO_ROOT" >/dev/null 2>&1; then
    python3 "$REGISTRY" --self-test --repo-root "$REPO_ROOT" >&2 || true
    printf '\nERROR gate: registry self-test failed — refusing to run.\n' >&2
    exit 1
fi

# ── The plan: the units bx runs for the selection, and no gate here ────
#
# The selection arrives as it does for a run, and the registry turns it into
# units (`--plan`), so the push picks the same gates whether bx carries them or
# this runner runs them in place. The release every unit runs on is the pin,
# read, so a plan needs no toolchain and names the same release on every
# machine. stdout is the plan and nothing else: every message above and below
# goes to stderr.
if (( PLAN )); then
    PLAN_ARGS=(--repo-root "$REPO_ROOT" --plan "${LANDING_ARGS[@]}")
    case "$MODE" in
        all)     PLAN_ARGS+=(--all) ;;
        changed)
            PLAN_ARGS+=(--changed-from "$CHANGED_FILE")
            # The ranges travel too: a unit whose gate reads the change set
            # carries them, since the file is this machine's alone.
            for range in ${CHANGED_RANGES[@]+"${CHANGED_RANGES[@]}"}; do
                PLAN_ARGS+=(--changed-in "$range")
            done
            ;;
        named)   PLAN_ARGS+=(--named "${SLUGS[@]}") ;;
        *)
            printf 'gate: --plan needs a selection: --all, --changed-in, --changed-from or slugs\n' >&2
            exit 2
            ;;
    esac
    PLAN_ARGS+=(--rust "$SCE_RUST_RELEASE")
    # Not `exec`: the EXIT trap owns the change-set file of `--changed-in`.
    plan_rc=0
    python3 "$REGISTRY" "${PLAN_ARGS[@]}" || plan_rc=$?
    exit "$plan_rc"
fi

case "$MODE" in
    list)
        exec python3 "$REGISTRY" --list --repo-root "$REPO_ROOT"
        ;;
    all)
        # Captured and THEN split, for the reason the `named` branch gives. A
        # full run as a landing's leaves out the gates the fleet cannot place
        # or bound (`drop_hosted_only`), the answer `--plan --all --landing`
        # gives.
        if ! ORDER_TEXT="$(python3 - "$REGISTRY" "$REPO_ROOT" "$LANDING" <<'PYEOF'
import runpy, sys
from pathlib import Path
mod = runpy.run_path(sys.argv[1])
gates = set(mod["GATES"])
if sys.argv[3] == "1":
    gates = mod["drop_hosted_only"](gates, mod["fleet_platforms"](Path(sys.argv[2])))
print("\n".join(mod["run_order"](gates)))
PYEOF
)"; then
            printf 'gate: the registry could not list every gate\n' >&2
            exit 2
        fi
        while IFS= read -r _slug; do
            [[ -n "$_slug" ]] && ORDER+=("$_slug")
        done <<<"$ORDER_TEXT"
        ;;
    changed)
        # Captured and THEN split, for the reason the `named` branch below
        # gives: `mapfile < <(cmd)` reports `mapfile`'s status, so a registry
        # that failed here left `ORDER` empty, and an empty `ORDER` is the
        # "no gate applies" exit 0 — a push told it had passed every gate
        # because the one program choosing them had died.
        if ! ORDER_TEXT="$(python3 "$REGISTRY" --repo-root "$REPO_ROOT" \
                --changed-from "$CHANGED_FILE" --explain "${LANDING_ARGS[@]}")"; then
            printf 'gate: the registry could not select gates for %s\n' "$CHANGED_FILE" >&2
            exit 2
        fi
        while IFS= read -r _slug; do
            [[ -n "$_slug" ]] && ORDER+=("$_slug")
        done <<<"$ORDER_TEXT"
        # The change set decides WHICH gates run, and until now that was all
        # it decided — a gate could not see it, so a gate whose work is
        # per-path had to do all of it or none. `mutation-rounds` is the
        # first that needs the set itself: it runs a full mutation round per
        # casefile whose declared target moved, and without the set the only
        # honest alternatives are the whole corpus or nothing.
        #
        # Exported rather than passed as an argument so that a gate which
        # does not narrow needs no signature change, and absent rather than
        # empty when there is no set: a gate must be able to tell "nothing
        # changed" from "no range was resolved", because those call for
        # opposite behaviour.
        export SCE_GATE_CHANGED_FILE="$CHANGED_FILE"
        ;;
    named)
        # Named gates still get their dependency closure and the derived
        # order — asking for `forge-cpp` alone must not run it against a
        # generator that was never built.
        #
        # ⚠ Captured into a variable and THEN split, rather than read straight
        # into `mapfile` through a process substitution. `mapfile < <(cmd)`
        # reports `mapfile`'s status, never `cmd`'s, so the resolver below
        # could refuse an unknown slug with exit 2 and leave `ORDER` empty —
        # and an empty `ORDER` is the "no gate applies" path, which exits 0.
        # Measured 2026-08-29: `scripts/gate clang-format` — a slug that does
        # not exist — printed `unknown slug(s)` on stderr and returned SUCCESS,
        # so a lane or a person asking for a gate by a name with a typo in it
        # was told the gate had passed. That is the escape hatch this
        # repository writes its gates against, in the runner that owns all of
        # them.
        if ! ORDER_TEXT="$(python3 -I "$TABLE" order "${SLUGS[@]}")"; then
            exit 2
        fi
        while IFS= read -r _slug; do
            [[ -n "$_slug" ]] && ORDER+=("$_slug")
        done <<<"$ORDER_TEXT"
        # A name the registry knows always resolves to at least itself, so an
        # empty order here is the resolver having answered nothing rather than
        # the change set having selected nothing — the one case below that
        # must NOT be read as "nothing to verify".
        if (( ${#ORDER[@]} == 0 )); then
            printf 'gate: %s resolved to no gate at all; the registry answered nothing for a name it accepted\n' \
                "${SLUGS[*]}" >&2
            exit 2
        fi
        # Named gates handed a change set (`--change-set`, a plan's unit) read
        # its paths, as the `changed` branch above hands its gates theirs.
        if (( ${#CHANGE_SET_RANGES[@]} )); then
            export SCE_GATE_CHANGED_FILE="$CHANGED_FILE"
        fi
        ;;
    *)
        printf 'gate: nothing to do — pass a slug, --all, --changed-from or --list\n' >&2
        exit 2
        ;;
esac

if (( ${#ORDER[@]} == 0 )); then
    printf 'gate: no gate applies — nothing to verify\n' >&2
    exit 0
fi

# ── Gates that run in an image ─────────────────────────────────────────
#
# A gate whose verdict is one compiler's names the Containerfile of its image
# (`container` in the registry, "Gates that run in an image"). It is never run
# on this machine: `gate_in_container` builds the image and runs this runner on
# the gate inside it, where its dependencies run too. The registry says which
# gates of this run go in and which stay (`--placement`), leaving out the
# dependencies only a gate in an image needs, so they are not built twice and
# not built here with another compiler. Inside the image (SCE_GATE_CONTAINER is
# the Containerfile it was built from) every gate runs where it is.
declare -A CONTAINER_OF=()
if [[ -z "${SCE_GATE_CONTAINER:-}" ]]; then
    if ! PLACEMENT_TEXT="$(python3 -I "$TABLE" placement "${ORDER[@]}")"; then
        printf 'gate: the registry could not say where %s run\n' "${ORDER[*]}" >&2
        exit 2
    fi
    ORDER=()
    while read -r _where _slug _containerfile; do
        [[ -z "$_slug" ]] && continue
        ORDER+=("$_slug")
        [[ "$_where" == "container" ]] && CONTAINER_OF["$_slug"]="$_containerfile"
    done <<<"$PLACEMENT_TEXT"
fi

# ── The image a gate runs in: addressed by its build context, pulled ──
#
# An image is addressed by its content (ADR 0145, D2). Its tag is the digest of
# its build context, the directory its Containerfile is in: one line per file,
# in byte order of the path, holding the SHA-256 of the file's content, whether
# it is executable and its path, and the SHA-256 of those lines. The context is
# what `docker build` sends, so a file the Containerfile copies in moves the tag
# as the Containerfile does, and a file it never reads moves it too: a tag that
# moves for nothing costs a build, one that stays while the image changes would
# name two environments. Only the executable bit of a file's mode is read,
# since a checkout's other bits follow the umask of whoever made it.
#
# The image's family is the name of that directory (`host`, `swift`), and the
# registry holds it as `$GATE_IMAGE_REGISTRY/sce-gate-<family>:<digest>`. The
# runner pulls that before it builds anything, so a machine judges a gate with
# the bytes every other machine pulled; it builds only when the registry has no
# image of the digest, which is when the change it judges moved the context. A
# run on main that built one pushes it (`SCE_GATE_IMAGE_PUSH=1`, which only the
# lane's `.github/actions/gate-image` sets, on a push to main), so the next run
# pulls. One digest is one environment: an image is never pushed under a tag
# the registry already holds.
GATE_IMAGE_REGISTRY="ghcr.io/newmassrael"

# gate_image_digest <context>: the digest that names the image built from
# directory <context>, on stdout; status 1 when the directory holds no file or
# a file of it cannot be read.
gate_image_digest() {
    local context="$1" path sum mode listing=""
    local -a paths=()
    mapfile -d '' -t paths < <(cd "$context" && LC_ALL=C find . -type f -print0 | LC_ALL=C sort -z)
    (( ${#paths[@]} > 0 )) || return 1
    for path in "${paths[@]}"; do
        sum="$(sha256sum <"$context/$path")" || return 1
        mode=-
        [[ -x "$context/$path" ]] && mode=x
        listing+="${sum%% *} $mode ${path#./}"$'\n'
    done
    sum="$(printf '%s' "$listing" | sha256sum)" || return 1
    printf '%s\n' "${sum%% *}"
}

# gate_image_pull <remote>: pull it, three tries with a growing pause between
# them. A registry that answers that it holds no such image, or will not show
# it, is answered at once (status 1): that is the answer, and asking again
# would not change it. Any other failure (the network, the registry's own
# errors) is tried again, and status 1 after the third.
gate_image_pull() {
    local remote="$1" try out pause=10
    for try in 1 2 3; do
        if out="$(docker pull --quiet "$remote" 2>&1)"; then
            printf 'gate: pulled %s\n' "$remote" >&2
            return 0
        fi
        case "$out" in
            *"manifest unknown"* | *"not found"* | *denied* | *unauthorized*)
                printf 'gate: the registry holds no %s readable here (%s)\n' "$remote" "$out" >&2
                return 1
                ;;
        esac
        printf 'gate: pulling %s failed, try %d of 3: %s\n' "$remote" "$try" "$out" >&2
        if (( try < 3 )); then
            sleep "$pause"
            pause=$(( pause * 3 ))
        fi
    done
    return 1
}

# gate_image_push <local> <remote>: push the image this run built, unless the
# registry holds the tag already (another job of the same push built the same
# digest and pushed first): a tag names one image, and the first one stays.
# Three tries. A push that fails leaves the gate's verdict alone (the image is
# what the next run would pull, not what this one judged with), and says so.
gate_image_push() {
    local local_tag="$1" remote="$2" try
    if docker manifest inspect "$remote" >/dev/null 2>&1; then
        printf 'gate: the registry holds %s already; it is not pushed again\n' "$remote" >&2
        return 0
    fi
    docker tag "$local_tag" "$remote" >&2 || return 1
    for try in 1 2 3; do
        if docker push --quiet "$remote" >&2; then
            printf 'gate: pushed %s\n' "$remote" >&2
            return 0
        fi
        if (( try < 3 )); then
            sleep $(( 10 * try ))
        fi
    done
    return 1
}

# gate_image <containerfile>: the local tag of the image the file's directory
# builds, on stdout, made present here: taken from this machine when it holds
# it, else pulled from the registry and tagged locally, else built (and pushed
# when `SCE_GATE_IMAGE_PUSH=1`). Status 3 when it can be had none of those ways.
gate_image() {
    local containerfile="$1" context family digest local_tag remote
    context="$(dirname "$REPO_ROOT/$containerfile")"
    family="$(basename "$context")"
    if ! digest="$(gate_image_digest "$context")"; then
        printf '\nERROR gate: the build context %s of %s could not be read\n' "$context" "$containerfile" >&2
        return 3
    fi
    local_tag="sce-gate-$family:$digest"
    remote="$GATE_IMAGE_REGISTRY/sce-gate-$family:$digest"
    if docker image inspect "$local_tag" >/dev/null 2>&1; then
        printf '%s\n' "$local_tag"
        return 0
    fi
    if gate_image_pull "$remote"; then
        docker tag "$remote" "$local_tag" >&2 \
            || { printf '\nERROR gate: could not tag %s as %s\n' "$remote" "$local_tag" >&2; return 3; }
        printf '%s\n' "$local_tag"
        return 0
    fi
    printf '\ngate: building %s from %s, which the registry does not hold\n' "$local_tag" "$containerfile" >&2
    docker build --tag "$local_tag" --file "$REPO_ROOT/$containerfile" "$context" >&2 \
        || { printf '\nERROR gate: the image did not build from %s\n' "$containerfile" >&2; return 3; }
    if [[ "${SCE_GATE_IMAGE_PUSH:-}" == 1 ]] && ! gate_image_push "$local_tag" "$remote"; then
        printf '\nWARNING gate: %s was built and not pushed; the next run builds it again\n' "$remote" >&2
    fi
    printf '%s\n' "$local_tag"
}

# What every run in an image is handed from this run's environment, whatever
# its gate, when it is set here:
#   BX_GRANT_CORES, BX_GRANT_MEM_MB  the share of the machine bx gave the unit,
#                         which the builds inside size their jobs by
#                         (scripts/lib/sce_build_jobs.sh).
#   SCE_GATE_NO_FAIL_FAST the runner's own switch, which a lane may set to have
#                         a suite report every failure.
#   GITHUB_ACTIONS        that this is a hosted runner, which
#                         `sce_rust_on_hosted_runner` (scripts/lib/
#                         rust_toolchains.sh) reads.
#   CI                    that this is a CI run, which tools the gates run read
#                         for themselves (npm and the Node tools of the wasm
#                         gates do), so they behave inside as on the lane.
# The compile cache's wrappers (RUSTC_WRAPPER, CMAKE_C_COMPILER_LAUNCHER,
# CMAKE_CXX_COMPILER_LAUNCHER, EM_COMPILER_WRAPPER) cross too, renamed to the
# sccache mounted inside (`RUNNER_WRAPPERS`, `gate_in_container`).
RUNNER_ENV=(BX_GRANT_CORES BX_GRANT_MEM_MB SCE_GATE_NO_FAIL_FAST GITHUB_ACTIONS CI)
RUNNER_WRAPPERS=(RUSTC_WRAPPER CMAKE_C_COMPILER_LAUNCHER CMAKE_CXX_COMPILER_LAUNCHER EM_COMPILER_WRAPPER)

# gate_in_container <slug> <containerfile>: run this runner on the gate inside
# the image the file builds, and end with its status.
#
# The checkout is mounted at its own path, and so is the repository's git
# directory when it lies outside (a worktree), so git and every absolute path
# mean inside what they mean here. The cargo cache, a home and the build
# directory (`target/`, so a generator linked against the image's libc is
# never handed to this machine or taken from it) are a cache directory of the
# image's own, kept across runs.
#
# The image carries no Rust, and nothing installs one in it: the toolchain this
# run selected (`gate_select_rust`, so the release a plan named) is mounted
# read-only where the runner inside looks for a declared release
# (`~/.local/rust/<release>` under the image's home), and its release goes in
# as `--rust`, with `--landing` and `--at`. The gate inside therefore builds
# with exactly the compiler the unit's key names. A toolchain whose release is
# no x.y.z, or that has no cargo beside its rustc, is 3, could not run.
#
# Every other Rust toolchain this machine declares (`~/.local/rust/<name>`,
# where bx and `scripts/install_rust.sh --declared` put them: the pinned
# nightly and the MSRV releases a gate may ask for) is mounted the same way,
# read-only, where the runner inside looks for it, so a gate that needs one
# finds the one this machine was provisioned with.
#
# The rev-pinned Mnemosyne builds this machine carries are handed in the same
# way, read-only, each binary where `scripts/lib/mnemosyne_pin.sh` looks under
# the image's home: their revision is the tree's (`MNEMOSYNE_REV` in
# spec-citations.yml), and the runner provisions them (bx installs them as a
# tool of bx.toml, a lane with `scripts/install_mnemosyne_cli.sh`) as it
# provisions Rust. Each binary is mounted by the file it resolves to, since bx
# links the path the pin names to its own store.
#
# Cargo's registry download is this machine's: its `registry/` and `git/`
# and the two files cargo locks them with are mounted into the image's cargo
# home, so a crate the lane's compile cache restored, or another run fetched,
# is not fetched again, and two runs that share them take the same lock. What
# cargo builds stays in the image's own `target/`.
#
# The image starts from an environment of its own, so a variable crosses into
# it only by name. What the runner and the machine set for every gate is
# `RUNNER_ENV` (below); what a lane sets for one gate is the gate's
# `container_env` (gate_table.py `container-env`); and the gate's part goes
# in as `--shard`, which the runner inside checks. Nothing else of this
# machine's environment crosses: a path in it would name this machine.
#
# The uid follows the daemon (bx's rule for containers on fleet machines,
# measured 2026-10-19): under a rootless one, uid 0 inside IS the caller and any other
# uid is one of its subordinates, to which the mounted checkout reads as
# root's, unwritable and refused by git; under a system daemon (a hosted
# runner) the caller's own uid owns what it writes. `safe.directory` would
# answer git and leave the write refused.
#
# Docker missing, or an image that can be neither pulled nor built, is 3, could
# not run: the machine cannot measure the gate, and a landing unit asks bx for
# docker so it is placed where it can. Docker's own failures (125, 126, 127)
# are 3 as well; the gate's statuses inside pass through as they are. The PATH
# inside is the image's own (its Containerfile's `ENV PATH`), which is where
# the image puts the toolchains it holds.
gate_in_container() {
    local slug="$1" containerfile="$2" tag rc=0 cache target common security
    local release sysroot wrapper="" name bin rel toolchain cargo_home lock container_env=""
    local -a user mounts inner wrapper_env=() handed=()
    if ! command -v docker >/dev/null 2>&1; then
        printf '\nERROR gate: %s runs in the image %s builds, and docker is not on PATH here.\n' \
            "$slug" "$containerfile" >&2
        return 3
    fi
    release="$(rustc --version 2>/dev/null | awk '{ print $2 }')" || release=""
    sysroot="$(rustc --print sysroot 2>/dev/null)" || sysroot=""
    if [[ ! "$release" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ || -z "$sysroot" \
            || ! -x "$sysroot/bin/cargo" || ! -x "$sysroot/bin/rustc" ]]; then
        printf '\nERROR gate: %s runs in the image %s builds, on the Rust this run selected,\n' \
            "$slug" "$containerfile" >&2
        printf 'and that is no release with cargo beside rustc (release %q, sysroot %q).\n' \
            "$release" "$sysroot" >&2
        return 3
    fi
    if [[ -n "$RUST_WANT" && "$release" != "$RUST_WANT" ]]; then
        printf '\nERROR gate: the plan named Rust %s and the rustc on PATH is %s\n' \
            "$RUST_WANT" "$release" >&2
        return 3
    fi
    tag="$(gate_image "$containerfile")" || return 3
    security="$(docker info --format '{{.SecurityOptions}}' 2>/dev/null || true)"
    if [[ "$security" == *name=rootless* ]]; then
        user=(--user 0:0)
    else
        user=(--user "$(id -u):$(id -g)")
    fi
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/sce-gate-containers/$slug"
    # The toolchain's mount point is made here, by the caller, rather than by
    # the daemon inside the image's home.
    mkdir -p "$cache/home/.local/rust/$release" "$cache/cargo" "$cache/target"
    mounts=(-v "$REPO_ROOT:$REPO_ROOT" -v "$cache:/sce-cache"
            -v "$sysroot:/sce-cache/home/.local/rust/$release:ro")
    for toolchain in "$HOME"/.local/rust/*; do
        name="$(basename "$toolchain")"
        [[ -d "$toolchain" && "$name" != "$release" ]] || continue
        mkdir -p "$cache/home/.local/rust/$name"
        mounts+=(-v "$(readlink -f "$toolchain"):/sce-cache/home/.local/rust/$name:ro")
    done
    cargo_home="${CARGO_HOME:-$HOME/.cargo}"
    for name in registry git; do
        if [[ -d "$cargo_home/$name" ]]; then
            mkdir -p "$cache/cargo/$name"
            mounts+=(-v "$cargo_home/$name:/sce-cache/cargo/$name")
        fi
    done
    if [[ -d "$cargo_home/registry" ]]; then
        for lock in .package-cache .package-cache-mutate; do
            [[ -e "$cargo_home/$lock" ]] || : >"$cargo_home/$lock"
            [[ -e "$cache/cargo/$lock" ]] || : >"$cache/cargo/$lock"
            mounts+=(-v "$cargo_home/$lock:/sce-cache/cargo/$lock")
        done
    fi
    for bin in "$HOME"/.local/share/mnemosyne-rev/*/bin/*; do
        [[ -x "$bin" ]] || continue
        rel="${bin#"$HOME"/}"
        mkdir -p "$(dirname "$cache/home/$rel")"
        [[ -e "$cache/home/$rel" ]] || : >"$cache/home/$rel"
        mounts+=(-v "$(readlink -f "$bin"):/sce-cache/home/$rel:ro")
    done
    common="$(git rev-parse --path-format=absolute --git-common-dir)"
    case "$common/" in
        "$REPO_ROOT"/*) ;;
        *) mounts+=(-v "$common:$common") ;;
    esac
    # `target` is often a link into a build cache outside the checkout: the
    # image's own cache is mounted where the link points, so the link resolves
    # to it inside. A checkout with no `target` gets the directory here, made
    # by the caller, rather than by the daemon as root.
    target="$REPO_ROOT/target"
    if [[ -L "$target" ]]; then
        target="$(readlink -m "$target")"
    else
        mkdir -p "$target"
    fi
    mounts+=(-v "$cache/target:$target")
    inner=(bash scripts/gate --rust "$release")
    # A unit's run inside reads what the unit's reads outside do: no
    # self-test, no drift report.
    if (( UNIT )); then
        inner+=(--unit)
    fi
    if (( LANDING )); then
        inner+=(--landing)
    fi
    if [[ -n "$AT_WANT" ]]; then
        inner+=(--at "$AT_WANT")
    fi
    # The ranges a unit was handed mean the same inside: the checkout and its
    # git directory are mounted at their own paths.
    for range in ${CHANGE_SET_RANGES[@]+"${CHANGE_SET_RANGES[@]}"}; do
        inner+=(--change-set "$range")
    done
    if [[ -n "$SHARD_WANT" ]]; then
        inner+=(--shard "$SHARD_WANT")
    else
        # A lane that sets the gate's shard variable itself (`<variable>: k/N`
        # in its job, as the sharded lanes do) means the same part inside the
        # image, and the image starts from an environment of its own: the part
        # goes in as `--shard`, which the runner inside checks and hands back to
        # the gate as the variable. Dropped here, every job of the lane would
        # run the whole gate under a part's name.
        local shard_env=""
        shard_env="$(python3 -I "$TABLE" shard-env "$slug")" || return 2
        if [[ -n "$shard_env" && -n "${!shard_env:-}" ]]; then
            inner+=(--shard "${!shard_env}")
        fi
    fi
    inner+=("$slug")
    # `-e NAME` with no value passes NAME only where this run has it set, so a
    # variable the lane left unset stays unset inside.
    for name in "${RUNNER_ENV[@]}"; do
        handed+=(-e "$name")
    done
    container_env="$(python3 -I "$TABLE" container-env "$slug")" || return 2
    while IFS= read -r name; do
        if [[ -n "$name" ]]; then
            handed+=(-e "$name")
        fi
    done <<<"$container_env"
    printf '\ngate: %s runs in %s (%s) on Rust %s from %s: %s\n' \
        "$slug" "$tag" "${user[*]}" "$release" "$sysroot" "${inner[*]}" >&2
    # The compile cache a CI lane compiles through
    # (.github/actions/compile-cache): sccache, named by RUSTC_WRAPPER for Rust,
    # CMAKE_C_COMPILER_LAUNCHER and CMAKE_CXX_COMPILER_LAUNCHER for CMake's C
    # and C++, and EM_COMPILER_WRAPPER for what emcc compiles. The binary is
    # static and is mounted read-only beside nothing the image holds, and each
    # of those variables the lane set names it there; the settings and the
    # cache service's address and token it reads go in with it. What it
    # answers is a compilation whose inputs, the compiler and its target among
    # them, are the image's own, and what links is linked in the image, so
    # nothing built against another libc is handed in. Its server lives in the
    # container, so its counts are printed there, after the gate and with the
    # gate's status kept.
    for name in "${RUNNER_WRAPPERS[@]}"; do
        [[ "$(basename "${!name:-}")" == sccache ]] || continue
        if [[ -z "$wrapper" ]]; then
            wrapper="$(command -v "${!name}" 2>/dev/null)" || wrapper=""
            [[ -n "$wrapper" ]] || continue
            mounts+=(-v "$wrapper:/opt/sce-sccache/sccache:ro")
            wrapper_env+=(-e SCCACHE_GHA_ENABLED -e SCCACHE_GHA_RW_MODE -e SCCACHE_IDLE_TIMEOUT
                          -e ACTIONS_RESULTS_URL -e ACTIONS_RUNTIME_TOKEN -e ACTIONS_CACHE_SERVICE_V2)
        fi
        wrapper_env+=(-e "$name=/opt/sce-sccache/sccache")
        if [[ "$name" == RUSTC_WRAPPER ]]; then
            wrapper_env+=(-e CARGO_INCREMENTAL=0)
        fi
    done
    if [[ -n "$wrapper" ]]; then
        inner=(bash -c '"$@"; rc=$?; /opt/sce-sccache/sccache --show-stats >&2; exit "$rc"' \
            gate-in-container "${inner[@]}")
    fi
    # The commands that reproduce a failure inside come back through the cache
    # directory, and are printed out here, where the step summary is.
    : >"$cache/repro.jsonl"
    docker run --rm "${user[@]}" "${mounts[@]}" -w "$REPO_ROOT" \
        -e SCE_GATE_CONTAINER="$containerfile" \
        -e SCE_GATE_REPRO_HANDOFF=/sce-cache/repro.jsonl \
        -e HOME=/sce-cache/home -e CARGO_HOME=/sce-cache/cargo \
        "${handed[@]}" \
        ${wrapper_env[@]+"${wrapper_env[@]}"} \
        "$tag" "${inner[@]}" || rc=$?
    cat "$cache/repro.jsonl" >>"$SCE_GATE_REPRO_FILE" 2>/dev/null || true
    case "$rc" in
        125|126|127)
            printf '\nERROR gate: docker could not start the image of %s (status %s)\n' "$slug" "$rc" >&2
            return 3
            ;;
    esac
    return "$rc"
}

# ── Submodule parity: a gate cannot mirror a checkout it does not have ──
#
# `git worktree add` does not populate submodules, and neither does a plain
# `git clone`. Measured 2026-08-24: a push from a fresh worktree spent every
# gate ahead of `w3c-kotlin` and then died 27 seconds into a Gradle task with
# "CMake Generate step failed", which names neither `third_party/quickjs` nor
# the one command that fixes it — so the gates ahead of it ran again from the
# start on the next push.
#
# Here rather than in each gate script, for the same reason the release is chosen
# below: a gate run by hand must get the same preconditions the hook
# gives it. WHICH gates need submodules is derived from the workflows they
# mirror, never typed — `tree-hygiene` checks out without them on purpose, so
# a blanket refusal would be wrong. See the script's header.
#
# A DRY RUN is exempt, and that is the preflight's own logic rather than an
# escape hatch: `SCE_MUTATION_ROUNDS_DRY_RUN=1` stops the gate once it has
# CHOSEN which casefiles a change reaches. Choosing reads the registry and
# builds nothing, so the checkout it has to mirror is the registry's, not the
# toolchain's. Measured 2026-08-24: `mutation_rounds_selection.rs` runs that
# selection step from inside the `tree-hygiene` job, which checks out without
# submodules on purpose — so the preflight refused a step that would not have
# touched `third_party/` either way.
if [[ -z "${SCE_MUTATION_ROUNDS_DRY_RUN:-}" ]]; then
    "$REPO_ROOT/scripts/lib/require_submodules.sh" "${ORDER[@]}"
fi

# The release the gates run on (see "The Rust release the gates run on" above):
# the one a plan named when this run is one of its units, else the pin where it
# is installed, else the cargo on PATH.
gate_select_rust

# ── The Go the gates run on ────────────────────────────────────────
#
# DECLARED, NOT FETCHED. The release is the `go` line of the Go modules, and
# bx.toml declares it to bx (`[platform.linux.tools.go]`): provision installs it
# once per build machine at ~/.local/share/go/<release>, and a unit that runs go
# is placed only where it is. Until 2026-11-19 a build machine's Go 1.22.2 reached
# 1.23.0 by GOTOOLCHAIN=auto fetching it at run time, which fails on a machine
# that cannot fetch. Chosen here, for every gate, because go is started by gates
# that never name it (the sce-build contract tests of `workspace-tests`, the Go
# casefiles of `mutation-rounds`, the regeneration `regen-reproduces` runs), as
# the Rust release is. Where it is installed its `bin/` goes first on PATH with
# GOTOOLCHAIN=local, so no gate fetches another toolchain; elsewhere the go on
# PATH runs, and the line says which (scripts/lib/go_toolchain.sh).
# shellcheck source=lib/go_toolchain.sh
source "$REPO_ROOT/scripts/lib/go_toolchain.sh"
sce_go_select gate || true

printf '\ngate: running %d gate(s): %s\n' "${#ORDER[@]}" "${ORDER[*]}" >&2

# Milliseconds since the epoch, from bash's own clock.
#
# `SECONDS` is whole seconds, and that floor was not a rounding detail — it
# was why one entry in `PACE_NORMALISED` could not be retired by measuring
# it. `http-endpoint-ssot` declared 4s to cover the process the runner starts
# around a 124ms scan, and every `--measure` run answered 0, so the
# declaration and the measurement were never comparable. A gate whose cost
# cannot be READ is one whose cost stays a chosen number for ever. With this
# clock it reads 0.185s, and the entry is gone.
#
# `EPOCHREALTIME` is bash 5's microsecond clock and needs no subprocess, so
# this costs nothing in a loop that is itself the measurement. Its separator
# follows the locale — a comma in de_DE, a dot here — so the split accepts
# both rather than trusting whichever the machine happens to use.
gate_now_ms() {
    local t=${EPOCHREALTIME} whole frac
    whole=${t%%[.,]*}
    frac=${t#*[.,]}
    frac="${frac}000"
    printf '%s%s\n' "$whole" "${frac:0:3}"
}

# Milliseconds as seconds, the unit `cost_s` is written in.
gate_ms_as_s() { printf '%d.%03d\n' $(( $1 / 1000 )) $(( $1 % 1000 )); }

# ── What a red gate ends with ──────────────────────────────────────────
#
# The smallest command that reproduces each thing the gate found, from the root
# of a clean checkout, under the one heading scripts/lib/repro.py writes: the
# one test (`cargo test -p <pkg> --test <target> -- <name> --exact`), the one
# ctest case after building just what it runs, the one go, pytest, Gradle or
# Swift test, the one W3C case, the one mutation case, the one output ninja
# could not make, the declared tree whose files a regeneration changed. Each
# gate records them as its commands fail (`sce_gate_tested` in
# scripts/gates/lib.sh) into the file this runner hands it, and the whole gate
# (or the shard of it that ran) is named last. Measured 2026-11-25: a red shard
# of `workspace-tests` said "run just this one with: scripts/gate
# workspace-tests", 1363 seconds of suite, where one test had failed (job
# 138951650414).
#
# In a hosted lane the same goes into the job's step summary, from here, so no
# workflow carries a step for it. A gate run in an image hands its commands
# back out (`gate_in_container`); the run inside prints nothing of its own.
GATE_REPRO_DIR="$(mktemp -d)"
GATE_TEMPORARY+=("$GATE_REPRO_DIR")

# gate_repro_report <slug>: the heading, the commands the gate recorded and the
# whole gate.
gate_repro_report() {
    local slug="$1" part="$SHARD_WANT" variable=""
    local -a whole=(scripts/gate) args=()
    # A lane runs one shard by its variable rather than `--shard`; the shard is
    # what reruns it.
    if [[ -z "$part" ]]; then
        variable="$(python3 -I "$TABLE" shard-env "$slug" 2>/dev/null || true)"
        if [[ -n "$variable" && -n "${!variable:-}" ]]; then
            part="${!variable}"
        fi
    fi
    if [[ -n "$part" ]]; then
        whole+=(--shard "$part")
    fi
    whole+=("$slug")
    if [[ -n "${SCE_GATE_REPRO_HANDOFF:-}" ]]; then
        cat "$SCE_GATE_REPRO_FILE" >>"$SCE_GATE_REPRO_HANDOFF" 2>/dev/null || true
        return 0
    fi
    args=(report --slug "$slug" --file "$SCE_GATE_REPRO_FILE" --fallback "${whole[*]}")
    if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
        args+=(--summary "$GITHUB_STEP_SUMMARY")
    fi
    if [[ -n "${CONTAINER_OF[$slug]:-}" ]]; then
        args+=(--note "$slug runs in the image ${CONTAINER_OF[$slug]} builds, and so does each command above: scripts/gate $slug builds the image and runs there")
    fi
    if ! python3 -I "$REPO_ROOT/scripts/lib/repro.py" "${args[@]}"; then
        printf '\n==> reproduce gate[%s]\n  the whole gate: %s\n' "$slug" "${whole[*]}" >&2
    fi
    return 0
}

declare -A ELAPSED=()
for slug in "${ORDER[@]}"; do
    [[ -n "$slug" ]] || continue
    script="$REPO_ROOT/scripts/gates/${slug}.sh"
    [[ -x "$script" ]] || { printf '\nERROR gate: %s is not executable\n' "$script" >&2; exit 1; }
    printf '\n==> gate[%s]\n' "$slug" >&2
    export SCE_GATE_REPRO_FILE="$GATE_REPRO_DIR/$slug.jsonl"
    : >"$SCE_GATE_REPRO_FILE"
    start_ms=$(gate_now_ms)
    if [[ -n "${CONTAINER_OF[$slug]:-}" ]]; then
        gate_cmd=(gate_in_container "$slug" "${CONTAINER_OF[$slug]}")
    else
        gate_cmd=(bash "$script")
    fi
    "${gate_cmd[@]}" || {
        rc=$?
        # Exit 3 is `sce_gate_cannot_run`: the gate's own tooling is missing,
        # not the tree it judges. Still a failure — a machine that cannot run a
        # gate has not passed it — but saying "FAILED" for it sends the reader
        # looking for a defect in their own changes, which is the whole reason
        # the status is distinct.
        if (( rc == 3 )); then
            printf '\nERROR gate: %s COULD NOT RUN — its own inputs are missing (see above). Nothing is claimed about the tree.\n' \
                "$slug" >&2
        else
            printf '\nERROR gate: %s FAILED — the commands that reproduce what it found end this run\n' \
                "$slug" >&2
        fi
        # WHAT DID NOT RUN, by name. The runner stops at the first failure, so
        # every gate after this one is UNRUN — and saying nothing about them
        # reads as "they passed". Measured 2026-08-16: a batch of six was read
        # as covering all six when its third gate failed, and `embed-vendor`,
        # two positions later, never executed; the manifest drift it exists to
        # catch surfaced at `git push` instead, after the whole selected set
        # had to run again from the start. The remedy is the one this
        # repository applies elsewhere — make the silence say something —
        # rather than a flag that keeps going past a red.
        unrun=()
        reached_failure=0
        for other in "${ORDER[@]}"; do
            [[ -n "$other" ]] || continue
            if (( reached_failure )); then
                unrun+=("$other")
            elif [[ "$other" == "$slug" ]]; then
                reached_failure=1
            fi
        done
        if (( ${#unrun[@]} > 0 )); then
            printf 'gate: %d gate(s) after it did NOT run, so nothing is claimed about them: %s\n' \
                "${#unrun[@]}" "${unrun[*]}" >&2
        fi
        if (( rc != 3 )); then
            gate_repro_report "$slug" >&2
        fi
        exit "$rc"
    }
    ELAPSED["$slug"]=$(gate_ms_as_s $(( $(gate_now_ms) - start_ms )))
done

if (( MEASURE )); then
    printf '\ngate: measured wall clock (put these in gate_registry.py cost_s)\n' >&2
    for slug in "${ORDER[@]}"; do
        [[ -n "$slug" ]] || continue
        printf '    "%s": %s,\n' "$slug" "${ELAPSED[$slug]}" >&2
    done
fi

# Every run is a measurement, so every run can say whether the declared costs
# still describe the gates. `cost_s` is updated by hand and nothing noticed
# when a value went stale: the gates all passed, and the number was quietly
# wrong. The registry's own order case cannot catch it (it derives the order
# from the costs and checks it against the costs); this compares the
# declarations against what actually happened.
#
# The verdict used to be discarded here — `|| true` — and that is exactly how
# `tree-hygiene` came to be declared 13s while running 193s in every push for
# weeks. Every one of those pushes had the measurement in hand and threw it
# away, which is the defect `no_gate_discards_the_output_of_a_build_it_runs`
# forbids one line at a time and this line did wholesale.
#
# What propagates now is narrow. Ordering drift stays a report: a slow machine
# reorders gates and that is no reason to refuse a push. A BUDGET breach is a
# claim about the table rather than the machine — the registry divides out
# this run's own pace before making it — and that fails, because a ceiling
# checked against a stale number is not a ceiling.
#
# A unit (`--unit`) makes no report: the budget is a sum over every gate's
# declared cost, a claim about the table that no unit's verdict rests on, and
# making it would read the whole table into the unit's run.
DRIFT_ARGS=()
for slug in "${ORDER[@]}"; do
    [[ -n "$slug" ]] || continue
    DRIFT_ARGS+=("${slug}=${ELAPSED[$slug]}")
done
drift_rc=0
if (( ! UNIT && ${#DRIFT_ARGS[@]} > 1 )); then
    python3 "$REGISTRY" --repo-root "$REPO_ROOT" \
        --order-drift "${DRIFT_ARGS[@]}" || drift_rc=$?
fi

if (( drift_rc != 0 )); then
    printf '\ngate: %d gate(s) passed, but the push budget above is breached.\n' \
        "${#ORDER[@]}" >&2
    exit "$drift_rc"
fi

printf '\ngate: %d gate(s) passed.\n' "${#ORDER[@]}" >&2
