#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-2.1-or-later WITH LicenseRef-SCE-Linking-Exception OR LicenseRef-SCE-Commercial
# SPDX-FileCopyrightText: Copyright (c) 2026 newmassrael
#
# Mutation harness — run a test set against deliberately broken source and
# require it to notice.
#
# A test that passes proves nothing about whether it *could* fail. The way
# to find out is to break the code it guards and watch it turn red. That
# procedure has two failure modes of its own, and both of them look exactly
# like a passing mutation round, which is why they are worth a tool rather
# than a habit:
#
#   1. **The mutation never reached the binary that ran.** Restoring a file
#      with `cp -a` preserves its mtime, so cargo's fingerprint can conclude
#      nothing changed and re-run the binary it already had. The author
#      reads "0 failures" as "the mutation survived" when the truth is that
#      the mutated source was never compiled. This harness does not consult
#      mtime at all: it hashes every test executable before and after, and a
#      mutation that leaves every hash unchanged is reported INCONCLUSIVE,
#      not SURVIVED.
#
#   2. **The run selected a different set of tests.** `cargo test --test X
#      --lib FILTER` applies FILTER to every binary, so the integration
#      binary can run zero tests while its summary still prints `ok`. This
#      harness resolves the test executables once with `--no-run` and then
#      runs each binary directly with no shared filter, and it records how
#      many tests each one ran in the baseline. A case whose run count
#      differs from the baseline is INCONCLUSIVE.
#
# Both checks answer the same question — *did I actually test what I think I
# tested* — and both are hard errors, because a mutation round that cannot
# answer it is worth less than no mutation round at all: it produces a
# confident claim from no evidence.
#
# Usage:
#
#     scripts/mutate [--check] <casefile>
#
# The casefile is sourced by this script. It declares the selector for the
# tests under study, the files a case may edit, and one `case` block per
# mutation:
#
#     mutation_tests -p sce-build --features cli --test scxml_exhaustiveness
#     mutation_targets sce-build/src/parser.rs
#
# A suite this repository runs through ctest is declared instead with
# `mutation_ctest`, whose arguments are a ctest selector and must include
# `--test-dir` so the harness knows which tree to rebuild:
#
#     mutation_ctest --test-dir build -R '^SceKindRouting'
#     mutation_targets sce/src/parser/SCXMLParser.cpp
#
# ── Where this runs, and why that is a decision ────────────────────
#
# Locally, always. This script calls `cargo`, `cmake` and `ctest` directly and
# never goes through `~/.claude/remote-build/bin/bx`, so no placement decision
# is made for it — which is worth saying out loud, because a mutation round is
# a full rebuild plus a suite run and is among the heaviest things this
# repository does.
#
# Local is nevertheless the right answer, for reasons that are properties of
# the harness rather than of any machine:
#   - it needs the CONFIGURED build tree, and `build/` is excluded from the
#     transfer that populates a build machine;
#   - it EDITS FILES IN PLACE and owns restoring them. Splitting the tree from
#     the restore is how a mutation survives a round — this harness was fixed
#     once for exactly that (`mutation_harness_did_not_own_its_restore`);
#   - a round is edit → rebuild → run → restore, repeated per case, so the
#     transfer would be paid on every case rather than once.
#
# Stated here so it stays a decision. The failure mode it guards against is
# the ordinary one: a choice nothing writes down is never re-examined, which
# is the same reason `bx --local` now demands a sentence.
#
# The two runners are not two procedures. Both answers this harness exists to
# give — did the mutation reach what ran, and did the same tests run — are
# asked of every runner, from the same three operations: resolve the artifacts
# a run will execute, rebuild and hash them, run them and report how many
# tests ran and how many failed. Only those three differ between cargo and
# ctest; every verdict below is computed identically for both.
#
# `mutation_targets` names files COMPILED INTO the tests. A file the tests
# instead READ AT RUN TIME — a gate script a test executes, a fixture it
# loads — goes in `mutation_runtime_targets`, because check 1 above is
# answered differently for it: a script is read fresh on every run, so its
# test binaries are unchanged by definition and demanding a changed binary
# would call every such case INCONCLUSIVE. The evidence there is that the
# file on disk differed from the baseline while the tests ran.
#
#     mutation_case "parser accepts a wildcard token" <<'PY'
#     edit("sce-build/src/parser.rs",
#          "if tok == \"*\" ||",
#          "if false && tok == \"*\" ||")
#     PY
#
# A case body is Python, with one helper in scope:
#
#     edit(path, old, new)   # replaces the first occurrence; raises if
#                            # `old` is absent, so a mutation that no longer
#                            # matches the source fails loudly instead of
#                            # applying nothing and reading as SURVIVED.
#
# Exit status is 0 only when every case was CAUGHT.
#
# ── `--check`: is this casefile still alive? ───────────────────────
#
#     scripts/mutate --check <casefile>
#
# Applies every case and restores it, without building or running anything.
# It answers the cheap half of the question a full round asks — *does this
# case still say what it was written to say* — in milliseconds rather than a
# rebuild per case.
#
# It exists because a casefile is source that nothing compiles. Each case is
# written against an anchor in a file that goes on changing, and when the
# anchor moves the case stops applying. The harness says so, honestly and
# loudly — to whoever happens to run it by hand, which between two commits is
# nobody. `parallel_microstep_owns_exit_and_entry.cases` stood in the debt
# registry as CAUGHT 1/1 while it was in fact INCONCLUSIVE, and the only
# reason that surfaced is that someone went back and ran it.
#
# So this is the mode a gate can afford over the whole corpus on every push:
# `scripts/gates/mutation-cases.sh` runs it for every casefile under its own
# floors, and `sce-build/tests/mutation_case_liveness.rs` proves it can fail
# — one fixture per shape it refuses.
#
# What it cannot answer is what only a build can: whether the mutated tree
# still COMPILES, and whether the suite still turns red. Those stay with the
# full round, which is why this mode reports "applies" and never "CAUGHT" —
# a check that cannot see a test result must not print a word that names one.

set -euo pipefail

SCE_REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$SCE_REPO_ROOT"

# The two parsers that read a test runner's output for the names of what
# turned red. Kept in their own file so they can be exercised against
# captured output without a mutation round — see
# `sce-build/tests/mutation_case_liveness.rs`.
# shellcheck source=scripts/lib/mutation_failures.sh
source "$SCE_REPO_ROOT/scripts/lib/mutation_failures.sh"

WORK="$(mktemp -d)"
trap 'mutation_restore_quiet; rm -rf "$WORK"' EXIT

MUTATION_RUNNER=""
MUTATION_RUNNER_ARGS=()
MUTATION_BUILD_DIR=""
MUTATION_TARGET_FILES=()
MUTATION_RUNTIME_FILES=()
MUTATION_ARTIFACTS=()
# Which tests turned red on the last run, one name per line.
#
# A verdict used to be a count and nothing else, so `CAUGHT (1/287 red)`
# left the author to work out which assertion had earned it. The parallel
# round needed exactly that attribution and got it by re-running the whole
# harness under `GTEST_FILTER=<suite>` — a workaround for a fact the runner
# already had in front of it and threw away.
MUTATION_FAILING="$WORK/failing.txt"
MUTATION_CAUGHT=0
MUTATION_SURVIVED=0
MUTATION_INCONCLUSIVE=0
# `run` (the default) or `check`. Set once by the driver, read by the two
# places whose work differs: what the baseline has to establish, and how far
# a case is taken before its verdict.
MUTATION_MODE=run

# Colour only for a terminal. A gate reads this output rather than watching
# it, and an escape sequence in front of every verdict makes `^applies` match
# nothing — which is how the first run of `scripts/gates/mutation-cases.sh`
# counted zero cases across a corpus that had just reported 124.
if [[ -t 1 ]]; then
    red()   { printf '\033[31m%s\033[0m\n' "$*"; }
    green() { printf '\033[32m%s\033[0m\n' "$*"; }
    dim()   { printf '\033[2m%s\033[0m\n' "$*"; }
else
    red()   { printf '%s\n' "$*"; }
    green() { printf '%s\n' "$*"; }
    dim()   { printf '%s\n' "$*"; }
fi

# ── Casefile vocabulary ────────────────────────────────────────────

# Declare which runner drives the tests, and with what selector. A casefile
# names exactly one: two would leave the verdicts below describing two
# different suites under one label.
mutation_declare_runner() {
    local runner="$1"
    shift
    if [[ -n "$MUTATION_RUNNER" && "$MUTATION_RUNNER" != "$runner" ]]; then
        red "the casefile declared both mutation_${MUTATION_RUNNER} and mutation_${runner}"
        red "— one casefile studies one suite, or the verdicts name neither"
        exit 2
    fi
    MUTATION_RUNNER="$runner"
    MUTATION_RUNNER_ARGS=("$@")
}

# Cargo selector for the tests under study. Passed to `cargo test`
# verbatim. Give it target selectors (`--test`, `--lib`, `-p`), never a
# bare filter argument — a filter reaches every binary the selector
# matched, which is failure mode 2 above.
mutation_tests() { mutation_declare_runner cargo "$@"; }

# ctest selector for the tests under study, passed to `ctest` verbatim by
# both the resolve step and the run step, so the two cannot describe
# different sets. It must carry `--test-dir <dir>`: that directory is the
# tree the harness rebuilds between cases, and guessing it from the
# repository layout would be a second answer to a question the selector
# already contains.
mutation_ctest() { mutation_declare_runner ctest "$@"; }

# Files a case is allowed to edit, COMPILED INTO the tests. Snapshotted at
# init and restored after every case, so a case body never has to clean up
# after itself and a case that dies mid-edit cannot leave the tree broken
# for the next one.
#
# Accumulates rather than replaces. A casefile whose cases reach into several
# files spells one declaration per line as readily as one line of many, and
# replacing on the second call silently narrowed the snapshot to the last line
# — leaving the earlier files edited, unrestored, and reported as though the
# case body had changed nothing.
mutation_targets() { MUTATION_TARGET_FILES+=("$@"); }

# Files a case is allowed to edit that the tests READ AT RUN TIME — a shell
# script a test executes, a fixture a test loads — rather than link into a
# binary.
#
# They need their own list because failure mode 1 is detected differently for
# them, not because they are edited differently. For a compiled target the
# evidence that a mutation reached the code that ran is a CHANGED test binary:
# an unchanged one means cargo re-ran the artifact it already had. A script is
# read fresh on every execution, so its binaries are unchanged by definition,
# and demanding a changed binary would report every such case INCONCLUSIVE —
# a harness that cannot answer its own question for this kind of target.
# The evidence here is that the file on disk differed from the baseline while
# the tests ran, which is checked below and is the same question asked of the
# artifact that actually decides the behaviour.
#
# Declaring one in the wrong list is caught rather than believed: a case that
# edits a compiled target is still held to the changed-binary rule, whichever
# list named the file.
mutation_runtime_targets() { MUTATION_RUNTIME_FILES+=("$@"); }

# ── Internals ──────────────────────────────────────────────────────

# Every file a case may edit, of either kind.
# Every path exactly once, first mention winning. The casefile is sourced on
# both passes, so an accumulating declaration is seen twice; and a casefile may
# name the same file in two declarations for its own reasons. Neither should
# reach the snapshot, the restore, or — above all — the hash list the restore
# is checked against, where a repeated path makes the baseline and the
# post-restore reading disagree over files that are in fact identical.
mutation_all_targets() {
    printf '%s\n' ${MUTATION_TARGET_FILES[@]+"${MUTATION_TARGET_FILES[@]}"} \
                  ${MUTATION_RUNTIME_FILES[@]+"${MUTATION_RUNTIME_FILES[@]}"} |
        awk 'NF && !seen[$0]++'
}

# The compiled targets alone, under the same rule and for the same reason.
#
# The de-duplication above was applied to the combined list and not to this
# one, and the omission was not cosmetic: the baseline is taken between the
# two passes, so it saw one copy of each declaration while every case saw
# two. The two readings then differed for reasons that had nothing to do
# with the mutation, and the "did the mutation reach a compiled target"
# test below read that difference as yes. Any case whose mutation
# legitimately leaves the test binaries alone — which is precisely what a
# `mutation_runtime_targets` case is — was therefore reported
# INCONCLUSIVE with its real verdict discarded.
mutation_compiled_targets() {
    printf '%s\n' ${MUTATION_TARGET_FILES[@]+"${MUTATION_TARGET_FILES[@]}"} |
        awk 'NF && !seen[$0]++'
}

# "<sha> <path>" for each path read on stdin, in the order given. Reads a
# stream rather than taking arguments so a path is a path — splitting a
# command substitution on whitespace would break the first one containing a
# space.
mutation_hash_stream() {
    local f
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        printf '%s %s\n' "$(sha256sum "$f" | cut -d' ' -f1)" "$f"
    done
}

# Over every target of either kind, and over the compiled ones alone. Both
# read a de-duplicated list, so the two readings a verdict compares can
# only differ because a file's contents did.
mutation_all_target_hashes() { mutation_all_targets | mutation_hash_stream; }
mutation_compiled_target_hashes() { mutation_compiled_targets | mutation_hash_stream; }

mutation_snapshot() {
    mkdir -p "$WORK/snapshot"
    local f
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        mkdir -p "$WORK/snapshot/$(dirname "$f")"
        # Deliberately not `cp -a`: preserving mtime is what lets a later
        # rebuild be skipped. The hash check below would catch that, but
        # there is no reason to create the condition in the first place.
        cp "$f" "$WORK/snapshot/$f"
    done < <(mutation_all_targets)
}

mutation_restore() {
    local f
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        # Into the existing file, so its mode survives: a gate script restored
        # without its executable bit would fail every later case for a reason
        # that has nothing to do with the mutation.
        cp "$WORK/snapshot/$f" "$f"
        touch "$f"
    done < <(mutation_all_targets)
}

mutation_restore_quiet() {
    [[ -d "$WORK/snapshot" ]] || return 0
    mutation_restore 2>/dev/null || true
}

# ── Runner interface ───────────────────────────────────────────────
#
# Three operations, one implementation per runner. Everything that decides a
# verdict is written once, against these:
#
#   mutation_resolve_artifacts   populate MUTATION_ARTIFACTS with the files a
#                                run executes, resolved ONCE so no later
#                                argument can narrow the set
#   mutation_build_and_hash      rebuild, then print "<sha> <path>" per
#                                artifact — evidence about what will run,
#                                which mtime and fingerprint logs only proxy
#   mutation_run_artifacts       run them; print "<tests_run> <tests_failed>"

mutation_resolve_artifacts() { "mutation_${MUTATION_RUNNER}_resolve"; }
mutation_build_and_hash() { "mutation_${MUTATION_RUNNER}_build_and_hash"; }
mutation_run_artifacts() { "mutation_${MUTATION_RUNNER}_run"; }

# Resolve the test executables the selector names. Doing this once, and
# then running the binaries directly, is what removes the shared-filter
# hazard: there is no argument left that could narrow one binary's run.
mutation_cargo_resolve() {
    local json
    json="$(cargo test --no-run --message-format=json "${MUTATION_RUNNER_ARGS[@]}" 2>/dev/null)" || {
        red "build failed while resolving test executables"
        cargo test --no-run "${MUTATION_RUNNER_ARGS[@]}" 2>&1 | tail -30
        exit 2
    }
    mapfile -t MUTATION_ARTIFACTS < <(printf '%s\n' "$json" | python3 -c '
import json, sys
for line in sys.stdin:
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        rec = json.loads(line)
    except ValueError:
        continue
    if rec.get("reason") == "compiler-artifact" and rec.get("executable") and rec.get("profile", {}).get("test"):
        print(rec["executable"])
')
    if [[ ${#MUTATION_ARTIFACTS[@]} -eq 0 ]]; then
        red "the selector matched no test executables: ${MUTATION_RUNNER_ARGS[*]}"
        exit 2
    fi
}

# Rebuild, then report "<sha> <path>" per executable. The hash is the whole
# point: it is evidence about the artifact that will actually run, which
# mtime, cargo's fingerprint log, and the source on disk are all merely
# proxies for.
mutation_cargo_build_and_hash() {
    cargo test --no-run "${MUTATION_RUNNER_ARGS[@]}" >/dev/null 2>&1 || return 1
    mutation_hash_artifacts
}

# "<sha> <path>" per resolved artifact, in resolution order. Shared by the
# runners because the evidence is the same evidence.
mutation_hash_artifacts() {
    local artifact
    for artifact in "${MUTATION_ARTIFACTS[@]}"; do
        printf '%s %s\n' "$(sha256sum "$artifact" | cut -d' ' -f1)" "$artifact"
    done
}

# Run every executable; print "<tests_run> <failed>" totalled across them.
mutation_cargo_run() {
    local exe out run failed total_run=0 total_failed=0
    : > "$MUTATION_FAILING"
    for exe in "${MUTATION_ARTIFACTS[@]}"; do
        out="$("$exe" 2>&1 || true)"
        run="$(printf '%s\n' "$out" | sed -n 's/^running \([0-9]*\) test.*/\1/p' | awk '{s+=$1} END {print s+0}')"
        failed="$(printf '%s\n' "$out" | sed -n 's/.*[0-9]* passed; \([0-9]*\) failed.*/\1/p' | awk '{s+=$1} END {print s+0}')"
        printf '%s\n' "$out" | mutation_failures_from_cargo >> "$MUTATION_FAILING"
        total_run=$((total_run + ${run:-0}))
        total_failed=$((total_failed + ${failed:-0}))
    done
    printf '%s %s\n' "$total_run" "$total_failed"
}

# The build tree the ctest selector names, read out of the selector itself
# so the tree that gets rebuilt is the tree that gets run.
mutation_ctest_build_dir() {
    local i
    for ((i = 0; i < ${#MUTATION_RUNNER_ARGS[@]}; i++)); do
        case "${MUTATION_RUNNER_ARGS[i]}" in
            --test-dir) printf '%s\n' "${MUTATION_RUNNER_ARGS[i + 1]:-}"; return 0 ;;
            --test-dir=*) printf '%s\n' "${MUTATION_RUNNER_ARGS[i]#--test-dir=}"; return 0 ;;
        esac
    done
    return 1
}

# Every file this repository owns that a registered test command names.
#
# `command[0]` alone is not the artifact set: a case can be `bash <script>`
# or a driver invoked with per-case arguments, and hashing the interpreter
# would report an unchanged system binary as evidence that a mutation did
# not land. Paths outside the repository are dropped for the same reason —
# a mutation here cannot change them, so they can only dilute the check.
mutation_ctest_resolve() {
    local build_dir json
    build_dir="$(mutation_ctest_build_dir)" || {
        red "mutation_ctest needs --test-dir <dir>: it names the tree to rebuild"
        exit 2
    }
    MUTATION_BUILD_DIR="$build_dir"
    json="$(ctest "${MUTATION_RUNNER_ARGS[@]}" --show-only=json-v1 2>/dev/null)" || {
        red "ctest could not enumerate the suite: ${MUTATION_RUNNER_ARGS[*]}"
        ctest "${MUTATION_RUNNER_ARGS[@]}" --show-only=json-v1 2>&1 | tail -20
        exit 2
    }
    mapfile -t MUTATION_ARTIFACTS < <(printf '%s\n' "$json" | python3 -c '
import json, os, sys

repo = os.path.realpath(sys.argv[1])
seen = []
for test in json.load(sys.stdin).get("tests", []):
    for token in test.get("command") or []:
        path = os.path.realpath(token)
        if not os.path.isfile(path):
            continue
        if os.path.commonpath([repo, path]) != repo:
            continue
        if path not in seen:
            seen.append(path)
for path in sorted(seen):
    print(path)
' "$SCE_REPO_ROOT")
    if [[ ${#MUTATION_ARTIFACTS[@]} -eq 0 ]]; then
        red "the selector matched no in-repository test artifacts: ${MUTATION_RUNNER_ARGS[*]}"
        exit 2
    fi
}

# The default target, not the artifact list. A test whose executable this
# harness resolved is not the only thing a mutation can break: a source it
# links reaches other targets too, and building only the resolved set would
# leave the tree half-rebuilt and the next case measuring a mixture. This is
# the same reasoning `scripts/gates/cpp-suite.sh` states for not naming
# targets.
mutation_ctest_build_and_hash() {
    cmake --build "$MUTATION_BUILD_DIR" --parallel "$(nproc)" >/dev/null 2>&1 || return 1
    mutation_hash_artifacts
}

# One ctest run over the declared selector; "<tests_run> <failed>" read from
# the JUnit report it writes. `--no-tests=error` is what keeps an empty run
# from reporting as a green one.
#
# The report rather than the console summary, because that summary is not one
# sentence: an all-passing run prints "100% tests passed out of 2" and a
# failing one "50% tests passed, 1 tests failed out of 2". A parser written
# against either form reads the other as zero tests — which is how the first
# ctest round here ended, saved only by the guard that refuses a baseline of
# zero. The counts are attributes of a machine-readable document instead, and
# skipped cases are subtracted because a case that did not run is not one
# this harness can claim anything about.
mutation_ctest_run() {
    local report="$WORK/ctest-junit.xml" console="$WORK/ctest-console.txt"
    rm -f "$report"
    : > "$MUTATION_FAILING"
    # Kept rather than discarded, because it carries the only naming of what
    # went red that is finer than a ctest entry: one entry here is a binary
    # holding hundreds of assertions.
    # `--output-on-failure` is what puts gtest's own verdict lines in reach:
    # without it ctest prints only its per-entry pass/fail, so a red round
    # over a binary holding hundreds of assertions could be attributed no
    # further than the binary's name. Measured — the first C++ round under
    # this harness reported `red: IntegrationTests` and nothing finer.
    ctest "${MUTATION_RUNNER_ARGS[@]}" --no-tests=error -j "$(nproc)" \
        --output-on-failure --output-junit "$report" >"$console" 2>&1 || true
    mutation_failures_from_gtest < "$console" > "$MUTATION_FAILING"
    if [[ ! -f "$report" ]]; then
        printf '0 0\n'
        return
    fi
    python3 - "$report" "$MUTATION_FAILING" <<'PY'
import sys
import xml.etree.ElementTree as ET

root = ET.parse(sys.argv[1]).getroot()
suites = [root] if root.tag == "testsuite" else root.iter("testsuite")
run = failed = 0
red = []
for suite in suites:
    total = int(suite.get("tests", 0))
    skipped = int(suite.get("skipped", 0))
    disabled = int(suite.get("disabled", 0))
    run += total - skipped - disabled
    failed += int(suite.get("failures", 0)) + int(suite.get("errors", 0))
    for case in suite.iter("testcase"):
        if case.find("failure") is not None or case.find("error") is not None:
            red.append(case.get("name", "?"))

# The ctest-level names are the fallback, not the answer: they are what a
# non-gtest runner leaves behind. A binary that named its own failures above
# has already said something more useful, so this only writes when that came
# back empty.
names = sys.argv[2]
if red and not open(names).read().strip():
    with open(names, "w") as fh:
        fh.write("\n".join(red) + "\n")
print(f"{run} {failed}")
PY
}

# ── Cheap liveness ─────────────────────────────────────────────────
#
# What `--check` asks of a casefile beyond applying its cases. Everything
# here reads manifests and enumerates; nothing compiles, which is what makes
# the mode affordable over the whole corpus on every push.

# Every declared file is still there. A target that was renamed or deleted
# takes every case in the file with it, and the failure a full round gives
# for it — `sha256sum: No such file` from inside the snapshot — names
# neither the casefile nor the declaration that went stale.
mutation_check_targets_exist() {
    local missing=0 f
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        [[ -e "$f" ]] && continue
        red "declared target does not exist: $f"
        missing=$((missing + 1))
    done < <(mutation_all_targets)
    (( missing == 0 ))
}

mutation_check_selector() { "mutation_${MUTATION_RUNNER}_check_selector"; }

# The cargo selector still names a package that exists, features that
# package declares, and test targets it has. `cargo metadata` reads the
# manifests and compiles nothing, so this is the part of the runner
# question a cheap mode can answer. The expensive part — do those targets
# still BUILD — is `mutation_cargo_resolve`'s, in the full round.
mutation_cargo_check_selector() {
    # Into a file rather than down a pipe: the script itself arrives on
    # stdin as a heredoc, so a piped payload would be swallowed by it and
    # the reader would get an empty document. Measured the moment this was
    # first run.
    local meta="$WORK/cargo-metadata.json"
    cargo metadata --no-deps --format-version 1 >"$meta" 2>/dev/null || {
        red "cargo metadata failed — the selector cannot be checked"
        return 1
    }
    python3 - "$meta" "${MUTATION_RUNNER_ARGS[@]}" <<'PY'
import json
import sys

args = sys.argv[2:]
meta = json.load(open(sys.argv[1]))

named_pkgs, wanted_tests, wanted_features = [], [], []
want_lib = False
i = 0
while i < len(args):
    a = args[i]
    if a in ("-p", "--package") and i + 1 < len(args):
        named_pkgs.append(args[i + 1]); i += 2; continue
    if a == "--test" and i + 1 < len(args):
        wanted_tests.append(args[i + 1]); i += 2; continue
    if a == "--features" and i + 1 < len(args):
        wanted_features += [f for f in args[i + 1].replace(",", " ").split() if f]
        i += 2; continue
    if a == "--lib":
        want_lib = True
    i += 1

packages = {p["name"]: p for p in meta["packages"]}
problems = []
for name in named_pkgs:
    if name not in packages:
        problems.append("no package named %r in this workspace" % name)

# A selector with no `-p` reaches the whole workspace, so the targets it
# names may live in any member. Scoping to the named packages when there
# are any is what makes a renamed test in the RIGHT package a failure
# rather than a pass because some other member happens to have that name.
scope = [packages[n] for n in named_pkgs if n in packages] or list(packages.values())

for test in wanted_tests:
    if not any(t["name"] == test and "test" in t["kind"]
               for p in scope for t in p["targets"]):
        problems.append(
            "--test %s names no test target in %s"
            % (test, ", ".join(sorted(p["name"] for p in scope))))

# `--lib` selects whatever library target a package has, and cargo reports
# that target under its crate type rather than under the word "lib" — this
# workspace's is `rlib`. Testing for the literal string called every `--lib`
# selector broken on the first run of this check.
LIB_KINDS = {"lib", "rlib", "dylib", "cdylib", "staticlib", "proc-macro"}
if want_lib and not any(LIB_KINDS.intersection(t["kind"])
                        for p in scope for t in p["targets"]):
    problems.append("--lib, but no package in scope has a library target")

for feature in wanted_features:
    if not any(feature in p.get("features", {}) for p in scope):
        problems.append("--features %s names a feature no package in scope declares" % feature)

for problem in problems:
    print("  " + problem, file=sys.stderr)
raise SystemExit(1 if problems else 0)
PY
}

# The ctest selector still matches at least one registered test.
#
# Skipped rather than failed when the tree is not configured: configuring a
# CMake tree is minutes, and a mode whose whole claim is that it costs
# nothing must not quietly start doing that. Said out loud, because a check
# that skips in silence is the thing this harness exists to prevent.
mutation_ctest_check_selector() {
    local build_dir
    build_dir="$(mutation_ctest_build_dir)" || {
        red "mutation_ctest needs --test-dir <dir>: it names the tree to rebuild"
        return 1
    }
    if [[ ! -f "$build_dir/CMakeCache.txt" ]]; then
        dim "selector NOT checked: $build_dir is not configured — configuring one"
        dim "would cost more than everything else this mode does put together"
        return 0
    fi
    local n
    n="$(ctest "${MUTATION_RUNNER_ARGS[@]}" --show-only=json-v1 2>/dev/null |
         python3 -c 'import json, sys; print(len(json.load(sys.stdin).get("tests", [])))' 2>/dev/null)" \
        || n=0
    if [[ "${n:-0}" -eq 0 ]]; then
        red "the ctest selector matches no registered test: ${MUTATION_RUNNER_ARGS[*]}"
        return 1
    fi
    dim "selector matches $n registered test(s)"
}

mutation_init() {
    if [[ -z "$MUTATION_RUNNER" ]]; then
        red "the casefile declared no mutation_tests or mutation_ctest selector"
        exit 2
    fi
    if [[ ${#MUTATION_TARGET_FILES[@]} -eq 0 && ${#MUTATION_RUNTIME_FILES[@]} -eq 0 ]]; then
        red "the casefile declared no mutation_targets or mutation_runtime_targets"
        exit 2
    fi
    # Before the snapshot, which reads every declared file and would other-
    # wise die on the missing one with `cp`'s message instead of this one.
    mutation_check_targets_exist || exit 2
    mutation_snapshot

    if [[ "$MUTATION_MODE" == "check" ]]; then
        mutation_check_selector || exit 2
        # The case bodies still need a baseline to compare against; it is
        # just the files this time, since nothing gets built.
        BASELINE_FILE_HASHES="$(mutation_all_target_hashes)"
        green "check: $(mutation_all_targets | wc -l) declared target(s), selector resolves"
        echo
        return
    fi

    mutation_resolve_artifacts
    dim "resolved ${#MUTATION_ARTIFACTS[@]} test artifact(s) via $MUTATION_RUNNER"

    BASELINE_FILE_HASHES="$(mutation_all_target_hashes)"
    BASELINE_COMPILED_HASHES="$(mutation_compiled_target_hashes)"
    BASELINE_HASHES="$(mutation_build_and_hash)" || { red "baseline build failed"; exit 2; }
    read -r BASELINE_RUN BASELINE_FAILED <<<"$(mutation_run_artifacts)"
    if [[ "$BASELINE_FAILED" != "0" ]]; then
        red "baseline is not green ($BASELINE_FAILED failing) — fix that before mutating,"
        red "or every case below will read as CAUGHT for the wrong reason"
        exit 2
    fi
    if [[ "$BASELINE_RUN" == "0" ]]; then
        red "baseline ran 0 tests — the selector matches nothing"
        exit 2
    fi
    green "baseline: $BASELINE_RUN tests, 0 failing"
    echo
}

# mutation_case <label>  (Python case body on stdin)
mutation_case() {
    local label="$1"
    local body
    # Read unconditionally: the heredoc has to be consumed on the declaration
    # pass too, or the shell would hand its lines to the parser as commands.
    body="$(cat)"
    [[ "${MUTATION_PASS:-run}" != "declare" ]] || return 0

    printf '%s\n' "$body" > "$WORK/case.py"
    if ! MUTATION_DECLARED_FILES="$(printf '%s\n' \
            ${MUTATION_TARGET_FILES[@]+"${MUTATION_TARGET_FILES[@]}"} \
            ${MUTATION_RUNTIME_FILES[@]+"${MUTATION_RUNTIME_FILES[@]}"})" \
        python3 - "$WORK/case.py" <<'PY'
import os
import sys

# Only declared files are snapshotted, and only snapshotted files are restored.
# An edit outside that set therefore outlives the round: the mutation stays in
# the working tree, and because the harness compares only declared files the
# case is reported as though the body had changed nothing — a false
# INCONCLUSIVE sitting on top of a source tree that is now silently broken.
# Refusing here is the difference between a harness that owns the restore and
# one that only appears to.
_declared = {line for line in os.environ.get("MUTATION_DECLARED_FILES", "").splitlines() if line}


def edit(path, old, new):
    if path not in _declared:
        raise SystemExit(
            "%s is edited by this case but declared by neither mutation_targets "
            "nor mutation_runtime_targets.\n"
            "Only declared files are snapshotted and restored, so this edit would "
            "survive the round and leave the mutation in the tree.\n"
            "  declared: %s" % (path, ", ".join(sorted(_declared)) or "(none)")
        )
    if old == new:
        raise SystemExit(
            "%s: this edit replaces its anchor with itself, so the case "
            "mutates nothing.\n  %r" % (path, old[:120])
        )
    src = open(path).read()
    occurrences = src.count(old)
    if occurrences == 0:
        raise SystemExit(
            "anchor not found in %s — the mutation matched nothing, which "
            "would have read as SURVIVED:\n  %r" % (path, old[:120])
        )
    # An anchor that matches twice is a case that no longer says where it
    # aims: `replace(..., 1)` takes the first, and which line that is can be
    # changed by an edit somewhere else in the file that the case never
    # mentions. The verdict would still be printed, against a different
    # defect than the one the comment above it describes. Widen the anchor
    # with a line of surrounding context to make it say which site it means.
    if occurrences > 1:
        raise SystemExit(
            "anchor matches %d places in %s — this case would silently mutate "
            "the first, and a later edit elsewhere in the file can change "
            "which one that is. Widen it with surrounding context:\n  %r"
            % (occurrences, path, old[:120])
        )
    open(path, "w").write(src.replace(old, new, 1))


exec(compile(open(sys.argv[1]).read(), sys.argv[1], "exec"), {"edit": edit})
PY
    then
        red "INCONCLUSIVE  $label"
        red "              the case body did not apply"
        MUTATION_INCONCLUSIVE=$((MUTATION_INCONCLUSIVE + 1))
        mutation_restore
        return
    fi

    # What the case actually changed on disk, before asking what that did to
    # the artifacts. A body whose `edit()` matched but replaced a string with
    # itself leaves the tree at the baseline, and every check below would then
    # be measuring the unmutated code and reporting it as SURVIVED.
    local file_hashes compiled_hashes
    file_hashes="$(mutation_all_target_hashes)"
    compiled_hashes="$(mutation_compiled_target_hashes)"
    if [[ "$file_hashes" == "$BASELINE_FILE_HASHES" ]]; then
        red "INCONCLUSIVE  $label"
        red "              the case body left every target byte-identical —"
        red "              nothing was mutated, so nothing was tested"
        MUTATION_INCONCLUSIVE=$((MUTATION_INCONCLUSIVE + 1))
        mutation_restore
        return
    fi

    # `--check` stops here, having established the whole of what it claims:
    # the case still finds its anchors and still changes the tree. It
    # deliberately does not say CAUGHT — nothing was built and no test ran,
    # so there is no verdict about a test to report.
    if [[ "$MUTATION_MODE" == "check" ]]; then
        green "applies       $label"
        MUTATION_CAUGHT=$((MUTATION_CAUGHT + 1))
        mutation_restore
        if [[ "$(mutation_all_target_hashes)" != "$BASELINE_FILE_HASHES" ]]; then
            red "              restore did not reproduce the baseline files"
            exit 2
        fi
        return
    fi

    local hashes
    if ! hashes="$(mutation_build_and_hash)"; then
        # A mutation that does not compile is a legitimate outcome — the
        # type system refused it — but it is not evidence about the tests,
        # so it is never reported as CAUGHT.
        red "INCONCLUSIVE  $label"
        red "              mutated tree does not compile; the tests never ran"
        MUTATION_INCONCLUSIVE=$((MUTATION_INCONCLUSIVE + 1))
        mutation_restore
        return
    fi

    # Only a case that touched a COMPILED target owes a changed binary. One
    # that edited a script the tests execute is expected to leave every binary
    # identical — the mutated artifact is the file on disk, and the check above
    # already established it differs from the baseline.
    if [[ "$compiled_hashes" != "$BASELINE_COMPILED_HASHES" \
          && "$hashes" == "$BASELINE_HASHES" ]]; then
        red "INCONCLUSIVE  $label"
        red "              every test binary is byte-identical to the baseline —"
        red "              the mutation never reached the code under test"
        MUTATION_INCONCLUSIVE=$((MUTATION_INCONCLUSIVE + 1))
        mutation_restore
        return
    fi

    local run failed
    read -r run failed <<<"$(mutation_run_artifacts)"

    if [[ "$run" != "$BASELINE_RUN" ]]; then
        red "INCONCLUSIVE  $label"
        red "              ran $run tests, baseline ran $BASELINE_RUN — the case"
        red "              changed which tests exist, so the verdict is not comparable"
        MUTATION_INCONCLUSIVE=$((MUTATION_INCONCLUSIVE + 1))
        mutation_restore
        return
    fi

    if [[ "$failed" -gt 0 ]]; then
        green "CAUGHT        $label  ($failed/$run red)"
        mutation_name_failures
        MUTATION_CAUGHT=$((MUTATION_CAUGHT + 1))
    else
        red "SURVIVED      $label  (0/$run red)"
        MUTATION_SURVIVED=$((MUTATION_SURVIVED + 1))
    fi

    mutation_restore
    # Restoring must put the tree back where it started. Checking it here
    # rather than at the end means a botched restore is attributed to the
    # case that caused it instead of poisoning every case after it.
    local restored
    restored="$(mutation_build_and_hash)" || { red "restore left a tree that does not build"; exit 2; }
    if [[ "$restored" != "$BASELINE_HASHES" ]]; then
        red "              restore did not reproduce the baseline binaries"
        red "              — later cases would be measured against a moved baseline"
        exit 2
    fi
    # And the files themselves, which for a runtime target is the only place a
    # botched restore would show: its binaries are identical either way.
    if [[ "$(mutation_all_target_hashes)" != "$BASELINE_FILE_HASHES" ]]; then
        red "              restore did not reproduce the baseline files"
        red "              — later cases would be measured against a moved baseline"
        exit 2
    fi
}

# Name the tests a CAUGHT verdict is made of.
#
# Three at most: a mutation that reds a hundred assertions has said what it
# needs to with three, and burying the verdict under the list is how a
# reader stops reading the verdict.
mutation_name_failures() {
    [[ -s "$MUTATION_FAILING" ]] || return 0
    local count shown
    count="$(wc -l < "$MUTATION_FAILING")"
    shown="$(head -3 "$MUTATION_FAILING" | paste -sd',' - | sed 's/,/, /g')"
    if (( count > 3 )); then
        dim "              red: $shown (+$((count - 3)) more)"
    else
        dim "              red: $shown"
    fi
}

mutation_report() {
    echo
    local total=$((MUTATION_CAUGHT + MUTATION_SURVIVED + MUTATION_INCONCLUSIVE))
    # A casefile with no cases is the emptiest form of the failure this whole
    # harness is about: it declares a suite and a target, runs clean, and
    # tests nothing. Neither mode may report that as a pass.
    if [[ $total -eq 0 ]]; then
        red "the casefile declared no mutation_case — nothing was tested"
        return 1
    fi
    if [[ "$MUTATION_MODE" == "check" ]]; then
        if [[ $MUTATION_INCONCLUSIVE -eq 0 ]]; then
            green "$MUTATION_CAUGHT/$total case(s) still apply"
            return 0
        fi
        red "$MUTATION_CAUGHT/$total case(s) still apply, $MUTATION_INCONCLUSIVE stale"
        return 1
    fi
    if [[ $MUTATION_SURVIVED -eq 0 && $MUTATION_INCONCLUSIVE -eq 0 ]]; then
        green "$MUTATION_CAUGHT/$total caught"
        return 0
    fi
    red "$MUTATION_CAUGHT/$total caught, $MUTATION_SURVIVED survived, $MUTATION_INCONCLUSIVE inconclusive"
    return 1
}

# ── Driver ─────────────────────────────────────────────────────────

MUTATION_ARGV=()
while (( $# )); do
    case "$1" in
        --check) MUTATION_MODE=check ;;
        # Spelled out rather than sliced out of the header with a line
        # range: a range silently prints the wrong block the first time
        # anything above it grows, and this file's header has grown twice.
        -h|--help)
            printf 'usage: scripts/mutate [--check] <casefile>\n\n'
            printf '  (default)  full round — build, run, require every case CAUGHT\n'
            printf '  --check    apply and restore only; no build, no test run\n\n'
            printf 'The casefile vocabulary is documented in this file'\''s header.\n'
            exit 0 ;;
        -*) red "mutate: unknown option $1"; exit 2 ;;
        *) MUTATION_ARGV+=("$1") ;;
    esac
    shift
done

if (( ${#MUTATION_ARGV[@]} != 1 )); then
    echo "usage: scripts/mutate [--check] <casefile>" >&2
    exit 2
fi

CASEFILE="${MUTATION_ARGV[0]}"
[[ -f "$CASEFILE" ]] || { red "no such casefile: $CASEFILE"; exit 2; }

# The casefile declares the selector and targets, then the cases. Sourcing
# happens in two passes so `mutation_init` can run — and reject a red
# baseline — before the first case body edits anything.
#
# Both passes source the whole file, and `mutation_case` decides which pass it
# is in. The first pass used to be a grep for the declaration names, which was
# a second copy of this file's vocabulary — and the copy is what goes stale:
# `mutation_runtime_targets` was invisible to it on the day it was added, and
# the casefile that used it was rejected as declaring no targets at all.
MUTATION_PASS=declare
# shellcheck disable=SC1090
source "$CASEFILE"
mutation_init

MUTATION_PASS="$MUTATION_MODE"
# shellcheck disable=SC1090
source "$CASEFILE"

mutation_report
