"""Bazel repository rule for consuming the SCE C++ runtime.

Provides @sce//:sce_core (header-only) and @sce//:sce_base (compiled), and
the Mesh https binding's reference adapters (docs/adr/0107, D2):
@sce//:mesh_https_curl when the `curl` attribute names the consumer's libcurl,
and @sce//:mesh_https_winhttp when the repository is fetched on Windows.

sce_base_sources.cmake is the single source of truth for the file list.
This rule parses it and generates BUILD.bazel files automatically.

The generated BUILD files load the C++ rules from `@rules_cc`, which Bazel 9
requires (it removed the native `cc_library`) and Bazel 7 and 8 accept, so the
consumer's workspace must provide `rules_cc`.

Usage with Bzlmod (Bazel 7 and later; the only mode Bazel 9 runs), in the
consumer's MODULE.bazel:

    bazel_dep(name = "rules_cc", version = "0.2.27")

    sce_local_repository = use_repo_rule("//path/to:sce_repo.bzl", "sce_local_repository")

    sce_local_repository(
        name = "sce",
        path = "/path/to/scxml-core-engine",
    )

Usage in a WORKSPACE (Bazel 7 and 8 with --enable_workspace), where
`rules_cc` must be declared too:

    load("//path/to/sce_repo.bzl", "sce_local_repository")

    sce_local_repository(
        name = "sce",
        path = "/path/to/scxml-core-engine",
    )

Either form also takes the checkout from an environment variable:

    sce_local_repository(
        name = "sce",
        environ = "MY_SCE_ROOT",
    )

The COSE operations of the C++ reference host (docs/adr/0107, D7) are built on
libsodium, which SCE finds and never vendors: a consumer that wants them names
the libsodium it already builds or imports, and the repository then provides
@sce//:sce_host_cose, which links it and states SCE_HOST_COSE=1 to what links
it, as the CMake target SCE::host_cose does (cmake/SCEHostCose.cmake):

    sce_local_repository(
        name = "sce",
        path = "/path/to/scxml-core-engine",
        sodium = "@libsodium//:sodium",
    )

Without `sodium` there is no such target, and the header that calls libsodium
(host/SodiumCoseCrypto.h) is in no target either.

sce_base is compiled with the options of the compiler the consumer's toolchain
selects (rules_cc's `cc/compiler` settings): GCC and Clang force-include with
`-include`; MSVC and clang-cl with `/FI`, at the C++17 their default C++14 is
below, and read the sources as UTF-8.
"""

_CC_LOAD = 'load("@rules_cc//cc:defs.bzl", "cc_library")\n'

def _parse_cmake_sources(content, variable):
    """Extract file paths from a CMake set(<variable> ...) block."""
    sources = []
    in_block = False
    for line in content.split("\n"):
        stripped = line.strip()
        if stripped.startswith("set(" + variable):
            in_block = True
            continue
        if in_block:
            if stripped == ")":
                break
            if stripped.startswith("#") or stripped == "":
                continue
            sources.append(stripped)
    return sources

_THIRD_PARTY_BUILD = '''\
# Auto-generated by sce_local_repository.
'''

_NLOHMANN_BUILD = '''\
# Auto-generated by sce_local_repository.
cc_library(
    name = "nlohmann_json",
    hdrs = ["include/nlohmann/json.hpp"],
    includes = ["include"],
    visibility = ["//sce:__pkg__"],
)
'''

_PUGIXML_BUILD = '''\
# Auto-generated by sce_local_repository.
cc_library(
    name = "pugixml",
    srcs = ["src/pugixml.cpp"],
    hdrs = [
        "src/pugiconfig.hpp",
        "src/pugixml.hpp",
    ],
    includes = ["src"],
    visibility = ["//sce:__pkg__"],
)
'''

# The Forge C++ runtime, which the C++ sce-codegen writes includes
# (<sce/forge/algorithm.h>, <sce/forge/span.h>, ...). Its own package, so the
# rule writes a BUILD file of its own rather than one inside the symlinked
# source tree (which would land in the consumer's checkout).
_FORGE_RUNTIME_BUILD = '''\
# Auto-generated by sce_local_repository.
cc_library(
    name = "sce_forge_runtime",
    hdrs = glob(["include/sce/forge/*.h"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
'''

# The header of the COSE operations that calls libsodium. It belongs to
# sce_host_cose, which links the libsodium the consumer names, and to no target
# when none is named: in sce_core it would be a header that includes <sodium.h>
# with nothing to find it.
_SODIUM_HEADER = "include/host/SodiumCoseCrypto.h"

# sce_base's own compile options, in the spelling of the compiler that builds it:
# the force-included headers (`-include` for GCC and Clang, `/FI` for MSVC and
# clang-cl, whose command line is cl's), and for those two the C++17 the sources
# are written in (their default is C++14) and the UTF-8 they are written in
# (cl reads a source in the system's code page otherwise).
_SCE_BASE_COPTS = '''select({
        "@rules_cc//cc/compiler:msvc-cl": _MSVC_COPTS,
        "@rules_cc//cc/compiler:clang-cl": _MSVC_COPTS,
        "//conditions:default": [
            "-include common/ExternTemplates.h",
            "-include common/DisableStdOut.h",
        ],
    })'''

_SCE_BUILD_TEMPLATE = '''\
# Auto-generated by sce_local_repository.
# Source list parsed from sce_base_sources.cmake (SSOT).

_MSVC_COPTS = [
    "/std:c++17",
    "/utf-8",
    "/FIcommon/ExternTemplates.h",
    "/FIcommon/DisableStdOut.h",
]

cc_library(
    name = "sce_core",
    hdrs = glob(["include/**/*.h"], exclude = ["{sodium_header}"]),
    includes = ["include"],
    deps = [
        "//forge_runtime:sce_forge_runtime",
        "//third_party/nlohmann_json",
        "//third_party/pugixml",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "sce_base",
    srcs = {srcs},
    copts = {copts},
    deps = [":sce_core"],
    visibility = ["//visibility:public"],
)
'''

_SCE_HOST_COSE_BUILD = '''
cc_library(
    name = "sce_host_cose",
    hdrs = ["{sodium_header}"],
    includes = ["include"],
    defines = ["SCE_HOST_COSE=1"],
    deps = [
        ":sce_core",
        "{sodium}",
    ],
    visibility = ["//visibility:public"],
)
'''

_ROOT_BUILD = '''\
# Auto-generated by sce_local_repository.
alias(
    name = "sce_core",
    actual = "//sce:sce_core",
    visibility = ["//visibility:public"],
)

alias(
    name = "sce_base",
    actual = "//sce:sce_base",
    visibility = ["//visibility:public"],
)
'''

# The reference adapters of the Mesh https binding's port (docs/adr/0107, D2;
# sce/include/mesh/transports/HttpsTransport.h), each a target of its own and
# each optional, as cmake/SCEMeshHttps.cmake makes them, and built only by a
# consumer that depends on one. The libcurl one exists when the consumer
# passes its libcurl as the `curl` label (SCE vendors none); the WinHTTP one
# exists when the repository is fetched on Windows. Neither links the other,
# and the rest of SCE links neither.
_MESH_HTTPS_PORT_HDRS = '''\
        "include/mesh/transports/HttpsTransport.h",
'''

_MESH_HTTPS_CURL_BUILD = '''\
cc_library(
    name = "mesh_https_curl",
    srcs = ["src/mesh/https/CurlHttpsTransport.cpp"],
    hdrs = [
{port_hdrs}        "include/mesh/transports/https/CurlHttpsTransport.h",
    ],
    includes = ["include"],
    defines = ["SCE_MESH_HTTPS_CURL=1"],
    deps = ["{curl}"],
    visibility = ["//visibility:public"],
)
'''

_MESH_HTTPS_WINHTTP_BUILD = '''\
cc_library(
    name = "mesh_https_winhttp",
    srcs = ["src/mesh/https/WinHttpHttpsTransport.cpp"],
    hdrs = [
{port_hdrs}        "include/mesh/transports/https/WinHttpHttpsTransport.h",
    ],
    includes = ["include"],
    defines = ["SCE_MESH_HTTPS_WINHTTP=1"],
    linkopts = ["winhttp.lib", "crypt32.lib"],
    visibility = ["//visibility:public"],
)
'''

_MESH_HTTPS_ALIAS = '''\

alias(
    name = "{name}",
    actual = "//sce:{name}",
    visibility = ["//visibility:public"],
)
'''

_ROOT_HOST_COSE_BUILD = '''
alias(
    name = "sce_host_cose",
    actual = "//sce:sce_host_cose",
    visibility = ["//visibility:public"],
)
'''

# Directories to skip when symlinking the SCE source tree.
_SKIP_DIRS = (
    "embed", "build", "build_debug", "build_debug_qjs", "build_python",
    "build_wasm", "target", "Testing",
    ".git", ".github", ".gradle", ".kotlin", ".pytest_cache", ".serena",
    ".claude",
)

def _sce_local_repository_impl(ctx):
    # Resolve SCE root: explicit path > environment variable.
    sce_root = ""
    if ctx.attr.path:
        sce_root = ctx.attr.path
    elif ctx.attr.environ:
        sce_root = ctx.os.environ.get(ctx.attr.environ, "")

    if not sce_root:
        fail(
            "sce_local_repository: SCE root not found.\n" +
            "Set the 'path' attribute or the '{}' environment variable.".format(
                ctx.attr.environ or "SCE_ROOT",
            ),
        )

    root = ctx.path(sce_root)
    if not root.exists:
        fail("sce_local_repository: path does not exist: " + sce_root)

    # Symlink SCE source tree, skipping build artifacts.
    for entry in root.readdir():
        name = entry.basename
        if name in _SKIP_DIRS or name == "WORKSPACE":
            continue
        ctx.symlink(entry, name)

    # Parse cmake SSOT and generate BUILD files.
    cmake_content = ctx.read(
        root.get_child("sce").get_child("sce_base_sources.cmake"),
    )
    srcs = _parse_cmake_sources(cmake_content, "SCE_BASE_SOURCES")
    srcs_str = "[\n" + "".join(
        ["        \"%s\",\n" % s for s in srcs],
    ) + "    ]"

    ctx.symlink(
        root.get_child("backends").get_child("cpp").get_child("forge-runtime").get_child("include"),
        "forge_runtime/include",
    )
    sce_build = _SCE_BUILD_TEMPLATE.format(
        srcs = srcs_str,
        copts = _SCE_BASE_COPTS,
        sodium_header = _SODIUM_HEADER,
    )
    root_build = _ROOT_BUILD
    if ctx.attr.sodium:
        # The label as Bazel resolved it where the rule was called, in its
        # canonical form, so it names the same target from inside this
        # repository whatever this repository's own mapping of names is.
        sce_build += _SCE_HOST_COSE_BUILD.format(
            sodium_header = _SODIUM_HEADER,
            sodium = str(ctx.attr.sodium),
        )
        root_build += _ROOT_HOST_COSE_BUILD

    ctx.file("forge_runtime/BUILD.bazel", _CC_LOAD + _FORGE_RUNTIME_BUILD)

    # The Mesh https adapters (docs/adr/0107, D2), each where its platform
    # stack is there to link.
    if ctx.attr.curl:
        sce_build += "\n" + _MESH_HTTPS_CURL_BUILD.format(
            port_hdrs = _MESH_HTTPS_PORT_HDRS,
            curl = ctx.attr.curl,
        )
        root_build += _MESH_HTTPS_ALIAS.format(name = "mesh_https_curl")
    if ctx.os.name.lower().startswith("windows"):
        sce_build += "\n" + _MESH_HTTPS_WINHTTP_BUILD.format(port_hdrs = _MESH_HTTPS_PORT_HDRS)
        root_build += _MESH_HTTPS_ALIAS.format(name = "mesh_https_winhttp")

    ctx.file("BUILD.bazel", root_build)
    ctx.file("sce/BUILD.bazel", _CC_LOAD + sce_build)
    ctx.file("third_party/BUILD.bazel", _THIRD_PARTY_BUILD)
    ctx.file("third_party/nlohmann_json/BUILD.bazel", _CC_LOAD + _NLOHMANN_BUILD)
    ctx.file("third_party/pugixml/BUILD.bazel", _CC_LOAD + _PUGIXML_BUILD)
    ctx.file("WORKSPACE", "workspace(name = \"sce\")\n")

sce_local_repository = repository_rule(
    implementation = _sce_local_repository_impl,
    attrs = {
        "path": attr.string(doc = "Absolute path to scxml-core-engine checkout."),
        "environ": attr.string(
            default = "SCE_ROOT",
            doc = "Environment variable holding the SCE checkout path.",
        ),
        "curl": attr.string(
            default = "",
            doc = "The consumer's libcurl, as a label (`@curl//:curl`); when given, " +
                  "@sce//:mesh_https_curl is defined on it. SCE vendors no libcurl.",
        ),
        "sodium": attr.label(
            doc = "The consumer's libsodium (a cc_library or cc_import target). When " +
                  "given, the repository provides sce_host_cose, the C++ reference " +
                  "host's COSE operations, linked against it.",
        ),
    },
    environ = ["SCE_ROOT"],
    local = True,
    doc = "Exposes the SCE C++ runtime (sce_core + sce_base, and sce_host_cose when " +
          "a libsodium is named) as a Bazel repository.",
)
