        window.onSceAimAssistState = function(enabled) {
            SCE.aimAssistEnabled = !!enabled;
            const state = enabled ? 'enabled' : 'disabled';

            // Update indicator
            const indicator = document.getElementById('ind-aim');
            if (indicator) indicator.textContent = enabled ? 'ON' : 'OFF';

