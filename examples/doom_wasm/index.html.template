        // C++ callback: Called when berserk state changes
        window.onSceBerserkUpdate = function(intensity, active) {
            console.log('[SCE:Berserk] Update: intensity=' + intensity + ', active=' + active);
            berserkActive = active;
            berserkIntensity = intensity;

            // Update red screen overlay with intensity-based effects
            const overlayEl = document.getElementById('berserk-overlay');
            if (overlayEl) {
                if (active && intensity > 0) {
                    // Strong red intensity: 0.2 at x1, up to 0.8 at x10+
                    const cappedIntensity = Math.min(intensity, 10);
                    const redIntensity = 0.2 + (cappedIntensity / 10) * 0.6;
                    // Smaller transparent center at high intensity
                    const transparentSize = Math.max(5, 25 - cappedIntensity * 2);
                    overlayEl.style.background = 'radial-gradient(ellipse at center, transparent ' + transparentSize + '%, rgba(255, 0, 0, ' + redIntensity + ') 100%)';

                    // Intensity-based pulse speed
                    let intensityClass = 'active ';
                    if (cappedIntensity <= 3) {
                        intensityClass += 'intensity-low';
                    } else if (cappedIntensity <= 6) {
                        intensityClass += 'intensity-mid';
                    } else {
                        intensityClass += 'intensity-high';
                    }
                    overlayEl.className = intensityClass;
                } else {
                    overlayEl.className = '';
                    overlayEl.style.background = '';
                }
            }

            // Update combo display text for berserk
            const comboEl = document.getElementById('combo-display');
            if (comboEl && active) {
                comboEl.textContent = 'BERSERK! x' + intensity;
                comboEl.className = 'berserk-active';
            }

            // Reset timer animation for berserk (10 second timeout)
            if (active) {
                comboTimerStart = Date.now();
                const timerEl = document.getElementById('combo-timer');
                if (timerEl) {
                    timerEl.style.width = '100%';
                    timerEl.style.background = '#ff0000';  // Red for berserk
                }
            }
        };

        // C++ callback: Called when kill combo state changes
        window.onSceComboUpdate = function(count, active) {
            // Update game overlay (only if not in berserk - berserk has its own display)
            const comboEl = document.getElementById('combo-display');
            if (comboEl && !berserkActive) {
                if (active && count > 1) {
                    comboEl.textContent = count + 'x COMBO!';
                    comboEl.className = 'combo-active';
                } else if (!active) {
                    comboEl.textContent = '';
                    comboEl.className = '';
                }
            }

            // Update combo section panel
            const countEl = document.getElementById('combo-count');
            if (countEl) {
                countEl.textContent = count;
            }

            // Set timer bar color based on mode (actual animation driven by onSceComboTimer)
            const timerEl = document.getElementById('combo-timer');
            if (timerEl) {
                if (active) {
                    timerEl.style.width = '100%';
                    timerEl.style.background = berserkActive ? '#ff0000' : '#ff6600';
                } else {
                    timerEl.style.width = '0%';
                    timerEl.style.background = '#ff6600';  // Reset to normal color
                }
            }

            // Clear berserk overlay if combo ended
            if (!active) {
                const overlayEl = document.getElementById('berserk-overlay');
                if (overlayEl) {
                    overlayEl.className = '';
                }
            }
        };

        // C++ callback: Called every game tic with remaining timer (synced with game logic)
        window.onSceComboTimer = function(remainingMs, totalMs) {
            const timerEl = document.getElementById('combo-timer');
            if (timerEl) {
                if (remainingMs < 0 || totalMs <= 0) {
                    // Timer ended
                    timerEl.style.width = '0%';
                } else {
                    // Update timer bar from C++ game time (perfectly synced)
                    const percent = Math.max(0, (remainingMs / totalMs) * 100);
                    timerEl.style.width = percent + '%';
                    // Color based on berserk state
                    timerEl.style.background = berserkActive ? '#ff0000' : '#ff6600';
                }
            }
        };

