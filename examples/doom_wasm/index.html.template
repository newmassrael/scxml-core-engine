        // C++ callback: Called when secret path is found
        // isPartial: 1 if target is unreachable (path only goes to closest accessible point)
        window.onSceSecretPath = function(numArrows, remainingSecrets, isPartial) {
            SCE.secretArrows = [];
            SCE.secretRemaining = remainingSecrets;
            SCE.pathPartial = !!isPartial;
            const arrowsEl = document.getElementById('secret-arrows');
            const statsEl = document.getElementById('stat-secrets');
            const partialEl = document.getElementById('path-partial-warning');
            if (arrowsEl) arrowsEl.textContent = numArrows;
            if (statsEl) statsEl.textContent = remainingSecrets + ' left';
            if (partialEl) {
                partialEl.style.display = isPartial ? 'inline' : 'none';
