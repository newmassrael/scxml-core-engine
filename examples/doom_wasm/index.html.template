        // C++ callback: Called when target info updates
        // Parameters: typeName, name, index, total, triggerX, triggerY, sectorX, sectorY, sectorIdx, openMethod, isHidden, linkedSecret
        window.onSceTargetInfo = function(typeName, name, index, total, triggerX, triggerY, sectorX, sectorY, sectorIdx, openMethod, isHidden, linkedSecret) {
            // Update active button highlight
            // Normalize type name: "Key Door" -> "keydoor" to match button dataset
            const normalizedType = typeName.toLowerCase().replace(/ /g, '');
            document.querySelectorAll('.target-btn').forEach(btn => {
                const isActive = btn.dataset.type === normalizedType &&
                                 parseInt(btn.dataset.index) === index;
                btn.classList.toggle('active', isActive);
            });
            // Store coordinates for visualization
            SCE.currentTarget = {
                type: typeName,
                name: name,
                index: index,
                total: total,
                trigger: { x: triggerX, y: triggerY },
                sector: { x: sectorX, y: sectorY, index: sectorIdx },
                openMethod: openMethod || '',
                isHidden: !!isHidden,
                linkedSecret: linkedSecret
            };
            // Show/hide destination mode selector based on whether target has sector
            const destSelector = document.getElementById('dest-selector');
            if (destSelector) {
                const hasSector = (sectorIdx !== undefined && sectorIdx >= 0);
                destSelector.style.display = hasSector ? 'inline-block' : 'none';
            }
            // Update door info display
            const doorInfoEl = document.getElementById('door-info');
            if (doorInfoEl) {
                const isDoorType = (normalizedType === 'door' || normalizedType === 'keydoor' || normalizedType === 'lift');
                if (isDoorType && openMethod) {
                    let infoText = 'Open: ' + openMethod;
                    if (isHidden) {
                        infoText = '[Hidden] ' + infoText;
                        if (linkedSecret >= 0) {
                            infoText += ' → Secret ' + (linkedSecret + 1);
                        }
                    }
                    doorInfoEl.textContent = infoText;
                    doorInfoEl.style.display = 'block';
                } else {
                    doorInfoEl.style.display = 'none';
                }
            }
        };

        // Destination mode: 0 = trigger, 1 = sector
        let currentDestMode = 0;

        function setDestMode(mode) {
            if (!Module || !Module.ccall) {
                console.error('Module not ready');
                return;
            }
            currentDestMode = mode;
            // Update C backend
            if (mode === 0) {
                Module.ccall('sce_set_dest_mode_trigger', null, [], []);
            } else {
                Module.ccall('sce_set_dest_mode_sector', null, [], []);
            }
            // Update button states
            document.getElementById('dest-trigger-btn').classList.toggle('active', mode === 0);
            document.getElementById('dest-sector-btn').classList.toggle('active', mode === 1);
            // Recalculate path with new destination
            Module.ccall('sce_secret_recalculate', null, [], []);
        }

