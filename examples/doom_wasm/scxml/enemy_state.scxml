<?xml version="1.0" encoding="UTF-8"?>
<!--
    DOOM Enemy State Machine

    States:
    - dormant: Enemy has not detected player (idle/patrol)
    - alert: Enemy just detected player, preparing to act
    - chasing: Enemy is actively pursuing player
    - attacking: Enemy is performing attack animation
    - pain: Enemy is in pain state (hit stun)
    - dead: Enemy has been killed

    C++ Integration:
    - Uses <cpp> tag for direct C++ function calls (Zero Overhead)
    - enemy.xxx() calls are transformed to user_->enemy.xxx()

    Note: Each enemy instance has its own state machine instance
    W3C SCXML 1.0 compliant
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext" version="1.0"
       name="EnemyState" initial="dormant" datamodel="null">
    <sce:context id="enemy"/>

    <!-- dormant: Enemy idle, hasn't seen player -->
    <state id="dormant">
        <onentry>
            <script><cpp>enemy.onDormant()</cpp></script>
        </onentry>
        <transition event="see_player" target="alert"/>
        <transition event="pain" target="pain"/>  <!-- Can take damage before seeing player -->
        <transition event="killed" target="dead"/>
    </state>

    <!-- alert: Just spotted player, about to act -->
    <state id="alert">
        <onentry>
            <script><cpp>enemy.onAlert()</cpp></script>
        </onentry>
        <transition event="chase" target="chasing"/>
        <transition event="attack" target="attacking"/>
        <transition event="pain" target="pain"/>
        <transition event="killed" target="dead"/>
        <!-- Note: DOOM enemies don't return to dormant once alerted -->
    </state>

    <!-- chasing: Actively pursuing player -->
    <state id="chasing">
        <onentry>
            <script><cpp>enemy.onChasing()</cpp></script>
        </onentry>
        <transition event="attack" target="attacking"/>
        <transition event="pain" target="pain"/>
        <transition event="killed" target="dead"/>
        <!-- Note: DOOM enemies persist in chase until killed or attacking -->
    </state>

    <!-- attacking: Performing attack -->
    <state id="attacking">
        <onentry>
            <script><cpp>enemy.onAttacking()</cpp></script>
        </onentry>
        <!-- Returns to chasing via chase event from A_Chase -->
        <transition event="chase" target="chasing"/>
        <transition event="pain" target="pain"/>
        <transition event="killed" target="dead"/>
    </state>

    <!-- pain: Hit stun state -->
    <state id="pain">
        <onentry>
            <script><cpp>enemy.onPain()</cpp></script>
        </onentry>
        <!-- Returns to chasing via chase event from A_Chase -->
        <transition event="chase" target="chasing"/>
        <transition event="attack" target="attacking"/>  <!-- Can attack directly from pain -->
        <transition event="killed" target="dead"/>
    </state>

    <!-- dead: Final state -->
    <final id="dead">
        <onentry>
            <script><cpp>enemy.onDead()</cpp></script>
        </onentry>
    </final>

</scxml>
