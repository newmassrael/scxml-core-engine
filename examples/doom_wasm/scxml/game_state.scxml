<?xml version="1.0" encoding="UTF-8"?>
<!--
    DOOM Game State Machine

    Models DOOM's actual game state transitions:
    - DEMOSCREEN: Title screen / demo playback
    - LEVEL: Active gameplay
    - INTERMISSION: Between-level statistics
    - FINALE: End of episode/game text sequence

    Actual DOOM flow:
    1. DEMOSCREEN → (newgame/loadgame) → LEVEL
    2. LEVEL → (completed) → INTERMISSION
    3. INTERMISSION → (worlddone) → LEVEL (next level)
    4. INTERMISSION → (finale) → FINALE (end of episode)
    5. LEVEL → (finale) → FINALE (victory/secret exit)
    6. FINALE → (worlddone) → LEVEL (continue to next episode)

    W3C SCXML 1.0 compliant
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="urn:sce:extensions"
       version="1.0"
       initial="demoscreen"
       datamodel="null">
    <sce:context id="game"/>

    <!-- Initial state: Demo/Title screen -->
    <state id="demoscreen">
        <onentry>
            <script><cpp>game.onDemoScreen()</cpp></script>
        </onentry>
        <transition event="newgame" target="level"/>
        <transition event="loadgame" target="level"/>
    </state>

    <!-- Active gameplay -->
    <state id="level">
        <onentry>
            <script><cpp>game.onLevelStart()</cpp></script>
        </onentry>
        <onexit>
            <script><cpp>game.onLevelEnd()</cpp></script>
        </onexit>
        <transition event="completed" target="intermission"/>
        <transition event="finale" target="finale"/>
    </state>

    <!-- Between-level intermission -->
    <state id="intermission">
        <onentry>
            <script><cpp>game.onIntermission()</cpp></script>
        </onentry>
        <transition event="worlddone" target="level"/>
        <transition event="finale" target="finale"/>
    </state>

    <!-- End game/episode finale text -->
    <state id="finale">
        <onentry>
            <script><cpp>game.onFinale()</cpp></script>
        </onentry>
        <!-- After finale text, player continues to next level/episode -->
        <transition event="worlddone" target="level"/>
    </state>

</scxml>
