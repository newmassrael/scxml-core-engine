<?xml version="1.0" encoding="UTF-8"?>
<!--
    DOOM Secret and Trigger Hint State Machine

    Manages the hint system for secrets and interactive triggers
    (doors, lifts, switches, teleporters, exits).

    States:
    - DISABLED: Hint system is completely off
    - IDLE: Hint system enabled, path hidden
    - CALCULATING: Computing BFS path to selected target
    - SHOWING: Actively displaying floor arrows to target
    - FOUND: Player reached the target (secrets only)
    - NO_PATH: No accessible path to selected target

    Events:
    - enable: Turn on hint system
    - disable: Turn off hint system
    - toggle: H key - toggle path visibility
    - show_path: Show path to currently selected target (from button click)
    - cancel_hint: Cancel current hint display
    - path_found: BFS found a valid path
    - no_path: No path found to target
    - secret_reached: Player entered the target secret sector
    - level_change: New level loaded, reset hint state

    W3C SCXML 1.0 compliant
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       initial="idle"
       datamodel="null">

    <!-- Hint system disabled -->
    <state id="disabled">
        <transition event="enable" target="idle"/>
        <transition event="level_change" target="disabled"/>
    </state>

    <!-- Hint system enabled, path hidden -->
    <state id="idle">
        <transition event="disable" target="disabled"/>
        <transition event="toggle" target="calculating"/>
        <transition event="show_path" target="calculating"/>
        <transition event="level_change" target="idle"/>
    </state>

    <!-- Computing path to target -->
    <state id="calculating">
        <transition event="path_found" target="showing"/>
        <transition event="no_path" target="no_path"/>
        <transition event="disable" target="disabled"/>
        <transition event="level_change" target="idle"/>
    </state>

    <!-- Actively displaying floor arrows -->
    <state id="showing">
        <transition event="toggle" target="idle"/>
        <transition event="show_path" target="calculating"/>
        <transition event="cancel_hint" target="idle"/>
        <transition event="secret_reached" target="found"/>
        <transition event="disable" target="disabled"/>
        <transition event="level_change" target="idle"/>
    </state>

    <!-- Player reached the secret -->
    <state id="found">
        <transition event="toggle" target="idle"/>
        <transition event="show_path" target="calculating"/>
        <transition event="disable" target="disabled"/>
        <transition event="level_change" target="idle"/>
    </state>

    <!-- No accessible path to target -->
    <state id="no_path">
        <transition event="toggle" target="idle"/>
        <transition event="show_path" target="calculating"/>
        <transition event="disable" target="disabled"/>
        <transition event="level_change" target="idle"/>
    </state>

</scxml>
