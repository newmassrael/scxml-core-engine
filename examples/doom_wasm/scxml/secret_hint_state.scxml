<?xml version="1.0" encoding="UTF-8"?>
<!--
    DOOM Secret and Trigger Hint State Machine

    Manages the hint system for secrets and interactive triggers
    (doors, lifts, switches, teleporters, exits).

    States:
    - DISABLED: Hint system is off, no path displayed
    - ENABLED (compound): Hint system is on
      - CALCULATING: Computing BFS path to selected target
      - SHOWING: Actively displaying floor arrows to target
      - FOUND: Player reached the target (secrets only)
      - NO_PATH: No accessible path to selected target

    Events:
    - toggle: H key - toggle hint system on/off
    - select: Button click - select target and show path
    - recalculate: Player moved - recalculate path
    - path_found: BFS found a valid path
    - no_path: No path found to target
    - secret_reached: Player entered the target secret sector
    - level_change: New level loaded, reset hint state

    C++ Integration:
    - Uses <cpp> tag for direct C++ function calls (Zero Overhead)
    - secret.xxx() calls are transformed to user_->secret.xxx()
    - Requires SecretContext struct to be passed to state machine

    W3C SCXML 1.0 compliant
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="disabled"
       datamodel="null">
    <sce:context id="secret"/>

    <!-- Hint system disabled -->
    <state id="disabled">
        <onentry>
            <script><cpp>secret.onDisabled()</cpp></script>
        </onentry>
        <!-- H key or button click enables hint system -->
        <transition event="toggle" target="calculating"/>
        <transition event="select" target="calculating"/>
        <transition event="level_change" target="disabled"/>
    </state>

    <!-- Hint system enabled (compound state) -->
    <!-- sce:exhaustive="false" silences the whole compound, so the whole
         set it covers is named here rather than the one event that
         prompted it:
           * `no_path` / `path_found` are the two conclusions of a path
             computation, so only `calculating` can reach either.
           * `select` picks a target and is only meaningful while a hint
             is on screen, which is `showing`.
           * `secret_reached` retires the current hint and only `showing`
             has one to retire.
           * `recalculate` restarts the search from a settled state, so
             `calculating` — already searching — does not listen for it. -->
    <state id="enabled" initial="calculating" sce:exhaustive="false">
        <!-- H key from any sub-state disables hint system -->
        <transition event="toggle" target="disabled"/>

        <!-- Computing path to target -->
        <state id="calculating">
            <onentry>
                <script><cpp>secret.onCalculating()</cpp></script>
            </onentry>
            <transition event="path_found" target="showing"/>
            <transition event="no_path" target="no_path"/>
            <transition event="level_change" target="disabled"/>
        </state>

        <!-- Actively displaying floor arrows -->
        <state id="showing">
            <onentry>
                <script><cpp>secret.onShowing()</cpp></script>
            </onentry>
            <onexit>
                <script><cpp>secret.onExitShowing()</cpp></script>
            </onexit>
            <transition event="select" target="calculating"/>
            <transition event="recalculate" target="calculating"/>
            <transition event="secret_reached" target="found"/>
            <transition event="level_change" target="disabled"/>
        </state>

        <!-- Player reached the secret (keep showing path) -->
        <state id="found">
            <onentry>
                <script><cpp>secret.onFound()</cpp></script>
            </onentry>
            <onexit>
                <script><cpp>secret.onExitFound()</cpp></script>
            </onexit>
            <transition event="select" target="calculating"/>
            <transition event="recalculate" target="calculating"/>
            <transition event="level_change" target="disabled"/>
        </state>

        <!-- No accessible path to target -->
        <state id="no_path">
            <onentry>
                <script><cpp>secret.onNoPath()</cpp></script>
            </onentry>
            <transition event="select" target="calculating"/>
            <transition event="recalculate" target="calculating"/>
            <transition event="level_change" target="disabled"/>
        </state>
    </state>

</scxml>
