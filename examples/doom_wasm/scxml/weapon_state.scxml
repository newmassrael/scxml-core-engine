<?xml version="1.0" encoding="UTF-8"?>
<!--
  DOOM Weapon State Machine

  Models weapon action lifecycle and weapon switching.
  States: READY, RAISING, LOWERING, FIRING

  Syncs with DOOM's pspdef_t states:
  - upstate: Weapon raising animation
  - downstate: Weapon lowering animation
  - readystate: Weapon ready to fire
  - atkstate: Weapon firing animation

  C++ Integration:
  - Uses <cpp> tag for direct C++ function calls (Zero Overhead)
  - weapon.xxx() calls are transformed to user_->weapon.xxx()

  W3C SCXML 1.0 compliant
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="ready" datamodel="null">

    <!-- Ready state - weapon can fire or be switched -->
    <state id="ready">
        <onentry>
            <script><cpp>weapon.onReady()</cpp></script>
        </onentry>
        <transition event="fire" target="firing"/>
        <transition event="switch_weapon" target="lowering"/>
    </state>

    <!-- Lowering state - weapon moving down to switch -->
    <state id="lowering">
        <onentry>
            <script><cpp>weapon.onLowering()</cpp></script>
        </onentry>
        <transition event="lower_complete" target="raising"/>
    </state>

    <!-- Raising state - new weapon coming up -->
    <state id="raising">
        <onentry>
            <script><cpp>weapon.onRaising()</cpp></script>
        </onentry>
        <transition event="raise_complete" target="ready"/>
    </state>

    <!-- Firing state - weapon attacking -->
    <state id="firing">
        <onentry>
            <script><cpp>weapon.onFiring()</cpp></script>
        </onentry>
        <transition event="fire_complete" target="ready"/>
    </state>

</scxml>
