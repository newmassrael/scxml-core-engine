<!-- The executor wrote something for the request. The candidate itself is the host's; the
     machine says only whether this caller may write it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="schema_write"
       sce:event-name="write">
  <datamodel>
    <data id="holder" sce:type="string" sce:max-size="64" sce:direction="in"/>
    <data id="attempt" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
