<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCE Forge Extension Schema for W3C SCXML
  Namespace: http://sce.dev/ext

  Defines extension attributes and elements for the SCE kind system.
  W3C SCXML Section 3.1 explicitly allows foreign namespace attributes on any element.
  This schema validates Extended SCXML documents that use sce: namespace extensions.

  Usage:
    <scxml xmlns="http://www.w3.org/2005/07/scxml"
           xmlns:sce="http://sce.dev/ext"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
           sce:kind="statechart" ...>

  Covers:
    - SCE Forge (kind system, build-time codegen)
    - SCE Mesh  (transport QoS, runtime attributes)
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sce="http://sce.dev/ext"
           targetNamespace="http://sce.dev/ext"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- Agent-facing wire surface. The stability status below is
       machine-readable; see SCE_WIRE_CONTRACTS.md for the shared
       stability + deprecation policy across SCE wire surfaces. -->
  <xs:annotation>
    <xs:documentation>x-sce-schema-status: pre-release</xs:documentation>
  </xs:annotation>

  <!-- ═══════════════════════════════════════════════════════════════
       Simple Types
       ═══════════════════════════════════════════════════════════════ -->

  <!-- SCE Forge Section 3.2: Document-level and inline kind values -->
  <xs:simpleType name="kindType">
    <xs:restriction base="xs:string">
      <!-- Core kinds -->
      <xs:enumeration value="statechart"/>
      <xs:enumeration value="transform"/>
      <xs:enumeration value="lookup"/>
      <xs:enumeration value="condition"/>
      <xs:enumeration value="codec"/>
      <!-- peek-byte mode dispatch (RFC §synth-5-B) -->
      <xs:enumeration value="procedure"/>
      <xs:enumeration value="validator"/>
      <!-- Signal-processing kinds -->
      <xs:enumeration value="filter"/>
      <xs:enumeration value="interpolation"/>
      <xs:enumeration value="timer"/>
      <xs:enumeration value="observer"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-A (item A3) -->
      <xs:enumeration value="algorithm"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-C (item B6, MCU-class) -->
      <xs:enumeration value="link"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-E (item B7, MCU-class) -->
      <xs:enumeration value="buffer-pool"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-D (item C2, MCU-class) -->
      <xs:enumeration value="worker"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-L (item C6, Generic-class) -->
      <xs:enumeration value="bounded-collection"/>
      <!-- NL→IR Item C1 Path A — Closed set of named variants with
           1:1 wire-key values. Distinct from `lookup` by the
           bijectivity invariant on variant values. -->
      <xs:enumeration value="enum"/>
      <!-- NL→IR Mapping Roadmap Item C1 Path A — EventSchema kind.
           Typed contract for the `_event.data` payload of a named
           SCXML event. Carries the event name on the root via
           `sce:event-name`; declares typed `<data>` children that
           are read by transition `cond` expressions as
           `_event.data.<field>` and written via `<send>/<param>`
           payloads. Covers parse + receive/send-side typecheck +
           mesh DL-7'; `_event.data.<field>` reads lower natively
           on every backend. -->
      <xs:enumeration value="event-schema"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- NL→IR Mapping Roadmap Item C1 Path A — `sce:type` accepts
       primitive `sceType` values plus the `enum:<alias>` pattern
       referring to an imported `sce:kind="enum"` document. The
       pattern is the lexically authored token; cross-doc resolution
       against the document's `<sce:import>` table happens in the
       cross-kind binding pass, not at XSD validation time. -->
  <xs:simpleType name="sceTypeOrEnumRef">
    <xs:union memberTypes="sce:sceType">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="enum:[A-Za-z_][A-Za-z0-9_]*"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <!-- SCE Forge Section 3.3: Cross-language type system -->
  <xs:simpleType name="sceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="uint8"/>
      <xs:enumeration value="uint16"/>
      <xs:enumeration value="uint32"/>
      <xs:enumeration value="uint64"/>
      <xs:enumeration value="int8"/>
      <xs:enumeration value="int16"/>
      <xs:enumeration value="int32"/>
      <xs:enumeration value="int64"/>
      <xs:enumeration value="float32"/>
      <xs:enumeration value="float64"/>
      <xs:enumeration value="bool"/>
      <xs:enumeration value="string"/>
      <xs:enumeration value="bytes"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 3.3: Data flow direction -->
  <xs:simpleType name="directionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="in"/>
      <xs:enumeration value="out"/>
      <xs:enumeration value="internal"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 3.3: Byte order -->
  <xs:simpleType name="endianType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="big"/>
      <xs:enumeration value="little"/>
      <xs:enumeration value="native"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Codec field bit-size: fixed integer, "tail", "length-ref", or "vle".
       "vle" pairs with sce:type ∈ {uint16, uint32, uint64} and selects
       the base-128 variable-length encoding (RFC §synth-5-B App. B). -->
  <xs:simpleType name="bitSizeType">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:nonNegativeInteger"/>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="tail"/>
          <xs:enumeration value="length-ref"/>
          <xs:enumeration value="vle"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <!-- SCE Forge Section 4.8: Filter algorithm types -->
  <xs:simpleType name="filterType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="moving-average"/>
      <xs:enumeration value="low-pass"/>
      <xs:enumeration value="debounce"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.9: Interpolation method -->
  <xs:simpleType name="interpolationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="linear"/>
      <xs:enumeration value="bilinear"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.9: Out-of-bounds handling -->
  <xs:simpleType name="outOfBoundsType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="clamp"/>
      <xs:enumeration value="extrapolate"/>
      <xs:enumeration value="error"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.10: Timer scheduling type -->
  <xs:simpleType name="timerType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="periodic"/>
      <xs:enumeration value="timeout"/>
      <xs:enumeration value="delayed"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.11: Monitor type -->
  <xs:simpleType name="monitorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="threshold"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Duration with unit suffix (e.g., "100ms", "5s", "2000") -->
  <xs:simpleType name="durationType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+(\.\d+)?(ms|s|m|h)?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ═══════════════════════════════════════════════════════════════
       Attribute Declarations — SCE Forge (build-time codegen)
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Section 3.2: Kind selector — on <scxml> root or <data> elements -->
  <xs:attribute name="kind" type="sce:kindType"/>

  <!-- Section 3.3: Common data attributes — on <data> elements.
       NL→IR Item C1 Path A: accepts primitive `sceType` values plus
       the `enum:<alias>` pattern. Codec / lookup / etc. parsers
       reject the enum form at parse time when the surrounding kind
       does not support it; the wider XSD union keeps the global
       attribute declaration valid for the kinds that do. -->
  <xs:attribute name="type" type="sce:sceTypeOrEnumRef"/>
  <xs:attribute name="direction" type="sce:directionType"/>

  <!-- NL→IR Item C1 Path A — `sce:underlying-type` on a
       `sce:kind="enum"` `<scxml>` root names the fixed-width integer
       carrier (uint8/uint16/uint32/uint64/int8/int16/int32/int64) for
       the document's variant values. Free-form `sceType` at the XSD
       layer; the parser rejects the non-integer members of that type
       (see `validation/enum-unsupported-underlying-type`). -->
  <xs:attribute name="underlying-type" type="sce:sceType"/>

  <!-- NL→IR Item C1 Path A — `sce:strict-variants` on
       a `sce:kind="enum"` `<scxml>` root opts the enum out of the
       strict variant-membership check that runs over integer
       literals compared against (receive-side) or assigned to
       (send-side) an `enum:<alias>`-typed field. Defaults to `true`
       (strict): integer literals whose value is not one of the
       enum's declared `<sce:variant value="…"/>` set raise
       `validation/cross-kind-type-mismatch` (reused per Item 4
       precedent — no new wire code). Set to `false` for open-set
       status vocabularies (e.g. UDS NRC, OEM-extensible response
       codes) where wire-side values outside the declared set are
       legal. Width narrowing (`enum-underlying-overflow`) still
       runs regardless of this opt-out — overflow of the declared
       underlying type remains a wire-level error. -->
  <xs:attribute name="strict-variants" type="xs:boolean"/>

  <!-- NL→IR Mapping Roadmap Item C1 Path A — `sce:event-name` on a
       `sce:kind="event-schema"` `<scxml>` root names the SCXML event
       whose `_event.data` payload the schema constrains. Reserved
       W3C namespaces (`error.*`, `done.invoke.*`, `done.state.*`)
       are rejected by `parse_event_schema` (raises
       `validation/event-schema-on-builtin-event`). Free-form string
       at the XSD layer; semantic validation lives in sce-build. -->
  <xs:attribute name="event-name" type="xs:string"/>
  <xs:attribute name="unit" type="xs:string"/>
  <xs:attribute name="default" type="xs:string"/>
  <xs:attribute name="input" type="xs:string"/>
  <xs:attribute name="input-type" type="sce:sceType"/>

  <!-- NL→IR Mapping Roadmap Item 4: physical-quantity annotation. The
       triple `sce:quantity` / `sce:scale` / `sce:offset` declares a
       linear `physical = raw * scale + offset` conversion in the named
       unit. `sce:scale` and `sce:offset` must accompany `sce:quantity`
       (orphan declarations rejected at parse time); the rational
       grammar accepts integers, decimal fractions, and `<num>/<denom>`
       ratios. Strings are kept opaque at the XSD layer; semantic
       validation lives in sce-build (`parse_quantity_attrs`). -->
  <xs:attribute name="quantity" type="xs:string"/>
  <xs:attribute name="scale" type="xs:string"/>
  <xs:attribute name="offset" type="xs:string"/>

  <!-- Section 4.6: Codec — document-level default endianness -->
  <xs:attribute name="default-endian" type="sce:endianType"/>

  <!-- Section 4.6: Codec field layout — on <data> or <sce:field> -->
  <xs:attribute name="byte" type="xs:nonNegativeInteger"/>
  <xs:attribute name="bit-offset" type="xs:nonNegativeInteger"/>
  <xs:attribute name="bit-size" type="sce:bitSizeType"/>
  <xs:attribute name="endian" type="sce:endianType"/>
  <xs:attribute name="max-size" type="xs:nonNegativeInteger"/>
  <xs:attribute name="length" type="xs:nonNegativeInteger"/>
  <xs:attribute name="length-field" type="xs:string"/>

  <!-- RFC §synth-5-B present-if primitive (sce:present-if attribute).
       Predicate grammar v1: exactly `<field_id>.<flag_name>` — the
       referenced field must be a `<sce:flags>` carrier declared
       earlier in the same codec. Field shape (string typed at the XSD
       layer; semantic checks land in sce-build):
         - forward / unknown carrier → codec/present-if-refs-later-field
         - non-flags carrier or unknown flag → validation/invalid-attribute -->
  <xs:attribute name="present-if" type="xs:string"/>

  <!-- RFC §synth-5-B B3 DMA alignment primitive (sce:dma-burst-align attribute).
       Constrains the field's start offset within the encoded buffer to
       an N-byte boundary (typical N: 16, 32, 64). MCU-class — codecs
       containing this attribute emit only on Rust + C11 per the §synth-5-J-4
       matrix. The XSD type is positiveInteger; semantic checks land in
       sce-build (`parse_codec_field_from_node` rejects non-power-of-2
       N, `validate_codec_dma_alignment` rejects misaligned `sce:byte`
       and variable-length predecessors with
       `codec/dma-alignment-unsatisfiable`). -->
  <xs:attribute name="dma-burst-align" type="xs:positiveInteger"/>

  <!-- RFC §synth-5-B length-arith primitive (sce:length-arith attribute).
       Arithmetic offset on the length-field source value. Effective
       payload length is `sibling_value + length_arith` bytes.
       Authored as `sce:length-arith="+1"` or `sce:length-arith="-1"`
       paired with `sce:bit-size="length-ref"` + `sce:length-field="..."`.
       v1 grammar restricts to ±1 (parser rejects 0 and `|x|>1`);
       widening defers to a reachable consumer. First reachable
       consumer: zenoh-pico Scout/Hello/Init `zid` length packing
       (zid_len_m1 = actual_len - 1, decode reconstructs actual_len). -->
  <xs:attribute name="length-arith" type="xs:integer"/>

  <!-- RFC §synth-5-B — `sce:length-from="<sibling_field_id>"` on
       `<sce:embed>`. Bounds the embedded codec's decode-time cursor
       scope to the named earlier integer field's value. Mirrors
       zenoh-pico declarations.c:206 `_z_slice_as_zbuf` inner-cursor
       pattern. Author-trust on encode (sibling's wire value must
       match the embedded codec's emitted byte count). Validator
       (`validate_codec_embed_length_from`) rejects forward / unknown
       / non-integer references. -->
  <xs:attribute name="length-from" type="xs:string"/>

  <!-- RFC §synth-5-B B2 repeat primitive: <sce:repeat>-internal attributes
       (count / until-eof / max-count / type / id) live unqualified
       inside the <sce:repeat> element complexType — same convention
       as <sce:arm value/type> and <sce:flag name/bit> where attrs
       declared inside SCE-namespaced child elements stay unqualified.
       Globally-shared `sce:byte` (also on <sce:field> / <sce:flags>)
       remains qualified via the existing global declaration. -->


  <!-- Section 4.5: Procedure <send> hints -->
  <xs:attribute name="service" type="xs:string"/>
  <xs:attribute name="subfunc" type="xs:string"/>
  <xs:attribute name="addr" type="xs:string"/>
  <xs:attribute name="payload" type="xs:string"/>

  <!-- Section 4.7: Validator — data-attribute form (target format) -->
  <xs:attribute name="range-min" type="xs:string"/>
  <xs:attribute name="range-max" type="xs:string"/>
  <xs:attribute name="max-delta" type="xs:string"/>
  <xs:attribute name="sample-interval" type="sce:durationType"/>
  <xs:attribute name="plausibility" type="xs:string"/>

  <!-- Section 4.8: Filter — on output <data> element -->
  <xs:attribute name="filter" type="sce:filterType"/>
  <xs:attribute name="window" type="xs:positiveInteger"/>
  <xs:attribute name="alpha" type="xs:decimal"/>

  <!-- Section 4.9: Interpolation — on output <data> element -->
  <xs:attribute name="interpolation" type="sce:interpolationType"/>
  <xs:attribute name="out-of-bounds" type="sce:outOfBoundsType"/>
  <!--
    Axis breakpoint attributes follow the pattern sce:axis-{input_id}
    (e.g., sce:axis-rpm="800 1200 2000 3000").
    XSD 1.0 cannot express wildcard attribute names; these are validated
    by the sce-build parser at build time. Documents using sce:axis-*
    attributes remain schema-valid via xs:anyAttribute on the host element.
  -->

  <!-- Section 4.10: Timer — on <data> elements -->
  <xs:attribute name="timer" type="sce:timerType"/>
  <xs:attribute name="interval" type="xs:nonNegativeInteger"/>
  <xs:attribute name="duration" type="xs:nonNegativeInteger"/>
  <xs:attribute name="delay" type="xs:nonNegativeInteger"/>
  <xs:attribute name="event" type="xs:string"/>
  <xs:attribute name="on-timeout" type="xs:string"/>

  <!-- Section 4.11: Observer — on <data> elements -->
  <xs:attribute name="monitor" type="sce:monitorType"/>
  <xs:attribute name="enter" type="xs:string"/>
  <xs:attribute name="leave" type="xs:string"/>
  <xs:attribute name="on-enter" type="xs:string"/>
  <xs:attribute name="on-leave" type="xs:string"/>

  <!-- Section 5.F: build-time const-fold trigger. Declared globally so
       it carries the `sce:` prefix in instance documents (matching the
       RFC §synth-5-F worked example: `<sce:const sce:compute-at="build">`).
       Local `compute-at` declarations on individual elements would land
       unprefixed under the schema's `attributeFormDefault="unqualified"`
       and conflict with the parser's `sce_attr` lookup. -->
  <xs:attribute name="compute-at" type="xs:string"/>

  <!-- ═══════════════════════════════════════════════════════════════
       Attribute Declarations — SCE Mesh (runtime transport)
       ═══════════════════════════════════════════════════════════════ -->

  <xs:attribute name="qos" type="xs:string"/>
  <xs:attribute name="deadline" type="xs:string"/>
  <xs:attribute name="priority" type="xs:string"/>

  <!-- ═══════════════════════════════════════════════════════════════
       Element Declarations
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Section 5: Cross-file kind import. The optional
       <sce:variant-dispatch> child carries the parent-side dispatch
       inversion declaration: when the imported codec is a `<sce:variant>` codec,
       the parent uses this child to designate which of its own flags
       drives the variant's arm dispatch (dotted `<carrier>.<flag>`).
       Parent-local cross-doc validator confirms the named carrier and
       flag exist in the parent's own model. -->
  <xs:element name="import">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:variant-dispatch" minOccurs="0" maxOccurs="1"/>
        <!-- Flag inversion: parent-side flag-bind declarations
             supply values for the imported leaf's declared
             `<sce:flag-inputs>`. Each `<sce:flag-bind>` names one
             leaf-side input and a source on the parent (either a
             local flags-carrier flag in dotted form, or one of the
             parent's own `<sce:flag-input>` declarations by bare
             name for the chain-forwarder pattern). The cross-doc
             validator `validate_cross_codec_flag_bind` enforces
             binding-completeness, source resolution, width
             agreement, and carrier-before-embed ordering. -->
        <xs:element ref="sce:flag-bind" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="src" type="xs:string" use="required"/>
      <xs:attribute name="kind" type="sce:kindType" use="required"/>
      <xs:attribute name="as" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Dispatch inversion: parent-side variant-dispatch declaration.
       Dotted `flag="<carrier>.<flag>"` references one of the parent
       codec's own carriers and one of its declared flags. Cross-doc
       validator (`validate_cross_codec_variant_dispatch`) enforces
       carrier/flag existence, flag-width fit against the imported
       variant's arm count, no value= conflict on the dispatched flag,
       and carrier-before-embed declaration order. -->
  <xs:element name="variant-dispatch">
    <xs:complexType>
      <xs:attribute name="flag" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Flag inversion: parent-side `<sce:flag-bind>` directive
       (child of `<sce:import>`). The `input=` attribute names one of
       the imported leaf's declared `<sce:flag-input name="X" .../>`
       declarations. The `source=` attribute resolves via the dotted-
       form rule: `<carrier>.<flag>` references a local
       `<sce:flags id="X">` flag; bare name references one of the
       parent's own `<sce:flag-input>` declarations (chain-forwarder
       pattern). Cross-doc validator enforces resolution and width
       agreement. -->
  <xs:element name="flag-bind">
    <xs:complexType>
      <xs:attribute name="input" type="xs:NCName" use="required"/>
      <xs:attribute name="source" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Flag inversion: codec-level `<sce:flag-inputs>` block
       containing one or more `<sce:flag-input name="X" width="N"/>`
       child declarations. Each input becomes a positional typed
       parameter on the generated `decode`/`encode` signatures; the
       parent supplies values at import-site via `<sce:flag-bind>`.
       Owns the entire codec-to-codec flag-shaped dependency surface
       (the legacy `<sce:requires-parent-flags>` block is deleted —
       flag-inputs own this surface). -->
  <xs:element name="flag-inputs">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:flag-input" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Flag inversion: a single `<sce:flag-input>` child of
       `<sce:flag-inputs>`. The `name=` is the logical input name
       (referenced by `<sce:flag-bind input="X" .../>` at the parent's
       import site, and by `sce:present-if="X"` predicates in this
       codec's body). The `width=` is the bit-width — v1 lock-in
       fixes width=1 (multi-bit inputs defer to a reachable
       consumer). -->
  <xs:element name="flag-input">
    <xs:complexType>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="width" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- §synth-5-I `<sce:extern>` whitelisted intrinsic registry.
       Bounded escape hatch for platform-specific intrinsics
       (atomic CAS / fences / cache maintenance / IRQ control).
       The `name` is closed-set checked at parse time against the
       SCE-shipped baseline registry; `sig` and `abi` must match the
       registry entry's canonical values. The 4-code rejection family
       (`extern/symbol-not-in-whitelist`, `extern/abi-mismatch`,
       `extern/signature-mismatch`, `extern/ordering-unspecified`)
       fires through `crate::forge::extern_validator::validate_extern`. -->
  <xs:element name="extern">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="sig" type="xs:string" use="required"/>
      <xs:attribute name="abi" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="c"/>
            <xs:enumeration value="rust"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="crate" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- Section 4.3: Lookup key-value mapping entry -->
  <xs:element name="entry">
    <xs:complexType>
      <xs:attribute name="key" type="xs:string" use="required"/>
      <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>


  <!-- Section 4.6: Codec field definition with byte layout -->
  <xs:element name="field">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute ref="sce:type" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <xs:attribute ref="sce:bit-size" use="required"/>
      <xs:attribute ref="sce:bit-offset"/>
      <xs:attribute ref="sce:endian"/>
      <xs:attribute ref="sce:max-size"/>
      <xs:attribute ref="sce:length-field"/>
      <xs:attribute ref="sce:present-if"/>
      <xs:attribute ref="sce:dma-burst-align"/>
      <xs:attribute ref="sce:length-arith"/>
      <!-- NL→IR Mapping Roadmap Item 4: physical-quantity annotation. -->
      <xs:attribute ref="sce:quantity"/>
      <xs:attribute ref="sce:scale"/>
      <xs:attribute ref="sce:offset"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-B variant primitive

       Discriminated-union suffix on a codec. The `<sce:variant>` element
       sits under <datamodel> alongside <sce:field> declarations; its
       `tag` attribute references a sibling field (must be unsigned-int)
       whose decoded value selects an arm. Each `<sce:arm value="..."
       type="alias"/>` names an imported codec alias as the arm body;
       `<sce:default type="alias"/>` is the catch-all for unenumerated
       tag values. When no <sce:default> is declared and the arms don't
       cover the tag's value domain, the build fires
       `codec/variant-arm-unreachable`.

       Attributes are unqualified inside <sce:*> elements (matches the
       <sce:entry key/value> convention; SCE-namespaced attrs are
       reserved for the W3C-element host case like <data sce:byte=...>).
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="arm">
    <xs:complexType>
      <!-- Discriminator value (decimal or 0x-hex). Parser carries u64
           internally to fit any unsigned tag width up to uint64. -->
      <xs:attribute name="value" type="xs:string" use="required"/>
      <!-- Body codec alias; must resolve to an <sce:import as="alias"/>
           in the same document. Resolution happens at codegen time. -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <!-- RFC variant-default-uniformity: optional
           default="true" marker selects this arm as the body chosen
           by the outer codec's Default::default(). Parser enforces
           at-most-one per <sce:variant> via
           codec/variant-duplicate-default-arm. Distinct from the
           <sce:default> sibling element (unknown-tag catch-all). -->
      <xs:attribute name="default" type="xs:boolean" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- `<sce:variant>` serves three distinct purposes by host kind:

       1. **Codec discriminated-union suffix (RFC §synth-5-B)**
          Inside `<datamodel>` of `<scxml sce:kind="codec">` — carries
          `tag` attribute + `<sce:peek-byte>` / `<sce:arm>` /
          `<sce:default>` children. Parser `parse_codec_variant`
          enforces `tag` presence + arm shape.
       2. **Buffer-pool variant discriminator (RFC §synth-5-M)**
          Top-level child of `<scxml sce:kind="buffer-pool">` — carries
          plain text content `reassembly` (or `default`). Parser
          `parse_buffer_pool` enforces the closed enum + the three
          reassembly-only sibling elements.
       3. **Enum variant declaration (NL→IR Item C1 Path A)**
          Child of `<data>` inside `<scxml sce:kind="enum">` — carries
          `name` + `value` attributes. Parser `parse_enum` enforces
          the bijectivity invariant on `value` and uniqueness on `name`.

       The three contexts have disjoint surrounding scopes so there is
       no parse-time ambiguity. The XSD relaxes the global element type
       to permit ALL shapes — `mixed="true"` for text content, every
       attribute optional. The XSD remains a structural-only gate;
       semantic enforcement (codec's required `tag` + arms, buffer-
       pool's closed enum value + required siblings, enum's required
       `name` + `value` pair) is the parser's responsibility per
       `[[feedback-spec-mirror-parity]]`. -->
  <xs:element name="variant">
    <xs:complexType mixed="true">
      <xs:sequence>
        <!-- RFC §synth-5-B peek-byte mode:
             singleton `<sce:peek-byte>` child opts the variant into
             dispatch on the cursor's NEXT byte (read without
             advancing) instead of an own-codec field. Every arm
             body codec then reads the SAME byte as its first wire
             byte. When present, the variant's `tag` attribute MUST
             be the dotted form `<peek_id>.<flag>` referencing this
             element's `id` and one of its `<sce:flag>` children. -->
        <xs:element name="peek-byte" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="sce:flag" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:NCName" use="required"/>
            <!-- v1 fixed at uint8 (Zenoh single-byte network dispatch
                 pattern). Multi-byte peek surfaces as a separate
                 `<sce:peek-bytes>` primitive when a reachable
                 consumer surfaces. -->
            <xs:attribute ref="sce:type" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element ref="sce:arm" minOccurs="0" maxOccurs="unbounded"/>
        <!-- The local name `default` does not collide with the global
             <xs:attribute name="default"/> declared earlier; XSD
             attribute and element symbol spaces are independent. -->
        <xs:element name="default" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="type" type="xs:NCName" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <!-- Tag field id (codec context only) — must reference a sibling
           <sce:field>/<data> with an unsigned-int sce:type. Parser
           `parse_codec_variant` enforces presence + resolution. Item C9
           (RFC §synth-5-M) relaxes the XSD requirement to `optional` so the
           buffer-pool reassembly variant (text content `reassembly`,
           no `tag`) passes; `parse_buffer_pool` enforces the closed
           enum value. -->
      <xs:attribute name="tag" type="xs:string" use="optional"/>
      <!-- NL→IR Item C1 Path A — Enum variant attributes. `name` is
           the source-level identifier authors reference as
           `<EnumName>.<variant>`; `value` is the wire byte (decimal
           or 0x-prefixed hex). Both optional at the XSD layer; the
           enum-kind parser requires both. -->
      <xs:attribute name="name" type="xs:string" use="optional"/>
      <xs:attribute name="value" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-B flags primitive

       Named-bit-range accessor container over an unsigned-int carrier
       field. The `<sce:flags>` element occupies the same wire bytes as
       a plain `<sce:field>` of the same `sce:type` / `sce:byte` /
       `sce:bit-size`; its `<sce:flag name="X" bit="N" [width="W"]/>`
       children declare ergonomic per-bit-range get/set accessors that
       codegen emits alongside the generated struct. Bit positions are
       0 = LSB, `bit + width - 1 = MSB`. `width` defaults to 1 (the
       single-bit shape — getter/setter use bool); multi-bit
       (width >= 2) returns the smallest unsigned int type that fits.
       Bit-range overlap and `bit + width > carrier_bit_width` are
       rejected at parse time by sce-build.

       Attributes are unqualified on `<sce:flag>` (matches the
       `<sce:entry key/value>` and `<sce:arm value/type>` convention for
       attributes declared on SCE-namespaced child elements).
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="flag">
    <xs:complexType>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <!-- Bit position within the carrier (0 = LSB). Range bounded by
           the carrier's bit width: 0..7 for uint8, 0..15 for uint16,
           0..31 for uint32, 0..63 for uint64. Enforced by sce-build. -->
      <xs:attribute name="bit" type="xs:nonNegativeInteger" use="required"/>
      <!-- Multi-bit accessor: contiguous bit-range size. Defaults
           to 1 (the single-bit shape — bool getter/setter). When > 1
           the accessor returns the smallest unsigned integer type that
           fits the range. `bit + width <= carrier_bit_width` and no
           overlap with sibling flags — both enforced by sce-build. -->
      <xs:attribute name="width" type="xs:positiveInteger" use="optional"/>
      <!-- RFC variant-default-uniformity: optional
           wire-constant baked into the carrier's Default::default().
           Decimal or 0x-hex unsigned integer (parsed via parse_int_u64);
           sce-build rejects values that exceed `(1 << width) - 1`. Used
           by inner codecs that are referenced as a variant arm body so
           the codec's default instance is wire-valid for its own
           dispatch tag. -->
      <xs:attribute name="value" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="flags">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:flag" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute ref="sce:type" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <xs:attribute ref="sce:bit-size" use="required"/>
      <xs:attribute ref="sce:bit-offset"/>
      <xs:attribute ref="sce:endian"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-B B2 repeat primitive — `<sce:repeat>` element

       List-of-imported-codec field. Sits under <datamodel> alongside
       <sce:field> / <sce:flags> declarations; carries an imported
       codec alias (`sce:type=`) that names each element's
       encode/decode. The streaming codec iterates either a sibling
       integer field's decoded value (`sce:count="<id>"`) or
       cursor-exhaustion (`sce:until-eof="true"`); exactly one of the
       two MUST be present.

       `sce:type` here is locally redeclared as `xs:NCName` (the
       imported codec alias) — distinct from the document-level
       `sce:type` global which restricts to primitive `sceType` enum
       values. XSD attribute symbol spaces are scoped per-element so
       this redeclaration does not collide.

       Forward references and shape mismatches are sce-build
       diagnostics:
         - forward / unknown count target → codec/repeat-count-refs-later-field
         - non-integer count target / both or neither count form →
           validation/invalid-attribute
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="repeat">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <!-- Imported codec alias (matches an `<sce:import as=...>` in
           the same document); resolved at codegen time. Unqualified
           on <sce:repeat> (matches the <sce:arm type=...> shape;
           distinct from the global qualified `sce:type` which
           restricts to primitive sceType enum values). -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <!-- Mutually exclusive: exactly one of count / until-eof must
           appear. sce-build enforces; XSD allows either to keep the
           grammar declarative. -->
      <xs:attribute name="count" type="xs:string"/>
      <xs:attribute name="until-eof" type="xs:boolean"/>
      <xs:attribute name="max-count" type="xs:nonNegativeInteger"/>
      <!-- RFC §synth-5-B: present-if on the
           entire repeat block. When set, the count field MUST also
           carry the IDENTICAL `sce:present-if` predicate (co-gating
           contract enforced by `validate_codec_repeat_present_if_co_
           gating` — wire bytes for both count and elements appear or
           disappear atomically). Predicate grammar covers the
           `<carrier>.<flag>` (Local) and `parent.<flag>`
           (Parent) forms, with optional `!` negation. -->
      <xs:attribute ref="sce:present-if"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       TLV chain — RFC §synth-5-B B3 "TLV chain"

       Bounded extension list, each entry has id+len+body shape (the
       entry shape lives inside the imported entry codec, not enforced
       here). Iteratively decoded up to `max-depth`; residual bytes
       handled per `on-overflow`:

         <sce:tlv-chain id="extensions"
                        sce:type="TlvEntry"
                        sce:byte="2"
                        max-depth="8"
                        on-overflow="reject"/>

       MCU-class — codecs containing this element emit only on
       `(rust, *)` and `(c11, bare_metal)` per the §synth-5-J-4 matrix; on
       `{cpp, kotlin, go, python}` the codec is rejected with
       `codegen/mcu-class-kind-on-non-mcu-language` (the existing
       kind-class diagnostic, repurposed at codec-content granularity).

       `max-depth` is required (RFC line 488 "MUST be specified for
       MCU targets"); missing → typed
       `codec/tlv-chain-depth-unspecified`. `on-overflow` defaults to
       `reject`; `truncate` is the silent-drop opt-in. v1 rejects
       `diagnostic-event` (defers to a later B-stage when §synth-5-A
       diagnostic-event runtime infrastructure ships).

       Diagnostics:
         - missing max-depth → codec/tlv-chain-depth-unspecified
         - max-depth=0 → validation/invalid-attribute
         - on-overflow="diagnostic-event" / unknown value →
             validation/invalid-attribute
         - codec containing tlv-chain on a non-MCU language →
             codegen/mcu-class-kind-on-non-mcu-language
       ═══════════════════════════════════════════════════════════════ -->

  <!-- RFC §synth-5-B — `<sce:tlv-chain>` termination strategies. The
       default `exhaust-or-depth` ends the chain on cursor-exhaust +
       max-depth (used when nothing follows the chain on the wire).
       `entry-flag` reads a named flag on each decoded entry's flags
       carrier and stops the chain when the flag is clear — required
       when the wire stream has payload after the chain (zenoh-pico
       request body's query/put/del variant after the ext chain).
       The `entry-flag-name` attribute names the flag (mandatory when
       terminate-on="entry-flag"). -->
  <xs:simpleType name="tlvTerminateOnType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="exhaust-or-depth"/>
      <xs:enumeration value="entry-flag"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="tlv-chain">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <!-- Imported entry codec alias (matches an `<sce:import as=...>`
           in the same document); resolved at codegen time. Mirrors
           `<sce:repeat type=...>` / `<sce:arm type=...>` shape. -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <!-- max-depth is required by spec but kept XSD-optional so the
           dedicated `codec/tlv-chain-depth-unspecified` diagnostic
           fires (with the RFC-specific repair hint) rather than the
           generic `xml/schema-validation` "attribute required" form.
           sce-build/src/forge/parser.rs::parse_codec_tlv_chain_from_node
           rejects when missing. Mirrors the `<sce:repeat>` pattern
           where `count` / `until-eof` mutex is parser-enforced. -->
      <xs:attribute name="max-depth" type="xs:positiveInteger"/>
      <xs:attribute name="on-overflow" type="xs:string"/>
      <!-- RFC §synth-5-B — termination strategy + flag-name attribute.
           Default `exhaust-or-depth` ends on cursor-exhaust +
           max-depth (the item B3 tlv-chain shape). `entry-flag` reads `entry-flag-name`
           on each decoded entry's flags carrier and stops the chain
           when the flag is clear; required when the wire stream
           continues past the chain. Parser enforces flag-name
           presence when terminate-on="entry-flag". -->
      <xs:attribute name="terminate-on" type="sce:tlvTerminateOnType"/>
      <xs:attribute name="entry-flag-name" type="xs:string"/>
      <!-- RFC §synth-5-B — `<sce:tlv-chain sce:present-if="P">`
           gates the entire chain on a flag predicate (mirrors the
           repeat-with-present-if lift). When the predicate is
           false the chain field is absent from the wire; the
           host-language type wraps as a per-language optional
           (Option<Vec<T>> / std::optional<vector> / MutableList<T>?
           / bare []T (Go slice nilness) / Optional[List[T]] / C11
           carrier-bit-as-truth via _len=0). Required by zenoh-pico
           network MID bodies whose ext chain is Z-bit-gated on the
           per-MID header. -->
      <xs:attribute ref="sce:present-if"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-B — single-codec embed primitive

       Embeds an imported codec inline at the named byte position.
       The embedded codec's own decode/encode methods consume/produce
       bytes directly; the host language emits a nested struct of the
       imported codec's type. Mirrors `<sce:repeat>` / `<sce:tlv-chain>`
       tri-attr shape (id + type + sce:byte) plus two optional
       attributes that compose freely.

       First reachable consumer: zenoh-pico declare bodies
       (decl_keyexpr / decl_subscriber / decl_queryable / decl_token)
       embedding `codec_zenoh_wireexpr` after the body's VLE id field
       — Zenoh wire packs id + wireexpr inline with no length prefix
       between them, so the always-present cursor-direct shape exactly
       mirrors that wire layout.

       The two optional attributes:

         - `sce:present-if="<carrier>.<flag>" | "parent.<flag>" | "!..."`
           gates the embed on a runtime predicate (mirrors the
           present-if grammar used by `<sce:field>` and `<sce:repeat>`).
           When set the host-language type wraps in a per-language
           optional (Option<T> / std::optional<T> / T? / *T /
           Optional[T]). C11 keeps the bare struct member with
           carrier-bit-as-truth for presence (no nullable wrapper).

         - `sce:length-from="<sibling_field_id>"` bounds the embedded
           codec's decode-time cursor scope to the named earlier
           integer field's value (typical: a VLE total-length prefix).
           Encode side trusts the author to keep `self.<sibling> ==
           emitted_inner.len()` (mirrors the LengthRef author-trust
           contract). First reachable consumer: zenoh-pico
           `_z_decl_ext_keyexpr_encode` (declarations.c:38-50) where
           the outer envelope's VLE total_length prefix scopes the
           inner wireexpr-shaped body.

       Diagnostics (folded into validation/invalid-attribute):
         - sce:length-from references later/unknown sibling
         - sce:length-from references non-integer sibling
         - sce:present-if cross-field validation reuses the existing
           present-if predicate validators
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="embed">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <!-- Imported codec alias (matches an `<sce:import as=...>` in
           the same document); resolved at codegen time. Mirrors
           `<sce:repeat type=...>` / `<sce:tlv-chain type=...>` /
           `<sce:arm type=...>` shape. -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <!-- RFC §synth-5-B — optional present-if predicate gating the
           embed. Same grammar as `<sce:field sce:present-if>`. -->
      <xs:attribute ref="sce:present-if"/>
      <!-- RFC §synth-5-B — optional `sce:length-from="<id>"` bounds
           the embedded codec's decode-time cursor scope to the named
           sibling integer field's value. Author-trust on encode
           (sibling value must match emitted byte count). -->
      <xs:attribute ref="sce:length-from"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       Test vector — RFC §synth-5-B "Test vector" (B2-test-vector)

       Inline reference oracle declared as a top-level child of an
       algorithm <scxml> root:

         <sce:test-vector hex="313233343536373839" value="0x29B1"/>

       Both attributes are required; hex must be even-length hex-only;
       value is parsed in v1 as a boolean / signed-integer / unsigned-
       integer literal compatible with the algorithm's declared return
       type. v1 supports `sce:kind="algorithm"` only — declaring this
       element under any other kind rejects with
       `algorithm/test-vector-unsupported-kind`; codec multi-field
       test vectors defer to B5 alongside the Zenoh msg-set authoring.

       Diagnostics:
         - test-vector under non-algorithm kind →
             algorithm/test-vector-unsupported-kind
         - missing hex / value attribute → validation/missing-attribute
         - malformed hex / value literal → validation/invalid-attribute
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Algorithm form (B2): attribute `value=` declares the scalar
       expected return — content is empty.
       Codec form: nested `<sce:decoded field=...>` rows
       declare the field-by-field expected struct. The two forms are
       union'd via choice on the schema; the parser dispatches on
       `sce:kind` so an algorithm fixture with `<sce:decoded>` rows
       (or vice versa) rejects with a precise validation error
       upstream of XSD. -->
  <xs:element name="test-vector">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="sce:decoded"/>
      </xs:choice>
      <xs:attribute name="hex" type="xs:string" use="required"/>
      <!-- `value` is required for algorithm form (B2); codec form
           sets it via nested <sce:decoded> rows instead. The
           parser enforces the per-kind requirement; making `value`
           optional here keeps the XSD a structural surface and lets
           the kind-aware parser return the precise diagnostic. -->
      <xs:attribute name="value" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- RFC §synth-5-B codec test-vector field assignment. Shape:
       `<sce:decoded field="..." (value|hex|string)="..."/>`.
       Variant / TLV-chain / repeat sibling element names
       (`<sce:decoded-variant>`, `<sce:decoded-chain>`,
       `<sce:decoded-entry>`) are consumer-gated; only the leaf
       field form is declared. -->
  <xs:element name="decoded">
    <xs:complexType>
      <xs:attribute name="field" type="xs:string" use="required"/>
      <!-- Exactly one of value / hex / string must be set (the parser
           validates this — XSD's xs:choice across attributes is not
           expressible without elaborate typing tricks). -->
      <xs:attribute name="value" type="xs:string" use="optional"/>
      <xs:attribute name="hex" type="xs:string" use="optional"/>
      <xs:attribute name="string" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!--
    Section 4.7: Validator rules use data-attribute form only.
    Validation attributes (sce:range-min, sce:range-max, sce:max-delta,
    sce:sample-interval, sce:plausibility) are declared as global attributes
    above and applied directly to <data> elements.
  -->

  <!-- ═══════════════════════════════════════════════════════════════
       Composition extensions — sce:template / sce:use / sce:param
       (RFC §6.5, AOT-only)

       In normal build flow the sce-build template expander (Rust)
       eliminates every <sce:use> before the XSD validator runs, so
       these declarations act as schema self-awareness: they enable
       tooling (editor integrations, standalone template-file linters)
       to recognise the grammar. Structural correctness inside template
       files is still enforced at expansion time by
       sce-build/src/template.rs.
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Param-name pattern matches RFC §3.1. Mirrored by is_valid_param_name
       in sce-build/src/template.rs; keep the two in sync. -->
  <xs:simpleType name="paramNameType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Call site inside an SCXML document. The `template` attribute is
       the only reserved slot; every other attribute binds a parameter
       declared by the referenced template file. xs:anyAttribute
       (processContents="skip") captures param bindings without requiring
       them to be pre-declared — the expander validates them at build
       time against the template's <sce:param> declarations. -->
  <xs:element name="use">
    <xs:complexType>
      <xs:attribute name="template" type="xs:string" use="required"/>
      <xs:anyAttribute processContents="skip"/>
    </xs:complexType>
  </xs:element>

  <!-- Template declaration — root element of a standalone template file.
       Declared here so the schema is self-describing for tooling; template
       files themselves are not routed through this XSD in the build flow
       (the expander parses them directly).

       Content model: a single lax wildcard. The authoring shape is "zero or
       more <sce:param> declarations followed by body content" (RFC §3.1),
       but that ordering — and the <sce:param> grammar itself — is enforced
       by the expander (sce-build/src/template.rs), the sole SSOT for
       template structure. The XSD does NOT re-encode it: a named
       <sce:param> particle ahead of an `##any` wildcard makes the content
       model non-deterministic (XSD 1.0 Unique Particle Attribution
       violation), which strict schema processors (libxml2 >= 2.15) reject at
       schema-compile time. A lone wildcard is unambiguous, still admits any
       sce:* body element, and matches the algorithm-body elements below. -->
  <xs:element name="template">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Parameter declaration. Two roles:
       * Inside <sce:template>: name + (required | default), per RFC §3.1.
       * Inside <sce:signature> (algorithm kind, RFC §synth-5-A): name + type.
       The parser distinguishes by enclosing element; the schema permits
       both shapes via separate optional attributes. -->
  <xs:element name="param">
    <xs:complexType>
      <xs:attribute name="name" type="sce:paramNameType" use="required"/>
      <xs:attribute name="required" type="xs:boolean"/>
      <xs:attribute name="default" type="xs:string"/>
      <!-- RFC §synth-5-A signature param: by-value scalar or by-reference bytes. -->
      <xs:attribute name="type" type="sce:sceType"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       Algorithm kind body (SCE Protocol-Synthesis RFC §synth-5-A item A3)

       Pure synchronous functions with bounded loops and mutable
       locals. Body statements are <sce:var>/<sce:assign>/<sce:if>/
       <sce:while>/<sce:foreach>/<sce:return>/<sce:call>; nested
       blocks recurse via xs:any lax. The parser
       (`forge::parser::parse_algorithm`) enforces structural
       constraints (e.g. statement order, max-iter on while, l-value
       shape on assign). The schema only declares element/attribute
       presence so libxml2 stops accepting freeform body markup.
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="signature">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="return">
    <xs:complexType>
      <!-- type=  inside <sce:signature>; expr=  inside body. The two
           are not mutually exclusive at schema level — the parser
           rejects `<sce:return type expr/>` collisions. -->
      <xs:attribute name="type" type="sce:sceType"/>
      <xs:attribute name="expr" type="xs:string"/>
      <!-- SCE byte-buffer-build (SCE_FORGE.md §4.12): fixed output-buffer
           capacity for a `type="bytes"` return. Required by the parser when
           the return type is `bytes` (the no-alloc profile's bound); ignored
           otherwise. Mirrors `<sce:helper returns-max-size>`. -->
      <xs:attribute name="returns-max-size" type="xs:positiveInteger"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="body">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--
    Local binding. A scalar local carries `init=` (required by the parser).

    SCE byte-buffer-build (SCE_FORGE.md §4.12): a `type="bytes"` local is a
    growable output buffer instead — it carries `capacity=` (the fixed bound)
    and NO `init=` (it starts empty and is filled forward-only via
    `<sce:append>`). `init` is therefore relaxed from `use="required"` to
    optional at schema level; the parser enforces "scalar ⇒ init, bytes ⇒
    capacity, no init" with a precise structural diagnostic.
  -->
  <xs:element name="var">
    <xs:complexType>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="type" type="sce:sceType" use="required"/>
      <xs:attribute name="init" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:positiveInteger"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="assign">
    <xs:complexType>
      <xs:attribute name="target" type="xs:string" use="required"/>
      <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    SCE byte-buffer-build (SCE_FORGE.md §4.12): forward-only append to a
    `type="bytes"` buffer local. `target` is the buffer's name; `expr` lowers
    by its static type — a `uint8` value pushes one byte, a `bytes` value
    extends the buffer. Index writes (`buf[i]=x`) are deliberately excluded;
    `<sce:append>` is the only buffer-mutation statement.
  -->
  <xs:element name="append">
    <xs:complexType>
      <xs:attribute name="target" type="xs:string" use="required"/>
      <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="if">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="cond" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="else">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="while">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="cond" type="xs:string" use="required"/>
      <xs:attribute name="max-iter" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="foreach">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="item" type="xs:NCName" use="required"/>
      <xs:attribute name="in" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    Build-time const (RFC §synth-5-A scalar form, RFC §synth-5-F build-time fold form).

    Two shapes accepted by `forge::parser::parse_algorithm_const`:

      Scalar (RFC §synth-5-A v1):
        <sce:const name="N" type="uint16" init="0xFFFF"/>

      Build-time array (RFC §synth-5-F):
        <sce:const name="TABLE" type="array<u16, 256>" sce:compute-at="build">
          <sce:fold range="0..256" as="i" elem-type="u16">
            ...statements...
            <sce:yield expr="..."/>
          </sce:fold>
        </sce:const>

    `type` is relaxed from `sce:sceType` (scalar enum) to `xs:string` so
    the `array<elem, len>` form passes XSD validation; the parser
    rejects ill-formed values with a precise diagnostic.

    `init` is no longer `use="required"` — the parser enforces "exactly
    one of `init=` or `<sce:fold>` body" with a structural diagnostic
    that is more useful than a missing-attribute error from XSD.
  -->
  <xs:element name="const">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:fold" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="init" type="xs:string"/>
      <xs:attribute ref="sce:compute-at"/>
    </xs:complexType>
  </xs:element>

  <!--
    RFC §synth-5-F build-time fold body. `range="START..END"` is exclusive
    upper-bound; `as` names the loop variable; `elem-type` is the
    yielded element's scalar type. The terminal `<sce:yield>` carries
    the per-iteration expression.
  -->
  <xs:element name="fold">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="range" type="xs:string" use="required"/>
      <xs:attribute name="as" type="xs:NCName" use="required"/>
      <xs:attribute name="elem-type" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- RFC §synth-5-F: terminal element of an `<sce:fold>` body. -->
  <xs:element name="yield">
    <xs:complexType>
      <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="call">
    <xs:complexType>
      <xs:attribute name="target" type="xs:NCName" use="required"/>
      <xs:attribute name="args" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-C (item B6, MCU-class): byte-stream link
    endpoint declared via `<scxml sce:kind="link">`. This surface is
    the minimum vertical slice that exercises the rust codegen path:
    `<sce:link-class>` enum body + `<sce:framer ref="..."/>` (required) +
    `<sce:backpressure>` + `<sce:events>` rows. `<sce:rx-pool>` /
    `<sce:tx-pool>` defer to B7's buffer-pool kind.
  -->

  <!-- RFC §synth-5-C link-class enumeration. Five strings shipped today;
       OS-specific classes (e.g. `unix_socket`, `qnx_msg`) land
       additively in later phases. -->
  <xs:simpleType name="linkClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="udp"/>
      <xs:enumeration value="tcp"/>
      <xs:enumeration value="serial"/>
      <xs:enumeration value="websocket"/>
      <xs:enumeration value="raw_eth"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- RFC §synth-5-C backpressure policy. -->
  <xs:simpleType name="backpressureType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="drop"/>
      <xs:enumeration value="block"/>
      <xs:enumeration value="signal-event"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="link-class">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="sce:linkClassType"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="framer">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="backpressure">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="sce:backpressureType"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="inbound">
    <xs:complexType>
      <xs:attribute name="event" type="xs:string" use="required"/>
      <xs:attribute name="when" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="outbound">
    <xs:complexType>
      <xs:attribute name="event" type="xs:string" use="required"/>
      <xs:attribute name="encode" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="events">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="sce:inbound"/>
          <xs:element ref="sce:outbound"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-E: link-side `<sce:rx-pool>`
    / `<sce:tx-pool>` reference a `<scxml sce:kind="buffer-pool">`
    sibling document by name. The cross-resolution validator
    (`link/pool-slot-smaller-than-framer-max`) wires pool ↔ framer
    through `compile_forge_with_imports`.
  -->
  <xs:element name="rx-pool">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="tx-pool">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-E sample-callback surface: link-side `<sce:stage-pool>`
    references a `<scxml sce:kind="buffer-pool">` sibling document by
    name. Single source of truth for `Sample::take()`'s stage-copy
    destination, co-located with `<sce:rx-pool>` / `<sce:tx-pool>` on
    the link kind. SCXML on-sample validators
    (`validate_on_sample_link_references`) consult the build's
    `SceCrossDocRegistry` to decide whether `pool/sample-take-without-
    stage-pool` fires for a state's `<sce:on-sample link="X">`.
  -->
  <xs:element name="stage-pool">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-E (item B7, MCU-class): SRAM-placed,
    DMA-aligned slot table declared via `<scxml sce:kind="buffer-pool">`.
    The schema here is the minimum vertical slice; the 7-state
    lifecycle FSM and cache-maintenance pinning are realised by the
    buffer-pool codegen (`sce-build/src/forge/buffer_pool_fsm.rs` +
    the per-backend buffer_pool templates).
  -->

  <!-- RFC §synth-5-E lines 948-957 cache-policy enumeration. -->
  <xs:simpleType name="cachePolicyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="maintain"/>
      <xs:enumeration value="non-cacheable"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="slot-count">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="slot-size">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="section">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="alignment">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="dma-channel">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="cache-policy">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="sce:cachePolicyType"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-M reassembly-variant buffer-pool fields (item C9)

       Three sibling elements required when
       `<sce:variant>reassembly</sce:variant>` is declared on a
       `<scxml sce:kind="buffer-pool">` document. Parser-side
       enforcement (`parse_buffer_pool` rejects missing or zero values)
       via `mem/reassembly-pool-variant-missing-max-fragments` +
       `mem/reassembly-pool-variant-missing-timeout` codes. Cross-doc
       validators that read `<sce:per-peer-quota>` against §synth-5-K's
       `peer_table.capacity` (build-time invariant
       `peer_table.capacity × per-peer-quota ≥ slot_count`) run at
       deploy time (`sce-build/src/mesh/deploy.rs`).
       ═══════════════════════════════════════════════════════════════ -->
  <xs:element name="max-fragments-per-message">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="reassembly-timeout-ms">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="per-peer-quota">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-D (item C2, MCU-class): Worker kind declared
    via `<scxml sce:kind="worker">`. The schema vertical slice covers
    the four worker body elements:
      - <sce:link-rx ref="..."/>  required driving link kind reference
      - <sce:inbox depth="N"/>    required SPSC ring-buffer depth
      - <sce:outbox ref="..."/>   optional recipient inbox path
      - <sce:body>...</sce:body>  optional SCXML actions (usually empty)
    Cross-resolution + ordering validators live in sce-build
    (`worker/link-rx-ref-unknown`, `worker/inbox-ordering-unspecified`);
    the XSD enforces structural shape only.
  -->
  <xs:element name="link-rx">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="inbox">
    <xs:complexType>
      <xs:attribute name="depth" type="xs:positiveInteger" use="required"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-I lines 1752-1758: SPSC inbox
           ordering choice. Spec phrasing labels missing-ordering a
           "warning"; SCE's error-only wire realizes the warning as a
           required-when-worker-exists error (parse-time
           `worker/inbox-ordering-unspecified`), so the XSD shape stays
           optional and the Rust parser enforces presence with a typed
           diagnostic that names the choice axes. The XSD enum closes
           the accepted set to `acq_rel` | `relaxed` so foreign values
           reject at schema validation time rather than reaching the
           parser's `InvalidAttribute` fallback. -->
      <xs:attribute name="ordering" use="optional">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="acq_rel"/>
            <xs:enumeration value="relaxed"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="outbox">
    <xs:complexType>
      <!-- `ref` carries the recipient namespace; spec line 895 example
           `session_fsm.inbox` uses dot notation, so `xs:string` rather
           than the NCName restriction the pool-side refs use. -->
      <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- SCE Protocol-Synthesis RFC §synth-5-E sample-callback: SCXML state-level
       subscriber declaration. Lifts the spec line 1269 callback
       contract ("the subscriber callback receives `&Sample<'_>`")
       into a state-scoped `<sce:on-sample link="X" event="E"/>`
       parser-AST extension; attributes are link + event (both
       required). Cross-reference resolution against the forge link
       kind registry runs in `validate_on_sample_link_references`.
       The optional `callback="rust:crate::path::fn"` extern
       reference attribute: codegen wires the path into
       the dispatch shim with a borrow-mode call site. XSD enforces
       attribute presence shape only; the language-prefixed Rust path
       subset is checked by the Rust validator
       `validate_on_sample_callback_paths` so the diagnostic message
       can name specific path-syntax mistakes per
       `pool/sample-callback-signature-non-borrow`. -->
  <xs:element name="on-sample">
    <xs:complexType>
      <xs:attribute name="link" type="xs:string" use="required"/>
      <xs:attribute name="event" type="xs:string" use="required"/>
      <xs:attribute name="callback" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- SCE Protocol-Synthesis RFC §5.2: top-level driver-header
       reference. Allowed only as a direct child of `<scxml>` root;
       the C11 backend emits `#include "<resolved>"`
       at the top of the generated `*_sm.c` so cross-TU symbol
       resolution is handled by the C compiler. `href`
       is required; the parser resolves it against
       `deploy.yaml`'s `platform.driver_root` (or the SCXML file's
       parent directory as fallback). Unresolved paths surface
       `mcu/driver-header-not-found`. The SCXML root content model
       in `sce-forge.xsd` is `xs:any namespace="##any" lax` so XSD
       cannot strictly forbid misplacement; downstream codegen only
       consumes top-level instances, matching the W3C lax-anywhere
       pattern. -->
  <xs:element name="driver">
    <xs:complexType>
      <xs:attribute name="href" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
