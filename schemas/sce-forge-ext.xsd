<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCE Forge Extension Schema for W3C SCXML
  Namespace: http://sce.dev/ext

  Defines extension attributes and elements for the SCE kind system.
  W3C SCXML Section 3.1 explicitly allows foreign namespace attributes on any element.
  This schema validates Extended SCXML documents that use sce: namespace extensions.

  Usage:
    <scxml xmlns="http://www.w3.org/2005/07/scxml"
           xmlns:sce="http://sce.dev/ext"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
           sce:kind="statechart" ...>

  Covers:
    - SCE Forge (kind system, build-time codegen)
    - SCE Mesh  (transport QoS, runtime attributes)
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sce="http://sce.dev/ext"
           targetNamespace="http://sce.dev/ext"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- ═══════════════════════════════════════════════════════════════
       Simple Types
       ═══════════════════════════════════════════════════════════════ -->

  <!-- SCE Forge Section 3.2: Document-level and inline kind values -->
  <xs:simpleType name="kindType">
    <xs:restriction base="xs:string">
      <!-- Phase 1 -->
      <xs:enumeration value="statechart"/>
      <xs:enumeration value="transform"/>
      <xs:enumeration value="lookup"/>
      <xs:enumeration value="condition"/>
      <xs:enumeration value="codec"/>
      <!-- Phase 2 -->
      <xs:enumeration value="procedure"/>
      <xs:enumeration value="validator"/>
      <!-- Phase 3 -->
      <xs:enumeration value="filter"/>
      <xs:enumeration value="interpolation"/>
      <xs:enumeration value="timer"/>
      <xs:enumeration value="observer"/>
      <!-- watching-zenoh RFC §5.A (Phase A3) -->
      <xs:enumeration value="algorithm"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 3.3: Cross-language type system -->
  <xs:simpleType name="sceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="uint8"/>
      <xs:enumeration value="uint16"/>
      <xs:enumeration value="uint32"/>
      <xs:enumeration value="uint64"/>
      <xs:enumeration value="int8"/>
      <xs:enumeration value="int16"/>
      <xs:enumeration value="int32"/>
      <xs:enumeration value="int64"/>
      <xs:enumeration value="float32"/>
      <xs:enumeration value="float64"/>
      <xs:enumeration value="bool"/>
      <xs:enumeration value="string"/>
      <xs:enumeration value="bytes"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 3.3: Data flow direction -->
  <xs:simpleType name="directionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="in"/>
      <xs:enumeration value="out"/>
      <xs:enumeration value="internal"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 3.3: Byte order -->
  <xs:simpleType name="endianType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="big"/>
      <xs:enumeration value="little"/>
      <xs:enumeration value="native"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Codec field bit-size: fixed integer, "tail", "length-ref", or "vle".
       "vle" pairs with sce:type ∈ {uint16, uint32, uint64} and selects
       the base-128 variable-length encoding (RFC §5.B App. B). -->
  <xs:simpleType name="bitSizeType">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:nonNegativeInteger"/>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="tail"/>
          <xs:enumeration value="length-ref"/>
          <xs:enumeration value="vle"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <!-- SCE Forge Section 4.8: Filter algorithm types -->
  <xs:simpleType name="filterType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="moving-average"/>
      <xs:enumeration value="low-pass"/>
      <xs:enumeration value="debounce"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.9: Interpolation method -->
  <xs:simpleType name="interpolationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="linear"/>
      <xs:enumeration value="bilinear"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.9: Out-of-bounds handling -->
  <xs:simpleType name="outOfBoundsType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="clamp"/>
      <xs:enumeration value="extrapolate"/>
      <xs:enumeration value="error"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.10: Timer scheduling type -->
  <xs:simpleType name="timerType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="periodic"/>
      <xs:enumeration value="timeout"/>
      <xs:enumeration value="delayed"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.11: Monitor type -->
  <xs:simpleType name="monitorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="threshold"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Duration with unit suffix (e.g., "100ms", "5s", "2000") -->
  <xs:simpleType name="durationType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+(\.\d+)?(ms|s|m|h)?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ═══════════════════════════════════════════════════════════════
       Attribute Declarations — SCE Forge (build-time codegen)
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Section 3.2: Kind selector — on <scxml> root or <data> elements -->
  <xs:attribute name="kind" type="sce:kindType"/>

  <!-- Section 3.3: Common data attributes — on <data> elements -->
  <xs:attribute name="type" type="sce:sceType"/>
  <xs:attribute name="direction" type="sce:directionType"/>
  <xs:attribute name="unit" type="xs:string"/>
  <xs:attribute name="default" type="xs:string"/>
  <xs:attribute name="input" type="xs:string"/>
  <xs:attribute name="input-type" type="sce:sceType"/>

  <!-- Section 4.6: Codec — document-level default endianness -->
  <xs:attribute name="default-endian" type="sce:endianType"/>

  <!-- Section 4.6: Codec field layout — on <data> or <sce:field> -->
  <xs:attribute name="byte" type="xs:nonNegativeInteger"/>
  <xs:attribute name="bit-offset" type="xs:nonNegativeInteger"/>
  <xs:attribute name="bit-size" type="sce:bitSizeType"/>
  <xs:attribute name="endian" type="sce:endianType"/>
  <xs:attribute name="max-size" type="xs:nonNegativeInteger"/>
  <xs:attribute name="length" type="xs:nonNegativeInteger"/>
  <xs:attribute name="length-field" type="xs:string"/>

  <!-- RFC §5.B B1-δ present-if primitive (sce:present-if attribute).
       Predicate grammar v1: exactly `<field_id>.<flag_name>` — the
       referenced field must be a `<sce:flags>` carrier declared
       earlier in the same codec. Field shape (string typed at the XSD
       layer; semantic checks land in sce-build):
         - forward / unknown carrier → codec/present-if-refs-later-field
         - non-flags carrier or unknown flag → validation/invalid-attribute -->
  <xs:attribute name="present-if" type="xs:string"/>

  <!-- RFC §5.B B3 DMA alignment primitive (sce:dma-burst-align attribute).
       Constrains the field's start offset within the encoded buffer to
       an N-byte boundary (typical N: 16, 32, 64). MCU-class — codecs
       containing this attribute emit only on Rust + C11 per the §5.J.4
       matrix. The XSD type is positiveInteger; semantic checks land in
       sce-build (`parse_codec_field_from_node` rejects non-power-of-2
       N, `validate_codec_dma_alignment` rejects misaligned `sce:byte`
       and variable-length predecessors with
       `codec/dma-alignment-unsatisfiable`). -->
  <xs:attribute name="dma-burst-align" type="xs:positiveInteger"/>

  <!-- RFC §5.B B2 repeat primitive: <sce:repeat>-internal attributes
       (count / until-eof / max-count / type / id) live unqualified
       inside the <sce:repeat> element complexType — same convention
       as <sce:arm value/type> and <sce:flag name/bit> where attrs
       declared inside SCE-namespaced child elements stay unqualified.
       Globally-shared `sce:byte` (also on <sce:field> / <sce:flags>)
       remains qualified via the existing global declaration. -->


  <!-- Section 4.5: Procedure <send> hints -->
  <xs:attribute name="service" type="xs:string"/>
  <xs:attribute name="subfunc" type="xs:string"/>
  <xs:attribute name="addr" type="xs:string"/>
  <xs:attribute name="payload" type="xs:string"/>

  <!-- Section 4.7: Validator — data-attribute form (target format) -->
  <xs:attribute name="range-min" type="xs:string"/>
  <xs:attribute name="range-max" type="xs:string"/>
  <xs:attribute name="max-delta" type="xs:string"/>
  <xs:attribute name="sample-interval" type="sce:durationType"/>
  <xs:attribute name="plausibility" type="xs:string"/>

  <!-- Section 4.8: Filter — on output <data> element -->
  <xs:attribute name="filter" type="sce:filterType"/>
  <xs:attribute name="window" type="xs:positiveInteger"/>
  <xs:attribute name="alpha" type="xs:decimal"/>

  <!-- Section 4.9: Interpolation — on output <data> element -->
  <xs:attribute name="interpolation" type="sce:interpolationType"/>
  <xs:attribute name="out-of-bounds" type="sce:outOfBoundsType"/>
  <!--
    Axis breakpoint attributes follow the pattern sce:axis-{input_id}
    (e.g., sce:axis-rpm="800 1200 2000 3000").
    XSD 1.0 cannot express wildcard attribute names; these are validated
    by the sce-build parser at build time. Documents using sce:axis-*
    attributes remain schema-valid via xs:anyAttribute on the host element.
  -->

  <!-- Section 4.10: Timer — on <data> elements -->
  <xs:attribute name="timer" type="sce:timerType"/>
  <xs:attribute name="interval" type="xs:nonNegativeInteger"/>
  <xs:attribute name="duration" type="xs:nonNegativeInteger"/>
  <xs:attribute name="delay" type="xs:nonNegativeInteger"/>
  <xs:attribute name="event" type="xs:string"/>
  <xs:attribute name="on-timeout" type="xs:string"/>

  <!-- Section 4.11: Observer — on <data> elements -->
  <xs:attribute name="monitor" type="sce:monitorType"/>
  <xs:attribute name="enter" type="xs:string"/>
  <xs:attribute name="leave" type="xs:string"/>
  <xs:attribute name="on-enter" type="xs:string"/>
  <xs:attribute name="on-leave" type="xs:string"/>

  <!-- Section 5.F: build-time const-fold trigger. Declared globally so
       it carries the `sce:` prefix in instance documents (matching the
       RFC §5.F worked example: `<sce:const sce:compute-at="build">`).
       Local `compute-at` declarations on individual elements would land
       unprefixed under the schema's `attributeFormDefault="unqualified"`
       and conflict with the parser's `sce_attr` lookup. -->
  <xs:attribute name="compute-at" type="xs:string"/>

  <!-- ═══════════════════════════════════════════════════════════════
       Attribute Declarations — SCE Mesh (runtime transport)
       ═══════════════════════════════════════════════════════════════ -->

  <xs:attribute name="qos" type="xs:string"/>
  <xs:attribute name="deadline" type="xs:string"/>
  <xs:attribute name="priority" type="xs:string"/>

  <!-- ═══════════════════════════════════════════════════════════════
       Element Declarations
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Section 5: Cross-file kind import -->
  <xs:element name="import">
    <xs:complexType>
      <xs:attribute name="src" type="xs:string" use="required"/>
      <xs:attribute name="kind" type="sce:kindType" use="required"/>
      <xs:attribute name="as" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Section 4.3: Lookup key-value mapping entry -->
  <xs:element name="entry">
    <xs:complexType>
      <xs:attribute name="key" type="xs:string" use="required"/>
      <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Section 4.6: Codec field definition with byte layout -->
  <xs:element name="field">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute ref="sce:type" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <xs:attribute ref="sce:bit-size" use="required"/>
      <xs:attribute ref="sce:bit-offset"/>
      <xs:attribute ref="sce:endian"/>
      <xs:attribute ref="sce:max-size"/>
      <xs:attribute ref="sce:length-field"/>
      <xs:attribute ref="sce:present-if"/>
      <xs:attribute ref="sce:dma-burst-align"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §5.B variant primitive (B1-β)

       Discriminated-union suffix on a codec. The `<sce:variant>` element
       sits under <datamodel> alongside <sce:field> declarations; its
       `tag` attribute references a sibling field (must be unsigned-int)
       whose decoded value selects an arm. Each `<sce:arm value="..."
       type="alias"/>` names an imported codec alias as the arm body;
       `<sce:default type="alias"/>` is the catch-all for unenumerated
       tag values. When no <sce:default> is declared and the arms don't
       cover the tag's value domain, the build fires
       `codec/variant-arm-unreachable`.

       Attributes are unqualified inside <sce:*> elements (matches the
       <sce:entry key/value> convention; SCE-namespaced attrs are
       reserved for the W3C-element host case like <data sce:byte=...>).
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="arm">
    <xs:complexType>
      <!-- Discriminator value (decimal or 0x-hex). Parser carries u64
           internally to fit any unsigned tag width up to uint64. -->
      <xs:attribute name="value" type="xs:string" use="required"/>
      <!-- Body codec alias; must resolve to an <sce:import as="alias"/>
           in the same document. Resolution happens at codegen time. -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="variant">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:arm" minOccurs="0" maxOccurs="unbounded"/>
        <!-- The local name `default` does not collide with the global
             <xs:attribute name="default"/> declared earlier; XSD
             attribute and element symbol spaces are independent. -->
        <xs:element name="default" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="type" type="xs:NCName" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <!-- Tag field id; must reference a sibling <sce:field>/<data> with
           an unsigned-int sce:type. Validated by sce-build. -->
      <xs:attribute name="tag" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §5.B B1-γ + B5-α flags primitive

       Named-bit-range accessor container over an unsigned-int carrier
       field. The `<sce:flags>` element occupies the same wire bytes as
       a plain `<sce:field>` of the same `sce:type` / `sce:byte` /
       `sce:bit-size`; its `<sce:flag name="X" bit="N" [width="W"]/>`
       children declare ergonomic per-bit-range get/set accessors that
       codegen emits alongside the generated struct. Bit positions are
       0 = LSB, `bit + width - 1 = MSB`. `width` defaults to 1 (B1-γ
       single-bit shape — getter/setter use bool); B5-α multi-bit
       (width >= 2) returns the smallest unsigned int type that fits.
       Bit-range overlap and `bit + width > carrier_bit_width` are
       rejected at parse time by sce-build.

       Attributes are unqualified on `<sce:flag>` (matches the
       `<sce:entry key/value>` and `<sce:arm value/type>` convention for
       attributes declared on SCE-namespaced child elements).
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="flag">
    <xs:complexType>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <!-- Bit position within the carrier (0 = LSB). Range bounded by
           the carrier's bit width: 0..7 for uint8, 0..15 for uint16,
           0..31 for uint32, 0..63 for uint64. Enforced by sce-build. -->
      <xs:attribute name="bit" type="xs:nonNegativeInteger" use="required"/>
      <!-- B5-α multi-bit accessor: contiguous bit-range size. Defaults
           to 1 (single-bit B1-γ shape — bool getter/setter). When > 1
           the accessor returns the smallest unsigned integer type that
           fits the range. `bit + width <= carrier_bit_width` and no
           overlap with sibling flags — both enforced by sce-build. -->
      <xs:attribute name="width" type="xs:positiveInteger" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="flags">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:flag" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute ref="sce:type" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <xs:attribute ref="sce:bit-size" use="required"/>
      <xs:attribute ref="sce:bit-offset"/>
      <xs:attribute ref="sce:endian"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §5.B B2 repeat primitive — `<sce:repeat>` element

       List-of-imported-codec field. Sits under <datamodel> alongside
       <sce:field> / <sce:flags> declarations; carries an imported
       codec alias (`sce:type=`) that names each element's
       encode/decode. The streaming codec iterates either a sibling
       integer field's decoded value (`sce:count="<id>"`) or
       cursor-exhaustion (`sce:until-eof="true"`); exactly one of the
       two MUST be present.

       `sce:type` here is locally redeclared as `xs:NCName` (the
       imported codec alias) — distinct from the document-level
       `sce:type` global which restricts to primitive `sceType` enum
       values. XSD attribute symbol spaces are scoped per-element so
       this redeclaration does not collide.

       Forward references and shape mismatches are sce-build
       diagnostics:
         - forward / unknown count target → codec/repeat-count-refs-later-field
         - non-integer count target / both or neither count form →
           validation/invalid-attribute
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="repeat">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <!-- Imported codec alias (matches an `<sce:import as=...>` in
           the same document); resolved at codegen time. Unqualified
           on <sce:repeat> (matches the <sce:arm type=...> shape;
           distinct from the global qualified `sce:type` which
           restricts to primitive sceType enum values). -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <!-- Mutually exclusive: exactly one of count / until-eof must
           appear. sce-build enforces; XSD allows either to keep the
           grammar declarative. -->
      <xs:attribute name="count" type="xs:string"/>
      <xs:attribute name="until-eof" type="xs:boolean"/>
      <xs:attribute name="max-count" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       TLV chain — RFC §5.B B3 "TLV chain"

       Bounded extension list, each entry has id+len+body shape (the
       entry shape lives inside the imported entry codec, not enforced
       here). Iteratively decoded up to `max-depth`; residual bytes
       handled per `on-overflow`:

         <sce:tlv-chain id="extensions"
                        sce:type="TlvEntry"
                        sce:byte="2"
                        max-depth="8"
                        on-overflow="reject"/>

       MCU-class — codecs containing this element emit only on
       `(rust, *)` and `(c11, bare_metal)` per the §5.J.4 matrix; on
       `{cpp, kotlin, go, python}` the codec is rejected with
       `codegen/mcu-class-kind-on-non-mcu-language` (the existing
       kind-class diagnostic, repurposed at codec-content granularity).

       `max-depth` is required (RFC line 488 "MUST be specified for
       MCU targets"); missing → typed
       `codec/tlv-chain-depth-unspecified`. `on-overflow` defaults to
       `reject`; `truncate` is the silent-drop opt-in. v1 rejects
       `diagnostic-event` (defers to a later B-stage when §5.A
       diagnostic-event runtime infrastructure ships).

       Diagnostics:
         - missing max-depth → codec/tlv-chain-depth-unspecified
         - max-depth=0 → validation/invalid-attribute
         - on-overflow="diagnostic-event" / unknown value →
             validation/invalid-attribute
         - codec containing tlv-chain on a non-MCU language →
             codegen/mcu-class-kind-on-non-mcu-language
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="tlv-chain">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <!-- Imported entry codec alias (matches an `<sce:import as=...>`
           in the same document); resolved at codegen time. Mirrors
           `<sce:repeat type=...>` / `<sce:arm type=...>` shape. -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <!-- max-depth is required by spec but kept XSD-optional so the
           dedicated `codec/tlv-chain-depth-unspecified` diagnostic
           fires (with the RFC-specific repair hint) rather than the
           generic `xml/schema-validation` "attribute required" form.
           sce-build/src/forge/parser.rs::parse_codec_tlv_chain_from_node
           rejects when missing. Mirrors the `<sce:repeat>` pattern
           where `count` / `until-eof` mutex is parser-enforced. -->
      <xs:attribute name="max-depth" type="xs:positiveInteger"/>
      <xs:attribute name="on-overflow" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §5.B B5-γ parent-flags dependency

       Codec-level annotation declaring that a body codec's fields
       read flags from a parent codec's flags carrier (Zenoh upstream
       pattern: `_z_init_decode(.., uint8_t header)` gates the body's
       `sn_res + req_id_res + batch_size` triplet on the parent
       header's S-flag at bit 6). Authored as a direct child of the
       codec's `<scxml>` root, alongside `<datamodel>`:

         <sce:requires-parent-flags carrier="header">
           <sce:flag name="S" bit="6"/>
           <sce:flag name="A" bit="5"/>
         </sce:requires-parent-flags>

       Codegen extends the codec's decode/encode signature with a
       `parent_flags: u8` parameter when this element is present;
       the variant arm dispatcher threads the parent's flag-carrier
       value into the arm decoder call. Body-field gating uses the
       existing `sce:present-if="parent.<flag>"` grammar (B5-γ
       extension of B1-δ).

       Cross-codec layout match against the parent codec's
       `<sce:flags id="<carrier>">` happens at variant arm wire-up
       (codegen-time) and rejects with `codec/parent-flag-mismatch`
       on (a) carrier missing on parent, (b) carrier not flags-
       bearing or not uint8, or (c) flag name+bit mismatch.

       v1 fixes the parent flag carrier type at uint8 (Zenoh
       transport pattern; widening to uint16+ defers until a
       reachable consumer surfaces). Declared on `<sce:flag>` here
       with `bit ∈ [0, 7]`; sce-build enforces.
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="requires-parent-flags">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:flag" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <!-- Parent codec's flags-carrier field id (e.g. carrier="header").
           Cross-codec match validated at variant arm wire-up. -->
      <xs:attribute name="carrier" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       Test vector — RFC §5.B "Test vector" (B2-test-vector)

       Inline reference oracle declared as a top-level child of an
       algorithm <scxml> root:

         <sce:test-vector hex="313233343536373839" value="0x29B1"/>

       Both attributes are required; hex must be even-length hex-only;
       value is parsed in v1 as a boolean / signed-integer / unsigned-
       integer literal compatible with the algorithm's declared return
       type. v1 supports `sce:kind="algorithm"` only — declaring this
       element under any other kind rejects with
       `algorithm/test-vector-unsupported-kind`; codec multi-field
       test vectors defer to B5 alongside the Zenoh msg-set authoring.

       Diagnostics:
         - test-vector under non-algorithm kind →
             algorithm/test-vector-unsupported-kind
         - missing hex / value attribute → validation/missing-attribute
         - malformed hex / value literal → validation/invalid-attribute
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="test-vector">
    <xs:complexType>
      <xs:attribute name="hex" type="xs:string" use="required"/>
      <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    Section 4.7: Validator rules use data-attribute form only.
    Validation attributes (sce:range-min, sce:range-max, sce:max-delta,
    sce:sample-interval, sce:plausibility) are declared as global attributes
    above and applied directly to <data> elements.
  -->

  <!-- ═══════════════════════════════════════════════════════════════
       Composition extensions — sce:template / sce:use / sce:param
       (RFC §6.5 Phase A, AOT-only)

       In normal build flow the sce-build template expander (Rust)
       eliminates every <sce:use> before the XSD validator runs, so
       these declarations act as schema self-awareness: they enable
       tooling (editor integrations, standalone template-file linters)
       to recognise the grammar. Structural correctness inside template
       files is still enforced at expansion time by
       sce-build/src/template.rs.
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Param-name pattern matches RFC §3.1. Mirrored by is_valid_param_name
       in sce-build/src/template.rs; keep the two in sync. -->
  <xs:simpleType name="paramNameType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Call site inside an SCXML document. The `template` attribute is
       the only reserved slot; every other attribute binds a parameter
       declared by the referenced template file. xs:anyAttribute
       (processContents="skip") captures param bindings without requiring
       them to be pre-declared — the expander validates them at build
       time against the template's <sce:param> declarations. -->
  <xs:element name="use">
    <xs:complexType>
      <xs:attribute name="template" type="xs:string" use="required"/>
      <xs:anyAttribute processContents="skip"/>
    </xs:complexType>
  </xs:element>

  <!-- Template declaration — root element of a standalone template file.
       Declared here so the schema is self-describing for tooling; template
       files themselves are not routed through this XSD in the build flow
       (the expander parses them directly).

       Content model: zero or more <sce:param> declarations followed by
       body content (xs:any lax). XSD 1.0 cannot express both (a) "params
       must precede body" and (b) "body may contain any sce:* element"
       without ambiguity; the sequence here enforces (a), which matches
       the canonical authoring convention in RFC §3.1. -->
  <xs:element name="template">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:param" minOccurs="0" maxOccurs="unbounded"/>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Parameter declaration. Two roles:
       * Inside <sce:template>: name + (required | default), per RFC §3.1.
       * Inside <sce:signature> (algorithm kind, RFC §5.A): name + type.
       The parser distinguishes by enclosing element; the schema permits
       both shapes via separate optional attributes. -->
  <xs:element name="param">
    <xs:complexType>
      <xs:attribute name="name" type="sce:paramNameType" use="required"/>
      <xs:attribute name="required" type="xs:boolean"/>
      <xs:attribute name="default" type="xs:string"/>
      <!-- RFC §5.A signature param: by-value scalar or by-reference bytes. -->
      <xs:attribute name="type" type="sce:sceType"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       Algorithm kind body (watching-zenoh RFC §5.A, Phase A3)

       Pure synchronous functions with bounded loops and mutable
       locals. Body statements are <sce:var>/<sce:assign>/<sce:if>/
       <sce:while>/<sce:foreach>/<sce:return>/<sce:call>; nested
       blocks recurse via xs:any lax. The parser
       (`forge::parser::parse_algorithm`) enforces structural
       constraints (e.g. statement order, max-iter on while, l-value
       shape on assign). The schema only declares element/attribute
       presence so libxml2 stops accepting freeform body markup.
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="signature">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="return">
    <xs:complexType>
      <!-- type=  inside <sce:signature>; expr=  inside body. The two
           are not mutually exclusive at schema level — the parser
           rejects `<sce:return type expr/>` collisions. -->
      <xs:attribute name="type" type="sce:sceType"/>
      <xs:attribute name="expr" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="body">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="var">
    <xs:complexType>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="type" type="sce:sceType" use="required"/>
      <xs:attribute name="init" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="assign">
    <xs:complexType>
      <xs:attribute name="target" type="xs:string" use="required"/>
      <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="if">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="cond" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="else">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="while">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="cond" type="xs:string" use="required"/>
      <xs:attribute name="max-iter" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="foreach">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="item" type="xs:NCName" use="required"/>
      <xs:attribute name="in" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    Build-time const (RFC §5.A scalar form, RFC §5.F build-time fold form).

    Two shapes accepted by `forge::parser::parse_algorithm_const`:

      Scalar (RFC §5.A v1):
        <sce:const name="N" type="uint16" init="0xFFFF"/>

      Build-time array (RFC §5.F):
        <sce:const name="TABLE" type="array<u16, 256>" sce:compute-at="build">
          <sce:fold range="0..256" as="i" elem-type="u16">
            ...statements...
            <sce:yield expr="..."/>
          </sce:fold>
        </sce:const>

    `type` is relaxed from `sce:sceType` (scalar enum) to `xs:string` so
    the `array<elem, len>` form passes XSD validation; the parser
    rejects ill-formed values with a precise diagnostic.

    `init` is no longer `use="required"` — the parser enforces "exactly
    one of `init=` or `<sce:fold>` body" with a structural diagnostic
    that is more useful than a missing-attribute error from XSD.
  -->
  <xs:element name="const">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:fold" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="init" type="xs:string"/>
      <xs:attribute ref="sce:compute-at"/>
    </xs:complexType>
  </xs:element>

  <!--
    RFC §5.F build-time fold body. `range="START..END"` is exclusive
    upper-bound; `as` names the loop variable; `elem-type` is the
    yielded element's scalar type. The terminal `<sce:yield>` carries
    the per-iteration expression.
  -->
  <xs:element name="fold">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="range" type="xs:string" use="required"/>
      <xs:attribute name="as" type="xs:NCName" use="required"/>
      <xs:attribute name="elem-type" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- RFC §5.F: terminal element of an `<sce:fold>` body. -->
  <xs:element name="yield">
    <xs:complexType>
      <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="call">
    <xs:complexType>
      <xs:attribute name="target" type="xs:NCName" use="required"/>
      <xs:attribute name="args" type="xs:string"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
