<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCE Forge Extension Schema for W3C SCXML
  Namespace: http://sce.dev/ext

  Defines extension attributes and elements for the SCE kind system.
  W3C SCXML Section 3.1 explicitly allows foreign namespace attributes on any element.
  This schema validates Extended SCXML documents that use sce: namespace extensions.

  Usage:
    <scxml xmlns="http://www.w3.org/2005/07/scxml"
           xmlns:sce="http://sce.dev/ext"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
           sce:kind="statechart" ...>

  Covers:
    - SCE Forge (kind system, build-time codegen)
    - SCE Mesh  (transport QoS, runtime attributes)
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sce="http://sce.dev/ext"
           targetNamespace="http://sce.dev/ext"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- Wire surface. The stability status below is
       machine-readable; see SCE_WIRE_CONTRACTS.md for the shared
       stability + deprecation policy across SCE wire surfaces. -->
  <xs:annotation>
    <xs:documentation>x-sce-schema-status: pre-release</xs:documentation>
  </xs:annotation>

  <!-- ═══════════════════════════════════════════════════════════════
       Simple Types
       ═══════════════════════════════════════════════════════════════ -->

  <!-- SCE Forge Section 3.2: Document-level and inline kind values -->
  <xs:simpleType name="kindType">
    <xs:restriction base="xs:string">
      <!-- Core kinds -->
      <xs:enumeration value="statechart"/>
      <xs:enumeration value="transform"/>
      <xs:enumeration value="lookup"/>
      <xs:enumeration value="condition"/>
      <xs:enumeration value="codec"/>
      <!-- peek-byte mode dispatch (RFC §synth-5-B) -->
      <xs:enumeration value="procedure"/>
      <xs:enumeration value="validator"/>
      <!-- Signal-processing kinds -->
      <xs:enumeration value="filter"/>
      <xs:enumeration value="interpolation"/>
      <xs:enumeration value="timer"/>
      <xs:enumeration value="observer"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-A (item A3) -->
      <xs:enumeration value="algorithm"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-C (item B6, MCU-class) -->
      <xs:enumeration value="link"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-E (item B7, MCU-class) -->
      <xs:enumeration value="buffer-pool"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-D (item C2, MCU-class) -->
      <xs:enumeration value="worker"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-L (item C6, Generic-class) -->
      <xs:enumeration value="bounded-collection"/>
      <!-- NL→IR Item C1 Path A — Closed set of named variants with
           1:1 wire-key values. Distinct from `lookup` by the
           bijectivity invariant on variant values. -->
      <xs:enumeration value="enum"/>
      <!-- NL→IR Mapping Roadmap Item C1 Path A — EventSchema kind.
           Typed contract for the `_event.data` payload of a named
           SCXML event. Carries the event name on the root via
           `sce:event-name`; declares typed `<data>` children that
           are read by transition `cond` expressions as
           `_event.data.<field>` and written via `<send>/<param>`
           payloads. Covers parse + receive/send-side typecheck +
           mesh DL-7'; `_event.data.<field>` reads lower natively
           on every backend. -->
      <xs:enumeration value="event-schema"/>
      <!-- SCE Protocol-Synthesis RFC §synth-5-P — FIFO handed from one
           execution context to another. The document states the contract
           (element type, producers, consumers, progress, one storage) and
           names no algorithm. -->
      <xs:enumeration value="queue"/>
      <!-- ADR 0057 §2 — the features of a product line and the requires
           order on them. A declaration: read by the statecharts that
           import it, emits nothing of its own. -->
      <xs:enumeration value="feature-model"/>
      <!-- ADR 0062 — a bounded log one producer appends to and any number
           of readers read, each by a cursor of its own; a full log forgets
           its oldest entry. The document states the contract (element type,
           producers, progress, retention) and names no algorithm. -->
      <xs:enumeration value="broadcast-log"/>
      <!-- docs/adr/0087, section 3 — a text with typed holes, rendered by
           one pure function on every backend; an untrusted hole is put
           between the document's fence markers. -->
      <xs:enumeration value="text-template"/>
      <!-- docs/adr/0092, section 1 — a value that is exactly one of several
           shapes, told apart by a tag of a closed enum: one `<sce:case>` per
           variant, each holding the record of an imported event schema or
           nothing. A type of the language (`union:<alias>`). -->
      <xs:enumeration value="union"/>
      <!-- docs/adr/0091, section 2 — the six kinds of the test profile
           (docs/SCE_TEST_PROFILE.md §11): a template, a port type, a test
           component (a `sce-static` statechart), a test configuration, a
           test case and a test suite. -->
      <xs:enumeration value="test-template"/>
      <xs:enumeration value="test-port-type"/>
      <xs:enumeration value="test-component"/>
      <xs:enumeration value="test-configuration"/>
      <xs:enumeration value="test-case"/>
      <xs:enumeration value="test-suite"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- NL→IR Mapping Roadmap Item C1 Path A — `sce:type` accepts
       primitive `sceType` values plus the `enum:<alias>` pattern
       referring to an imported `sce:kind="enum"` document. The
       pattern is the lexically authored token; resolution against the
       document's `<sce:import kind="enum">` table happens in the
       parser (`read_type_attr`), not at XSD validation time. -->
  <xs:simpleType name="sceTypeOrEnumRef">
    <xs:union memberTypes="sce:sceType">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="enum:[A-Za-z_][A-Za-z0-9_]*"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <!-- SCE Forge Section 3.3: Cross-language type system -->
  <xs:simpleType name="sceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="uint8"/>
      <xs:enumeration value="uint16"/>
      <xs:enumeration value="uint32"/>
      <xs:enumeration value="uint64"/>
      <xs:enumeration value="int8"/>
      <xs:enumeration value="int16"/>
      <xs:enumeration value="int32"/>
      <xs:enumeration value="int64"/>
      <xs:enumeration value="float32"/>
      <xs:enumeration value="float64"/>
      <xs:enumeration value="bool"/>
      <xs:enumeration value="string"/>
      <xs:enumeration value="bytes"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- docs/adr/0086, section 1: the one type grammar of every position that
       declares a value: an event schema's field, a `sce-static` statechart's
       variable, an algorithm's parameter, return and local.

         T ::= uint8 | uint16 | uint32 | uint64 | int8 | int16 | int32 | int64
             | float32 | float64 | bool | enum:<alias> | string[B] | bytes[B]
             | optional<T> | record:<alias> | union:<alias> | list<T>[B]
             | list<T>[M..B]
         B ::= <positive integer> | <limit name>=<positive integer>
         M ::= <whole number of zero or more, at most the number of B>

       Every constructor takes every type, and a bound is written in the type it
       bounds, at every depth: `list&lt;string[8]&gt;[4]` in XML is at most 4
       texts of at most 8 bytes, and `string[merge_text=96]` a text whose bound
       a build moves with `limit merge_text=N`. A list may state its lower count
       before `..` (docs/adr/0086, section 15): `list&lt;uint32&gt;[1..8]` is at
       least 1 and at most 8 elements; a text and a byte string take none, and a
       name moves the upper bound alone (`[1..shared_parts=64]`). The grammar is recursive, which
       no pattern of XSD 1.0 matches, so the type is a lexical string of the
       type alphabet here, and the parser (`forge::value_type::WrittenType`,
       read by each position's reader) judges its structure with a diagnostic
       that names the rule and the place in the type: a misspelled keyword, a
       bracket on a type with no length, an optional inside an optional, a
       text, byte string or list with no bound, an alias the document does not
       import. Only a character outside the alphabet is the schema's to refuse.

       What each position holds of the grammar is its reader's to say: a codec's
       entry stays a scalar or an optional scalar (`read_entry_type`), and a
       composition no backend lowers in a position yet is refused there by name
       (`generate/unsupported-feature`), never by this declaration. -->
  <xs:simpleType name="valueTypeExpression">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*[A-Za-z_][A-Za-z0-9_:&lt;&gt;\[\]=.\-\s]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- An algorithm's parameter, return and local (SCE Forge Section 4.12):
       the one type grammar above. -->
  <xs:simpleType name="algorithmValueType">
    <xs:union memberTypes="sce:sceTypeOrEnumRef sce:valueTypeExpression"/>
  </xs:simpleType>

  <!-- The global `sce:type`: every grammar a `<data>` may be written in, a
       field's of a kind that holds scalars (`sceTypeOrEnumRef`), a codec
       entry's, and the one type grammar of an event schema's field and of a
       `sce-static` statechart's variable (SCE Accepted Subset §2.15,
       docs/adr/0086). One global attribute cannot be narrowed by where it sits
       in XSD 1.0, so each position's parser holds it to that position's
       grammar (`read_type_attr`, `read_entry_type`, and the one grammar's
       readers of a field, a variable and an algorithm's slot). -->
  <xs:simpleType name="dataValueType">
    <xs:union memberTypes="sce:sceTypeOrEnumRef sce:valueTypeExpression"/>
  </xs:simpleType>

  <!-- SCE Forge Section 3.3: Data flow direction -->
  <xs:simpleType name="directionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="in"/>
      <xs:enumeration value="out"/>
      <xs:enumeration value="internal"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 3.3: Byte order -->
  <xs:simpleType name="endianType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="big"/>
      <xs:enumeration value="little"/>
      <xs:enumeration value="native"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Codec field bit-size: fixed integer, "tail", "length-ref", or "vle".
       "vle" pairs with sce:type ∈ {uint16, uint32, uint64} and selects
       the base-128 variable-length encoding (RFC §synth-5-B App. B). -->
  <xs:simpleType name="bitSizeType">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:nonNegativeInteger"/>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="tail"/>
          <xs:enumeration value="length-ref"/>
          <xs:enumeration value="vle"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <!-- SCE Forge Section 4.8: Filter algorithm types -->
  <xs:simpleType name="filterType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="moving-average"/>
      <xs:enumeration value="low-pass"/>
      <xs:enumeration value="debounce"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.9: Interpolation method -->
  <xs:simpleType name="interpolationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="linear"/>
      <xs:enumeration value="bilinear"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.9: Out-of-bounds handling -->
  <xs:simpleType name="outOfBoundsType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="clamp"/>
      <xs:enumeration value="extrapolate"/>
      <xs:enumeration value="error"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- SCE Forge Section 4.10: Timer scheduling type — removed with the
       `<data sce:timer=…>` shape it typed; see the note further down where
       those attributes were declared. -->

  <!-- SCE Forge Section 4.11: Monitor type -->
  <xs:simpleType name="monitorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="threshold"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Duration with unit suffix (e.g., "100ms", "5s", "2000") -->
  <xs:simpleType name="durationType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+(\.\d+)?(ms|s|m|h)?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ═══════════════════════════════════════════════════════════════
       Attribute Declarations — SCE Forge (build-time codegen)
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Section 3.2: Kind selector — on <scxml> root or <data> elements -->
  <xs:attribute name="kind" type="sce:kindType"/>

  <!-- Section 3.3: Common data attributes — on <data> elements.
       NL→IR Item C1 Path A: accepts primitive `sceType` values plus
       the `enum:<alias>` pattern. Codec / lookup / etc. parsers
       reject the enum form at parse time when the surrounding kind
       does not support it; the wider XSD union keeps the global
       attribute declaration valid for the kinds that do. The same holds
       for `list<T>` / `record:<alias>` (`dataValueType`), which only a
       `sce-static` statechart variable admits. -->
  <xs:attribute name="type" type="sce:dataValueType"/>
  <!-- `sce:capacity` is a bound in two places: the event-queue depth on
       `<scxml>` and a `sce-static` `list<T>` variable's element count on
       `<data>` (SCE Accepted Subset §2.15). A global declaration types the
       attribute wherever it appears, so it is `xs:string` here: each parser
       rule judges its own value and refuses it with its own diagnostic (a
       positive u32 for both, the list rule also refusing it off a list).
       Typing it here would refuse a malformed or zero value with a schema
       error first, and the rules' refusals would never be reached.
       On a variable it is the legacy spelling of the bracket on the outermost
       type it bounds (`list&lt;int64&gt;[16]`, docs/adr/0086 section 1.3): read
       as that bracket, reported with `validation/bound-attribute-superseded`,
       and refused beside a bracket that states the same bound. On `<scxml>` it
       is the queue's depth, which is no value type and stays. -->
  <xs:attribute name="capacity" type="xs:string"/>
  <!-- `sce:limit="name"` beside a `capacity` or a `returns-max-size`: the name a
       build gives another number for (the `limit` option of `sce-codegen`, one
       `name=N` each), so that the
       bounds that have to move together (a list variable and the algorithm that
       returns it) are one name wherever they are written. The number written is
       the bound when a build gives none.
       On a value type it is the legacy spelling of a named bracket,
       `[name=N]` (docs/adr/0086 section 1.3): read with the bound attribute
       beside it as that bracket, and reported with
       `validation/bound-attribute-superseded`. -->
  <xs:attribute name="limit" type="xs:NCName"/>
  <!-- `sce:interface="closed"` on a statechart's `<scxml>`: every event
       crossing it is one an imported event-schema declares (SCE Accepted
       Subset §2.16). `xs:string` for `sce:capacity`'s reason: the parser
       refuses any other value with its own diagnostic, which a schema type
       would pre-empt. -->
  <xs:attribute name="interface" type="xs:string"/>
  <!-- `sce:transition-table="emit"` on a statechart's `<scxml>`: the generated
       machine carries its own transitions as constant data (SCE Accepted
       Subset §2.20). `xs:string` for the reason `sce:interface` is: the parser
       refuses any other value with its own diagnostic. -->
  <xs:attribute name="transition-table" type="xs:string"/>
  <!-- `sce:transition-function="emit"` on a statechart's `<scxml>`: the
       document is also generated as a pure function of (leaf state, event)
       beside the machine (SCE Accepted Subset §2.21). `xs:string` for the
       reason `sce:interface` is: the parser refuses any other value with its
       own diagnostic. -->
  <xs:attribute name="transition-function" type="xs:string"/>
  <xs:attribute name="direction" type="sce:directionType"/>

  <!-- NL→IR Item C1 Path A — `sce:underlying-type` on a
       `sce:kind="enum"` `<scxml>` root names the fixed-width integer
       carrier (uint8/uint16/uint32/uint64/int8/int16/int32/int64) for
       the document's variant values. Free-form `sceType` at the XSD
       layer; the parser rejects the non-integer members of that type
       (see `validation/enum-unsupported-underlying-type`). -->
  <xs:attribute name="underlying-type" type="sce:sceType"/>

  <!-- NL→IR Item C1 Path A — `sce:strict-variants` on
       a `sce:kind="enum"` `<scxml>` root opts the enum out of the
       strict variant-membership check that runs over integer
       literals compared against (receive-side) or assigned to
       (send-side) an `enum:<alias>`-typed field. Defaults to `true`
       (strict): integer literals whose value is not one of the
       enum's declared `<sce:variant value="…"/>` set raise
       `validation/cross-kind-type-mismatch` (reused per Item 4
       precedent — no new wire code). Set to `false` for open-set
       status vocabularies (e.g. UDS NRC, OEM-extensible response
       codes) where wire-side values outside the declared set are
       legal. Width narrowing (`enum-underlying-overflow`) still
       runs regardless of this opt-out — overflow of the declared
       underlying type remains a wire-level error. -->
  <xs:attribute name="strict-variants" type="xs:boolean"/>
  <!-- `sce:text` on an enum's `<sce:variant>` (docs/adr/0015): the text a codec
       of text lines (`sce:encoding="content-line"`) writes and reads for the
       variant, where it is not the declared name — `NEEDS-ACTION` for a variant
       named `needsAction`. The ASCII letters, digits and `-` of an RFC 5545
       `iana-token`, unique in its enum under ASCII case folding; both rules are
       the parser's, which names the variant that breaks them. -->
  <xs:attribute name="text" type="xs:string"/>

  <!-- NL→IR Mapping Roadmap Item C1 Path A — `sce:event-name` on a
       `sce:kind="event-schema"` `<scxml>` root names the SCXML event
       whose `_event.data` payload the schema constrains. Reserved
       W3C namespaces (`error.*`, `done.invoke.*`, `done.state.*`)
       are rejected by `parse_event_schema` (raises
       `validation/event-schema-on-builtin-event`). Free-form string
       at the XSD layer; semantic validation lives in sce-build. -->
  <xs:attribute name="event-name" type="xs:string"/>
  <!-- An event schema that grows (SCE Accepted Subset, "An event schema
       that grows"). `sce:revision` on a `sce:kind="event-schema"` root
       says which revision of the schema the document is, a positive
       integer, the first when absent. `sce:since` on one of its `<data>`
       fields names the revision that added the field, from 2 up to the
       root's revision, and the field then carries `sce:default` (declared
       below, shared with the lookup miss policy), the value a delivery
       written before the field existed takes in its place. A field of the
       first revision declares neither and stays required.

       An enum grows the same way (docs/adr/0044): `sce:revision` on a
       `sce:kind="enum"` root says which revision of the enum the document
       is, and `sce:since` on one of its `<sce:variant>`s names the revision
       that added the variant, from 2 up to the root's revision. A variant
       of the first revision declares none.

       Strings at the XSD layer, as `sce:event-name` is: the parser owns
       every refusal (`parse_event_schema`, `parse_enum`), a revision that
       is not a positive integer, a `since` outside its range, a default
       with no `since` or a `since` with no default, and a default that is
       no value of its field, so that each is answered in the words written
       for it rather than in libxml2's. -->
  <xs:attribute name="revision" type="xs:string"/>
  <xs:attribute name="since" type="xs:string"/>
  <!-- docs/adr/0087, section 3.1: on a text hole of a `sce:kind="text-template"`
       document, whether its value is the program's own (`trusted`) or came
       from outside it (`untrusted`, put between the fence markers). Which
       holes must and must not carry it is the parser's rule, answered as
       `validation/text-template-hole`. -->
  <xs:attribute name="trust">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="trusted"/>
        <xs:enumeration value="untrusted"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
  <!-- A field widened across revisions (docs/adr/0055, section 6).
       `sce:optional-since` on an `optional<T>` `<data>` field of a
       `sce:kind="event-schema"` names the revision that widened the field
       from `T`: an integer past the revision that added the field (its
       `sce:since`, or 1) and at most the root's revision. At a revision
       before it the field is of `T`, from it on of `optional<T>`. A field
       that was optional from the revision that added it declares none.

       A string at the XSD layer, as `sce:since` is: the parser owns the
       range (`validation/attribute-rule-violated`), and on a field of `T`
       or on any other kind nothing reads the attribute, which is refused as
       `validation/sce-attribute-unread`. -->
  <xs:attribute name="optional-since" type="xs:string"/>
  <!-- `sce:default-covers` on an enum-typed INPUT `<data>` of a
       `sce:kind="transform"`: the variants of that input's value space
       which reach the expression's default branch on purpose. It is the
       answering half of the value-space coverage report (`sce-codegen
       coverage`), which lists the variants nothing in the document tests
       for.

       Whitespace-separated variant names, like every other list-valued
       SCE attribute. Named rather than boolean so the claim EXPIRES: a
       variant added to the enum document is unacknowledged, and the
       report asks again — which is right, because a value space growing
       is when the author must decide again.

       Opaque at the XSD layer; the claim is checked in sce-build
       (`forge::coverage::check`), which refuses a name that is not a
       variant (`validation/default-covers-unknown-variant`), a name the
       document tests for (`…/default-covers-tested-variant`), and the
       attribute on a field with no value space
       (`…/default-covers-not-a-value-space`). -->
  <xs:attribute name="default-covers" type="xs:string"/>

  <!-- `sce:retain` / `sce:initial` on a forge `<data>` field: the
       field's value OUTLIVES the program that computes it.

       `sce:retain` names the store, and the label is OPAQUE — SCE
       compares it for equality and never interprets it. The measurement
       behind this surface is automotive (one store survives
       ignition-off, another survives battery removal) and enumerating
       those two here would put one domain's vocabulary in a general
       grammar; a domain adapter gives labels meaning, the same policy
       `sce:req` uses for requirement ids.

       `sce:initial` is the value before the store has ever been
       written. Each attribute REQUIRES the other: a retained field with
       no initial value is undefined on the first run, and an initial
       value on a field that is not retained is read by nothing. Both
       orphans are refused as `validation/invalid-attribute`
       (`parse_retention_attrs`), and membership of `sce:initial` in the
       field's value space is checked by `forge::retention::check`. -->
  <xs:attribute name="retain" type="xs:string"/>
  <xs:attribute name="initial" type="xs:string"/>

  <xs:attribute name="unit" type="xs:string"/>
  <xs:attribute name="default" type="xs:string"/>
  <!-- `sce:input` / `sce:input-type` are gone (2026-09-22). They existed
       for the inline dialect alone: a transform or lookup declared in a
       statechart named its single input with them, while the same kinds
       written as documents used `sce:direction="in"` and admitted
       several. An inline kind now carries a standalone kind's body, so
       there is one spelling. -->

  <!-- NL→IR Mapping Roadmap Item 4: physical-quantity annotation. The
       triple `sce:quantity` / `sce:scale` / `sce:offset` declares a
       linear `physical = raw * scale + offset` conversion in the named
       unit. `sce:scale` and `sce:offset` must accompany `sce:quantity`
       (orphan declarations rejected at parse time); the rational
       grammar accepts integers, decimal fractions, and `<num>/<denom>`
       ratios. Strings are kept opaque at the XSD layer; semantic
       validation lives in sce-build (`parse_quantity_attrs`). -->
  <xs:attribute name="quantity" type="xs:string"/>
  <xs:attribute name="scale" type="xs:string"/>
  <xs:attribute name="offset" type="xs:string"/>

  <!-- NL→IR closure ledger row G3: the requirement a node claims, as
       whitespace-separated opaque ids. The statechart family has read
       this attribute since the trace table existed; the forge kinds
       could not carry it at all, so their review artefact had no
       requirement column to print and a `delegated` or `missing`
       verdict about a non-statechart document was unanswerable.

       Opaque by design at every layer — SCE never normalises a
       requirement id, because two spellings that normalise together
       are two requirements to the document that issued them. The
       shape rule that IS enforced lives in sce-build: a token
       repeated on one node is rejected
       (`validation/duplicate-requirement-id`), because a duplicate
       double-counts in coverage and masks the annotation that is
       actually absent. One reader (`collect_sce_req`) serves both
       families so the two cannot drift. -->
  <xs:attribute name="req" type="xs:string"/>

  <!-- ADR 0057 §3 — `sce:requires="P"` on an SCXML element: the feature
       condition under which the element is present. A string here; the
       grammar (`name | all(…) | any(…)`), the names and which elements take
       one are the parser's rules (`product_line`), each with its own
       diagnostic. -->
  <xs:attribute name="requires" type="xs:string"/>

  <!-- docs/SCE_TEST_PROFILE.md §11 — the test profile's attributes on W3C
       elements. Each is read only where its document is of the kind that
       takes it, and refused as unread anywhere else
       (`validation/sce-attribute-unread`): `sce:configuration` on the root
       of a `test-case`; `sce:receive`, `sce:timeout`, `sce:test-template`
       and `sce:template-args` on a `<transition>` of a `test-component`, the
       last two on its `<send>` too; `sce:module-parameter` on a `<data>` of
       a `test-component`. Names are strings here: which import, port, timer
       or variable each names is the parser's and the import check's rule. -->
  <xs:attribute name="configuration" type="xs:string"/>
  <xs:attribute name="receive" type="xs:string"/>
  <xs:attribute name="timeout" type="xs:string"/>
  <xs:attribute name="test-template" type="xs:string"/>
  <xs:attribute name="template-args" type="xs:string"/>
  <xs:attribute name="module-parameter" type="xs:boolean"/>

  <!-- W3C SCXML 6.4: on an `<invoke>` whose child is named by an
       expression, the finite set that expression may select from —
       space separated paths, matched by document STEM
       (docs/SCE_ACCEPTED_SUBSET.md §2.13). Declared globally because it
       is written on `<invoke>`, a W3C element this grammar wraps rather
       than declares, so a local declaration has nowhere to live.

       `xs:string` and not `use`-constrained anywhere: the parser owns
       all three refusals — beside a `contentexpr`, two entries sharing
       one stem, and an attribute present but empty — and each names the
       entry that was wrong. -->
  <xs:attribute name="candidates" type="xs:string"/>

  <!-- The typed interface of an `<invoke>` the host runs: `sce:request` and
       `sce:result` each name an imported event schema's alias
       (docs/SCE_ACCEPTED_SUBSET.md §2.12). Global for the reason
       `candidates` is — written on the W3C `<invoke>`. `xs:string` and not
       `use`-constrained: the parser owns the refusals (on an invoke SCE runs
       itself, without an `id`, empty, or naming no imported schema), and
       each names the attribute that was wrong. -->
  <xs:attribute name="request" type="xs:string"/>
  <xs:attribute name="result" type="xs:string"/>

  <!-- docs/adr/0087, section 4.1: the answer schema an `<invoke>` of
       `sce-host-model-generate` asks its text in, an imported event schema's
       alias. Global for the reason `request` is. `xs:string` and not
       `use`-constrained: the parser and the build own the refusals (on an
       invoke of another type, empty, naming no imported schema, one with no
       grammar, two schemas of one id), each `validation/model-answer-schema`. -->
  <xs:attribute name="answer" type="xs:string"/>

  <!-- Section 4.6: Codec — document-level default endianness -->
  <xs:attribute name="default-endian" type="sce:endianType"/>

  <!-- Section 4.6, docs/adr/0065: a codec's statement that its encode can
       refuse a value. Absent or `false`, the encode is total and returns its
       bytes; `true`, it can refuse a value its encoding cannot carry. The
       build holds the statement to the refusals it finds and refuses a codec
       whose statement disagrees (`codec/undeclared-encode-refusal`,
       `codec/encode-may-fail-without-refusal`). -->
  <xs:attribute name="encode-may-fail" type="xs:boolean"/>

  <!-- Section 4.6: Codec wire layout. `positional` (the default) places each
       field at sce:byte / sce:bit-size; `cbor` writes one CBOR map (RFC 8949)
       whose entries are the <data sce:key> elements, and refuses every
       positional attribute and element. -->
  <xs:attribute name="encoding">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="positional"/>
        <xs:enumeration value="cbor"/>
        <xs:enumeration value="content-line"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
  <!-- Section 4.6, docs/adr/0055 section 8: the format a `cbor` or `content-line`
       codec document is written in, on its root. Format 2 is the only one read
       and generated: a bare `sce:type` is an entry that must be present and
       `optional<T>` one that may be absent, and `sce:required` is not part of it.
       A document that declares none, or `1`, is format 1, refused with its
       rewrite as `validation/codec-format-superseded`, and any other value is
       `validation/invalid-attribute`. `xs:string` and not an enumeration, so that
       those values reach the parser's refusal that names `2` rather than a schema
       violation that does not. A positional codec declares none: written there,
       it is `validation/sce-attribute-unread`. -->
  <xs:attribute name="codec-format" type="xs:string"/>
  <!-- Section 4.6.4: a `content-line` codec writes one RFC 5545 component
       (sce:component, the name between BEGIN: and END:) whose entries are the
       <data sce:property> elements: a property's value, or with sce:param one
       of its parameters. sce:value="text" makes a string an RFC 5545 TEXT
       (escaped); sce:repeated="true" makes a property a list of its lines, and
       sce:max-count, beside it, bounds that list where the protocol does
       (docs/adr/0077 section 7). -->
  <xs:attribute name="component" type="xs:string"/>
  <xs:attribute name="property" type="xs:string"/>
  <xs:attribute name="param" type="xs:string"/>
  <xs:attribute name="value">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="text"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
  <xs:attribute name="repeated">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="true"/>
        <xs:enumeration value="false"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
  <!-- A content-line entry's count beside `sce:repeated`, which belongs to its
       codec and stays. On an event schema's `list<T>` field it is the legacy
       spelling of the bracket on the list (`list&lt;T&gt;[N]`, docs/adr/0086
       section 1.3): read as that bracket and reported with
       `validation/bound-attribute-superseded`. -->
  <xs:attribute name="max-count" type="xs:positiveInteger"/>
  <!-- Section 4.6: a CBOR codec entry's map key — 0..23, a one-byte head. -->
  <xs:attribute name="key">
    <xs:simpleType>
      <xs:restriction base="xs:nonNegativeInteger">
        <xs:maxInclusive value="23"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
  <!-- Section 4.6: a codec entry whose absence a decode refuses, in format 1 of
       a `cbor` or `content-line` codec document. Not part of format 2
       (`sce:codec-format="2"`), where a bare `sce:type` is required and
       `optional<T>` is optional; written there, it is
       `validation/attribute-rule-violated`, which names the two spellings of
       what it meant. Declared so that the parser's refusal, and not a schema
       violation, is what the author reads. -->
  <xs:attribute name="required" type="xs:boolean"/>

  <!-- Section 4.6: Codec field layout — on <data> or <sce:field> -->
  <xs:attribute name="byte" type="xs:nonNegativeInteger"/>
  <xs:attribute name="bit-offset" type="xs:nonNegativeInteger"/>
  <xs:attribute name="bit-size" type="sce:bitSizeType"/>
  <xs:attribute name="endian" type="sce:endianType"/>
  <!-- A codec field's bound, which describes a foreign frame's layout (ADR
       0077) and stays. On an event schema's text or byte string field it is
       the legacy spelling of the bracket on the outermost type it bounds
       (`string[N]`, `optional&lt;bytes[N]&gt;`, docs/adr/0086 section 1.3):
       read as that bracket, reported with
       `validation/bound-attribute-superseded`, and refused beside a bracket
       that states the same bound. -->
  <xs:attribute name="max-size" type="xs:nonNegativeInteger"/>
  <xs:attribute name="length" type="xs:nonNegativeInteger"/>
  <xs:attribute name="length-field" type="xs:string"/>

  <!-- RFC §synth-5-B present-if primitive (sce:present-if attribute).
       Predicate grammar: a clause is `<field_id>.<flag_name>` — the
       referenced field must be a `<sce:flags>` carrier declared
       earlier in the same codec — or `<chain_id>.has(<value>)`, true
       when an entry of the earlier `<sce:tlv-chain>` `chain_id` has the
       identifier `value` (decimal, 0x or 0b; the chain's `entry-id`
       says where an entry keeps it) — or a bare `<flag-input>` name. A
       clause may carry a leading `!`, and clauses join with `||`.
       Field shape (string typed at the XSD layer; semantic checks land
       in sce-build):
         - forward / unknown carrier or chain → codec/present-if-refs-later-field
         - non-flags carrier or unknown flag → validation/invalid-attribute
         - `.has(…)` on a chain that declares no entry-id, or on a field
           that is not a chain → validation/attribute-rule-violated -->
  <xs:attribute name="present-if" type="xs:string"/>

  <!-- RFC §synth-5-B B3 DMA alignment primitive (sce:dma-burst-align attribute).
       Constrains the field's start offset within the encoded buffer to
       an N-byte boundary (typical N: 16, 32, 64). MCU-class — codecs
       containing this attribute emit only on Rust + C11 per the §synth-5-J-4
       matrix. The XSD type is positiveInteger; semantic checks land in
       sce-build (`parse_codec_field_from_node` rejects non-power-of-2
       N, `validate_codec_dma_alignment` rejects misaligned `sce:byte`
       and variable-length predecessors with
       `codec/dma-alignment-unsatisfiable`). -->
  <xs:attribute name="dma-burst-align" type="xs:positiveInteger"/>

  <!-- RFC §synth-5-B length-arith primitive (sce:length-arith attribute).
       Arithmetic offset on the length-field source value. Effective
       payload length is `sibling_value + length_arith` bytes.
       Authored as `sce:length-arith="+1"` or `sce:length-arith="-1"`
       paired with `sce:bit-size="length-ref"` + `sce:length-field="..."`.
       v1 grammar restricts to ±1 (parser rejects 0 and `|x|>1`);
       widening defers to a reachable consumer. First reachable
       consumer: zenoh-pico Scout/Hello/Init `zid` length packing
       (zid_len_m1 = actual_len - 1, decode reconstructs actual_len). -->
  <xs:attribute name="length-arith" type="xs:integer"/>

  <!-- RFC §synth-5-B — `sce:length-from="<sibling_field_id>"` on
       `<sce:embed>`. Bounds the embedded codec's decode-time cursor
       scope to the named earlier integer field's value. Mirrors
       zenoh-pico declarations.c:206 `_z_slice_as_zbuf` inner-cursor
       pattern. Author-trust on encode (sibling's wire value must
       match the embedded codec's emitted byte count). Validator
       (`validate_codec_embed_length_from`) rejects forward / unknown
       / non-integer references. -->
  <xs:attribute name="length-from" type="xs:string"/>

  <!-- RFC §synth-5-B B2 repeat primitive: <sce:repeat>-internal attributes
       (count / until-eof / max-count / type / id) live unqualified
       inside the <sce:repeat> element complexType — same convention
       as <sce:arm value/type> and <sce:flag name/bit> where attrs
       declared inside SCE-namespaced child elements stay unqualified.
       Globally-shared `sce:byte` (also on <sce:field> / <sce:flags>)
       remains qualified via the existing global declaration. -->


  <!-- Section 4.5: Procedure <send> hints -->
  <xs:attribute name="service" type="xs:string"/>
  <xs:attribute name="subfunc" type="xs:string"/>
  <xs:attribute name="addr" type="xs:string"/>
  <!-- `sce:payload` has two readings, told apart by the element that carries
       it. On a procedure `<send sce:service>` it names the operand that is
       the request's payload (above). On the `<datamodel>` of a
       `sce:kind="event-schema"` document it is `none` — the specification
       says the event carries no data — and stands in for the field a schema
       otherwise has to declare (SCE Accepted Subset, "Fieldless schema").
       `xs:string` for both: the parser refuses any other value on a
       `<datamodel>` with its own diagnostic, which a schema type would
       pre-empt. -->
  <xs:attribute name="payload" type="xs:string"/>

  <!-- Section 4.7: Validator — data-attribute form (target format) -->
  <xs:attribute name="range-min" type="xs:string"/>
  <xs:attribute name="range-max" type="xs:string"/>
  <xs:attribute name="max-delta" type="xs:string"/>
  <xs:attribute name="sample-interval" type="sce:durationType"/>
  <xs:attribute name="plausibility" type="xs:string"/>

  <!-- Section 4.8: Filter — on output <data> element -->
  <xs:attribute name="filter" type="sce:filterType"/>
  <xs:attribute name="window" type="xs:positiveInteger"/>
  <xs:attribute name="alpha" type="xs:decimal"/>

  <!-- Section 4.9: Interpolation — on output <data> element -->
  <xs:attribute name="interpolation" type="sce:interpolationType"/>
  <xs:attribute name="out-of-bounds" type="sce:outOfBoundsType"/>
  <!--
    Axis breakpoint attributes follow the pattern sce:axis-{input_id}
    (e.g., sce:axis-rpm="800 1200 2000 3000").
    XSD 1.0 cannot express wildcard attribute names; these are validated
    by the sce-build parser at build time. Documents using sce:axis-*
    attributes remain schema-valid via xs:anyAttribute on the host element.
  -->

  <!-- Section 4.10: Timer — the `<data sce:timer=…>` shape this used to
       declare (sce:timer / interval / duration / delay / event /
       on-timeout, and the timerType enumeration above them) was removed
       from the implementation on 2026-05-12, when C1 replaced it with the
       §synth-5-D shape: one named timer per document, carrying
       <sce:period>, <sce:reset-on>, <sce:cancel-on> and <sce:fire-event>.
       See `TimerModel` in sce-build/src/forge/model.rs, which records the
       removal.

       ⚠ The declarations outlived the shape by four months. This file is a
       registered wire surface, so a consumer reading it to learn what is
       valid would write `sce:timer="timeout"`, get a schema-valid document,
       and then be refused by the generator — a surface advertised and not
       served. Measured 2026-09-17: parser reads 0, documents using them 0,
       references from inside this schema 0. -->

  <!-- Section 4.11: Observer — on <data> elements -->
  <xs:attribute name="monitor" type="sce:monitorType"/>
  <xs:attribute name="enter" type="xs:string"/>
  <xs:attribute name="leave" type="xs:string"/>
  <xs:attribute name="on-enter" type="xs:string"/>
  <xs:attribute name="on-leave" type="xs:string"/>

  <!-- Section 5.F: build-time const-fold trigger. Declared globally so
       it carries the `sce:` prefix in instance documents (matching the
       RFC §synth-5-F worked example: `<sce:const sce:compute-at="build">`).
       Local `compute-at` declarations on individual elements would land
       unprefixed under the schema's `attributeFormDefault="unqualified"`
       and conflict with the parser's `sce_attr` lookup. -->
  <xs:attribute name="compute-at" type="xs:string"/>

  <!-- ═══════════════════════════════════════════════════════════════
       Attribute Declarations — SCE Mesh (runtime transport)
       ═══════════════════════════════════════════════════════════════ -->

  <xs:attribute name="qos" type="xs:string"/>
  <xs:attribute name="deadline" type="xs:string"/>
  <xs:attribute name="priority" type="xs:string"/>

  <!-- ═══════════════════════════════════════════════════════════════
       Element Declarations
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Section 5: Cross-file kind import. The optional
       <sce:variant-dispatch> child carries the parent-side dispatch
       inversion declaration: when the imported codec is a `<sce:variant>` codec,
       the parent uses this child to designate which of its own flags
       drives the variant's arm dispatch (dotted `<carrier>.<flag>`).
       Parent-local cross-doc validator confirms the named carrier and
       flag exist in the parent's own model. -->
  <xs:element name="import">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:variant-dispatch" minOccurs="0" maxOccurs="1"/>
        <!-- Flag inversion: parent-side flag-bind declarations
             supply values for the imported leaf's declared
             `<sce:flag-inputs>`. Each `<sce:flag-bind>` names one
             leaf-side input and a source on the parent (either a
             local flags-carrier flag in dotted form, or one of the
             parent's own `<sce:flag-input>` declarations by bare
             name for the chain-forwarder pattern). The cross-doc
             validator `validate_cross_codec_flag_bind` enforces
             binding-completeness, source resolution, width
             agreement, and carrier-before-embed ordering. -->
        <xs:element ref="sce:flag-bind" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="src" type="xs:string" use="required"/>
      <xs:attribute name="kind" type="sce:kindType" use="required"/>
      <xs:attribute name="as" type="xs:NCName" use="required"/>
      <!-- ADR 0057 §3: the feature condition under which the import is
           present (refused on the feature-model import itself, by the
           parser). -->
      <xs:attribute name="requires" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ADR 0057 §2 — one feature of a `sce:kind="feature-model"` document.
       `name` is a feature name and `requires` a space-separated list of
       features of the same model. Both are typed as strings here: the
       grammar of a name, the existence of each requirement and the absence
       of a cycle are the parser's rules (`feature_model::FeatureModel::new`),
       held once there so each refusal carries its own diagnostic. -->
  <xs:element name="feature">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="requires" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- docs/adr/0092, section 1.1 — one case of a `sce:kind="union"`
       document, a child of its tag `<data>`. `variant` names a variant of
       the tag's enum; `record`, when present, the alias of an imported
       event schema whose record the case holds, and an empty case has none.
       That the cases and the variants are one to one, and that no case's
       record declares the tag's key, are the parser's and the import
       check's rules (`validation/union-cases`,
       `validation/union-tag-collision`), each with its own diagnostic. -->
  <xs:element name="case">
    <xs:complexType>
      <xs:attribute name="variant" type="xs:string" use="required"/>
      <xs:attribute name="record" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       The test profile — docs/adr/0091; the forms are
       docs/SCE_TEST_PROFILE.md §11.

       Each element below is read only in the kind that takes it, and an
       element read by nothing is refused by the parser's read ledger.
       What the grammar does not say — how many matchers a container
       holds, which name an attribute names, which matcher a position's
       type admits — is the parser's and the import check's rule, each
       with its own diagnostic (`test-profile/…` and the shape codes).
       ═══════════════════════════════════════════════════════════════ -->

  <!-- §11.3: the direction of a message, seen from the component that
       owns a port of the type. -->
  <xs:simpleType name="testMessageDirectionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="in"/>
      <xs:enumeration value="out"/>
      <xs:enumeration value="inout"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- §11.3: one message of a `test-port-type`: `type` the alias of an
       imported event schema. -->
  <xs:element name="message">
    <xs:complexType>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="direction" type="sce:testMessageDirectionType" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- §11.4: the matchers of a `test-template`, one element each. A
       container holds matchers of this group; how many is the parser's rule
       (a value list two or more, a complement one or more, a union case at
       most one). -->
  <xs:group name="testMatcher">
    <xs:choice>
      <xs:element ref="sce:specific"/>
      <xs:element ref="sce:record-match"/>
      <xs:element ref="sce:list-match"/>
      <xs:element ref="sce:union-match"/>
      <xs:element ref="sce:value-list"/>
      <xs:element ref="sce:complement"/>
      <xs:element ref="sce:any-value"/>
      <xs:element ref="sce:any-value-or-none"/>
      <xs:element ref="sce:value-range"/>
      <xs:element ref="sce:omit"/>
      <xs:element ref="sce:template-ref"/>
    </xs:choice>
  </xs:group>

  <!-- B.1.1: a specific value, by exactly one of `value` (a literal of the
       position's type) and `param` (a formal parameter). Every matcher takes
       `field` (in a record match), `length-min`, `length-max` and
       `ifpresent`. -->
  <xs:element name="specific">
    <xs:complexType>
      <xs:attribute name="value" type="xs:string"/>
      <xs:attribute name="param" type="xs:string"/>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- B.1.1: one matcher per field of the record, each with `field`. -->
  <xs:element name="record-match">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="sce:testMatcher" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- B.1.1, B.1.3.1: one matcher per element of the list, in order. -->
  <xs:element name="list-match">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="sce:testMatcher" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- B.1.1: the case `variant` of a union, and the matcher of its record. -->
  <xs:element name="union-match">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="sce:testMatcher" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="variant" type="xs:string" use="required"/>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- B.1.2.1: the value matches one of two or more matchers. -->
  <xs:element name="value-list">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="sce:testMatcher" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- B.1.2.2: the value matches none of one or more matchers. -->
  <xs:element name="complement">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="sce:testMatcher" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- B.1.2.3: any value. -->
  <xs:element name="any-value">
    <xs:complexType>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- B.1.2.4: any value of an optional field, or none. -->
  <xs:element name="any-value-or-none">
    <xs:complexType>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- B.1.2.5: an integer within the bounds, each inclusive and optional. -->
  <xs:element name="value-range">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="sce:lower"/>
        <xs:element ref="sce:upper"/>
      </xs:choice>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- A bound of a value range, by exactly one of `value` and `param`. -->
  <xs:element name="lower">
    <xs:complexType>
      <xs:attribute name="value" type="xs:string"/>
      <xs:attribute name="param" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="upper">
    <xs:complexType>
      <xs:attribute name="value" type="xs:string"/>
      <xs:attribute name="param" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- B.1.2.8: the optional field is absent. -->
  <xs:element name="omit">
    <xs:complexType>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- -1 §15.1: an imported template, its formal parameters bound in order
       to this template's own parameters `args`, separated by spaces. -->
  <xs:element name="template-ref">
    <xs:complexType>
      <xs:attribute name="template" type="xs:string" use="required"/>
      <xs:attribute name="args" type="xs:string"/>
      <xs:attribute name="field" type="xs:string"/>
      <xs:attribute name="length-min" type="xs:nonNegativeInteger"/>
      <xs:attribute name="length-max" type="xs:nonNegativeInteger"/>
      <xs:attribute name="ifpresent" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- §11.5: a port of a `test-component`, of an imported port type. -->
  <xs:element name="test-port">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="type" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- §11.5, P7: a one-shot timer of a `test-component`, with an optional
       default duration in SCXML's delay syntax. -->
  <xs:element name="test-timer">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="duration" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- §5.1, P12: the verdict a document sets. `error` is the runtime's
       alone. -->
  <xs:simpleType name="testVerdictType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pass"/>
      <xs:enumeration value="inconclusive"/>
      <xs:enumeration value="fail"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- P12: executable content of a `test-component`; `reason` a
       `sce-static` expression of type string. -->
  <xs:element name="setverdict">
    <xs:complexType>
      <xs:attribute name="value" type="sce:testVerdictType" use="required"/>
      <xs:attribute name="reason" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- P7: executable content of a `test-component`. -->
  <xs:element name="start-timer">
    <xs:complexType>
      <xs:attribute name="timer" type="xs:string" use="required"/>
      <xs:attribute name="duration" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="stop-timer">
    <xs:complexType>
      <xs:attribute name="timer" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- §11.6: the components of a `test-configuration` and how their ports
       are joined. `component` names the MTC (`mtc`) or a PTC. -->
  <xs:element name="mtc">
    <xs:complexType>
      <xs:attribute name="type" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="ptc">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="type" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="system-port">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="type" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="map">
    <xs:complexType>
      <xs:attribute name="component" type="xs:string" use="required"/>
      <xs:attribute name="port" type="xs:string" use="required"/>
      <xs:attribute name="system-port" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="connect">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:endpoint" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="endpoint">
    <xs:complexType>
      <xs:attribute name="component" type="xs:string" use="required"/>
      <xs:attribute name="port" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- §11.8: a module parameter of a `test-suite` and its default, and one
       test case in run order with its guard and its selection. -->
  <xs:element name="module-parameter">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="execute">
    <xs:complexType>
      <xs:attribute name="test-case" type="xs:string" use="required"/>
      <xs:attribute name="guard" type="xs:string"/>
      <xs:attribute name="requires" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Dispatch inversion: parent-side variant-dispatch declaration.
       Dotted `flag="<carrier>.<flag>"` references one of the parent
       codec's own carriers and one of its declared flags. Cross-doc
       validator (`validate_cross_codec_variant_dispatch`) enforces
       carrier/flag existence, flag-width fit against the imported
       variant's arm count, no value= conflict on the dispatched flag,
       and carrier-before-embed declaration order. -->
  <xs:element name="variant-dispatch">
    <xs:complexType>
      <xs:attribute name="flag" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Flag inversion: parent-side `<sce:flag-bind>` directive
       (child of `<sce:import>`). The `input=` attribute names one of
       the imported leaf's declared `<sce:flag-input name="X" .../>`
       declarations. The `source=` attribute resolves via the dotted-
       form rule: `<carrier>.<flag>` references a local
       `<sce:flags id="X">` flag; bare name references one of the
       parent's own `<sce:flag-input>` declarations (chain-forwarder
       pattern). Cross-doc validator enforces resolution and width
       agreement. -->
  <xs:element name="flag-bind">
    <xs:complexType>
      <xs:attribute name="input" type="xs:NCName" use="required"/>
      <xs:attribute name="source" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Flag inversion: codec-level `<sce:flag-inputs>` block
       containing one or more `<sce:flag-input name="X" width="N"/>`
       child declarations. Each input becomes a positional typed
       parameter on the generated `decode`/`encode` signatures; the
       parent supplies values at import-site via `<sce:flag-bind>`.
       Owns the entire codec-to-codec flag-shaped dependency surface
       (the legacy `<sce:requires-parent-flags>` block is deleted —
       flag-inputs own this surface). -->
  <xs:element name="flag-inputs">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:flag-input" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Flag inversion: a single `<sce:flag-input>` child of
       `<sce:flag-inputs>`. The `name=` is the logical input name
       (referenced by `<sce:flag-bind input="X" .../>` at the parent's
       import site, and by `sce:present-if="X"` predicates in this
       codec's body). The `width=` is the bit-width — v1 lock-in
       fixes width=1 (multi-bit inputs defer to a reachable
       consumer). -->
  <xs:element name="flag-input">
    <xs:complexType>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="width" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- §synth-5-I `<sce:extern>` whitelisted intrinsic registry.
       Bounded escape hatch for platform-specific intrinsics
       (atomic CAS / fences / cache maintenance / IRQ control).
       The `name` is closed-set checked at parse time against the
       SCE-shipped baseline registry; `sig` and `abi` must match the
       registry entry's canonical values. The 4-code rejection family
       (`extern/symbol-not-in-whitelist`, `extern/abi-mismatch`,
       `extern/signature-mismatch`, `extern/ordering-unspecified`)
       fires through `crate::forge::extern_validator::validate_extern`. -->
  <xs:element name="extern">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="sig" type="xs:string" use="required"/>
      <xs:attribute name="abi" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="c"/>
            <xs:enumeration value="rust"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="crate" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- Section 4.3: Lookup key-value mapping entry -->
  <xs:element name="entry">
    <xs:complexType>
      <xs:attribute name="key" type="xs:string" use="required"/>
      <xs:attribute name="value" type="xs:string" use="required"/>
      <!-- Optional: the requirement(s) this row satisfies. A mapping
           table is the shape a specification states row by row ("gear
           3 shall select DRIVE"), so the row is where the claim
           belongs — not the surrounding `<data>`, which would make
           every row's verdict the same verdict. -->
      <xs:attribute ref="sce:req"/>
    </xs:complexType>
  </xs:element>


  <!-- An ORDERED sequence of named alternatives drawn from a value
       space — `<sce:cycle id="…" of="<enum alias>">` with one
       `<sce:step name="…" when="…"/>` per alternative, in the order the
       document states.

       ⚠ The ORDER is the document's, not the value space's, and that is
       the whole reason this element exists. The obvious design walked
       the imported enum's declaration order; in the surveyed material
       the specification's list and the platform's value space agree on
       their first three alternatives and disagree after that, so "the
       next alternative" would have been silently wrong. A value space
       says WHICH values exist; a cycle says in what order a user walks
       them.

       The steps are a SUBSET — a value space usually holds values that
       are not stops at all (an OFF, an INVALID, a MAX sentinel). `when`
       is optional and names the condition under which that stop is
       present; putting it on the step is what removes the hand-typed bit
       positions an availability mask would have needed. Fewer than two
       stops is refused (nothing to navigate), as is a repeated name (one
       value in two positions makes `next` ambiguous). Step names are
       checked against the value space by `forge::cycle_check`. -->
  <xs:element name="cycle">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:step" minOccurs="2" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="of" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="step">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="when" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Section 4.6: Codec field definition with byte layout -->
  <xs:element name="field">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute ref="sce:type" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <xs:attribute ref="sce:bit-size" use="required"/>
      <xs:attribute ref="sce:bit-offset"/>
      <xs:attribute ref="sce:endian"/>
      <xs:attribute ref="sce:max-size"/>
      <xs:attribute ref="sce:length-field"/>
      <xs:attribute ref="sce:present-if"/>
      <xs:attribute ref="sce:dma-burst-align"/>
      <xs:attribute ref="sce:length-arith"/>
      <!-- NL→IR Mapping Roadmap Item 4: physical-quantity annotation. -->
      <xs:attribute ref="sce:quantity"/>
      <xs:attribute ref="sce:scale"/>
      <xs:attribute ref="sce:offset"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-B variant primitive

       Discriminated-union suffix on a codec. The `<sce:variant>` element
       sits under <datamodel> alongside <sce:field> declarations; its
       `tag` attribute references a sibling field (must be unsigned-int)
       whose decoded value selects an arm. Each `<sce:arm value="..."
       type="alias"/>` names an imported codec alias as the arm body;
       `<sce:default type="alias"/>` is the catch-all for unenumerated
       tag values. When no <sce:default> is declared and the arms don't
       cover the tag's value domain, the build fires
       `codec/variant-arm-unreachable`.

       Attributes are unqualified inside <sce:*> elements (matches the
       <sce:entry key/value> convention; SCE-namespaced attrs are
       reserved for the W3C-element host case like <data sce:byte=...>).
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="arm">
    <xs:complexType>
      <!-- Discriminator value (decimal or 0x-hex). Parser carries u64
           internally to fit any unsigned tag width up to uint64. -->
      <xs:attribute name="value" type="xs:string" use="required"/>
      <!-- Body codec alias; must resolve to an <sce:import as="alias"/>
           in the same document. Resolution happens at codegen time. -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <!-- RFC variant-default-uniformity: optional
           default="true" marker selects this arm as the body chosen
           by the outer codec's Default::default(). Parser enforces
           at-most-one per <sce:variant> via
           codec/variant-duplicate-default-arm. Distinct from the
           <sce:default> sibling element (unknown-tag catch-all). -->
      <xs:attribute name="default" type="xs:boolean" use="optional"/>
      <!-- docs/adr/0072: the build feature the arm is compiled under, in
           Cargo's kebab case. A backend that can leave one arm out of a
           build does so where the feature is off (a Cargo feature, or the
           C macro SCE_FEATURE_<NAME> set to 0), and its decode refuses the
           arm's tag. <sce:default> declares no such attribute; the parser
           refuses it on the default="true" arm, which no grammar rule here
           can say. -->
      <xs:attribute name="feature" use="optional">
        <xs:simpleType>
          <xs:restriction base="xs:NCName">
            <xs:pattern value="[a-z][a-z0-9\-]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- `<sce:variant>` serves three distinct purposes by host kind:

       1. **Codec discriminated-union suffix (RFC §synth-5-B)**
          Inside `<datamodel>` of `<scxml sce:kind="codec">` — carries
          `tag` attribute + `<sce:peek-byte>` / `<sce:arm>` /
          `<sce:default>` children. Parser `parse_codec_variant`
          enforces `tag` presence + arm shape.
       2. **Buffer-pool variant discriminator (RFC §synth-5-M)**
          Top-level child of `<scxml sce:kind="buffer-pool">` — carries
          plain text content `reassembly` (or `default`). Parser
          `parse_buffer_pool` enforces the closed enum + the three
          reassembly-only sibling elements.
       3. **Enum variant declaration (NL→IR Item C1 Path A)**
          Child of `<data>` inside `<scxml sce:kind="enum">` — carries
          `name` + `value` attributes. Parser `parse_enum` enforces
          the bijectivity invariant on `value` and uniqueness on `name`.

       The three contexts have disjoint surrounding scopes so there is
       no parse-time ambiguity. The XSD relaxes the global element type
       to permit ALL shapes — `mixed="true"` for text content, every
       attribute optional. The XSD remains a structural-only gate;
       semantic enforcement (codec's required `tag` + arms, buffer-
       pool's closed enum value + required siblings, enum's required
       `name` + `value` pair) is the parser's responsibility per
       `[[feedback-spec-mirror-parity]]`. -->
  <xs:element name="variant">
    <xs:complexType mixed="true">
      <xs:sequence>
        <!-- RFC §synth-5-B peek-byte mode:
             singleton `<sce:peek-byte>` child opts the variant into
             dispatch on the cursor's NEXT byte (read without
             advancing) instead of an own-codec field. Every arm
             body codec then reads the SAME byte as its first wire
             byte. When present, the variant's `tag` attribute MUST
             be the dotted form `<peek_id>.<flag>` referencing this
             element's `id` and one of its `<sce:flag>` children. -->
        <xs:element name="peek-byte" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="sce:flag" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:NCName" use="required"/>
            <!-- v1 fixed at uint8 (Zenoh single-byte network dispatch
                 pattern). Multi-byte peek surfaces as a separate
                 `<sce:peek-bytes>` primitive when a reachable
                 consumer surfaces. -->
            <xs:attribute ref="sce:type" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element ref="sce:arm" minOccurs="0" maxOccurs="unbounded"/>
        <!-- The local name `default` does not collide with the global
             <xs:attribute name="default"/> declared earlier; XSD
             attribute and element symbol spaces are independent. -->
        <xs:element name="default" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="type" type="xs:NCName" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <!-- Tag field id (codec context only) — must reference a sibling
           <sce:field>/<data> with an unsigned-int sce:type. Parser
           `parse_codec_variant` enforces presence + resolution. Item C9
           (RFC §synth-5-M) relaxes the XSD requirement to `optional` so the
           buffer-pool reassembly variant (text content `reassembly`,
           no `tag`) passes; `parse_buffer_pool` enforces the closed
           enum value. -->
      <xs:attribute name="tag" type="xs:string" use="optional"/>
      <!-- NL→IR Item C1 Path A — Enum variant attributes. `name` is
           the source-level identifier authors reference as
           `<EnumName>.<variant>`; `value` is the wire byte (decimal
           or 0x-prefixed hex). Both optional at the XSD layer; the
           enum-kind parser requires both. -->
      <xs:attribute name="name" type="xs:string" use="optional"/>
      <xs:attribute name="value" type="xs:string" use="optional"/>
      <!-- The text of an enum variant on a text line (docs/adr/0015). -->
      <xs:attribute ref="sce:text" use="optional"/>
      <!-- The revision of its enum that added the variant (docs/adr/0044). -->
      <xs:attribute ref="sce:since" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-B flags primitive

       Named-bit-range accessor container over an unsigned-int carrier
       field. The `<sce:flags>` element occupies the same wire bytes as
       a plain `<sce:field>` of the same `sce:type` / `sce:byte` /
       `sce:bit-size`; its `<sce:flag name="X" bit="N" [width="W"]/>`
       children declare ergonomic per-bit-range get/set accessors that
       codegen emits alongside the generated struct. Bit positions are
       0 = LSB, `bit + width - 1 = MSB`. `width` defaults to 1 (the
       single-bit shape — getter/setter use bool); multi-bit
       (width >= 2) returns the smallest unsigned int type that fits.
       Bit-range overlap and `bit + width > carrier_bit_width` are
       rejected at parse time by sce-build.

       Attributes are unqualified on `<sce:flag>` (matches the
       `<sce:entry key/value>` and `<sce:arm value/type>` convention for
       attributes declared on SCE-namespaced child elements).
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="flag">
    <xs:complexType>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <!-- Bit position within the carrier (0 = LSB). Range bounded by
           the carrier's bit width: 0..7 for uint8, 0..15 for uint16,
           0..31 for uint32, 0..63 for uint64. Enforced by sce-build. -->
      <xs:attribute name="bit" type="xs:nonNegativeInteger" use="required"/>
      <!-- Multi-bit accessor: contiguous bit-range size. Defaults
           to 1 (the single-bit shape — bool getter/setter). When > 1
           the accessor returns the smallest unsigned integer type that
           fits the range. `bit + width <= carrier_bit_width` and no
           overlap with sibling flags — both enforced by sce-build. -->
      <xs:attribute name="width" type="xs:positiveInteger" use="optional"/>
      <!-- RFC variant-default-uniformity: optional
           wire-constant baked into the carrier's Default::default().
           Decimal or 0x-hex unsigned integer (parsed via parse_int_u64);
           sce-build rejects values that exceed `(1 << width) - 1`. Used
           by inner codecs that are referenced as a variant arm body so
           the codec's default instance is wire-valid for its own
           dispatch tag. -->
      <xs:attribute name="value" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="flags">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:flag" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute ref="sce:type" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <xs:attribute ref="sce:bit-size" use="required"/>
      <xs:attribute ref="sce:bit-offset"/>
      <xs:attribute ref="sce:endian"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-B B2 repeat primitive — `<sce:repeat>` element

       List-of-imported-codec field. Sits under <datamodel> alongside
       <sce:field> / <sce:flags> declarations; carries an imported
       codec alias (`sce:type=`) that names each element's
       encode/decode. The streaming codec iterates either a sibling
       integer field's decoded value (`count="<id>"`) or
       cursor-exhaustion (`until-eof="true"`), both unqualified as
       declared below; exactly one of the
       two MUST be present.

       `sce:type` here is locally redeclared as `xs:NCName` (the
       imported codec alias) — distinct from the document-level
       `sce:type` global which restricts to primitive `sceType` enum
       values. XSD attribute symbol spaces are scoped per-element so
       this redeclaration does not collide.

       Forward references and shape mismatches are sce-build
       diagnostics:
         - forward / unknown count target → codec/repeat-count-refs-later-field
         - non-integer count target / both or neither count form →
           validation/invalid-attribute
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="repeat">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <!-- Imported codec alias (matches an `<sce:import as=...>` in
           the same document); resolved at codegen time. Unqualified
           on <sce:repeat> (matches the <sce:arm type=...> shape;
           distinct from the global qualified `sce:type` which
           restricts to primitive sceType enum values). -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <!-- Mutually exclusive: exactly one of count / until-eof must
           appear. sce-build enforces; XSD allows either to keep the
           grammar declarative. -->
      <xs:attribute name="count" type="xs:string"/>
      <xs:attribute name="until-eof" type="xs:boolean"/>
      <xs:attribute name="max-count" type="xs:nonNegativeInteger"/>
      <!-- RFC §synth-5-B: present-if on the
           entire repeat block. When set, the count field MUST also
           carry the IDENTICAL `sce:present-if` predicate (co-gating
           contract enforced by `validate_codec_repeat_present_if_co_
           gating` — wire bytes for both count and elements appear or
           disappear atomically). Predicate grammar covers the
           `<carrier>.<flag>` (Local) and `parent.<flag>`
           (Parent) forms, with optional `!` negation. -->
      <xs:attribute ref="sce:present-if"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       TLV chain — RFC §synth-5-B B3 "TLV chain"

       Bounded extension list, each entry has id+len+body shape (the
       entry shape lives inside the imported entry codec, not enforced
       here). Iteratively decoded up to `max-depth`; an entry past it is
       refused as TooManyElements:

         <sce:tlv-chain id="extensions"
                        sce:type="TlvEntry"
                        sce:byte="2"
                        max-depth="8"/>

       MCU-class — codecs containing this element emit only on
       `(rust, *)` and `(c11, bare_metal)` per the §synth-5-J-4 matrix; on
       `{cpp, kotlin, go, python}` the codec is rejected with
       `codegen/mcu-class-kind-on-non-mcu-language` (the existing
       kind-class diagnostic, repurposed at codec-content granularity).

       `max-depth` is the protocol's bound, stated only where the protocol
       states one: a chain with none reads entries until it ends. What a
       node does past what it holds is not in the document: a capacity is
       the deployment's (docs/adr/0077 §7).

       Diagnostics:
         - max-depth=0 → validation/invalid-attribute
         - codec containing tlv-chain on a non-MCU language →
             codegen/mcu-class-kind-on-non-mcu-language
       ═══════════════════════════════════════════════════════════════ -->

  <!-- RFC §synth-5-B — `<sce:tlv-chain>` termination strategies. The
       default `exhaust-or-depth` ends the chain on cursor-exhaust +
       max-depth (used when nothing follows the chain on the wire).
       `entry-flag` reads a named flag on each decoded entry's flags
       carrier and stops the chain when the flag is clear — required
       when the wire stream has payload after the chain (zenoh-pico
       request body's query/put/del variant after the ext chain).
       The `entry-flag-name` attribute names the flag (mandatory when
       terminate-on="entry-flag"). -->
  <xs:simpleType name="tlvTerminateOnType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="exhaust-or-depth"/>
      <xs:enumeration value="entry-flag"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="tlv-chain">
    <xs:complexType>
      <xs:sequence>
        <!-- Entry-by-entry flag-input binds: a flag-input of the entry codec
             whose value is not one value for the whole chain but depends on
             the entry decoded just before. See `entry-flag-bind`. -->
        <xs:element ref="sce:entry-flag-bind" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <!-- Imported entry codec alias (matches an `<sce:import as=...>`
           in the same document); resolved at codegen time. Mirrors
           `<sce:repeat type=...>` / `<sce:arm type=...>` shape. -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <!-- The protocol's bound on the chain, absent where it states none
           (docs/adr/0077 §7). -->
      <xs:attribute name="max-depth" type="xs:positiveInteger"/>
      <!-- RFC §synth-5-B — termination strategy + flag-name attribute.
           Default `exhaust-or-depth` ends on cursor-exhaust +
           max-depth (the item B3 tlv-chain shape). `entry-flag` reads `entry-flag-name`
           on each decoded entry's flags carrier and stops the chain
           when the flag is clear; required when the wire stream
           continues past the chain. Parser enforces flag-name
           presence when terminate-on="entry-flag". -->
      <xs:attribute name="terminate-on" type="sce:tlvTerminateOnType"/>
      <xs:attribute name="entry-flag-name" type="xs:string"/>
      <!-- Which part of a decoded entry tells its kind: `<carrier>.<flag>`
           names a multi-bit flag of the entry codec's flags carrier, a
           bare name one of its unsigned integer fields — the grammar
           `sce:length-field` uses for a value inside another field. A
           later field's `sce:present-if="<chain>.has(<value>)"` is true
           when an entry of this chain has that identifier, so a chain
           some predicate reads must declare it. The parser checks the
           spelling; the entry codec is only known once imported, and
           sce-build checks there that the flag or field exists, is
           unsigned and holds the values the predicates look for. -->
      <xs:attribute name="entry-id" type="xs:string"/>
      <!-- Flags of the field `entry-id` names whose bits the identifier
           leaves out: a whitespace-separated list of `<field>.<flag>`,
           where `<field>` is the bare name `entry-id` carries and a flags
           carrier of the entry codec. The identifier is the field with
           those bits cleared, so an entry's continuation flag (set on
           every entry but the last) does not make two entries of one kind
           two identifiers, and `has(<value>)` looks for the value without
           them. The bits are read from the entry codec's own flag layout,
           not written here a second time. Requires `entry-id`, which must
           name a whole field and not a single flag; sce-build checks the
           flags exist and that a value a predicate looks for has none of
           those bits set. -->
      <xs:attribute name="entry-id-except" type="xs:string"/>
      <!-- RFC §synth-5-B — `<sce:tlv-chain sce:present-if="P">`
           gates the entire chain on a flag predicate (mirrors the
           repeat-with-present-if lift). When the predicate is
           false the chain field is absent from the wire; the
           host-language type wraps as a per-language optional
           (Option<Vec<T>> / std::optional<vector> / MutableList<T>?
           / bare []T (Go slice nilness) / Optional[List[T]] / C11
           carrier-bit-as-truth via _len=0). Required by zenoh-pico
           network MID bodies whose ext chain is Z-bit-gated on the
           per-MID header. -->
      <xs:attribute ref="sce:present-if"/>
    </xs:complexType>
  </xs:element>

  <!-- `<sce:entry-flag-bind input="X" previous-entry-id="V"/>`, a child of
       `<sce:tlv-chain>`: the chain supplies the entry codec's
       `<sce:flag-input name="X">` itself, entry by entry. The input is 1 for
       an entry whose immediately preceding entry has the identifier `V` (the
       chain's `entry-id`; decimal, 0x or 0b) and 0 for every other entry, the
       first included. It is adjacency and not membership: an entry two places
       after an entry with that identifier does not follow it.

       `<sce:flag-bind>` on the import supplies a value that is one for the
       whole chain (a flag of a carrier the parent has already read, or the
       parent's own flag-input); this supplies the value that only the chain,
       while it reads, can know. An input is bound by one or the other, never
       both, and every input the entry codec declares is bound by one of them.
       The chain must declare `entry-id`; sce-build checks that the entry codec
       declares the input, that it is one bit wide, that nothing else binds it,
       and that `V` is a value the identifier can hold. -->
  <xs:element name="entry-flag-bind">
    <xs:complexType>
      <xs:attribute name="input" type="xs:NCName" use="required"/>
      <xs:attribute name="previous-entry-id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-B — single-codec embed primitive

       Embeds an imported codec inline at the named byte position.
       The embedded codec's own decode/encode methods consume/produce
       bytes directly; the host language emits a nested struct of the
       imported codec's type. Mirrors `<sce:repeat>` / `<sce:tlv-chain>`
       tri-attr shape (id + type + sce:byte) plus two optional
       attributes that compose freely.

       First reachable consumer: zenoh-pico declare bodies
       (decl_keyexpr / decl_subscriber / decl_queryable / decl_token)
       embedding `codec_zenoh_wireexpr` after the body's VLE id field
       — Zenoh wire packs id + wireexpr inline with no length prefix
       between them, so the always-present cursor-direct shape exactly
       mirrors that wire layout.

       The two optional attributes:

         - `sce:present-if="<carrier>.<flag>" | "parent.<flag>" | "!..."`
           gates the embed on a runtime predicate (mirrors the
           present-if grammar used by `<sce:field>` and `<sce:repeat>`).
           When set the host-language type wraps in a per-language
           optional (Option<T> / std::optional<T> / T? / *T /
           Optional[T]). C11 keeps the bare struct member with
           carrier-bit-as-truth for presence (no nullable wrapper).

         - `sce:length-from="<sibling_field_id>"` bounds the embedded
           codec's decode-time cursor scope to the named earlier
           integer field's value (typical: a VLE total-length prefix).
           Encode side trusts the author to keep `self.<sibling> ==
           emitted_inner.len()` (mirrors the LengthRef author-trust
           contract). First reachable consumer: zenoh-pico
           `_z_decl_ext_keyexpr_encode` (declarations.c:38-50) where
           the outer envelope's VLE total_length prefix scopes the
           inner wireexpr-shaped body.

       Diagnostics (folded into validation/invalid-attribute):
         - sce:length-from references later/unknown sibling
         - sce:length-from references non-integer sibling
         - sce:present-if cross-field validation reuses the existing
           present-if predicate validators
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="embed">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <!-- Imported codec alias (matches an `<sce:import as=...>` in
           the same document); resolved at codegen time. Mirrors
           `<sce:repeat type=...>` / `<sce:tlv-chain type=...>` /
           `<sce:arm type=...>` shape. -->
      <xs:attribute name="type" type="xs:NCName" use="required"/>
      <xs:attribute ref="sce:byte" use="required"/>
      <!-- RFC §synth-5-B — optional present-if predicate gating the
           embed. Same grammar as `<sce:field sce:present-if>`. -->
      <xs:attribute ref="sce:present-if"/>
      <!-- RFC §synth-5-B — optional `sce:length-from="<id>"` bounds
           the embedded codec's decode-time cursor scope to the named
           sibling integer field's value. Author-trust on encode
           (sibling value must match emitted byte count). -->
      <xs:attribute ref="sce:length-from"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       Test vector — RFC §synth-5-B "Test vector" (B2-test-vector)

       Inline reference oracle declared as a top-level child of an
       algorithm <scxml> root:

         <sce:test-vector hex="313233343536373839" value="0x29B1"/>

       Both attributes are required; hex must be even-length hex-only;
       value is parsed in v1 as a boolean / signed-integer / unsigned-
       integer literal compatible with the algorithm's declared return
       type. v1 supports `sce:kind="algorithm"` only — declaring this
       element under any other kind rejects with
       `algorithm/test-vector-unsupported-kind`; codec multi-field
       test vectors defer to B5 alongside the Zenoh msg-set authoring.

       Diagnostics:
         - test-vector under non-algorithm kind →
             algorithm/test-vector-unsupported-kind
         - missing hex / value attribute → validation/missing-attribute
         - malformed hex / value literal → validation/invalid-attribute
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Algorithm form (B2): attribute `value=` declares the scalar
       expected return — content is empty.
       Codec form: nested `<sce:decoded field=...>` rows
       declare the field-by-field expected struct. The two forms are
       union'd via choice on the schema; the parser dispatches on
       `sce:kind` so an algorithm fixture with `<sce:decoded>` rows
       (or vice versa) rejects with a precise validation error
       upstream of XSD. -->
  <xs:element name="test-vector">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="sce:decoded"/>
      </xs:choice>
      <xs:attribute name="hex" type="xs:string" use="required"/>
      <!-- `value` is required for algorithm form (B2); codec form
           sets it via nested <sce:decoded> rows instead. The
           parser enforces the per-kind requirement; making `value`
           optional here keeps the XSD a structural surface and lets
           the kind-aware parser return the precise diagnostic. -->
      <xs:attribute name="value" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- RFC §synth-5-B codec test-vector field assignment. Shape:
       `<sce:decoded field="..." (value|hex|string)="..."/>`.
       Variant / TLV-chain / repeat sibling element names
       (`<sce:decoded-variant>`, `<sce:decoded-chain>`,
       `<sce:decoded-entry>`) are consumer-gated; only the leaf
       field form is declared. -->
  <xs:element name="decoded">
    <xs:complexType>
      <xs:attribute name="field" type="xs:string" use="required"/>
      <!-- Exactly one of value / hex / string must be set (the parser
           validates this — XSD's xs:choice across attributes is not
           expressible without elaborate typing tricks). -->
      <xs:attribute name="value" type="xs:string" use="optional"/>
      <xs:attribute name="hex" type="xs:string" use="optional"/>
      <xs:attribute name="string" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!--
    Section 4.7: Validator rules use data-attribute form only.
    Validation attributes (sce:range-min, sce:range-max, sce:max-delta,
    sce:sample-interval, sce:plausibility) are declared as global attributes
    above and applied directly to <data> elements.
  -->

  <!-- ═══════════════════════════════════════════════════════════════
       Composition extensions — sce:template / sce:use / sce:param
       (RFC §6.5, AOT-only)

       In normal build flow the sce-build template expander (Rust)
       eliminates every <sce:use> before the XSD validator runs, so
       these declarations act as schema self-awareness: they enable
       tooling (editor integrations, standalone template-file linters)
       to recognise the grammar. Structural correctness inside template
       files is still enforced at expansion time by
       sce-build/src/template.rs.
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Param-name pattern matches RFC §3.1. Mirrored by is_valid_param_name
       in sce-build/src/template.rs; keep the two in sync. -->
  <xs:simpleType name="paramNameType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Call site inside an SCXML document. The `template` attribute is
       the only reserved slot; every other attribute binds a parameter
       declared by the referenced template file. xs:anyAttribute
       (processContents="skip") captures param bindings without requiring
       them to be pre-declared — the expander validates them at build
       time against the template's <sce:param> declarations. -->
  <xs:element name="use">
    <xs:complexType>
      <xs:attribute name="template" type="xs:string" use="required"/>
      <xs:anyAttribute processContents="skip"/>
    </xs:complexType>
  </xs:element>

  <!-- Template declaration — root element of a standalone template file.
       Declared here so the schema is self-describing for tooling; template
       files themselves are not routed through this XSD in the build flow
       (the expander parses them directly).

       Content model: a single lax wildcard. The authoring shape is "zero or
       more <sce:param> declarations followed by body content" (RFC §3.1),
       but that ordering — and the <sce:param> grammar itself — is enforced
       by the expander (sce-build/src/template.rs), the sole SSOT for
       template structure. The XSD does NOT re-encode it: a named
       <sce:param> particle ahead of an `##any` wildcard makes the content
       model non-deterministic (XSD 1.0 Unique Particle Attribution
       violation), which strict schema processors (libxml2 >= 2.15) reject at
       schema-compile time. A lone wildcard is unambiguous, still admits any
       sce:* body element, and matches the algorithm-body elements below. -->
  <xs:element name="template">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Parameter declaration. Two roles:
       * Inside <sce:template>: name + (required | default), per RFC §3.1.
       * Inside <sce:signature> (algorithm kind, RFC §synth-5-A): name + type.
       The parser distinguishes by enclosing element; the schema permits
       both shapes via separate optional attributes. -->
  <xs:element name="param">
    <xs:complexType>
      <xs:attribute name="name" type="sce:paramNameType" use="required"/>
      <xs:attribute name="required" type="xs:boolean"/>
      <xs:attribute name="default" type="xs:string"/>
      <!-- RFC §synth-5-A signature param: by-value scalar or by-reference bytes.
           `list<T>` is admitted lexically so the parser's v1 refusal of a
           list parameter (SCE_FORGE.md §4.12) is the diagnostic an author sees. -->
      <xs:attribute name="type" type="sce:algorithmValueType"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       Algorithm kind body (SCE Protocol-Synthesis RFC §synth-5-A item A3)

       Pure synchronous functions with bounded loops and mutable
       locals. Body statements are <sce:var>/<sce:assign>/<sce:if>/
       <sce:while>/<sce:foreach>/<sce:return>/<sce:call>; nested
       blocks recurse via xs:any lax. The parser
       (`forge::parser::parse_algorithm`) enforces structural
       constraints (e.g. statement order, max-iter on while, l-value
       shape on assign). The schema only declares element/attribute
       presence so libxml2 stops accepting freeform body markup.
       ═══════════════════════════════════════════════════════════════ -->

  <xs:element name="signature">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="return">
    <xs:complexType>
      <!-- type=  inside <sce:signature>; expr=  inside body. The two
           are not mutually exclusive at schema level — the parser
           rejects `<sce:return type expr/>` collisions. -->
      <xs:attribute name="type" type="sce:algorithmValueType"/>
      <xs:attribute name="expr" type="xs:string"/>
      <!-- SCE byte-buffer-build (SCE_FORGE.md §4.12): fixed output-buffer
           capacity for a `type="bytes"` or `type="list<T>"` return. Required
           by the parser when the return is a buffer (the no-alloc profile's
           bound); refused otherwise. Mirrors `<sce:helper returns-max-size>`.
           The legacy spelling of the bracket on the return's type
           (`bytes[64]`, docs/adr/0086 section 1.3): read as that bracket and
           reported with `validation/bound-attribute-superseded`. -->
      <xs:attribute name="returns-max-size" type="xs:positiveInteger"/>
      <xs:attribute ref="sce:limit"/>
      <!-- The integer arithmetic contract (SCE_FORGE.md §3.4.1): an
           algorithm whose integer arithmetic can fail — overflow, a division
           by zero, a signed MIN / -1 — says so here, on the signature's
           return, and its callers receive the failure. Meaningful on the
           signature's declaration only; the parser refuses it on a body's
           return. -->
      <xs:attribute name="may-fail" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="body">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--
    Local binding. A scalar local carries `init=` (required by the parser).

    SCE byte-buffer-build (SCE_FORGE.md §4.12): a `type="bytes"` or
    `type="list<T>"` local is a growable output buffer instead — it carries
    `capacity=` (the fixed bound) and NO `init=` (it starts empty and is
    filled forward-only via `<sce:append>`). `init` is therefore relaxed from
    `use="required"` to optional at schema level; the parser enforces
    "scalar ⇒ init, buffer ⇒ capacity, no init" with a precise structural
    diagnostic.
  -->
  <!--
    One field of a record value being built whole: the schema field `name`
    names, given the value of `expr`. A record is built from one `<sce:set>`
    per field of its imported event-schema — an algorithm's record local
    (`<sce:var type="record:<alias>">`, SCE_FORGE.md §4.12) and a
    `sce-static` statechart's record variable
    (`<data sce:type="record:<alias>">`, SCE Accepted Subset §2.15) alike.
    Its own element rather than `sce:field`, which is the codec's
    byte-layout field. Which fields must be given is the schema's, judged by
    the parser once the import is resolved.
  -->
  <xs:element name="set">
    <xs:complexType>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    A `type="record:<alias>"` local (SCE_FORGE.md §4.12) is built whole from
    one `<sce:set>` per field of the imported event-schema, and takes no
    `init`.
  -->
  <xs:element name="var">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:set" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="type" type="sce:algorithmValueType" use="required"/>
      <xs:attribute name="init" type="xs:string"/>
      <!-- The legacy spelling of the bracket on the buffer's type
           (`bytes[64]`, `list&lt;int64&gt;[16]`, docs/adr/0086 section 1.3):
           read as that bracket and reported with
           `validation/bound-attribute-superseded`. -->
      <xs:attribute name="capacity" type="xs:positiveInteger"/>
      <xs:attribute ref="sce:limit"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="assign">
    <xs:complexType>
      <xs:attribute name="target" type="xs:string" use="required"/>
      <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    SCE byte-buffer-build (SCE_FORGE.md §4.12): forward-only append to a
    `type="bytes"` buffer local. `target` is the buffer's name; `expr` lowers
    by its static type — a `uint8` value pushes one byte, a `bytes` value
    extends the buffer. Index writes (`buf[i]=x`) are deliberately excluded;
    `<sce:append>` is the only buffer-mutation statement.
  -->
  <xs:element name="append">
    <xs:complexType>
      <xs:attribute name="target" type="xs:string" use="required"/>
      <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    Render a text template a `sce-static` statechart imports into a string
    variable (docs/adr/0087, section 3.1, item 6). `template` is the alias of
    the `<sce:import kind="text-template">`; `location` a `string[N]`
    variable with `N` at least the template's MAX_LEN, replaced whole. One
    `<sce:set name expr>` per hole of the template, each once.
  -->
  <xs:element name="render">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:set" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="template" type="xs:string" use="required"/>
      <xs:attribute name="location" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    The two markers a `sce:kind="text-template"` document puts an untrusted
    hole's text between (docs/adr/0087, section 3.1, item 3): printable
    ASCII, 1 to 32 bytes each, neither inside the other nor in the template's
    text — the parser's rules, answered as `validation/text-template-fence`.
  -->
  <xs:element name="fence">
    <xs:complexType>
      <xs:attribute name="open" type="xs:string" use="required"/>
      <xs:attribute name="close" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    The text of a `sce:kind="text-template"` document (docs/adr/0087,
    section 3.1, item 2): its character data, nothing trimmed, with a
    `<sce:put hole>` standing where a hole's text goes.
  -->
  <xs:element name="text">
    <xs:complexType mixed="true">
      <xs:sequence>
        <xs:element ref="sce:put" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Where the text of the hole `hole` goes in a template's `<sce:text>`. -->
  <xs:element name="put">
    <xs:complexType>
      <xs:attribute name="hole" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    Empty a `sce-static` statechart's `list<T>` variable (SCE Accepted Subset
    §2.15). An algorithm's list local needs no such statement — it starts
    empty on every call — but a datamodel list outlives the macrostep that
    filled it.
  -->
  <xs:element name="clear">
    <xs:complexType>
      <xs:attribute name="target" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    Read a text a `sce-static` statechart holds into a record of an imported
    event schema, or keep why it is not one (docs/adr/0087, section 2.1).
    `text` names a `string[N]` value; `schema` the alias of the event schema;
    `location` the variable of `record:R` or `optional<record:R>` a value of
    the text replaces whole; `refusal` the variable of
    `optional<record:L>`, `L` the document `sce:std/lift/refusal.scxml`,
    present after a refused text and absent after a read one. The statement
    raises nothing.
  -->
  <xs:element name="lift">
    <xs:complexType>
      <xs:attribute name="text" type="xs:string" use="required"/>
      <xs:attribute name="schema" type="xs:string" use="required"/>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="refusal" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="if">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="cond" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="else">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="while">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="cond" type="xs:string" use="required"/>
      <xs:attribute name="max-iter" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="foreach">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="item" type="xs:NCName" use="required"/>
      <xs:attribute name="in" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    Build-time const (RFC §synth-5-A scalar form, RFC §synth-5-F build-time fold form).

    Two shapes accepted by `forge::parser::parse_algorithm_const`:

      Scalar (RFC §synth-5-A v1):
        <sce:const name="N" type="uint16" init="0xFFFF"/>

      Build-time array (RFC §synth-5-F):
        <sce:const name="TABLE" type="array<u16, 256>" sce:compute-at="build">
          <sce:fold range="0..256" as="i" elem-type="u16">
            ...statements...
            <sce:yield expr="..."/>
          </sce:fold>
        </sce:const>

    `type` is relaxed from `sce:sceType` (scalar enum) to `xs:string` so
    the `array<elem, len>` form passes XSD validation; the parser
    rejects ill-formed values with a precise diagnostic.

    `init` is no longer `use="required"` — the parser enforces "exactly
    one of `init=` or `<sce:fold>` body" with a structural diagnostic
    that is more useful than a missing-attribute error from XSD.
  -->
  <xs:element name="const">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:fold" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="init" type="xs:string"/>
      <xs:attribute ref="sce:compute-at"/>
    </xs:complexType>
  </xs:element>

  <!--
    RFC §synth-5-F build-time fold body. `range="START..END"` is exclusive
    upper-bound; `as` names the loop variable; `elem-type` is the
    yielded element's scalar type. The terminal `<sce:yield>` carries
    the per-iteration expression.
  -->
  <xs:element name="fold">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="range" type="xs:string" use="required"/>
      <xs:attribute name="as" type="xs:NCName" use="required"/>
      <xs:attribute name="elem-type" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- RFC §synth-5-F: terminal element of an `<sce:fold>` body. -->
  <xs:element name="yield">
    <xs:complexType>
      <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="call">
    <xs:complexType>
      <xs:attribute name="target" type="xs:NCName" use="required"/>
      <xs:attribute name="args" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!--
    A precondition of a `may-fail` algorithm (SCE_FORGE.md §3.4.1): the body
    goes on only where `cond` holds, and fails `precondition` where it does
    not — an input outside the algorithm's domain is refused, never answered
    with a value that looks like one. After it the analysis knows `cond`.
  -->
  <xs:element name="require">
    <xs:complexType>
      <xs:attribute name="cond" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-C (item B6, MCU-class): byte-stream link
    endpoint declared via `<scxml sce:kind="link">`. This surface is
    the minimum vertical slice that exercises the rust codegen path:
    `<sce:link-class>` enum body + `<sce:framer ref="..."/>` (required) +
    `<sce:backpressure>` + `<sce:events>` rows. `<sce:rx-pool>` /
    `<sce:tx-pool>` defer to B7's buffer-pool kind.
  -->

  <!-- RFC §synth-5-C link-class enumeration. Five strings shipped today;
       OS-specific classes (e.g. `unix_socket`, `qnx_msg`) land
       additively in later phases. -->
  <xs:simpleType name="linkClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="udp"/>
      <xs:enumeration value="tcp"/>
      <xs:enumeration value="serial"/>
      <xs:enumeration value="websocket"/>
      <xs:enumeration value="raw_eth"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- RFC §synth-5-C backpressure policy. -->
  <xs:simpleType name="backpressureType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="drop"/>
      <xs:enumeration value="block"/>
      <xs:enumeration value="signal-event"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="link-class">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="sce:linkClassType"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="framer">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="backpressure">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="sce:backpressureType"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="inbound">
    <xs:complexType>
      <xs:attribute name="event" type="xs:string" use="required"/>
      <xs:attribute name="when" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="outbound">
    <xs:complexType>
      <xs:attribute name="event" type="xs:string" use="required"/>
      <xs:attribute name="encode" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="events">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="sce:inbound"/>
          <xs:element ref="sce:outbound"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-E: link-side `<sce:rx-pool>`
    / `<sce:tx-pool>` reference a `<scxml sce:kind="buffer-pool">`
    sibling document by name. The cross-resolution validator
    (`link/pool-slot-smaller-than-framer-max`) wires pool ↔ framer
    through `compile_forge_with_imports`.
  -->
  <xs:element name="rx-pool">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="tx-pool">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-E sample-callback surface: link-side `<sce:stage-pool>`
    references a `<scxml sce:kind="buffer-pool">` sibling document by
    name. Single source of truth for `Sample::take()`'s stage-copy
    destination, co-located with `<sce:rx-pool>` / `<sce:tx-pool>` on
    the link kind. SCXML on-sample validators
    (`validate_on_sample_link_references`) consult the build's
    `SceCrossDocRegistry` to decide whether `pool/sample-take-without-
    stage-pool` fires for a state's `<sce:on-sample link="X">`.
  -->
  <xs:element name="stage-pool">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-E (item B7, MCU-class): SRAM-placed,
    DMA-aligned slot table declared via `<scxml sce:kind="buffer-pool">`.
    The schema here is the minimum vertical slice; the 7-state
    lifecycle FSM and cache-maintenance pinning are realised by the
    buffer-pool codegen (`sce-build/src/forge/buffer_pool_fsm.rs` +
    the per-backend buffer_pool templates).
  -->

  <!-- RFC §synth-5-E lines 948-957 cache-policy enumeration. -->
  <xs:simpleType name="cachePolicyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="maintain"/>
      <xs:enumeration value="non-cacheable"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="slot-count">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="slot-size">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="section">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="alignment">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="dma-channel">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="cache-policy">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="sce:cachePolicyType"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════════════════════════════════════════════
       RFC §synth-5-M reassembly-variant buffer-pool fields (item C9)

       Three sibling elements required when
       `<sce:variant>reassembly</sce:variant>` is declared on a
       `<scxml sce:kind="buffer-pool">` document. Parser-side
       enforcement (`parse_buffer_pool` rejects missing or zero values)
       via `mem/reassembly-pool-variant-missing-max-fragments` +
       `mem/reassembly-pool-variant-missing-timeout` codes. Cross-doc
       validators that read `<sce:per-peer-quota>` against §synth-5-K's
       `peer_table.capacity` (build-time invariant
       `peer_table.capacity × per-peer-quota ≥ slot_count`) run at
       deploy time (`sce-build/src/mesh/deploy.rs`).
       ═══════════════════════════════════════════════════════════════ -->
  <xs:element name="max-fragments-per-message">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="reassembly-timeout-ms">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="per-peer-quota">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:positiveInteger"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!--
    SCE Protocol-Synthesis RFC §synth-5-D (item C2, MCU-class): Worker kind declared
    via `<scxml sce:kind="worker">`. The schema vertical slice covers
    the four worker body elements:
      - <sce:link-rx ref="..."/>  required driving link kind reference
      - <sce:inbox ref="..."/>    required alias of the imported queue that is the inbox
      - <sce:outbox ref="..."/>   optional recipient inbox path
      - <sce:body>...</sce:body>  optional SCXML actions (usually empty)
    Cross-resolution validators live in sce-build
    (`worker/link-rx-ref-unknown`, `worker/inbox-ref-unknown`,
    `worker/inbox-queue-not-single-consumer`); the XSD enforces structural
    shape only.
  -->
  <xs:element name="link-rx">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="inbox">
    <xs:complexType>
      <!-- SCE Protocol-Synthesis RFC §synth-5-P Migration (worker, §synth-5-D): the
           inbox is a queue the worker imports with
           `<sce:import kind="queue">` and names here by alias. The shape
           stays optional in the schema and the Rust parser enforces presence
           with a typed diagnostic, as every attribute that a removed form
           must still reach the parser with does. -->
      <xs:attribute name="ref" type="xs:NCName" use="optional"/>
      <!-- Removed: the inline ring depth and ordering. They stay in the
           grammar for one reason: a document that still writes them must
           reach the parser, which refuses it with `worker/inbox-inline-removed`
           and names the queue document that holds exactly what the ring held
           (`capacity = depth - 1`, one producer, one consumer, `wait-free`),
           where a schema failure would only say the attribute is unknown. -->
      <xs:attribute name="depth" type="xs:string" use="optional"/>
      <xs:attribute name="ordering" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="outbox">
    <xs:complexType>
      <!-- `ref` carries the recipient namespace; spec line 895 example
           `session_fsm.inbox` uses dot notation, so `xs:string` rather
           than the NCName restriction the pool-side refs use. -->
      <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- SCE Protocol-Synthesis RFC §synth-5-E sample-callback: SCXML state-level
       subscriber declaration. Lifts the spec line 1269 callback
       contract ("the subscriber callback receives `&Sample<'_>`")
       into a state-scoped `<sce:on-sample link="X" event="E"/>`
       parser-AST extension; attributes are link + event (both
       required). Cross-reference resolution against the forge link
       kind registry runs in `validate_on_sample_link_references`.
       The optional `callback="rust:crate::path::fn"` extern
       reference attribute: codegen wires the path into
       the dispatch shim with a borrow-mode call site. XSD enforces
       attribute presence shape only; the language-prefixed Rust path
       subset is checked by the Rust validator
       `validate_on_sample_callback_paths` so the diagnostic message
       can name specific path-syntax mistakes per
       `pool/sample-callback-signature-non-borrow`. -->
  <xs:element name="on-sample">
    <xs:complexType>
      <xs:attribute name="link" type="xs:string" use="required"/>
      <xs:attribute name="event" type="xs:string" use="required"/>
      <xs:attribute name="callback" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- SCE Protocol-Synthesis RFC §5.2: top-level driver-header
       reference. Allowed only as a direct child of `<scxml>` root;
       the C11 backend emits `#include "<resolved>"`
       at the top of the generated `*_sm.c` so cross-TU symbol
       resolution is handled by the C compiler. `href`
       is required; the parser resolves it against
       `deploy.yaml`'s `platform.driver_root` (or the SCXML file's
       parent directory as fallback). Unresolved paths surface
       `mcu/driver-header-not-found`. The SCXML root content model
       in `sce-forge.xsd` is `xs:any namespace="##any" lax` so XSD
       cannot strictly forbid misplacement; downstream codegen only
       consumes top-level instances, matching the W3C lax-anywhere
       pattern. -->
  <xs:element name="driver">
    <xs:complexType>
      <xs:attribute name="href" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ── Elements the tree reads that this grammar did not declare ──

       Measured 2026-09-20: five `sce:` elements were read by a parser,
       written by fixtures, and declared nowhere. The SCXML root content
       model in `sce-forge.xsd` is `xs:any namespace="##any" lax`, so an
       undeclared element validates by being unknown — the grammar was
       silent about them rather than permissive on purpose. That silence
       is the same defect class as an attribute nobody looks for (see the
       `SCE_ATTRIBUTES` comment in `forge/parser.rs`), one level up: an
       element the grammar does not name cannot be checked, spell-checked
       or rejected when misspelled.

       Each declaration below states what its reader actually accepts, so
       the grammar becomes a true statement about the tree rather than a
       partial one. -->

  <!-- Read by `parse_procedure`'s datamodel walk (`forge/parser.rs`,
       `tag_name().name() == "helper"`). ⚠ `returns-max-size` is read
       QUALIFIED here (`sce_attr`) while `<sce:return>` above declares an
       unqualified one — two spellings of one name, which is why the
       global declaration below exists. Converging them is a behaviour
       change for authored documents and belongs to its own round. -->
  <xs:attribute name="returns-max-size" type="xs:positiveInteger"/>

  <!-- ⚠ `args` is OPTIONAL, though every `<sce:helper>` in the checkout
       writes one. `parse_procedure_helper` reads it with
       `unwrap_or("")` and splits on commas, so an absent `args` is a
       helper that takes no arguments — a form the parser supports and
       this grammar refused while the attribute was `use="required"`.
       The discriminator for the whole file: a grammar may be stricter
       than its parser where the extra strictness removes no MEANING (a
       bare `<sce:reset-on/>` says exactly what omitting the element
       says), and may not where it removes a form that means something
       (a helper of no arguments). -->
  <xs:element name="helper">
    <xs:complexType>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="args" type="xs:string"/>
      <xs:attribute name="returns" type="sce:sceType" use="required"/>
      <xs:attribute ref="sce:returns-max-size"/>
    </xs:complexType>
  </xs:element>

  <!-- Statechart executable content: a call into host code, read by
       `SCXMLParser::parse_native_action`. Declared because the content
       models around it are `xs:any processContents="lax"`, so an
       undeclared element validates by being unknown and a misspelling
       validates the same way. Found 2026-09-20 by
       `every_sce_element_a_document_carries_is_named_by_the_grammar`
       once its sweep reached the whole checkout instead of three
       fixture directories. -->
  <xs:element name="action">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="sce:arg" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <!-- Whether the machine's correctness depends on the host performing
           the operation (docs/adr/0038). Required: an action that does not say
           is the gap the attribute closes. -->
      <xs:attribute name="effect" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="duty"/>
            <xs:enumeration value="notice"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <!-- The action of the same state's `<onexit>` that gives back what this
           duty took on `<onentry>`. -->
      <xs:attribute name="released-by" type="xs:string"/>
      <!-- ADR 0057 §3: the feature condition under which the action is
           present. Its grammar and names are the parser's rules. -->
      <xs:attribute name="requires" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- One argument of a `<sce:action>`. `name` is optional: the parser
       reads it and a positional argument leaves it empty. -->
  <xs:element name="arg">
    <xs:complexType>
      <xs:attribute name="expr" type="xs:string" use="required"/>
      <xs:attribute name="name" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- The element form of a provenance anchor — the specification a
       node came from. `doc-id` is the only required attribute; of
       `page` / `row` / `path` the parser takes the FIRST present, in
       that order, so all three are optional here and the grammar has no
       vocabulary for the precedence. -->
  <xs:element name="provenance">
    <xs:complexType>
      <!-- ⚠ NOT `use="required"`, although the parser requires it. An
           absent `doc-id` and an empty one are ONE defect — the anchor
           names no document — and `MalformedProvenance` is the one code
           that says so, whichever spelling the author reached for.
           Declaring it required here moved the absent case to libxml2
           and left the empty case with the parser: two messengers for
           one defect, and a consumer branching on `code` would have to
           know which. Measured by
           `element_form_without_doc_id_rejects_as_the_same_code`, which
           went red the moment this said `required`. -->
      <xs:attribute name="doc-id" type="xs:string"/>
      <xs:attribute name="rev" type="xs:string"/>
      <xs:attribute name="section" type="xs:string"/>
      <!-- ⚠ `xs:string`, not an integer type, and for the same reason
           `doc-id` is not `required`. The parser reads these with
           `.parse::<u32>().ok()` and DROPS a value that does not parse
           instead of refusing it, because the compact URI spelling of
           the same anchor does the same — `#4.4.2:draft` reads as a
           section with no position — and its own comment says the two
           spellings of one grammar have to agree about what they
           accept. An integer type here is what makes them disagree: the
           element form would be refused for a value the compact form
           takes, and libxml2 would be the one saying so. -->
      <xs:attribute name="page" type="xs:string"/>
      <xs:attribute name="row" type="xs:string"/>
      <xs:attribute name="path" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Why the document is the kind it declares: on the <scxml> root of
       every kind, at most once. `sce-build/src/forge/kind_basis.rs`.

       ⚠ Looser here than the parser, deliberately, for the reason the
       provenance element above gives: every fault of a basis — repeated,
       misplaced, empty, a child it does not take, a kind no kind goes by,
       the document's own kind ruled out — is ONE defect with ONE code,
       `validation/kind-basis-malformed`, raised by the parser. A rule
       stated here as well would move some of those to libxml2 as
       `xml/schema-validation` and leave the rest with the parser, and it
       would still be absent from a build without the `xsd` feature. So
       the content is handed on laxly, `kind` is a string, and nothing is
       `required`; what IS declared validates the two children's shape
       wherever the schema is compiled in. -->
  <xs:element name="kind-basis">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <!-- The kind itself left open is the `sce:unresolved` family on this
           element, read by the same parser code as on every other
           element; lax, so the family's own declarations judge it. -->
      <xs:anyAttribute namespace="##targetNamespace" processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <!-- What the specification states that makes the document its kind.
       `provenance` is the compact anchor of `sce:provenance`. -->
  <xs:element name="evidence">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="provenance" type="xs:string"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- A kind considered and not chosen, and the behaviour that ruled it
       out. -->
  <xs:element name="rejected">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="kind" type="xs:string"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- Timer kind: read by `parse_timer` via `find_sce_child`. -->
  <xs:element name="cancel-on">
    <xs:complexType>
      <xs:attribute name="state-exit" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="reset-on">
    <xs:complexType>
      <xs:attribute name="event" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Bounded-collection kind: required by its parser
       (`find_sce_child(root, "capacity")` … `ok_or_else`). Distinct from
       the `capacity` ATTRIBUTE on `<sce:var>` above, which bounds a
       byte buffer; the two share a name and nothing else.

       TWO forms, and the parser takes exactly one of them:
       `source="deploy" key="machines.X.limits.Y"` reads the bound out of
       the deployment (RFC §synth-5-L lines 2553-2554), `const="N"` fixes
       it at build time (line 2602). All three attributes are therefore
       OPTIONAL here, and none carries a narrower type than `xs:string`.
       This grammar names the SURFACE — which attributes exist — and the
       parser judges the combination and the values, because that is
       where the sentence an author can act on lives: *exactly one of
       `source="deploy" key="..."` or `const="..."`*. Spelling the one
       accepted `source`, or `const`'s integer-ness, into a type here
       would put the same judgement in two places, and the copy without
       the message is the one that would go stale.

       ⚠ This element was first declared with `const` alone, `use=
       "required"`, on 2026-09-20. Every document in the checkout spelled
       the `const` form, so a declaration derived from the corpus
       described the parser's accepted set too narrowly and turned SIX
       passing contract tests red — the deploy-key form lives only in
       test fixtures written as string literals, which no sweep over
       `.scxml` files can see. A grammar is a statement about what the
       PARSER accepts; the documents that happen to be checked in are a
       sample of that, never its definition. -->
  <xs:element name="capacity">
    <xs:complexType>
      <xs:attribute name="source" type="xs:string"/>
      <xs:attribute name="key" type="xs:string"/>
      <xs:attribute name="const" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Timer kind: the period and the event it raises, both as element
       text. Found by the grammar/parser gate rather than by hand — the
       first sweep for undeclared surface enumerated (element, attribute)
       PAIRS, and an element carrying no attribute is invisible to that
       unit. -->
  <xs:element name="period">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="fire-event">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- Bounded-collection kind: names the element type the collection
       holds, resolved across documents, so `xs:string` rather than
       `xs:NCName` — an alias may carry a separator this grammar does not
       get to constrain. -->
  <xs:element name="element-type">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- Bounded-collection kind: the field of the element document a lookup by
       index reads (`find_sce_child(root, "index-by")`), named by an attribute.
       Optional here for the reason `capacity` above is: the parser judges that
       the field exists in the element and has a type a lookup can compare. -->
  <xs:element name="index-by">
    <xs:complexType>
      <xs:attribute name="field" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Bounded-collection kind: what an insert does when every slot is taken,
       a word in the element's text (`diagnostic-event`, `reject` or
       `oldest-wins`). The parser refuses a word outside that set and names the
       allowed ones, which an enumeration here would only report as a pattern
       failure; the same reason `producers` below is a string. -->
  <xs:element name="on-overflow">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- Bounded-collection kind: the order an iteration walks the slots in, a
       word in the element's text (`insertion` or `sorted-by(index-by)`). A
       string for the reason `on-overflow` above is. -->
  <xs:element name="ordering">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- Queue kind (RFC §synth-5-P). `producers`, `consumers` and `progress`
       are words in the element's text; the parser refuses a word outside
       the closed set and names the allowed ones, which a grammar
       enumeration would only report as a pattern failure. Every attribute
       below is optional for the reason `capacity` above is: the parser
       decides which are required, per storage mode, and a grammar narrower
       than the parser removes a form the parser accepts. -->
  <xs:element name="producers">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="consumers">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="progress">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- Storage: exactly one of the three. `<sce:bounded>` writes its
       capacity as `capacity="N"` or as `source="deploy" key="..."`. -->
  <xs:element name="bounded">
    <xs:complexType>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="source" type="xs:string"/>
      <xs:attribute name="key" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="segmented">
    <xs:complexType>
      <xs:attribute name="segment" type="xs:string"/>
      <xs:attribute name="allocator-progress" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- `<sce:intrusive/>` is written empty: the queue links nodes its
       runtime defines, and each node holds an element as its value (ADR
       0088), so the element carries no link and the author names none. -->
  <xs:element name="intrusive">
    <xs:complexType>
      <!-- Removed: the link field of the element. It stays in the grammar
           for one reason: a document that still writes it must reach the
           parser, which refuses it with `queue/intrusive-link-field-removed`
           and says the field it named can leave the element codec, where a
           schema failure would only say the attribute is unknown. -->
      <xs:attribute name="link-field" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- The most contexts that hold a handle on one side at once: a count
       like a capacity, written the same two ways. -->
  <xs:element name="participants">
    <xs:complexType>
      <xs:attribute name="const" type="xs:string"/>
      <xs:attribute name="source" type="xs:string"/>
      <xs:attribute name="key" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Broadcast-log kind (RFC §synth-5-S, ADR 0062). `element-type`, `producers` and
       `progress` are the elements above; the retention is the number of
       latest entries a reader may rely on, written the two ways a capacity
       is. Every attribute is optional for the reason `capacity` above is:
       the parser decides which are required, and a grammar narrower than
       the parser removes a form the parser accepts. -->
  <xs:element name="retention">
    <xs:complexType>
      <xs:attribute name="entries" type="xs:string"/>
      <xs:attribute name="source" type="xs:string"/>
      <xs:attribute name="key" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Read by the STATECHART parser (`src/parser.rs`), not the forge
       one, and reachable here because `sce-forge.xsd` wraps W3C SCXML.
       ⚠ Fixtures also hang `urn:sce:cpp` attributes on it, and that
       namespace has NO schema in this tree — so they are admitted as
       `##other` rather than named. That is narrower than the status quo
       (which admitted the whole element unknown) and stops short of
       inventing a grammar for an extension that has none. -->
  <xs:element name="context">
    <xs:complexType>
      <xs:attribute name="id" type="xs:NCName" use="required"/>
      <xs:anyAttribute namespace="##other" processContents="lax"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
