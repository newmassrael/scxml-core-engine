<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCE Forge — SCXML validation entry point.

  Targets the W3C SCXML namespace and declares <scxml> as a valid root
  element so libxml2/xmllint can begin schema validation. Imports
  `sce-forge-ext.xsd` (the sce: namespace extension declarations) and
  uses `xs:any`/`xs:anyAttribute` with `processContents="lax"` so that:

    1. Anything declared in the imported sce: extension schema (kindType,
       sceType, directionType, codec field layout, etc.) is validated
       strictly — bad enum values, malformed bit-size, missing required
       attributes on <sce:field>/<sce:entry>/<sce:import> all raise
       errors with line/column info.

    2. Standard W3C SCXML structural elements (<state>, <transition>,
       <data>, <onentry>, ...) pass through without re-validation. Their
       structural correctness is the W3C SCXML parser's responsibility,
       which `sce-build/src/forge/parser.rs` and `roxmltree` already
       cover. This wrapper deliberately does NOT duplicate the W3C SCXML
       schema — that would either drift from the W3C reference or pull
       in the entire ~2000-line W3C scxml-core.xsd as a vendored
       dependency. Single responsibility: validate the sce: extension
       surface only.

  Composition rationale (vs. one big file): XSD 1.0 forbids more than one
  targetNamespace per schema document. The `sce:` extensions live in
  `http://sce.dev/ext` and the `<scxml>` root lives in
  `http://www.w3.org/2005/07/scxml`, so two files are mandatory. Keeping
  the entry point in this file (sce-forge.xsd) means tooling and docs
  that reference the file path stay stable; the extension file is a
  dependency loaded transparently via xs:import.

  Usage:
    xmllint  -noout  -schema schemas/sce-forge.xsd file.scxml
  (XML comments cannot contain double-hyphens, so the actual flags are
  written here as single-dash placeholders. The real command uses
  GNU-style double-dash flags.)
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:scxml="http://www.w3.org/2005/07/scxml"
           xmlns:sce="http://sce.dev/ext"
           targetNamespace="http://www.w3.org/2005/07/scxml"
           elementFormDefault="qualified">

  <!-- The sce: extension schema is loaded as a separate compilation unit;
       libxml2 resolves the relative schemaLocation against this file. -->
  <xs:import namespace="http://sce.dev/ext"
             schemaLocation="sce-forge-ext.xsd"/>

  <!-- W3C SCXML root element. Children are intentionally `xs:any` with
       `lax` processing — we are not re-implementing the W3C schema, only
       wrapping it so the validator has somewhere to start. The
       `<xs:anyAttribute namespace="##other">` clause picks up every
       sce:* attribute declared in the imported extension schema and
       validates them strictly via global attribute references. -->
  <xs:element name="scxml">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax"
                minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="initial" type="xs:string"/>
      <xs:attribute name="name" type="xs:string"/>
      <xs:attribute name="datamodel" type="xs:string"/>
      <xs:attribute name="version" type="xs:string"/>
      <xs:attribute name="binding" type="xs:string"/>
      <xs:anyAttribute namespace="##other" processContents="lax"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
