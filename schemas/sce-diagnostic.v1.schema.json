    "stage": {
      "description": "Pipeline stage that raised the diagnostic. Exit codes are routed by prefix (see SCE_ERROR_CONTRACT.md §6).",
      "type": "string",
      "enum": [
        "xml",
        "validation",
        "expression",
        "import",
        "manifest",
        "generate",
        "io",
        "cli",
        "mesh-deploy",
        "mesh-external",
        "mesh-topology",
        "mesh-codegen"
      ]
    },
    "spec": {
      "description": "Optional specification anchor (e.g. 'SCE Forge §3.4', 'SCE Mesh §14'). Absent when the code records an operational failure rather than a spec violation.",
      "type": "string"
    },
    "message": {
      "description": "English one-line rendering. Not machine-parsed; agents dispatch on `code` and drive repair from `fix`/`expected`. Present as a tiebreaker for ambiguous triage and as UI text.",
      "type": "string"
    },
    "location": {
      "description": "Source location carried when the error was raised through a Located<E> wrapper. Absent for pure I/O and CLI-boundary failures.",
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 1 }
      }
    },
    "expected": {
      "description": "Non-repair metadata. Holds grammatical expectations (parser token names) or cardinality notes. Never a substitution candidate list — see SCE_ERROR_CONTRACT.md §3.2 (non-overlap rule).",
      "type": "array",
      "items": { "type": "string" }
    },
    "actual": {
      "description": "Observed value that triggered the rejection.",
      "type": "string"
    },
    "fix": {
      "description": "Structured repair proposal. Sole channel for substitution candidates and additive repairs — never overlaps with `expected` (SCE_ERROR_CONTRACT.md §3.2). The `kind` discriminator selects the payload shape.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "element", "attr"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "add_attribute" },
            "element": { "type": "string" },
            "attr": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "what", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "rename_duplicate" },
            "what": { "type": "string" },
            "id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "location", "fields"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "remove_fields" },
            "location": { "type": "string" },
            "fields": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "to"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "replace_with" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "candidates"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "replace_one_of" },
            "candidates": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "element", "attrs"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "add_one_of" },
            "element": { "type": "string" },
            "attrs": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          }
        }
      ]
    },
    "spec_provenance": {
      "description": "NL→IR Mapping Roadmap Item 6 — spec-document anchors that justify the rejected node. Populated by upstream IR generators (NL→IR pipelines, ARXML transcoders) and passed through verbatim by SCE. Omitted when the upstream did not record provenance.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id"],
        "additionalProperties": false,
        "properties": {
          "doc_id": { "type": "string" },
          "rev": { "type": "string" },
          "section": { "type": "string" },
          "page": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "question_kind": {
      "description": "NL→IR Mapping Roadmap Item 6 — coarse routing label so IDE / triage tooling can dispatch on the kind of question the diagnostic raises (structural vs ambiguous-mapping vs unit-missing …). Closed enum; consumers must treat unknown values as `structural` per the schema's ignore-unknown rule.",
      "type": "string",
      "enum": [
        "implicit_default",
        "ambiguous_mapping",
        "cross_doc_conflict",
        "unit_unspecified",
        "unknown_vocabulary",
        "structural"
      ]
    }
  }
