# Android
local.properties
.cxx/
.kotlin/

# Go W3C test code regenerates at test time via sce-codegen and is
# deliberately not tracked. The Kotlin + Rust counterparts are tracked
# (see sce-kotlin-tests/build.gradle.kts: "Generated files are kept in
# git so builds work without sce-codegen") so they are intentionally
# absent from this ignore list. Drift against the templates is caught
# by running `sce-codegen generate-w3c` and inspecting `git status`.
sce-go-tests/generated/

# Python W3C harness output mirrors the Go convention — regenerated by
# `sce-codegen generate-w3c --language python` and not tracked. The
# pytest wrapper that lands with γ-4f will live alongside (also
# generated, so it stays under this ignore rule).
sce-python-tests/generated/

# Python AOT integration trees: emitted by
# `scripts/regen_donedata_local_invoke_python.sh` (and
# `sce-codegen generate-integration -l python` in CI). Mirrors the W3C
# IRP Python pattern above — only `*_sm.py` is gitignored; the
# hand-authored test wrappers (`test_*.py`) and `__init__.py` markers
# under `sce-python-tests/integration/<stem>/` stay committed.
sce-python-tests/integration/*/*_sm.py
sce-python-tests/integration/*/sce_sourcemap.json
sce-python-tests/integration/*/__pycache__/

build_debug_qjs/

# Bazel
bazel-*/
MODULE.bazel
MODULE.bazel.lock
# Auto-generated BUILD.bazel files from bazel/sce_repo.bzl repository rule.
# Committing these would conflict with sce_local_repository's ctx.file() writes
# and go stale against sce_base_sources.cmake (SSOT). embed/BUILD.bazel is the
# only checked-in variant and lives under the already-ignored embed/ tree.
/BUILD.bazel
/sce/BUILD.bazel
/third_party/BUILD.bazel
/third_party/*/BUILD.bazel

# SCE Mesh §9.6.6: synth-invoke child SCXMLs are derived artefacts —
# `sce-codegen generate` re-materialises them into the caller-supplied
# `-o` (and `--deploy <path>` parent when distinct) on every run, so a
# leak into a tracked dir is pollution, not signal. Exception:
# `resources/<num>/test<num>__sce_synth_invoke__*.scxml` files stay
# tracked because `cmake/SCEStaticW3CTest.cmake:373` glob-discovers
# them at *configure time* (before the build-time parent codegen has
# a chance to re-materialise them under OUTPUT_DIR); a CMake refactor
# that pre-computes the child list from the parent SCXML at configure
# time would let the corpus join the rest of this rule.
**/*__sce_synth_invoke__*.scxml
!resources/*/*__sce_synth_invoke__*.scxml

# SCE embed output (regenerate via: ./scripts/package_embed.sh)
# embed/MANIFEST.json records the public-header API surface and is
# checked in so consumers vendoring embed/ can diff old-vs-new across
# sync points, and so verify_embed_manifest.sh can drift-guard changes.
# The /embed/** pattern is required (not embed/) — git cannot re-include
# a file under a directory that is ignored as a whole.
/embed/**
!/embed/MANIFEST.json
