# Build directories (covers root build/ and Gradle subproject builds)
**/build/
# Rust (Cargo) build output
target/
build_debug/
build_python/
build_wasm/
build_tsan/
build_release/
build_conformance_c/
build_conformance_cpp/
/bin/
lib/
out/
cmake-build-*/

# Visualizer WASM build outputs only (source files are tracked)
visualizer/visualizer.wasm
visualizer/visualizer.js
visualizer/comprehensive_interactive_test.js

# Visualizer symlinks created by start-server.sh (local dev only)
visualizer/doom
visualizer/resources
visualizer/tools

# CMake generated files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
.DS_Store
*.sublime-workspace
*.sublime-project

