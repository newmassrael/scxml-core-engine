<?xml version="1.0" encoding="UTF-8"?>
<!-- W3C SCXML 6.4 autoforward happens at the external dequeue, not the enqueue.

     The sibling fixtures `autoforward_done_invoke` and
     `autoforward_internal_queue` pin *which* events are forwarded — whatever
     comes off the external queue, name-blind, and nothing off the internal
     one. Neither of them can see *when* the forward happens, and both were
     deliberately built to be blind to it. This fixture pins the position.

     Appendix D's `mainEventLoop` places the forward one statement after the
     dequeue and before transition selection:

       externalEvent = externalQueue.dequeue()
       ...
       for state in configuration:
           for inv in state.invoke:
               if inv.invokeid == externalEvent.invokeid:
                   applyFinalize(inv, externalEvent)
               if inv.autoforward:
                   send(inv.id, externalEvent)
       enabledTransitions = selectTransitions(externalEvent)

     and §6.4.2 says so in prose as well: the parent forwards "at the point at
     which it removes it from the external event queue". An engine that
     forwards where it *enqueues* instead satisfies every name-blind
     forwarding rule and still breaks run-to-completion: the child sees event
     N before the parent has processed events 1..N-1, so the two sessions
     disagree about what has happened so far.

     Queue order alone cannot catch that. Forwarding at enqueue and forwarding
     at dequeue hand the child the same events in the same relative order,
     because the parent's own queue is FIFO either way. The difference is only
     visible against a second channel the parent drives from *inside* a
     transition body — so the parent marks the child directly, with
     `<send target="#_inv_probe">`, while handling the first of two events it
     queued together:

       inv_probe's onentry sends `ready` to the parent
         -> the parent's `ready` transition queues `first` and `second`
            back-to-back onto its own external queue (targetless <send>,
            §6.2.4)
         -> the parent's `first` transition sends `mark` straight to the child

       forwards at dequeue   child sees first, mark, second -> sawMarkFirst
                             (`second` is forwarded only once the parent has
                             finished with `first`, so `mark` overtakes it)
       forwards at enqueue   child sees first, second, mark -> sawSecondEarly
                             (both were handed over during the `ready`
                             transition, before `mark` existed)

     Ordering is established without any wall-clock delay and without assuming
     when a backend starts its pending invokes relative to the external drain:
     the *child* opens the exchange, so it is provably alive for everything
     that follows. Both child verdicts are top-level `<final>` states, so
     neither depends on a timeout, and no `<final>` is nested inside a
     compound state — whether a nested final ends a session is a separate
     question, and mixing the two would let one regression masquerade as the
     other.

     The child spends `first` moving into `awaiting`, the one state that
     answers `mark` and `second` differently; whichever of the two arrives
     there first decides the verdict, and the other is then unreachable.
     Every event is named in full because the AOT backends resolve a forwarded
     event by exact name against the child's own event enum and silently drop
     names it does not declare.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="ecmascript" initial="phase"
       name="autoforward_dequeue_point">
    <state id="phase">
        <invoke type="scxml" id="inv_probe" autoforward="true">
            <content>
                <scxml xmlns="http://www.w3.org/2005/07/scxml"
                       version="1.0" datamodel="ecmascript" initial="probe">
                    <state id="probe">
                        <onentry>
                            <send target="#_parent" event="ready"/>
                        </onentry>
                        <transition event="first" target="awaiting"/>
                    </state>
                    <state id="awaiting">
                        <transition event="mark" target="marked"/>
                        <transition event="second" target="early">
                            <send target="#_parent" event="sawSecondEarly"/>
                        </transition>
                    </state>
                    <state id="marked">
                        <transition event="second" target="ordered">
                            <send target="#_parent" event="sawMarkFirst"/>
                        </transition>
                    </state>
                    <final id="early"/>
                    <final id="ordered"/>
                </scxml>
            </content>
        </invoke>
        <transition event="ready">
            <send event="first"/>
            <send event="second"/>
        </transition>
        <transition event="first">
            <send target="#_inv_probe" event="mark"/>
        </transition>
        <transition event="sawSecondEarly" target="fail"/>
        <transition event="sawMarkFirst" target="pass"/>
    </state>
    <final id="pass"/>
    <final id="fail"/>
</scxml>
