<!--
  sce:std/sync/item_version.scxml — one item a replica holds and the sync
  token of the change that last wrote it: the element of the state
  sce:std/sync/changes_apply.scxml keeps.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="item_version"
       sce:event-name="sync.item_version">
  <datamodel>
    <data id="item" sce:type="uint64" sce:direction="in"/>
    <data id="token" sce:type="uint64" sce:direction="in"/>
  </datamodel>
</scxml>
