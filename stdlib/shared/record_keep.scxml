<!--
  sce:std/shared/record_keep.scxml — a change a copy of a shared record list has taken
  in, told to the copy's own digest (record_list): whether it is an add or a tombstone
  (`kind`, 0 for an add and 1 for a tombstone), the register it is in (`element`, the one
  the set names it by) and the dot it is known by (`wallTime`, `counter`, `nodeId`). It
  is raised by the copy for itself, from the places a change is first stored, so the
  digest is made in one place whatever the change was.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="record_keep"
       sce:event-name="record_list.keep">
  <datamodel>
    <data id="kind" sce:type="uint8" sce:direction="in"/>
    <data id="element" sce:type="uint64" sce:direction="in"/>
    <data id="wallTime" sce:type="int64" sce:direction="in"/>
    <data id="counter" sce:type="uint32" sce:direction="in"/>
    <data id="nodeId" sce:type="uint64" sce:direction="in"/>
  </datamodel>
</scxml>
