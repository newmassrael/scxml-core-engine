<!--
  sce:std/shared/record_refused.scxml — what a shared record list (record_list) tells the
  statechart that invoked it when it refused a change of its own (docs/adr/0046): once
  for each change refused, after the command that ended it. The command at fault is named
  by its row (`id`), its field (`field`, 0 for a retire) and its `kind`, the command it
  was (record_command: an edit, a clear or a retire): the one whose text or staging
  failed, the second of two that name one register, or, for what is judged of the whole
  change, the one that ended it. `reason` says why (record_refusal), and every refusal
  has all four fields: no field of it may be absent, and no refusal is the absence of the
  record, which a parent keeps in an `optional<record:Refused>` (docs/adr/0055).
  Nothing of a refused change is taken in, stamped or sent, so a parent that told its
  user the change was made tells them it was not.

  `Command` and `Refusal` are this schema's names for the two enum documents
  (docs/adr/0052). A statechart that reads the payload holds each field in its type for
  the document, imported or not, and imports an enum, under any alias, only to name it
  (a variant, a variable of it): a record variable of this schema names a variant of
  each when it starts, so it imports both (docs/adr/0054), and an optional one starts
  absent and names none.

  A list a host started has no parent and tells no one, as it tells no register.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="record_refused"
       sce:event-name="record_list.refused">
  <sce:import kind="enum" src="sce:std/shared/record_command.scxml" as="Command"/>
  <sce:import kind="enum" src="sce:std/shared/record_refusal.scxml" as="Refusal"/>
  <datamodel>
    <data id="id" sce:type="uint32" sce:direction="in"/>
    <data id="field" sce:type="uint16" sce:direction="in"/>
    <data id="kind" sce:type="enum:Command" sce:direction="in"/>
    <data id="reason" sce:type="enum:Refusal" sce:direction="in"/>
  </datamodel>
</scxml>
