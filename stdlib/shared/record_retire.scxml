<!--
  sce:std/shared/record_retire.scxml — a person's word that a row of a shared record list
  is gone, as the host or the statechart that invoked the list hands it to a copy
  (docs/adr/0046): which row (`id`), `now`, the host's wall clock in milliseconds, and
  `more`, whether the change goes on.

  The copy writes over every value it holds in any field of the row, and writes none, so
  that once every copy has taken the change in and the copies have settled past it, the
  row takes no room anywhere: its values and adds go at once, and its tombstones at the
  settle. What the copy has not seen is not named: a value written to the row at the same
  time by someone who had not seen the retire stays, on every copy, and the row then holds
  the fields such writes gave it and no others, which the statechart that invoked the list
  is told. A retire is a command of a change as an edit is (record_edit); a change that
  retires a row and edits fields of it writes the row anew.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="record_retire"
       sce:event-name="record_list.retire">
  <datamodel>
    <data id="id" sce:type="uint32" sce:direction="in"/>
    <data id="now" sce:type="int64" sce:direction="in"/>
    <data id="more" sce:type="bool" sce:direction="in"/>
  </datamodel>
</scxml>
