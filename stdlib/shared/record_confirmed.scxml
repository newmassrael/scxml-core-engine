<!--
  sce:std/shared/record_confirmed.scxml — what a copy of a shared record list tells the
  statechart that invoked it when a change it took in provisionally
  (record_list.pending, record_pending) is carried now (docs/adr/0093, section 3.3): the
  host confirmed it (record_list.confirm), and it will not be withdrawn.

  The fields are record_confirm's (the shape `record_stamp` of docs/adr/0093, section
  5): the change's stamp (`wallTime`, `counter`) and `command`, the host's name for the
  command that ended it, as the copy kept it. A list a host started has no parent and
  tells no one.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="record_confirmed"
       sce:event-name="record_list.confirmed">
  <datamodel>
    <data id="wallTime" sce:type="int64" sce:direction="in"/>
    <data id="counter" sce:type="uint32" sce:direction="in"/>
    <data id="command" sce:type="uint64" sce:direction="in"/>
  </datamodel>
</scxml>
