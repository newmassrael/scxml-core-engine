<!--
  sce:std/merge/merkle_prune.scxml — the digest `nodes` cut down to its most
  recent branches: under every kept node, only the `keep` children with the
  largest prefixes stay, and nothing under a dropped node (the reference's
  `prune(trie, n)`, merkle.ts, whose default n is 2). Every kept node keeps
  its hash, so a pruned digest still compares by its root.

  Pruning is lossy on purpose: two sides that differ only on a dropped
  branch are still told apart by the hashes above it, and merkle_diff then
  answers an earlier time than the change — more to exchange, never a
  change missed.

  One difference from the reference, which is a fix: the reference stops
  pruning below any node whose hash is 0 (`if (!trie.hash) return trie`),
  so a subtree whose changes happen to XOR to 0 is kept whole. Here a
  node's hash does not decide what is kept.

  `keep` must be at least 1 and `nodes` a digest (ascending (depth,
  prefix), depth at most 16); anything else fails `precondition`. The
  result is in the same order. The comparison is O(16 · n²), which a
  digest of this size affords.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="algorithm" name="merkle_prune" version="1.0">
  <sce:import kind="event-schema" src="merkle_node.scxml" as="Node"/>
  <sce:signature>
    <sce:param name="nodes" type="list&lt;record:Node&gt;"/>
    <sce:param name="keep" type="uint32"/>
    <sce:return type="list&lt;record:Node&gt;" returns-max-size="1024" may-fail="true"/>
  </sce:signature>
  <sce:body>
    <sce:require cond="keep &gt;= 1"/>
    <sce:var name="out" type="list&lt;record:Node&gt;" capacity="1024"/>
    <sce:var name="prevDepth" type="int32" init="-1"/>
    <sce:var name="prevPrefix" type="uint64" init="0"/>
    <sce:foreach item="x" in="nodes">
      <sce:require cond="x.depth &lt;= 16 &amp;&amp; (x.depth &gt; prevDepth || (x.depth === prevDepth &amp;&amp; x.prefix &gt; prevPrefix))"/>
      <sce:assign target="prevDepth" expr="x.depth"/>
      <sce:assign target="prevPrefix" expr="x.prefix"/>
      <!-- Walk from x up to the root: x is kept when, at every step, fewer
           than `keep` siblings sort after it. -->
      <sce:var name="kept" type="bool" init="true"/>
      <sce:var name="d" type="uint32" init="x.depth"/>
      <sce:var name="p" type="uint64" init="x.prefix"/>
      <sce:while cond="kept &amp;&amp; d &gt;= 1">
        <sce:var name="after" type="uint32" init="0"/>
        <sce:foreach item="y" in="nodes">
          <sce:if cond="y.depth === d &amp;&amp; (d === 1 || y.prefix / 3 === p / 3) &amp;&amp; y.prefix &gt; p">
            <sce:assign target="after" expr="after + 1"/>
          </sce:if>
        </sce:foreach>
        <sce:if cond="after &gt;= keep">
          <sce:assign target="kept" expr="false"/>
        </sce:if>
        <sce:assign target="p" expr="d &gt;= 2 ? p / 3 : 0"/>
        <sce:assign target="d" expr="d - 1"/>
      </sce:while>
      <sce:if cond="kept">
        <sce:append target="out" expr="x"/>
      </sce:if>
    </sce:foreach>
    <sce:return expr="out"/>
  </sce:body>
</scxml>
