<!--
  sce:std/merge/field_version.scxml — one write to one field of one entity, as
  undo_field_plan reads the history of a last-writer-wins field.

  `wallTime`, `counter` and `nodeId` are the write's hybrid logical clock stamp
  (hlc_timestamp), spelled out because a record's fields are fixed-width
  scalars (SCE_FORGE.md §4.12), so a record does not hold a record. `arrival` is
  the number the server gave the write when it took it in.

  `batchId` groups the writes made together, as a commit groups changes; 0 is no
  batch. `origin` says how it was written: 0 typed by a person, 1 written by a
  program, 2 an undo. An undo is an ordinary write that restores an earlier
  value, and `revertsBatch` names the batch it undoes (0 otherwise).

  `valueRef` is a handle to the value written, 0 for a field with no value. The
  value itself stays with the host: a record cannot hold a string, and an undo
  only has to say WHICH earlier write to restore, never what it said.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="field_version"
       sce:event-name="merge.field_version">
  <datamodel>
    <data id="entityId" sce:type="uint64" sce:direction="in"/>
    <data id="fieldId" sce:type="uint32" sce:direction="in"/>
    <data id="wallTime" sce:type="int64" sce:direction="in"/>
    <data id="counter" sce:type="uint32" sce:direction="in"/>
    <data id="nodeId" sce:type="uint64" sce:direction="in"/>
    <data id="arrival" sce:type="uint64" sce:direction="in"/>
    <data id="batchId" sce:type="uint64" sce:direction="in"/>
    <data id="origin" sce:type="uint8" sce:direction="in"/>
    <data id="revertsBatch" sce:type="uint64" sce:direction="in"/>
    <data id="valueRef" sce:type="uint64" sce:direction="in"/>
  </datamodel>
</scxml>
