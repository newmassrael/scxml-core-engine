<!--
  sce:std/merge/merkle_divergence.scxml — what merkle_diff finds between two
  digests: whether they differ, and if so the time, in milliseconds since
  the epoch at a minute boundary, from which the two sides must exchange
  their changes to agree. `millis` is 0 when they do not differ.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="merkle_divergence"
       sce:event-name="merge.merkle_divergence">
  <datamodel>
    <data id="differs" sce:type="bool" sce:direction="in"/>
    <data id="millis" sce:type="int64" sce:direction="in"/>
  </datamodel>
</scxml>
