<!--
  sce:std/merge/orset_live.scxml — the value of an observed-remove set: the
  entries of `adds` whose add no remove observed, i.e. that `tombstones`
  does not hold. An element is in the set while any of its adds is live, so
  an add concurrent with a remove survives it — the remove could only
  tombstone the adds it had seen (add wins).

  The result keeps `adds`' order and holds at most 256 entries, as
  orset_union's does.

  adds {1@(100,0,7), 1@(102,0,9)}, tombstones {1@(100,0,7)} → {1@(102,0,9)}.

  The same difference is how a set forgets. Tombstones are never dropped by
  merging, so a set that is added to and removed from keeps growing until it
  passes the 256-entry bound. Once every replica has observed a set S of
  tombstones — the host's to decide; a server that tracks each device's
  read cursor knows it — both lists shrink by it:

    adds'       = orset_live(adds, S)        the adds S covers go
    tombstones' = orset_live(tombstones, S)  and so do S's own entries

  and orset_live(adds', tombstones') is orset_live(adds, tombstones) for any
  S ⊆ tombstones, so the set's value is unchanged. The precondition is the
  whole of the rule: a replica that had not seen a pruned tombstone still
  holds its add, and merging that replica in afterwards brings the element
  back, because nothing any longer says it was removed.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="algorithm" name="orset_live" version="1.0">
  <sce:import kind="event-schema" src="orset_entry.scxml" as="Entry"/>
  <sce:signature>
    <sce:param name="adds" type="list&lt;record:Entry&gt;"/>
    <sce:param name="tombstones" type="list&lt;record:Entry&gt;"/>
    <sce:return type="list&lt;record:Entry&gt;" returns-max-size="256"/>
  </sce:signature>
  <sce:body>
    <sce:var name="out" type="list&lt;record:Entry&gt;" capacity="256"/>
    <sce:foreach item="x" in="adds">
      <sce:var name="removed" type="bool" init="false"/>
      <sce:foreach item="t" in="tombstones">
        <sce:if cond="t.element === x.element &amp;&amp; t.wallTime === x.wallTime &amp;&amp; t.counter === x.counter &amp;&amp; t.nodeId === x.nodeId">
          <sce:assign target="removed" expr="true"/>
        </sce:if>
      </sce:foreach>
      <sce:if cond="!removed">
        <sce:append target="out" expr="x"/>
      </sce:if>
    </sce:foreach>
    <sce:return expr="out"/>
  </sce:body>
</scxml>
