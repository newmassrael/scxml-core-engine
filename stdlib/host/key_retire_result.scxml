<!--
  sce:std/host/key_retire_result.scxml — the answer of `sce-host-key-retire`
  (docs/SCE_HOST_FEATURES.md, "Keys"): `retired` is true when the key was
  active and is retired now, false when it was retired already. A retired key
  still verifies, opens and exports its public key, and no longer signs,
  seals, tags or derives.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="key_retire_result"
       sce:event-name="host.key.retire.result">
  <datamodel>
    <data id="error" sce:type="string[24]" sce:direction="in"/>
    <data id="retired" sce:type="bool" sce:direction="in"/>
  </datamodel>
</scxml>
