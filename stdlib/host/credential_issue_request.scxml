<!--
  sce:std/host/credential_issue_request.scxml — the request of
  `sce-host-credential-issue` (docs/SCE_HOST_FEATURES.md, "Credentials").

  `name` is the name the token proves, as a client of the `https` binding
  claims it: not empty. `ttl_s` is how many seconds after its issue the token
  stops proving it: at least 1.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="credential_issue_request"
       sce:event-name="host.credential.issue.request">
  <datamodel>
    <data id="name" sce:type="string[256]" sce:direction="in"/>
    <data id="ttl_s" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
