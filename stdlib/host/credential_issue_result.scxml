<!--
  sce:std/host/credential_issue_result.scxml — the answer of
  `sce-host-credential-issue` (docs/SCE_HOST_FEATURES.md, "Credentials"):
  `token` is the bearer token, `sce1.` and 43 base64url digits, that proves
  the request's name until it expires or is revoked. The host keeps only its
  digest, so the machine hands it to its client once; an issue repeated under
  one identity answers the same token.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="credential_issue_result"
       sce:event-name="host.credential.issue.result">
  <datamodel>
    <data id="error" sce:type="string[24]" sce:direction="in"/>
    <data id="token" sce:type="string[64]" sce:direction="in"/>
  </datamodel>
</scxml>
