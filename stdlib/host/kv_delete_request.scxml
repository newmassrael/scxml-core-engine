<!--
  sce:std/host/kv_delete_request.scxml — the request of `sce-host-kv-delete`
  (docs/SCE_HOST_FEATURES.md, "Key-value store"): the key to remove.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="kv_delete_request"
       sce:event-name="host.kv.delete.request">
  <datamodel>
    <data id="key" sce:type="string" sce:max-size="256" sce:direction="in"/>
  </datamodel>
</scxml>
