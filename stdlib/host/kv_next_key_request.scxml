<!--
  sce:std/host/kv_next_key_request.scxml — the request of `sce-host-kv-next-key`
  (docs/SCE_HOST_FEATURES.md, "Key-value store"): the first key after `after`
  that begins with `prefix`. Both may be empty; an empty `after` starts the
  walk.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="kv_next_key_request"
       sce:event-name="host.kv.next_key.request">
  <datamodel>
    <data id="after" sce:type="string" sce:max-size="256" sce:direction="in"/>
    <data id="prefix" sce:type="string" sce:max-size="256" sce:direction="in"/>
  </datamodel>
</scxml>
