<!--
  sce:std/host/credential_revoke_result.scxml — the answer of
  `sce-host-credential-revoke` (docs/SCE_HOST_FEATURES.md, "Credentials"):
  `revoked` is how many credentials of the name the revocation took away, its
  tokens not revoked before and its installation pin; 0 when it held none.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="credential_revoke_result"
       sce:event-name="host.credential.revoke.result">
  <datamodel>
    <data id="error" sce:type="string[24]" sce:direction="in"/>
    <data id="revoked" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
