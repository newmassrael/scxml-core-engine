<!--
  sce:std/host/notify_post_result.scxml — the answer of `sce-host-notify-post`
  (docs/SCE_HOST_FEATURES.md, "Notifications"). `status` is `posted` (handed to
  the platform to show now), `scheduled` (kept to show at `at_ms`) or `denied`
  (permission is not granted, and nothing was kept).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="notify_post_result"
       sce:event-name="host.notify.post.result">
  <datamodel>
    <data id="error" sce:type="string" sce:max-size="24" sce:direction="in"/>
    <data id="status" sce:type="string" sce:max-size="16" sce:direction="in"/>
  </datamodel>
</scxml>
