<!--
  sce:std/host/credential_revoke_request.scxml — the request of
  `sce-host-credential-revoke` (docs/SCE_HOST_FEATURES.md, "Credentials"):
  `name` is the name whose tokens and installation pin are taken away: not
  empty.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="credential_revoke_request"
       sce:event-name="host.credential.revoke.request">
  <datamodel>
    <data id="name" sce:type="string[256]" sce:direction="in"/>
  </datamodel>
</scxml>
