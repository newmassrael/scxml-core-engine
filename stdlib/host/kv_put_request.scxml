<!--
  sce:std/host/kv_put_request.scxml — the request of `sce-host-kv-put`
  (docs/SCE_HOST_FEATURES.md, "Key-value store"): the key and the text to
  keep under it, of at most 4096 UTF-8 bytes.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="kv_put_request"
       sce:event-name="host.kv.put.request">
  <datamodel>
    <data id="key" sce:type="string" sce:max-size="256" sce:direction="in"/>
    <data id="value" sce:type="string" sce:max-size="4096" sce:direction="in"/>
  </datamodel>
</scxml>
