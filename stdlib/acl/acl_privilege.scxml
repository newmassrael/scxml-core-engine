<!--
  sce:std/acl/acl_privilege.scxml — one privilege of a resource's
  supported-privilege tree (RFC 3744 §5.3): its number and the number of
  the aggregate privilege that contains it. 0 is DAV:all, the root, which
  names itself as its parent.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="acl_privilege"
       sce:event-name="acl.privilege">
  <datamodel>
    <data id="id" sce:type="uint32" sce:direction="in"/>
    <data id="parent" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
