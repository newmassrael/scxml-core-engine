<!--
  sce:std/time/resolve_date.scxml — the day a date expression names
  (date_expression.scxml), resolved from `today`: both are counts of days
  since 1970-01-01 in the user's zone, `today` as a statechart takes it from
  the host's clock and zone through days_from_epoch_seconds.scxml. Absent
  when the expression names no date (`none`). What each kind resolves to is
  date_kind.scxml's; this document only composes the calendar the library
  already has, days_from_civil, civil_from_days, weekday_from_days,
  add_months and days_in_month, and computes no date of its own.

  The expression is taken whole, as the union a statechart lifted from a
  text, and each kind is resolved under a test of its tag, where its case's
  numbers are read (docs/adr/0092, section 10.2). Every number a kind reads
  is present by the type of its case, so no precondition asks for one. Every
  kind is tested and returned, so no kind is left after the last test; a
  kind a revision of date_kind.scxml adds is left there, and this document
  is refused at build (`algorithm/return-missing`) until it resolves it.

  Failures (SCE_FORGE.md §3.4.1):
  - `precondition`: a month outside 1 to 12; a day the month does not have
    (for `absolute` in that year, for `monthDay` in any year, so 29 February
    is a day February has, for `dayOfMonthOffset` in the month it lands in);
    a weekday past 6;
  - `overflow`: the day leaves int64, or the year of a date the kind works
    out leaves int32. The kinds that read today's date (`monthDay`,
    `relativeMonths`, `relativeYears`, `dayOfMonthOffset`) read it first, so
    a `today` whose own year leaves int32 fails there. A precondition is
    judged before anything is computed, so an expression that breaks one
    fails `precondition` whatever `today` is. The one precondition that
    depends on `today` is a `dayOfMonthOffset` day within 1 to 31 that the
    month it lands in does not have: that month is known only once today's
    date and the landing month are worked out, so it is judged after both,
    and a `today` or a landing month whose year leaves int32 fails
    `overflow` first.

  `relativeYears` moves the year and holds the day to the month it lands in,
  which is add_months by twelve times `count`, written as the year it is:
  add_months takes its count of months as an int32, so `12 * count` would
  fail `overflow` for a count past 178956970 whose year still fits.

  Each shift is one addition to `today`, of a number that cannot overflow,
  so a day count fails `overflow` exactly when the day it names leaves
  int64, and never at a step on the way to one that does not.

  today 20761 (2026-11-04, a Wednesday):
  relativeDays 1 → 20762 · comingWeekday 3 → 20768 (a week ahead) ·
  previousWeekday 3 → 20754 · weekdayOfWeek 1, 1 → 20766 (Monday of next
  week) · monthDay 2, 29 → 21243 (2028-02-29) · none → absent ·
  absolute 2026, 2, 29 → precondition · dayOfMonthOffset 5, 1 → 20792
  (2026-12-05) · dayOfMonthOffset 1, 0 → 20758 (2026-11-01, before today) ·
  dayOfMonthOffset 31, 0 → precondition (November has 30 days).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="algorithm" name="resolve_date" version="1.0">
  <sce:import kind="enum" src="date_kind.scxml" as="DateKind"/>
  <sce:import kind="union" src="date_expression.scxml" as="DateExpression"/>
  <sce:import kind="event-schema" src="civil_date.scxml" as="CivilDate"/>
  <sce:import kind="algorithm" src="days_from_civil.scxml" as="daysOf"/>
  <sce:import kind="algorithm" src="civil_from_days.scxml" as="civil"/>
  <sce:import kind="algorithm" src="weekday_from_days.scxml" as="weekdayOf"/>
  <sce:import kind="algorithm" src="add_months.scxml" as="addMonths"/>
  <sce:import kind="algorithm" src="days_in_month.scxml" as="monthLength"/>
  <sce:signature>
    <sce:param name="today" type="int64"/>
    <sce:param name="expression" type="union:DateExpression"/>
    <sce:return type="optional&lt;int64&gt;" may-fail="true"/>
  </sce:signature>
  <sce:body>
    <sce:if cond="expression.kind === DateKind.none">
      <sce:return expr="null"/>
    </sce:if>
    <!-- days_from_civil refuses a month outside 1 to 12 and a day its month
         does not have in that year. -->
    <sce:if cond="expression.kind === DateKind.absolute">
      <sce:return expr="daysOf(expression.year, expression.month, expression.day)"/>
    </sce:if>
    <sce:if cond="expression.kind === DateKind.monthDay">
      <!-- 2000 is a leap year, so its month is as long as the month ever is:
           29 February is a day February has. days_in_month refuses a month
           outside 1 to 12. -->
      <sce:require cond="expression.day &gt;= 1 &amp;&amp; expression.day &lt;= monthLength(2000, expression.month)"/>
      <sce:var name="dayToday" type="record:CivilDate" init="civil(today)"/>
      <sce:var name="landing" type="int32" init="dayToday.year"/>
      <sce:var name="landingLast" type="uint8" init="monthLength(landing, expression.month)"/>
      <!-- This year's, where the year has the day and it is not before today. -->
      <sce:if cond="expression.day &lt;= landingLast">
        <sce:var name="thisYear" type="int64" init="daysOf(landing, expression.month, expression.day)"/>
        <sce:if cond="thisYear &gt;= today">
          <sce:return expr="thisYear"/>
        </sce:if>
      </sce:if>
      <!-- Otherwise the next year that has it, which is at most eight years on
           for a 29 February (2096 to 2104). Each step is checked at the int32
           a year is held in, so a year past the largest fails `overflow`. -->
      <sce:assign target="landing" expr="landing + 1"/>
      <sce:assign target="landingLast" expr="monthLength(landing, expression.month)"/>
      <sce:while cond="expression.day &gt; landingLast">
        <sce:assign target="landing" expr="landing + 1"/>
        <sce:assign target="landingLast" expr="monthLength(landing, expression.month)"/>
      </sce:while>
      <sce:return expr="daysOf(landing, expression.month, expression.day)"/>
    </sce:if>
    <sce:if cond="expression.kind === DateKind.relativeDays">
      <sce:var name="dayShift" type="int64" init="expression.count"/>
      <sce:return expr="today + dayShift"/>
    </sce:if>
    <sce:if cond="expression.kind === DateKind.relativeWeeks">
      <sce:var name="weekShift" type="int64" init="expression.count"/>
      <sce:return expr="today + weekShift * 7"/>
    </sce:if>
    <!-- add_months holds the day to the length of the month it lands in. -->
    <sce:if cond="expression.kind === DateKind.relativeMonths">
      <sce:var name="monthFrom" type="record:CivilDate" init="civil(today)"/>
      <sce:var name="monthTo" type="record:CivilDate" init="addMonths(monthFrom.year, monthFrom.month, monthFrom.day, expression.count)"/>
      <sce:return expr="daysOf(monthTo.year, monthTo.month, monthTo.day)"/>
    </sce:if>
    <!-- The year moved at the int32 it is held in, and the day held to the
         month it lands in, as add_months holds it: only 29 February moves, to
         the 28th. -->
    <sce:if cond="expression.kind === DateKind.relativeYears">
      <sce:var name="yearFrom" type="record:CivilDate" init="civil(today)"/>
      <sce:var name="yearTo" type="int32" init="yearFrom.year + expression.count"/>
      <sce:var name="yearLast" type="uint8" init="monthLength(yearTo, yearFrom.month)"/>
      <sce:return expr="daysOf(yearTo, yearFrom.month, yearFrom.day &lt; yearLast ? yearFrom.day : yearLast)"/>
    </sce:if>
    <!-- The days from today's weekday forward to the one asked for, 0 to 6; a
         0 is today's own weekday, which is a week ahead. -->
    <sce:if cond="expression.kind === DateKind.comingWeekday">
      <sce:require cond="expression.weekday &lt;= 6"/>
      <sce:var name="comingWanted" type="int64" init="expression.weekday"/>
      <sce:var name="comingNow" type="int64" init="weekdayOf(today)"/>
      <sce:var name="comingGap" type="int64" init="(comingWanted - comingNow + 7) % 7"/>
      <sce:return expr="today + (comingGap === 0 ? 7 : comingGap)"/>
    </sce:if>
    <sce:if cond="expression.kind === DateKind.previousWeekday">
      <sce:require cond="expression.weekday &lt;= 6"/>
      <sce:var name="previousWanted" type="int64" init="expression.weekday"/>
      <sce:var name="previousNow" type="int64" init="weekdayOf(today)"/>
      <sce:var name="previousGap" type="int64" init="(previousNow - previousWanted + 7) % 7"/>
      <sce:return expr="today - (previousGap === 0 ? 7 : previousGap)"/>
    </sce:if>
    <!-- The month is moved by add_months from the 1st of today's month, which
         every month has, so the landing month is never held to a shorter one;
         days_from_civil then refuses a day that month does not have, where
         add_months would have held it to the month's last day. A day past 31
         is no month's, so it is refused before today is read. -->
    <sce:if cond="expression.kind === DateKind.dayOfMonthOffset">
      <sce:require cond="expression.day &gt;= 1 &amp;&amp; expression.day &lt;= 31"/>
      <sce:var name="offsetFrom" type="record:CivilDate" init="civil(today)"/>
      <sce:var name="offsetTo" type="record:CivilDate" init="addMonths(offsetFrom.year, offsetFrom.month, 1, expression.count)"/>
      <sce:return expr="daysOf(offsetTo.year, offsetTo.month, expression.day)"/>
    </sce:if>
    <!-- ISO 8601 counts a week's days from Monday, so Sunday, 0 here, is its
         last: the day's place in its week is (weekday + 6) % 7. -->
    <sce:if cond="expression.kind === DateKind.weekdayOfWeek">
      <sce:require cond="expression.weekday &lt;= 6"/>
      <sce:var name="isoWanted" type="int64" init="expression.weekday"/>
      <sce:var name="isoNow" type="int64" init="weekdayOf(today)"/>
      <sce:var name="weeks" type="int64" init="expression.count"/>
      <sce:return expr="today + (weeks * 7 + (isoWanted + 6) % 7 - (isoNow + 6) % 7)"/>
    </sce:if>
  </sce:body>
</scxml>
