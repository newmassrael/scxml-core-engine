<!--
  sce:std/time/date_shift.scxml — how far a date is from today, in a unit
  the case that holds it names: the record the `relativeDays`,
  `relativeWeeks`, `relativeMonths` and `relativeYears` cases of
  date_expression.scxml hold (docs/adr/0092, section 10.1). `count` is
  signed, a negative one counting back from today.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="date_shift"
       sce:event-name="time.date_shift">
  <datamodel>
    <data id="count" sce:type="int32" sce:direction="in"/>
  </datamodel>
</scxml>
