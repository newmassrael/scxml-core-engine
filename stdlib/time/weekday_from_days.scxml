<!--
  sce:std/time/weekday_from_days.scxml — the day of the week of a day
  count since 1970-01-01, 0 for Sunday through 6 for Saturday.

  1970-01-01 was a Thursday, so the weekday is (days + 4) mod 7 — but
  written as ((days % 7) + 11) % 7. The remainder takes the dividend's sign
  (SCE_FORGE.md §3.4.1), so `(days + 4) % 7` answers a negative number for
  most days before 1970, the trap this document exists so that no caller
  steps in; and taking the remainder first keeps every step small, so the
  function cannot fail for any int64 day.

  0 → 4 (Thursday) · 20719 → 3 (Wednesday, 2026-09-23) · -1 → 3 (Wednesday)
  · -719529 → 5 (Friday, -0001-12-31).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="algorithm" name="weekday_from_days" version="1.0">
  <sce:signature>
    <sce:param name="days" type="int64"/>
    <sce:return type="uint8"/>
  </sce:signature>
  <sce:body>
    <sce:var name="w" type="int64" init="(days % 7 + 11) % 7"/>
    <sce:return expr="w"/>
  </sce:body>
</scxml>
