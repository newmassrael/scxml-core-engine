<!--
  sce:std/time/days_in_month.scxml — the number of days in a month of a
  proleptic Gregorian year.

  February follows the leap-year rule of is_leap_year, imported beside it
  in the library by a relative name. A month outside 1..12 is not a month,
  so it fails `precondition` (SCE_FORGE.md §3.4.1) rather than being given
  a length that would read as an answer.

  (2024, 2) → 29 · (2023, 2) → 28 · (2026, 4) → 30 · (2026, 12) → 31 ·
  (2026, 0) and (2026, 13) → precondition.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="algorithm" name="days_in_month" version="1.0">
  <sce:import kind="algorithm" src="is_leap_year.scxml" as="leap"/>
  <sce:signature>
    <sce:param name="year" type="int32"/>
    <sce:param name="month" type="uint8"/>
    <sce:return type="uint8" may-fail="true"/>
  </sce:signature>
  <sce:body>
    <sce:require cond="month &gt;= 1 &amp;&amp; month &lt;= 12"/>
    <sce:if cond="month === 2">
      <sce:if cond="leap(year)">
        <sce:return expr="29"/>
      </sce:if>
      <sce:return expr="28"/>
    </sce:if>
    <sce:if cond="month === 4 || month === 6 || month === 9 || month === 11">
      <sce:return expr="30"/>
    </sce:if>
    <sce:return expr="31"/>
  </sce:body>
</scxml>
