<!--
  sce:std/time/date_expression.scxml — a date as a text names it, written as
  which kind of date it is and the numbers that kind reads, so that the
  arithmetic is done by resolve_date.scxml and never by whoever read the
  text (docs/adr/0087, section 5). A record type, read from a text by a
  lift, and a schema of its own events.

  `kind` says which fields are read (date_kind.scxml); a field the kind does
  not read is written `null`. `weekday` counts from 0 for Sunday to 6 for
  Saturday, as weekday_from_days.scxml does; `count` is signed, a negative
  one counting back from today.

  "the 3rd of March 2027"       → absolute, 2027, 3, 3
  "on 29 February"              → monthDay, null, 2, 29
  "in two weeks"                → relativeWeeks, count 2
  "next Friday" (the coming one) → comingWeekday, weekday 5
  "Friday next week"            → weekdayOfWeek, weekday 5, count 1
  "the 5th of next month"       → dayOfMonthOffset, day 5, count 1
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="date_expression"
       sce:event-name="time.date_expression">
  <sce:import kind="enum" src="date_kind.scxml" as="DateKind"/>
  <datamodel>
    <data id="kind" sce:type="enum:DateKind" sce:direction="in"/>
    <data id="year" sce:type="optional&lt;int32&gt;" sce:direction="in"/>
    <data id="month" sce:type="optional&lt;uint8&gt;" sce:direction="in"/>
    <data id="day" sce:type="optional&lt;uint8&gt;" sce:direction="in"/>
    <data id="weekday" sce:type="optional&lt;uint8&gt;" sce:direction="in"/>
    <data id="count" sce:type="optional&lt;int32&gt;" sce:direction="in"/>
  </datamodel>
</scxml>
