# SourceDigest.cmake — the digest of a source tree, written as a C++ header.
#
# Usage (from sce/CMakeLists.txt, as a build-time custom command):
#   cmake -D SCE_DIGEST_ROOT=<dir> -D SCE_DIGEST_LISTING=<file>
#         -D SCE_DIGEST_HEADER=<file> -P SourceDigest.cmake
#
# SCE_DIGEST_LISTING names one file per line, by its path relative to
# SCE_DIGEST_ROOT, sorted. The digest is the SHA-256 of a manifest that holds,
# for each of those files in that order, the SHA-256 of its bytes, two spaces
# and its relative path, one line each (the form `sha256sum` prints). A path
# holds no newline, so the manifest names one set of contents; it holds no
# absolute path, so the digest is the same wherever the tree is checked out,
# and nothing in it reads a clock, a commit or the machine.
#
# Generates a header containing:
#   #define SCE_RUNTIME_SOURCE_DIGEST "<64 lowercase hex digits>"
#
# The header is rewritten only when its text changes, so a re-run after a
# file was only touched, or saved with the bytes it had, leaves the files that
# include it alone.

foreach(_var SCE_DIGEST_ROOT SCE_DIGEST_LISTING SCE_DIGEST_HEADER)
    if(NOT DEFINED ${_var})
        message(FATAL_ERROR "SourceDigest.cmake: ${_var} is not set")
    endif()
endforeach()

file(STRINGS "${SCE_DIGEST_LISTING}" _paths ENCODING UTF-8)
list(LENGTH _paths _count)
if(_count EQUAL 0)
    # A digest of nothing identifies nothing; the listing was not written.
    message(FATAL_ERROR "SourceDigest.cmake: ${SCE_DIGEST_LISTING} names no file")
endif()

set(_manifest "")
foreach(_path IN LISTS _paths)
    file(SHA256 "${SCE_DIGEST_ROOT}/${_path}" _hash)
    string(APPEND _manifest "${_hash}  ${_path}\n")
endforeach()
string(SHA256 _digest "${_manifest}")

set(_header "// Generated by sce/cmake/SourceDigest.cmake from the sources under sce/. Do not edit.\n")
string(APPEND _header "#pragma once\n")
string(APPEND _header "#define SCE_RUNTIME_SOURCE_DIGEST \"${_digest}\"\n")

set(_previous "")
if(EXISTS "${SCE_DIGEST_HEADER}")
    file(READ "${SCE_DIGEST_HEADER}" _previous)
endif()
if(NOT _previous STREQUAL _header)
    file(WRITE "${SCE_DIGEST_HEADER}" "${_header}")
endif()
