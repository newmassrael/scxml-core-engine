# SCE Static Integration Fixture Code Generation
#
# Parallel to SCEStaticW3CTest.cmake but scoped to integration
# fixtures under `integration_resources/<stem>/<stem>.scxml`. Generates C++
# state machine code (parent + synth-invoke children) at CMake
# build time into ${CMAKE_CURRENT_BINARY_DIR}/integration_static_generated/.
#
# Build-time generation (no committed tree) mirrors how cpp / C11
# W3C IRP code is produced — the build itself is the §6.2.6
# freshness invariant, distinct from the committed-tree backends
# (Rust / Kotlin / Go) where drift-verify guards the SCE-GENERATED
# header.

if(POLICY CMP0116)
    cmake_policy(SET CMP0116 NEW)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/SCEClangFormat.cmake)

# SCE_CODEGEN is already resolved in SCEStaticW3CTest.cmake. Loading
# this file after that one keeps a single source of truth for the
# binary path; this guard catches the misuse where this file is
# included standalone.
if(NOT SCE_CODEGEN)
    message(FATAL_ERROR
        "SCEStaticIntegrationFixture.cmake: SCE_CODEGEN unset. Include "
        "SCEStaticW3CTest.cmake first (it resolves the binary).")
endif()

# Which files a fixture's generation writes is asked of the generator
# (`sce_codegen_plan`), by the same helper the W3C route asks it through.
include(${CMAKE_CURRENT_LIST_DIR}/SCECodegenPlan.cmake)

# _sce_refuse_children_arguments:
#   The synth-invoke children and hybrid stubs of a fixture are derived from the
#   generator (`sce_codegen_plan`), so a call that still lists them
#   is asking for the second copy this file no longer keeps — and would be
#   ignored without a word if it were not refused.
function(_sce_refuse_children_arguments FUNCTION STEM)
    if(ARGN)
        message(FATAL_ERROR
            "${FUNCTION}(${STEM}): unexpected argument(s): ${ARGN}. "
            "SYNTH_INVOKE_CHILDREN and HYBRID_INVOKE_CHILDREN are gone: the children "
            "a fixture produces are read from `sce-codegen --plan generate`, not "
            "listed here. Remove them from the call.")
    endif()
endfunction()

# sce_generate_static_integration_test:
#   Register one integration fixture whose C++ AOT code the build generates.
#   Every registered fixture is declared by the one
#   `sce_declare_registered_static_integration_tests()` that follows the last
#   registration, which asks the generator for every fixture's plan in one
#   batch (`sce_codegen_plan_request`, `sce_codegen_plan_prefetch`) and then
#   declares each from the answer the batch kept. Asked one fixture at a time,
#   the plans were most of what a configure cost. A fixture registered after
#   that call, and a registration no call follows, are refused: either would
#   be a fixture the build never generates.
#
# Args:
#   STEM        Fixture stem (`donedata_local_invoke` etc.). The
#               canonical source must live at
#               `${CMAKE_SOURCE_DIR}/integration_resources/${STEM}/${STEM}.scxml`.
#   OUTPUT_DIR  Destination dir for generated `_sm.{h,inl}` files
#               (typically `${STATIC_INTEGRATION_OUTPUT_DIR}`).
#   SCXML_FILE  (optional) The document, when it is NOT under
#               `integration_resources/`. Such a document sits beside its drivers
#               because a stem under `integration_resources/` is a seven-channel
#               contract and the document asks something fewer channels can be
#               asked (see `tests/integration/a_child_timer_is_a_deadline_of_its_parent.scxml`).
#               Its file name must be `${STEM}.scxml`, and the directory holding
#               it is the `--input-root` the way the stem's own directory is.
#
# What the fixture produces besides its own `_sm.{h,inl}` — a machine per inline
# `<invoke>` (`<stem>__sce_synth_invoke__<id>`, SCE Mesh §9.6.6 rule 1) and one
# per stub or candidate of an `<invoke>` that names its target through an
# expression (docs/SCE_ACCEPTED_SUBSET.md §2.13) — is not named by the caller.
# It is asked of the generator when the tree is configured
# (`sce_codegen_plan`), and every file of the answer is declared
# as an output of the command that writes it. The child documents the parent's
# generation writes (a stub, a candidate) are generated by a command each,
# without `--parent-stem`: the parent emits `::SCE::Generated::<name>::<name>`,
# the plain namespace codegen gives a document of that name, so rewriting it
# under the parent would leave the reference unresolved. What each of those
# generations writes is the generator's answer too (`CHILD_GENERATIONS`): it
# plans the child from the text the parent's generation would write, which is
# on no disk when the tree is configured.
#
# Side effects (of the declaration):
#   - Appends parent + every child `_sm.h` to GENERATED_INTEGRATION_HEADERS
#     (PARENT_SCOPE) so the caller's executable target can DEPENDS on them.
#   - Stages the fixture into OUTPUT_DIR when the tree is configured, so the
#     children land in OUTPUT_DIR rather than in the read-only source tree under
#     integration_resources/. Editing the fixture reconfigures the tree, which
#     is when the children are asked for again.
#
# Drift contract:
#   The build-time output dir is distinct from W3C's `w3c_static_generated/`
#   so a stale fixture surfaces as a stale tree per-context (mirroring
#   the committed-tree backends' separate §6.2.6 drift contexts).
function(sce_generate_static_integration_test STEM OUTPUT_DIR)
    cmake_parse_arguments(_INT "" "SCXML_FILE" "" ${ARGN})
    _sce_refuse_children_arguments(sce_generate_static_integration_test "${STEM}"
        ${_INT_UNPARSED_ARGUMENTS})
    get_property(_DECLARED GLOBAL PROPERTY _SCE_STATIC_INTEGRATION_DECLARED)
    if(_DECLARED)
        message(FATAL_ERROR
            "sce_generate_static_integration_test(${STEM}) comes after "
            "sce_declare_registered_static_integration_tests(), which declared the "
            "fixtures registered before it: this one would never be generated. "
            "Register it before that call.")
    endif()
    get_property(_REGISTERED GLOBAL PROPERTY _SCE_STATIC_INTEGRATION_REGISTERED)
    if("${STEM}" IN_LIST _REGISTERED)
        message(FATAL_ERROR
            "sce_generate_static_integration_test(${STEM}) registers a fixture "
            "registered already")
    endif()
    if(NOT _REGISTERED)
        # The first registration: the configure ends refusing a registration
        # no declaration followed.
        cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}"
            CALL _sce_refuse_undeclared_static_integration_tests)
    endif()
    set_property(GLOBAL APPEND PROPERTY _SCE_STATIC_INTEGRATION_REGISTERED "${STEM}")
    set_property(GLOBAL PROPERTY "_SCE_STATIC_INTEGRATION_${STEM}_OUTPUT_DIR" "${OUTPUT_DIR}")
    set_property(GLOBAL PROPERTY "_SCE_STATIC_INTEGRATION_${STEM}_SCXML_FILE"
        "${_INT_SCXML_FILE}")
endfunction()

# sce_declare_registered_static_integration_tests()
#
#   Declare every fixture `sce_generate_static_integration_test` registered:
#   stage each, ask the generator for every plan in one batch, then declare
#   each generation from the answer the batch kept. Appends every header they
#   write to GENERATED_INTEGRATION_HEADERS in the caller's scope.
function(sce_declare_registered_static_integration_tests)
    get_property(_DECLARED GLOBAL PROPERTY _SCE_STATIC_INTEGRATION_DECLARED)
    if(_DECLARED)
        message(FATAL_ERROR
            "sce_declare_registered_static_integration_tests() is called twice; every "
            "fixture is registered before the one call that declares them")
    endif()
    set_property(GLOBAL PROPERTY _SCE_STATIC_INTEGRATION_DECLARED TRUE)
    get_property(_REGISTERED GLOBAL PROPERTY _SCE_STATIC_INTEGRATION_REGISTERED)
    foreach(_STEM IN LISTS _REGISTERED)
        _sce_static_integration_fixture(REQUEST "${_STEM}")
    endforeach()
    sce_codegen_plan_prefetch()
    set(_HEADERS "")
    foreach(_STEM IN LISTS _REGISTERED)
        _sce_static_integration_fixture(DECLARE "${_STEM}")
        list(APPEND _HEADERS ${_FIXTURE_HEADERS})
    endforeach()
    set(GENERATED_INTEGRATION_HEADERS ${GENERATED_INTEGRATION_HEADERS} ${_HEADERS} PARENT_SCOPE)
endfunction()

# _sce_refuse_undeclared_static_integration_tests()
#
#   At the end of the configure: refuse fixtures registered and never
#   declared, which no command would generate and no target compile.
function(_sce_refuse_undeclared_static_integration_tests)
    get_property(_DECLARED GLOBAL PROPERTY _SCE_STATIC_INTEGRATION_DECLARED)
    if(NOT _DECLARED)
        get_property(_REGISTERED GLOBAL PROPERTY _SCE_STATIC_INTEGRATION_REGISTERED)
        message(FATAL_ERROR
            "sce_generate_static_integration_test registered ${_REGISTERED}, and no "
            "sce_declare_registered_static_integration_tests() declared them")
    endif()
endfunction()

# _sce_static_integration_fixture(<REQUEST|DECLARE> <STEM>)
#
#   One registered fixture: staged, then its plan asked ahead (REQUEST), or
#   its generation declared from the plan (DECLARE), which sets
#   `_FIXTURE_HEADERS` in the caller's scope to every header it writes. The
#   two ask the generator the same question, in the options both spell
#   (`the_conformance_cmake_route_declares_what_the_generator_plans` holds the
#   request to the plan).
function(_sce_static_integration_fixture MODE STEM)
    set(_FIXTURE_HEADERS "" PARENT_SCOPE)
    get_property(OUTPUT_DIR GLOBAL PROPERTY "_SCE_STATIC_INTEGRATION_${STEM}_OUTPUT_DIR")
    get_property(_SCXML_FILE GLOBAL PROPERTY "_SCE_STATIC_INTEGRATION_${STEM}_SCXML_FILE")
    if(_SCXML_FILE)
        set(FIXTURE "${_SCXML_FILE}")
        get_filename_component(FIXTURE_ROOT "${FIXTURE}" DIRECTORY)
    else()
        set(FIXTURE_ROOT "${CMAKE_SOURCE_DIR}/integration_resources/${STEM}")
        set(FIXTURE "${FIXTURE_ROOT}/${STEM}.scxml")
    endif()

    if(NOT EXISTS "${FIXTURE}")
        if(MODE STREQUAL "DECLARE")
            message(WARNING
                "sce_generate_static_integration_test: fixture not found, "
                "skipping ${STEM}: ${FIXTURE}")
        endif()
        return()
    endif()

    file(MAKE_DIRECTORY "${OUTPUT_DIR}")

    set(STAGED_SCXML "${OUTPUT_DIR}/${STEM}.scxml")

    # Step 1: stage the fixture into OUTPUT_DIR so synth-invoke children
    # land in OUTPUT_DIR rather than polluting the read-only source tree
    # under integration_resources/. At configure time, and before the plan is
    # asked ahead, because the plan has to read the staged document;
    # `configure_file` also makes an edit to the fixture reconfigure the tree,
    # which is when its children are asked for again.
    configure_file("${FIXTURE}" "${STAGED_SCXML}" COPYONLY)

    if(MODE STREQUAL "REQUEST")
        sce_codegen_plan_request(
            STEM "${STEM}"
            DOCUMENT "${STAGED_SCXML}"
            OUTPUT_DIR "${OUTPUT_DIR}"
            LANGUAGE cpp
            INPUT_ROOT "${FIXTURE_ROOT}"
            CHILD_GENERATIONS)
        return()
    endif()

    # Step 2: parent generate. Emits `<stem>_sm.{h,inl}`, the synth-invoke
    # `<stem>__sce_synth_invoke__<id>.scxml` siblings with each one's
    # `_sm.{h,inl}` — `generate` emits an inline child's machine with its
    # parent, under the parent's stem, so no `--as-child` pass per child is
    # needed — and any stub or candidate document of an `<invoke srcexpr>`.
    # `--input-root` pins the §6.2.6 source-hash to the canonical fixture dir
    # so the build-time output advertises the same hash the committed-tree
    # backends embed.
    #
    # Every file this command writes is declared on it: the parent header as the
    # OUTPUT and the rest as BYPRODUCTS. The declaration is the generator's own
    # answer (`sce-codegen --plan generate`), not a list kept here. A hand-kept
    # list of a fixture's synth and hybrid children fell out of step with the
    # generator for six stems, and each file it missed was one ninja 1.11 refused
    # a rebuild over: "depfile mentions ... as an output, but no such output was
    # declared" (CMake 3.28, 2026-09-30). The depfile names one target now, so a
    # missing declaration no longer stops the build, but it still leaves a file
    # the build does not know it makes.
    #
    # The header is the OUTPUT because the depfile's one target is the primary
    # artefact, and ninja needs that to be the edge's FIRST output.
    #
    # `CHILD_GENERATIONS` asks, in the same answer, what the generation of each
    # child document this one writes will write in turn (see above).
    sce_codegen_plan(_PLAN
        STEM "${STEM}"
        DOCUMENT "${STAGED_SCXML}"
        OUTPUT_DIR "${OUTPUT_DIR}"
        LANGUAGE cpp
        INPUT_ROOT "${FIXTURE_ROOT}"
        CHILD_GENERATIONS)

    # Formatting happens inside sce-codegen, with the pinned clang-format, on
    # the parent and the synth children it emits alike — see SCEClangFormat.cmake.
    sce_codegen_format_args(_FORMAT_ARGS)

    # `--write-deps` + DEPFILE: the generated source depends on every
    # jinja2 template that rendered it, not just on the SCXML. Without it
    # a template edit leaves this artefact stale and the build reuses it
    # silently — measured, by editing a template and watching zero of the
    # generated headers change. `SCECodegen.cmake` has always done this;
    # this generator had not.
    add_custom_command(
        OUTPUT ${_PLAN_OUTPUTS}
        COMMAND "${SCE_CODEGEN}" generate "${STAGED_SCXML}"
                -l cpp -o "${OUTPUT_DIR}"
                --input-root "${FIXTURE_ROOT}"
                --write-deps "${_PLAN_DEPFILE}"
                ${_FORMAT_ARGS}
        DEPENDS "${STAGED_SCXML}" "${SCE_CODEGEN}"
        DEPFILE "${_PLAN_DEPFILE}"
        ${_PLAN_BYPRODUCTS_ARG}
        COMMENT "Generating C++ integration parent: ${STEM}"
        VERBATIM
    )

    # The parent's header and every header its generation writes beside it:
    # each synthesized child's, and the transition function's when the document
    # declares one.
    set(_ALL_HEADERS ${_PLAN_HEADERS})

    # Each child document the parent's generation writes (a stub, a candidate),
    # and each one those write in turn, is generated by a command of its own,
    # without `--parent-stem` (see above), declared from the plan the parent's
    # answer holds for it: its machine, the children it carries written in-line
    # (a candidate such as `static_mesh_relay` starts its `inner`), and the
    # documents it writes for generations of their own. It waits for the
    # generation that writes the document it reads.
    foreach(_CHILD ${_PLAN_GENERATIONS})
        sce_codegen_plan(_CHILD_PLAN FROM _PLAN CHILD "${_CHILD}")
        add_custom_command(
            OUTPUT ${_CHILD_PLAN_OUTPUTS}
            COMMAND "${SCE_CODEGEN}" generate "${_CHILD_PLAN_DOCUMENT}"
                    ${_CHILD_PLAN_ARGS}
                    -l cpp -o "${OUTPUT_DIR}"
                    --input-root "${FIXTURE_ROOT}"
                    --write-deps "${_CHILD_PLAN_DEPFILE}"
                    ${_FORMAT_ARGS}
            DEPENDS ${_CHILD_PLAN_DEPENDS} "${SCE_CODEGEN}"
            DEPFILE "${_CHILD_PLAN_DEPFILE}"
            ${_CHILD_PLAN_BYPRODUCTS_ARG}
            COMMENT "Generating C++ integration child of ${STEM}: ${_CHILD}"
            VERBATIM
        )
        list(APPEND _ALL_HEADERS ${_CHILD_PLAN_HEADERS})
    endforeach()

    set(_FIXTURE_HEADERS ${_ALL_HEADERS} PARENT_SCOPE)
endfunction()

# sce_generate_static_integration_c_test:
#   C11 sibling of `sce_generate_static_integration_test`. Emits
#   `<stem>_sm.{h,c}` (rather than `.h/.inl` for cpp) plus the
#   synth-invoke `_sm.c` children that the parent's translation unit
#   #includes. Caller wires the resulting source list into an
#   `add_executable` target via the conventional integration runner
#   under `backends/c/tests/integration/test_<stem>.c`.
#
# Args:
#   STEM        Fixture stem (`donedata_local_invoke` etc.). Canonical
#               source: `${CMAKE_SOURCE_DIR}/integration_resources/${STEM}/${STEM}.scxml`.
#   OUTPUT_DIR  Destination dir for `_sm.{h,c}` (e.g.
#               `${SCE_C_INTEGRATION_GENERATED_DIR}`).
#
# The fixture's synth-invoke and hybrid children are derived, as the cpp
# variant's are: see `sce_codegen_plan`.
#
# The call stages the fixture and asks ahead for its plan
# (`sce_codegen_plan_request`); every fixture registered in a directory is
# declared at the end of that directory (`cmake_language(DEFER)`), after the
# plans of all of them were asked of the generator in one batch. Each block
# that compiles a fixture follows its call and uses the sources at once, so
# the files are not known when the call returns: what it hands back names
# them as a generator expression, which a target's sources take and the
# generate step reads once the declaration has filled it.
#
# Side effects:
#   - Sets `INTEGRATION_C_TEST_${STEM}_SOURCES` (PARENT_SCOPE) to the
#     parent _sm.c plus every child _sm.c and every header they write, as a
#     generator expression for a target's sources (the caller links these
#     into the per-fixture executable target); a fixture not found sets
#     nothing.
# Keyword args beyond the stem contract:
#   SCXML_FILE <path>        Generate this document instead of the
#                            `integration_resources/<stem>/<stem>.scxml`
#                            the stem names. For a fixture that is
#                            deliberately NOT a seven-channel stem — the
#                            §scxml-6.2.5 host-served document is asked of
#                            the backends that have a registry, and the
#                            others still refuse the declaration by name.
#                            A library name (`sce:std/shared/record_list.scxml`)
#                            generates that standard statechart from the
#                            library the generator embeds, unstaged.
#   HOST_PROCESSOR <type>... Pass `--host-processor <type>` to codegen.
#                            Load-bearing rather than cosmetic: codegen
#                            decides at compile time whether a `<send
#                            type>` site dispatches or refuses, so a test
#                            registering a handler against a machine built
#                            without the flag meets the refusal and reads
#                            as a feature that does not work.
#   HOST_INVOKER <type>...   Pass `--host-invoker <type>` to codegen — the
#                            `<invoke type>` twin of HOST_PROCESSOR, and
#                            load-bearing for the same reason: codegen
#                            decides at compile time whether the invoke
#                            starts or refuses.
#   STAGE_ALSO <file>...     Sibling documents to copy beside the staged
#                            fixture, named relative to its directory.
#                            The staging copies ONE file, so a fixture
#                            that `<sce:import src="…">`s a sibling
#                            resolves it against a directory the sibling
#                            is not in — and the import is not an error,
#                            so what reaches codegen is a document whose
#                            schema silently went missing. Naming them
#                            here rather than scanning the fixture keeps
#                            the answer explicit: a name that is wrong
#                            fails at the copy, where it can be read.
function(sce_generate_static_integration_c_test STEM OUTPUT_DIR)
    cmake_parse_arguments(_INT "" "SCXML_FILE"
        "HOST_PROCESSOR;HOST_INVOKER;STAGE_ALSO" ${ARGN})
    _sce_refuse_children_arguments(sce_generate_static_integration_c_test "${STEM}"
        ${_INT_UNPARSED_ARGUMENTS})
    get_property(_DECLARED DIRECTORY PROPERTY _SCE_C_INTEGRATION_DECLARED)
    if(_DECLARED)
        message(FATAL_ERROR
            "sce_generate_static_integration_c_test(${STEM}) comes after the fixtures of "
            "this directory were declared: it would never be generated")
    endif()
    get_property(_EVERY GLOBAL PROPERTY _SCE_C_INTEGRATION_REGISTERED)
    if("${STEM}" IN_LIST _EVERY)
        message(FATAL_ERROR
            "sce_generate_static_integration_c_test(${STEM}) registers a fixture "
            "registered already; INTEGRATION_C_TEST_${STEM}_SOURCES names one generation")
    endif()
    set_property(GLOBAL APPEND PROPERTY _SCE_C_INTEGRATION_REGISTERED "${STEM}")
    foreach(_OPTION OUTPUT_DIR SCXML_FILE HOST_PROCESSOR HOST_INVOKER STAGE_ALSO)
        if(_OPTION STREQUAL "OUTPUT_DIR")
            set(_VALUE "${OUTPUT_DIR}")
        else()
            set(_VALUE "${_INT_${_OPTION}}")
        endif()
        set_property(DIRECTORY PROPERTY "_SCE_C_INTEGRATION_${STEM}_${_OPTION}" "${_VALUE}")
    endforeach()

    _sce_static_integration_c_fixture(REQUEST "${STEM}")
    if(NOT _FIXTURE_FOUND)
        return()
    endif()

    get_property(_PENDING DIRECTORY PROPERTY _SCE_C_INTEGRATION_PENDING)
    if(NOT _PENDING)
        # The first fixture of this directory: its declarations, and every
        # later fixture's, are made when the directory ends.
        if(NOT TARGET sce_c_integration_generated_sources)
            # Holds, per fixture, the files its generations write, for the
            # generator expression each caller is handed.
            add_library(sce_c_integration_generated_sources INTERFACE)
        endif()
        cmake_language(DEFER CALL _sce_declare_registered_static_integration_c_tests)
    endif()
    set_property(DIRECTORY APPEND PROPERTY _SCE_C_INTEGRATION_PENDING "${STEM}")
    set("INTEGRATION_C_TEST_${STEM}_SOURCES"
        "$<TARGET_PROPERTY:sce_c_integration_generated_sources,SCE_GENERATED_SOURCES_${STEM}>"
        PARENT_SCOPE)
endfunction()

# _sce_declare_registered_static_integration_c_tests()
#
#   At the end of a directory: send every plan its C11 integration fixtures
#   asked ahead in one batch, then declare each fixture's generations from
#   the answers, in the order the fixtures were registered (which `CLAIM`
#   reads: the first fixture to declare a shared candidate owns it), and fill
#   the sources each caller's generator expression names.
function(_sce_declare_registered_static_integration_c_tests)
    set_property(DIRECTORY PROPERTY _SCE_C_INTEGRATION_DECLARED TRUE)
    get_property(_PENDING DIRECTORY PROPERTY _SCE_C_INTEGRATION_PENDING)
    sce_codegen_plan_prefetch()
    foreach(_STEM IN LISTS _PENDING)
        _sce_static_integration_c_fixture(DECLARE "${_STEM}")
        set_property(TARGET sce_c_integration_generated_sources
            PROPERTY "SCE_GENERATED_SOURCES_${_STEM}" ${_FIXTURE_SOURCES})
    endforeach()
endfunction()

# _sce_static_integration_c_fixture(<REQUEST|DECLARE> <STEM>)
#
#   One C11 integration fixture of this directory, from the options its call
#   registered: staged and its plan asked ahead (REQUEST, which sets
#   `_FIXTURE_FOUND` in the caller's scope), or its generations declared from
#   the plan (DECLARE, which sets `_FIXTURE_SOURCES` to every translation unit
#   and header they write). The two ask the generator the same question, in
#   the options both spell
#   (`the_conformance_cmake_route_declares_what_the_generator_plans` holds the
#   request to the plan).
function(_sce_static_integration_c_fixture MODE STEM)
    set(_FIXTURE_FOUND FALSE PARENT_SCOPE)
    set(_FIXTURE_SOURCES "" PARENT_SCOPE)
    foreach(_OPTION OUTPUT_DIR SCXML_FILE HOST_PROCESSOR HOST_INVOKER STAGE_ALSO)
        get_property(_INT_${_OPTION} DIRECTORY PROPERTY "_SCE_C_INTEGRATION_${STEM}_${_OPTION}")
    endforeach()
    set(OUTPUT_DIR "${_INT_OUTPUT_DIR}")

    # A library name (`sce:std/shared/record_list.scxml`) names a statechart of the
    # standard library, which the generator reads from the library it embeds: it is
    # neither found on disk nor staged, it has no directory to be the input root, and
    # its siblings are the library's, which the generator resolves itself.
    set(_STANDARD FALSE)
    if(_INT_SCXML_FILE MATCHES "^sce:")
        set(_STANDARD TRUE)
        if(_INT_STAGE_ALSO)
            message(FATAL_ERROR
                "sce_generate_static_integration_c_test(${STEM}): STAGE_ALSO names "
                "${_INT_STAGE_ALSO} beside ${_INT_SCXML_FILE}, a standard statechart, "
                "whose imports the generator reads from its own library")
        endif()
        set(FIXTURE_ROOT "")
        set(FIXTURE "${_INT_SCXML_FILE}")
    elseif(_INT_SCXML_FILE)
        get_filename_component(FIXTURE_ROOT "${_INT_SCXML_FILE}" DIRECTORY)
        set(FIXTURE "${_INT_SCXML_FILE}")
    else()
        set(FIXTURE_ROOT "${CMAKE_SOURCE_DIR}/integration_resources/${STEM}")
        set(FIXTURE "${FIXTURE_ROOT}/${STEM}.scxml")
    endif()

    set(_HOST_PROCESSOR_ARGS "")
    foreach(_TYPE ${_INT_HOST_PROCESSOR})
        list(APPEND _HOST_PROCESSOR_ARGS --host-processor "${_TYPE}")
    endforeach()
    foreach(_TYPE ${_INT_HOST_INVOKER})
        list(APPEND _HOST_PROCESSOR_ARGS --host-invoker "${_TYPE}")
    endforeach()

    if(NOT _STANDARD AND NOT EXISTS "${FIXTURE}")
        message(WARNING
            "sce_generate_static_integration_c_test: fixture not found, "
            "skipping ${STEM}: ${FIXTURE}")
        return()
    endif()
    set(_FIXTURE_FOUND TRUE PARENT_SCOPE)

    file(MAKE_DIRECTORY "${OUTPUT_DIR}")

    if(_STANDARD)
        # Generated by its library name; a rebuilt generator is a changed library.
        set(STAGED_SCXML "${FIXTURE}")
        set(_STAGED_DEPENDS "")
        set(_INPUT_ROOT_ARGS "")
    else()
        set(STAGED_SCXML "${OUTPUT_DIR}/${STEM}.scxml")
        set(_STAGED_DEPENDS "${STAGED_SCXML}")
        set(_INPUT_ROOT_ARGS --input-root "${FIXTURE_ROOT}")
    endif()

    if(MODE STREQUAL "REQUEST")
        if(NOT _STANDARD)
            # Staged at configure time, when the fixture is registered, as the
            # cpp variant stages it: the plan reads the staged document, and
            # `configure_file` makes an edit to the fixture or to a sibling
            # reconfigure the tree.
            foreach(_SIBLING ${_INT_STAGE_ALSO})
                if(NOT EXISTS "${FIXTURE_ROOT}/${_SIBLING}")
                    message(FATAL_ERROR
                        "sce_generate_static_integration_c_test(${STEM}): STAGE_ALSO names "
                        "${_SIBLING}, which is not beside the fixture at ${FIXTURE_ROOT}")
                endif()
                configure_file("${FIXTURE_ROOT}/${_SIBLING}" "${OUTPUT_DIR}/${_SIBLING}"
                    COPYONLY)
            endforeach()
            configure_file("${FIXTURE}" "${STAGED_SCXML}" COPYONLY)
        endif()
        sce_codegen_plan_request(
            STEM "${STEM}"
            DOCUMENT "${STAGED_SCXML}"
            OUTPUT_DIR "${OUTPUT_DIR}"
            LANGUAGE c11
            INPUT_ROOT "${FIXTURE_ROOT}"
            CHILD_GENERATIONS
            CLAIM SCE_C_INTEGRATION_DECLARED_OUTPUTS
            ARGS ${_HOST_PROCESSOR_ARGS})
        return()
    endif()

    # The parent emits each synth-invoke child's machine with its own, and
    # writes each child document it starts by a command of its own — see the
    # cpp generator above for why the declaration is the generator's answer and
    # not a list, and for `CHILD_GENERATIONS`.
    #
    # A document two fixtures start a child from (the candidates a hybrid
    # `<invoke>` chooses among, which the generation of whoever starts them
    # writes beside it) is the same file whoever writes it, so the first fixture
    # to declare it owns it, and its machine's generation with it: two commands
    # declaring one file as an output is an error of its own, and the second
    # writes the same bytes. `CLAIM` keeps the one list of what is declared.
    sce_codegen_plan(_PLAN
        STEM "${STEM}"
        DOCUMENT "${STAGED_SCXML}"
        OUTPUT_DIR "${OUTPUT_DIR}"
        LANGUAGE c11
        INPUT_ROOT "${FIXTURE_ROOT}"
        CHILD_GENERATIONS
        CLAIM SCE_C_INTEGRATION_DECLARED_OUTPUTS
        ARGS ${_HOST_PROCESSOR_ARGS})

    # See the cpp generator above for why DEPFILE is load-bearing: the C11
    # path is where the stale-artefact defect was first hit, and it took a
    # manual `rm` of the generated `.c` to get a template fix compiled.
    #
    # The header comes first in OUTPUT because it is the depfile's one
    # target (`sce_codegen_plan` says why).
    add_custom_command(
        OUTPUT ${_PLAN_OUTPUTS}
        COMMAND "${SCE_CODEGEN}" generate "${STAGED_SCXML}"
                -l c11 -o "${OUTPUT_DIR}"
                ${_INPUT_ROOT_ARGS}
                ${_HOST_PROCESSOR_ARGS}
                --write-deps "${_PLAN_DEPFILE}"
        DEPENDS ${_STAGED_DEPENDS} "${SCE_CODEGEN}"
        DEPFILE "${_PLAN_DEPFILE}"
        ${_PLAN_BYPRODUCTS_ARG}
        COMMENT "Generating C11 integration parent: ${STEM}"
        VERBATIM
    )

    # The parent's machine and every translation unit and header its generation
    # writes beside it: each synthesized child's, and the transition function's
    # when the document declares one.
    set(_ALL_SOURCES ${_PLAN_SOURCES})
    set(_ALL_HEADERS ${_PLAN_HEADERS})

    # Each child document the parent's generation writes, and each one those
    # write in turn, without `--parent-stem` for the reason the cpp generator
    # above states: the parent names the child by the plain symbol codegen gives
    # a document of that name. Declared from the plan the parent's answer holds
    # for it, and compiled with the fixture whichever fixture declared it first
    # (`DECLARED_ELSEWHERE`, see `CLAIM` above).
    foreach(_CHILD ${_PLAN_GENERATIONS})
        sce_codegen_plan(_CHILD_PLAN FROM _PLAN CHILD "${_CHILD}")
        if(NOT _CHILD_PLAN_DECLARED_ELSEWHERE)
            add_custom_command(
                OUTPUT ${_CHILD_PLAN_OUTPUTS}
                COMMAND "${SCE_CODEGEN}" generate "${_CHILD_PLAN_DOCUMENT}"
                        ${_CHILD_PLAN_ARGS}
                        -l c11 -o "${OUTPUT_DIR}"
                        ${_INPUT_ROOT_ARGS}
                        --write-deps "${_CHILD_PLAN_DEPFILE}"
                DEPENDS ${_CHILD_PLAN_DEPENDS} "${SCE_CODEGEN}"
                DEPFILE "${_CHILD_PLAN_DEPFILE}"
                ${_CHILD_PLAN_BYPRODUCTS_ARG}
                COMMENT "Generating C11 integration child of ${STEM}: ${_CHILD}"
                VERBATIM
            )
        endif()
        list(APPEND _ALL_SOURCES ${_CHILD_PLAN_SOURCES})
        list(APPEND _ALL_HEADERS ${_CHILD_PLAN_HEADERS})
    endforeach()

    # Sources include both .c (compilation units) and .h (generated header
    # dependencies). Listing the headers makes them part of the target's
    # input set so Ninja schedules every child codegen before compiling
    # the parent _sm.c that #includes them.
    set(_FIXTURE_SOURCES ${_ALL_SOURCES} ${_ALL_HEADERS} PARENT_SCOPE)
endfunction()
