@PACKAGE_INIT@

# SCEConfig.cmake - CMake configuration file for SCE (SCXML Core Engine)
#
# This file is generated by cmake configure_package_config_file() and enables
# external projects to use SCE via find_package(SCE).
#
# ─── Tier selection ────────────────────────────────────────────────────────
# SCE ships as four layered library tiers. Consumers link the tier that
# matches their use case (ARCHITECTURE.md §4-Tier). No "default main library"
# exists; pick deliberately:
#
#   SCE::sce_core       Header-only. Templates + concepts. Minimal AOT embed.
#   SCE::sce_base       Pure static AOT. Logger, Helper, utilities. No scripting.
#   SCE::sce_scripting  Static hybrid AOT with JSEngine (QuickJS/Lua for <cond>/<expr>).
#   SCE::sce_runtime    Full interpreter. Parser + StateMachine + HTTP (optional).
#
# Typical mappings:
#   - Generated `sce_add_state_machine()` with needs_script_engine=false → sce_base
#   - Generated `sce_add_state_machine()` with needs_script_engine=true  → sce_scripting
#   - Dynamic SCXML loading at runtime                                    → sce_runtime
#
# ─── Provided CMake functions ──────────────────────────────────────────────
#   sce_add_state_machine()            — Generate SM header from one SCXML
#   sce_add_state_machines_from_dir()  — Generate from every SCXML in a dir
#   sce_create_state_machine_library() — Standalone reusable SM library
#
# ─── Finding SCE ───────────────────────────────────────────────────────────
#   Install-tree (recommended):
#       cmake --install <sce-build>
#       find_package(SCE REQUIRED)
#   Build-tree (no install step):
#       find_package(SCE REQUIRED PATHS /path/to/sce/build NO_DEFAULT_PATH)
#
# Both trees generate their own SCEConfig.cmake with paths resolved correctly
# for that tree. Consumers select the tier explicitly at link time:
#
#   find_package(SCE REQUIRED)
#   add_executable(my_app main.cpp)
#   sce_add_state_machine(TARGET my_app SCXML_FILE state.scxml)
#   target_link_libraries(my_app PRIVATE SCE::sce_base)  # pick one tier
#
# ─── COMPONENTS (tier gating) ──────────────────────────────────────────────
# Pure static AOT consumers can opt out of loading the scripting / runtime
# tiers to avoid their transitive find_dependency chain (httplib, OpenSSL,
# ZLIB, Brotli, ...). Valid components, with nested inclusion:
#
#   base      → sce_core + sce_base
#   scripting → base + sce_scripting (+ qjs / lua54)
#   runtime   → scripting + sce_runtime (+ httplib when SCE_ENABLE_HTTP)
#
# Examples:
#   find_package(SCE REQUIRED COMPONENTS base)        # minimal pure-static
#   find_package(SCE REQUIRED COMPONENTS scripting)   # hybrid AOT
#   find_package(SCE REQUIRED COMPONENTS runtime)     # full interpreter
#   find_package(SCE REQUIRED)                        # all tiers (default)
#
# No COMPONENTS clause keeps the historical eager-load behaviour so existing
# consumers remain unchanged.

include(CMakeFindDependencyMacro)

# Thread support is pulled in by all tiers (sce_core onward).
find_dependency(Threads)

# Paths resolved by configure_package_config_file (differ between trees).
set_and_check(SCE_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(SCE_CODEGEN_DIR "@PACKAGE_CODEGEN_INSTALL_DIR@")
# sce-codegen binary directory — plain set() (not set_and_check): the path
# may not exist in a build tree if `cargo build --bin sce-codegen` hasn't
# been run. SCECodegen.cmake FATAL_ERRORs if the binary is actually needed.
set(SCE_CODEGEN_BIN_DIR "@PACKAGE_CODEGEN_BIN_DIR@")

# Locate sce-codegen: explicit bin dir first, then system PATH.
find_program(SCE_CODEGEN sce-codegen
    PATHS "${SCE_CODEGEN_BIN_DIR}"
    NO_DEFAULT_PATH
)
if(NOT SCE_CODEGEN)
    find_program(SCE_CODEGEN sce-codegen)
endif()

# Template dir for sce-codegen (passed via env to add_custom_command).
set(SCE_TEMPLATE_DIR "${SCE_CODEGEN_DIR}/templates")

# ─── Tier target loading (ordered by dependency) ──────────────────────────
# Each tier has its own Targets file; missing tiers (e.g. Scripting disabled
# at SCE configure time) are simply skipped, leaving only lower tiers usable.
#
# COMPONENTS gating: SCE_FIND_COMPONENTS is populated by find_package() when
# the caller passes COMPONENTS. With no COMPONENTS clause we load all tiers
# (back-compat). Otherwise we load only the requested tiers plus their lower
# dependencies. Unknown components leave their SCE_<comp>_FOUND unset, which
# check_required_components() flags when the component was REQUIRED.
if(SCE_FIND_COMPONENTS)
    set(_sce_load_base     FALSE)
    set(_sce_load_scripting FALSE)
    set(_sce_load_runtime  FALSE)
    foreach(_sce_comp IN LISTS SCE_FIND_COMPONENTS)
        if(_sce_comp STREQUAL "base")
            set(_sce_load_base TRUE)
        elseif(_sce_comp STREQUAL "scripting")
            set(_sce_load_base TRUE)
            set(_sce_load_scripting TRUE)
        elseif(_sce_comp STREQUAL "runtime")
            set(_sce_load_base TRUE)
            set(_sce_load_scripting TRUE)
            set(_sce_load_runtime TRUE)
        endif()
    endforeach()
    unset(_sce_comp)
else()
    set(_sce_load_base     TRUE)
    set(_sce_load_scripting TRUE)
    set(_sce_load_runtime  TRUE)
endif()

# Core tier (sce_core + sce_base) — required foundation for every higher tier.
if(_sce_load_base)
    include("${CMAKE_CURRENT_LIST_DIR}/SCE_CoreTargets.cmake")
    set(SCE_base_FOUND TRUE)
endif()

# Scripting tier — loaded if installed. Includes qjs / lua54 as members.
if(_sce_load_scripting)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/SCE_ScriptingTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/SCE_ScriptingTargets.cmake")
        set(SCE_scripting_FOUND TRUE)
    else()
        set(SCE_scripting_FOUND FALSE)
    endif()
endif()

# Runtime tier. sce_runtime PUBLIC-links httplib::httplib when SCE_ENABLE_HTTP
# was on at SCE configure time; resolve that dependency right here, scoped to
# Runtime so pure-static (sce_base) consumers never trigger httplib lookups.
set(SCE_ENABLE_HTTP @SCE_ENABLE_HTTP@)
if(_sce_load_runtime)
    if(SCE_ENABLE_HTTP)
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/httplibTargets.cmake")
            # Build-tree branch. cpp-httplib's own build-tree Config is unusable
            # here (same PACKAGE_PREFIX_DIR bug SCE just fixed), so we replay
            # httplib's find_dependency chain ourselves based on which transitive
            # deps were actually detected at SCE configure time.
            set(_sce_httplib_find_modules_dir "@SCE_HTTPLIB_FIND_MODULES_DIR@")
            if(_sce_httplib_find_modules_dir)
                list(APPEND CMAKE_MODULE_PATH "${_sce_httplib_find_modules_dir}")
            endif()
            if(@SCE_HTTPLIB_NEEDS_OPENSSL@)
                find_dependency(OpenSSL)
            endif()
            if(@SCE_HTTPLIB_NEEDS_ZLIB@)
                find_dependency(ZLIB)
            endif()
            if(@SCE_HTTPLIB_NEEDS_BROTLI@)
                find_dependency(Brotli COMPONENTS common encoder decoder)
            endif()
            if(@SCE_HTTPLIB_NEEDS_ZSTD@)
                find_dependency(zstd)
            endif()
            if(_sce_httplib_find_modules_dir)
                list(REMOVE_ITEM CMAKE_MODULE_PATH "${_sce_httplib_find_modules_dir}")
            endif()
            unset(_sce_httplib_find_modules_dir)
            include("${CMAKE_CURRENT_LIST_DIR}/httplibTargets.cmake")
        else()
            # Install-tree branch: httplib's own installed Config handles the chain.
            find_dependency(httplib)
        endif()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/SCE_RuntimeTargets.cmake")
    set(SCE_runtime_FOUND TRUE)
endif()

# Include code generation utilities.
include("${CMAKE_CURRENT_LIST_DIR}/SCECodegen.cmake")

# Verify required components.
check_required_components(SCE)

# Version information (kept as convenience — consumers sometimes probe this).
set(SCE_VERSION       @PROJECT_VERSION@)
set(SCE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(SCE_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(SCE_VERSION_PATCH @PROJECT_VERSION_PATCH@)

# Note: SCE intentionally does NOT set SCE_LIBRARIES / SCE_INCLUDE_DIRS /
# SCE_FOUND variables. Those legacy Module-mode convenience aliases hide
# the tier decision; consumers must select SCE::sce_core / sce_base /
# sce_scripting / sce_runtime explicitly per ARCHITECTURE.md §4-Tier.

message(STATUS "Found SCE: ${SCE_VERSION} (${CMAKE_CURRENT_LIST_DIR})")
