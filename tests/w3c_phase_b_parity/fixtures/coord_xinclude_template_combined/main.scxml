<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase X D2 coordinate-parity fixture: coord_xinclude_template_combined.

  Chains both preprocessor stages: this file `<xi:include>`s
  `frag.xml`, and `frag.xml` contains a `<sce:use template="t.scxml"/>`
  whose template body itself contains a nested
  `<sce:use template="ghost.scxml"/>`. The nested `<sce:use>` trips
  `xml/template-not-found` / `SCE::parsing::TemplateNotFound`.

  Both producers must:
    - Emit DiagnosticCode `xml/template-not-found` (Rust NDJSON)
      / throw `SCE::parsing::TemplateNotFound` (C++).
    - Pin the diagnostic's `location.{file, line, col}` at the
      *outer* `<sce:use>` callsite in `frag.xml` — depth-1
      collapse (RFC §6.3 Q3) attributes every nested-template
      failure to the outer call site the operator can see, NOT
      to the leaf template file `t.scxml` and NOT to this host.

  The fixture pins the FULL composition chain through both
  preprocessor stages and the depth-1 collapse rule together:
    1. xinclude_map maps fragment-region bytes to frag.xml.
    2. substitution.positions maps template-body bytes to t.scxml.
    3. Inner expandImpl resolves the ghost.scxml `<sce:use>` byte
       to its t.scxml origin via `inputMap.lookup`.
    4. Outer recursive-expandImpl catch RE-STAMPS to the outer
       caller's useLocation (the `<sce:use>` in frag.xml) per
       depth-1 collapse — mirrors Rust's
       `.map_err(|(err, _)| (remap_nested(err, ...), loc))`.

  See claudedocs/rfc-sce-template-phase-x.md §3 D2 and the §6.3 Q3
  depth-1 rule that takes precedence on file attribution.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:xi="http://www.w3.org/2001/XInclude"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="s1"
       name="coord_xinclude_template_combined">
  <state id="s1">
    <xi:include href="frag.xml"/>
  </state>
</scxml>
