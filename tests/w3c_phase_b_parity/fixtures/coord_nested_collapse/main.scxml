<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase C P3 coordinate-parity fixture: coord_nested_collapse.

  Success-path companion to the two error-path P3 fixtures. The
  caller's `<sce:use>` binds a parameter value (chosen below as a
  short sentinel whose literal bytes appear nowhere else in this
  fixture). The template splices it into a `<state id="s_{.}"/>`
  body. After expansion, the byte inside the substituted value
  must resolve via `PositionMap::lookup` back to the caller's
  `<sce:use>` element in this file — the depth-1 collapse rule
  (RFC §6.3 Q3 in rfc-sce-template-phase-c.md).

  Unlike the two error-path fixtures, this one has no Rust NDJSON
  counterpart: `sce-codegen` JSON mode is error-only, so
  coordinate-map lookups on the success path are a C++-unit-only
  fact. The harness's `runCoordinateLookupFixture` driver exercises
  `SCE::parsing::expandString` directly to keep the assertion
  pointed at the PositionMap primitive rather than at the reparse
  boundary inside `PugiXMLDocument::processSceTemplate`.

  See claudedocs/rfc-sce-template-phase-c.md §3 P3 deliverable #1
  third bullet.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="s1"
       name="coord_nested_collapse">
  <state id="s1">
    <sce:use template="inner.scxml" id="ZQ42"/>
  </state>
</scxml>
