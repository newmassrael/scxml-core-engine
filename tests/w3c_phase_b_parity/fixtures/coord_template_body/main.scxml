<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase C P3 coordinate-parity fixture: coord_template_body.

  The referenced `t.scxml` carries an ill-formed `<sce:param>`
  declaration (`required="maybe"`) — the Malformed classification
  surface per `TemplateError::Malformed` doc-comment (case (c),
  ill-formed `<sce:param>` declaration). Both producers must:
    - Emit DiagnosticCode `xml/template-malformed` (Rust NDJSON)
      / throw `SCE::parsing::TemplateMalformed` (C++).
    - Pin the diagnostic's `location.{file, line, col}` at the
      caller's `<sce:use>` element in this file — NOT at the
      offending row inside `t.scxml`.

  The caller-site collapse reflects the current P2 throw-site
  stamping: `substituteIntoTemplateWithMap` raises without a
  location, and the `<sce:use>` caller catches-and-stamps via
  `setLocation(useLocation)`. The Rust side mirrors this via
  `.map_err(|e| (e, loc))?` on the template substitution call.
  A future milestone that wants to point at the template-body
  row directly (rather than at the caller) would need to thread
  a PositionMap through `substituteIntoTemplateWithMap` on both
  sides; Phase C explicitly scopes to depth-1 collapse per
  RFC §6.3 Q3, and P3 validates the actually-implemented shape,
  not a speculative deeper-pointing one.

  See claudedocs/rfc-sce-template-phase-c.md §3 P3.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="s1"
       name="coord_template_body">
  <state id="s1">
    <sce:use template="t.scxml"/>
  </state>
</scxml>
