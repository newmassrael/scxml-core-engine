<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase B M4 error-path parity fixture: missing_attribute.

  `<sce:use/>` omits the required `template` attribute entirely.
  Both producers must FAIL with equivalent classifications:
    - Rust emits DiagnosticCode `xml/template-missing-attribute`
      on stderr, carrying a deterministic `add_attribute` fix so
      repair agents can insert the attribute without reading
      call-site context.
    - C++ throws `SCE::parsing::TemplateMissingAttribute`.

  Missing vs empty string is classified the same way here — an
  empty `template=""` never resolves against any base directory,
  so the Rust side collapses both shapes into the same
  DiagnosticCode and the C++ side follows suit. Mirror for the
  equivalent empty-string case is covered by the Rust unit tests
  in `template.rs::tests`.

  See claudedocs/rfc-sce-template-phase-b.md §3 M4.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="s1"
       name="missing_attribute">
  <state id="s1">
    <sce:use/>
  </state>
</scxml>
