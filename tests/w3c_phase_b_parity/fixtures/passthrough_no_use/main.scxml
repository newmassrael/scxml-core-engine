<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase B parity fixture: passthrough_no_use.

  The document contains no `<sce:use>` element, so both producers
  (Rust `sce-codegen expand` and C++ `processXInclude` +
  `processSceTemplate`) short-circuit to the identity pass-through
  path. The harness asserts their canonicalised outputs are
  byte-identical, proving the harness plumbing itself works.

  See claudedocs/rfc-sce-template-phase-b.md §3.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="idle">
  <state id="idle">
    <transition event="go" target="running"/>
  </state>
  <state id="running">
    <transition event="stop" target="idle"/>
  </state>
</scxml>
