<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase B M5 parity template: greeter.

  One defaulted parameter `proto` substituted into the `target`
  attribute of a single body transition. No call-site binding is
  required; omitting `proto` at the `<sce:use>` picks up the
  default value `TCP` via the splice path.
-->
<sce:template xmlns:sce="http://sce.dev/ext" name="greeter">
  <sce:param name="proto" default="TCP"/>
  <transition event="connect" target="done" cond="_event.data.proto == '{$proto}'"/>
</sce:template>
