<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase B M3 parity template: outer.

  One required `port` parameter. Body contains a nested
  `<sce:use template="inner.scxml" endpoint="..."/>` — the outer
  `{$port}` is substituted into the nested `<sce:use>`'s
  `endpoint` attribute before the recursive expansion loads
  `inner.scxml`, proving substitution-before-recursion order.
-->
<sce:template xmlns:sce="http://sce.dev/ext" name="outer">
  <sce:param name="port" required="true"/>
  <sce:use template="inner.scxml" endpoint="host:{$port}"/>
</sce:template>
