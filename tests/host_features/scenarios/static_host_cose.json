      "event": "host.cose.sign1.request",
      "data": {"key_id": "11", "payload": "This is the content.", "external_aad": ""},
      "expect": { "state": "idle",
                  "variables": {"outcome": "done", "signed_object": "Ò\u0084G¢\u0001'\u0004B11 TThis is the content.X@\u000e!ö\u0082ZAýå{þ\u0097\u001a\u009a\u0081z\u0083\u001e\u0007\u009f2\u0011\u0082\u0089\u0010}\u0083v qÐÜ´\u0014\u0089øtDgîU_b\u000e\u0003©\rT\u0084XÙ5¥´Í8\u0092>\u008eÚ\u0016î,\u0011\u0001"},
                  "host_invokes": [{"type": "sce-host-cose-sign1", "id": "sign", "request": {"key_id": "11", "payload": "This is the content.", "external_aad": ""}}] } },

    { "note": "the object verifies under a trust set that holds its signer: the signer and the payload come back",
