    { "note": "a name revoked already has nothing more to revoke",
      "event": "host.credential.revoke.request",
      "data": {"name": "phone"},
      "expect": { "state": "idle",
                  "variables": {"outcome": "done", "revoked": 0} } },

    { "note": "an empty name is refused: error.execution, and nothing is issued",
      "event": "host.credential.issue.request",
      "data": {"name": "", "ttl_s": 60},
      "expect": { "state": "idle",
                  "variables": {"outcome": "refused", "revoked": 0},
                  "host_invokes": [{"type": "sce-host-credential-issue", "id": "credential_issue", "request": {"name": "", "ttl_s": 60}}] } },

    { "note": "a token that would expire as it is issued is refused: ttl_s is at least 1",
      "event": "host.credential.issue.request",
      "data": {"name": "phone", "ttl_s": 0},
      "expect": { "state": "idle",
                  "variables": {"outcome": "refused"} } },

    { "note": "an empty name is refused a revocation too",
      "event": "host.credential.revoke.request",
      "data": {"name": ""},
      "expect": { "state": "idle",
                  "variables": {"outcome": "refused", "revoked": 0} } },

    { "note": "an issue that fails unavailable issues nothing",
      "host": {"fail": {"sce-host-credential-issue": "unavailable"}},
      "event": "host.credential.issue.request",
      "data": {"name": "laptop", "ttl_s": 60},
      "expect": { "state": "idle",
                  "variables": {"outcome": "unavailable"},
                  "host_state": {"credentials": {"phone": [{"issued_ms": 1700000000000, "expires_ms": 1700003600000, "revoked": true}],
                                                 "tablet": [{"issued_ms": 1700000060000, "expires_ms": 1700000120000, "revoked": false}]}} } },

    { "note": "a revocation that fails unavailable revokes nothing",
      "host": {"fail": {"sce-host-credential-revoke": "unavailable"}},
      "event": "host.credential.revoke.request",
      "data": {"name": "tablet"},
      "expect": { "state": "idle",
                  "variables": {"outcome": "unavailable", "revoked": 0},
                  "host_state": {"credentials": {"phone": [{"issued_ms": 1700000000000, "expires_ms": 1700003600000, "revoked": true}],
                                                 "tablet": [{"issued_ms": 1700000060000, "expires_ms": 1700000120000, "revoked": false}]}} } },

    { "note": "an attempt is appended to a stream the host keeps: the account written as its keyed digest under the pseudonymisation key (the first 32 random bytes), the password never, the entry in its canonical form; the answer is its sequence (docs/adr/0109, D14)",
      "host": {"fail": {}, "clock": {"utc_ms": 1767225600000},
               "audit": {"streams": {"sign-ins": {"checkpoint_every": 2, "retain_days": 30}}},
               "random": "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f"},
      "event": "audit.sign_in",
      "data": {"account": "alice@example.org", "password": "hunter2", "result": "accepted", "attempt": 1},
      "expect": { "state": "idle",
                  "variables": {"outcome": "done", "audit_sequence": "1"},
                  "host_state": {"audit": {"sign-ins": {"rows": [{"sequence": 1, "at_ms": 1767225600000, "entry": "{\"account\":\"sce-personal:4da32f6e1bdd3ce977a6d49f84aab95d799270b8233a873ae65b13c112571684\",\"attempt\":1,\"password\":\"sce-secret\",\"result\":\"accepted\"}"}],
                                                        "checkpoints": [], "verified": true}}} } },

    { "note": "the second entry is chained on the first and checkpointed under the audit key (the next 32 random bytes), every two rows; the stream verifies from its first row",
      "host": {"clock": {"utc_ms": 1767225601000}},
      "event": "audit.sign_in",
      "data": {"account": "bob@example.org", "password": "letmein", "result": "refused", "attempt": 1},
      "expect": { "state": "idle",
                  "variables": {"outcome": "done", "audit_sequence": "2"},
                  "host_state": {"audit": {"sign-ins": {"rows": [{"sequence": 1, "at_ms": 1767225600000, "entry": "{\"account\":\"sce-personal:4da32f6e1bdd3ce977a6d49f84aab95d799270b8233a873ae65b13c112571684\",\"attempt\":1,\"password\":\"sce-secret\",\"result\":\"accepted\"}"},
                                                                 {"sequence": 2, "at_ms": 1767225601000, "entry": "{\"account\":\"sce-personal:7c6bfba3407b0b9e957a5f868583418981d34d78f453d01d6e928edc50fb0935\",\"attempt\":1,\"password\":\"sce-secret\",\"result\":\"refused\"}"}],
                                                        "checkpoints": [2], "verified": true}}} } },

    { "note": "an append to a stream the host keeps no policy for fails unknown_stream, and appends nothing",
      "host": {"audit": {"streams": {}}},
      "event": "audit.sign_in",
      "data": {"account": "alice@example.org", "password": "hunter2", "result": "accepted", "attempt": 2},
      "expect": { "state": "idle",
                  "variables": {"outcome": "unknown_stream", "audit_sequence": "2"},
                  "host_state": {"audit": {"sign-ins": {"rows": [{"sequence": 1, "at_ms": 1767225600000, "entry": "{\"account\":\"sce-personal:4da32f6e1bdd3ce977a6d49f84aab95d799270b8233a873ae65b13c112571684\",\"attempt\":1,\"password\":\"sce-secret\",\"result\":\"accepted\"}"},
                                                                 {"sequence": 2, "at_ms": 1767225601000, "entry": "{\"account\":\"sce-personal:7c6bfba3407b0b9e957a5f868583418981d34d78f453d01d6e928edc50fb0935\",\"attempt\":1,\"password\":\"sce-secret\",\"result\":\"refused\"}"}],
                                                        "checkpoints": [2], "verified": true}}} } },

    { "note": "an append that fails unavailable appends nothing",
      "host": {"audit": {"streams": {"sign-ins": {"checkpoint_every": 2, "retain_days": 30}}}, "fail": {"sce-host-audit-append": "unavailable"}},
      "event": "audit.sign_in",
      "data": {"account": "alice@example.org", "password": "hunter2", "result": "accepted", "attempt": 2},
      "expect": { "state": "idle",
                  "variables": {"outcome": "unavailable", "audit_sequence": "2"} } },

    { "note": "a stream that keeps personal values in the clear writes the account as it is, and still never the password",
      "host": {"fail": {}, "clock": {"utc_ms": 1767225602000},
               "audit": {"streams": {"sign-ins": {"checkpoint_every": 2, "retain_days": 30, "personal": "clear"}}}},
      "event": "audit.sign_in",
      "data": {"account": "alice@example.org", "password": "hunter2", "result": "accepted", "attempt": 2},
      "expect": { "state": "idle",
                  "variables": {"outcome": "done", "audit_sequence": "3"},
                  "host_state": {"audit": {"sign-ins": {"rows": [{"sequence": 1, "at_ms": 1767225600000, "entry": "{\"account\":\"sce-personal:4da32f6e1bdd3ce977a6d49f84aab95d799270b8233a873ae65b13c112571684\",\"attempt\":1,\"password\":\"sce-secret\",\"result\":\"accepted\"}"},
                                                                 {"sequence": 2, "at_ms": 1767225601000, "entry": "{\"account\":\"sce-personal:7c6bfba3407b0b9e957a5f868583418981d34d78f453d01d6e928edc50fb0935\",\"attempt\":1,\"password\":\"sce-secret\",\"result\":\"refused\"}"},
                                                                 {"sequence": 3, "at_ms": 1767225602000, "entry": "{\"account\":\"alice@example.org\",\"attempt\":2,\"password\":\"sce-secret\",\"result\":\"accepted\"}"}],
                                                        "checkpoints": [2], "verified": true}}} } }
  ]
