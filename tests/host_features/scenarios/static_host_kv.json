{
  "machine": "static_host_kv",
  "about": "The key-value store of docs/SCE_HOST_FEATURES.md, section 3, as a machine sees it through its host. Each step sends the request record the machine turns into an operation, and states what the machine published, what the host was started with, and what the host holds afterwards. Expected values are derived from the specification, not observed from a host.",
  "steps": [
    { "note": "started: nothing has been asked",
      "expect": { "state": "idle", "variables": { "outcome": "", "found": false, "got": "" }, "host_invokes": [], "host_state": { "store": {} } } },

    { "note": "get of a key nothing was written under: found is false, the value is empty and the version is 0, and that is a completion",
      "event": "host.kv.get.request", "data": { "key": "a" },
      "expect": { "state": "idle", "variables": { "outcome": "done", "found": false, "got": "", "got_version": "0" },
                  "host_invokes": [ { "type": "sce-host-kv-get", "id": "get", "request": { "key": "a" } } ],
                  "host_state": { "store": {} } } },

    { "note": "a first put does not replace",
      "event": "host.kv.put.request", "data": { "key": "a", "value": "1" },
      "expect": { "variables": { "outcome": "done", "replaced": false },
                  "host_invokes": [ { "type": "sce-host-kv-put", "id": "put", "request": { "key": "a", "value": "1" } } ],
                  "host_state": { "store": { "a": "1" } } } },

    { "note": "a second put replaces, and the store holds the new text",
      "event": "host.kv.put.request", "data": { "key": "a", "value": "2" },
      "expect": { "variables": { "outcome": "done", "replaced": true }, "host_state": { "store": { "a": "2" } } } },

    { "note": "a get started after the put completed sees it, at the version the second write of the store gave it (section 8: one counter of the store)",
      "event": "host.kv.get.request", "data": { "key": "a" },
      "expect": { "variables": { "outcome": "done", "found": true, "got": "2", "got_version": "2" } } },

    { "note": "an empty text is a value: put it under b",
      "event": "host.kv.put.request", "data": { "key": "b", "value": "" },
      "expect": { "variables": { "replaced": false }, "host_state": { "store": { "a": "2", "b": "" } } } },

    { "note": "and a get of it is found, with an empty text where the last answer was 2, at the third write's version",
      "event": "host.kv.get.request", "data": { "key": "b" },
      "expect": { "variables": { "outcome": "done", "found": true, "got": "", "got_version": "3" } } },

    { "note": "a key that differs only in its case is another key",
      "event": "host.kv.get.request", "data": { "key": "A" },
      "expect": { "variables": { "outcome": "done", "found": false, "got": "", "got_version": "0" } } },

    { "note": "two more keys, for the walk: ab and c",
      "event": "host.kv.put.request", "data": { "key": "ab", "value": "x" },
      "expect": { "variables": { "replaced": false } } },
    { "note": "c",
      "event": "host.kv.put.request", "data": { "key": "c", "value": "y" },
      "expect": { "variables": { "replaced": false }, "host_state": { "store": { "a": "2", "ab": "x", "b": "", "c": "y" } } } },

    { "note": "the walk starts at the least key when `after` is empty",
      "event": "host.kv.next_key.request", "data": { "after": "", "prefix": "" },
      "expect": { "variables": { "outcome": "done", "next_found": true, "next": "a" },
                  "host_invokes": [ { "type": "sce-host-kv-next-key", "id": "walk", "request": { "after": "", "prefix": "" } } ] } },
    { "note": "after a, excluded, in the order of the keys' UTF-8 bytes: ab before b",
      "event": "host.kv.next_key.request", "data": { "after": "a", "prefix": "" },
      "expect": { "variables": { "next_found": true, "next": "ab" } } },
    { "note": "after ab",
      "event": "host.kv.next_key.request", "data": { "after": "ab", "prefix": "" },
      "expect": { "variables": { "next_found": true, "next": "b" } } },
    { "note": "after b",
      "event": "host.kv.next_key.request", "data": { "after": "b", "prefix": "" },
      "expect": { "variables": { "next_found": true, "next": "c" } } },
    { "note": "after the last key nothing follows, and `next` is empty",
      "event": "host.kv.next_key.request", "data": { "after": "c", "prefix": "" },
      "expect": { "variables": { "outcome": "done", "next_found": false, "next": "" } } },
    { "note": "a prefix keeps the keys that begin with it, starting from the least",
      "event": "host.kv.next_key.request", "data": { "after": "", "prefix": "a" },
      "expect": { "variables": { "next_found": true, "next": "a" } } },
    { "note": "and past ab, with the prefix a, nothing follows",
      "event": "host.kv.next_key.request", "data": { "after": "ab", "prefix": "a" },
      "expect": { "variables": { "next_found": false, "next": "" } } },

    { "note": "a quota of four keys: a new key is refused as quota_exceeded and the store is unchanged",
      "host": { "quota": 4 },
      "event": "host.kv.put.request", "data": { "key": "d", "value": "z" },
      "expect": { "variables": { "outcome": "quota_exceeded", "replaced": false },
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "", "c": "y" } } } },
    { "note": "a put that replaces adds no key, so the quota does not stop it",
      "event": "host.kv.put.request", "data": { "key": "c", "value": "w" },
      "expect": { "variables": { "outcome": "done", "replaced": true },
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "", "c": "w" } } } },

    { "note": "delete answers that the key existed",
      "event": "host.kv.delete.request", "data": { "key": "c" },
      "expect": { "variables": { "outcome": "done", "existed": true },
                  "host_invokes": [ { "type": "sce-host-kv-delete", "id": "del", "request": { "key": "c" } } ],
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "" } } } },
    { "note": "and a second delete of it is not a failure: existed is false",
      "event": "host.kv.delete.request", "data": { "key": "c" },
      "expect": { "variables": { "outcome": "done", "existed": false } } },
    { "note": "a get of it is not found, and a removed key is at version 0",
      "event": "host.kv.get.request", "data": { "key": "c" },
      "expect": { "variables": { "found": false, "got": "", "got_version": "0" } } },

    { "note": "the store cannot be reached: the get fails unavailable, and what the last get left is as it was",
      "event": "host.kv.get.request", "data": { "key": "a" },
      "expect": { "variables": { "found": true, "got": "2", "got_version": "2" } } },
    { "note": "failing the get",
      "host": { "fail": { "sce-host-kv-get": "unavailable" } },
      "event": "host.kv.get.request", "data": { "key": "b" },
      "expect": { "state": "idle", "variables": { "outcome": "unavailable", "found": true, "got": "2", "got_version": "2" } } },
    { "note": "a failed write changes nothing",
      "host": { "fail": { "sce-host-kv-put": "unavailable" } },
      "event": "host.kv.put.request", "data": { "key": "e", "value": "q" },
      "expect": { "variables": { "outcome": "unavailable" },
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "" } } } },

    { "note": "a key that is empty is refused, not started and not failed",
      "host": { "fail": {} },
      "event": "host.kv.get.request", "data": { "key": "" },
      "expect": { "state": "idle", "variables": { "outcome": "refused", "found": true, "got": "2" },
                  "host_invokes": [ { "type": "sce-host-kv-get", "id": "get", "request": { "key": "" } } ] } },

    { "note": "put-if with version 0 on a key that is absent writes it: seven numbers were taken (six writes and the delete that removed c; the failures, the refusal and the delete of an absent key take none), so it is at 8",
      "event": "host.kv.put_if.request", "data": { "key": "d", "value": "p", "expected_version": "0" },
      "expect": { "state": "idle", "variables": { "outcome": "done", "written": true, "put_version": "8" },
                  "host_invokes": [ { "type": "sce-host-kv-put-if", "id": "putif", "request": { "key": "d", "value": "p", "expected_version": "0" } } ],
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "", "d": "p" } } } },
    { "note": "a get answers the version the put-if gave",
      "event": "host.kv.get.request", "data": { "key": "d" },
      "expect": { "variables": { "outcome": "done", "found": true, "got": "p", "got_version": "8" } } },
    { "note": "put-if with version 0 on a key that is there is a lost race: nothing is written, the answer is the key's version, and that is a completion",
      "event": "host.kv.put_if.request", "data": { "key": "d", "value": "q", "expected_version": "0" },
      "expect": { "variables": { "outcome": "done", "written": false, "put_version": "8" },
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "", "d": "p" } } } },
    { "note": "a stale version does not write: a is at 2, not at the 1 its first put gave",
      "event": "host.kv.put_if.request", "data": { "key": "a", "value": "3", "expected_version": "1" },
      "expect": { "variables": { "outcome": "done", "written": false, "put_version": "2" },
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "", "d": "p" } } } },
    { "note": "the version a read answered writes, and the key is given the store's next number",
      "event": "host.kv.put_if.request", "data": { "key": "a", "value": "3", "expected_version": "2" },
      "expect": { "variables": { "outcome": "done", "written": true, "put_version": "9" },
                  "host_state": { "store": { "a": "3", "ab": "x", "b": "", "d": "p" } } } },
    { "note": "the expected version is compared as a number: leading zeros do not count",
      "event": "host.kv.put_if.request", "data": { "key": "a", "value": "4", "expected_version": "0009" },
      "expect": { "variables": { "outcome": "done", "written": true, "put_version": "10" },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "", "d": "p" } } } },
    { "note": "digits past 2^64 - 1 are accepted and name no version, so nothing is written",
      "event": "host.kv.put_if.request", "data": { "key": "a", "value": "5", "expected_version": "99999999999999999999" },
      "expect": { "variables": { "outcome": "done", "written": false, "put_version": "10" },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "", "d": "p" } } } },
    { "note": "the quota of four keys holds a put-if that would add a fifth: it fails quota_exceeded, and what the last answer left is as it was",
      "event": "host.kv.put_if.request", "data": { "key": "e", "value": "z", "expected_version": "0" },
      "expect": { "variables": { "outcome": "quota_exceeded", "written": false, "put_version": "10" },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "", "d": "p" } } } },
    { "note": "a put-if whose version does not match writes nothing, so the quota does not judge it",
      "event": "host.kv.put_if.request", "data": { "key": "e", "value": "z", "expected_version": "3" },
      "expect": { "variables": { "outcome": "done", "written": false, "put_version": "0" },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "", "d": "p" } } } },
    { "note": "delete d, which takes the number 11",
      "event": "host.kv.delete.request", "data": { "key": "d" },
      "expect": { "variables": { "outcome": "done", "existed": true },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "" } } } },
    { "note": "a removed key is at version 0",
      "event": "host.kv.get.request", "data": { "key": "d" },
      "expect": { "variables": { "outcome": "done", "found": false, "got": "", "got_version": "0" } } },
    { "note": "after the delete, the version d had before it does not write",
      "event": "host.kv.put_if.request", "data": { "key": "d", "value": "r", "expected_version": "8" },
      "expect": { "variables": { "outcome": "done", "written": false, "put_version": "0" },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "" } } } },
    { "note": "version 0 writes it again, at a version past both the one it had and the delete's",
      "event": "host.kv.put_if.request", "data": { "key": "d", "value": "r", "expected_version": "0" },
      "expect": { "variables": { "outcome": "done", "written": true, "put_version": "12" },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "", "d": "r" } } } },
    { "note": "a put gives a new version too",
      "event": "host.kv.put.request", "data": { "key": "d", "value": "s" },
      "expect": { "variables": { "outcome": "done", "replaced": true },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "", "d": "s" } } } },
    { "note": "and a get answers it",
      "event": "host.kv.get.request", "data": { "key": "d" },
      "expect": { "variables": { "outcome": "done", "found": true, "got": "s", "got_version": "13" } } },
    { "note": "a put-if that fails writes nothing, whatever its version",
      "host": { "fail": { "sce-host-kv-put-if": "unavailable" } },
      "event": "host.kv.put_if.request", "data": { "key": "d", "value": "t", "expected_version": "13" },
      "expect": { "variables": { "outcome": "unavailable", "written": true, "put_version": "12" },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "", "d": "s" } } } },
    { "note": "a put-if with an empty key is refused",
      "host": { "fail": {} },
      "event": "host.kv.put_if.request", "data": { "key": "", "value": "u", "expected_version": "0" },
      "expect": { "state": "idle", "variables": { "outcome": "refused" },
                  "host_invokes": [ { "type": "sce-host-kv-put-if", "id": "putif", "request": { "key": "", "value": "u", "expected_version": "0" } } ] } },
    { "note": "an empty expected version is not digits, and is refused",
      "event": "host.kv.put_if.request", "data": { "key": "d", "value": "u", "expected_version": "" },
      "expect": { "variables": { "outcome": "refused" } } },
    { "note": "neither is one that holds a letter",
      "event": "host.kv.put_if.request", "data": { "key": "d", "value": "u", "expected_version": "1a" },
      "expect": { "variables": { "outcome": "refused" } } },
    { "note": "nor one with a sign",
      "event": "host.kv.put_if.request", "data": { "key": "d", "value": "u", "expected_version": "-1" },
      "expect": { "variables": { "outcome": "refused" },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "", "d": "s" } } } },
    { "note": "the failure and the refusals took no number: the next write is at 14",
      "event": "host.kv.put_if.request", "data": { "key": "d", "value": "u", "expected_version": "13" },
      "expect": { "variables": { "outcome": "done", "written": true, "put_version": "14" },
                  "host_state": { "store": { "a": "4", "ab": "x", "b": "", "d": "u" } } } }
  ]
}
