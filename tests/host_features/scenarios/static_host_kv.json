{
  "machine": "static_host_kv",
  "about": "The key-value store of docs/SCE_HOST_FEATURES.md, section 3, as a machine sees it through its host. Each step sends the request record the machine turns into an operation, and states what the machine published, what the host was started with, and what the host holds afterwards. Expected values are derived from the specification, not observed from a host.",
  "steps": [
    { "note": "started: nothing has been asked",
      "expect": { "state": "idle", "variables": { "outcome": "", "found": false, "got": "" }, "host_invokes": [], "host_state": { "store": {} } } },

    { "note": "get of a key nothing was written under: found is false and the value is empty, and that is a completion",
      "event": "host.kv.get.request", "data": { "key": "a" },
      "expect": { "state": "idle", "variables": { "outcome": "done", "found": false, "got": "" },
                  "host_invokes": [ { "type": "sce-host-kv-get", "id": "get", "request": { "key": "a" } } ],
                  "host_state": { "store": {} } } },

    { "note": "a first put does not replace",
      "event": "host.kv.put.request", "data": { "key": "a", "value": "1" },
      "expect": { "variables": { "outcome": "done", "replaced": false },
                  "host_invokes": [ { "type": "sce-host-kv-put", "id": "put", "request": { "key": "a", "value": "1" } } ],
                  "host_state": { "store": { "a": "1" } } } },

    { "note": "a second put replaces, and the store holds the new text",
      "event": "host.kv.put.request", "data": { "key": "a", "value": "2" },
      "expect": { "variables": { "outcome": "done", "replaced": true }, "host_state": { "store": { "a": "2" } } } },

    { "note": "a get started after the put completed sees it",
      "event": "host.kv.get.request", "data": { "key": "a" },
      "expect": { "variables": { "outcome": "done", "found": true, "got": "2" } } },

    { "note": "an empty text is a value: put it under b",
      "event": "host.kv.put.request", "data": { "key": "b", "value": "" },
      "expect": { "variables": { "replaced": false }, "host_state": { "store": { "a": "2", "b": "" } } } },

    { "note": "and a get of it is found, with an empty text where the last answer was 2",
      "event": "host.kv.get.request", "data": { "key": "b" },
      "expect": { "variables": { "outcome": "done", "found": true, "got": "" } } },

    { "note": "a key that differs only in its case is another key",
      "event": "host.kv.get.request", "data": { "key": "A" },
      "expect": { "variables": { "outcome": "done", "found": false, "got": "" } } },

    { "note": "two more keys, for the walk: ab and c",
      "event": "host.kv.put.request", "data": { "key": "ab", "value": "x" },
      "expect": { "variables": { "replaced": false } } },
    { "note": "c",
      "event": "host.kv.put.request", "data": { "key": "c", "value": "y" },
      "expect": { "variables": { "replaced": false }, "host_state": { "store": { "a": "2", "ab": "x", "b": "", "c": "y" } } } },

    { "note": "the walk starts at the least key when `after` is empty",
      "event": "host.kv.next_key.request", "data": { "after": "", "prefix": "" },
      "expect": { "variables": { "outcome": "done", "next_found": true, "next": "a" },
                  "host_invokes": [ { "type": "sce-host-kv-next-key", "id": "walk", "request": { "after": "", "prefix": "" } } ] } },
    { "note": "after a, excluded, in the order of the keys' UTF-8 bytes: ab before b",
      "event": "host.kv.next_key.request", "data": { "after": "a", "prefix": "" },
      "expect": { "variables": { "next_found": true, "next": "ab" } } },
    { "note": "after ab",
      "event": "host.kv.next_key.request", "data": { "after": "ab", "prefix": "" },
      "expect": { "variables": { "next_found": true, "next": "b" } } },
    { "note": "after b",
      "event": "host.kv.next_key.request", "data": { "after": "b", "prefix": "" },
      "expect": { "variables": { "next_found": true, "next": "c" } } },
    { "note": "after the last key nothing follows, and `next` is empty",
      "event": "host.kv.next_key.request", "data": { "after": "c", "prefix": "" },
      "expect": { "variables": { "outcome": "done", "next_found": false, "next": "" } } },
    { "note": "a prefix keeps the keys that begin with it, starting from the least",
      "event": "host.kv.next_key.request", "data": { "after": "", "prefix": "a" },
      "expect": { "variables": { "next_found": true, "next": "a" } } },
    { "note": "and past ab, with the prefix a, nothing follows",
      "event": "host.kv.next_key.request", "data": { "after": "ab", "prefix": "a" },
      "expect": { "variables": { "next_found": false, "next": "" } } },

    { "note": "a quota of four keys: a new key is refused as quota_exceeded and the store is unchanged",
      "host": { "quota": 4 },
      "event": "host.kv.put.request", "data": { "key": "d", "value": "z" },
      "expect": { "variables": { "outcome": "quota_exceeded", "replaced": false },
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "", "c": "y" } } } },
    { "note": "a put that replaces adds no key, so the quota does not stop it",
      "event": "host.kv.put.request", "data": { "key": "c", "value": "w" },
      "expect": { "variables": { "outcome": "done", "replaced": true },
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "", "c": "w" } } } },

    { "note": "delete answers that the key existed",
      "event": "host.kv.delete.request", "data": { "key": "c" },
      "expect": { "variables": { "outcome": "done", "existed": true },
                  "host_invokes": [ { "type": "sce-host-kv-delete", "id": "del", "request": { "key": "c" } } ],
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "" } } } },
    { "note": "and a second delete of it is not a failure: existed is false",
      "event": "host.kv.delete.request", "data": { "key": "c" },
      "expect": { "variables": { "outcome": "done", "existed": false } } },
    { "note": "a get of it is not found",
      "event": "host.kv.get.request", "data": { "key": "c" },
      "expect": { "variables": { "found": false, "got": "" } } },

    { "note": "the store cannot be reached: the get fails unavailable, and what the last get left is as it was",
      "event": "host.kv.get.request", "data": { "key": "a" },
      "expect": { "variables": { "found": true, "got": "2" } } },
    { "note": "failing the get",
      "host": { "fail": { "sce-host-kv-get": "unavailable" } },
      "event": "host.kv.get.request", "data": { "key": "b" },
      "expect": { "state": "idle", "variables": { "outcome": "unavailable", "found": true, "got": "2" } } },
    { "note": "a failed write changes nothing",
      "host": { "fail": { "sce-host-kv-put": "unavailable" } },
      "event": "host.kv.put.request", "data": { "key": "e", "value": "q" },
      "expect": { "variables": { "outcome": "unavailable" },
                  "host_state": { "store": { "a": "2", "ab": "x", "b": "" } } } },

    { "note": "a key that is empty is refused, not started and not failed",
      "host": { "fail": {} },
      "event": "host.kv.get.request", "data": { "key": "" },
      "expect": { "state": "idle", "variables": { "outcome": "refused", "found": true, "got": "2" },
                  "host_invokes": [ { "type": "sce-host-kv-get", "id": "get", "request": { "key": "" } } ] } }
  ]
}
