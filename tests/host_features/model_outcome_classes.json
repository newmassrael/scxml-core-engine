{
  "about": [
    "The outcome classes of one generation, as a machine sees them (docs/adr/0087, section 9.4).",
    "",
    "A model's answer reaches a machine only through the answer schema and the host operation,",
    "so at each call the machine sees one of a finite set of classes: a record read, a refusal of",
    "each code a schema of fields reaches, an answer cut by `length`, each failure code, the",
    "refusal, a deadline that passes, and a cancel by leaving the state. The exhaustive provider",
    "of every lane's reference host stands for a model that may give any class at any call: the",
    "test names a sequence of classes, each start takes the next one, and the provider answers",
    "what the class says. Every lane runs `machine` against every sequence of classes up to",
    "`bound` and holds what the machine publishes after each call to the class's `expect`.",
    "",
    "Each class is one `end`: `answer` (a completion with `text` and `finish`, the provider",
    "unconstrained, its tokens the bytes of the prompt and of the text, `model` `exhaustive`),",
    "`failure` (a completion whose `error` is the code), `refusal` (the host declines to start",
    "it, `invalid_argument`) or `hold` (the provider does not answer; `then` says how the call",
    "ends: `advance`, the engine's clock moved `deadline_ms` on, or `leave`, the event `leave`).",
    "Each call is the event `ask.event` with `ask.data`, a request the host accepts.",
    "",
    "`expect` is what the machine publishes after the call: `outcome`, `why` and `finish`, and",
    "`answer` where the call reads a record. A call that reads none leaves `answer` as the last",
    "call that read one left it, `null` before any; `calls` is the call's number from 1, and the",
    "machine is in `idle`. The texts and their refusals are those of",
    "sce-build/tests/fixtures/static_datamodel/scenarios/static_lift.json, against the same",
    "schema. `deferred` names a refusal code no schema a lift reads now reaches, and why.",
    "Expected values are derived from the specification, not observed from a host."
  ],
  "machine": "static_host_model",
  "answer_schema": "urn:sce:schema:lift_answer:2",
  "ask": {
    "event": "host.model.generate.request",
    "data": {"prompt": "Plan my day", "answer_schema": "", "max_tokens": 64, "temperature_milli": 0}
  },
  "leave": "model.leave",
  "deadline_ms": 1000,
  "bound": 2,
  "deferred": [
    {"code": "tooMany", "why": "a list past its bound: no schema a lift reads holds a list until ADR 0086 step 3 (docs/adr/0087, section 7.1)"}
  ],
  "classes": [
    {"class": "read", "end": "answer", "finish": "stop",
     "text": "{\"amount\":-42,\"id\":7,\"kind\":\"task\",\"note\":null,\"priority\":1,\"tag\":\"ab\",\"title\":\"Plan\"}",
     "expect": {"outcome": "read", "why": null, "finish": "stop",
                "answer": {"id": 7, "amount": "-42", "title": "Plan", "kind": "task", "note": null, "tag": "ab", "priority": 1}}},
    {"class": "notJson", "end": "answer", "finish": "stop", "text": "{",
     "expect": {"outcome": "refused", "why": {"code": "notJson", "path": "", "bound": null}, "finish": "stop"}},
    {"class": "notObject", "end": "answer", "finish": "stop", "text": "[1]",
     "expect": {"outcome": "refused", "why": {"code": "notObject", "path": "", "bound": null}, "finish": "stop"}},
    {"class": "tooDeep", "end": "answer", "finish": "stop",
     "text": "{\"id\":7,\"amount\":-42,\"title\":[\"Plan\"],\"kind\":\"task\",\"note\":null,\"tag\":\"ab\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "tooDeep", "path": "/title", "bound": 1}, "finish": "stop"}},
    {"class": "missing", "end": "answer", "finish": "stop",
     "text": "{\"amount\":-42,\"title\":\"Plan\",\"kind\":\"task\",\"note\":null,\"tag\":\"ab\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "missing", "path": "/id", "bound": null}, "finish": "stop"}},
    {"class": "nullNotOptional", "end": "answer", "finish": "stop",
     "text": "{\"id\":null,\"amount\":-42,\"title\":\"Plan\",\"kind\":\"task\",\"note\":null,\"tag\":\"ab\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "nullNotOptional", "path": "/id", "bound": null}, "finish": "stop"}},
    {"class": "wrongKind", "end": "answer", "finish": "stop",
     "text": "{\"id\":\"7\",\"amount\":-42,\"title\":\"Plan\",\"kind\":\"task\",\"note\":null,\"tag\":\"ab\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "wrongKind", "path": "/id", "bound": null}, "finish": "stop"}},
    {"class": "badNumber", "end": "answer", "finish": "stop",
     "text": "{\"id\":1.5,\"amount\":-42,\"title\":\"Plan\",\"kind\":\"task\",\"note\":null,\"tag\":\"ab\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "badNumber", "path": "/id", "bound": null}, "finish": "stop"}},
    {"class": "outOfRange", "end": "answer", "finish": "stop",
     "text": "{\"id\":4294967296,\"amount\":-42,\"title\":\"Plan\",\"kind\":\"task\",\"note\":null,\"tag\":\"ab\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "outOfRange", "path": "/id", "bound": null}, "finish": "stop"}},
    {"class": "tooLong", "end": "answer", "finish": "stop",
     "text": "{\"id\":7,\"amount\":-42,\"title\":\"abcdefghijklmno\u00e9\",\"kind\":\"task\",\"note\":null,\"tag\":\"ab\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "tooLong", "path": "/title", "bound": 16}, "finish": "stop"}},
    {"class": "unknownVariant", "end": "answer", "finish": "stop",
     "text": "{\"id\":7,\"amount\":-42,\"title\":\"Plan\",\"kind\":\"call\",\"note\":null,\"tag\":\"ab\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "unknownVariant", "path": "/kind", "bound": null}, "finish": "stop"}},
    {"class": "notByteText", "end": "answer", "finish": "stop",
     "text": "{\"id\":7,\"amount\":-42,\"title\":\"Plan\",\"kind\":\"task\",\"note\":null,\"tag\":\"\\u0100\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "notByteText", "path": "/tag", "bound": null}, "finish": "stop"}},
    {"class": "nulInText", "end": "answer", "finish": "stop",
     "text": "{\"id\":7,\"amount\":-42,\"title\":\"a\\u0000b\",\"kind\":\"task\",\"note\":null,\"tag\":\"ab\",\"priority\":1}",
     "expect": {"outcome": "refused", "why": {"code": "nulInText", "path": "/title", "bound": null}, "finish": "stop"}},
    {"class": "length", "end": "answer", "finish": "length", "text": "{\"id\":7,\"amount\":",
     "expect": {"outcome": "refused", "why": {"code": "notJson", "path": "", "bound": null}, "finish": "length"}},
    {"class": "unavailable", "end": "failure", "error": "unavailable",
     "expect": {"outcome": "unavailable", "why": null, "finish": ""}},
    {"class": "busy", "end": "failure", "error": "busy",
     "expect": {"outcome": "busy", "why": null, "finish": ""}},
    {"class": "network", "end": "failure", "error": "network",
     "expect": {"outcome": "network", "why": null, "finish": ""}},
    {"class": "context_exceeded", "end": "failure", "error": "context_exceeded",
     "expect": {"outcome": "context_exceeded", "why": null, "finish": ""}},
    {"class": "answer_too_large", "end": "failure", "error": "answer_too_large",
     "expect": {"outcome": "answer_too_large", "why": null, "finish": ""}},
    {"class": "declined", "end": "failure", "error": "declined",
     "expect": {"outcome": "declined", "why": null, "finish": ""}},
    {"class": "invalid_argument", "end": "refusal",
     "expect": {"outcome": "invalid_argument", "why": null, "finish": ""}},
    {"class": "deadline", "end": "hold", "then": "advance",
     "expect": {"outcome": "deadline", "why": null, "finish": ""}},
    {"class": "cancel", "end": "hold", "then": "leave",
     "expect": {"outcome": "left", "why": null, "finish": ""}}
  ]
}
