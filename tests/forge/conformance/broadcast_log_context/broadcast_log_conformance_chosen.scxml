<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR 0062 (broadcast-log kind): a log over an element that is a variant whose tag
  the caller gives (`broadcast_log_conformance_choice`). The generator stores the
  tag in a context word of each entry, takes it on `publish` and gives it back with
  the item. One producer, wait-free, a retention of three. An entry is a length
  word, a context word and one word of bytes (at most two bytes).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="broadcast-log"
       name="broadcast_log_conformance_chosen"
       version="1.0">
  <sce:element-type>broadcast_log_conformance_choice</sce:element-type>
  <sce:producers>one</sce:producers>
  <sce:progress>wait-free</sce:progress>
  <sce:retention entries="3"/>
</scxml>
