    {
      "id": "an_index_rebuilds_its_handle_once",
      "make": {
        "count": 4
      },
      "expect": "ok",
      "steps": [
        {
          "op": "acquire",
          "len": 64,
          "headroom": 0,
          "out": 0,
          "expect": "ok"
        },
        {
          "op": "into_index",
          "slot": 0,
          "out": 0
        },
        {
          "op": "free",
          "expect": 3
        },
        {
          "op": "reclaim",
          "index": 0,
          "state": "cpu-mut",
          "out": 1,
          "expect": "ok"
        },
        {
          "op": "reclaim",
          "index": 0,
          "state": "cpu-mut",
          "out": 2,
          "expect": "refused"
        },
        {
          "op": "violations",
          "expect": 1
        },
        {
          "op": "return",
          "slot": 1,
          "expect": "ok"
        },
        {
          "op": "free",
          "expect": 4
        }
      ]
    },
    {
      "id": "a_stale_index_is_refused_and_counted",
      "make": {
        "count": 1
      },
      "expect": "ok",
      "steps": [
        {
          "op": "acquire",
          "len": 64,
          "headroom": 0,
          "out": 0,
          "expect": "ok"
        },
        {
          "op": "index",
          "slot": 0,
          "out": 0
        },
        {
          "op": "generation",
          "index": 0,
          "expect": 0
        },
        {
          "op": "return",
          "slot": 0,
          "expect": "ok"
        },
        {
          "op": "acquire",
          "len": 64,
          "headroom": 0,
          "out": 1,
          "expect": "ok"
        },
        {
          "op": "into_index",
          "slot": 1,
          "out": 1
        },
        {
          "op": "generation",
          "index": 1,
          "expect": 1
        },
        {
          "op": "reclaim",
          "index": 0,
          "state": "cpu-mut",
          "out": 2,
          "expect": "refused"
        },
        {
          "op": "violations",
          "expect": 1
        },
        {
          "op": "reclaim",
          "index": 1,
          "state": "cpu-mut",
          "out": 2,
          "expect": "ok"
        },
        {
          "op": "violations",
          "expect": 1
        },
        {
          "op": "return",
          "slot": 2,
          "expect": "ok"
        }
      ]
    },
    {
      "id": "an_index_given_up_in_one_state_does_not_rebuild_another",
