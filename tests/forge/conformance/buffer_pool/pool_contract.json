    {
      "id": "a_take_writes_the_prefix_in_front_of_the_frame",
      "make": {
        "count": 4
      },
      "expect": "ok",
      "steps": [
        {
          "op": "acquire",
          "len": 64,
          "headroom": 2,
          "out": 0,
          "expect": "ok"
        },
        {
          "op": "capacity",
          "slot": 0,
          "expect": 62
        },
        {
          "op": "write",
          "slot": 0,
          "bytes": [
            161,
            162,
            163
          ]
        },
        {
          "op": "arm_tx",
          "slot": 0,
          "frame": 3,
          "out": 0,
          "expect": "ok"
        },
        {
          "op": "take",
          "index": 0,
          "prefix": [
            0,
            3
          ],
          "expect": "ok",
          "len": 5
        },
        {
          "op": "sent",
          "bytes": [
            0,
            3,
            161,
            162,
            163
          ]
        },
        {
          "op": "take",
          "index": 0,
          "prefix": [],
          "expect": "stale"
        },
        {
          "op": "violations",
          "expect": 1
        },
        {
          "op": "complete_tx",
          "index": 0,
          "expect": true
        },
        {
          "op": "free",
          "expect": 4
        }
      ]
    },
