{
  "version": 1,
  "description": "The buffer-pool kind's lending contract (docs/adr/0111 D4), run by the Rust arm (backends/rust/forge-conformance/tests/forge_buffer_pool.rs) and the C11 arm (backends/c/forge-runtime/tests/conformance/buffer_pool_test.c) against every pool of `pools`, each of which is a document in this directory. A scenario makes a pool (`make`: a run-time `count` over the pool's own storage, or `over` a span the caller holds, cut at `offset` bytes past an aligned arena) and runs its steps in order. A step's `slot` and `out` name a handle register and `index` an index register, 0 to 7. The C11 arm learns a construction's refusal as `false` alone, so it checks `ok` against any refusal; every other outcome both arms check alike.",
  "pools": [
    "pool_conformance_owner",
    "pool_conformance_shared"
  ],
  "scenarios": [
    {
      "id": "a_count_within_the_bound_lends_that_many",
      "make": {
        "count": 2
      },
      "expect": "ok",
      "steps": [
        {
          "op": "count",
          "expect": 2
        },
        {
          "op": "slot_len",
          "expect": 64
        },
        {
          "op": "acquire",
          "len": 64,
          "headroom": 0,
          "out": 0,
          "expect": "ok"
        },
        {
          "op": "acquire",
          "len": 64,
          "headroom": 0,
          "out": 1,
          "expect": "ok"
        },
        {
          "op": "acquire",
          "len": 64,
          "headroom": 0,
          "out": 2,
          "expect": "exhausted"
        },
        {
          "op": "free",
          "expect": 0
        },
        {
          "op": "return",
          "slot": 0,
          "expect": "ok"
        },
        {
          "op": "free",
          "expect": 1
        },
        {
          "op": "return",
          "slot": 1,
          "expect": "ok"
        },
        {
          "op": "free",
          "expect": 2
        }
      ]
    },
    {
      "id": "a_count_of_none_is_refused",
      "make": {
        "count": 0
      },
      "expect": "count",
      "steps": []
    },
    {
      "id": "a_count_past_the_bound_is_refused",
      "make": {
        "count": 5
      },
      "expect": "count",
      "steps": []
    },
    {
      "id": "a_lending_names_its_length_and_its_headroom",
      "make": {
        "count": 4
      },
      "expect": "ok",
      "steps": [
        {
          "op": "acquire",
          "len": 0,
          "headroom": 0,
          "out": 0,
          "expect": "length"
        },
        {
          "op": "acquire",
          "len": 65,
          "headroom": 0,
          "out": 0,
          "expect": "length"
        },
        {
          "op": "acquire",
          "len": 64,
          "headroom": 64,
          "out": 0,
          "expect": "headroom"
        },
        {
          "op": "free",
          "expect": 4
        },
        {
          "op": "acquire",
          "len": 16,
          "headroom": 2,
          "out": 0,
          "expect": "ok"
        },
        {
          "op": "capacity",
          "slot": 0,
          "expect": 14
        },
        {
          "op": "return",
          "slot": 0,
          "expect": "ok"
        },
        {
          "op": "free",
          "expect": 4
        }
      ]
    },
    {
      "id": "a_pool_over_caller_storage_lends_the_slots_it_was_cut_into",
      "make": {
        "over": {
          "span": 128,
          "offset": 0,
          "count": 2,
          "len": 32
        }
      },
      "expect": "ok",
      "steps": [
        {
          "op": "count",
          "expect": 2
        },
        {
          "op": "slot_len",
          "expect": 32
        },
        {
          "op": "acquire",
          "len": 33,
          "headroom": 0,
          "out": 0,
          "expect": "length"
        },
        {
          "op": "acquire",
          "len": 32,
          "headroom": 0,
          "out": 0,
          "expect": "ok"
        },
        {
          "op": "capacity",
          "slot": 0,
          "expect": 32
        },
        {
          "op": "acquire",
          "len": 32,
          "headroom": 0,
          "out": 1,
          "expect": "ok"
        },
        {
          "op": "acquire",
          "len": 32,
          "headroom": 0,
          "out": 2,
          "expect": "exhausted"
        },
        {
          "op": "return",
          "slot": 0,
          "expect": "ok"
        },
        {
          "op": "return",
          "slot": 1,
          "expect": "ok"
        },
        {
          "op": "free",
          "expect": 2
        }
      ]
    },
    {
      "id": "a_short_span_is_refused",
      "make": {
        "over": {
          "span": 63,
          "offset": 0,
          "count": 2,
          "len": 32
        }
      },
      "expect": "short",
      "steps": []
    },
