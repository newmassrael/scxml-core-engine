<!--
  A record of a field of every kind a record signed by name may hold
  (sce:payload, docs/adr/0109, D9): unsigned and signed integers of the
  narrowest and the widest widths, a bool, a bounded text and byte string, a
  closed enum of a signed carrier, a nested record, a list, an optional text and
  an optional number, and a union of an empty case, a case of a byte string and
  a case of a list. A float and an open enum are no such kind: the build refuses
  a record that holds one (`validation/payload-record-schema`).

  The codec codec_cbor_payload_leaves.scxml holds it as its one entry, so the
  record's own map, written by the codec ADR 0101 prints, is held byte for byte
  to the one the runtimes' record codecs write from the record's payload JSON
  (tests/forge/conformance/numerical_reference.json, `codec_cbor_payload_record`).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="cbor_payload_leaves"
       sce:event-name="cbor.payload.leaves">
  <sce:import kind="enum" src="cbor_composed_level.scxml" as="Level"/>
  <sce:import kind="event-schema" src="cbor_composed_point.scxml" as="Point"/>
  <sce:import kind="union" src="cbor_composed_choice.scxml" as="Choice"/>
  <datamodel>
    <data id="tiny" sce:type="uint8" sce:direction="in"/>
    <data id="span" sce:type="uint16" sce:direction="in"/>
    <data id="huge" sce:type="uint64" sce:direction="in"/>
    <data id="low" sce:type="int8" sce:direction="in"/>
    <data id="deep" sce:type="int64" sce:direction="in"/>
    <data id="on" sce:type="bool" sce:direction="in"/>
    <data id="label" sce:type="string[8]" sce:direction="in"/>
    <data id="blob" sce:type="bytes[4]" sce:direction="in"/>
    <data id="level" sce:type="enum:Level" sce:direction="in"/>
    <data id="at" sce:type="record:Point" sce:direction="in"/>
    <data id="samples" sce:type="list&lt;uint8&gt;[3]" sce:direction="in"/>
    <data id="memo" sce:type="optional&lt;string[4]&gt;" sce:direction="in"/>
    <data id="count" sce:type="optional&lt;uint16&gt;" sce:direction="in"/>
    <data id="choice" sce:type="union:Choice" sce:direction="in"/>
  </datamodel>
</scxml>
