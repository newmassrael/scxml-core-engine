<!--
  A CBOR map of an entry of every constructor of the language and at depth
  (docs/adr/0101, section 1.1 and "Conformance" item 1): signed integers,
  floats, enums of a signed carrier, closed and open, lists of numbers, of
  optional numbers, of lists and of a lower count, a record that holds a list,
  an optional text and a nested record, an optional record, a union of an
  empty case, a case of a byte string and a case of a list, a list of unions
  of a lower count and an optional union, and an optional text. Its values,
  their bytes, the encodings a decode reads and the encode never writes, and
  the inputs a decode refuses are the corpus's
  (tests/forge/conformance/numerical_reference.json, `codec_cbor_composed`).

  A list below its lower count and a card's byte string past its bound have no
  encoding, so the encode can refuse a value. Kept apart from the shared
  fixtures, with the documents it imports, so that adding it moves the hash of
  no generated tree; a backend reads it from here.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:encoding="cbor" sce:codec-format="2" name="codec_cbor_composed"
       sce:encode-may-fail="true" version="1.0">
  <sce:import kind="enum" src="cbor_composed_level.scxml" as="Level"/>
  <sce:import kind="enum" src="cbor_composed_color.scxml" as="Color"/>
  <sce:import kind="enum" src="cbor_composed_code.scxml" as="Code"/>
  <sce:import kind="event-schema" src="cbor_composed_point.scxml" as="Point"/>
  <sce:import kind="event-schema" src="cbor_composed_reading.scxml" as="Reading"/>
  <sce:import kind="union" src="cbor_composed_choice.scxml" as="Choice"/>
  <datamodel>
    <data id="raw" sce:type="bytes" sce:direction="in"/>
    <data id="small" sce:type="int8" sce:key="0" sce:direction="out"/>
    <data id="wide" sce:type="int64" sce:key="1" sce:direction="out"/>
    <data id="ratio" sce:type="float32" sce:key="2" sce:direction="out"/>
    <data id="precise" sce:type="float64" sce:key="3" sce:direction="out"/>
    <data id="level" sce:type="enum:Level" sce:key="4" sce:direction="out"/>
    <data id="color" sce:type="enum:Color" sce:key="5" sce:direction="out"/>
    <data id="code" sce:type="enum:Code" sce:key="6" sce:direction="out"/>
    <data id="octets" sce:type="list&lt;uint8&gt;[4]" sce:key="7" sce:direction="out"/>
    <data id="sparse" sce:type="list&lt;optional&lt;uint16&gt;&gt;[3]" sce:key="8" sce:direction="out"/>
    <data id="grid" sce:type="list&lt;list&lt;uint8&gt;[2]&gt;[2]" sce:key="9" sce:direction="out"/>
    <data id="flags" sce:type="list&lt;bool&gt;[1..2]" sce:key="10" sce:direction="out"/>
    <data id="reading" sce:type="record:Reading" sce:key="11" sce:direction="out"/>
    <data id="spare" sce:type="optional&lt;record:Point&gt;" sce:key="12" sce:direction="out"/>
    <data id="choice" sce:type="union:Choice" sce:key="13" sce:direction="out"/>
    <data id="choices" sce:type="list&lt;union:Choice&gt;[1..3]" sce:key="14" sce:direction="out"/>
    <data id="maybe" sce:type="optional&lt;union:Choice&gt;" sce:key="15" sce:direction="out"/>
    <data id="note" sce:type="optional&lt;string[8]&gt;" sce:key="16" sce:direction="out"/>
  </datamodel>
</scxml>
