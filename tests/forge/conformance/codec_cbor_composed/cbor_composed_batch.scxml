<!-- The record of the union's `batch` case: a list. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="cbor_composed_batch"
       sce:event-name="cbor.composed.batch">
  <datamodel>
    <data id="items" sce:type="list&lt;uint16&gt;[3]" sce:direction="in"/>
  </datamodel>
</scxml>
