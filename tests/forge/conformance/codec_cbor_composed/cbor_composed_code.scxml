<!--
  An open enum (`sce:strict-variants="false"`): every number its carrier holds
  is a value, one no variant names among them, written as that number.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="enum"
       name="cbor_composed_code"
       sce:underlying-type="uint16"
       sce:strict-variants="false">
  <datamodel>
    <data id="variants">
      <sce:variant name="ok" value="0"/>
      <sce:variant name="retry" value="1"/>
    </data>
  </datamodel>
</scxml>
