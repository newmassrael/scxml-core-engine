<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="enum"
       name="cbor_composed_kind"
       sce:underlying-type="uint8">
  <datamodel>
    <data id="variants">
      <sce:variant name="idle" value="0"/>
      <sce:variant name="card" value="1"/>
      <sce:variant name="batch" value="2"/>
    </data>
  </datamodel>
