<!--
  A record of two signed integers, held whole by a field of another record and
  by an optional entry of the codec.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="cbor_composed_point"
       sce:event-name="cbor.composed.point">
  <datamodel>
    <data id="x" sce:type="int16" sce:direction="in"/>
    <data id="y" sce:type="int16" sce:direction="in"/>
  </datamodel>
</scxml>
