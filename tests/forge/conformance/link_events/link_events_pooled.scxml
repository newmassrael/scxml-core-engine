<?xml version="1.0" encoding="UTF-8"?>
<!--
  A link that carries the events it declares through a transmit pool
  (docs/adr/0106, #142): two inbound rows, one guarded by the decoded frame and
  one for every frame, and two outbound rows, one encoded by the framer and one
  by another codec, each into a slot of `link_events_tx_pool`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="link" name="link_events_pooled" version="1.0">
  <sce:import as="link_events_frame" src="link_events_frame.scxml" kind="codec"/>
  <sce:link-class>udp</sce:link-class>
  <sce:framer ref="link_events_frame"/>
  <sce:backpressure>drop</sce:backpressure>
  <sce:import as="link_events_query" src="link_events_query.scxml" kind="codec"/>
  <sce:import as="link_events_tx_pool" src="link_events_tx_pool.scxml" kind="buffer-pool"/>
  <sce:tx-pool ref="link_events_tx_pool"/>
  <sce:events>
    <sce:inbound event="scout.hello.received" when="decoded.msg_id === 0x02"/>
    <sce:inbound event="scout.any.received"/>
    <sce:outbound event="scout.query.send" encode="link_events_query"/>
    <sce:outbound event="scout.frame.send" encode="link_events_frame"/>
  </sce:events>
</scxml>
