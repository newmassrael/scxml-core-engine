{
  "version": 1,
  "description": "Cross-language numerical conformance reference for sce_forge_runtime generated code. All five languages (C++, Rust, Python, Kotlin, Go) MUST produce these exact outputs. Every entry is computed by hand from the algorithms in sce-forge-runtime/rust/src/ and verified against the live Rust smoke tests. If any language disagrees, the bug is in that language's codegen template or runtime helper — not in this file.",
  "float_tolerance": 1e-12,

  "pure_functions": {
    "interpolation_1d_linear": {
      "fixture": "Interpolation1dLinear::lookup",
      "signature": "(rpm: u16) -> f64",
      "axis_rpm": [800, 1200, 2000, 3000, 4000, 6000],
      "values": [120.0, 145.0, 200.0, 230.0, 210.0, 180.0],
      "cases": [
        {"args": [800],  "expected": 120.0,   "note": "exact low boundary"},
        {"args": [1200], "expected": 145.0,   "note": "exact knot"},
        {"args": [1500], "expected": 165.625, "note": "interior: 145 + 0.375*(200-145)"},
        {"args": [3000], "expected": 230.0,   "note": "exact knot"},
        {"args": [500],  "expected": 120.0,   "note": "below range, clamped to values[0]"},
        {"args": [7000], "expected": 180.0,   "note": "above range, clamped to values[N-1]"}
      ]
    },
    "interpolation_2d_bilinear": {
      "fixture": "Interpolation2dBilinear::lookup",
      "signature": "(rpm: u16, load: u8) -> f64",
      "axis_rpm":  [800, 1200, 2000, 3000],
      "axis_load": [10, 50, 100],
      "values": [
        [2.1, 4.5, 7.0],
        [2.5, 5.0, 8.0],
        [3.0, 6.0, 9.5],
        [3.5, 7.0, 11.0]
      ],
      "cases": [
        {"args": [2000, 50],  "expected": 6.0,   "note": "exact grid point values[2][1]"},
        {"args": [800, 10],   "expected": 2.1,   "note": "lower corner"},
        {"args": [3000, 100], "expected": 11.0,  "note": "upper corner"},
        {"args": [1000, 30],  "expected": 3.525, "note": "interior: tx=0.5 ty=0.5, (2.1,4.5,2.5,5.0) -> 3.525"},
        {"args": [500, 5],    "expected": 2.1,   "note": "below both axes, clamped to corner"}
      ]
    }
  },

  "stateful_filters": {
    "filter_moving_average": {
      "fixture": "FilterMovingAverage",
      "signature": "update(f64) -> f64",
      "window": 5,
      "element_type": "f64",
      "description": "Sliding arithmetic mean. Before buffer is full, returns mean of samples seen so far.",
      "sequence": [
        {"input": 1.0, "expected": 1.0, "note": "count=1 sum=1"},
        {"input": 2.0, "expected": 1.5, "note": "count=2 sum=3"},
        {"input": 3.0, "expected": 2.0, "note": "count=3 sum=6"},
        {"input": 4.0, "expected": 2.5, "note": "count=4 sum=10"},
        {"input": 5.0, "expected": 3.0, "note": "filled count=5 sum=15"},
        {"input": 6.0, "expected": 4.0, "note": "window [6,2,3,4,5] sum=20"},
        {"input": 7.0, "expected": 5.0, "note": "window [6,7,3,4,5] sum=25"}
      ]
    },
    "filter_debounce": {
      "fixture": "FilterDebounce",
      "signature": "update(bool) -> bool",
      "window": 3,
      "element_type": "bool",
      "description": "Output latches only when all WINDOW buffer entries match. Before buffer fills, raw input passes through.",
      "sequence": [
        {"input": true,  "expected": true,  "note": "not filled, pass-through"},
        {"input": false, "expected": false, "note": "not filled, pass-through"},
        {"input": true,  "expected": false, "note": "buffer [T,F,T] filled but unstable; output holds previous (false)"},
        {"input": true,  "expected": false, "note": "buffer [T,F,T] still unstable; output holds"},
        {"input": true,  "expected": true,  "note": "buffer [T,T,T] stable; latch to T"},
        {"input": false, "expected": true,  "note": "buffer [T,T,F] unstable; hold"},
        {"input": false, "expected": true,  "note": "buffer [F,T,F] unstable; hold"},
        {"input": false, "expected": false, "note": "buffer [F,F,F] stable; latch to F"}
      ]
    }
  },

  "observers": {
    "observer_coolant": {
      "fixture": "ObserverCoolant",
      "signature": "update(f64) -> EventQueue<Tag>",
      "description": "Hysteresis. Warning band: enter>110, leave<100. Critical band: enter>120, leave<105 (silent leave, no CLEAR event).",
      "tags": ["EMIT_WARNING", "CLEAR_WARNING", "EMERGENCY_SHUTDOWN"],
      "sequence": [
        {"input": 95.0,  "expected_events": [],                      "note": "cold start, both bands inactive"},
        {"input": 112.0, "expected_events": ["EMIT_WARNING"],        "note": "enter warning"},
        {"input": 115.0, "expected_events": [],                      "note": "already in warning band, no re-emit"},
        {"input": 125.0, "expected_events": ["EMERGENCY_SHUTDOWN"],  "note": "enter critical (warning stays)"},
        {"input": 90.0,  "expected_events": ["CLEAR_WARNING"],       "note": "leave warning; critical also leaves silently (no event)"}
      ]
    }
  }
}
