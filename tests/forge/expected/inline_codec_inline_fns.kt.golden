// SCE Forge: Inline codec 'frame'
    data class Frame(
        val msgId: UByte,
        val length: UByte,
        val payload: UShort
    ) {
        companion object {
            fun decode(cursor: com.sce.forge.runtime.SceCursor): Frame? {
                val raw = cursor.peekSlice(4) ?: return null
                val value = Frame(
                    raw[0].toUByte(),
                    raw[1].toUByte(),
                    (((raw[2].toInt() and 0xFF) shl 8) or (raw[3].toInt() and 0xFF)).toUShort(),
                )
                if (!cursor.advance(4)) return null
                return value
            }
        }
        fun encode(): ByteArray = byteArrayOf(
            msgId.toByte(),
            length.toByte(),
            (payload.toInt() ushr 8 and 0xFF).toByte(),
            (payload.toInt() and 0xFF).toByte()
        )
    }
