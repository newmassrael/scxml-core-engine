// SCE Forge: Inline codec 'frame'
type Frame struct {
	MsgId uint8
	Length uint8
	Payload uint16
}

// codec runtime import for cursor-based decode (RFC §5.B L494-519)
// import "github.com/newmassrael/sce-forge-runtime/codec"
func DecodeFrame(cursor *codec.SceCursor) (*Frame, error) {
	raw, err := cursor.PeekSlice(4)
	if err != nil {
		return nil, err
	}
	value := &Frame{
		MsgId: raw[0],
		Length: raw[1],
		Payload: uint16(raw[2])<<8 | uint16(raw[3]),
	}
	if err := cursor.Advance(4); err != nil {
		return nil, err
	}
	return value, nil
}

func (s *Frame) Encode() []byte {
	return []byte{
		byte(s.MsgId),
		byte(s.Length),
		byte(s.Payload >> 8 & 0xFF),
		byte(s.Payload & 0xFF)
	}
}
