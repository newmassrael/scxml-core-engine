/* SCE Forge: Inline codec 'frame' */
#define INLINE_CODEC_FRAME_MIN_BYTES 4
#define INLINE_CODEC_FRAME_MAX_BYTES 4

typedef struct {
    uint8_t msg_id;
    uint8_t length;
    uint16_t payload;
} inline_codec_frame_t;

typedef struct {
    uint8_t bytes[INLINE_CODEC_FRAME_MAX_BYTES];
    size_t  len;
} inline_codec_frame_encoded_t;

static inline bool inline_codec_frame_decode(const uint8_t *raw, size_t len, inline_codec_frame_t *out) {
    if (len < INLINE_CODEC_FRAME_MIN_BYTES) return false;
    out->msg_id = raw[0];
    out->length = raw[1];
    out->payload = ((uint16_t)raw[2] << 8) | raw[3];
    return true;
}

static inline inline_codec_frame_encoded_t inline_codec_frame_encode(const inline_codec_frame_t *self) {
    inline_codec_frame_encoded_t r;
    r.len = INLINE_CODEC_FRAME_MIN_BYTES;
    r.bytes[0] = self->msg_id;
    r.bytes[1] = self->length;
    r.bytes[2] = (uint8_t)((self->payload >> 8) & 0xFF);
    r.bytes[3] = (uint8_t)(self->payload & 0xFF);
    return r;
}
