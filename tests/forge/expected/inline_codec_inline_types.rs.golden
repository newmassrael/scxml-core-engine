// SCE Forge: Inline codec 'frame'
#[derive(Debug, Clone)]
pub struct Frame {
    pub msg_id: u8,
    pub length: u8,
    pub payload: u16,
}

impl Frame {
    pub fn decode(cursor: &mut ::sce_forge_runtime::codec::SceCursor<'_>) -> Result<Self, ::sce_forge_runtime::codec::CodecError> {
        let raw = cursor.peek_slice(4)?;
        let msg_id = raw[0];
        let length = raw[1];
        let payload = ((raw[2] as u16) << 8) | raw[3] as u16;
        let value = Self {
            msg_id,
            length,
            payload,
        };
        cursor.advance(4)?;
        Ok(value)
    }

    pub const MAX_ENCODED_BYTES: usize = 4;

    pub fn encode<S: ::sce_forge_runtime::codec::SceSink>(&self, w: &mut S) -> Result<(), ::sce_forge_runtime::codec::CodecError> {
        w.write_u8(self.msg_id)?;
        w.write_u8(self.length)?;
        w.write_u8((self.payload >> 8 & 0xFF) as u8)?;
        w.write_u8((self.payload & 0xFF) as u8)?;
        Ok(())
    }

    pub fn encode_to_vec(&self) -> Vec<u8> {
        let mut _sce_v: Vec<u8> = Vec::with_capacity(Self::MAX_ENCODED_BYTES);
        let mut _sce_sink = ::sce_forge_runtime::codec::VecSink::new(&mut _sce_v);
        self.encode(&mut _sce_sink).expect("VecSink is infallible");
        _sce_v
    }
}
