// SCE Forge: Inline codec 'frame'
#[derive(Debug, Clone)]
pub struct Frame {
    pub msg_id: u8,
    pub length: u8,
    pub payload: u16,
}

impl Frame {
    pub fn decode(cursor: &mut ::sce_forge_runtime::codec::SceCursor<'_>) -> Result<Self, ::sce_forge_runtime::codec::CodecError> {
        let raw = cursor.peek_slice(4)?;
        let value = Self {
            msg_id: raw[0],
            length: raw[1],
            payload: ((raw[2] as u16) << 8) | raw[3] as u16,
        };
        cursor.advance(4)?;
        Ok(value)
    }

    pub fn encode(&self) -> Vec<u8> {
        vec![
            self.msg_id,
            self.length,
            (self.payload >> 8 & 0xFF) as u8,
            (self.payload & 0xFF) as u8
        ]
    }
}
