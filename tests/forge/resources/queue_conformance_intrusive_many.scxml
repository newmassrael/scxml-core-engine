<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCE Protocol-Synthesis RFC §synth-5-P (queue kind, intrusive storage): many
  producers and many consumers over nodes the caller owns. The selection table
  gives this Vyukov's list with a test-and-set flag that serialises the
  consumers, so pop is blocking in two ways: it waits for the flag's holder,
  and it answers empty while a producer is between its two steps. Its nodes are
  of the same type as `queue_conformance_intrusive`'s, the runtime's node over
  `queue_conformance_event` (ADR 0088).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="queue"
       name="queue_conformance_intrusive_many"
       version="1.0">
  <sce:element-type>queue_conformance_event</sce:element-type>
  <sce:producers>many</sce:producers>
  <sce:consumers>many</sce:consumers>
  <sce:progress>blocking</sce:progress>
  <sce:intrusive/>
</scxml>
