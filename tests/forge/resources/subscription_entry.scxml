<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCE Protocol-Synthesis RFC §synth-5-A line 311 + §synth-5-L line 2642-2647 (C7-lowering
  2026-05-13): minimal element-type codec consumed by
  `local_sub_table.scxml` (bounded-collection) and indirectly by
  `algorithm_bc_iter_minimal.scxml` (algorithm-over-BC iter). Single
  field `callback_id` carries the registered subscription identity so
  the C7-lowering BC-foreach + dotted-call exemplars can match on a
  field of the element.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="codec"
       name="subscription_entry"
       version="1.0">
  <datamodel>
    <sce:field id="callback_id" sce:type="uint32" sce:byte="4" sce:bit-size="32"/>
  </datamodel>
</scxml>
