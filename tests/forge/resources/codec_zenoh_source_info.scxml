<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: Zenoh source_info body (RFC §5.B Y2 — second
     realistic consumer of the dotted-path length-field +
     length-ref arithmetic offset, after codec_zenoh_scout).

     Mirrors zenoh-pico `_z_source_info_encode` / `_z_source_info_decode`
     (src/protocol/codec/message.c lines 196-242) verbatim:

         z_result_t _z_source_info_encode(_z_wbuf_t *wbf,
                                          const _z_source_info_t *info) {
             uint8_t zidlen = _z_id_len(info->_source_id.zid);
             ret |= _z_uint8_encode(wbf, (uint8_t)((zidlen - 1) << 4));
             _z_slice_t zid = _z_slice_alias_buf(info->_source_id.zid.id, zidlen);
             ret |= _z_slice_val_encode(wbf, &zid);
             ret |= _z_zsize_encode(wbf, info->_source_id.eid);
             ret |= _z_zsize_encode(wbf, info->_source_sn);
             return ret;
         }

         z_result_t _z_source_info_decode(_z_source_info_t *info,
                                          _z_zbuf_t *zbf) {
             uint8_t zidlen = 0;
             ret = _z_uint8_decode(&zidlen, zbf);
             zidlen = (zidlen >> 4) + 1;
             _z_zbuf_read_bytes(zbf, info->_source_id.zid.id, 0, zidlen);
             ret = _z_zsize_decode(&intbuf, zbf);
             if (intbuf <= UINT32_MAX) info->_source_id.eid = intbuf;
             ret = _z_zsize_decode(&intbuf, zbf);
             if (intbuf <= UINT32_MAX) info->_source_sn = intbuf;
             ...
         }

     Wire shape (1+N+2..10 bytes):
       byte 0   : header  (uint8 flags: zidlen_m1 in upper 4 bits;
                           lower 4 bits unused, written 0 / ignored
                           on decode)
       byte 1+  : zid     (bytes, length = header.zidlen_m1 + 1, max=16)
       byte ?+  : eid     (VLE u32, _z_zsize_encode + UINT32_MAX cap
                           on decode)
       byte ?+  : sn      (VLE u32, same VLE u32 convention as eid)

     Composition: flags flags carrier (header) + flags multi-bit flag
     (zidlen_m1 width=4) + dotted-path dotted-path length-field
     (`header.zidlen_m1`) + length-ref arithmetic offset (1) +
     VLE VLE primitive (eid + sn). NO new SCE primitives required.
     Same zid-length encoding pattern as codec_zenoh_scout but with
     no `I` gating bit (zid is always present in source_info, even
     when length=1; upstream encoder always emits it).

     Wire round-trip oracle:
       zid=[0xAB], eid=42, sn=7:
         header=0x00 (zidlen_m1=0, length=1)
         body = 0x00 0xAB 0x2A 0x07
       zid=[0x01..0x10] (16 bytes), eid=0xFFFFFFFF, sn=0:
         header=0xF0 (zidlen_m1=15, length=16)
         body = 0xF0 0x01 0x02 ... 0x10 0xFF 0xFF 0xFF 0xFF 0x0F 0x00 -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_zenoh_source_info">
  <datamodel>
    <sce:flags id="header" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="zidlen_m1" bit="4" width="4"/>
    </sce:flags>
    <sce:field id="zid" sce:type="bytes" sce:byte="1" sce:bit-size="length-ref"
               sce:length-field="header.zidlen_m1" sce:length-arith="+1"
               sce:max-size="16"/>
    <sce:field id="eid" sce:type="uint32" sce:byte="2" sce:bit-size="vle"/>
    <sce:field id="sn"  sce:type="uint32" sce:byte="3" sce:bit-size="vle"/>
  </datamodel>
</scxml>
