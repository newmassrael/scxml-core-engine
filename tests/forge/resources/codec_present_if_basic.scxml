<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: codec present-if primitive (RFC §synth-5-B present-if).
     One-byte uint8 carrier "flags" exposes a single named bit "has_seq"
     (bit 0). The trailing "seq" field is uint16 BE gated on
     sce:present-if="flags.has_seq"; when the bit is clear the field is
     absent from the wire (`Option<u16>` / `std::optional<uint16_t>`)
     and the encoded frame is exactly one byte. v1 trunk supports
     present-if on fixed-width carriers only — variable-length gated
     fields land alongside the B2 len-prefix / until-eof primitives. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_present_if_basic">
  <datamodel>
    <sce:flags id="flags" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="has_seq" bit="0"/>
    </sce:flags>
    <sce:field id="seq" sce:type="uint16" sce:byte="1" sce:bit-size="16"
               sce:present-if="flags.has_seq"/>
  </datamodel>
</scxml>
