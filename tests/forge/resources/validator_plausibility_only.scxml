<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="validator"
       name="plausibility_only_validator">
  <datamodel>
    <data id="voltage" sce:type="float64" sce:direction="in"/>
    <data id="current" sce:type="float64" sce:direction="in"/>
    <data id="valid" sce:type="bool" sce:direction="out"
          sce:plausibility="voltage * current &lt;= 1000.0"/>
  </datamodel>
</scxml>
