<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="procedure"
       name="startup_check"
       initial="check_voltage">
  <datamodel>
    <data id="voltage" sce:type="float32" sce:direction="in"/>
    <data id="temperature" sce:type="float32" sce:direction="in"/>
  </datamodel>

  <state id="check_voltage">
    <transition cond="voltage >= 11.5 &amp;&amp; voltage &lt;= 14.5" target="check_temp"/>
    <transition target="fail_voltage"/>
  </state>

  <state id="check_temp">
    <transition cond="temperature &lt; 80.0" target="success"/>
    <transition target="fail_overtemp"/>
  </state>

  <final id="success"/>
  <final id="fail_voltage"/>
  <final id="fail_overtemp"/>
</scxml>
