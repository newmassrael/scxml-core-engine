<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: Zenoh undecl_token body (RFC §5.B —
     RFC §5.B consumer). Wire-identical to
     codec_zenoh_undecl_subscriber / undecl_queryable; mirrors
     `_z_undecl_token_encode` →
     `_z_undecl_encode(_Z_UNDECL_TOKEN_MID=7, ...)` (declarations.c:
     128-130 + 310-312). Kept as a separate fixture per the named-
     encoder 1:1 convention so a future MID-specific divergence
     surfaces here.

     Wire shape (1+ bytes — outer envelope writes the per-MID header
     byte; this body only carries the payload):
       VLE u32 id
       parent.Z : ext_keyexpr  (length-bound TLV envelope —
                                codec_zenoh_decl_ext_keyexpr) -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_zenoh_undecl_token">
  <sce:import src="codec_zenoh_decl_ext_keyexpr.scxml" kind="codec"
              as="codec_zenoh_decl_ext_keyexpr"/>
  <sce:flag-inputs>
    <sce:flag-input name="Z" width="1"/>
  </sce:flag-inputs>
  <datamodel>
    <sce:field id="id" sce:type="uint32" sce:byte="0" sce:bit-size="vle"/>
    <sce:embed id="ext_keyexpr" type="codec_zenoh_decl_ext_keyexpr" sce:byte="1"
               sce:present-if="Z"/>
  </datamodel>
</scxml>
