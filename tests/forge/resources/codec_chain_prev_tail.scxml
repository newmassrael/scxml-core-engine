<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: a chain that ends with the frame, and still tells its
     entries what came before them.

     `entry-id` was only admitted on a chain that something after it could be
     gated by (`<chain>.has(…)`), and a chain that ends only when the frame does
     has nothing after it. A bind reads the identifier too, and needs nothing
     after the chain, so this is the chain without a termination flag: it reads
     entries to the end of the frame, and each is laid out by the one before it.
     The loop has no `_more` to carry here, only the value for the next entry.

     Wire shape:
       byte 0  : head  (T at bit 0, handed to every entry as `tagged`)
       byte 1..: entries to the end of the frame -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_chain_prev_tail">
  <sce:import src="codec_chain_prev_entry.scxml" kind="codec" as="codec_chain_prev_entry">
    <sce:flag-bind input="tagged" source="head.T"/>
  </sce:import>
  <datamodel>
    <sce:flags id="head" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="T" bit="0"/>
    </sce:flags>
    <sce:tlv-chain id="entries" type="codec_chain_prev_entry" sce:byte="1"
                   max-depth="4" on-overflow="reject"
                   entry-id="header.ext_id">
      <sce:entry-flag-bind input="after_marker" previous-entry-id="0x4"/>
    </sce:tlv-chain>
  </datamodel>
</scxml>
