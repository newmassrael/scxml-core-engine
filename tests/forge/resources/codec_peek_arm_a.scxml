<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: peek-byte primitive demo arm body A (RFC §5.B
     atomic 2b-ii peek-byte). Mirrors a Zenoh-style arm-body shape — the
     first wire byte is a `<sce:flags>` header that names the dispatch
     bit (`kind` at bit 0) the parent variant peeks. Body payload is a
     trailing uint8.

     Wire shape:
       byte 0 : header (kind:1 + reserved:7) — the peeked byte; arm A
                fires when bit 0 is clear (kind=0).
       byte 1 : payload uint8.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_peek_arm_a">
  <datamodel>
    <sce:flags id="header" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="kind" bit="0" width="1" value="0x00"/>
    </sce:flags>
    <sce:field id="payload" sce:type="uint8" sce:byte="1" sce:bit-size="8"/>
  </datamodel>
</scxml>
