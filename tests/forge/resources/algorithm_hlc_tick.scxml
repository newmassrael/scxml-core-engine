<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hybrid logical clock send/local-event step: the next stamp after `prev`
  when the local clock reads `now` on node `node`. The wall time never goes
  backwards; when it does not advance, the counter does.

  Exercises a record local built whole with <sce:field>, a field updated by
  <sce:assign>, and a record return (SCE_FORGE.md §4.12).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="algorithm"
       version="1.0">
  <sce:import kind="event-schema" src="event_schema_hlc.scxml" as="Hlc"/>
  <sce:signature>
    <sce:param name="prev" type="record:Hlc"/>
    <sce:param name="now" type="int64"/>
    <sce:param name="node" type="uint64"/>
    <sce:return type="record:Hlc"/>
  </sce:signature>
  <sce:body>
    <sce:var name="next" type="record:Hlc">
      <sce:field name="nodeId" expr="node"/>
      <sce:field name="wallTime" expr="now &gt; prev.wallTime ? now : prev.wallTime"/>
      <sce:field name="counter" expr="0"/>
    </sce:var>
    <sce:if cond="next.wallTime === prev.wallTime">
      <sce:assign target="next.counter" expr="prev.counter + 1"/>
    </sce:if>
    <sce:return expr="next"/>
  </sce:body>
</scxml>
