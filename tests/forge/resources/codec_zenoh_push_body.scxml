<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: inner variant — Zenoh push-body envelope
     (RFC §5.B B5-η Surface I, "recursive variant body"). This codec
     is itself a variant (header MID dispatches PUT vs DEL), AND it is
     used as an arm body of the outer variant codec_zenoh_push — so
     when the outer codec emits its per-language sum-type, that
     sum-type's arm holds an inner sum-type. That nested-sum
     emission shape is what Surface I validates.

     Upstream `_z_push_body_t` (zenoh-pico
     src/protocol/codec/message.c:_z_push_body_decode lines 332-367):
     `switch (_Z_MID(header))` dispatches PUT (0x01) → put body, DEL
     (0x02) → del body, default → unknown error. The fixture mirrors
     that switch through `<sce:variant tag="header.mid">` (B5-β
     variant-from-multi-bit-flag). The non-MID 3 high-order bits are
     declared as a `rest` flag block to keep the carrier byte
     accounted for; they are body-consumed in upstream and stay
     unread here (matches the codec_transport_envelope shape).

     Wire shape (1 + arm body bytes):
       byte 0: header  bits 0..4 = mid    (5 bits)
                       bits 5..7 = rest   (3 bits, body-consumed)
       bytes 1..N: arm body bytes (PUT=1 payload byte; DEL=0 bytes)

     Arm coverage:
       0x01 → codec_zenoh_put   (mirrors _Z_MID_Z_PUT)
       0x02 → codec_zenoh_del   (mirrors _Z_MID_Z_DEL)
       <sce:default> → codec_zenoh_put (catch-all; preserves runtime
       mid for round-trip per B1-β default-arm contract). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_zenoh_push_body">
  <sce:import src="codec_zenoh_put.scxml" kind="codec" as="codec_zenoh_put"/>
  <sce:import src="codec_zenoh_del.scxml" kind="codec" as="codec_zenoh_del"/>
  <datamodel>
    <sce:flags id="header" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="mid"  bit="0" width="5"/>
      <sce:flag name="rest" bit="5" width="3"/>
    </sce:flags>
    <sce:variant tag="header.mid">
      <sce:arm value="0x01" type="codec_zenoh_put"/>
      <sce:arm value="0x02" type="codec_zenoh_del"/>
      <sce:default type="codec_zenoh_put"/>
    </sce:variant>
  </datamodel>
</scxml>
