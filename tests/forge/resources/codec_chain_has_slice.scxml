<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: one element of a sliced payload — the element
     codec `codec_chain_has_envelope` repeats when a chain entry says its
     payload is sliced.

     Wire shape: `kind` (VLE) ++ `len` (VLE) ++ `len` bytes. Two kinds of
     slice share it, which is why one element codec is enough. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_chain_has_slice">
  <datamodel>
    <sce:field id="kind"  sce:type="uint16" sce:byte="0" sce:bit-size="vle"/>
    <sce:field id="len"   sce:type="uint64" sce:byte="1" sce:bit-size="vle"/>
    <sce:field id="bytes" sce:type="bytes"  sce:byte="2" sce:bit-size="length-ref"
               sce:length-field="len" sce:max-size="256"/>
  </datamodel>
</scxml>
