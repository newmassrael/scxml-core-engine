<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: Zenoh transport-layer Close body (RFC §synth-5-B
     zenoh groundwork — first reachable downstream consumer of B1-B4 primitives
     from the watching-zenoh authoring path).

     Upstream zenoh-pico shape (`_z_close_encode` in
     src/protocol/codec/transport.c:335-343): the Close body is a
     single uint8 reason code. The 1-byte transport-message header
     (MID + flags) is written by `_z_transport_message_encode` BEFORE
     dispatching to `_z_close_encode`, so the body codec scope is the
     reason byte alone.

     Pure composition of existing primitives: a single Fixed uint8
     field. No new IR / parser / template surface. Validates that
     B1-B4 compose for an actual Zenoh transport-message body. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_zenoh_close">
  <datamodel>
    <sce:field id="reason" sce:type="uint8" sce:byte="0" sce:bit-size="8"/>
  </datamodel>
  <!-- RFC §synth-5-B test-vector inline test vectors. Each row pins one wire byte
       sequence to the expected decoded form; the per-backend sidecar
       (`<fixture>_test.{rs,h}`) generates a round-trip oracle. Same
       4 reason codes as the numerical_reference.json oracle harness
       so the inline anchor and the bulk JSON oracle stay in lockstep. -->
  <sce:test-vector hex="00">
    <sce:decoded field="reason" value="0"/>
  </sce:test-vector>
  <sce:test-vector hex="01">
    <sce:decoded field="reason" value="1"/>
  </sce:test-vector>
  <sce:test-vector hex="02">
    <sce:decoded field="reason" value="2"/>
  </sce:test-vector>
  <sce:test-vector hex="ff">
    <sce:decoded field="reason" value="0xff"/>
  </sce:test-vector>
</scxml>
