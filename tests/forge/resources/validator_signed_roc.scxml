<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="validator"
       name="signed_roc_validator">
  <datamodel>
    <data id="speed" sce:type="int32" sce:direction="in"
          sce:range-min="-100" sce:range-max="500"
          sce:max-delta="50" sce:sample-interval="200ms"/>
    <data id="altitude" sce:type="float64" sce:direction="in"
          sce:range-max="50000.0"
          sce:max-delta="100.0" sce:sample-interval="1s"/>
    <data id="valid" sce:type="bool" sce:direction="out"/>
  </datamodel>
</scxml>
