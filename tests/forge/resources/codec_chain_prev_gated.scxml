<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: the same hand-over through a gated chain, with an
     identifier that leaves the continuation flag out.

     The chain is on the wire only when E is set. Its entries are told what came
     before them as in `codec_chain_prev_carrier`, but here the identifier is the
     whole header byte with Z left out (`entry-id-except`): the marker is an
     entry whose header is 0x04 on the wire when it is the last of the chain and
     0x84 when it is not, and both are the identifier 0x4. A bind that compared
     the byte whole would see a different kind in each. A gated chain is
     rendered by its own builder in every backend, so it is covered on its own.

     Wire shape:
       byte 0  : head  (T at bit 0 handed to every entry as `tagged`,
                        E at bit 1 gating the chain)
       byte 1..: entries, present iff E -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_chain_prev_gated">
  <sce:import src="codec_chain_prev_entry.scxml" kind="codec" as="codec_chain_prev_entry">
    <sce:flag-bind input="tagged" source="head.T"/>
  </sce:import>
  <datamodel>
    <sce:flags id="head" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="T" bit="0"/>
      <sce:flag name="E" bit="1"/>
    </sce:flags>
    <sce:tlv-chain id="entries" type="codec_chain_prev_entry" sce:byte="1"
                   max-depth="4" on-overflow="reject"
                   terminate-on="entry-flag" entry-flag-name="Z"
                   entry-id="header" entry-id-except="header.Z"
                   sce:present-if="head.E">
      <sce:entry-flag-bind input="after_marker" previous-entry-id="0x4"/>
    </sce:tlv-chain>
  </datamodel>
</scxml>
