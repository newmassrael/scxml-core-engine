<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: a codec with nothing borrowed in it, the arm of
     `codec_origin_choice` whose body an origin has nothing to share with.

     Wire shape: `value` (1 byte). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_origin_scalar">
  <datamodel>
    <sce:field id="value" sce:type="uint8" sce:byte="0" sce:bit-size="8"/>
  </datamodel>
</scxml>
