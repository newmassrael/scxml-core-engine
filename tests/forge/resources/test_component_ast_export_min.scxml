<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.5: the smallest test component, the main
     test component of the sibling configuration fixture. It waits on its port
     for any message and passes; its timer running out fails. A test component
     is exported through the statechart arm, its profile under
     `test_component`. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="test_component_ast_export_min"
       datamodel="sce-static" initial="waiting">
  <sce:import kind="test-port-type" src="test_port_type_ast_export_min.scxml" as="BytePort"/>
  <sce:test-port id="sut" type="BytePort"/>
  <sce:test-timer id="reply" duration="500ms"/>
  <state id="waiting">
    <onentry>
      <sce:start-timer timer="reply"/>
    </onentry>
    <transition sce:receive="sut" target="passed">
      <sce:setverdict value="pass"/>
    </transition>
    <transition sce:timeout="reply" target="failed">
      <sce:setverdict value="fail"/>
    </transition>
  </state>
  <final id="passed"/>
  <final id="failed"/>
</scxml>
