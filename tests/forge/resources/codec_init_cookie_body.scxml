<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: Init body cookie (RFC §5.B B5-δ Surfaces D + E).

     Mirrors the upstream zenoh-pico Init message's optional cookie
     payload (src/protocol/codec/transport.c lines 268-275 + lines
     316-322 — `_z_init_decode` and `_z_open_decode` both append the
     cookie when the parent header's A-flag is set, encoding the cookie
     bytes via `_z_slice_decode` which is `<vle-zsize length> + <bytes>`).

     This fixture exercises two B5-δ surfaces against one consumer:

     - **Surface D (VLE-length-ref)**: `cookie_size` is a u16 VLE
       integer (`bit-size="vle"`). The streaming codec helper for
       `length-ref` reads the sibling-bound local through `as usize`,
       which works whether the sibling is `Fixed { bits: 8 }` or
       `Vle { width_bits: 16/32/64 }`. Lifts the B4 deferral that
       restricted the canonical cookie/attachment case to ≤ 127 bytes.

     - **Surface E (gated length sibling)**: `cookie_size` itself
       carries `present-if="parent.A"` — when the parent's A-flag is
       clear, the entire `<size-prefix> + <cookie-bytes>` span is
       absent from the wire (full upstream parity). Decode helper
       unwraps the sibling Optional inside the same gated branch as
       the payload (trust contract: shared predicate).

     Wire shape (1 byte minimum, +1..3 VLE size, +0..N cookie bytes):
       byte 0   : version       (uint8, always present)
       byte 1+  : cookie_size   (VLE u16, present iff parent.A)
                 cookie         (bytes, length=cookie_size, present iff parent.A)

     Round-trip oracles:
       parent_flags=0x20 (A=true):  version=0x01 cookie_size=Some(3) cookie=Some([0xAB,0xCD,0xEF])
                                      → 0x01 0x03 0xAB 0xCD 0xEF (5 bytes)
       parent_flags=0x00 (A=false): version=0x01 cookie_size=None  cookie=None
                                      → 0x01 (1 byte) -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_init_cookie_body">
  <sce:flag-inputs>
    <sce:flag-input name="A" width="1"/>
  </sce:flag-inputs>
  <datamodel>
    <sce:field id="version" sce:type="uint8" sce:byte="0" sce:bit-size="8"/>
    <sce:field id="cookie_size" sce:type="uint16" sce:byte="1" sce:bit-size="vle"
               sce:present-if="A"/>
    <sce:field id="cookie" sce:type="bytes" sce:byte="2" sce:bit-size="length-ref"
               sce:length-field="cookie_size" sce:present-if="A"
               sce:max-size="64"/>
  </datamodel>
</scxml>
