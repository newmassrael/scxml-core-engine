<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: Zenoh response envelope (RFC §5.B Wire RFC
     Phase B Y3 atomic 2b-ii peek-byte — first realistic peek-byte
     primitive consumer).

     Mirrors zenoh-pico `_z_response_encode` / `_z_response_decode`
     (src/protocol/codec/network.c). Network-layer envelope wrapping a
     reply or err inner body — the inner body's own header byte
     identifies which (Z_REPLY = 0x04, Z_ERR = 0x05). SCE's
     `<sce:peek-byte>` primitive surfaces exactly that dispatch shape:
     the cursor's NEXT byte is read without advancing, the envelope
     dispatches on the named bit-range, and the matched arm body
     decoder reads that same byte as its own first wire byte (so
     msg_reply / msg_err re-read the inner MID through their own
     `<sce:flags>` header — no double-consumption, no host-level
     plumbing).

     Wire shape (per upstream network.c response_encode):
       byte 0   : header     (MID Z_RESPONSE in bits 0..4 + M@5 + N@6 +
                              Z@7) — the request's inner header is the
                              outer envelope's ID for this network-
                              layer message; the dispatch byte for the
                              body variant is at byte N+ (after the
                              prefix below).
       byte 1+  : request_id (VLE u64 — request_id reuses the request's
                              rid, identifying which request this
                              response answers).
       byte ~   : key_id     (VLE u32 — keyexpr id; pairs with N-gated
                              suffix below to form a "qualified
                              keyexpr" per Z_RESPONSE convention).
       N-gated  : suffix     (VLE u64 length + UTF-8 string up to 256B)
                              — keyexpr suffix string, present iff
                              header.N is set.
       Z-gated  : extensions (codec_zenoh_ext_entry tlv-chain, max-
                              depth=4, entry-flag-Z termination since
                              the body variant follows the chain — the
                              Y3 atomic 1 termination strategy).
       inner    : body       — peek-byte primitive dispatches on the
                              cursor's next byte's MID bit-range; arm
                              body codec re-reads same byte as own
                              header.

     Peek-byte arm coverage (per zenoh-pico response.network.h MIDs):
       0x04 → codec_zenoh_msg_reply (Z_REPLY arm — atomic 2b-i sub-codec)
       0x05 → codec_zenoh_msg_err   (Z_ERR arm — atomic 2b-i sub-codec)
       <sce:default> → codec_zenoh_msg_reply (catch-all preserves
       runtime mid for round-trip; in production a non-reply / non-err
       MID under Z_RESPONSE is a wire-protocol violation, so default
       arm is a defensive recovery shape rather than a routine path).

     Q4 envelope-only fidelity (RFC §5.B Y3 atomic 2b-ii peek-byte
     scoping): inner-level wire detail strips remain in scope of
     follow-up atomics — VLE-LSB-as-flag for inner encoding (atomic
     2b-iii-α), bit-shifted-length-prefix for timestamp (atomic
     2b-iii-β), source_info ext nested encoding (atomic 2b-iii-γ).
     The envelope-level framing here is wire-correct against
     network.c verbatim (header bits + max-depth=4 + entry-flag-Z
     chain termination + body MID dispatch); inner body details are
     stripped through the atomic 2b-i sub-codec layer (msg_reply /
     msg_err already inherit the Q1(b) envelope-only scoping).

     Cross-codec validator (RFC §5.B Y3 atomic 2b-ii peek-byte)
     confirms: codec_zenoh_msg_reply.header.mid (bit=0 width=5) +
     codec_zenoh_msg_err.header.mid (bit=0 width=5) match this
     peek-byte's mid declaration. The arm body codecs' additional
     flag declarations (R_C / X / E_E / Z at bits 5/6/7) sit outside
     the dispatch bit-range — peek-byte doesn't constrain them.

     Composition: B1-γ flags (header) + B5-μ X1 present-if + Y0a
     gated-string + B5-ζ Surface H string-vs-bytes + B5-κ Surface L
     dotted-path length-from + Y3 atomic 1 entry-flag termination + Y3
     atomic 2a present-if-on-tlv-chain + Y3 atomic 2b-i sub-codec
     embeds (atomic 2b-i msg_reply / msg_err arms) + Y3 atomic 2b-ii
     peek-byte primitive. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_zenoh_response">
  <sce:import src="codec_zenoh_ext_entry.scxml" kind="codec" as="codec_zenoh_ext_entry"/>
  <sce:import src="codec_zenoh_msg_reply.scxml" kind="codec" as="codec_zenoh_msg_reply"/>
  <sce:import src="codec_zenoh_msg_err.scxml"   kind="codec" as="codec_zenoh_msg_err"/>
  <datamodel>
    <sce:flags id="header" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="mid" bit="0" width="5"/>
      <sce:flag name="M"   bit="5"/>
      <sce:flag name="N"   bit="6"/>
      <sce:flag name="Z"   bit="7"/>
    </sce:flags>
    <sce:field id="request_id" sce:type="uint64" sce:byte="1" sce:bit-size="vle"/>
    <sce:field id="key_id" sce:type="uint32" sce:byte="2" sce:bit-size="vle"/>
    <sce:field id="suffix_len" sce:type="uint64" sce:byte="3" sce:bit-size="vle"
               sce:present-if="header.N"/>
    <sce:field id="suffix" sce:type="string" sce:byte="4" sce:bit-size="length-ref"
               sce:length-field="suffix_len" sce:max-size="256"
               sce:present-if="header.N"/>
    <sce:tlv-chain id="extensions" type="codec_zenoh_ext_entry" sce:byte="5"
                   max-depth="4" on-overflow="reject"
                   sce:present-if="header.Z"
                   terminate-on="entry-flag" entry-flag-name="Z"/>
    <sce:variant tag="peek.mid">
      <sce:peek-byte id="peek" sce:type="uint8">
        <sce:flag name="mid" bit="0" width="5"/>
      </sce:peek-byte>
      <sce:arm value="0x04" type="codec_zenoh_msg_reply"/>
      <sce:arm value="0x05" type="codec_zenoh_msg_err"/>
      <sce:default type="codec_zenoh_msg_reply"/>
    </sce:variant>
  </datamodel>
</scxml>
