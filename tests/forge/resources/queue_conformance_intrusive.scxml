<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCE Protocol-Synthesis RFC §synth-5-P (queue kind, intrusive storage): many
  producers and one consumer over nodes the caller owns. The selection table
  gives this Vyukov's MPSC list: push is wait-free, and pop blocks while a
  producer is between its two steps, so blocking is the strongest progress the
  document can declare. The conformance crates compile what the generator
  emits for it and run the queue.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://sce.dev/ext sce-forge.xsd"
       sce:kind="queue"
       name="queue_conformance_intrusive"
       version="1.0">
  <sce:element-type>queue_conformance_node</sce:element-type>
  <sce:producers>many</sce:producers>
  <sce:consumers>one</sce:consumers>
  <sce:progress>blocking</sce:progress>
  <sce:intrusive link-field="next"/>
</scxml>
