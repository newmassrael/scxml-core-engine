<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: present-if disjunction primitive (RFC §5.B
     atomic 2b-ii). One-byte uint8 carrier "flags" exposes two named
     bits "wants_a" (bit 0) and "wants_b" (bit 1). The trailing "seq"
     field is uint16 BE gated on sce:present-if="flags.wants_a ||
     flags.wants_b" — predicate fires when EITHER bit is set. Mirrors
     zenoh-pico's _Z_INTEREST_NOT_FINAL_MASK = (CURRENT | FUTURE)
     pattern (interest.h:35) where two flag bits independently signal
     a downstream-body presence and the encoder can set either one or
     both. The (carrier & MASK_A) != 0 || (carrier & MASK_B) != 0 test
     is the OR-chain shape generated by present_if_test_literal walking
     the or_with tail. v1 grammar binds || looser than the per-clause
     ! so chains like "!a.X || b.Y" parse as "(!a.X) || (b.Y)"; outer
     negation "!(a.X || b.Y)" defers to a future RFC stage. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_present_if_disjunction">
  <datamodel>
    <sce:flags id="flags" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="wants_a" bit="0"/>
      <sce:flag name="wants_b" bit="1"/>
    </sce:flags>
    <sce:field id="seq" sce:type="uint16" sce:byte="1" sce:bit-size="16"
               sce:present-if="flags.wants_a || flags.wants_b"/>
  </datamodel>
</scxml>
