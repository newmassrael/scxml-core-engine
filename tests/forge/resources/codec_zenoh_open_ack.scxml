<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: Zenoh transport-layer OpenAck body (RFC §5.B
     B5-ι — cross-codec composition fixture authoring the ~30 zenoh
     messages end-to-end on B1-B5 primitives).

     Upstream zenoh-pico shape (`_z_open_encode` in
     src/protocol/codec/transport.c:288-305 with the A-flag branch at
     line 300): when the transport-message header carries
     `_Z_FLAG_T_OPEN_A` (bit 5, value 0x20) the OpenAck variant skips
     the cookie field, so the body is just two VLE u64 fields — lease
     followed by initial_sn. The 1-byte header (MID + A/T/Z flags) is
     written by `_z_transport_message_encode` BEFORE dispatching to
     `_z_open_encode`, so the body codec scope is the two VLE fields
     alone. The OpenSyn (A=0) variant adds a length-prefixed cookie;
     that case is the codec_zenoh_open_syn fixture.

     Applied composition: B1-α VLE primitive on both fields, plain
     ordering (no parent flags, no variant — A=1 is implied by the
     enclosing envelope's MID + A flag). The lease semantics (T-flag
     scaling lease/1000 vs lease) is a host-level concern and not
     wire-visible — both branches encode the same VLE u64. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_zenoh_open_ack">
  <datamodel>
    <sce:field id="lease"      sce:type="uint64" sce:byte="0" sce:bit-size="vle"/>
    <sce:field id="initial_sn" sce:type="uint64" sce:byte="1" sce:bit-size="vle"/>
  </datamodel>
  <!-- RFC §5.B B5-θ inline test vectors. Pinned at VLE width
       boundaries on both fields (1-byte: 0/127, 2-byte: 128, 3-byte:
       16384) so cursor advance composition is exercised across mixed
       widths. -->
  <sce:test-vector hex="0000">
    <sce:decoded field="lease"      value="0"/>
    <sce:decoded field="initial_sn" value="0"/>
  </sce:test-vector>
  <sce:test-vector hex="0164">
    <sce:decoded field="lease"      value="1"/>
    <sce:decoded field="initial_sn" value="100"/>
  </sce:test-vector>
  <sce:test-vector hex="7f01">
    <sce:decoded field="lease"      value="127"/>
    <sce:decoded field="initial_sn" value="1"/>
  </sce:test-vector>
  <sce:test-vector hex="8001c801">
    <sce:decoded field="lease"      value="128"/>
    <sce:decoded field="initial_sn" value="200"/>
  </sce:test-vector>
</scxml>
