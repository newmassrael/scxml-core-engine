<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: a list read to the end of the frame holds no more
     entries than its max-count (docs/adr/0077 §2). The entry past the bound is
     refused before it is read, so a frame whose third entry is cut short is
     refused for its count and not for its missing bytes.

     Wire shape (codec_repeat_elem = uint16 BE seq):
       items     entries to the end of the frame, at most 2 -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_declared_bounds_to_end">
  <sce:import src="codec_repeat_elem.scxml" kind="codec" as="codec_repeat_elem"/>
  <datamodel>
    <sce:repeat id="items" type="codec_repeat_elem" sce:byte="0"
                until-eof="true" max-count="2"/>
  </datamodel>
</scxml>
