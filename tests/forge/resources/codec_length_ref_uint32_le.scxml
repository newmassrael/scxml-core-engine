<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: length-ref bytes with uint32 little-endian
     length-field. uint32 variant of codec_length_ref_uint16_le. For
     length=256 the wire is 0x00 0x01 0x00 0x00; the pre-refactor
     decode read only raw[0]=0x00 (truncating to a 0-byte slice) —
     the simple-path let-binding refactor (commit 948f73d0) folds
     all 4 bytes into the sibling local so the full length value
     reaches the slice end.

     Wire shape:
       byte 0..3 : payload_len (uint32 LE)
       byte 4+   : payload     (bytes, length = payload_len) -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="little" name="codec_length_ref_uint32_le">
  <datamodel>
    <sce:field id="payload_len" sce:type="uint32" sce:byte="0" sce:bit-size="32"/>
    <sce:field id="payload"     sce:type="bytes"  sce:byte="4" sce:bit-size="length-ref"
               sce:length-field="payload_len" sce:max-size="1024"/>
  </datamodel>
  <sce:test-vector hex="00000000">
    <sce:decoded field="payload_len" value="0"/>
    <sce:decoded field="payload" hex=""/>
  </sce:test-vector>
  <sce:test-vector hex="04000000aabbccdd">
    <sce:decoded field="payload_len" value="4"/>
    <sce:decoded field="payload" hex="aabbccdd"/>
  </sce:test-vector>
  <sce:test-vector hex="">
    <sce:decoded field="payload_len" value="256"/>
    <sce:decoded field="payload" hex=""/>
  </sce:test-vector>
</scxml>
