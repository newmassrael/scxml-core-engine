<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: codec until-eof repeat primitive (RFC §synth-5-B
     B2, until-eof shape). The `msgs` field greedily consumes
     `codec_repeat_elem` elements until the cursor has no remaining
     bytes; a partial trailing element returns NeedMoreBytes (the
     element's own decode() surfaces the truncation). v1 trunk ships
     Rust + Cpp byte-stable goldens; Kotlin / Go / C11 / Python gate
     via `generate/unsupported-feature` until per-language closures
     land. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_until_eof_basic">
  <sce:import src="codec_repeat_elem.scxml" kind="codec" as="codec_repeat_elem"/>
  <datamodel>
    <sce:repeat id="msgs" type="codec_repeat_elem" sce:byte="0"
                until-eof="true" max-count="64"/>
  </datamodel>
</scxml>
