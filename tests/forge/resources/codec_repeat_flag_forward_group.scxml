<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: a list on one side of a gate, held to the law its
     entries say the codec's own input by.

     The hand-over of `codec_chain_flag_forward`, in a group. The caller of
     this codec decides `wide`, and the codec hands it on to every element of
     the repeat, which says it back. Where L is set the frame holds the count
     and the elements; where it is clear, `note`. The fields L decides are one
     group of two arms (docs/adr/0065 §6 R4b), and the elements say the input
     the codec hands them, so the list is held to the law they say it by (R8):
     the value says `wide` by the list's start where it holds the arm that
     holds the list, and nothing of it where it holds `note`.

     Wire shape:
       byte 0  : head  (bit 0 = L)
       L set   : count (uint8), then `count` elements, each laid out by `wide`
       L clear : note  (uint8) -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_repeat_flag_forward_group">
  <sce:import src="codec_chain_flag_entry.scxml" kind="codec" as="codec_chain_flag_entry">
    <sce:flag-bind input="wide" source="wide"/>
  </sce:import>
  <sce:flag-inputs>
    <sce:flag-input name="wide" width="1"/>
  </sce:flag-inputs>
  <datamodel>
    <sce:flags id="head" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="L" bit="0"/>
    </sce:flags>
    <sce:field id="count" sce:type="uint8" sce:byte="1" sce:bit-size="8"
               sce:present-if="head.L"/>
    <sce:repeat id="entries" type="codec_chain_flag_entry" sce:byte="2"
                count="count" max-count="4"
                sce:present-if="head.L"/>
    <sce:field id="note" sce:type="uint8" sce:byte="3" sce:bit-size="8"
               sce:present-if="!head.L"/>
  </datamodel>
</scxml>
