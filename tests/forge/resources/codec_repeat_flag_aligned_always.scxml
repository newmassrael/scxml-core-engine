<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: a list always there held to its law that shares
     its count with a list a gate decides.

     The other side of `codec_repeat_flag_aligned_group`: here the list always
     on the wire is the one whose elements are handed W as their `wide`
     input, and the gated list is plain. `links` is always there and its
     length is written once; `weights` is there only where H is set, of as
     many elements. The two lists are one group of H (docs/adr/0065 §6 R5):
     the arm where H is set holds both as two lists of one count, the other
     `links` alone. The elements of `links` say the input W hands them, so
     that list is held to the law they say it by (R8) in both arms: W is its
     start whichever arm the value holds.

     Wire shape:
       byte 0  : head      (bit 0 = W, bit 1 = H)
       byte 1  : links_len (uint8, always there)
       then    : links     (`links_len` elements, each laid out by W)
       H set   : weights   (`links_len` elements of codec_repeat_elem) -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_repeat_flag_aligned_always">
  <sce:import src="codec_repeat_elem.scxml" kind="codec" as="codec_repeat_elem"/>
  <sce:import src="codec_chain_flag_entry.scxml" kind="codec" as="codec_chain_flag_entry">
    <sce:flag-bind input="wide" source="head.W"/>
  </sce:import>
  <datamodel>
    <sce:flags id="head" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="W" bit="0"/>
      <sce:flag name="H" bit="1"/>
    </sce:flags>
    <sce:field id="links_len" sce:type="uint8" sce:byte="1" sce:bit-size="8"/>
    <sce:repeat id="links" type="codec_chain_flag_entry" sce:byte="2"
                count="links_len" max-count="4"/>
    <sce:repeat id="weights" type="codec_repeat_elem" sce:byte="3"
                count="links_len" max-count="4"
                sce:present-if="head.H"/>
  </datamodel>
</scxml>
