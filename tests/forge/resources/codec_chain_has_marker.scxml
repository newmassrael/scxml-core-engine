<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: a field whose shape depends on a marker entry in
     an extension chain, when the entry's continuation flag is part of the
     byte that identifies it.

     The payload is laid out in one of two ways. When the chain carries the
     marker entry `0x12` — identifier 2 with the mandatory bit set and the
     unit encoding — it is a count of slices followed by that many slices
     (`codec_chain_has_marker_slice`); when it does not, it is a length followed by
     that many bytes. Nothing in the header says which.

     The marker is not always the last entry. Every entry but the last has
     its continuation flag `Z` set, so the same marker is the byte 0x12 at
     the end of the chain and 0x92 in the middle of it. The chain therefore
     says that the identifier is the whole `header` with the continuation
     flag left out (`entry-id="header"` `entry-id-except="header.Z"`), and
     `has(0x12)` is true for both. An entry that shares only the 4-bit id —
     the mandatory bit clear, or another encoding — is a different kind, and
     `!has(0x12)` is true for it.

     The chain is itself gated (`header.E`), so the document also covers a
     chain that is absent: no entries, `has(0x12)` false.

     Composition: flags + gated tlv-chain with entry-flag termination + an
     identifier that leaves a flag out + chain-membership predicate (positive
     and negated) on a VLE field, a length-ref bytes field, a VLE count and a
     repeat. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_chain_has_marker">
  <sce:import src="codec_zenoh_ext_entry.scxml" kind="codec" as="codec_zenoh_ext_entry"/>
  <sce:import src="codec_chain_has_marker_slice.scxml" kind="codec" as="codec_chain_has_marker_slice"/>
  <datamodel>
    <sce:flags id="header" sce:type="uint8" sce:byte="0" sce:bit-size="8">
      <sce:flag name="kind" bit="0" width="5"/>
      <sce:flag name="E"    bit="7"/>
    </sce:flags>
    <sce:tlv-chain id="extensions" type="codec_zenoh_ext_entry" sce:byte="1"
                   max-depth="4" on-overflow="reject" sce:present-if="header.E"
                   terminate-on="entry-flag" entry-flag-name="Z"
                   entry-id="header" entry-id-except="header.Z"/>
    <sce:field id="payload_len" sce:type="uint64" sce:byte="2" sce:bit-size="vle"
               sce:present-if="!extensions.has(0x12)"/>
    <sce:field id="payload" sce:type="bytes" sce:byte="3" sce:bit-size="length-ref"
               sce:length-field="payload_len" sce:max-size="256"
               sce:present-if="!extensions.has(0x12)"/>
    <sce:field id="slice_count" sce:type="uint32" sce:byte="4" sce:bit-size="vle"
               sce:present-if="extensions.has(0x12)"/>
    <sce:repeat id="slices" type="codec_chain_has_marker_slice" sce:byte="5"
                count="slice_count" max-count="4"
                sce:present-if="extensions.has(0x12)"/>
  </datamodel>
</scxml>
