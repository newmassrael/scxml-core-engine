<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: cross-file composition — validator importing transform -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="validator" version="1.0">
  <sce:import src="transform_temperature.scxml" kind="transform" as="tempConvert"/>

  <datamodel>
    <data id="rawTemp" sce:type="uint16" sce:direction="in"
          sce:range-min="0" sce:range-max="4095"/>
    <data id="valid" sce:type="bool" sce:direction="out"
          sce:plausibility="tempConvert(rawTemp) &gt; -40 &amp;&amp; tempConvert(rawTemp) &lt; 200"/>
  </datamodel>
</scxml>
