<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: cross-file composition — validator importing transform -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="validator" version="1.0">
  <sce:import src="transform_temperature.scxml" kind="transform" as="tempConvert"/>

  <datamodel>
    <data id="rawTemp" sce:type="uint16" sce:direction="in"/>
  </datamodel>

  <sce:rules>
    <sce:range id="rawTemp" min="0" max="4095"/>
    <sce:plausibility expr="tempConvert(rawTemp) > -40 &amp;&amp; tempConvert(rawTemp) &lt; 200"/>
  </sce:rules>
</scxml>
