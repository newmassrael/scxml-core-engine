<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.4: the smallest template that carries a
     formal parameter and both kinds of value a matcher names, a literal and
     a parameter, over a type the document spells itself. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="test_template_ast_export_min"
       sce:type="uint32">
  <datamodel>
    <data id="limit" sce:type="uint32" sce:direction="in"/>
  </datamodel>
  <sce:value-range>
    <sce:lower value="0"/>
    <sce:upper param="limit"/>
  </sce:value-range>
</scxml>
