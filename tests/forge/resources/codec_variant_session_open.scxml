<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: variant arm body — session-open frame.
     Imported by codec_variant_dispatch.scxml as one of the
     enumerated arms; carries a single uint16 protocol version. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:default-endian="big" name="codec_variant_session_open">
  <datamodel>
    <data id="version" sce:type="uint16" sce:byte="0" sce:bit-size="16"/>
  </datamodel>
</scxml>
