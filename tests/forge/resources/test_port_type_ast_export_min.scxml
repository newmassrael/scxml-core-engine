<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.3: the smallest port type, one message of
     the one-field event schema of the sibling export fixture, carried both
     ways. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="test_port_type_ast_export_min">
  <sce:import kind="event-schema" src="event_schema_ast_export_min.scxml" as="Byte"/>
  <sce:message type="Byte" direction="inout"/>
</scxml>
