<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Forge conformance: cross-file composition — procedure invoking filter update -->
<!-- Procedure imports a stateful filter and dispatches the filter's update()
     method via <assign location="smoothed" expr="smoother.update(rawSample)"/>.
     Verifies that cross-file member-method calls on a non-codec stateful kind
     route through the same expression pipeline as codec.encode() across all
     six backends. Filter return is a primitive (float64) so the C11 lowering
     calls the kind's free function (`<snake>_update`) directly — no wrapper
     conversion needed (codec's `<send sce:payload>` wrapper is codec-only). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="procedure" initial="sample" version="1.0">
  <sce:import src="filter_low_pass.scxml" kind="filter" as="smoother"/>

  <datamodel>
    <data id="rawSample" sce:type="float64" sce:direction="in"/>
    <data id="smoothed" sce:type="float64" sce:direction="internal"/>
  </datamodel>

  <state id="sample">
    <transition target="done">
      <assign location="smoothed" expr="smoother.update(rawSample)"/>
    </transition>
  </state>

  <final id="done">
    <donedata><param name="result" expr="'success'"/></donedata>
  </final>
</scxml>
