<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template parity template: inner.

  One required `endpoint` parameter substituted into the `cond`
  attribute of a single `<transition>` body element. Reached via
  `outer.scxml`'s nested `<sce:use>`; `{$endpoint}` resolves to
  `host:8080` once both expansion layers complete.
-->
<sce:template xmlns:sce="http://sce.dev/ext" name="inner">
  <sce:param name="endpoint" required="true"/>
  <transition event="connect" cond="_event.data.target == '{$endpoint}'" target="accept"/>
</sce:template>
