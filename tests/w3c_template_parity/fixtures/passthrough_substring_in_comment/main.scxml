<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template parity fixture: passthrough_substring_in_comment.

  Replay of the Rust unit test `passthrough_when_substring_but_no_element`
  (sce-build/src/template.rs::tests). The string "sce:use"
  appears inside a comment and an attribute value, but no
  `<sce:use>` element exists. Both producers must scan the
  document tree (not the byte content) to decide there is no
  expansion to perform — short-circuiting on the substring alone
  would be a false positive, and short-circuiting after element
  scan is the correct identity path.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="idle">
  <!-- instructional comment: how to sce:use this template family -->
  <state id="idle" description="how to sce:use this idle state">
    <transition event="go" target="running"/>
  </state>
  <state id="running">
    <transition event="stop" target="idle"/>
  </state>
</scxml>
