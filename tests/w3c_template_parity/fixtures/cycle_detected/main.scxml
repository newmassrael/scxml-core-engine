<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template error-path parity fixture: cycle_detected.

  `main.scxml` invokes `a.scxml`; `a.scxml`'s body uses
  `b.scxml`; `b.scxml`'s body uses `a.scxml` — completing the
  cycle. Both producers (Rust `sce-codegen expand` and C++
  `PugiXMLDocument::processSceTemplate`) must FAIL with
  equivalent error classifications:
    - Rust emits DiagnosticCode `xml/template-cycle` on stderr.
    - C++ throws `SCE::parsing::TemplateCycle`.
  The harness asserts discriminant agreement, not message bytes
  (RFC §3 M3 pins this explicitly — error messages are UX
  surface, byte-equivalence is too strict).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="s1"
       name="cycle_detected">
  <state id="s1">
    <sce:use template="a.scxml"/>
  </state>
</scxml>
