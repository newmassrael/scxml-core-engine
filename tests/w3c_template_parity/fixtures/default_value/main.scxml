<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template parity fixture: default_value.

  Replay of the Rust unit test `default_value_substitutes_when_call_site_omits`
  (sce-build/src/template.rs::tests). The caller omits the
  `proto` parameter on `<sce:use>`; the template declares
  `<sce:param name="proto" default="TCP"/>`, so both producers
  must substitute the literal `TCP` into every `{$proto}` token
  in the template body. First harness entry that exercises the
  `default="..."` fallback path — existing `with_params/`
  covers the call-site-supplied path but not the default-fallback
  path.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="idle">
  <state id="idle">
    <sce:use template="greeter.scxml"/>
  </state>
  <state id="done"/>
</scxml>
