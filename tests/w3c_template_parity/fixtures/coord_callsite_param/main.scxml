<?xml version="1.0" encoding="UTF-8"?>
<!--
  Coordinate-parity fixture: coord_callsite_param.

  Caller supplies `bogus="x"` which `t.scxml` does not declare.
  Both producers must:
    - Emit DiagnosticCode `xml/template-unknown-param` (Rust NDJSON)
      / throw `SCE::parsing::TemplateUnknownParam` (C++).
    - Pin the diagnostic's `location.{file, line, col}` at the
      caller's `<sce:use>` element in this file. The depth-1
      collapse rule collapses every call-site binding failure to the caller row
      so a repair loop sees one pointed line in the author file.

  This fixture is one of three P3 entries that opt in to
  coordinate-agreement assertion via the
  `assertCoordinateAgreement` parameter on `runErrorParityFixture`.
  The five pre-P3 error fixtures (cycle_detected, not_found,
  malformed, missing_attribute) keep the discriminant-only
  contract — opt-in, not retroactive.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="s1"
       name="coord_callsite_param">
  <state id="s1">
    <sce:use template="t.scxml" bogus="x"/>
  </state>
</scxml>
