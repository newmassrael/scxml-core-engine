#pragma once

#include "ScheduledAotTest.h"
#include "test@TEST_NUMBER@_sm.h"

namespace SCE::W3C::AotTests {

/**
 * @brief W3C conformance test @TEST_NUMBER@
 *
 * The section it targets is `specnum` in resources/@TEST_NUMBER@/metadata.txt,
 * and its description is that file's `description`, which
 * AotTestBase::getDescription() reads at run time. This header restates
 * neither; `sce-codegen check-aot-briefs` refuses a brief that states the
 * section.
 */
struct Test@TEST_NUMBER@ : public ScheduledAotTest<Test@TEST_NUMBER@, @TEST_NUMBER@> {
    using SM = SCE::Generated::test@TEST_NUMBER@::test@TEST_NUMBER@;
};

// Auto-register
inline static AotTestRegistrar<Test@TEST_NUMBER@> registrar_Test@TEST_NUMBER@;

}  // namespace SCE::W3C::AotTests
