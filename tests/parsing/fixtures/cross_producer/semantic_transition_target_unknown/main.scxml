<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cross-producer fixture: `<transition target>` names a state that is
  not declared. key_fragments are (owning state, "transition-target",
  target).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext" version="1.0" initial="s1">
  <state id="s1">
    <transition target="ghost"/>
  </state>
</scxml>
