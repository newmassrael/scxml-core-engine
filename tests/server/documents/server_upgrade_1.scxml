<!--
  datamodel="sce-static" (docs/SCE_ACCEPTED_SUBSET.md §2.15; docs/adr/0109, D11
  and D9): the first version of the document tests/server serves under load and
  upgrades in place (a_server_upgraded_in_place_under_load_loses_nothing).
  server_upgrade_2.scxml is the next version, which restores what this one
  saved through the migration it declares from shapes/server_upgrade_1.shape.

  A session, one per `key` the client names, starts `fresh`, records tags in
  `active` (each answered with its position and reminded to the client three
  seconds later by a delayed send), keeps a note the client signed
  (service.request.note) or sealed (service.request.seal) by name and verifies
  or opens it with its host, verifies the kept object again on
  service.request.recheck, stops recording in `closed`, and ends at `ended`.
  `read` answers what it holds from any state but `ended`.

  Every request is answered in the macrostep that takes it, so that the answer
  carries the request's invocation id and a request sent again is answered with
  the first answer (SCE_MESH.md section 10.5).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="fresh" datamodel="sce-static" name="server_upgrade_1">
  <sce:import kind="event-schema" src="upgrade_take.scxml" as="Take"/>
  <sce:import kind="event-schema" src="upgrade_taken.scxml" as="Taken"/>
  <sce:import kind="event-schema" src="upgrade_reminded.scxml" as="Reminded"/>
  <sce:import kind="event-schema" src="upgrade_signed.scxml" as="Signed"/>
  <sce:import kind="event-schema" src="upgrade_sealed.scxml" as="Sealed"/>
  <sce:import kind="event-schema" src="upgrade_read.scxml" as="Read"/>
  <sce:import kind="event-schema" src="upgrade_note_1.scxml" as="Note"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_verify1_request.scxml" as="Verify1Request"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_verify1_result.scxml" as="Verify1Result"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_decrypt0_request.scxml" as="Decrypt0Request"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_decrypt0_result.scxml" as="Decrypt0Result"/>
  <datamodel>
    <data id="taken" sce:type="uint32" expr="0"/>
    <data id="last_tag" sce:type="string[32]" expr="''"/>
    <data id="signed" sce:type="bytes[cose_signed=4352]" expr="''"/>
    <data id="sealed" sce:type="bytes[cose_sealed=4480]" expr="''"/>
    <data id="verified" sce:type="bool" expr="false"/>
    <data id="opened" sce:type="bool" expr="false"/>
    <data id="failure" sce:type="string[24]" expr="''"/>
    <data id="note" sce:type="optional&lt;record:Note&gt;" expr="null"/>
    <data id="sealed_note" sce:type="optional&lt;record:Note&gt;" expr="null"/>
  </datamodel>

  <state id="fresh">
    <!-- The client is told a session of its key was started; a restore enters no state, so it
         is told once for each session. -->
    <onentry>
      <send target="#client" event="opened"/>
    </onentry>
    <transition event="service.request.take" target="active">
      <assign location="taken" expr="taken + 1"/>
      <assign location="last_tag" expr="_event.data.tag"/>
      <send target="#client" event="service.response.take">
        <param name="tag" expr="_event.data.tag"/>
        <param name="position" expr="taken"/>
        <param name="state" expr="'active'"/>
      </send>
      <send target="#client" event="reminded" delay="3s">
        <param name="tag" expr="_event.data.tag"/>
      </send>
    </transition>
    <transition event="service.request.read" type="internal">
      <send target="#client" event="service.response.read">
        <param name="state" expr="'fresh'"/>
        <param name="taken" expr="taken"/>
        <param name="last_tag" expr="last_tag"/>
        <param name="verified" expr="verified"/>
        <param name="serial" expr="note !== null ? note.value.serial : 0"/>
        <param name="owner" expr="note !== null ? note.value.owner : ''"/>
        <param name="rank" expr="0"/>
        <param name="label" expr="''"/>
        <param name="opened" expr="opened"/>
        <param name="sealed_serial" expr="sealed_note !== null ? sealed_note.value.serial : 0"/>
        <param name="sealed_label" expr="''"/>
        <param name="ceiling" expr="0"/>
      </send>
    </transition>
  </state>

  <state id="active">
    <transition event="service.request.take" type="internal">
      <assign location="taken" expr="taken + 1"/>
      <assign location="last_tag" expr="_event.data.tag"/>
      <send target="#client" event="service.response.take">
        <param name="tag" expr="_event.data.tag"/>
        <param name="position" expr="taken"/>
        <param name="state" expr="'active'"/>
      </send>
      <send target="#client" event="reminded" delay="3s">
        <param name="tag" expr="_event.data.tag"/>
      </send>
    </transition>
    <transition event="service.request.note" target="verifying">
      <assign location="signed" expr="_event.data.cose"/>
      <send target="#client" event="service.response.note"/>
    </transition>
    <transition event="service.request.recheck" target="verifying">
      <send target="#client" event="service.response.recheck"/>
    </transition>
    <transition event="service.request.seal" target="opening">
      <assign location="sealed" expr="_event.data.cose"/>
      <send target="#client" event="service.response.seal"/>
    </transition>
    <transition event="service.request.close" target="closed">
      <send target="#client" event="service.response.close"/>
    </transition>
    <transition event="service.request.read" type="internal">
      <send target="#client" event="service.response.read">
        <param name="state" expr="'active'"/>
        <param name="taken" expr="taken"/>
        <param name="last_tag" expr="last_tag"/>
        <param name="verified" expr="verified"/>
        <param name="serial" expr="note !== null ? note.value.serial : 0"/>
        <param name="owner" expr="note !== null ? note.value.owner : ''"/>
        <param name="rank" expr="0"/>
        <param name="label" expr="''"/>
        <param name="opened" expr="opened"/>
        <param name="sealed_serial" expr="sealed_note !== null ? sealed_note.value.serial : 0"/>
        <param name="sealed_label" expr="''"/>
        <param name="ceiling" expr="0"/>
      </send>
    </transition>
  </state>

  <!-- The kept object, verified by name: the note it holds is kept when it
       verified, and a failure is kept as its code. -->
  <state id="verifying">
    <invoke type="sce-host-cose-verify1" id="verify" sce:request="Verify1Request" sce:result="Verify1Result" sce:payload="Note">
      <param name="trust_set" expr="'devices'"/>
      <param name="cose" expr="signed"/>
      <param name="external_aad" expr="''"/>
    </invoke>
    <transition event="done.invoke.verify" cond="_event.data.error === ''" target="active">
      <assign location="note" expr="_event.data.payload"/>
      <assign location="verified" expr="_event.data.valid"/>
    </transition>
    <transition event="done.invoke.verify" target="active">
      <assign location="verified" expr="false"/>
      <assign location="failure" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="active">
      <assign location="failure" expr="'refused'"/>
    </transition>
  </state>

  <!-- The kept object, opened by name. -->
  <state id="opening">
    <invoke type="sce-host-cose-decrypt0" id="open" sce:request="Decrypt0Request" sce:result="Decrypt0Result" sce:payload="Note">
      <param name="key_id" expr="'vault'"/>
      <param name="cose" expr="sealed"/>
      <param name="external_aad" expr="''"/>
    </invoke>
    <transition event="done.invoke.open" cond="_event.data.error === ''" target="active">
      <assign location="sealed_note" expr="_event.data.plaintext"/>
      <assign location="opened" expr="_event.data.opened"/>
    </transition>
    <transition event="done.invoke.open" target="active">
      <assign location="opened" expr="false"/>
      <assign location="failure" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="active">
      <assign location="failure" expr="'refused'"/>
    </transition>
  </state>

  <!-- Recording has stopped: a tag is answered and not recorded. -->
  <state id="closed">
    <transition event="service.request.take" type="internal">
      <send target="#client" event="service.response.take">
        <param name="tag" expr="_event.data.tag"/>
        <param name="position" expr="taken"/>
        <param name="state" expr="'closed'"/>
      </send>
    </transition>
    <transition event="service.request.end" target="ended">
      <send target="#client" event="service.response.end"/>
    </transition>
    <transition event="service.request.read" type="internal">
      <send target="#client" event="service.response.read">
        <param name="state" expr="'closed'"/>
        <param name="taken" expr="taken"/>
        <param name="last_tag" expr="last_tag"/>
        <param name="verified" expr="verified"/>
        <param name="serial" expr="note !== null ? note.value.serial : 0"/>
        <param name="owner" expr="note !== null ? note.value.owner : ''"/>
        <param name="rank" expr="0"/>
        <param name="label" expr="''"/>
        <param name="opened" expr="opened"/>
        <param name="sealed_serial" expr="sealed_note !== null ? sealed_note.value.serial : 0"/>
        <param name="sealed_label" expr="''"/>
        <param name="ceiling" expr="0"/>
      </send>
    </transition>
  </state>

  <final id="ended"/>
</scxml>
