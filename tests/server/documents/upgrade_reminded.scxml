<!--
  What the upgraded document sends the client a while after it recorded a
  tag (upgrade_take.scxml): a delayed send a stop and a restart carry.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="upgrade_reminded"
       sce:event-name="reminded">
  <datamodel>
    <data id="tag" sce:type="string[32]" sce:direction="in"/>
  </datamodel>
</scxml>
