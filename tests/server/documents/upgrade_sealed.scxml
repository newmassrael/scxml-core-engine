<!--
  A request of the upgraded document: keep `cose`, a COSE_Encrypt0 of a note
  (upgrade_note_1.scxml) the client sealed by name, and open it.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="upgrade_sealed"
       sce:event-name="service.request.seal">
  <datamodel>
    <data id="key" sce:type="string[32]" sce:direction="in"/>
    <data id="cose" sce:type="bytes[cose_sealed=4480]" sce:direction="in"/>
  </datamodel>
</scxml>
