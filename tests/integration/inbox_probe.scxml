<!--
  The smallest machine with a host-run invocation whose every taken event can
  be read back in order: what WhatAnotherThreadPostsEntersThroughTheInboxAotTest
  posts to the generated C++ engine's inbox from other threads, and
  backends/rust/tests/tests/what_another_thread_posts_enters_through_the_inbox.rs
  to the Rust engine's (docs/adr/0084, ARCHITECTURE.md "Engine Threading").

  `working` (initial) starts the host-run invocation `job` on entry and so
  cancels it on exit; `leave` goes to `idle` and `go` back, which starts `job`
  again under a new token. `ping`, `done.invoke.job` and `error.invoke.job`
  are taken in either state, by `running`, and appended to `taken` as
  `ping:<data>;`, `done:<data>;` and `failed:<data>;`, so the variable is the
  order the machine took them in.

  It sits beside its C++ driver, as parallel_current_state.scxml does. The C++
  engine, the C11 machine and the Rust engine are driven with it, each machine
  generated with the host-invoker declaration `x-sce-host`
  (tests/CMakeLists.txt and backends/c/tests/CMakeLists.txt at build time, and
  tools/codegen/trees/rust-integration.toml for the committed Rust tree).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       name="inbox_probe" datamodel="ecmascript" initial="running">

  <datamodel>
    <data id="taken" expr="''"/>
  </datamodel>

  <state id="running" initial="working">
    <transition event="ping">
      <assign location="taken" expr="taken + 'ping:' + _event.data + ';'"/>
    </transition>
    <transition event="done.invoke.job">
      <assign location="taken" expr="taken + 'done:' + _event.data + ';'"/>
    </transition>
    <transition event="error.invoke.job">
      <assign location="taken" expr="taken + 'failed:' + _event.data + ';'"/>
    </transition>

    <state id="working">
      <invoke id="job" type="x-sce-host"/>
      <transition event="leave" target="idle"/>
    </state>

    <state id="idle">
      <transition event="go" target="working"/>
    </state>
  </state>
</scxml>
