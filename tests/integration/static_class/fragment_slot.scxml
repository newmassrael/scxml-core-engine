<?xml version="1.0" encoding="UTF-8"?>
<!--
  A reassembly slot machine of the static class (docs/adr/0135), shaped as the
  reassembly machine of a downstream bare-metal consumer's image is: flat, 6
  states and 12 transitions. A message arrives as fragments and the machine
  runs once for every fragment, so its step is the image's most frequent one.

  It reaches what the class walker does for a flat document: an external self-transition
  that exits and enters its state again (fragment.last in empty, a restart in
  filling), a targetless transition (fragment.next in filling), an eventless
  transition taken as soon as its state is entered (complete), and a
  top-level <final> that ends the run (released).

  Tabled twice, for the class walker and for the general interpreter, and the
  two held to each other with seeded random events by
  sce-build/tests/the_class_walker_runs_as_the_general_interpreter_does.rs.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       name="fragment_slot"
       initial="empty"
       datamodel="null">
  <state id="empty">
    <onentry>
      <sce:action name="clear_slot" effect="notice"/>
    </onentry>
    <transition event="fragment.first" target="filling">
      <sce:action name="start_message" effect="notice"/>
    </transition>
    <transition event="fragment.next" target="discarding"/>
    <transition event="fragment.last" target="empty">
      <sce:action name="deliver_single" effect="notice"/>
    </transition>
    <transition event="slot.release" target="released"/>
  </state>
  <state id="filling">
    <transition event="fragment.next">
      <sce:action name="append_fragment" effect="notice"/>
    </transition>
    <transition event="fragment.last" target="complete">
      <sce:action name="append_fragment" effect="notice"/>
    </transition>
    <transition event="fragment.first" target="filling">
      <sce:action name="restart_message" effect="notice"/>
    </transition>
    <transition event="slot.timeout" target="expired"/>
  </state>
  <state id="complete">
    <onentry>
      <sce:action name="deliver_message" effect="notice"/>
    </onentry>
    <transition target="empty"/>
  </state>
  <state id="discarding">
    <transition event="fragment.last" target="empty"/>
    <transition event="fragment.first" target="filling"/>
  </state>
  <state id="expired">
    <onentry>
      <sce:action name="report_expired" effect="notice"/>
    </onentry>
    <transition event="slot.reset" target="empty"/>
  </state>
  <final id="released"/>
</scxml>
