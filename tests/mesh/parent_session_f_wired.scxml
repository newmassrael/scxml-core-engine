<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Mesh §9.6 Session F full lifecycle verification — parent.
     Declared in deploy_session_f_wired.yaml, which registers peer
     `worker_session_f_wired`. On entry of `waiting`, the parent emits
     wire-14 `InvokeStart` via the `/sce_p2c_*` shm channel. The worker's
     transport pump instantiates a trivial-final child, publishes wire-15
     `InvokeStarted` (sessionId stash) and immediately wire-18
     `InvokeDone` (child reached `<final>` during initialize). MeshDispatch
     on the parent raises `done.invoke.<id>` which this transition
     observes — the shortest success path through §9.6's full lifecycle. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="waiting" name="parent_session_f_wired">
    <state id="waiting">
        <invoke type="scxml" src="#worker_session_f_wired" id="remote_inv"/>
        <transition event="done.invoke" target="pass"/>
        <transition event="done.invoke.remote_inv" target="pass"/>
        <transition event="error.execution" target="fail"/>
    </state>
    <final id="pass"/>
    <final id="fail"/>
</scxml>
