<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Mesh gap S6: SOME/IP EventUnsubscribe E2E fixture (subscriber side).
     Dedicated fixture pair so Session C's multi-pattern tests keep their
     precise assertions undisturbed. Exercises ONLY the subscribe →
     unsubscribe lifecycle; the multi-pattern fixture covers the rest of
     the capability matrix. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       datamodel="null" name="brake_someip_unsub" initial="idle">
    <state id="idle">
        <transition event="ui.subscribe" target="subscribed"/>
    </state>
    <state id="subscribed">
        <onentry>
            <send target="#motor" event="event.subscribe.speed"/>
        </onentry>
        <transition event="ui.unsubscribe" target="unsubscribed"/>
        <transition event="field.notify.vehicle_speed"/>
    </state>
    <state id="unsubscribed">
        <onentry>
            <send target="#motor" event="event.unsubscribe.speed"/>
        </onentry>
        <transition event="field.notify.vehicle_speed"/>
    </state>
</scxml>
