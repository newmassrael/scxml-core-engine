<?xml version="1.0" encoding="UTF-8"?>
<!-- Motor receiver used for mesh topology validation and Session E
     server-side codegen verification. The build-time UncoveredEvents
     check requires every <send event="X"> in the sender to have a
     matching <transition event="X"> here.

     Session E: motor is an RPC server for compute_force. The topology
     analyzer detects the (service.request.compute_force,
     service.response.compute_force) pair and generates server-side
     Zenoh registration (declare_queryable + Query::reply). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       datamodel="null" name="motor" initial="ready">
    <state id="ready">
        <transition event="service.fire_forget.activate" target="ready"/>
        <transition event="service.request.compute_force" target="computing"/>
        <transition event="event.subscribe.status" target="ready"/>
        <!-- FieldAccess responses (SCE_MESH.md §8.3): raise field.notify.X
             as the spec-canonical reply form. inject_server_response_sends
             appends a synthetic <send> alongside each raise so the transport
             layer routes the response (Zenoh Query::reply) — identical
             mechanics to service.response. -->
        <transition event="field.set.position" target="ready">
            <raise event="field.notify.position"/>
        </transition>
        <transition event="field.get.position" target="ready">
            <raise event="field.notify.position"/>
        </transition>
    </state>
    <state id="computing">
        <onentry>
            <raise event="service.response.compute_force"/>
        </onentry>
        <transition target="ready"/>
    </state>
</scxml>
