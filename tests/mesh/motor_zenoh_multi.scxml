<?xml version="1.0" encoding="UTF-8"?>
<!-- Motor receiver used for mesh topology validation only — the build-
     time UncoveredEvents check requires every <send event="X"> in the
     sender to have a matching <transition event="X"> here. The runtime
     E2E test (test_mesh_zenoh_multipattern_runtime.cpp) does NOT load
     this state machine; it stands up raw zenoh queryable/subscriber/
     publisher endpoints on the motor side to exercise each pattern.
     This file's only job is to satisfy codegen-time validation. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       datamodel="null" name="motor" initial="ready">
    <state id="ready">
        <transition event="service.fire_forget.activate" target="ready"/>
        <transition event="service.request.compute_force" target="ready"/>
        <transition event="event.subscribe.status" target="ready"/>
        <transition event="field.set.position" target="ready"/>
        <transition event="field.get.position" target="ready"/>
    </state>
</scxml>
