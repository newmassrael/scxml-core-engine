<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Mesh §14.4 DDS bounded pool fixture (sender side).

     One `<send>` to the pooled `#sensor` target makes the binding
     reachable, so codegen emits the pool's endpoints and its dispatch
     arm. §1-§3 of the runtime test drive `route_send` directly with an
     explicit member value, because "which endpoint did the value select"
     is a fact about the transport router.

     This comment used to argue that driving the `<send>` from `<onentry>`
     would only test the same arm through a longer path. That was wrong,
     and the cost was concrete: the `corner` param emitted
     `std::to_string('front_left')` — a C++ multi-character literal, so
     the value on the wire was a number — and because nothing entered
     `sending`, it compiled and shipped unread. §4 now drives the engine,
     which is what makes the param path observable at all.

     The document declared `datamodel="null"` while carrying `<param
     expr>` for as long as the attribute reached no decision. W3C SCXML
     B.1.4 gives the Null data model no value expression language, so
     `ecmascript` is what these params were always written in. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="pool_sender_dds" initial="idle">
    <state id="idle">
        <transition event="ping.sensor" target="sending"/>
    </state>
    <state id="sending">
        <onentry>
            <send target="#sensor" event="service.request.ping">
                <param name="corner" expr="'front_left'"/>
            </send>
        </onentry>
        <transition event="service.response.ping" target="idle"/>
    </state>
</scxml>
