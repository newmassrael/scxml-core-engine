<?xml version="1.0" encoding="UTF-8"?>
<!--
    SCE Mesh §14 — first-party partitions: ctest fixture.

    Two orthogonal regions (left, right) under <parallel id="root">.
    Each region holds two intermediate states and a `<final>` child.
    Reaching either region's `<final>` triggers (in distributed
    deployments) a `ParallelRegionDone` envelope (wire 21, §16.5).
    The Root partition aggregates local + remote completions and
    raises `done.state.root`, which the parallel-level transition
    routes to `<final id="all_done">` so a single `getCurrentState()`
    check on the Root SM proves the wire-21 round-trip.

    `<donedata>` is intentionally omitted on every `<final>`: the
    null datamodel cannot evaluate `<content>` expressions and a
    payloaded final would force the SM to link the script engine
    even though no SCXML in this fixture actually scripts. The
    wire-21 envelope still carries `subject = "<parallel>/<region>"`
    on every region transition into final, which is the only
    correlation handle the §16.5 tracker needs.

    The SCXML is intentionally clean against the four R1-R4
    distributability axes the §16.3 analyzer scope describes:

      - R1 (ancestor-scope <data> writes): no <data> declarations.
      - R2 (cross-region transitions):     every region-internal
                                            transition stays within
                                            its own region.
      - R3 (ancestor-scope reads):         no <script>, no datamodel
                                            access of any kind.
      - R4 (<script> usage):               none.

    Cleanliness on all four axes is the deliberate property: the
    fixture exercises §14 (parse + cross-reference) and §16.5
    (parallel-final barrier) without depending on R1-R4
    enforcement. §16.3's current status banner records the
    analyzer as a separate concern from §14 partition resolution
    and §16.5 barrier semantics.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" name="motor_partition" initial="root">
    <parallel id="root">
        <state id="left" initial="left_idle">
            <state id="left_idle">
                <transition event="ping_left" target="left_active"/>
            </state>
            <state id="left_active">
                <transition event="reset_left" target="left_idle"/>
                <transition event="finalize_left" target="left_done"/>
            </state>
            <final id="left_done"/>
        </state>
        <state id="right" initial="right_idle">
            <state id="right_idle">
                <transition event="ping_right" target="right_active"/>
            </state>
            <state id="right_active">
                <transition event="reset_right" target="right_idle"/>
                <transition event="finalize_right" target="right_done"/>
            </state>
            <final id="right_done"/>
        </state>
        <transition event="done.state.root" target="all_done"/>
    </parallel>
    <final id="all_done"/>
</scxml>
