<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Mesh §9.6 Session F full lifecycle verification — worker peer.
     Declared in deploy_session_f_wired.yaml so the parent's
     `<invoke src="#worker_session_f_wired">` resolves to a distinct
     mesh machine. The body is a trivial-final child: the initial state
     is a `<final>` that the engine reaches during its initial macrostep,
     so `WorkerSessionHost::onWire14` observes `isFinal()` immediately
     after `initialize()` and emits wire-18 `InvokeDone` — validating
     the shortest success path through §9.6's parent/child lifecycle. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="done" name="worker_session_f_wired">
    <final id="done"/>
</scxml>
