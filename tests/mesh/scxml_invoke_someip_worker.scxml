<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Mesh §9.6 Session 4b SOME/IP scxml-invoke roundtrip — worker.
     Declared in deploy_scxml_invoke_someip.yaml so the parent's
     `<invoke src="#scxml_invoke_someip_worker">` resolves to a
     distinct mesh machine. Body is a trivial-final child: the initial
     state is a `<final>` that the engine reaches during its initial
     macrostep, so `WorkerSessionHost::onWire14` observes
     `isFinal() == true` immediately after `initialize()` and emits
     wire-15 InvokeStarted + wire-18 InvokeDone on the worker
     endpoint in a single pump tick — the shortest success path
     through §9.6's parent/child lifecycle exercised end-to-end over
     SOME/IP. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="done"
       name="scxml_invoke_someip_worker">
    <final id="done"/>
</scxml>
