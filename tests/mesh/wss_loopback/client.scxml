<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCE_MESH.md §mesh-18 / §mesh-19: the client half of the WebSocket loopback.
  It pings the server and waits for the answer, then asks the server to echo
  a value through `<invoke type="sce:mesh-rpc">` and waits for the invoke to
  complete (§mesh-9.5).

  Its peer table (backends/kotlin/mesh/src/jvmTest/kotlin/com/sce/generated/
  client/ClientMeshPeers.kt) is generated from deploy.yaml beside it by
  backends/kotlin/mesh/generate.sh, and the Kotlin CrossLanguageLoopbackTest
  builds its router from it.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       name="client" initial="asking" datamodel="ecmascript">
  <state id="asking">
    <onentry>
      <send target="#server" event="ping"/>
    </onentry>
    <transition event="pong" target="echoing"/>
  </state>
  <state id="echoing">
    <invoke id="echo" type="sce:mesh-rpc" src="#server">
      <param name="_mesh_event" expr="'service.request.echo'"/>
      <param name="x" expr="1"/>
    </invoke>
    <transition event="done.invoke.echo" target="answered"/>
  </state>
  <final id="answered"/>
</scxml>
