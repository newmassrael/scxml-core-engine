<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Mesh §9.5 srcexpr compile verification.

     Exercises the runtime-target-resolution path of
     <invoke type="sce:mesh-rpc" srcexpr="...">. Until this fixture existed
     there was no SCXML in-tree that emitted the `{% if invoke_info.srcexpr %}`
     branch of entry_exit_actions.jinja2, so the generated C++ for that block
     (ensureScriptEngine + evaluateExpression + std::regex shape check +
     stash into `_mesh_resolved_src_<suffix>_` + paired exit reuse) was
     never compiled — a textbook "built but unconsumed" gap.

     The srcexpr target expression always calls evaluateExpression at
     runtime, so `parse_invoke` marks every MeshRpcTarget::SrcExpr
     document as `needs_script_engine = true` unconditionally. This
     fixture therefore needs no surrounding script-engine trigger:
     `datamodel` can stay at the spec default and there is no
     `<datamodel>` block. `calling_literal` keeps a static
     `src="#motor_srcexpr"` so the topology still resolves a binding
     (srcexpr invokes are skipped by `invoke_sites_by_target`, leaving
     `TransportRouter` without any dispatch entry otherwise).
     `calling_runtime` is the real verifier: its srcexpr evaluates a
     literal target string at entry, is shape-checked, stashed, and
     reused on the paired onexit cancel. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" name="srcexpr_client" initial="idle">
    <state id="idle">
        <transition event="go.literal" target="calling_literal"/>
        <transition event="go.runtime" target="calling_runtime"/>
    </state>
    <state id="calling_literal">
        <!-- Static src: populates `invoke_sites_by_target` so the
             generated `TransportRouter::invokeMeshRpc` has a non-empty
             match table. Without this, the router's for-loop over
             `targets` is empty and overload resolution on the generic
             `const std::string&` parameters still works but the surface
             area being compiled is essentially degenerate. -->
        <invoke type="sce:mesh-rpc" src="#motor_srcexpr">
            <param name="_mesh_event" expr="'service.request.ping'"/>
        </invoke>
        <transition event="done.invoke" target="ok"/>
        <transition event="error.invoke" target="failed"/>
    </state>
    <state id="calling_runtime">
        <!-- Runtime target resolution. The srcexpr is evaluated at entry,
             shape-checked against ^#[A-Za-z_][A-Za-z0-9_]*$ before
             `performMeshInvoke`, then stashed so the onexit <cancel>
             path reuses the same literal (re-evaluating on exit could
             observe a mutated datamodel and pick a different machine
             than the one the correlation entry was registered against). -->
        <invoke type="sce:mesh-rpc" srcexpr="'#motor_srcexpr'">
            <param name="_mesh_event" expr="'service.request.ping'"/>
        </invoke>
        <transition event="done.invoke" target="ok"/>
        <transition event="error.invoke" target="failed"/>
    </state>
    <final id="ok"/>
    <final id="failed"/>
</scxml>
