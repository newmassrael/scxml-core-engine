<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Mesh Zenoh liveliness E2E fixture — target-stub side.
     Only exists so deploy.yaml event coverage sees a receiver for
     brake's `event.ping` <send>. The test never compiles motor's
     transport.h; a raw zenoh peer session in the test simulates motor
     and declares the liveliness token on `sce/live/motor`. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" name="motor_zenoh_liveliness" initial="idle">
    <state id="idle">
        <transition event="event.ping" target="idle"/>
    </state>
</scxml>
