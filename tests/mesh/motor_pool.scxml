<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal motor server SCXML for SCE_MESH.md §14.4 (Gap 7)
     multi-instance server pool compile verification.

     A single RPC pair (service.request.compute → service.response.compute)
     exercises the template's server-side instance loop: one
     register_message_handler call per (instance, method) pair, one
     offer_service per instance. The inject_server_response_sends
     build-time pass pairs the raise with a synthetic <send> so the
     transport layer routes the response via create_response(msg) —
     which preserves the inbound instance id and lets the client
     observe the correct reply origin without any per-instance
     dispatch work inside this machine. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       datamodel="null" name="motor_pool" initial="ready">
    <state id="ready">
        <transition event="service.request.compute" target="computing"/>
    </state>
    <state id="computing">
        <onentry>
            <raise event="service.response.compute"/>
        </onentry>
        <transition target="ready"/>
    </state>
</scxml>
