<?xml version="1.0" encoding="UTF-8"?>
<!-- Motor receiver for SOME/IP multi-pattern topology validation.
     Every <send event="X"> in brake_someip_multi.scxml requires a
     matching <transition event="X"> here for the build-time
     UncoveredEvents check.

     Session E: motor is an RPC server for compute_force. The topology
     analyzer detects the (service.request.compute_force,
     service.response.compute_force) pair from the transition + raise
     and generates server-side SOME/IP registration (offer_service +
     register_message_handler). The <raise> is the spec-canonical form
     (SCE_MESH.md Section 13); inject_server_response_sends adds a
     synthetic <send> at build time for transport routing. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       datamodel="null" name="motor" initial="ready">
    <state id="ready">
        <transition event="service.fire_forget.activate" target="ready"/>
        <transition event="service.request.compute_force" target="computing"/>
        <!-- event.subscribe.status / event.unsubscribe.status: transport-layer
             control messages consumed by the sender's router (app.subscribe /
             app.unsubscribe). Never dispatched to receiver engine
             (MeshDispatch returns false for EventSubscribe/EventUnsubscribe).
             Coverage-exempt per topology.rs (SCE_MESH.md Section 13). -->
        <!-- FieldAccess responses (SCE_MESH.md §8.3): raise field.notify.X
             as the spec-canonical reply form. inject_server_response_sends
             appends a synthetic <send> alongside each raise so the transport
             layer routes the response (SOME/IP create_response, Zenoh
             Query::reply) — identical mechanics to service.response. -->
        <transition event="field.set.target_speed" target="ready">
            <raise event="field.notify.target_speed"/>
        </transition>
        <transition event="field.get.vehicle_speed" target="ready">
            <raise event="field.notify.vehicle_speed"/>
        </transition>
    </state>
    <state id="computing">
        <onentry>
            <!-- Server RPC response (SCE_MESH.md Section 13): the raise puts
                 the event in the internal queue for state machine processing.
                 The build-time model injection (inject_server_response_sends)
                 adds a synthetic <send> alongside this raise so the transport
                 layer can route the response back to the caller. -->
            <raise event="service.response.compute_force"/>
        </onentry>
        <transition target="ready"/>
    </state>
</scxml>
