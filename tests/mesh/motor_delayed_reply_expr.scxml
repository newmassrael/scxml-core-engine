<?xml version="1.0" encoding="UTF-8"?>
<!-- motor_delayed_reply with the reply's peer named by an expression. A
     `targetexpr` is routed as the same value written in `target` is
     (§scxml-6.2.4), so a delayed reply to a peer read at run time must also
     wait and then reach that peer with the invokeid of the request it
     answers (SCE_MESH.md §10.7).

     Its only peer send is the `targetexpr`: the generated router carries a
     route to every binding deploy.yaml declares for this machine, and
     classifies the reply by its event (SCE_MESH.md §9.5), so nothing else
     in the document has to name the peer for it to be reached. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="ecmascript" name="motor_delayed_reply_expr" initial="ready">
    <state id="ready">
        <transition event="service.request.compute_force" target="replying"/>
    </state>
    <state id="replying">
        <onentry>
            <send targetexpr="'#brake_delayed_reply_expr'" event="service.response.compute_force" delay="20ms"/>
        </onentry>
    </state>
</scxml>
