<?xml version="1.0" encoding="UTF-8"?>
<!-- SCE Mesh §9.5 compile verification: brake controller invoking motor
     via <invoke type="sce:mesh-rpc">. Byte-golden regression coverage for
     invoke_sites plumbing — transport codegen must emit invokeMeshRpc /
     cancelMeshRpc / InvokeCorrelation / MeshDeadlineScheduler / the ctor
     setMeshInvokeCallback lambda when this fixture is compiled. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="ecmascript" name="brake_invoke" initial="idle">
    <state id="idle">
        <transition event="go" target="computing"/>
    </state>
    <state id="computing">
        <invoke type="sce:mesh-rpc" src="#motor_invoke">
            <param name="_mesh_event" expr="'service.request.compute_force'"/>
            <param name="_mesh_deadline_ms" expr="50"/>
        </invoke>
        <transition event="abort" target="aborted"/>
        <transition event="done.invoke" target="ok"/>
        <transition event="error.invoke" target="failed"/>
        <!-- SCE Mesh 16.7 row 14: a reply from outside the binding's
             responder set is rejected loudly, not dropped. Observing it
             as a state change is what proves the raise reaches SCXML. -->
        <transition event="error.communication" target="rejected"/>
    </state>
    <final id="ok"/>
    <final id="failed"/>
    <final id="aborted"/>
    <final id="rejected"/>
</scxml>
