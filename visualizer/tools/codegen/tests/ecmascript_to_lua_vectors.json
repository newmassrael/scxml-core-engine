  ],
  "scripts": [
    {
      "input": "var x = 1;",
      "expected": "x = 1"
    },
    {
      "input": "var x = 1;\nvar y = 2;",
      "expected": "x = 1\n\ny = 2"
    },
    {
      "input": "x = x + 1;",
      "expected": "x = x + 1"
    },
    {
      "input": "if (x > 0) { y = 1; }",
      "expected": "if x > 0 then\ny = 1\n\nend"
    },
    {
      "input": "for (var i in obj) { sum += obj[i]; }",
      "expected": "for i, _ in pairs(obj) do\nsum = sum + (obj[i])\n\nend"
    }
  ]
}
