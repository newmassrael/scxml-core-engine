      "context": "General",
      "expected": "nil"
    },
    {
      "input": "x == null",
      "context": "General",
      "expected": "x == nil"
    },
    {
      "input": "typeof x === 'undefined'",
      "context": "General",
      "expected": "x == nil"
    },
    {
      "input": "typeof x !== 'undefined'",
      "context": "General",
      "expected": "x ~= nil"
    },
    {
      "input": "typeof x === 'object'",
