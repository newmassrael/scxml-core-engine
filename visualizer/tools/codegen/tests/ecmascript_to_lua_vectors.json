{
  "description": "Cross-implementation test vectors for EcmaScriptToLuaTransformer",
  "note": "Generated from Python implementation. C++ and Kotlin must produce identical output.",
  "expressions": [
    {
      "input": "a && b",
      "context": "General",
      "expected": "a  and  b"
    },
    {
      "input": "a || b",
      "context": "General",
      "expected": "a  or  b"
    },
    {
      "input": "a === b",
      "context": "General",
      "expected": "a == b"
    },
    {
      "input": "a !== b",
      "context": "General",
      "expected": "a ~= b"
    },
    {
      "input": "a != b",
      "context": "General",
      "expected": "a ~= b"
    },
    {
      "input": "!a",
      "context": "General",
      "expected": "not a"
    },
    {
      "input": "a && b",
      "context": "Guard",
      "expected": "_scxml_truthy(a  and  b)"
    },
    {
      "input": "a || b",
      "context": "Guard",
      "expected": "_scxml_truthy(a  or  b)"
    },
    {
      "input": "x > 5",
      "context": "Guard",
      "expected": "x > 5"
    },
    {
      "input": "Var1",
      "context": "Guard",
      "expected": "_scxml_truthy(Var1)"
    },
    {
