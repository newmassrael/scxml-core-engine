<?xml version="1.0" encoding="UTF-8"?>
<!-- test-component: what the tester does, as a sce-static statechart. It
     waits on its port for the job's completion within a limit the suite
     supplies: a reply that matches passes, and no reply before the timer
     runs out fails. The port type and the template are the examples beside
     this file. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="job_tester"
       datamodel="sce-static" initial="waiting">
  <sce:import kind="test-port-type" src="test-port-type.scxml" as="JobPort"/>
  <sce:import kind="test-template" src="test-template.scxml" as="CompletedWithin"/>
  <sce:test-port id="sut" type="JobPort"/>
  <sce:test-timer id="deadline" duration="2s"/>
  <datamodel>
    <data id="elapsed_limit" sce:type="uint32" sce:module-parameter="true"/>
  </datamodel>
  <state id="waiting">
    <onentry>
      <sce:start-timer timer="deadline"/>
    </onentry>
    <transition sce:receive="sut" sce:test-template="CompletedWithin"
                sce:template-args="elapsed_limit" target="passed">
      <sce:stop-timer timer="deadline"/>
      <sce:setverdict value="pass"/>
    </transition>
    <transition sce:timeout="deadline" target="failed">
      <sce:setverdict value="fail" reason="'no reply in time'"/>
    </transition>
  </state>
  <final id="passed"/>
  <final id="failed"/>
</scxml>
