<?xml version="1.0" encoding="UTF-8"?>
<!-- lookup: each listed input value selects one output value. A signal
     level mapped to a quality name; sce:default answers every level the
     table does not list, and is a decision the specification has to make. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="lookup" name="signal_quality">
  <datamodel>
    <data id="level" sce:type="uint8" sce:direction="in"/>
    <data id="quality" sce:type="string" sce:direction="out"/>
    <data id="mapping" sce:default="NONE">
      <sce:entry key="0" value="NONE"/>
      <sce:entry key="1" value="LOW"/>
      <sce:entry key="2" value="MEDIUM"/>
      <sce:entry key="3" value="HIGH"/>
    </data>
  </datamodel>
</scxml>
