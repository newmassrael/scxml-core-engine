<?xml version="1.0" encoding="UTF-8"?>
<!-- filter: an output that depends on recent samples. A button input is
     accepted as changed only after three equal samples in a row. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="filter" name="button_debounce" version="1.0">
  <datamodel>
    <data id="rawButton" sce:type="bool" sce:direction="in"/>
    <data id="stable" sce:type="bool" sce:direction="out"
          sce:filter="debounce" sce:window="3"/>
  </datamodel>
</scxml>
