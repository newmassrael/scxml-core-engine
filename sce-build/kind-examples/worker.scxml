<?xml version="1.0" encoding="UTF-8"?>
<!-- worker: a concurrent execution context reading a link's received
     frames through an inbox. Imports the link kind it reads from and the
     queue kind that is its inbox; each import resolves against the file
     beside it (link.scxml imports codec.scxml and buffer-pool.scxml the
     same way), so a plain check follows the whole chain from this one
     file. The inbox queue has one consumer, the worker. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="worker" name="udp_receiver" version="1.0">
  <sce:import as="udp_endpoint" src="link.scxml" kind="link"/>
  <sce:import as="rx_events" src="queue.scxml" kind="queue"/>
  <sce:link-rx ref="udp_endpoint"/>
  <sce:inbox ref="rx_events"/>
</scxml>
