<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Path A positive fixture: statechart that imports the
  multi-field schema and exercises distinct typed reads of the
  three declared fields. Each transition cond references a
  different field/type axis (integer, bool, string).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="statechart_multi_field"
       version="1.0"
       initial="waiting"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_multi.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <state id="waiting">
    <transition event="job.completed" cond="_event.data.elapsed_ms === 0" target="instant_done"/>
    <transition event="job.completed" cond="_event.data.retried === true" target="retried_done"/>
    <transition event="job.completed" cond="_event.data.job_id === 'sentinel'" target="sentinel_done"/>
  </state>
  <state id="instant_done"/>
  <state id="retried_done"/>
  <state id="sentinel_done"/>
</scxml>
