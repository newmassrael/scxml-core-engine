<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Path A negative fixture (DL-4'): statechart imports
  the minimal schema (`elapsed_ms: uint32`) but the
  `<send event="job.completed">` payload binds `elapsed_ms` to a
  string literal. Send-side validator must reject with
  `validation/cross-kind-type-mismatch` (reused per Item 4
  precedent), naming the field's declared type and the literal's
  syntactic type.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="negative_statechart_send_type_mismatch"
       version="1.0"
       initial="working"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_minimal.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <state id="working">
    <onentry>
      <send event="job.completed">
        <param name="elapsed_ms" expr="'not-a-number'"/>
      </send>
    </onentry>
    <transition event="job.completed" target="done"/>
  </state>
  <state id="done"/>
</scxml>
