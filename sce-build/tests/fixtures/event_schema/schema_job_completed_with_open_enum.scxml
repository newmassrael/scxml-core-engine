<?xml version="1.0" encoding="UTF-8"?>
<!--
  Width-axis isolation schema: EventSchema referencing the open-set `result_open.scxml`
  enum so the paired width-axis boundary positive fixtures can
  exercise width narrowing without inadvertently triggering the membership check
  membership rejections.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="job_completed_schema_with_open_enum"
       sce:kind="event-schema"
       sce:event-name="job.completed">
  <sce:import src="result_open.scxml" kind="enum" as="ResultOpen"/>
  <datamodel>
    <data id="status" sce:type="enum:ResultOpen" sce:direction="in"/>
    <data id="elapsed_ms" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
