<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Path A Atomic 5 width-axis isolation schema (post-
  F-κ): EventSchema referencing the open-set `result_open.scxml`
  enum so the paired Atomic 5 boundary positive fixtures can
  exercise width narrowing without inadvertently triggering F-κ
  membership rejections.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="job_completed_schema_with_open_enum"
       sce:kind="event-schema"
       sce:event-name="job.completed">
  <sce:import src="result_open.scxml" kind="enum" as="ResultOpen"/>
  <datamodel>
    <data id="status" sce:type="enum:ResultOpen" sce:direction="in"/>
    <data id="elapsed_ms" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
