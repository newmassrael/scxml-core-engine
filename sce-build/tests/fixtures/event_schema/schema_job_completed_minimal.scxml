<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 fixture: minimal EventSchema (one field, no enum
  import). Exercises top-level surface form + receive-side typecheck
  on a single primitive-typed field. Generic vocabulary (`job.completed`
  + uint32 `elapsed_ms`) — no protocol token, no domain-specific
  identifier.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="job_completed_schema_minimal"
       sce:kind="event-schema"
       sce:event-name="job.completed">
  <datamodel>
    <data id="elapsed_ms" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
