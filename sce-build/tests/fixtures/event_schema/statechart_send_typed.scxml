<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Atomic B positive fixture: statechart that imports
  the minimal schema and emits a typed `<raise event="job.completed">`
  with a `<param name="elapsed_ms" expr="...">` matching the schema's
  declared field shape. Send-side typecheck must accept the known
  field + integer literal against the schema's `uint32` declaration.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="statechart_send_typed"
       version="1.0"
       initial="working"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_minimal.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <state id="working">
    <onentry>
      <send event="job.completed">
        <param name="elapsed_ms" expr="500"/>
      </send>
    </onentry>
    <transition event="job.completed" target="done"/>
  </state>
  <state id="done"/>
</scxml>
