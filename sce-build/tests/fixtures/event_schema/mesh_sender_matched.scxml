<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Atomic B positive mesh fixture (DL-7) — sender side.
  Machine `alpha` imports the minimal `job.completed` schema and
  emits `<send target="#beta">` whose receiver (`beta`) imports the
  same schema document. Mesh validator must accept (matching hashes,
  no diagnostic).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="mesh_sender_matched"
       version="1.0"
       initial="working"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_minimal.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <state id="working">
    <onentry>
      <send target="#beta" event="job.completed">
        <param name="elapsed_ms" expr="100"/>
      </send>
    </onentry>
    <transition event="job.completed" target="done"/>
  </state>
  <state id="done"/>
</scxml>
