<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Atomic B negative mesh fixture (DL-7, SenderOnly) —
  sender side. Machine `alpha` imports the minimal `job.completed`
  schema and sends to `#beta`; `beta`'s SCXML does NOT import any
  schema for `job.completed`. Mesh validator must reject with
  `mesh/event-schema-mismatch` reason=SenderOnly.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="negative_mesh_sender_only"
       version="1.0"
       initial="working"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_minimal.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <state id="working">
    <onentry>
      <send target="#beta" event="job.completed">
        <param name="elapsed_ms" expr="100"/>
      </send>
    </onentry>
    <transition event="job.completed" target="done"/>
  </state>
  <state id="done"/>
</scxml>
