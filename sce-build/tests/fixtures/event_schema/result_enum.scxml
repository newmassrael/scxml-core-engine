<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 cross-doc fixture: a `sce:kind="lookup"` document
  serving as the enum vocabulary referenced by
  `schema_job_completed_with_enum.scxml` via `sce:type="enum:Result"`.
  Maps unsigned-byte keys to symbolic status names; the lookup's
  string output triggers the symbolic-dispatch codegen strategy.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="lookup"
       name="result_enum">
  <datamodel>
    <data id="code" sce:type="uint8" sce:direction="in"/>
    <data id="label" sce:type="string" sce:direction="out"/>
    <data id="mapping" sce:default="ok">
      <sce:entry key="0" value="ok"/>
      <sce:entry key="1" value="error"/>
      <sce:entry key="2" value="timeout"/>
    </data>
  </datamodel>
</scxml>
