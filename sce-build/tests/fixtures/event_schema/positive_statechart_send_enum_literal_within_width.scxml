<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Path A Atomic 5 positive boundary fixture (send-side
  mirror of `positive_statechart_enum_literal_within_width.scxml`):
  `<send event="job.completed"><param name="status" expr="255"/>` and
  the hex equivalent both fit the uint8 carrier exactly. Locks the
  send-side branch of the narrowing layer against off-by-one drift.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="positive_send_enum_literal_within_width"
       version="1.0"
       initial="ready"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_with_enum.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <sce:import src="result.scxml" kind="enum" as="Result"/>
  <state id="ready">
    <transition event="user.go" target="done">
      <send event="job.completed">
        <param name="status" expr="0xFF"/>
        <param name="elapsed_ms" expr="42"/>
      </send>
    </transition>
  </state>
  <state id="done"/>
</scxml>
