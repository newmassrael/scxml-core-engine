<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 fixture: multi-field EventSchema exercising the
  full primitive type matrix (numeric + bool + string axes). Three
  fields on the same event so the validator's per-field resolution
  is exercised distinctly per axis.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="job_completed_schema_multi"
       sce:kind="event-schema"
       sce:event-name="job.completed">
  <datamodel>
    <data id="elapsed_ms" sce:type="uint32" sce:direction="in"/>
    <data id="retried" sce:type="bool" sce:direction="in"/>
    <data id="job_id" sce:type="string" sce:direction="in"/>
  </datamodel>
</scxml>
