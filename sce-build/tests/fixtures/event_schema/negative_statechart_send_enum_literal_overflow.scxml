<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Path A Atomic 5 negative fixture (send-side mirror of
  `negative_statechart_enum_literal_overflow.scxml`): `<send
  event="job.completed"><param name="status" expr="0x1FFFF"/>` against
  the `enum:Result` field whose underlying is uint8 — the integer
  literal 131071 overflows the uint8 carrier. The send-side narrowing
  layer in `check_send_param` rejects with
  `validation/cross-kind-type-mismatch`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="negative_send_enum_literal_overflow"
       version="1.0"
       initial="ready"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_with_enum.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <sce:import src="result.scxml" kind="enum" as="Result"/>
  <state id="ready">
    <transition event="user.go" target="done">
      <send event="job.completed">
        <param name="status" expr="0x1FFFF"/>
        <param name="elapsed_ms" expr="42"/>
      </send>
    </transition>
  </state>
  <state id="done"/>
</scxml>
