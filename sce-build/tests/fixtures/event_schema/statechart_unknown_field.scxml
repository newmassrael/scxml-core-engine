<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Path A negative fixture: statechart references a
  field (`status`) that the imported minimal schema does not declare.
  Receive-side typecheck rejects with
  `validation/cross-kind-field-not-found`, did-you-mean candidates
  = `["elapsed_ms"]`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="statechart_unknown_field"
       version="1.0"
       initial="waiting"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_minimal.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <state id="waiting">
    <transition event="job.completed" cond="_event.data.status === 0" target="done"/>
  </state>
  <state id="done"/>
</scxml>
