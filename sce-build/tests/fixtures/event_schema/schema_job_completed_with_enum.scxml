<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 cross-doc fixture: EventSchema with an enum-typed
  field referring to `result_enum.scxml` via the `enum:Result`
  syntax. Exercises the DL-2 SceType::Enum lattice surface against
  a real imported Lookup document; cross-doc resolution of the
  alias against the schema's `<sce:import>` table is the load-bearing
  axis tested here.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="job_completed_schema_with_enum"
       sce:kind="event-schema"
       sce:event-name="job.completed">
  <sce:import src="result_enum.scxml" kind="lookup" as="Result"/>
  <datamodel>
    <data id="status" sce:type="enum:Result" sce:direction="in"/>
    <data id="elapsed_ms" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
