<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Path A negative fixture: schema declared against the
  W3C reserved `error.*` namespace. Parse-time rejection via
  `validation/event-schema-on-builtin-event` (DL-9' schemaless
  fallback's complementary guard).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="schema_on_builtin_error"
       sce:kind="event-schema"
       sce:event-name="error.execution">
  <datamodel>
    <data id="reason" sce:type="string" sce:direction="in"/>
  </datamodel>
</scxml>
