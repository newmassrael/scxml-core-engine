<?xml version="1.0" encoding="UTF-8"?>
<!--
  NL→IR Item C1 Atomic B positive mesh fixture (DL-7) — receiver side.
  Machine `beta` imports the same minimal `job.completed` schema the
  sender (`alpha`) imported. Receive-side typecheck applies the
  schema to the `_event.data.elapsed_ms` cond; mesh DL-7 validator
  computes matching canonical hashes and accepts.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="mesh_receiver_matched"
       version="1.0"
       initial="waiting"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_minimal.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <state id="waiting">
    <transition event="job.completed" cond="_event.data.elapsed_ms &gt; 0" target="done"/>
  </state>
  <state id="done"/>
</scxml>
