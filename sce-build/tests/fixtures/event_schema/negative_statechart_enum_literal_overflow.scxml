<?xml version="1.0" encoding="UTF-8"?>
<!--
  Enum width-axis negative fixture: a statechart imports
  the cross-doc enum-bearing schema AND the underlying Enum doc, then
  compares `_event.data.status` (typed `enum:Result` over uint8) against
  an integer literal that overflows the underlying width. The narrowing
  layer in `event_schema_check.rs::enum_underlying_overflow` rejects
  with `validation/cross-kind-type-mismatch` (Item 4 reuse precedent —
  no new wire code). The statechart-direct `<sce:import kind="enum"
  as="Result"/>` is required for the alias to resolve from the
  statechart's view; without it the narrowing silent-skips per the
  conservative-accept default.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="negative_enum_literal_overflow"
       version="1.0"
       initial="waiting"
       datamodel="ecmascript">
  <sce:import src="schema_job_completed_with_enum.scxml" kind="event-schema" as="JobCompletedSchema"/>
  <sce:import src="result.scxml" kind="enum" as="Result"/>
  <state id="waiting">
    <transition event="job.completed" cond="_event.data.status === 256" target="ok"/>
  </state>
  <state id="ok"/>
</scxml>
