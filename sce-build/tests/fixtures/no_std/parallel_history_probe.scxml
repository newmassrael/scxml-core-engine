<?xml version="1.0" encoding="UTF-8"?>
<!--
  Watching-zenoh RFC 5.J.2 no_std MCU-target compile gate fixture.

  Exercises every construct whose Rust no_std emission is allocator-free yet
  was historically std-coupled, so a regression that reintroduces an alloc
  dependency fails the thumbv7em-none-eabihf compile in the sce-rust-runtime
  no_std CI workflow:

    nested parallel + multiple regions: conflict-resolution buffers
    (remove_conflicting_transitions, compute_exit_set, TransitionList,
    IndexList, StateChain) plus the FnvIndexSet dedup set.
    history shallow and deep: StateChain history fields.
    many same and different source transitions: stable_sort_by ordering.
    raise + send (internal / external / delayed / parent): the dispatch
    paths that build send_id and event metadata as SceString, the scheduler
    path, and the parent-absent error.communication branch.

  Intentionally script-free, invoke-free, http-free so the document is a valid
  no_std target (those constructs are codegen-rejected for the no_std backend).
  All send/data is static (no expr/namelist/targetexpr) since dynamic forms
  require the script engine, which no_std rejects.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="top" name="parallel_history_probe">
  <parallel id="top">
    <state id="ra" initial="a1">
      <history id="ha_deep" type="deep"><transition target="a1"/></history>
      <state id="a1">
        <onentry>
          <raise event="e1"/>
          <send event="ev_internal" target="#_internal"/>
          <send event="ev_external"/>
          <send event="ev_delayed" delay="5ms"/>
          <send event="ev_parent" target="#_parent"/>
        </onentry>
        <transition event="e1" target="a2"/>
        <transition event="e2" target="a3"/>
        <transition event="ev_internal" target="a2"/>
        <transition event="error.communication" target="a3"/>
      </state>
      <state id="a2"><transition event="e1" target="a1"/><transition event="back" target="ha_deep"/></state>
      <state id="a3"><transition event="e1" target="a1"/></state>
    </state>
    <state id="rb" initial="b1">
      <history id="hb_shallow" type="shallow"><transition target="b1"/></history>
      <state id="b1"><transition event="e1" target="b2"/></state>
      <state id="b2"><transition event="e2" target="b1"/><transition event="back" target="hb_shallow"/></state>
    </state>
    <state id="rc">
      <parallel id="pc">
        <state id="c1"><transition event="e1" target="c1"/><transition event="ev_external" target="c1"/></state>
        <state id="c2"><transition event="e2" target="c2"/><transition event="ev_delayed" target="c2"/></state>
      </parallel>
    </state>
  </parallel>
</scxml>
