<!--
  A record with a signed field, which no CBOR codec writes as an entry of a
  list's record: `a_cbor_codec_entry_holds_a_bounded_list_of_records.rs` holds
  a codec whose list holds it to its refusal by name.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="cbor_signed_entry"
       sce:event-name="cbor.signed_entry">
  <datamodel>
    <data id="seq" sce:type="uint64" sce:direction="in"/>
    <data id="delta" sce:type="int32" sce:direction="in"/>
  </datamodel>
</scxml>
