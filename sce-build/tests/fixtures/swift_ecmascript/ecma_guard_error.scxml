<?xml version="1.0" encoding="UTF-8"?>
<!--
  A guard that cannot be evaluated (§scxml-5.9.1): it is false, and error.execution is raised.
  The first transition reads a field off a variable that is declared and holds nothing, which is an
  error at run time and a legal expression to the frontend (an undeclared name would be refused at
  build time, and this document is part of the corpus the refusal lint sweeps). So the transition
  is not taken and the error event moves the machine to raised.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="s0" name="ecma_guard_error">
  <datamodel>
    <data id="holder"/>
  </datamodel>
  <state id="s0">
    <transition cond="holder.field.deep" target="wrong"/>
    <transition event="error.execution" target="raised"/>
  </state>
  <state id="wrong"/>
  <state id="raised"/>
</scxml>
