<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a suite that imports two feature models; it selects over at
     most one (docs/SCE_TEST_PROFILE.md §11.8). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="refused_suite_two_feature_models">
  <sce:import kind="feature-model" src="job_features.scxml" as="Features"/>
  <sce:import kind="feature-model" src="../../../kind-examples/feature-model.scxml"
              as="SessionFeatures"/>
  <sce:import kind="test-case" src="completes_in_time.scxml" as="CompletesInTime"/>
  <sce:execute test-case="CompletesInTime"/>
</scxml>
