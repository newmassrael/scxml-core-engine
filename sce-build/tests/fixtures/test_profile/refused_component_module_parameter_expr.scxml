       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_module_parameter_expr"
       datamodel="sce-static" initial="done">
  <datamodel>
    <data id="limit" sce:type="uint32" sce:module-parameter="true" expr="5"/>
  </datamodel>
  <final id="done"/>
</scxml>
