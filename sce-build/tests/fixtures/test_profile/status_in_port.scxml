<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.3: a port type that only receives the job
     status: the status is on its `in` list and its `out` list is empty. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="status_in_port">
  <sce:import kind="event-schema" src="job_status.scxml" as="JobStatus"/>
  <sce:message type="JobStatus" direction="in"/>
</scxml>
