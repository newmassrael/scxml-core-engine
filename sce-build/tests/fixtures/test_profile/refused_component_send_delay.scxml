<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a send with a delay; in a test component a delay is a timer
     (docs/SCE_TEST_PROFILE.md §4.6, §8.2). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_send_delay"
       datamodel="sce-static" initial="sending">
  <sce:import kind="test-port-type" src="job_port.scxml" as="JobPort"/>
  <sce:import kind="test-template" src="job_report.scxml" as="JobReport"/>
  <sce:test-port id="sut" type="JobPort"/>
  <state id="sending">
    <onentry>
      <send type="http://sce.dev/ext/test-port" target="sut" delay="1s"
            sce:test-template="JobReport"/>
    </onentry>
    <transition target="done"/>
  </state>
  <final id="done"/>
</scxml>
