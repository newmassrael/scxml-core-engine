<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a done branch that targets the state that invoked the PTC; the
     PTC stays done, so the branch would match again on every snapshot
     (docs/SCE_TEST_PROFILE.md §4.4, §8.2). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_done_branch_stays"
       datamodel="sce-static" initial="running">
  <state id="running">
    <invoke type="http://sce.dev/ext/test-component" src="helper.scxml" id="helper"/>
    <transition event="done.invoke.helper" target="running"/>
  </state>
  <final id="done"/>
</scxml>
