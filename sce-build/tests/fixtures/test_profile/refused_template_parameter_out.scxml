       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_template_parameter_out"
       sce:type="uint32">
  <datamodel>
    <data id="limit" sce:type="uint32" sce:direction="out"/>
  </datamodel>
  <sce:any-value/>
</scxml>
