<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a timer declared twice (docs/SCE_TEST_PROFILE.md §11.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_timer_twice"
       datamodel="sce-static" initial="done">
  <sce:test-timer id="reply" duration="2s"/>
  <sce:test-timer id="reply" duration="1s"/>
  <final id="done"/>
</scxml>
