<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a send of a template of values alone but for a reference to a
     template with a value range; specific is asked through every reference
     (docs/SCE_TEST_PROFILE.md §6.2, §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_send_not_specific_by_reference"
       datamodel="sce-static" initial="sending">
  <sce:import kind="test-port-type" src="job_port.scxml" as="JobPort"/>
  <sce:import kind="test-template" src="report_within.scxml" as="ReportWithin"/>
  <sce:test-port id="sut" type="JobPort"/>
  <datamodel>
    <data id="limit" sce:type="uint32" sce:module-parameter="true"/>
  </datamodel>
  <state id="sending">
    <onentry>
      <send type="http://sce.dev/ext/test-port" target="sut" sce:test-template="ReportWithin"
            sce:template-args="limit"/>
    </onentry>
    <transition target="done"/>
  </state>
  <final id="done"/>
</scxml>
