<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a transition on an event other than a PTC's completion; a
     transition of a test component is one of the branch kinds
     (docs/SCE_TEST_PROFILE.md §4.2, §8.2). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_branch_event"
       datamodel="sce-static" initial="waiting">
  <state id="waiting">
    <transition event="go" target="done"/>
  </state>
  <final id="done"/>
</scxml>
