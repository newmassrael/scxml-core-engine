<!--
  docs/SCE_TTCN3_LANE.md §12, SCE_FORGE.md §4.6.1: the codec of the record
  job_request (runtime/job_request.scxml) on a mapped port of the corpus, one
  CBOR map: the job under key 0. The lane's CBOR binding reads each entry's key
  and how its value is written from it, and nothing else of SCE.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:encoding="cbor" sce:codec-format="2" name="job_request_codec" version="1.0">
  <datamodel>
    <data id="raw" sce:type="bytes" sce:direction="in"/>
    <data id="job" sce:type="uint32" sce:key="0" sce:direction="out"/>
  </datamodel>
</scxml>
