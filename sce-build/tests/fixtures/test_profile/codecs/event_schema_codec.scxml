<!--
  docs/SCE_TTCN3_LANE.md §12, SCE_FORGE.md §4.6.1: the codec of the record
  event_schema, the job's completion of sce-build/kind-examples/event-schema.scxml,
  which job_suite's mapped port sends out; the record is named by the stem of
  its document (docs/SCE_TEST_PROFILE.md §12.5). One CBOR map: the elapsed time
  under key 0.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       sce:kind="codec" sce:encoding="cbor" sce:codec-format="2" name="event_schema_codec" version="1.0">
  <datamodel>
    <data id="raw" sce:type="bytes" sce:direction="in"/>
    <data id="elapsed_ms" sce:type="uint32" sce:key="0" sce:direction="out"/>
  </datamodel>
</scxml>
