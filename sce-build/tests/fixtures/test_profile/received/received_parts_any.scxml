<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.4: the template that matches any value of
     received_parts, its value that may be absent present or not. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="received_parts_any"
       sce:type="record:ReceivedParts">
  <sce:import kind="event-schema" src="received_parts.scxml" as="ReceivedParts"/>
  <sce:record-match>
    <sce:any-value field="blobs"/>
    <sce:any-value field="grid"/>
    <sce:any-value field="slots"/>
    <sce:any-value-or-none field="spare"/>
    <sce:any-value field="payment"/>
    <sce:any-value field="customer"/>
    <sce:any-value field="lines"/>
  </sce:record-match>
</scxml>
