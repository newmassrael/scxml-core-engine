<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.7, docs/SCE_TTCN3_LANE.md §10.5: a trace of one
     received_parts is replayed to the reader of every part. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-case" name="reads_every_part"
       sce:configuration="Parts">
  <sce:import kind="test-configuration" src="parts_configuration.scxml" as="Parts"/>
</scxml>
