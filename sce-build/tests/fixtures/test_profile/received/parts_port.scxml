<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.3: a port that takes received_parts. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="parts_port">
  <sce:import kind="event-schema" src="received_parts.scxml" as="ReceivedParts"/>
  <sce:message type="ReceivedParts" direction="in"/>
</scxml>
