<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a PTC's invocation with a <finalize>; messages between
     components go through ports (docs/SCE_TEST_PROFILE.md §4.9, §11.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_invoke_finalize"
       datamodel="sce-static" initial="running">
  <state id="running">
    <invoke type="http://sce.dev/ext/test-component" src="helper.scxml" id="helper">
      <finalize/>
    </invoke>
    <transition event="done.invoke.helper" target="done"/>
  </state>
  <final id="done"/>
</scxml>
