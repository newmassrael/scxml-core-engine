<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a module parameter whose default is no value of its type, 300
     for a uint8 (docs/SCE_TEST_PROFILE.md §11.8). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="refused_suite_parameter_literal">
  <sce:import kind="test-case" src="completes_in_time.scxml" as="CompletesInTime"/>
  <sce:module-parameter id="limit" type="uint8" value="300"/>
  <sce:execute test-case="CompletesInTime"/>
</scxml>
