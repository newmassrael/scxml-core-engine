<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: one message type listed twice (docs/SCE_TEST_PROFILE.md §11.3). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="refused_port_type_message_twice">
  <sce:import kind="event-schema" src="job_status.scxml" as="JobStatus"/>
  <sce:message type="JobStatus" direction="in"/>
  <sce:message type="JobStatus" direction="out"/>
</scxml>
