<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a guard that is not a whole number of microseconds
     (docs/SCE_TEST_PROFILE.md §4.7, §11.8). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="refused_suite_guard_below_a_microsecond">
  <sce:import kind="test-case" src="completes_in_time.scxml" as="CompletesInTime"/>
  <sce:execute test-case="CompletesInTime" guard="0.0000005s"/>
</scxml>
