<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a record match that names one field twice
     (docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_template_field_twice"
       sce:type="record:JobStatus">
  <sce:import kind="event-schema" src="job_status.scxml" as="JobStatus"/>
  <sce:record-match>
    <sce:any-value field="elapsed_ms"/>
    <sce:specific field="elapsed_ms" value="3"/>
  </sce:record-match>
</scxml>
