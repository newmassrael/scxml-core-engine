<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a map to a port the test system interface does not declare
     (docs/SCE_TEST_PROFILE.md §11.6). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration"
       name="refused_configuration_map_unknown_system_port">
  <sce:import kind="test-component" src="job_tester.scxml" as="Tester"/>
  <sce:import kind="test-port-type" src="job_port.scxml" as="JobPort"/>
  <sce:mtc type="Tester"/>
  <sce:system-port id="sut" type="JobPort"/>
  <sce:map component="mtc" port="sut" system-port="system"/>
</scxml>
