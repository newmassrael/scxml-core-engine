<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a send that names no template, the value it sends
     (docs/SCE_TEST_PROFILE.md §11.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_send_no_template"
       datamodel="sce-static" initial="sending">
  <sce:import kind="test-port-type" src="job_port.scxml" as="JobPort"/>
  <sce:test-port id="sut" type="JobPort"/>
  <state id="sending">
    <onentry>
      <send type="http://sce.dev/ext/test-port" target="sut"/>
    </onentry>
    <transition target="done"/>
  </state>
  <final id="done"/>
</scxml>
