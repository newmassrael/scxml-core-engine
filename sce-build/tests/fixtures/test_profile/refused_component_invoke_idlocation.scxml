<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a PTC's invocation that stores its id rather than writing it;
     the id is the PTC's literal name (docs/SCE_TEST_PROFILE.md §11.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_invoke_idlocation"
       datamodel="sce-static" initial="running">
  <datamodel>
    <data id="ptc" sce:type="string[16]" expr="''"/>
  </datamodel>
  <state id="running">
    <invoke type="http://sce.dev/ext/test-component" src="helper.scxml" idlocation="ptc"/>
    <transition target="done"/>
  </state>
  <final id="done"/>
</scxml>
