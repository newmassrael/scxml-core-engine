<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: an <invoke> of a statechart; a test component invokes PTCs
     alone (docs/SCE_TEST_PROFILE.md §8.2). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_invoke_type"
       datamodel="sce-static" initial="running">
  <state id="running">
    <invoke type="http://www.w3.org/TR/scxml/" src="helper.scxml" id="helper"/>
    <transition target="done"/>
  </state>
  <final id="done"/>
</scxml>
