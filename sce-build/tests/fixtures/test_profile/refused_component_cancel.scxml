<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a <cancel> in a test component, whose sends have no delay
     (docs/SCE_TEST_PROFILE.md §8.2). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_cancel"
       datamodel="sce-static" initial="waiting">
  <state id="waiting">
    <onexit>
      <cancel sendid="report"/>
    </onexit>
    <transition target="done"/>
  </state>
  <final id="done"/>
</scxml>
