<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a receive branch whose cond reads the message, which only its
     template matches (docs/SCE_TEST_PROFILE.md §4.2, §4.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_cond_reads_message"
       datamodel="sce-static" initial="waiting">
  <sce:import kind="test-port-type" src="job_port.scxml" as="JobPort"/>
  <sce:test-port id="sut" type="JobPort"/>
  <state id="waiting">
    <transition sce:receive="sut" cond="_event.data.count > 0" target="done">
      <sce:setverdict value="pass"/>
    </transition>
  </state>
  <final id="done"/>
</scxml>
