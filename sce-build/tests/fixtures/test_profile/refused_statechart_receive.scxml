<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a branch of the test profile in a statechart that is not a
     test component, where nothing reads sce:receive
     (validation/sce-attribute-unread). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="statechart" name="refused_statechart_receive"
       datamodel="null" initial="waiting">
  <state id="waiting">
    <transition event="go" sce:receive="sut" target="done"/>
  </state>
  <final id="done"/>
</scxml>
