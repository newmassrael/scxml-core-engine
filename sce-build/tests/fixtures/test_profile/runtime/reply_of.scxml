<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §6.2, §11.4: the specific reply its formal
     parameters name: the job it answers and its code. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="reply_of"
       sce:type="record:JobReply">
  <sce:import kind="event-schema" src="job_reply.scxml" as="JobReply"/>
  <datamodel>
    <data id="answers" sce:type="uint32" sce:direction="in"/>
    <data id="code" sce:type="uint32" sce:direction="in"/>
  </datamodel>
  <sce:record-match>
    <sce:specific field="job" param="answers"/>
    <sce:specific field="code" param="code"/>
  </sce:record-match>
</scxml>
