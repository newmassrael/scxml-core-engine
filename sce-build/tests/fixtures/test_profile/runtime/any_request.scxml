<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.4: a request for any job. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="any_request"
       sce:type="record:JobRequest">
  <sce:import kind="event-schema" src="job_request.scxml" as="JobRequest"/>
  <sce:record-match>
    <sce:any-value field="job"/>
  </sce:record-match>
</scxml>
