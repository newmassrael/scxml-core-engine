<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.7: the same exchange as answers_the_job, which
     the suite runs under a guard shorter than the system under test takes to
     answer. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-case" name="answers_before_the_guard"
       sce:configuration="Asking">
  <sce:import kind="test-configuration" src="asking_configuration.scxml" as="Asking"/>
</scxml>
