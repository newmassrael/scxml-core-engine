<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §12.3: the request the generated components of
     the runtime's end-to-end test exchange, naming one job. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="event-schema" name="job_request"
       sce:event-name="job.request">
  <datamodel>
    <data id="job" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
