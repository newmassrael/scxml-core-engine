<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a module parameter of a type no literal of the profile is
     written for, a float (docs/SCE_TEST_PROFILE.md §11.8). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="refused_suite_parameter_float">
  <sce:import kind="test-case" src="completes_in_time.scxml" as="CompletesInTime"/>
  <sce:module-parameter id="ratio" type="float32" value="0.5"/>
  <sce:execute test-case="CompletesInTime"/>
</scxml>
