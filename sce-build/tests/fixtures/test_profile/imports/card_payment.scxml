<?xml version="1.0" encoding="UTF-8"?>
<!-- The record the card case of the payment union holds. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="event-schema" name="card_payment"
       sce:event-name="payment.card">
  <datamodel>
    <data id="last4" sce:type="string[4]" sce:direction="in"/>
    <data id="amount" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
