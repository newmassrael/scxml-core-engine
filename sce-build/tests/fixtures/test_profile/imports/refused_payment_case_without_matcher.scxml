<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a union match of a case that holds a record, with no matcher of
     that record (docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_payment_case_without_matcher"
       sce:type="union:Payment">
  <sce:import kind="union" src="order_payment.scxml" as="Payment"/>
  <sce:union-match variant="card"/>
</scxml>
