<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a value range on a text field of an imported record
     (B.1.2.5, docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_line_range_on_text"
       sce:type="record:OrderLine">
  <sce:import kind="event-schema" src="order_line.scxml" as="OrderLine"/>
  <sce:record-match>
    <sce:value-range field="sku">
      <sce:lower value="1"/>
    </sce:value-range>
    <sce:any-value field="quantity"/>
    <sce:any-value field="color"/>
  </sce:record-match>
</scxml>
