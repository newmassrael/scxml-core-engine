<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a union match whose variant is no case of the imported union
     (docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_payment_unknown_variant"
       sce:type="union:Payment">
  <sce:import kind="union" src="order_payment.scxml" as="Payment"/>
  <sce:union-match variant="cheque"/>
</scxml>
