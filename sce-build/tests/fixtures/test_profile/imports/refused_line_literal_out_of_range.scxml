<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a literal past the range of a uint16 field of an imported record
     (docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_line_literal_out_of_range"
       sce:type="record:OrderLine">
  <sce:import kind="event-schema" src="order_line.scxml" as="OrderLine"/>
  <sce:record-match>
    <sce:any-value field="sku"/>
    <sce:specific field="quantity" value="70000"/>
    <sce:any-value field="color"/>
  </sce:record-match>
</scxml>
