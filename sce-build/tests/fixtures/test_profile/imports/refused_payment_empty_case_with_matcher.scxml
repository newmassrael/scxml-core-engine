<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a union match of a case that holds no record, with a matcher
     (docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_payment_empty_case_with_matcher"
       sce:type="union:Payment">
  <sce:import kind="union" src="order_payment.scxml" as="Payment"/>
  <sce:union-match variant="cash">
    <sce:any-value/>
  </sce:union-match>
</scxml>
