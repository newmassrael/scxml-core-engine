<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: in a record of a list, a literal of an enum that names none of its
     variants (docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_lines_enum_literal"
       sce:type="list&lt;record:OrderLine&gt;[2]">
  <sce:import kind="event-schema" src="order_line.scxml" as="OrderLine"/>
  <sce:list-match>
    <sce:record-match>
      <sce:any-value field="sku"/>
      <sce:any-value field="quantity"/>
      <sce:specific field="color" value="purple"/>
    </sce:record-match>
  </sce:list-match>
</scxml>
