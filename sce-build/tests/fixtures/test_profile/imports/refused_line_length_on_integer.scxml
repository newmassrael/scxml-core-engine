<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a length restriction on an integer field of an imported record
     (B.1.4.1, docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_line_length_on_integer"
       sce:type="record:OrderLine">
  <sce:import kind="event-schema" src="order_line.scxml" as="OrderLine"/>
  <sce:record-match>
    <sce:any-value field="sku"/>
    <sce:any-value field="quantity" length-max="3"/>
    <sce:any-value field="color"/>
  </sce:record-match>
</scxml>
