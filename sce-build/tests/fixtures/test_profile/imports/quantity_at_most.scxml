<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.4: a template over a quantity, its upper
     bound a formal parameter; the templates beside this file reference it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="quantity_at_most"
       sce:type="uint16">
  <datamodel>
    <data id="most" sce:type="uint16" sce:direction="in"/>
  </datamodel>
  <sce:value-range>
    <sce:upper param="most"/>
  </sce:value-range>
</scxml>
