<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §6.2, §11.4: a template whose own matchers are
     values alone, and which is no specific template: the template it
     references for its quantity matches a range. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="order_line_bounded"
       sce:type="record:OrderLine">
  <sce:import kind="event-schema" src="order_line.scxml" as="OrderLine"/>
  <sce:import kind="test-template" src="quantity_at_most.scxml" as="QuantityAtMost"/>
  <datamodel>
    <data id="limit" sce:type="uint16" sce:direction="in"/>
  </datamodel>
  <sce:record-match>
    <sce:specific field="sku" value="A-1"/>
    <sce:template-ref field="quantity" template="QuantityAtMost" args="limit"/>
    <sce:specific field="color" value="blue"/>
  </sce:record-match>
</scxml>
