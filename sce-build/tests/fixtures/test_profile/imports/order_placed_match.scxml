<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.4: a template over an imported record whose
     fields hold a list of records, an optional text matched with ifpresent and
     a length, an optional number matched by a range, a nested record and a
     union, its quantities matched by a parameterised reference and one line
     by a reference to a template of the record under another alias. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="order_placed_match"
       sce:type="record:OrderPlaced">
  <sce:import kind="event-schema" src="order_placed.scxml" as="OrderPlaced"/>
  <sce:import kind="test-template" src="quantity_at_most.scxml" as="QuantityAtMost"/>
  <sce:import kind="test-template" src="order_line_exact.scxml" as="LineExact"/>
  <datamodel>
    <data id="limit" sce:type="uint16" sce:direction="in"/>
  </datamodel>
  <sce:record-match>
    <sce:any-value field="order_id"/>
    <sce:list-match field="lines" length-max="4">
      <sce:record-match>
        <sce:specific field="sku" value="A-1"/>
        <sce:template-ref field="quantity" template="QuantityAtMost" args="limit"/>
        <sce:specific field="color" value="green"/>
      </sce:record-match>
      <sce:template-ref template="LineExact"/>
    </sce:list-match>
    <sce:any-value field="note" length-max="8" ifpresent="true"/>
    <sce:value-range field="priority" ifpresent="true">
      <sce:lower value="1"/>
      <sce:upper value="5"/>
    </sce:value-range>
    <sce:record-match field="customer">
      <sce:any-value field="full_name"/>
      <sce:specific field="vip" value="true"/>
    </sce:record-match>
    <sce:value-list field="payment">
      <sce:union-match variant="card">
        <sce:record-match>
          <sce:any-value field="last4" length-min="4"/>
          <sce:value-range field="amount">
            <sce:lower value="1"/>
          </sce:value-range>
        </sce:record-match>
      </sce:union-match>
      <sce:union-match variant="cash"/>
    </sce:value-list>
  </sce:record-match>
</scxml>
