<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a reference that binds none of the one formal parameter its
     template takes (-1 §15.1, docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_line_reference_arity"
       sce:type="record:OrderLine">
  <sce:import kind="event-schema" src="order_line.scxml" as="OrderLine"/>
  <sce:import kind="test-template" src="quantity_at_most.scxml" as="QuantityAtMost"/>
  <sce:record-match>
    <sce:any-value field="sku"/>
    <sce:template-ref field="quantity" template="QuantityAtMost"/>
    <sce:any-value field="color"/>
  </sce:record-match>
</scxml>
