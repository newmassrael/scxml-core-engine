<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a timer statement that names a timer the component does not
     declare (docs/SCE_TEST_PROFILE.md §11.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_unknown_timer"
       datamodel="sce-static" initial="waiting">
  <sce:test-timer id="reply" duration="2s"/>
  <state id="waiting">
    <onentry>
      <sce:start-timer timer="reply"/>
    </onentry>
    <onexit>
      <sce:stop-timer timer="replay"/>
    </onexit>
    <transition sce:timeout="reply" target="done"/>
  </state>
  <final id="done"/>
</scxml>
