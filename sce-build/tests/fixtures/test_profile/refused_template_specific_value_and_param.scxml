<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a specific value written both as a literal and as a parameter;
     it takes exactly one (docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_template_specific_value_and_param"
       sce:type="uint32">
  <datamodel>
    <data id="limit" sce:type="uint32" sce:direction="in"/>
  </datamodel>
  <sce:specific value="1" param="limit"/>
</scxml>
