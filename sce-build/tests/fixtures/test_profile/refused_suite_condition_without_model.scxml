<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a selection in a suite that imports no feature model, so no
     feature it names is declared (docs/SCE_TEST_PROFILE.md §11.8). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="refused_suite_condition_without_model">
  <sce:import kind="test-case" src="completes_in_time.scxml" as="CompletesInTime"/>
  <sce:execute test-case="CompletesInTime" requires="job-timeout"/>
</scxml>
