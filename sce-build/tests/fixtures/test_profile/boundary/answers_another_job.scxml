<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.7: the component that asks for the job its
     module parameter names, in the configuration of runtime_suite's
     answers_the_job, answered for another job, so it sets `fail`. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-case" name="answers_another_job"
       sce:configuration="Asking">
  <sce:import kind="test-configuration" src="../runtime/asking_configuration.scxml" as="Asking"/>
</scxml>
