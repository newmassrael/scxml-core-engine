<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.6: the PTC remover as the MTC and the request
     listener it invokes as a PTC, their two ports connected to each other. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration" name="removing_configuration">
  <sce:import kind="test-component" src="ptc_remover.scxml" as="PtcRemover"/>
  <sce:import kind="test-component" src="request_listener.scxml" as="RequestListener"/>
  <sce:mtc type="PtcRemover"/>
  <sce:ptc id="listener" type="RequestListener"/>
  <sce:connect>
    <sce:endpoint component="mtc" port="peer"/>
    <sce:endpoint component="listener" port="peer"/>
  </sce:connect>
</scxml>
