<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §4.6 (P6), §4.9 (P9), §5.2 (P13): a main test
     component that creates a PTC connected to it, leaves the state that
     invoked it when its patience runs out, which removes the PTC, and then
     sends a request on the port the removed PTC's port was connected to: a
     dynamic error, which ends the test case with `error`. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="ptc_remover"
       datamodel="sce-static" initial="watching">
  <sce:import kind="test-port-type" src="../runtime/exchange_port.scxml" as="ExchangePort"/>
  <sce:import kind="test-template" src="../runtime/request_of.scxml" as="RequestOf"/>
  <sce:test-port id="peer" type="ExchangePort"/>
  <sce:test-timer id="patience" duration="1ms"/>
  <datamodel>
    <data id="asked" sce:type="uint32" expr="3"/>
  </datamodel>
  <state id="watching">
    <invoke type="http://sce.dev/ext/test-component" src="request_listener.scxml" id="listener"/>
    <onentry>
      <sce:start-timer timer="patience"/>
    </onentry>
    <transition sce:timeout="patience" target="asking"/>
  </state>
  <state id="asking">
    <onentry>
      <send type="http://sce.dev/ext/test-port" target="peer"
            sce:test-template="RequestOf" sce:template-args="asked"/>
    </onentry>
    <transition sce:receive="peer" target="passed">
      <sce:setverdict value="pass"/>
    </transition>
  </state>
  <final id="passed"/>
</scxml>
