<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §5.1 (P12): a main test component that sets its
     verdict `none` and ends, so the test case ends with no verdict but the one
     the document wrote. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="no_verdict_setter"
       datamodel="sce-static" initial="deciding">
  <state id="deciding">
    <onentry>
      <sce:setverdict value="none"/>
    </onentry>
    <transition target="done"/>
  </state>
  <final id="done"/>
</scxml>
