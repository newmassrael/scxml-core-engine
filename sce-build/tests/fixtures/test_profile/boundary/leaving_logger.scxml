<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §4.4 (P4), §12.5: a main test component whose
     receive branch and whose timeout branch each leave a state that logs as
     it is exited, so its test log shows each branch taken (P4 step 1: the
     message received, the timer timed out) before the state it leaves logs
     its exit and before the branch's content runs (P4 step 2). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="leaving_logger"
       datamodel="sce-static" initial="listening">
  <sce:import kind="test-port-type" src="../runtime/exchange_port.scxml" as="ExchangePort"/>
  <sce:test-port id="sut" type="ExchangePort"/>
  <sce:test-timer id="patience" duration="1ms"/>
  <state id="listening">
    <onexit>
      <log label="leaving listening"/>
    </onexit>
    <transition sce:receive="sut" target="waiting">
      <log label="received"/>
    </transition>
  </state>
  <state id="waiting">
    <onentry>
      <sce:start-timer timer="patience"/>
    </onentry>
    <onexit>
      <log label="leaving waiting"/>
    </onexit>
    <transition sce:timeout="patience" target="done">
      <sce:setverdict value="pass"/>
    </transition>
  </state>
  <final id="done"/>
</scxml>
