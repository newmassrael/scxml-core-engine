<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §5.2 (P13): a main test component that waits for
     any reply on its port and holds no timer, so where nothing is sent to it
     no branch can ever fire and no instant is pending. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="stalled_listener"
       datamodel="sce-static" initial="waiting">
  <sce:import kind="test-port-type" src="../runtime/exchange_port.scxml" as="ExchangePort"/>
  <sce:test-port id="sut" type="ExchangePort"/>
  <state id="waiting">
    <transition sce:receive="sut" target="done">
      <sce:setverdict value="pass"/>
    </transition>
  </state>
  <final id="done"/>
</scxml>
