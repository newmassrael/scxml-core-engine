<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.7: the MTC sets the verdict `none` and ends,
     so the test case's verdict is `none`. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-case" name="sets_no_verdict"
       sce:configuration="Unset">
  <sce:import kind="test-configuration" src="unset_configuration.scxml" as="Unset"/>
</scxml>
