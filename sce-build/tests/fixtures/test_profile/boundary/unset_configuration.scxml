<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.6: the component that sets no verdict as the
     MTC, alone and with no port. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration" name="unset_configuration">
  <sce:import kind="test-component" src="no_verdict_setter.scxml" as="NoVerdictSetter"/>
  <sce:mtc type="NoVerdictSetter"/>
</scxml>
