<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a send that binds a variable to a template with no formal
     parameter (docs/SCE_TEST_PROFILE.md §11.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_template_args_count"
       datamodel="sce-static" initial="sending">
  <sce:import kind="test-port-type" src="job_port.scxml" as="JobPort"/>
  <sce:import kind="test-template" src="job_report.scxml" as="JobReport"/>
  <sce:test-port id="sut" type="JobPort"/>
  <datamodel>
    <data id="limit" sce:type="uint32" sce:module-parameter="true"/>
  </datamodel>
  <state id="sending">
    <onentry>
      <send type="http://sce.dev/ext/test-port" target="sut" sce:test-template="JobReport"
            sce:template-args="limit"/>
    </onentry>
    <transition target="done"/>
  </state>
  <final id="done"/>
</scxml>
