<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a test case whose configuration names no imported test
     configuration (docs/SCE_TEST_PROFILE.md §11.7). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-case" name="refused_case_unimported_configuration"
       sce:configuration="TesterAlone">
  <sce:import kind="test-configuration" src="tester_and_helper.scxml" as="TesterAndHelper"/>
</scxml>
