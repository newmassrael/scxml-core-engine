<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a native condition in a test component, which holds sce-static
     expressions alone (docs/adr/0091 §3). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_native_condition"
       datamodel="sce-static" initial="waiting">
  <state id="waiting">
    <transition cond="cpp:ready()" target="done"/>
  </state>
  <final id="done"/>
</scxml>
