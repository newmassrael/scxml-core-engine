     <sce:setverdict> (docs/SCE_TEST_PROFILE.md §8.2). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_donedata"
       datamodel="sce-static" initial="done">
  <final id="done">
    <donedata>
      <content expr="'pass'"/>
    </donedata>
  </final>
</scxml>
