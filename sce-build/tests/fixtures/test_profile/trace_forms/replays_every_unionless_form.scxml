       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-case" name="replays_every_unionless_form"
       sce:configuration="Forms">
  <sce:import kind="test-configuration" src="unionless_forms_configuration.scxml" as="Forms"/>
</scxml>
