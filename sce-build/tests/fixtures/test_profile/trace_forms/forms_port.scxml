<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.3, docs/SCE_TTCN3_LANE.md §10.2: a port that
     takes a record of every form of the canonical value: order_placed (a list
     of records with a closed enum, an optional text and integer, a record, and
     a union of a case with a text, one with nothing and one with a byte
     string), job_status (a list of integers, optional integers) and
     form_extras (the forms the other two do not hold). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="forms_port">
  <sce:import kind="event-schema" src="../imports/order_placed.scxml" as="OrderPlaced"/>
  <sce:import kind="event-schema" src="../job_status.scxml" as="JobStatus"/>
  <sce:import kind="event-schema" src="form_extras.scxml" as="FormExtras"/>
  <sce:message type="OrderPlaced" direction="in"/>
  <sce:message type="JobStatus" direction="in"/>
  <sce:message type="FormExtras" direction="in"/>
</scxml>
