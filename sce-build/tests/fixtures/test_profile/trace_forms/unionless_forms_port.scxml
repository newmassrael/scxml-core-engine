<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.3, docs/SCE_TTCN3_LANE.md §10.2: a port that
     takes a record of every form of the canonical value a backend that lowers
     no union holds: order_taken (a list of records with a closed enum, an
     optional text and integer, a record with a truth value, a byte string),
     job_status (a list of integers, optional integers) and form_extras (an enum
     of an open set, a list of optional elements, a 64-bit integer, a list with
     a lower count, an optional list and a list of lists). forms_port takes
     order_placed in order_taken's place, whose union C++ does not lower. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="unionless_forms_port">
  <sce:import kind="event-schema" src="order_taken.scxml" as="OrderTaken"/>
  <sce:import kind="event-schema" src="../job_status.scxml" as="JobStatus"/>
  <sce:import kind="event-schema" src="form_extras.scxml" as="FormExtras"/>
  <sce:message type="OrderTaken" direction="in"/>
  <sce:message type="JobStatus" direction="in"/>
  <sce:message type="FormExtras" direction="in"/>
</scxml>
