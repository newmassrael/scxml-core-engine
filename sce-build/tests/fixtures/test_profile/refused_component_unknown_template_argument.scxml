<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a template argument that names no variable of the component
     (docs/SCE_TEST_PROFILE.md §11.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_unknown_template_argument"
       datamodel="sce-static" initial="waiting">
  <sce:import kind="test-port-type" src="job_port.scxml" as="JobPort"/>
  <sce:import kind="test-template" src="every_matcher.scxml" as="EveryMatcher"/>
  <sce:test-port id="sut" type="JobPort"/>
  <datamodel>
    <data id="limit" sce:type="uint32" sce:module-parameter="true"/>
  </datamodel>
  <state id="waiting">
    <transition sce:receive="sut" sce:test-template="EveryMatcher" sce:template-args="limt"
                target="done"/>
  </state>
  <final id="done"/>
</scxml>
