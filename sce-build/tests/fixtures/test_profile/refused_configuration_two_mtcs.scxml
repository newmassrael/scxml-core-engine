<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a configuration that names its MTC twice; a test case has one
     main test component (docs/SCE_TEST_PROFILE.md §11.6). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration" name="refused_configuration_two_mtcs">
  <sce:import kind="test-component" src="job_tester.scxml" as="Tester"/>
  <sce:import kind="test-component" src="helper.scxml" as="Helper"/>
  <sce:mtc type="Tester"/>
  <sce:mtc type="Helper"/>
</scxml>
