<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a bound of a value range that is no integer in decimal, at a
     field whose type the record's document states
     (docs/SCE_TEST_PROFILE.md §11.4, B.1.2.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_template_range_bound_not_integer"
       sce:type="record:JobStatus">
  <sce:import kind="event-schema" src="job_status.scxml" as="JobStatus"/>
  <sce:record-match>
    <sce:value-range field="elapsed_ms">
      <sce:lower value="0x10"/>
    </sce:value-range>
  </sce:record-match>
</scxml>
