<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a value range with two lower bounds
     (docs/SCE_TEST_PROFILE.md §11.4, B.1.2.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_template_range_bound_twice"
       sce:type="uint32">
  <sce:value-range>
    <sce:lower value="1"/>
    <sce:lower value="2"/>
  </sce:value-range>
</scxml>
