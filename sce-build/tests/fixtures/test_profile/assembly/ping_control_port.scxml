<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.3: the port two components talk over. A ping
     travels both ways, and the ping schema imports under another alias than
     the port to the system under test gives it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="ping_control_port">
  <sce:import kind="event-schema" src="ping.scxml" as="Nudge"/>
  <sce:message type="Nudge" direction="inout"/>
</scxml>
