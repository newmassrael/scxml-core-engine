<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.7: a test case whose configuration leaves a
     port unjoined; a suite that runs it reaches the refusal of the
     configuration. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-case" name="ping_case_unjoined"
       sce:configuration="Unjoined">
  <sce:import kind="test-configuration" src="refused_configuration_port_unjoined.scxml"
              as="Unjoined"/>
</scxml>
