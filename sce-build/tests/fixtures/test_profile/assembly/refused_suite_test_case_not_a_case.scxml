<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: the import an execute names as its test case is a test
     configuration, not a test case (docs/SCE_TEST_PROFILE.md §11.8). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="refused_suite_test_case_not_a_case">
  <sce:import kind="test-case" src="ping_configuration.scxml" as="Pair"/>
  <sce:module-parameter id="limit" type="uint32" value="500"/>
  <sce:execute test-case="Pair"/>
</scxml>
