<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.7: a test case and the configuration it
     runs in. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-case" name="ping_case"
       sce:configuration="TesterAndHelper">
  <sce:import kind="test-configuration" src="ping_configuration.scxml" as="TesterAndHelper"/>
</scxml>
