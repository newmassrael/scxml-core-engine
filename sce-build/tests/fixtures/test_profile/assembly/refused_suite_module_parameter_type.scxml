<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: the suite declares the module parameter 'limit' a uint16, and
     the tester reads it as a uint32 (docs/SCE_TEST_PROFILE.md §11.8). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="refused_suite_module_parameter_type">
  <sce:import kind="test-case" src="ping_case.scxml" as="PingCase"/>
  <sce:module-parameter id="limit" type="uint16" value="500"/>
  <sce:execute test-case="PingCase"/>
</scxml>
