<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.3: a port that only receives pongs. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="ping_listen_port">
  <sce:import kind="event-schema" src="pong.scxml" as="Pong"/>
  <sce:message type="Pong" direction="in"/>
</scxml>
