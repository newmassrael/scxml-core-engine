<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: the tester the test case runs reads the module parameter
     'limit', and the suite declares none (docs/SCE_TEST_PROFILE.md §11.8). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="refused_suite_module_parameter_undeclared">
  <sce:import kind="test-case" src="ping_case.scxml" as="PingCase"/>
  <sce:module-parameter id="label" type="string[8]" value="nightly"/>
  <sce:execute test-case="PingCase" guard="10s"/>
</scxml>
