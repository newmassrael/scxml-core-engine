<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.5: a test component that creates the PTC
     'b', a ping_loop_b, and waits out a timer. With ping_loop_b.scxml, which
     creates the PTC 'a' in turn, it makes two components that create each
     other. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="ping_loop_a"
       datamodel="sce-static" initial="waiting">
  <sce:test-timer id="wait" duration="1s"/>
  <state id="waiting">
    <invoke type="http://sce.dev/ext/test-component" src="ping_loop_b.scxml" id="b"/>
    <onentry>
      <sce:start-timer timer="wait"/>
    </onentry>
    <transition sce:timeout="wait" target="done"/>
  </state>
  <final id="done"/>
</scxml>
