<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: the PTCs 'a' and 'b' create each other and the MTC creates
     neither, so the invoking relation is no tree rooted at the MTC
     (docs/SCE_TEST_PROFILE.md §11.6). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration" name="refused_configuration_ptc_cycle">
  <sce:import kind="test-component" src="ping_bystander.scxml" as="Bystander"/>
  <sce:import kind="test-component" src="ping_loop_a.scxml" as="LoopA"/>
  <sce:import kind="test-component" src="ping_loop_b.scxml" as="LoopB"/>
  <sce:mtc type="Bystander"/>
  <sce:ptc id="a" type="LoopA"/>
  <sce:ptc id="b" type="LoopB"/>
</scxml>
