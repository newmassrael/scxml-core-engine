<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: the connect joins the tester's port to the system under test to
     the helper's control port, and the ping the helper's port sends is not
     on the tester port's in list, which holds the pong alone
     (docs/SCE_TEST_PROFILE.md §11.6, -1 §21.1.1 b). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration" name="refused_configuration_connect_lists">
  <sce:import kind="test-component" src="ping_tester.scxml" as="Tester"/>
  <sce:import kind="test-component" src="ping_helper.scxml" as="Helper"/>
  <sce:mtc type="Tester"/>
  <sce:ptc id="helper" type="Helper"/>
  <sce:connect>
    <sce:endpoint component="mtc" port="sut"/>
    <sce:endpoint component="helper" port="control"/>
  </sce:connect>
</scxml>
