<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.8: a suite of one test case, selected by a
     feature of its feature model, that declares the module parameter its
     tester reads with the type the tester reads it as. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="ping_suite">
  <sce:import kind="feature-model" src="ping_features.scxml" as="Features"/>
  <sce:import kind="test-case" src="ping_case.scxml" as="PingCase"/>
  <sce:module-parameter id="limit" type="uint32" value="500"/>
  <sce:execute test-case="PingCase" guard="10s" requires="all(ping-echo, ping-retry)"/>
</scxml>
