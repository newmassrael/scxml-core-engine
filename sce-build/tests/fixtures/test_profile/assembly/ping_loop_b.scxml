<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.5: a test component that creates the PTC
     'a', a ping_loop_a, and waits out a timer (see ping_loop_a.scxml). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="ping_loop_b"
       datamodel="sce-static" initial="waiting">
  <sce:test-timer id="wait" duration="1s"/>
  <state id="waiting">
    <invoke type="http://sce.dev/ext/test-component" src="ping_loop_a.scxml" id="a"/>
    <onentry>
      <sce:start-timer timer="wait"/>
    </onentry>
    <transition sce:timeout="wait" target="done"/>
  </state>
  <final id="done"/>
</scxml>
