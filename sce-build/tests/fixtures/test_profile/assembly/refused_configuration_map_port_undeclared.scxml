<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: the map names a port the MTC's type does not declare; a
     bystander has no port (docs/SCE_TEST_PROFILE.md §11.6). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration" name="refused_configuration_map_port_undeclared">
  <sce:import kind="test-component" src="ping_bystander.scxml" as="Bystander"/>
  <sce:import kind="test-port-type" src="ping_system_port.scxml" as="SystemPort"/>
  <sce:mtc type="Bystander"/>
  <sce:system-port id="sut" type="SystemPort"/>
  <sce:map component="mtc" port="sut" system-port="sut"/>
</scxml>
