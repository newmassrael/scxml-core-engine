<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.6: the tester as the MTC and the helper it
     creates as a PTC. The tester's port to the system under test is mapped
     to a port of the test system interface whose type names the same
     messages under other aliases, and the two control ports are connected.
     Every port takes part in exactly one connect or map. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration" name="ping_configuration">
  <sce:import kind="test-component" src="ping_tester.scxml" as="Tester"/>
  <sce:import kind="test-component" src="ping_helper.scxml" as="Helper"/>
  <sce:import kind="test-port-type" src="ping_system_port.scxml" as="SystemPort"/>
  <sce:mtc type="Tester"/>
  <sce:ptc id="helper" type="Helper"/>
  <sce:system-port id="sut" type="SystemPort"/>
  <sce:map component="mtc" port="sut" system-port="sut"/>
  <sce:connect>
    <sce:endpoint component="mtc" port="control"/>
    <sce:endpoint component="helper" port="control"/>
  </sce:connect>
</scxml>
