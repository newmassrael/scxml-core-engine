<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.3: a port that only sends pings. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="ping_speak_port">
  <sce:import kind="event-schema" src="ping.scxml" as="Ping"/>
  <sce:message type="Ping" direction="out"/>
</scxml>
