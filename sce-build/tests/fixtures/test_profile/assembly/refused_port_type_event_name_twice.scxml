<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: two message types of one port type carry the event name
     test.ping, so a port of the type cannot tell them apart
     (docs/SCE_TEST_PROFILE.md §11.3). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-port-type" name="refused_port_type_event_name_twice">
  <sce:import kind="event-schema" src="ping.scxml" as="Ping"/>
  <sce:import kind="event-schema" src="ping_again.scxml" as="PingAgain"/>
  <sce:message type="Ping" direction="out"/>
  <sce:message type="PingAgain" direction="in"/>
</scxml>
