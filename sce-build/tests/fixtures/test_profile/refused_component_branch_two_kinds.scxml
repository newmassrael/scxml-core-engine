<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a transition that both receives and times out; a branch is one
     kind (docs/SCE_TEST_PROFILE.md §8.2). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_branch_two_kinds"
       datamodel="sce-static" initial="waiting">
  <sce:import kind="test-port-type" src="job_port.scxml" as="JobPort"/>
  <sce:test-port id="sut" type="JobPort"/>
  <sce:test-timer id="reply" duration="2s"/>
  <state id="waiting">
    <transition sce:receive="sut" sce:timeout="reply" target="done"/>
  </state>
  <final id="done"/>
</scxml>
