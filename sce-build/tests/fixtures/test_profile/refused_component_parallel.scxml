<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a <parallel> in a test component, which expresses concurrency
     with PTCs (docs/SCE_TEST_PROFILE.md §8.2). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_parallel"
       datamodel="sce-static" initial="both">
  <parallel id="both">
    <state id="left"/>
    <state id="right"/>
    <transition target="done"/>
  </parallel>
  <final id="done"/>
</scxml>
