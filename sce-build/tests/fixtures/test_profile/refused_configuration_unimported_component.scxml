<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: an MTC whose type names no imported test component
     (docs/SCE_TEST_PROFILE.md §11.6). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration"
       name="refused_configuration_unimported_component">
  <sce:import kind="test-component" src="job_tester.scxml" as="Tester"/>
  <sce:mtc type="Testor"/>
</scxml>
