<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a param that names no formal parameter of the template
     (docs/SCE_TEST_PROFILE.md §11.4). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-template" name="refused_template_unknown_parameter"
       sce:type="uint32">
  <datamodel>
    <data id="limit" sce:type="uint32" sce:direction="in"/>
  </datamodel>
  <sce:value-range>
    <sce:upper param="limt"/>
  </sce:value-range>
</scxml>
