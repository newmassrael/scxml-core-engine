<?xml version="1.0" encoding="UTF-8"?>
<!-- Refused: a receive on a port the component does not declare
     (docs/SCE_TEST_PROFILE.md §11.5). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-component" name="refused_component_unknown_receive_port"
       datamodel="sce-static" initial="waiting">
  <sce:import kind="test-port-type" src="job_port.scxml" as="JobPort"/>
  <sce:test-port id="sut" type="JobPort"/>
  <state id="waiting">
    <transition sce:receive="ctl" target="done"/>
  </state>
  <final id="done"/>
</scxml>
