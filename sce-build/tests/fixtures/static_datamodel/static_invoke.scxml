<?xml version="1.0" encoding="UTF-8"?>
<!--
  datamodel="sce-static" (docs/SCE_ACCEPTED_SUBSET.md §2.15, "Saving and
  restoring"): a child session an <invoke> started is part of what a machine is
  doing, so a saved machine that left it out would restore into a state that
  says "working" with nobody working — and nothing would say so.

  `working` invokes `worker`, a child that takes two events in order, `a` then
  `b`, and ends. The parent forwards what it is sent (autoforward), so the host
  drives the child through the parent and a run is read from the parent alone:
  `done.invoke.worker` counts the run in `completed` and leaves the parent in
  `working`, so a machine saved after its child ended stands in the state that
  invokes it with no child running; `finish` leaves for `finished`.

  A format-2 saved state holds `worker` with its whole state, and a restore
  resumes it where it stood (docs/adr/0045): a machine saved after `a` and
  restored ends the child on `b` alone. A format-1 state named the invocation by
  its id alone, and its restore starts `worker` again from its beginning (W3C
  SCXML 6.4: the invocation lives as long as its state is active), so `a` is
  needed again. `abort` leaves `working`, which cancels the child, and `idle` has
  no <invoke> — a saved machine there resumes and restarts nothing.

  The child is a datamodel="sce-static" document: a parent saves only when
  every child it can start can be saved too (docs/adr/0045, "Which documents
  save"), since a format-2 saved state holds the child's own state.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="working" datamodel="sce-static" name="static_invoke">
  <datamodel>
    <data id="completed" sce:type="uint32" expr="0" sce:direction="out"/>
  </datamodel>
  <state id="working">
    <invoke type="scxml" id="worker" autoforward="true">
      <content>
        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="first" datamodel="sce-static">
          <state id="first">
            <transition event="a" target="second"/>
          </state>
          <state id="second">
            <transition event="b" target="leaf"/>
          </state>
          <final id="leaf"/>
        </scxml>
      </content>
    </invoke>
    <!-- `a` and `b` are the child's events. The parent names them, because an
         event its document does not name cannot be sent to it, and what it is
         sent it forwards (autoforward); it does nothing else with them. -->
    <transition event="a"/>
    <transition event="b"/>
    <transition event="done.invoke.worker">
      <assign location="completed" expr="completed + 1"/>
    </transition>
    <transition event="finish" target="finished"/>
    <transition event="abort" target="idle"/>
  </state>
  <state id="idle"/>
  <final id="finished"/>
</scxml>
