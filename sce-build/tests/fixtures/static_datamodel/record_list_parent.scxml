<?xml version="1.0" encoding="UTF-8"?>
<!--
  datamodel="sce-static" (docs/SCE_ACCEPTED_SUBSET.md §2.15, "Child sessions"): a
  statechart that keeps a shared list of records by invoking the standard one
  (sce:std/shared/record_list.scxml, docs/adr/0042) and publishes what the list told
  it, the view an application keeps of the registers it is interested in.

  `holding` invokes the list by its library name and hands it `announce`, so the list
  tells it, once for each change it takes in, every register that change moved: the
  register's count and its first live value in the order of the dots
  (`record_list.register`), then each further value with its place
  (`record_list.value`). The host's words are the list's own events, and the parent
  passes each to its child (`#_list`) as it was given, the way an application turns a
  command into what it sends the list: the host's `record_list.join`, a peer's change
  (`record_list.change`, whose operations are forwarded whole as the list they are,
  docs/adr/0086, section 5.2), and a person's `record_list.edit`. A change of the list's
  own is taken in before it is sent, so it runs whole in a child no Mesh route is given,
  and the send that has no route fails alone (docs/adr/0046, section 4).

  The parent keeps the last register it was told of (`shown`) and the further values
  told after it (`others`, cleared by each register), and counts every event it was
  told (`told`). So a register written once reads as one value; two writes made at
  once, neither having seen the other, read as a count of 2 with the earlier dot
  first, whatever order they arrived in, and the other value after it; a register
  whose every value is written over reads as a count of 0; a write that is already
  held moves nothing and is told nothing; and an edit that writes over two values and
  writes its own, three changes inside the list, is told once. A retire of a row is told
  as each of its registers holding nothing, once, and a write to the row its author had
  not seen brings the field back, which is told as any write is (docs/adr/0046).

  The host's role and room are passed to the list as well, and a change the list
  refuses is told to the parent (`record_list.refused`): it keeps the last refusal
  (`refused`, the command at fault, a value of the enum record_command, and the reason,
  a value of the enum record_refusal) and counts them (`refusedCount`), so a change that
  was not made is never shown as one that was. `refused` is an `optional<record:Refused>`
  that starts absent and takes the payload whole, so before the first refusal the parent
  holds no refusal at all, and not one whose reason stands for none (docs/adr/0055).
  The document names no variant of either enum, so it imports neither: the record holds
  each in the type of the enum document the schema imports (docs/adr/0054).

  The join is passed on with `journal` as the host gave it (docs/adr/0083, docs/adr/0093),
  and so are the host's names for its commands (`command`). A list that keeps a journal
  takes a change of its own in only at the verdict of its delivery layer, which the host
  gives the parent as `record_list.verdict` and the parent passes on, with the host's
  later `record_list.confirm` and `record_list.withdraw` of a change the layer answered
  `waiting`. Such a change is told to the parent as its registers and
  `record_list.pending`, and then as `record_list.confirmed`, or, withdrawn, as the
  registers the withdrawal moved and `record_list.refused` with `withdrawn`; a change the
  layer refused is told as `record_list.refused` with the reason `peerRefused`. The parent
  counts what it is told of pending and confirmed changes (`pendingCount`,
  `confirmedCount`). A scenario's host that throws the list away when it ends joins it
  with `journal` false, and one that plays the host of a journal joins it with true.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="holding" datamodel="sce-static" name="record_list_parent">
  <sce:import kind="event-schema" src="sce:std/shared/record_join.scxml" as="Join"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_edit.scxml" as="Edit"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_change.scxml" as="Change"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_op.scxml" as="Op"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_clear.scxml" as="Clear"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_retire.scxml" as="Retire"/>
  <!-- The records are named for what the list told, and not `Register`: a generated
       name is spelled from the alias, and `register` is a word of C and C++. -->
  <sce:import kind="event-schema" src="sce:std/shared/record_register.scxml" as="Told"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_value.scxml" as="ToldValue"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_role.scxml" as="Role"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_room.scxml" as="Room"/>
  <!-- A refusal the list tells, whose command and reason are values of the enums the
       schema imports. -->
  <sce:import kind="event-schema" src="sce:std/shared/record_refused.scxml" as="Refused"/>
  <!-- The host's words of a change's verdict, passed on, and what the list tells of a
       change taken in provisionally. -->
  <sce:import kind="event-schema" src="sce:std/shared/record_verdict.scxml" as="Verdict"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_confirm.scxml" as="Confirm"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_withdraw.scxml" as="Withdraw"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_pending.scxml" as="Pending"/>
  <sce:import kind="event-schema" src="sce:std/shared/record_confirmed.scxml" as="Confirmed"/>
  <datamodel>
    <data id="told" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="shown" sce:type="record:Told" sce:direction="out">
      <sce:set name="id" expr="0"/>
      <sce:set name="field" expr="0"/>
      <sce:set name="count" expr="0"/>
      <sce:set name="value" expr="0"/>
      <sce:set name="text" expr="''"/>
      <sce:set name="wallTime" expr="0"/>
      <sce:set name="counter" expr="0"/>
      <sce:set name="nodeId" expr="0"/>
    </data>
    <data id="others" sce:type="list&lt;record:ToldValue&gt;[8]" sce:direction="out"/>
    <data id="other" sce:type="record:ToldValue">
      <sce:set name="id" expr="0"/>
      <sce:set name="field" expr="0"/>
      <sce:set name="ordinal" expr="0"/>
      <sce:set name="value" expr="0"/>
      <sce:set name="text" expr="''"/>
      <sce:set name="wallTime" expr="0"/>
      <sce:set name="counter" expr="0"/>
      <sce:set name="nodeId" expr="0"/>
    </data>
    <data id="refused" sce:type="optional&lt;record:Refused&gt;" expr="null" sce:direction="out"/>
    <data id="refusedCount" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="pendingCount" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="confirmedCount" sce:type="uint32" expr="0" sce:direction="out"/>
  </datamodel>
  <state id="holding">
    <invoke type="scxml" id="list" src="sce:std/shared/record_list.scxml">
      <param name="announce" expr="true"/>
    </invoke>

    <!-- What the host says, passed to the list as the list's own words. -->
    <transition event="record_list.join" type="internal">
      <send target="#_list" event="record_list.join">
        <param name="node" expr="_event.data.node"/>
        <param name="journal" expr="_event.data.journal"/>
      </send>
    </transition>
    <transition event="record_list.edit" type="internal">
      <send target="#_list" event="record_list.edit">
        <param name="id" expr="_event.data.id"/>
        <param name="field" expr="_event.data.field"/>
        <param name="value" expr="_event.data.value"/>
        <param name="text" expr="_event.data.text"/>
        <param name="now" expr="_event.data.now"/>
        <param name="more" expr="_event.data.more"/>
        <param name="command" expr="_event.data.command"/>
      </send>
    </transition>
    <transition event="record_list.clear" type="internal">
      <send target="#_list" event="record_list.clear">
        <param name="id" expr="_event.data.id"/>
        <param name="field" expr="_event.data.field"/>
        <param name="now" expr="_event.data.now"/>
        <param name="more" expr="_event.data.more"/>
        <param name="command" expr="_event.data.command"/>
      </send>
    </transition>
    <transition event="record_list.retire" type="internal">
      <send target="#_list" event="record_list.retire">
        <param name="id" expr="_event.data.id"/>
        <param name="now" expr="_event.data.now"/>
        <param name="more" expr="_event.data.more"/>
        <param name="command" expr="_event.data.command"/>
      </send>
    </transition>
    <!-- The verdict of the list's delivery layer on a change it offered, and the host's
         later word on one the layer answered `waiting`. -->
    <transition event="record_list.verdict" type="internal">
      <send target="#_list" event="record_list.verdict">
        <param name="wallTime" expr="_event.data.wallTime"/>
        <param name="counter" expr="_event.data.counter"/>
        <param name="outcome" expr="_event.data.outcome"/>
        <param name="reason" expr="_event.data.reason"/>
      </send>
    </transition>
    <transition event="record_list.confirm" type="internal">
      <send target="#_list" event="record_list.confirm">
        <param name="wallTime" expr="_event.data.wallTime"/>
        <param name="counter" expr="_event.data.counter"/>
        <param name="command" expr="_event.data.command"/>
      </send>
    </transition>
    <transition event="record_list.withdraw" type="internal">
      <send target="#_list" event="record_list.withdraw">
        <param name="wallTime" expr="_event.data.wallTime"/>
        <param name="counter" expr="_event.data.counter"/>
        <param name="command" expr="_event.data.command"/>
      </send>
    </transition>
    <transition event="record_list.role" type="internal">
      <send target="#_list" event="record_list.role">
        <param name="node" expr="_event.data.node"/>
        <param name="role" expr="_event.data.role"/>
      </send>
    </transition>
    <transition event="record_list.room" type="internal">
      <send target="#_list" event="record_list.room">
        <param name="values" expr="_event.data.values"/>
        <param name="history" expr="_event.data.history"/>
        <param name="digest" expr="_event.data.digest"/>
      </send>
    </transition>
    <!-- A peer's change, forwarded whole: its operations are a part of the payload,
         named as the list they are. -->
    <transition event="record_list.change" type="internal">
      <send target="#_list" event="record_list.change">
        <param name="by" expr="_event.data.by"/>
        <param name="wallTime" expr="_event.data.wallTime"/>
        <param name="counter" expr="_event.data.counter"/>
        <param name="ops" expr="_event.data.ops"/>
      </send>
    </transition>

    <!-- What the list tells: a register, which starts what is shown of it anew, and
         each further value of it. -->
    <transition event="record_list.register" type="internal">
      <assign location="shown.id" expr="_event.data.id"/>
      <assign location="shown.field" expr="_event.data.field"/>
      <assign location="shown.count" expr="_event.data.count"/>
      <assign location="shown.value" expr="_event.data.value"/>
      <assign location="shown.text" expr="_event.data.text"/>
      <assign location="shown.wallTime" expr="_event.data.wallTime"/>
      <assign location="shown.counter" expr="_event.data.counter"/>
      <assign location="shown.nodeId" expr="_event.data.nodeId"/>
      <sce:clear target="others"/>
      <assign location="told" expr="told + 1"/>
    </transition>
    <transition event="record_list.value" type="internal">
      <assign location="other.id" expr="_event.data.id"/>
      <assign location="other.field" expr="_event.data.field"/>
      <assign location="other.ordinal" expr="_event.data.ordinal"/>
      <assign location="other.value" expr="_event.data.value"/>
      <assign location="other.text" expr="_event.data.text"/>
      <assign location="other.wallTime" expr="_event.data.wallTime"/>
      <assign location="other.counter" expr="_event.data.counter"/>
      <assign location="other.nodeId" expr="_event.data.nodeId"/>
      <sce:append target="others" expr="other"/>
      <assign location="told" expr="told + 1"/>
    </transition>

    <!-- A change the list refused: the command at fault and why, the last kept whole
         (the first makes `refused` present), and every one counted. -->
    <transition event="record_list.refused" type="internal">
      <assign location="refused" expr="_event.data"/>
      <assign location="refusedCount" expr="refusedCount + 1"/>
    </transition>

    <!-- A change of the list's own taken in provisionally, and one of them carried now. -->
    <transition event="record_list.pending" type="internal">
      <assign location="pendingCount" expr="pendingCount + 1"/>
    </transition>
    <transition event="record_list.confirmed" type="internal">
      <assign location="confirmedCount" expr="confirmedCount + 1"/>
    </transition>
  </state>
</scxml>
