<?xml version="1.0" encoding="UTF-8"?>
<!--
  The host's word that the changes of a copy of the to-do list (todo_peer) up to an instant
  are settled, so that it can forget them: `before`, a wall time in milliseconds. Every
  tombstone (a write someone wrote over) stamped at or before it is dropped, with the add
  it names, and leaves the digest. What the copy shows is unchanged: a register holds the
  values nobody has written over, and a value that was written over is not one of them.

  The host says it only when every copy has taken in every change stamped at or before
  `before` and none is still on its way: a copy that had not taken in a tombstone, or a
  write that arrives again after it, would hold an add nothing any longer says was written
  over, and the value would come back (orset_live). A server that keeps each device's read
  cursor knows it (stable_point); the host tells every copy the same instant.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="todo_compact"
       sce:event-name="todo.compact">
  <datamodel>
    <data id="before" sce:type="int64" sce:direction="in"/>
  </datamodel>
</scxml>
