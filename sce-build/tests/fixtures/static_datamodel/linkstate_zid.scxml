<!--
  A peer's 128-bit zid as its two halves (docs/adr/0108, D1), the key of the inner map. Its event says a peer's face went down.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="linkstate_zid"
       sce:event-name="peer.removed">
  <datamodel>
    <data id="low" sce:type="uint64" sce:direction="in"/>
    <data id="high" sce:type="uint64" sce:direction="in"/>
  </datamodel>
</scxml>
