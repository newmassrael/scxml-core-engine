<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shapes sent as one event (docs/adr/0092, section 12.1): a shape alone, a list
  of one to three of them, and one that may be absent. Read by
  `static_union.scxml`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="event_shapes"
       sce:event-name="shapes.sent">
  <sce:import kind="union" src="union_shape.scxml" as="Shape"/>
  <datamodel>
    <data id="one" sce:type="union:Shape" sce:direction="in"/>
    <data id="many" sce:type="list&lt;union:Shape&gt;[1..3]" sce:direction="in"/>
    <data id="maybe" sce:type="optional&lt;union:Shape&gt;" sce:direction="in"/>
  </datamodel>
</scxml>
