<?xml version="1.0" encoding="UTF-8"?>
<!--
  A client was heard from: which one (`client`) and when it said so (`at`, its own
  clock), as the hub tells every copy for each heartbeat it receives. The same document
  is a copy's entry for a client: `client`, `last` is the latest `at` it holds, and `gen`
  is the number of the renewal the holder made of that entry, so the expiry that comes
  due for one is told from the ones that came due for the renewals before it. In an
  announcement `last` is the heartbeat's `at` and `gen` is not read.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="presence_seen"
       sce:event-name="presence.seen">
  <datamodel>
    <data id="client" sce:type="uint32" sce:direction="in"/>
    <data id="last" sce:type="int64" sce:direction="in"/>
    <data id="gen" sce:type="uint32" sce:direction="in"/>
  </datamodel>
</scxml>
