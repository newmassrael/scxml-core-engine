<?xml version="1.0" encoding="UTF-8"?>
<!--
  A statechart that reads a composed payload at depths 1 to 3 and takes no
  composed value into a variable of its own (docs/adr/0086, section 6): it
  measures `items`, walks it with an index and each item's `tags`, reads a field
  of an element through its index, walks the list of lists `grid` and each of its
  lists, reads `grid[1][0]`, the length of the first item's `tags` and an element
  that may be absent, and takes the list `late` whole into a list of a larger
  bound. Every out variable is what a host reads back of the delivery.

  It reads the schemas beside it: event_batch.scxml (batch.sent, revision 2,
  whose list late the second revision added), event_batch_item.scxml (the
  record each element of items is, holding the list tags) and
  enum_signal_level.scxml. A delivery of the first revision reads late empty.

  It names no backend. Which backends lower it, and the harness that compiles
  and runs its machine on each, are listed once, in docs/SCE_ACCEPTED_SUBSET.md
  section 2.15 ("Which backend lowers a composed value"), whose rows a test
  renders from the one table of what each backend lowers
  (ComposedLowering::of, sce-build/src/forge/event_schema_check.rs). A backend
  whose row does not read a composed payload refuses the read by its own name
  (section 7.3). A backend's step that comes to lower it adds its row and its
  harness line there, and leaves this file as it is, so the
  source hash of every tree generated from it does not move with the step: this
  comment says what the document holds and reads, never which backend lowers it
  (ARCHITECTURE.md, "Composed Values: One Walk, One Module per Backend").
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="idle"
       datamodel="sce-static"
       name="static_composed_payload">
  <sce:import kind="event-schema" src="event_batch.scxml" as="Batch"/>
  <sce:import kind="event-schema" src="event_batch_item.scxml" as="Item"/>
  <sce:import kind="enum" src="enum_signal_level.scxml" as="SignalLevel"/>
  <datamodel>
    <data id="item_count" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="tag_count" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="word_count" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="id_sum" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="cell_sum" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="cell" sce:type="uint8" expr="0" sce:direction="out"/>
    <data id="first_tags" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="first_maybe" sce:type="optional&lt;uint16&gt;" expr="null" sce:direction="out"/>
    <data id="late" sce:type="list&lt;uint8&gt;[4]" sce:direction="out"/>
    <data id="refusals" sce:type="uint32" expr="0" sce:direction="out"/>
  </datamodel>
  <state id="idle">
    <transition event="batch.sent" type="internal">
      <assign location="item_count" expr="len(_event.data.items)"/>
      <assign location="late" expr="_event.data.late"/>
      <foreach array="_event.data.items" item="row" index="i">
        <assign location="tag_count" expr="tag_count + len(row.tags)"/>
        <assign location="id_sum" expr="id_sum + _event.data.items[i].id"/>
        <foreach array="row.tags" item="word">
          <assign location="word_count" expr="word_count + 1"/>
        </foreach>
      </foreach>
      <foreach array="_event.data.grid" item="cells">
        <foreach array="cells" item="n">
          <assign location="cell_sum" expr="cell_sum + n"/>
        </foreach>
      </foreach>
      <if cond="len(_event.data.grid) &gt; 1 &amp;&amp; len(_event.data.grid[1]) &gt; 0">
        <assign location="cell" expr="_event.data.grid[1][0]"/>
      </if>
      <if cond="len(_event.data.items) &gt; 0">
        <assign location="first_tags" expr="len(_event.data.items[0].tags)"/>
      </if>
      <if cond="len(_event.data.maybe) &gt; 0">
        <assign location="first_maybe" expr="_event.data.maybe[0]"/>
      </if>
    </transition>
    <!-- A delivery outside its type is refused whole: none of the content above
         runs, and error.execution says so once. -->
    <transition event="error.execution" type="internal">
      <assign location="refusals" expr="refusals + 1"/>
    </transition>
  </state>
</scxml>
