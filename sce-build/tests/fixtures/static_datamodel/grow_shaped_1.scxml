<!--
  The event that hands static_grow_1.scxml a union whose case holds an inner record.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext" version="1.0"
       sce:kind="event-schema" name="grow_shaped_1" sce:event-name="grow.shaped">
  <sce:import kind="union" src="grow_shape_1.scxml" as="Shape"/>
  <datamodel>
    <data id="shape" sce:type="union:Shape" sce:direction="in"/>
  </datamodel>
</scxml>
