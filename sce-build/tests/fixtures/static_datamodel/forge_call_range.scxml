<?xml version="1.0" encoding="UTF-8"?>
<!--
  A validator that keeps nothing from one check to the next, which
  static_forge_calls.scxml calls as `Range(level, offset)` (docs/adr/0048): a
  level of at most 30 and an offset of at least 0 are valid.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="validator" name="forge_call_range" version="1.0">
  <datamodel>
    <data id="level" sce:type="int32" sce:direction="in" sce:range-max="30"/>
    <data id="offset" sce:type="int32" sce:direction="in" sce:range-min="0"/>
    <data id="valid" sce:type="bool" sce:direction="out"/>
  </datamodel>
</scxml>
