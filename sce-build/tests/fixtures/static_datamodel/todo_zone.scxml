<?xml version="1.0" encoding="UTF-8"?>
<!--
  One transition of the time zone a copy of the to-do list reads wall-clock times in
  (todo_peer): the instant it takes effect (`start`, seconds since 1970-01-01T00:00Z) and
  the UTC offset in force from it until the next transition (`offset`, seconds). The host
  gives them in order of `start`, once each, after a todo.zone_clear; a table is the
  host's, as the operating system's rules are, and is not part of what the people share.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="todo_zone"
       sce:event-name="todo.zone">
  <datamodel>
    <data id="start" sce:type="int64" sce:direction="in"/>
    <data id="offset" sce:type="int32" sce:direction="in"/>
  </datamodel>
</scxml>
