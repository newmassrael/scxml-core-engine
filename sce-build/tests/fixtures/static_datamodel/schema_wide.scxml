<?xml version="1.0" encoding="UTF-8"?>
<!--
  The payload `static_wire_wide.scxml` is handed: two 64-bit integers, one of each
  signedness (SCE Accepted Subset §2.15, "A 64-bit integer"). A 64-bit integer
  crosses as the text of its digits, so a value past 2^53 reaches every engine with
  its low bits.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="schema_wide"
       sce:event-name="wide.in">
  <datamodel>
    <data id="big" sce:type="uint64" sce:direction="in"/>
    <data id="small" sce:type="int64" sce:direction="in"/>
  </datamodel>
</scxml>
