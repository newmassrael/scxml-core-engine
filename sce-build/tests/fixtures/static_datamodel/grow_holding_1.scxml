<!--
  The event that hands static_grow_1.scxml an outer record, which a variable holds as optional:
  a record whose field holds a record has no value before something writes one.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext" version="1.0"
       sce:kind="event-schema" name="grow_holding_1" sce:event-name="grow.holding">
  <sce:import kind="event-schema" src="grow_outer_1.scxml" as="Outer"/>
  <datamodel>
    <data id="outer" sce:type="optional&lt;record:Outer&gt;" sce:direction="in"/>
  </datamodel>
</scxml>
