<?xml version="1.0" encoding="UTF-8"?>
<!--
  datamodel="sce-static" (docs/SCE_ACCEPTED_SUBSET.md §2.15): one
  collection's sync run, as a client of a WebDAV-style server runs it (the
  phases of DAVx⁵'s SyncManager) — upload what was deleted here, upload
  what was changed here, then read what changed there: by sync token
  (RFC 6578) when the server offers it and nothing forces a full listing,
  else by listing the collection. It composes the standard sync rules, and
  is held here rather than in the standard library because a sce-static
  machine lowers for Rust and Kotlin only, and the library promises all six
  backends.

  The host does every request and reports how it ended (`sync.response`),
  a page it applied (`sync.page`), and the end of a phase's requests
  (`sync.phase.done`); the machine decides what each answer means:
  - a delete's answer by sce:std/sync/sync_delete_outcome — a refused
    delete forces the next listing to be full, so the server's copy comes
    back (DAVx⁵ drops it for good under sync-collection);
  - an upload's answer by sync_upload_outcome — a discarded change forces
    a full listing, as DAVx⁵'s discardLocalChange does;
  - a listing refused for its token (DAV:valid-sync-token) falls back to a
    full listing in the same run;
  - any other failure ends the run: `outcome` is sync_failure's action for
    it, and `retryAt` the later of its retry time and any earlier one
    (sync_retry_at; DAVx⁵ overwrites it).

  After a run: `outcome` 0 when it completed, else sync_failure's action;
  `fullListing` whether the next run must list the collection in full;
  `byToken` whether this run read changes by token.

  Driven by the scenario in scenarios/sync_client.json on every backend
  that lowers the model (the committed machines are regenerated by
  scripts/regen_static_datamodel_{rust,kotlin}.sh).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="client" datamodel="sce-static" name="sync_client">
  <sce:import kind="event-schema" src="sce:std/sync/sync_start.scxml" as="Start"/>
  <sce:import kind="event-schema" src="sce:std/sync/sync_response.scxml" as="Response"/>
  <sce:import kind="event-schema" src="sce:std/sync/sync_page.scxml" as="Page"/>
  <sce:import kind="algorithm" src="sce:std/sync/sync_failure.scxml" as="Failure"/>
  <sce:import kind="algorithm" src="sce:std/sync/sync_retry_at.scxml" as="RetryAt"/>
  <sce:import kind="algorithm" src="sce:std/sync/sync_delete_outcome.scxml" as="DeleteOutcome"/>
  <sce:import kind="algorithm" src="sce:std/sync/sync_upload_outcome.scxml" as="UploadOutcome"/>
  <datamodel>
    <data id="byToken" sce:type="bool" expr="false" sce:direction="out"/>
    <data id="fullListing" sce:type="bool" expr="true" sce:direction="out"/>
    <data id="outcome" sce:type="uint8" expr="0" sce:direction="out"/>
    <data id="retryAt" sce:type="int64" expr="0" sce:direction="out"/>
    <data id="deleted" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="uploaded" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="discarded" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="pages" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="refusals" sce:type="uint32" expr="0" sce:direction="out"/>
  </datamodel>

  <state id="client" initial="idle">
    <state id="idle">
      <transition event="sync.start" target="deleting">
        <assign location="byToken" expr="_event.data.byToken &amp;&amp; !fullListing"/>
        <assign location="outcome" expr="0"/>
        <assign location="deleted" expr="0"/>
        <assign location="uploaded" expr="0"/>
        <assign location="discarded" expr="0"/>
        <assign location="pages" expr="0"/>
      </transition>
    </state>

    <state id="deleting">
      <transition event="sync.response"
                  cond="DeleteOutcome(_event.data.kind, _event.data.status) === 0" type="internal">
        <assign location="deleted" expr="deleted + 1"/>
      </transition>
      <!-- Refused: the deletion is forgotten and the server's copy must
           come back, which only a full listing brings. -->
      <transition event="sync.response"
                  cond="DeleteOutcome(_event.data.kind, _event.data.status) === 1" type="internal">
        <assign location="fullListing" expr="true"/>
        <assign location="byToken" expr="false"/>
      </transition>
      <transition event="sync.response" target="idle">
        <assign location="outcome" expr="Failure(_event.data.kind, _event.data.status)"/>
        <assign location="retryAt"
                expr="RetryAt(retryAt, _event.data.kind, _event.data.status, _event.data.now, _event.data.retryAfter)"/>
      </transition>
      <transition event="sync.phase.done" target="uploading"/>
    </state>

    <state id="uploading">
      <!-- A failure that was not a response ends the run before any
           upload rule reads a status. -->
      <transition event="sync.response" cond="_event.data.kind !== 4" target="idle">
        <assign location="outcome" expr="Failure(_event.data.kind, _event.data.status)"/>
        <assign location="retryAt"
                expr="RetryAt(retryAt, _event.data.kind, _event.data.status, _event.data.now, _event.data.retryAfter)"/>
      </transition>
      <transition event="sync.response"
                  cond="UploadOutcome(_event.data.create, _event.data.status, _event.data.davError) === 0"
                  type="internal">
        <assign location="uploaded" expr="uploaded + 1"/>
      </transition>
      <transition event="sync.response"
                  cond="UploadOutcome(_event.data.create, _event.data.status, _event.data.davError) === 1"
                  type="internal">
        <assign location="discarded" expr="discarded + 1"/>
        <assign location="fullListing" expr="true"/>
        <assign location="byToken" expr="false"/>
      </transition>
      <transition event="sync.response" target="idle">
        <assign location="outcome" expr="Failure(4, _event.data.status)"/>
        <assign location="retryAt"
                expr="RetryAt(retryAt, 4, _event.data.status, _event.data.now, _event.data.retryAfter)"/>
      </transition>
      <transition event="sync.phase.done" target="listing"/>
    </state>

    <state id="listing">
      <transition event="sync.page" cond="_event.data.more" type="internal">
        <assign location="pages" expr="pages + 1"/>
      </transition>
      <!-- The last page: the collection is in step, and the next run may
           read by token again. -->
      <transition event="sync.page" target="idle">
        <assign location="pages" expr="pages + 1"/>
        <assign location="fullListing" expr="false"/>
      </transition>
      <!-- The server refused the token: list the collection in full, now. -->
      <transition event="sync.response"
                  cond="byToken &amp;&amp; _event.data.kind === 4 &amp;&amp; _event.data.davError &amp;&amp; (_event.data.status === 403 || _event.data.status === 409)"
                  type="internal">
        <assign location="byToken" expr="false"/>
      </transition>
      <transition event="sync.response" target="idle">
        <assign location="outcome" expr="Failure(_event.data.kind, _event.data.status)"/>
        <assign location="retryAt"
                expr="RetryAt(retryAt, _event.data.kind, _event.data.status, _event.data.now, _event.data.retryAfter)"/>
      </transition>
    </state>

    <!-- A report a rule refused (a status outside its domain): counted, and
         the run stays where it was. -->
    <transition event="error.execution" type="internal">
      <assign location="refusals" expr="refusals + 1"/>
    </transition>
  </state>
</scxml>
