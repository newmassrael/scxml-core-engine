<!--
  datamodel="sce-static" (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A map of a map, a
  list or a record that holds a list"; docs/adr/0108, D12): a map whose value is
  a record that holds a list, the list appended to through the place
  `rows[1].tags`.

  `open` puts the record `row` at key 1, a copy of it: what is written through
  the map later leaves `row` as it was, a map being a value. `tag` takes the
  next tag and appends it to the row's tags, the third of which finds the list
  of two full, raising error.execution. `look` reads a field of the row,
  `sum` walks its tags, and `clear` empties them where they stand. `stray`
  appends to the tags of row 2, which is absent: the append fails before
  anything is written (rule 3).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="tagging" datamodel="sce-static" name="static_map_record_list">
  <sce:import kind="event-schema" src="schema_map_row.scxml" as="Row"/>
  <datamodel>
    <data id="rows" sce:type="map&lt;uint32, record:Row&gt;[2]" sce:direction="out"/>
    <data id="row" sce:type="record:Row" sce:direction="out">
      <sce:set name="id" expr="7"/>
    </data>
    <data id="next" sce:type="uint16" expr="0" sce:direction="out"/>
    <data id="held" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="rowId" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="total" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="errors" sce:type="uint8" expr="0" sce:direction="out"/>
  </datamodel>
  <state id="tagging">
    <transition event="open" type="internal">
      <sce:put target="rows" key="1" expr="row"/>
    </transition>
    <transition event="tag" type="internal">
      <assign location="next" expr="next + 1"/>
      <sce:append target="rows[1].tags" expr="next"/>
      <assign location="held" expr="len(rows[1].tags)"/>
    </transition>
    <transition event="look" type="internal">
      <assign location="rowId" expr="rows[1].id"/>
    </transition>
    <transition event="sum" type="internal">
      <assign location="total" expr="0"/>
      <foreach array="rows[1].tags" item="t">
        <assign location="total" expr="total + t"/>
      </foreach>
    </transition>
    <transition event="stray" type="internal">
      <sce:append target="rows[2].tags" expr="1"/>
    </transition>
    <transition event="clear" type="internal">
      <sce:clear target="rows[1].tags"/>
      <assign location="held" expr="len(rows[1].tags)"/>
    </transition>
    <transition event="error.execution" type="internal">
      <assign location="errors" expr="errors + 1"/>
    </transition>
  </state>
</scxml>
