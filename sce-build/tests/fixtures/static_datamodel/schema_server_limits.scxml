<?xml version="1.0" encoding="UTF-8"?>
<!--
  The limits `static_deployment.scxml`'s deployment supplies (docs/adr/0109, D12): how
  many rows the machine takes and the label it shows. An event schema used as a record
  type: no machine sends `server.limits`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="schema_server_limits"
       sce:event-name="server.limits">
  <datamodel>
    <data id="max_rows" sce:type="uint32" sce:direction="in"/>
    <data id="label" sce:type="string[16]" sce:direction="in"/>
  </datamodel>
</scxml>
