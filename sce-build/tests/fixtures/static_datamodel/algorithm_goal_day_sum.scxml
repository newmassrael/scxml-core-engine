<?xml version="1.0" encoding="UTF-8"?>
<!--
  The days of a list of goals added up (docs/adr/0055), a goal with no day counted as
  `instead`: a list of records whose `day` may be absent in, a number out. Each day
  is read with `??`, whose default is evaluated only for a goal with no day. The sum
  is checked like any integer operation.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       sce:kind="algorithm"
       name="goal_day_sum"
       version="1.0">
  <sce:import kind="event-schema" src="schema_goal.scxml" as="Goal"/>
  <sce:signature>
    <sce:param name="goals" type="list&lt;record:Goal&gt;"/>
    <sce:param name="instead" type="int64"/>
    <sce:return type="int64" may-fail="true"/>
  </sce:signature>
  <sce:body>
    <sce:var name="sum" type="int64" init="0"/>
    <sce:foreach item="g" in="goals">
      <sce:assign target="sum" expr="sum + (g.day ?? instead)"/>
    </sce:foreach>
    <sce:return expr="sum"/>
  </sce:body>
</scxml>
