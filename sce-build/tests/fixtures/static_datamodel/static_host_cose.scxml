<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only WITH AdditionRef-SCE-Linking-Exception OR LicenseRef-SCE-Commercial -->
<!-- SPDX-FileCopyrightText: Copyright (c) 2026 newmassrael -->
<!--
  datamodel="sce-static" (docs/SCE_ACCEPTED_SUBSET.md §2.12, §2.15; the
  standard host features, docs/SCE_HOST_FEATURES.md, "Signing and sealing",
  "Random bytes", "Keyed digests", "Keys", "Credentials" and "Audit log"): one
  machine that asks its host to sign, verify, seal and open COSE objects, to
  derive, generate, export and retire keys, to draw random bytes, to tag and
  verify messages, to issue and revoke credentials, and to append a sign-in
  attempt to its audit log, one operation at a time, and publishes each
  answer. No key enters the machine: it names each by the id its host gave it.
  `audit.sign_in` carries the attempt (schema_audit_sign_in.scxml), whose
  account the log keeps as its keyed digest and whose password it never
  writes.

  Each request record of the library is also the event that asks for it
  (`host.cose.sign1.request`, ...). `cose.held.open` opens the object the
  machine sealed last, which it keeps in `sealed_object`, for a seal whose
  nonce the scenario does not fix. A key's use is a value of the library's
  enum key_use.scxml, in the request and in the event alike, so a use that is
  none of the four cannot be written (docs/adr/0109, step 4 of its order of
  work).

    outcome    `done` when the host answered (a signature or a tag that does
               not verify and an object that does not open included), the
               failure code (`unknown_key`, `key_retired`, `unavailable`) when
               its answer is a failure, `refused` when it declined to start
    signed_object   the object the last signing gave
    valid, signer, payload       the last verification's answer
    sealed_object   the object the last seal gave
    opened, plaintext            the last opening's answer
    derived    the id of the key the last derivation gave
    drawn      the bytes the last draw gave
    tag, tag_valid               the last tag, the last verification of one
    generated  the id of the key the last generation gave
    cose_key   the COSE_Key the last export gave
    retired    the last retirement's answer
    issued_token   the bearer token the last issue gave
    revoked    how many tokens and pins the last revocation took away
    audit_sequence   the sequence the last append was written at

  Only `outcome` is written by a failure or a refusal; what an earlier
  operation published stays.

  The variables that hold a payload, a plaintext and the objects made of them
  name the bounds of the records they are handed to and from (cose_payload,
  cose_signed, cose_plaintext, cose_sealed; docs/adr/0109, D17), so a build
  that moves those bounds moves the machine with them.

  The operations are served by the Rust and C++ reference hosts
  (docs/adr/0107, D7 and D8; docs/adr/0109, D0), and a build for any other
  lane refuses this machine on its first `<invoke>`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="idle" datamodel="sce-static" name="static_host_cose">
  <sce:import kind="event-schema" src="sce:std/host/cose_sign1_request.scxml" as="Sign1Request"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_sign1_result.scxml" as="Sign1Result"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_verify1_request.scxml" as="Verify1Request"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_verify1_result.scxml" as="Verify1Result"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_encrypt0_request.scxml" as="Encrypt0Request"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_encrypt0_result.scxml" as="Encrypt0Result"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_decrypt0_request.scxml" as="Decrypt0Request"/>
  <sce:import kind="event-schema" src="sce:std/host/cose_decrypt0_result.scxml" as="Decrypt0Result"/>
  <sce:import kind="event-schema" src="sce:std/host/key_derive_request.scxml" as="KeyDeriveRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/key_derive_result.scxml" as="KeyDeriveResult"/>
  <sce:import kind="event-schema" src="sce:std/host/random_bytes_request.scxml" as="RandomBytesRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/random_bytes_result.scxml" as="RandomBytesResult"/>
  <sce:import kind="event-schema" src="sce:std/host/mac_request.scxml" as="MacRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/mac_result.scxml" as="MacResult"/>
  <sce:import kind="event-schema" src="sce:std/host/mac_verify_request.scxml" as="MacVerifyRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/mac_verify_result.scxml" as="MacVerifyResult"/>
  <sce:import kind="event-schema" src="sce:std/host/key_generate_request.scxml" as="KeyGenerateRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/key_generate_result.scxml" as="KeyGenerateResult"/>
  <sce:import kind="enum" src="sce:std/host/key_use.scxml" as="KeyUse"/>
  <sce:import kind="event-schema" src="sce:std/host/key_public_request.scxml" as="KeyPublicRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/key_public_result.scxml" as="KeyPublicResult"/>
  <sce:import kind="event-schema" src="sce:std/host/key_retire_request.scxml" as="KeyRetireRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/key_retire_result.scxml" as="KeyRetireResult"/>
  <sce:import kind="event-schema" src="sce:std/host/credential_issue_request.scxml" as="CredentialIssueRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/credential_issue_result.scxml" as="CredentialIssueResult"/>
  <sce:import kind="event-schema" src="sce:std/host/credential_revoke_request.scxml" as="CredentialRevokeRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/credential_revoke_result.scxml" as="CredentialRevokeResult"/>
  <sce:import kind="event-schema" src="sce:std/host/audit_append_request.scxml" as="AuditAppendRequest"/>
  <sce:import kind="event-schema" src="sce:std/host/audit_append_result.scxml" as="AuditAppendResult"/>
  <sce:import kind="event-schema" src="schema_cose_held.scxml" as="HeldOpen"/>
  <sce:import kind="event-schema" src="schema_audit_sign_in.scxml" as="SignIn"/>
  <datamodel>
    <!-- The arguments of the operation the machine is asking for. -->
    <data id="sign_key" sce:type="string[64]" expr="''"/>
    <data id="sign_payload" sce:type="bytes[cose_payload=4096]" expr="''"/>
    <data id="sign_aad" sce:type="bytes[256]" expr="''"/>
    <data id="trust_set" sce:type="string[64]" expr="''"/>
    <data id="verify_cose" sce:type="bytes[cose_signed=4352]" expr="''"/>
    <data id="verify_aad" sce:type="bytes[256]" expr="''"/>
    <data id="seal_key" sce:type="string[64]" expr="''"/>
    <data id="seal_plaintext" sce:type="bytes[cose_plaintext=4352]" expr="''"/>
    <data id="seal_aad" sce:type="bytes[256]" expr="''"/>
    <data id="open_key" sce:type="string[64]" expr="''"/>
    <data id="open_cose" sce:type="bytes[cose_sealed=4480]" expr="''"/>
    <data id="open_aad" sce:type="bytes[256]" expr="''"/>
    <data id="secret" sce:type="bytes[256]" expr="''"/>
    <data id="input_key" sce:type="string[64]" expr="''"/>
    <data id="salt" sce:type="bytes[64]" expr="''"/>
    <data id="info" sce:type="bytes[256]" expr="''"/>
    <data id="draw_length" sce:type="uint16" expr="0"/>
    <data id="tag_key" sce:type="string[64]" expr="''"/>
    <data id="tag_message" sce:type="bytes[mac_message=4096]" expr="''"/>
    <data id="tag_given" sce:type="bytes[32]" expr="''"/>
    <data id="key_use" sce:type="enum:KeyUse" expr="KeyUse.sign"/>
    <data id="key_label" sce:type="string[64]" expr="''"/>
    <data id="export_key" sce:type="string[64]" expr="''"/>
    <data id="retire_key" sce:type="string[64]" expr="''"/>
    <data id="credential_name" sce:type="string[256]" expr="''"/>
    <data id="credential_ttl" sce:type="uint32" expr="0"/>
    <data id="sign_in" sce:type="record:SignIn">
      <sce:set name="account" expr="''"/>
      <sce:set name="password" expr="''"/>
      <sce:set name="result" expr="''"/>
      <sce:set name="attempt" expr="0"/>
    </data>
    <!-- What the machine publishes. -->
    <data id="outcome" sce:type="string[24]" expr="''" sce:direction="out"/>
    <data id="signed_object" sce:type="bytes[cose_signed=4352]" expr="''" sce:direction="out"/>
    <data id="valid" sce:type="bool" expr="false" sce:direction="out"/>
    <data id="signer" sce:type="string[64]" expr="''" sce:direction="out"/>
    <data id="payload" sce:type="bytes[cose_payload=4096]" expr="''" sce:direction="out"/>
    <data id="sealed_object" sce:type="bytes[cose_sealed=4480]" expr="''" sce:direction="out"/>
    <data id="opened" sce:type="bool" expr="false" sce:direction="out"/>
    <data id="plaintext" sce:type="bytes[cose_plaintext=4352]" expr="''" sce:direction="out"/>
    <data id="derived" sce:type="string[64]" expr="''" sce:direction="out"/>
    <data id="drawn" sce:type="bytes[random_bytes=256]" expr="''" sce:direction="out"/>
    <data id="tag" sce:type="bytes[32]" expr="''" sce:direction="out"/>
    <data id="tag_valid" sce:type="bool" expr="false" sce:direction="out"/>
    <data id="generated" sce:type="string[64]" expr="''" sce:direction="out"/>
    <data id="cose_key" sce:type="bytes[128]" expr="''" sce:direction="out"/>
    <data id="retired" sce:type="bool" expr="false" sce:direction="out"/>
    <data id="issued_token" sce:type="string[64]" expr="''" sce:direction="out"/>
    <data id="revoked" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="audit_sequence" sce:type="string[20]" expr="''" sce:direction="out"/>
  </datamodel>

  <state id="idle">
    <transition event="host.cose.sign1.request" target="signing">
      <assign location="sign_key" expr="_event.data.key_id"/>
      <assign location="sign_payload" expr="_event.data.payload"/>
      <assign location="sign_aad" expr="_event.data.external_aad"/>
    </transition>
    <transition event="host.cose.verify1.request" target="verifying">
      <assign location="trust_set" expr="_event.data.trust_set"/>
      <assign location="verify_cose" expr="_event.data.cose"/>
      <assign location="verify_aad" expr="_event.data.external_aad"/>
    </transition>
    <transition event="host.cose.encrypt0.request" target="sealing">
      <assign location="seal_key" expr="_event.data.key_id"/>
      <assign location="seal_plaintext" expr="_event.data.plaintext"/>
      <assign location="seal_aad" expr="_event.data.external_aad"/>
    </transition>
    <transition event="host.cose.decrypt0.request" target="opening">
      <assign location="open_key" expr="_event.data.key_id"/>
      <assign location="open_cose" expr="_event.data.cose"/>
      <assign location="open_aad" expr="_event.data.external_aad"/>
    </transition>
    <transition event="cose.held.open" target="opening">
      <assign location="open_key" expr="_event.data.key_id"/>
      <assign location="open_cose" expr="sealed_object"/>
      <assign location="open_aad" expr="_event.data.external_aad"/>
    </transition>
    <transition event="host.key.derive.request" target="deriving">
      <assign location="secret" expr="_event.data.secret"/>
      <assign location="input_key" expr="_event.data.input_key_id"/>
      <assign location="salt" expr="_event.data.salt"/>
      <assign location="info" expr="_event.data.info"/>
    </transition>
    <transition event="host.random.bytes.request" target="drawing">
      <assign location="draw_length" expr="_event.data.length"/>
    </transition>
    <transition event="host.mac.request" target="tagging">
      <assign location="tag_key" expr="_event.data.key_id"/>
      <assign location="tag_message" expr="_event.data.message"/>
    </transition>
    <transition event="host.mac.verify.request" target="checking">
      <assign location="tag_key" expr="_event.data.key_id"/>
      <assign location="tag_message" expr="_event.data.message"/>
      <assign location="tag_given" expr="_event.data.tag"/>
    </transition>
    <transition event="host.key.generate.request" target="generating">
      <assign location="key_use" expr="_event.data.key_use"/>
      <assign location="key_label" expr="_event.data.label"/>
    </transition>
    <transition event="host.key.public.request" target="exporting">
      <assign location="export_key" expr="_event.data.key_id"/>
    </transition>
    <transition event="host.key.retire.request" target="retiring">
      <assign location="retire_key" expr="_event.data.key_id"/>
    </transition>
    <transition event="host.credential.issue.request" target="issuing">
      <assign location="credential_name" expr="_event.data.name"/>
      <assign location="credential_ttl" expr="_event.data.ttl_s"/>
    </transition>
    <transition event="host.credential.revoke.request" target="revoking">
      <assign location="credential_name" expr="_event.data.name"/>
    </transition>
    <transition event="audit.sign_in" target="auditing">
      <assign location="sign_in" expr="_event.data"/>
    </transition>
  </state>

  <state id="signing">
    <invoke type="sce-host-cose-sign1" id="sign" sce:request="Sign1Request" sce:result="Sign1Result">
      <param name="key_id" expr="sign_key"/>
      <param name="payload" expr="sign_payload"/>
      <param name="external_aad" expr="sign_aad"/>
    </invoke>
    <transition event="done.invoke.sign" cond="_event.data.error === ''" target="idle">
      <assign location="signed_object" expr="_event.data.cose"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.sign" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="verifying">
    <invoke type="sce-host-cose-verify1" id="verify" sce:request="Verify1Request" sce:result="Verify1Result">
      <param name="trust_set" expr="trust_set"/>
      <param name="cose" expr="verify_cose"/>
      <param name="external_aad" expr="verify_aad"/>
    </invoke>
    <transition event="done.invoke.verify" cond="_event.data.error === ''" target="idle">
      <assign location="valid" expr="_event.data.valid"/>
      <assign location="signer" expr="_event.data.key_id"/>
      <assign location="payload" expr="_event.data.payload"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.verify" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="sealing">
    <invoke type="sce-host-cose-encrypt0" id="seal" sce:request="Encrypt0Request" sce:result="Encrypt0Result">
      <param name="key_id" expr="seal_key"/>
      <param name="plaintext" expr="seal_plaintext"/>
      <param name="external_aad" expr="seal_aad"/>
    </invoke>
    <transition event="done.invoke.seal" cond="_event.data.error === ''" target="idle">
      <assign location="sealed_object" expr="_event.data.cose"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.seal" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="opening">
    <invoke type="sce-host-cose-decrypt0" id="open" sce:request="Decrypt0Request" sce:result="Decrypt0Result">
      <param name="key_id" expr="open_key"/>
      <param name="cose" expr="open_cose"/>
      <param name="external_aad" expr="open_aad"/>
    </invoke>
    <transition event="done.invoke.open" cond="_event.data.error === ''" target="idle">
      <assign location="opened" expr="_event.data.opened"/>
      <assign location="plaintext" expr="_event.data.plaintext"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.open" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="deriving">
    <invoke type="sce-host-key-derive" id="derive" sce:request="KeyDeriveRequest" sce:result="KeyDeriveResult">
      <param name="secret" expr="secret"/>
      <param name="input_key_id" expr="input_key"/>
      <param name="salt" expr="salt"/>
      <param name="info" expr="info"/>
    </invoke>
    <transition event="done.invoke.derive" cond="_event.data.error === ''" target="idle">
      <assign location="derived" expr="_event.data.key_id"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.derive" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="drawing">
    <invoke type="sce-host-random-bytes" id="draw" sce:request="RandomBytesRequest" sce:result="RandomBytesResult">
      <param name="length" expr="draw_length"/>
    </invoke>
    <transition event="done.invoke.draw" cond="_event.data.error === ''" target="idle">
      <assign location="drawn" expr="_event.data.bytes"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.draw" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="tagging">
    <invoke type="sce-host-mac" id="mac" sce:request="MacRequest" sce:result="MacResult">
      <param name="key_id" expr="tag_key"/>
      <param name="message" expr="tag_message"/>
    </invoke>
    <transition event="done.invoke.mac" cond="_event.data.error === ''" target="idle">
      <assign location="tag" expr="_event.data.tag"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.mac" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="checking">
    <invoke type="sce-host-mac-verify" id="mac_verify" sce:request="MacVerifyRequest" sce:result="MacVerifyResult">
      <param name="key_id" expr="tag_key"/>
      <param name="message" expr="tag_message"/>
      <param name="tag" expr="tag_given"/>
    </invoke>
    <transition event="done.invoke.mac_verify" cond="_event.data.error === ''" target="idle">
      <assign location="tag_valid" expr="_event.data.valid"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.mac_verify" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="generating">
    <invoke type="sce-host-key-generate" id="key_generate" sce:request="KeyGenerateRequest" sce:result="KeyGenerateResult">
      <param name="key_use" expr="key_use"/>
      <param name="label" expr="key_label"/>
    </invoke>
    <transition event="done.invoke.key_generate" cond="_event.data.error === ''" target="idle">
      <assign location="generated" expr="_event.data.key_id"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.key_generate" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="exporting">
    <invoke type="sce-host-key-public" id="key_public" sce:request="KeyPublicRequest" sce:result="KeyPublicResult">
      <param name="key_id" expr="export_key"/>
    </invoke>
    <transition event="done.invoke.key_public" cond="_event.data.error === ''" target="idle">
      <assign location="cose_key" expr="_event.data.cose_key"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.key_public" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="retiring">
    <invoke type="sce-host-key-retire" id="key_retire" sce:request="KeyRetireRequest" sce:result="KeyRetireResult">
      <param name="key_id" expr="retire_key"/>
    </invoke>
    <transition event="done.invoke.key_retire" cond="_event.data.error === ''" target="idle">
      <assign location="retired" expr="_event.data.retired"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.key_retire" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="issuing">
    <invoke type="sce-host-credential-issue" id="credential_issue" sce:request="CredentialIssueRequest" sce:result="CredentialIssueResult">
      <param name="name" expr="credential_name"/>
      <param name="ttl_s" expr="credential_ttl"/>
    </invoke>
    <transition event="done.invoke.credential_issue" cond="_event.data.error === ''" target="idle">
      <assign location="issued_token" expr="_event.data.token"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.credential_issue" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="revoking">
    <invoke type="sce-host-credential-revoke" id="credential_revoke" sce:request="CredentialRevokeRequest" sce:result="CredentialRevokeResult">
      <param name="name" expr="credential_name"/>
    </invoke>
    <transition event="done.invoke.credential_revoke" cond="_event.data.error === ''" target="idle">
      <assign location="revoked" expr="_event.data.revoked"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.credential_revoke" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>

  <state id="auditing">
    <invoke type="sce-host-audit-append" id="audit" sce:request="AuditAppendRequest" sce:result="AuditAppendResult" sce:entry="SignIn">
      <param name="stream" expr="'sign-ins'"/>
      <param name="entry" expr="sign_in"/>
    </invoke>
    <transition event="done.invoke.audit" cond="_event.data.error === ''" target="idle">
      <assign location="audit_sequence" expr="_event.data.sequence"/>
      <assign location="outcome" expr="'done'"/>
    </transition>
    <transition event="done.invoke.audit" target="idle">
      <assign location="outcome" expr="_event.data.error"/>
    </transition>
    <transition event="error.execution" target="idle">
      <assign location="outcome" expr="'refused'"/>
    </transition>
  </state>
</scxml>
