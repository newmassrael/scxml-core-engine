<?xml version="1.0" encoding="UTF-8"?>
<!--
  datamodel="sce-static" (docs/SCE_ACCEPTED_SUBSET.md §2.15): the `namelist` of
  a <send>. Each name is a variable the machine holds, carried as the pair
  `<param name="x" expr="x"/>` it abbreviates: read from the machine's fields
  when the <send> runs and crossing as the value the variable has, an enum
  value as the name its enum declares. The machine sends itself `view.shown` and
  reads it back through the schema, so what arrived is what the variables held.

  `send.mixed` writes a name in the `namelist` and a computed value in a
  <param>: the pairs of both go in the one event.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="viewing" datamodel="sce-static" name="static_send_namelist">
  <sce:import kind="event-schema" src="schema_view.scxml" as="View"/>
  <sce:import kind="enum" src="enum_view_mode.scxml" as="ViewMode"/>
  <datamodel>
    <data id="layout" sce:type="enum:ViewMode" expr="ViewMode.week" sce:direction="out"/>
    <data id="zoom" sce:type="uint8" expr="3" sce:direction="out"/>
    <data id="received" sce:type="enum:ViewMode" expr="ViewMode.month" sce:direction="out"/>
    <data id="level" sce:type="uint8" expr="0" sce:direction="out"/>
    <data id="deliveries" sce:type="uint32" expr="0" sce:direction="out"/>
  </datamodel>
  <state id="viewing">
    <transition event="pick" type="internal">
      <assign location="layout" expr="ViewMode.agenda_list"/>
      <assign location="zoom" expr="9"/>
    </transition>
    <transition event="send.names" type="internal">
      <send event="view.shown" namelist="layout zoom"/>
    </transition>
    <transition event="send.mixed" type="internal">
      <send event="view.shown" namelist="layout">
        <param name="zoom" expr="zoom + 1"/>
      </send>
    </transition>
    <transition event="view.shown" type="internal">
      <assign location="received" expr="_event.data.layout"/>
      <assign location="level" expr="_event.data.zoom"/>
      <assign location="deliveries" expr="deliveries + 1"/>
    </transition>
  </state>
</scxml>
