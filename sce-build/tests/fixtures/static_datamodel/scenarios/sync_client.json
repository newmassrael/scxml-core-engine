{
  "machine": "sync_client",
  "about": "One scenario every backend that lowers datamodel=\"sce-static\" replays against sync_client.scxml: after each step the machine's saved state must show `state` as its current state and every listed variable at its value. Expected values are derived from the document, not observed from a backend.",
  "steps": [
    { "note": "a new client lists in full on its first run",
      "expect": { "state": "idle", "variables": { "byToken": false, "fullListing": true, "outcome": 0, "retryAt": 0, "refusals": 0 } } },

    { "note": "run 1: a token is on offer, but nothing was listed yet",
      "event": "sync.start", "data": { "byToken": true },
      "expect": { "state": "deleting", "variables": { "byToken": false } } },
    { "event": "sync.response", "data": { "kind": 4, "status": 204, "create": false, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "deleting", "variables": { "deleted": 1 } } },
    { "note": "a delete the server no longer had counts as done",
      "event": "sync.response", "data": { "kind": 4, "status": 404, "create": false, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "deleting", "variables": { "deleted": 2 } } },
    { "event": "sync.phase.done",
      "expect": { "state": "uploading" } },
    { "event": "sync.response", "data": { "kind": 4, "status": 201, "create": true, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "uploading", "variables": { "uploaded": 1 } } },
    { "event": "sync.phase.done",
      "expect": { "state": "listing" } },
    { "note": "the listing's one page ends the run; the next may read by token",
      "event": "sync.page", "data": { "more": false },
      "expect": { "state": "idle", "variables": { "pages": 1, "fullListing": false, "outcome": 0, "deleted": 2, "uploaded": 1 } } },

    { "note": "run 2: by token",
      "event": "sync.start", "data": { "byToken": true },
      "expect": { "state": "deleting", "variables": { "byToken": true, "deleted": 0, "uploaded": 0, "pages": 0 } } },
    { "note": "a refused delete: its item must come back, so the listing goes full (DAVx5 would lose it)",
      "event": "sync.response", "data": { "kind": 4, "status": 412, "create": false, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "deleting", "variables": { "fullListing": true, "byToken": false, "deleted": 0 } } },
    { "event": "sync.phase.done",
      "expect": { "state": "uploading" } },
    { "note": "a change the server refused is discarded, and the server's copy fetched",
      "event": "sync.response", "data": { "kind": 4, "status": 412, "create": false, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "uploading", "variables": { "discarded": 1, "fullListing": true } } },
    { "event": "sync.phase.done",
      "expect": { "state": "listing" } },
    { "event": "sync.page", "data": { "more": true },
      "expect": { "state": "listing", "variables": { "pages": 1 } } },
    { "event": "sync.page", "data": { "more": false },
      "expect": { "state": "idle", "variables": { "pages": 2, "fullListing": false, "outcome": 0 } } },

    { "note": "run 3: the server refuses the token, and the run lists in full",
      "event": "sync.start", "data": { "byToken": true },
      "expect": { "state": "deleting", "variables": { "byToken": true } } },
    { "event": "sync.phase.done",
      "expect": { "state": "uploading" } },
    { "event": "sync.phase.done",
      "expect": { "state": "listing" } },
    { "event": "sync.response", "data": { "kind": 4, "status": 403, "create": false, "davError": true, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "listing", "variables": { "byToken": false, "outcome": 0 } } },
    { "event": "sync.page", "data": { "more": false },
      "expect": { "state": "idle", "variables": { "pages": 1, "fullListing": false, "outcome": 0 } } },

    { "note": "run 4: a 503 with an hour of Retry-After ends the run",
      "event": "sync.start", "data": { "byToken": false },
      "expect": { "state": "deleting", "variables": { "byToken": false } } },
    { "event": "sync.phase.done",
      "expect": { "state": "uploading" } },
    { "event": "sync.phase.done",
      "expect": { "state": "listing" } },
    { "event": "sync.response", "data": { "kind": 4, "status": 503, "create": false, "davError": false, "now": 1000, "retryAfter": 3600 },
      "expect": { "state": "idle", "variables": { "outcome": 1, "retryAt": 4600 } } },

    { "note": "run 5: a 502 on a delete asks for 15 minutes; the hour already asked for stands (DAVx5 would overwrite it)",
      "event": "sync.start", "data": { "byToken": false },
      "expect": { "state": "deleting", "variables": { "outcome": 0, "retryAt": 4600 } } },
    { "event": "sync.response", "data": { "kind": 4, "status": 502, "create": false, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "idle", "variables": { "outcome": 1, "retryAt": 4600 } } },

    { "note": "run 6: a 401 on an upload asks for sign-in",
      "event": "sync.start", "data": { "byToken": false },
      "expect": { "state": "deleting" } },
    { "event": "sync.phase.done",
      "expect": { "state": "uploading" } },
    { "event": "sync.response", "data": { "kind": 4, "status": 401, "create": false, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "idle", "variables": { "outcome": 3, "uploaded": 0, "discarded": 0 } } },

    { "note": "run 7: a transport failure on an upload retries later",
      "event": "sync.start", "data": { "byToken": false },
      "expect": { "state": "deleting" } },
    { "event": "sync.phase.done",
      "expect": { "state": "uploading" } },
    { "event": "sync.response", "data": { "kind": 1, "status": 0, "create": false, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "idle", "variables": { "outcome": 1, "retryAt": 4600 } } },

    { "note": "run 8: a cancelled run stops quietly",
      "event": "sync.start", "data": { "byToken": false },
      "expect": { "state": "deleting" } },
    { "event": "sync.phase.done",
      "expect": { "state": "uploading" } },
    { "event": "sync.phase.done",
      "expect": { "state": "listing" } },
    { "event": "sync.response", "data": { "kind": 7, "status": 0, "create": false, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "idle", "variables": { "outcome": 4, "refusals": 0 } } },

    { "note": "a report outside the rules' domain: both guards and both assignments that read it fail into error.execution (W3C SCXML 5.9.1: a condition that cannot be evaluated is false), and the run ends where the unconditioned transition goes",
      "event": "sync.start", "data": { "byToken": false },
      "expect": { "state": "deleting", "variables": { "outcome": 0 } } },
    { "event": "sync.response", "data": { "kind": 4, "status": 100, "create": false, "davError": false, "now": 1000, "retryAfter": 0 },
      "expect": { "state": "idle", "variables": { "refusals": 4, "outcome": 0, "retryAt": 4600 } } }
  ]
}
