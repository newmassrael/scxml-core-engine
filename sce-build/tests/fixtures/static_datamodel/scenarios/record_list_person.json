{
  "machine": "sce:std/shared/record_list",
  "about": "A person's copy of the standard shared record list (sce:std/shared/record_list.scxml), node 1: its own changes stamped and sent whole by the route `#people`, writes made at once kept side by side, a write-over taking out only the value its writer saw, a text past the bound, a role and a room refusing a change of its own whole, and the roster judged on a peer's change too: one whose author may only read is taken in as no change and counted in `denied`. Expected values are computed by a model of the list, not observed from a backend.",
  "steps": [
    {"note": "started: a copy that holds nothing", "expect": {"state": "open", "sent": [], "variables": {"node": "0", "values": [], "refusals": 0}}},
    {"note": "the host names the copy, node 1", "event": "record_list.join", "data": {"node": "1"}, "expect": {"state": "open", "sent": [], "variables": {"node": "1"}}},
    {"note": "a person's change is stamped after everything seen, taken in here, and sent to its peers on `#people`", "event": "record_list.edit", "data": {"id": 7, "field": 1, "value": "0", "text": "buy milk", "now": "1727000040000"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.change", "data": {"by": "1", "wallTime": "1727000040000", "counter": 0, "ops": [{"kind": 0, "id": 7, "field": 1, "value": "0", "text": "buy milk", "wallTime": "0", "counter": 0, "nodeId": "0"}]}}], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "buy milk", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000040000", "counter": 0, "nodeId": "1"}, "adds": [{"element": "458753", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}]}}},
    {"note": "another person's change to the same field, made without seeing this one, is kept beside it", "event": "record_list.change", "data": {"by": "2", "wallTime": "1727000040000", "counter": 0, "ops": [{"kind": 0, "id": 7, "field": 1, "value": "0", "text": "buy oat milk", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "buy milk", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}, {"id": "7", "field": "1", "value": "0", "text": "buy oat milk", "wallTime": "1727000040000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000040000", "counter": 1, "nodeId": "1"}}}},
    {"note": "a change over the field writes over the two values seen, each named, then the write, one change", "event": "record_list.edit", "data": {"id": 7, "field": 1, "value": "0", "text": "call home", "now": "1727000041000"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.change", "data": {"by": "1", "wallTime": "1727000041000", "counter": 0, "ops": [{"kind": 1, "id": 7, "field": 1, "value": "0", "text": "", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}, {"kind": 1, "id": 7, "field": 1, "value": "0", "text": "", "wallTime": "1727000040000", "counter": 0, "nodeId": "2"}, {"kind": 0, "id": 7, "field": 1, "value": "0", "text": "call home", "wallTime": "0", "counter": 0, "nodeId": "0"}]}}], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "458753", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}]}}},
    {"note": "two people write one field at once again", "event": "record_list.change", "data": {"by": "2", "wallTime": "1727000160000", "counter": 0, "ops": [{"kind": 0, "id": 8, "field": 1, "value": "1", "text": "", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "1", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "2"}]}}},
    {"note": "the other writer's value of the same instant, from node 3, is held beside it", "event": "record_list.change", "data": {"by": "3", "wallTime": "1727000160000", "counter": 0, "ops": [{"kind": 0, "id": 8, "field": 1, "value": "2", "text": "", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "1", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "2"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}]}}},
    {"note": "a write-over names only the value its writer saw: the one written at the same time stays", "event": "record_list.change", "data": {"by": "3", "wallTime": "1727000161000", "counter": 0, "ops": [{"kind": 1, "id": 8, "field": 1, "value": "0", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "2"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}], "adds": [{"element": "458753", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"element": "524289", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}]}}},
    {"note": "a text one byte past what a person writes is refused whole: nothing is stamped or sent", "event": "record_list.edit", "data": {"id": 9, "field": 1, "value": "0", "text": "a title that is one byte too long", "now": "1727000220000"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000161000", "counter": 1, "nodeId": "1"}, "refusals": 1}}},
    {"note": "the host lets this copy's member only read", "event": "record_list.role", "data": {"node": "1", "role": 1}, "expect": {"state": "open", "sent": [], "variables": {"denied": 0}}},
    {"note": "a change of its own is refused for it, before anything is stamped or sent", "event": "record_list.edit", "data": {"id": 9, "field": 1, "value": "0", "text": "tea", "now": "1727000220000"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000161000", "counter": 1, "nodeId": "1"}, "denied": 1}}},
    {"note": "the host lets it write again", "event": "record_list.role", "data": {"node": "1", "role": 2}, "expect": {"state": "open", "sent": [], "variables": {"denied": 1}}},
    {"note": "and lets node 2 only read: the roster is judged on every copy", "event": "record_list.role", "data": {"node": "2", "role": 1}, "expect": {"state": "open", "sent": [], "variables": {"denied": 1}}},
    {"note": "and lets node 3 write", "event": "record_list.role", "data": {"node": "3", "role": 2}, "expect": {"state": "open", "sent": [], "variables": {"denied": 1}}},
    {"note": "a change of a member who may only read is taken in as no change, and counted", "event": "record_list.change", "data": {"by": "2", "wallTime": "1727000170000", "counter": 0, "ops": [{"kind": 0, "id": 9, "field": 2, "value": "1", "text": "", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000161000", "counter": 1, "nodeId": "1"}, "denied": 2}}},
    {"note": "a writer's change is taken in", "event": "record_list.change", "data": {"by": "3", "wallTime": "1727000170000", "counter": 0, "ops": [{"kind": 0, "id": 9, "field": 3, "value": "1", "text": "", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}, {"id": "9", "field": "3", "value": "1", "text": "", "wallTime": "1727000170000", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000170000", "counter": 1, "nodeId": "1"}, "denied": 2}}},
    {"note": "the host takes node 2 off the roster", "event": "record_list.role", "data": {"node": "2", "role": 0}, "expect": {"state": "open", "sent": [], "variables": {"denied": 2}}},
    {"note": "and node 3", "event": "record_list.role", "data": {"node": "3", "role": 0}, "expect": {"state": "open", "sent": [], "variables": {"denied": 2}}},
    {"note": "and node 1, so the roster is empty and refuses no one", "event": "record_list.role", "data": {"node": "1", "role": 0}, "expect": {"state": "open", "sent": [], "variables": {"denied": 2}}},
    {"note": "node 2's change is taken in now", "event": "record_list.change", "data": {"by": "2", "wallTime": "1727000171000", "counter": 0, "ops": [{"kind": 0, "id": 9, "field": 2, "value": "1", "text": "", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}, {"id": "9", "field": "3", "value": "1", "text": "", "wallTime": "1727000170000", "counter": 0, "nodeId": "3"}, {"id": "9", "field": "2", "value": "1", "text": "", "wallTime": "1727000171000", "counter": 0, "nodeId": "2"}], "denied": 2}}},
    {"note": "the host gives the list room for the values it holds and no more", "event": "record_list.room", "data": {"values": 4, "history": 0, "digest": 0}, "expect": {"state": "open", "sent": [], "variables": {"full": 0}}},
    {"note": "a change to a register with no value would pass the room: refused whole and counted", "event": "record_list.edit", "data": {"id": 9, "field": 1, "value": "0", "text": "tea", "now": "1727000220000"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}, {"id": "9", "field": "3", "value": "1", "text": "", "wallTime": "1727000170000", "counter": 0, "nodeId": "3"}, {"id": "9", "field": "2", "value": "1", "text": "", "wallTime": "1727000171000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000171000", "counter": 1, "nodeId": "1"}, "full": 1}}},
    {"note": "a change to a register that holds a value adds none and is taken", "event": "record_list.edit", "data": {"id": 8, "field": 1, "value": "5", "text": "", "now": "1727000220000"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.change", "data": {"by": "1", "wallTime": "1727000220000", "counter": 0, "ops": [{"kind": 1, "id": 8, "field": 1, "value": "0", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}, {"kind": 0, "id": 8, "field": 1, "value": "5", "text": "", "wallTime": "0", "counter": 0, "nodeId": "0"}]}}], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "9", "field": "3", "value": "1", "text": "", "wallTime": "1727000170000", "counter": 0, "nodeId": "3"}, {"id": "9", "field": "2", "value": "1", "text": "", "wallTime": "1727000171000", "counter": 0, "nodeId": "2"}, {"id": "8", "field": "1", "value": "5", "text": "", "wallTime": "1727000220000", "counter": 0, "nodeId": "1"}], "full": 1, "clock": {"wallTime": "1727000220000", "counter": 0, "nodeId": "1"}}}},
    {"note": "the room is lifted", "event": "record_list.room", "data": {"values": 0, "history": 0, "digest": 0}, "expect": {"state": "open", "sent": [], "variables": {"full": 1}}}
  ]
}
