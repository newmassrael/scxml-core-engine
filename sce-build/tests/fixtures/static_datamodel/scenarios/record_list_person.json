{
  "machine": "sce:std/shared/record_list",
  "about": "A person's copy of the standard shared record list (sce:std/shared/record_list.scxml), node 1: its own changes stamped and sent to the hub by the route `#hub`, writes made at once kept side by side, a supersede taking out only the value its writer saw, a text past the bound, a role and a room refusing a change whole, the walk of the digest finding where two copies differ down to a minute and sharing what it holds of it, and a settle: the clock moved past the instant, the answer, the tombstones forgotten at the hub's word, a write at or before the floor refused, and a floor it did not hold the same of making it stale. Expected values are computed by a model of the list held first to every step todo_peer took in the world's afternoon, not observed from a backend.",
  "steps": [
    {"note": "started: a copy that holds nothing", "expect": {"state": "open", "sent": [], "variables": {"node": "0", "hub": false, "values": [], "refusals": 0}}},
    {"note": "the host names the copy: node 1, a person's copy", "event": "record_list.join", "data": {"node": "1", "hub": false}, "expect": {"state": "open", "sent": [], "variables": {"node": "1", "hub": false}}},
    {"note": "a person's change is stamped after everything seen and sent to the hub, and taken in here", "event": "record_list.edit", "data": {"id": 7, "field": 1, "value": "0", "text": "buy milk", "now": "1727000040000"}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.write", "data": {"id": 7, "field": 1, "value": "0", "text": "buy milk", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}}], "variables": {"clock": {"wallTime": "1727000040000", "counter": 0, "nodeId": "1"}, "values": [{"id": "7", "field": "1", "value": "0", "text": "buy milk", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "458753", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}]}}},
    {"note": "another person's write to the same field, made without seeing this one, is kept beside it", "event": "record_list.write", "data": {"id": 7, "field": 1, "value": "0", "text": "buy oat milk", "wallTime": "1727000040000", "counter": 0, "nodeId": "2"}, "expect": {"state": "open", "sent": [], "variables": {"clock": {"wallTime": "1727000040000", "counter": 1, "nodeId": "1"}, "values": [{"id": "7", "field": "1", "value": "0", "text": "buy milk", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}, {"id": "7", "field": "1", "value": "0", "text": "buy oat milk", "wallTime": "1727000040000", "counter": 0, "nodeId": "2"}]}}},
    {"note": "a change over the field writes over the two values seen, each named to the hub, then the write", "event": "record_list.edit", "data": {"id": 7, "field": 1, "value": "0", "text": "call home", "now": "1727000041000"}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.supersede", "data": {"id": 7, "field": 1, "wallTime": "1727000040000", "counter": 0, "nodeId": "1", "by": "1", "parts": 3, "atWallTime": "1727000041000", "atCounter": 0}}, {"target": "#hub", "event": "record_list.supersede", "data": {"id": 7, "field": 1, "wallTime": "1727000040000", "counter": 0, "nodeId": "2", "by": "1", "parts": 3, "atWallTime": "1727000041000", "atCounter": 0}}, {"target": "#hub", "event": "record_list.write", "data": {"id": 7, "field": 1, "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1", "parts": 3}}], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}], "tombstones": [{"element": "458753", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}, {"element": "458753", "wallTime": "1727000040000", "counter": 0, "nodeId": "2"}], "adds": [{"element": "458753", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}]}}},
    {"note": "two people write one field at once again", "event": "record_list.write", "data": {"id": 8, "field": 1, "value": "1", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "2"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "1", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "2"}]}}},
    {"note": "the other writer's value of the same instant, from node 3, is held beside it", "event": "record_list.write", "data": {"id": 8, "field": 1, "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "1", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "2"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}]}}},
    {"note": "a supersede names only the value its writer saw: the one written at the same time stays", "event": "record_list.supersede", "data": {"id": 8, "field": 1, "wallTime": "1727000160000", "counter": 0, "nodeId": "2", "by": "3"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}], "tombstones": [{"element": "458753", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}, {"element": "458753", "wallTime": "1727000040000", "counter": 0, "nodeId": "2"}, {"element": "524289", "wallTime": "1727000160000", "counter": 0, "nodeId": "2"}]}}},
    {"note": "a supersede that arrives twice changes nothing", "event": "record_list.supersede", "data": {"id": 8, "field": 1, "wallTime": "1727000160000", "counter": 0, "nodeId": "2", "by": "3"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}], "tombstones": [{"element": "458753", "wallTime": "1727000040000", "counter": 0, "nodeId": "1"}, {"element": "458753", "wallTime": "1727000040000", "counter": 0, "nodeId": "2"}, {"element": "524289", "wallTime": "1727000160000", "counter": 0, "nodeId": "2"}]}}},
    {"note": "a text one byte past what a person writes is refused whole: nothing is stamped or sent", "event": "record_list.edit", "data": {"id": 9, "field": 1, "value": "0", "text": "a title that is one byte too long", "now": "1727000220000"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000160000", "counter": 2, "nodeId": "1"}, "refusals": 1}}},
    {"note": "the host lets this copy's member only read", "event": "record_list.role", "data": {"node": "1", "role": 1}, "expect": {"state": "open", "sent": [], "variables": {"denied": 0}}},
    {"note": "a change of its own is refused for it, before anything is stamped or sent", "event": "record_list.edit", "data": {"id": 9, "field": 1, "value": "0", "text": "tea", "now": "1727000220000"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000160000", "counter": 2, "nodeId": "1"}, "denied": 1}}},
    {"note": "the host lets it write again", "event": "record_list.role", "data": {"node": "1", "role": 2}, "expect": {"state": "open", "sent": [], "variables": {"denied": 1}}},
    {"note": "the host gives the list room for the values it holds and no more", "event": "record_list.room", "data": {"values": 2, "history": 0, "digest": 0}, "expect": {"state": "open", "sent": [], "variables": {"full": 0}}},
    {"note": "a change to a register with no value would pass the room: refused whole and counted", "event": "record_list.edit", "data": {"id": 9, "field": 1, "value": "0", "text": "tea", "now": "1727000220000"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "2", "text": "", "wallTime": "1727000160000", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000160000", "counter": 2, "nodeId": "1"}, "full": 1}}},
    {"note": "a change to a register that holds a value adds none and is taken", "event": "record_list.edit", "data": {"id": 8, "field": 1, "value": "5", "text": "", "now": "1727000220000"}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.supersede", "data": {"id": 8, "field": 1, "wallTime": "1727000160000", "counter": 0, "nodeId": "3", "by": "1", "parts": 2, "atWallTime": "1727000220000", "atCounter": 0}}, {"target": "#hub", "event": "record_list.write", "data": {"id": 8, "field": 1, "value": "5", "text": "", "wallTime": "1727000220000", "counter": 0, "nodeId": "1", "parts": 2}}], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "5", "text": "", "wallTime": "1727000220000", "counter": 0, "nodeId": "1"}], "full": 1}}},
    {"note": "the room is lifted", "event": "record_list.room", "data": {"values": 0, "history": 0, "digest": 0}, "expect": {"state": "open", "sent": [], "variables": {"full": 1}}},
    {"note": "the link is back: the copy shows the hub the root of its digest", "event": "record_list.resync", "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.node", "data": {"sender": "1", "to": 0, "depth": 0, "prefix": "0", "hash": 2988895409, "reply": false}}], "variables": {"digest": [{"depth": 0, "prefix": "0", "hash": 2988895409}, {"depth": 1, "prefix": "0", "hash": 2988895409}, {"depth": 2, "prefix": "0", "hash": 2988895409}, {"depth": 3, "prefix": "0", "hash": 2988895409}, {"depth": 4, "prefix": "0", "hash": 2988895409}, {"depth": 5, "prefix": "0", "hash": 2988895409}, {"depth": 6, "prefix": "0", "hash": 2988895409}, {"depth": 7, "prefix": "0", "hash": 2988895409}, {"depth": 8, "prefix": "0", "hash": 2988895409}, {"depth": 9, "prefix": "0", "hash": 2988895409}, {"depth": 10, "prefix": "0", "hash": 2988895409}, {"depth": 11, "prefix": "0", "hash": 2988895409}, {"depth": 12, "prefix": "0", "hash": 2988895409}, {"depth": 13, "prefix": "0", "hash": 2988895409}, {"depth": 14, "prefix": "0", "hash": 2988895409}, {"depth": 15, "prefix": "2", "hash": 2988895409}, {"depth": 16, "prefix": "6", "hash": 2988895409}, {"depth": 17, "prefix": "18", "hash": 2988895409}, {"depth": 18, "prefix": "54", "hash": 2988895409}, {"depth": 19, "prefix": "162", "hash": 2988895409}, {"depth": 20, "prefix": "487", "hash": 2988895409}, {"depth": 21, "prefix": "1462", "hash": 2988895409}, {"depth": 22, "prefix": "4387", "hash": 2988895409}, {"depth": 23, "prefix": "13161", "hash": 2988895409}, {"depth": 24, "prefix": "39483", "hash": 2988895409}, {"depth": 25, "prefix": "118449", "hash": 2988895409}, {"depth": 26, "prefix": "355349", "hash": 2988895409}, {"depth": 27, "prefix": "1066049", "hash": 2988895409}, {"depth": 28, "prefix": "3198148", "hash": 2988895409}, {"depth": 29, "prefix": "9594444", "hash": 2827911023}, {"depth": 29, "prefix": "9594445", "hash": 447255518}, {"depth": 30, "prefix": "28783334", "hash": 2827911023}, {"depth": 30, "prefix": "28783336", "hash": 3119174590}, {"depth": 30, "prefix": "28783337", "hash": 2739028064}]}}},
    {"note": "the hub's root differs: the copy shows the three children of the root", "event": "record_list.node", "data": {"sender": "9", "to": "0", "depth": 0, "prefix": "0", "hash": 2988895408, "reply": false}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.node", "data": {"sender": "1", "to": 0, "depth": 1, "prefix": "0", "hash": 2988895409, "reply": false}}, {"target": "#hub", "event": "record_list.node", "data": {"sender": "1", "to": 0, "depth": 1, "prefix": "1", "hash": 0, "reply": false}}, {"target": "#hub", "event": "record_list.node", "data": {"sender": "1", "to": 0, "depth": 1, "prefix": "2", "hash": 0, "reply": false}}], "variables": {"refusals": 1}}},
    {"note": "a node meant for another person is let go", "event": "record_list.node", "data": {"sender": "9", "to": "2", "depth": 0, "prefix": "0", "hash": 2988895408, "reply": false}, "expect": {"state": "open", "sent": [], "variables": {"refusals": 1}}},
    {"note": "at a minute the copies differ in, the copy shares every change it holds of that minute and shows its node there once", "event": "record_list.node", "data": {"sender": "9", "to": "1", "depth": 30, "prefix": "28783334", "hash": 0, "reply": false}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.write", "data": {"id": 7, "field": 1, "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}}, {"target": "#hub", "event": "record_list.supersede", "data": {"id": 7, "field": 1, "wallTime": "1727000040000", "counter": 0, "nodeId": "1", "by": "1"}}, {"target": "#hub", "event": "record_list.supersede", "data": {"id": 7, "field": 1, "wallTime": "1727000040000", "counter": 0, "nodeId": "2", "by": "1"}}, {"target": "#hub", "event": "record_list.node", "data": {"sender": "1", "to": 0, "depth": 30, "prefix": "28783334", "hash": 2827911023, "reply": true}}], "variables": {"refusals": 1}}},
    {"note": "a node that answers one of its own is not answered again; the changes are shared", "event": "record_list.node", "data": {"sender": "9", "to": "1", "depth": 30, "prefix": "28783334", "hash": 0, "reply": true}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.write", "data": {"id": 7, "field": 1, "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}}, {"target": "#hub", "event": "record_list.supersede", "data": {"id": 7, "field": 1, "wallTime": "1727000040000", "counter": 0, "nodeId": "1", "by": "1"}}, {"target": "#hub", "event": "record_list.supersede", "data": {"id": 7, "field": 1, "wallTime": "1727000040000", "counter": 0, "nodeId": "2", "by": "1"}}], "variables": {"refusals": 1}}},
    {"note": "a node that is the same on both sides ends the walk", "event": "record_list.node", "data": {"sender": "9", "to": "1", "depth": 30, "prefix": "28783334", "hash": 2827911023, "reply": false}, "expect": {"state": "open", "sent": [], "variables": {"refusals": 1}}},
    {"note": "the change the walk found arrives from the hub as the write it was", "event": "record_list.write", "data": {"id": 10, "field": 1, "value": "0", "text": "lost", "wallTime": "1727000280000", "counter": 0, "nodeId": "3"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "5", "text": "", "wallTime": "1727000220000", "counter": 0, "nodeId": "1"}, {"id": "10", "field": "1", "value": "0", "text": "lost", "wallTime": "1727000280000", "counter": 0, "nodeId": "3"}]}}},
    {"note": "the hub asks what the copy holds up to an instant: its clock moves past it and it answers", "event": "record_list.propose", "data": {"before": "1727000190000"}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.ack", "data": {"sender": "1", "before": "1727000190000", "hash": 291810513}}], "variables": {"clock": {"wallTime": "1727000280000", "counter": 1, "nodeId": "1"}}}},
    {"note": "the hub's word that the instant is settled, with the hash the copy gave: it forgets the tombstones up to it", "event": "record_list.floor", "data": {"before": "1727000190000", "hash": 291810513}, "expect": {"state": "open", "sent": [], "variables": {"floor": "1727000190000", "tombstones": [], "stale": false, "clock": {"wallTime": "1727000280000", "counter": 1, "nodeId": "1"}}}},
    {"note": "a write stamped at or before the floor that the copy does not hold is not taken in, and counted", "event": "record_list.write", "data": {"id": 11, "field": 1, "value": "0", "text": "old", "wallTime": "1727000040100", "counter": 0, "nodeId": "3"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "5", "text": "", "wallTime": "1727000220000", "counter": 0, "nodeId": "1"}, {"id": "10", "field": "1", "value": "0", "text": "lost", "wallTime": "1727000280000", "counter": 0, "nodeId": "3"}], "late": 1}}},
    {"note": "one it holds is not counted", "event": "record_list.write", "data": {"id": 7, "field": 1, "value": "0", "text": "call home", "wallTime": "1727000041000", "counter": 0, "nodeId": "1"}, "expect": {"state": "open", "sent": [], "variables": {"late": 1}}},
    {"note": "a later instant the copy did not hold the same of: it forgets nothing and says it is stale", "event": "record_list.floor", "data": {"before": "1727000340000", "hash": 291810512}, "expect": {"state": "open", "sent": [], "variables": {"floor": "1727000190000", "tombstones": [], "stale": true}}}
  ]
}
