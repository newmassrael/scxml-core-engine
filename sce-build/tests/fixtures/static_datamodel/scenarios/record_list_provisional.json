{
  "machine": "sce:std/shared/record_list",
  "about": "Changes a copy of the standard shared record list took in provisionally (docs/adr/0093, sections 3.3 and 3.4): a change its layer answered `waiting` is taken in with an undo record of what its write-overs took out, until the host confirms it (`record_list.confirm`) or withdraws it (`record_list.withdraw`). A withdrawal takes out what the change wrote and gives back what it wrote over, so the copy holds what a copy that never took the change holds, the values in another order; a peer's write-over of a value the withdrawn change also took out strikes it from the undo record, and the value stays out. Two provisional changes, the first withdrawn, are both withdrawn, latest first. A confirmation or a withdrawal that names no provisional change is the host's fault and counted. A copy that holds `shared_provisional` (8) provisional changes refuses the next one it closes, `noRoomForHistory`, until one is confirmed. Expected values come from a model of the list, not from a backend.",
  "steps": [
    {"note": "started: a copy that holds nothing", "expect": {"state": "open", "sent": [], "variables": {"node": "0", "values": []}}},
    {"note": "the host names the copy, node 1, which keeps a journal", "event": "record_list.join", "data": {"node": "1", "journal": true}, "expect": {"state": "open", "sent": [], "variables": {"node": "1"}}},
    {"note": "a peer's change writes two fields of row 3", "event": "record_list.change", "data": {"by": "2", "wallTime": "1727000700000", "counter": 0, "ops": [{"kind": 0, "id": 3, "field": 1, "value": "0", "text": "a", "wallTime": "0", "counter": 0, "nodeId": "0"}, {"kind": 0, "id": 3, "field": 2, "value": "0", "text": "b", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "3", "field": "1", "value": "0", "text": "a", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "3", "field": "2", "value": "0", "text": "b", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}], "adds": [{"element": "196609", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "196610", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000700000", "counter": 1, "nodeId": "1"}, "refusals": 0}}},
    {"note": "a change of the copy's own is offered", "event": "record_list.edit", "data": {"id": 4, "field": 1, "value": "0", "text": "x", "now": "1727000700100", "command": "1"}, "expect": {"state": "open", "sent": [{"target": "#journal", "event": "record_list.made", "data": {"by": "1", "wallTime": "1727000700100", "counter": 0, "ops": [{"kind": 0, "id": 4, "field": 1, "value": "0", "text": "x", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "1"}}], "variables": {"values": [{"id": "3", "field": "1", "value": "0", "text": "a", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "3", "field": "2", "value": "0", "text": "b", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}], "adds": [{"element": "196609", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "196610", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, "refusals": 0}}},
    {"note": "waiting: it is taken in provisionally", "event": "record_list.verdict", "data": {"wallTime": "1727000700100", "counter": 0, "outcome": "waiting", "reason": null}, "expect": {"state": "open", "sent": [{"target": "#journal", "event": "record_list.closed", "data": {"command": "1", "operations": 1, "reason": null, "wallTime": "1727000700100", "counter": 0}}], "variables": {"values": [{"id": "3", "field": "1", "value": "0", "text": "a", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "3", "field": "2", "value": "0", "text": "b", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "4", "field": "1", "value": "0", "text": "x", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}], "adds": [{"element": "196609", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "196610", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "262145", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, "refusals": 0}}},
    {"note": "the host confirms it: nothing it holds moves", "event": "record_list.confirm", "data": {"wallTime": "1727000700100", "counter": 0, "command": "1"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "3", "field": "1", "value": "0", "text": "a", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "3", "field": "2", "value": "0", "text": "b", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "4", "field": "1", "value": "0", "text": "x", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}], "adds": [{"element": "196609", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "196610", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "262145", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, "refusals": 0}}},
    {"note": "a change that clears 3/1 and writes 3/2 over begins", "event": "record_list.clear", "data": {"id": 3, "field": 1, "now": "1727000700200", "more": true, "command": "2"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "3", "field": "1", "value": "0", "text": "a", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "3", "field": "2", "value": "0", "text": "b", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "4", "field": "1", "value": "0", "text": "x", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}], "adds": [{"element": "196609", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "196610", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "262145", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, "refusals": 0}}},
    {"note": "and ends: offered whole", "event": "record_list.edit", "data": {"id": 3, "field": 2, "value": "0", "text": "c", "now": "1727000700200", "command": "3"}, "expect": {"state": "open", "sent": [{"target": "#journal", "event": "record_list.made", "data": {"by": "1", "wallTime": "1727000700200", "counter": 0, "ops": [{"kind": 1, "id": 3, "field": 1, "value": "0", "text": "", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"kind": 1, "id": 3, "field": 2, "value": "0", "text": "", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"kind": 0, "id": 3, "field": 2, "value": "0", "text": "c", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "3"}}], "variables": {"values": [{"id": "3", "field": "1", "value": "0", "text": "a", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "3", "field": "2", "value": "0", "text": "b", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"id": "4", "field": "1", "value": "0", "text": "x", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}], "adds": [{"element": "196609", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "196610", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"element": "262145", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000700200", "counter": 0, "nodeId": "1"}, "refusals": 0}}},
    {"note": "waiting: taken in provisionally, both values it saw out and its own write in, what it took out kept in its undo record", "event": "record_list.verdict", "data": {"wallTime": "1727000700200", "counter": 0, "outcome": "waiting", "reason": null}, "expect": {"state": "open", "sent": [{"target": "#journal", "event": "record_list.closed", "data": {"command": "3", "operations": 3, "reason": null, "wallTime": "1727000700200", "counter": 0}}], "variables": {"values": [{"id": "4", "field": "1", "value": "0", "text": "x", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, {"id": "3", "field": "2", "value": "0", "text": "c", "wallTime": "1727000700200", "counter": 0, "nodeId": "1"}], "adds": [{"element": "262145", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, {"element": "196610", "wallTime": "1727000700200", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000700200", "counter": 0, "nodeId": "1"}, "refusals": 0}}},
    {"note": "a peer, not having seen it, writes 3/1 over and anew: the value the provisional change took out is gone already, and is struck from its undo record", "event": "record_list.change", "data": {"by": "2", "wallTime": "1727000700250", "counter": 0, "ops": [{"kind": 1, "id": 3, "field": 1, "value": "0", "text": "", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}, {"kind": 0, "id": 3, "field": 1, "value": "0", "text": "d", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "4", "field": "1", "value": "0", "text": "x", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, {"id": "3", "field": "2", "value": "0", "text": "c", "wallTime": "1727000700200", "counter": 0, "nodeId": "1"}, {"id": "3", "field": "1", "value": "0", "text": "d", "wallTime": "1727000700250", "counter": 0, "nodeId": "2"}], "adds": [{"element": "262145", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, {"element": "196610", "wallTime": "1727000700200", "counter": 0, "nodeId": "1"}, {"element": "196609", "wallTime": "1727000700250", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000700250", "counter": 1, "nodeId": "1"}, "refusals": 0}}},
    {"note": "the host withdraws the provisional change: its write goes, the value of 3/2 it wrote over comes back, and 3/1's stays out, as on a copy that never took the change", "event": "record_list.withdraw", "data": {"wallTime": "1727000700200", "counter": 0, "command": "3"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "4", "field": "1", "value": "0", "text": "x", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, {"id": "3", "field": "1", "value": "0", "text": "d", "wallTime": "1727000700250", "counter": 0, "nodeId": "2"}, {"id": "3", "field": "2", "value": "0", "text": "b", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}], "adds": [{"element": "262145", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, {"element": "196609", "wallTime": "1727000700250", "counter": 0, "nodeId": "2"}, {"element": "196610", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000700250", "counter": 1, "nodeId": "1"}, "refusals": 0}}},
    {"note": "a change writes row 5", "event": "record_list.edit", "data": {"id": 5, "field": 1, "value": "0", "text": "p1", "now": "1727000700300", "command": "4"}, "expect": {"state": "open", "sent": [{"target": "#journal", "event": "record_list.made", "data": {"by": "1", "wallTime": "1727000700300", "counter": 0, "ops": [{"kind": 0, "id": 5, "field": 1, "value": "0", "text": "p1", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "4"}}], "variables": {"values": [{"id": "4", "field": "1", "value": "0", "text": "x", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, {"id": "3", "field": "1", "value": "0", "text": "d", "wallTime": "1727000700250", "counter": 0, "nodeId": "2"}, {"id": "3", "field": "2", "value": "0", "text": "b", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}], "adds": [{"element": "262145", "wallTime": "1727000700100", "counter": 0, "nodeId": "1"}, {"element": "196609", "wallTime": "1727000700250", "counter": 0, "nodeId": "2"}, {"element": "196610", "wallTime": "1727000700000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000700300", "counter": 0, "nodeId": "1"}, "refusals": 0}}},
