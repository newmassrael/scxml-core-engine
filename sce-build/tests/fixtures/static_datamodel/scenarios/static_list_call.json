{
  "machine": "static_list_call",
  "about": "A ledger that hands the lists it keeps to imported algorithms to be read. Before a line is put in, Has is asked of the list of records whether the line's id is already there; after it, Above is asked of the list of ids whether any is above 100. Neither call writes the list, and the line is appended whatever they answer. Expected values are derived from the document, not observed from a backend.",
  "steps": [
    { "note": "both lists start empty",
      "expect": { "state": "open", "variables": { "entries": [], "ids": [], "repeats": 0, "high": 0 } } },

    { "note": "id 5 is new, and 5 is not above 100",
      "event": "ledger.entry", "data": { "id": 5, "amount": 10 },
      "expect": { "variables": { "entries": [ { "id": 5, "amount": 10 } ], "ids": [5], "repeats": 0, "high": 0 } } },

    { "note": "id 7 is new",
      "event": "ledger.entry", "data": { "id": 7, "amount": 20 },
      "expect": { "variables": { "entries": [ { "id": 5, "amount": 10 }, { "id": 7, "amount": 20 } ], "ids": [5, 7], "repeats": 0, "high": 0 } } },

    { "note": "id 5 is in the list already: a repeat, and the line is appended all the same",
      "event": "ledger.entry", "data": { "id": 5, "amount": 30 },
      "expect": { "variables": { "entries": [ { "id": 5, "amount": 10 }, { "id": 7, "amount": 20 }, { "id": 5, "amount": 30 } ], "ids": [5, 7, 5], "repeats": 1, "high": 0 } } },

    { "note": "id 200 is new, and once it is in the list an id is above 100",
      "event": "ledger.entry", "data": { "id": 200, "amount": 1 },
      "expect": { "variables": { "entries": [ { "id": 5, "amount": 10 }, { "id": 7, "amount": 20 }, { "id": 5, "amount": 30 }, { "id": 200, "amount": 1 } ], "ids": [5, 7, 5, 200], "repeats": 1, "high": 1 } } },

    { "note": "id 7 is a repeat, and the 200 is still in the list",
      "event": "ledger.entry", "data": { "id": 7, "amount": 2 },
      "expect": { "variables": { "entries": [ { "id": 5, "amount": 10 }, { "id": 7, "amount": 20 }, { "id": 5, "amount": 30 }, { "id": 200, "amount": 1 }, { "id": 7, "amount": 2 } ], "ids": [5, 7, 5, 200, 7], "repeats": 2, "high": 2 } } }
  ]
}
