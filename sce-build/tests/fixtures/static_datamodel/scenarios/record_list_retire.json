{
  "machine": "sce:std/shared/record_list",
  "about": "A field of the standard shared record list (sce:std/shared/record_list.scxml) emptied, and a row retired (docs/adr/0046, section 2): `record_list.clear` writes over every value the copy holds in one register and `record_list.retire` every value it holds in any register of a row, each writing none, a change of as many parts. What the copy has not seen is not named: a write made at the same time without seeing the retire stays, and the row holds that field alone; a value the retire wrote over is not taken in again. A change that retires a row and edits it writes the row anew. What the retire wrote over leaves `values` and `adds` at once, and its tombstones at the settle. Expected values come from a model of the list, not from a backend.",
  "steps": [
    {"note": "started: a copy that holds nothing", "expect": {"state": "open", "sent": [], "variables": {"node": "0", "values": []}}},
    {"note": "the host names the copy: node 1, a person's copy", "event": "record_list.join", "data": {"node": "1", "hub": false}, "expect": {"state": "open", "sent": [], "variables": {"node": "1", "hub": false}}},
    {"note": "a row of three fields begins", "event": "record_list.edit", "data": {"id": 20, "field": 1, "value": "0", "text": "water the plants", "more": true, "now": "1727000200000"}, "expect": {"state": "open", "sent": [], "variables": {"values": []}}},
    {"note": "its second field", "event": "record_list.edit", "data": {"id": 20, "field": 2, "value": "5", "text": "", "more": true, "now": "1727000200000"}, "expect": {"state": "open", "sent": [], "variables": {"values": []}}},
    {"note": "and its third ends the change: the row is written whole", "event": "record_list.edit", "data": {"id": 20, "field": 3, "value": "0", "text": "on the balcony", "now": "1727000200000"}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.write", "data": {"id": 20, "field": 1, "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1", "parts": 3}}, {"target": "#hub", "event": "record_list.write", "data": {"id": 20, "field": 2, "value": "5", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "1", "parts": 3}}, {"target": "#hub", "event": "record_list.write", "data": {"id": 20, "field": 3, "value": "0", "text": "on the balcony", "wallTime": "1727000200000", "counter": 0, "nodeId": "1", "parts": 3}}], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "2", "value": "5", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "3", "value": "0", "text": "on the balcony", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000200000", "counter": 0, "nodeId": "1"}}}},
    {"note": "another person's write to the second field, made without seeing the row's, is kept beside it", "event": "record_list.write", "data": {"id": 20, "field": 2, "value": "7", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "2"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "2", "value": "5", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "3", "value": "0", "text": "on the balcony", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "2", "value": "7", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000200000", "counter": 1, "nodeId": "1"}}}},
    {"note": "the second field is cleared: both values it holds are written over, and none is written, one change of two parts", "event": "record_list.clear", "data": {"id": 20, "field": 2, "now": "1727000201000", "more": false}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.supersede", "data": {"id": 20, "field": 2, "wallTime": "1727000200000", "counter": 0, "nodeId": "1", "by": "1", "parts": 2, "atWallTime": "1727000201000", "atCounter": 0}}, {"target": "#hub", "event": "record_list.supersede", "data": {"id": 20, "field": 2, "wallTime": "1727000200000", "counter": 0, "nodeId": "2", "by": "1", "parts": 2, "atWallTime": "1727000201000", "atCounter": 0}}], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "3", "value": "0", "text": "on the balcony", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "1310721", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310723", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "tombstones": [{"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000201000", "counter": 0, "nodeId": "1"}}}},
    {"note": "a field that holds nothing is cleared by nothing: nothing is stamped or sent", "event": "record_list.clear", "data": {"id": 20, "field": 2, "now": "1727000202000", "more": false}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "3", "value": "0", "text": "on the balcony", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "tombstones": [{"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000201000", "counter": 0, "nodeId": "1"}}}},
    {"note": "the row is retired: every value it holds is written over, and the row holds nothing", "event": "record_list.retire", "data": {"id": 20, "now": "1727000203000", "more": false}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.supersede", "data": {"id": 20, "field": 1, "wallTime": "1727000200000", "counter": 0, "nodeId": "1", "by": "1", "parts": 2, "atWallTime": "1727000203000", "atCounter": 0}}, {"target": "#hub", "event": "record_list.supersede", "data": {"id": 20, "field": 3, "wallTime": "1727000200000", "counter": 0, "nodeId": "1", "by": "1", "parts": 2, "atWallTime": "1727000203000", "atCounter": 0}}], "variables": {"values": [], "adds": [], "tombstones": [{"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "2"}, {"element": "1310721", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310723", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000203000", "counter": 0, "nodeId": "1"}}}},
    {"note": "a write to the row's third field that another person made without seeing the retire arrives: it stays, and the row holds that field alone", "event": "record_list.write", "data": {"id": 20, "field": 3, "value": "0", "text": "in the shade", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "20", "field": "3", "value": "0", "text": "in the shade", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}], "adds": [{"element": "1310723", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}]}}},
    {"note": "a value the retire wrote over arrives again: its tombstone names it, and it is not taken in", "event": "record_list.write", "data": {"id": 20, "field": 1, "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "20", "field": "3", "value": "0", "text": "in the shade", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}]}}},
    {"note": "a change that retires the row and writes it anew begins", "event": "record_list.retire", "data": {"id": 20, "now": "1727000204000", "more": true}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "20", "field": "3", "value": "0", "text": "in the shade", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}]}}},
    {"note": "and ends with the new field: the value it saw written over, then the write, one change", "event": "record_list.edit", "data": {"id": 20, "field": 1, "value": "0", "text": "water the herbs", "now": "1727000204000"}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.supersede", "data": {"id": 20, "field": 3, "wallTime": "1727000202500", "counter": 0, "nodeId": "3", "by": "1", "parts": 2, "atWallTime": "1727000204000", "atCounter": 0}}, {"target": "#hub", "event": "record_list.write", "data": {"id": 20, "field": 1, "value": "0", "text": "water the herbs", "wallTime": "1727000204000", "counter": 0, "nodeId": "1", "parts": 2}}], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the herbs", "wallTime": "1727000204000", "counter": 0, "nodeId": "1"}], "tombstones": [{"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "2"}, {"element": "1310721", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310723", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310723", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000204000", "counter": 0, "nodeId": "1"}}}},
    {"note": "the hub asks what the copy holds up to an instant past every change: its clock moves past it and it answers", "event": "record_list.propose", "data": {"before": "1727000260000"}, "expect": {"state": "open", "sent": [{"target": "#hub", "event": "record_list.ack", "data": {"sender": "1", "before": "1727000260000", "hash": 4196450491}}], "variables": {"clock": {"wallTime": "1727000260001", "counter": 0, "nodeId": "1"}, "tombstones": [{"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310722", "wallTime": "1727000200000", "counter": 0, "nodeId": "2"}, {"element": "1310721", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310723", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310723", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}]}}},
    {"note": "the instant is settled with the hash the copy gave: every tombstone goes, and the row takes no more room than the field it holds", "event": "record_list.floor", "data": {"before": "1727000260000", "hash": 4196450491}, "expect": {"state": "open", "sent": [], "variables": {"floor": "1727000260000", "tombstones": [], "adds": [{"element": "1310721", "wallTime": "1727000204000", "counter": 0, "nodeId": "1"}], "values": [{"id": "20", "field": "1", "value": "0", "text": "water the herbs", "wallTime": "1727000204000", "counter": 0, "nodeId": "1"}]}}}
  ]
}
