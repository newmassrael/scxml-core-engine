{
  "machine": "sce:std/shared/record_list",
  "about": "A field of the standard shared record list (sce:std/shared/record_list.scxml) emptied, and a row retired (docs/adr/0046, section 2): `record_list.clear` writes over every value the copy holds in one register and `record_list.retire` every value it holds in any register of a row, each writing none, a change of as many write-overs, sent as one `record_list.change`. What the copy has not seen is not named: a write made at the same time without seeing the retire stays, and the row holds that field alone. A change that retires a row and edits it writes the row anew. What a write-over names leaves `values` and `adds` at once, and nothing is kept of it (docs/adr/0085, section 2.2). Expected values come from a model of the list, not from a backend.",
  "steps": [
    {"note": "started: a copy that holds nothing", "expect": {"state": "open", "sent": [], "variables": {"node": "0", "values": []}}},
    {"note": "the host names the copy, node 1", "event": "record_list.join", "data": {"node": "1"}, "expect": {"state": "open", "sent": [], "variables": {"node": "1"}}},
    {"note": "a row of three fields begins", "event": "record_list.edit", "data": {"id": 20, "field": 1, "value": "0", "text": "water the plants", "now": "1727000200000", "more": true}, "expect": {"state": "open", "sent": [], "variables": {"values": []}}},
    {"note": "its second field", "event": "record_list.edit", "data": {"id": 20, "field": 2, "value": "5", "text": "", "now": "1727000200000", "more": true}, "expect": {"state": "open", "sent": [], "variables": {"values": []}}},
    {"note": "and its third ends the change: the row is written whole", "event": "record_list.edit", "data": {"id": 20, "field": 3, "value": "0", "text": "on the balcony", "now": "1727000200000"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.change", "data": {"by": "1", "wallTime": "1727000200000", "counter": 0, "ops": [{"kind": 0, "id": 20, "field": 1, "value": "0", "text": "water the plants", "wallTime": "0", "counter": 0, "nodeId": "0"}, {"kind": 0, "id": 20, "field": 2, "value": "5", "text": "", "wallTime": "0", "counter": 0, "nodeId": "0"}, {"kind": 0, "id": 20, "field": 3, "value": "0", "text": "on the balcony", "wallTime": "0", "counter": 0, "nodeId": "0"}]}}], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "2", "value": "5", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "3", "value": "0", "text": "on the balcony", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000200000", "counter": 0, "nodeId": "1"}}}},
    {"note": "another person's write to the second field, made without seeing the row's, is kept beside it", "event": "record_list.change", "data": {"by": "2", "wallTime": "1727000200000", "counter": 0, "ops": [{"kind": 0, "id": 20, "field": 2, "value": "7", "text": "", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "2", "value": "5", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "3", "value": "0", "text": "on the balcony", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "2", "value": "7", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000200000", "counter": 1, "nodeId": "1"}}}},
    {"note": "the second field is cleared: both values it holds are written over, and none is written, one change of two write-overs", "event": "record_list.clear", "data": {"id": 20, "field": 2, "now": "1727000201000", "more": false}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.change", "data": {"by": "1", "wallTime": "1727000201000", "counter": 0, "ops": [{"kind": 1, "id": 20, "field": 2, "value": "0", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"kind": 1, "id": 20, "field": 2, "value": "0", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "2"}]}}], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "3", "value": "0", "text": "on the balcony", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "1310721", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310723", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000201000", "counter": 0, "nodeId": "1"}}}},
    {"note": "a field that holds nothing is cleared by nothing: nothing is stamped or sent", "event": "record_list.clear", "data": {"id": 20, "field": 2, "now": "1727000202000", "more": false}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the plants", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"id": "20", "field": "3", "value": "0", "text": "on the balcony", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "1310721", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"element": "1310723", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000201000", "counter": 0, "nodeId": "1"}}}},
    {"note": "the row is retired: every value it holds is written over, and the row holds nothing, with nothing kept of what it held", "event": "record_list.retire", "data": {"id": 20, "now": "1727000203000", "more": false}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.change", "data": {"by": "1", "wallTime": "1727000203000", "counter": 0, "ops": [{"kind": 1, "id": 20, "field": 1, "value": "0", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}, {"kind": 1, "id": 20, "field": 3, "value": "0", "text": "", "wallTime": "1727000200000", "counter": 0, "nodeId": "1"}]}}], "variables": {"values": [], "adds": [], "clock": {"wallTime": "1727000203000", "counter": 0, "nodeId": "1"}}}},
    {"note": "a change to the row's third field that another person made without seeing the retire arrives: it stays, and the row holds that field alone", "event": "record_list.change", "data": {"by": "3", "wallTime": "1727000202500", "counter": 0, "ops": [{"kind": 0, "id": 20, "field": 3, "value": "0", "text": "in the shade", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "20", "field": "3", "value": "0", "text": "in the shade", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}], "adds": [{"element": "1310723", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000203000", "counter": 1, "nodeId": "1"}}}},
    {"note": "a change that retires the row and writes it anew begins", "event": "record_list.retire", "data": {"id": 20, "now": "1727000204000", "more": true}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "20", "field": "3", "value": "0", "text": "in the shade", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}]}}},
    {"note": "and ends with the new field: the value it saw written over, then the write, one change", "event": "record_list.edit", "data": {"id": 20, "field": 1, "value": "0", "text": "water the herbs", "now": "1727000204000"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.change", "data": {"by": "1", "wallTime": "1727000204000", "counter": 0, "ops": [{"kind": 1, "id": 20, "field": 3, "value": "0", "text": "", "wallTime": "1727000202500", "counter": 0, "nodeId": "3"}, {"kind": 0, "id": 20, "field": 1, "value": "0", "text": "water the herbs", "wallTime": "0", "counter": 0, "nodeId": "0"}]}}], "variables": {"values": [{"id": "20", "field": "1", "value": "0", "text": "water the herbs", "wallTime": "1727000204000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "1310721", "wallTime": "1727000204000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000204000", "counter": 0, "nodeId": "1"}}}}
  ]
}
