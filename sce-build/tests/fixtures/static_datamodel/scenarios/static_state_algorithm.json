{
  "machine": "static_state_algorithm",
  "about": "A statechart that keeps a ledger hands the algorithms its state and holds what they give back: a list of records in and out (AddEntry), a list in and a record out (TotalOf), a record in and out (Bump), a record from an event in a guard (AmountOf), a list of numbers in (IdSum). Expected values are derived from the document, not observed from a backend.",
  "steps": [
    { "note": "nothing yet",
      "expect": { "state": "open", "variables": {
        "entries": [], "total": { "count": 0, "sum": 0 }, "last": { "id": 0, "amount": 0 },
        "ids": [], "idsum": 0, "large": 0, "refusals": 0 } } },

    { "note": "the first line: put in, totalled, remembered, and not large",
      "event": "ledger.entry", "data": { "id": 1, "amount": 50 },
      "expect": { "variables": {
        "entries": [ { "id": 1, "amount": 50 } ],
        "total": { "count": 1, "sum": 50 },
        "last": { "id": 1, "amount": 50 }, "large": 0 } } },

    { "note": "a line over 100 counts as large, and the lines are kept in the order they came",
      "event": "ledger.entry", "data": { "id": 2, "amount": 150 },
      "expect": { "variables": {
        "entries": [ { "id": 1, "amount": 50 }, { "id": 2, "amount": 150 } ],
        "total": { "count": 2, "sum": 200 },
        "last": { "id": 2, "amount": 150 }, "large": 1 } } },

    { "note": "a line with an id already there replaces it where it stands",
      "event": "ledger.entry", "data": { "id": 1, "amount": 70 },
      "expect": { "variables": {
        "entries": [ { "id": 1, "amount": 70 }, { "id": 2, "amount": 150 } ],
        "total": { "count": 2, "sum": 220 },
        "last": { "id": 1, "amount": 70 }, "large": 1 } } },

    { "note": "the total moves one line on from the total the statechart holds",
      "event": "bump",
      "expect": { "variables": { "total": { "count": 3, "sum": 221 } } } },

    { "note": "the last line's id goes on a list of ids, and the sum of the list is asked for",
      "event": "track",
      "expect": { "variables": { "ids": [ 1 ], "idsum": 1 } } },
    { "event": "track",
      "expect": { "variables": { "ids": [ 1, 1 ], "idsum": 2 } } },

    { "event": "ledger.entry", "data": { "id": 3, "amount": 10 },
      "expect": { "variables": { "total": { "count": 3, "sum": 230 }, "last": { "id": 3, "amount": 10 } } } },
    { "event": "track",
      "expect": { "variables": { "ids": [ 1, 1, 3 ], "idsum": 5 } } },

    { "event": "ledger.entry", "data": { "id": 4, "amount": 1 }, "expect": { "variables": { "total": { "count": 4, "sum": 231 } } } },
    { "event": "ledger.entry", "data": { "id": 5, "amount": 1 }, "expect": { "variables": { "total": { "count": 5, "sum": 232 } } } },
    { "event": "ledger.entry", "data": { "id": 6, "amount": 1 }, "expect": { "variables": { "total": { "count": 6, "sum": 233 } } } },
    { "event": "ledger.entry", "data": { "id": 7, "amount": 1 }, "expect": { "variables": { "total": { "count": 7, "sum": 234 } } } },
    { "event": "ledger.entry", "data": { "id": 8, "amount": 1 },
      "expect": { "variables": {
        "entries": [ { "id": 1, "amount": 70 }, { "id": 2, "amount": 150 }, { "id": 3, "amount": 10 },
                     { "id": 4, "amount": 1 }, { "id": 5, "amount": 1 }, { "id": 6, "amount": 1 },
                     { "id": 7, "amount": 1 }, { "id": 8, "amount": 1 } ],
        "total": { "count": 8, "sum": 235 }, "refusals": 0 } } },

    { "note": "a total that overflows is a failed statement: the line was put in by the statement before, the total stays as it was, the rest of the block does not run, and error.execution says so",
      "event": "ledger.entry", "data": { "id": 7, "amount": 2147483647 },
      "expect": { "variables": {
        "entries": [ { "id": 1, "amount": 70 }, { "id": 2, "amount": 150 }, { "id": 3, "amount": 10 },
                     { "id": 4, "amount": 1 }, { "id": 5, "amount": 1 }, { "id": 6, "amount": 1 },
                     { "id": 7, "amount": 2147483647 }, { "id": 8, "amount": 1 } ],
        "total": { "count": 8, "sum": 235 },
        "last": { "id": 8, "amount": 1 },
        "large": 1, "refusals": 1 } } },

    { "note": "the line replaced again is totalled again",
      "event": "ledger.entry", "data": { "id": 7, "amount": 1 },
      "expect": { "variables": {
        "entries": [ { "id": 1, "amount": 70 }, { "id": 2, "amount": 150 }, { "id": 3, "amount": 10 },
                     { "id": 4, "amount": 1 }, { "id": 5, "amount": 1 }, { "id": 6, "amount": 1 },
                     { "id": 7, "amount": 1 }, { "id": 8, "amount": 1 } ],
        "total": { "count": 8, "sum": 235 },
        "last": { "id": 7, "amount": 1 },
        "large": 1, "refusals": 1 } } },

    { "note": "a ninth line does not fit: AddEntry fails, nothing is written, the rest of the block does not run, and error.execution says so",
      "event": "ledger.entry", "data": { "id": 9, "amount": 500 },
      "expect": { "variables": {
        "entries": [ { "id": 1, "amount": 70 }, { "id": 2, "amount": 150 }, { "id": 3, "amount": 10 },
                     { "id": 4, "amount": 1 }, { "id": 5, "amount": 1 }, { "id": 6, "amount": 1 },
                     { "id": 7, "amount": 1 }, { "id": 8, "amount": 1 } ],
        "total": { "count": 8, "sum": 235 },
        "last": { "id": 7, "amount": 1 },
        "large": 1, "refusals": 2 } } }
  ]
}
