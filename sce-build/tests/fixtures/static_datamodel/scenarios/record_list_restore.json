{
  "machine": "sce:std/shared/record_list",
  "about": "A stable state handed to a copy of the standard shared record list its host builds again, `record_list.restore` (docs/adr/0085 sections 4.4 and 9.3), then the changes after the cut as `record_list.recall`: the state's live values are taken in as writes, each at the dot it carries, a live value of a change whose write-overs the cut forgot among them, and the copy's clock is raised to the state's. A state may come in parts, and a value given twice is taken in once. Nothing is reported or sent, and no change identity is claimed. The changes after the cut are taken in over it, and the copy's next change is stamped after everything it was given. Expected values come from a model of the list, not from a backend.",
  "steps": [
    {"note": "started: a copy that holds nothing", "expect": {"state": "open", "sent": [], "variables": {"node": "0", "values": []}}},
    {"note": "the host builds the copy again, node 1, which keeps a journal", "event": "record_list.join", "data": {"node": "1"}, "expect": {"state": "open", "sent": [], "variables": {"node": "1"}}},
    {"note": "the state at the cut: three live values, each at its own dot, one of them written by node 2's change whose write-overs the cut forgot, and the state's clock", "event": "record_list.restore", "data": {"by": "0", "wallTime": "1727001002000", "counter": 3, "ops": [{"kind": 0, "id": 1, "field": 1, "value": "0", "text": "kept", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"kind": 0, "id": 1, "field": 2, "value": "0", "text": "mine", "wallTime": "1727001001000", "counter": 0, "nodeId": "1"}, {"kind": 0, "id": 2, "field": 1, "value": "0", "text": "x", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "1", "field": "1", "value": "0", "text": "kept", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"id": "1", "field": "2", "value": "0", "text": "mine", "wallTime": "1727001001000", "counter": 0, "nodeId": "1"}, {"id": "2", "field": "1", "value": "0", "text": "x", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}], "adds": [{"element": "65537", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"element": "65538", "wallTime": "1727001001000", "counter": 0, "nodeId": "1"}, {"element": "131073", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}], "clock": {"wallTime": "1727001002000", "counter": 3, "nodeId": "0"}, "refusals": 0}}},
    {"note": "a second part of the same state: its new value is taken in, one given already is not taken twice", "event": "record_list.restore", "data": {"by": "0", "wallTime": "1727001002000", "counter": 3, "ops": [{"kind": 0, "id": 2, "field": 2, "value": "0", "text": "y", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"kind": 0, "id": 1, "field": 1, "value": "0", "text": "kept", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "1", "field": "1", "value": "0", "text": "kept", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"id": "1", "field": "2", "value": "0", "text": "mine", "wallTime": "1727001001000", "counter": 0, "nodeId": "1"}, {"id": "2", "field": "1", "value": "0", "text": "x", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"id": "2", "field": "2", "value": "0", "text": "y", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}], "adds": [{"element": "65537", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"element": "65538", "wallTime": "1727001001000", "counter": 0, "nodeId": "1"}, {"element": "131073", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"element": "131074", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}], "clock": {"wallTime": "1727001002000", "counter": 3, "nodeId": "0"}, "refusals": 0}}},
    {"note": "a peer's change after the cut, recalled, writes 2/1 over and anew", "event": "record_list.recall", "data": {"by": "3", "wallTime": "1727001002500", "counter": 0, "ops": [{"kind": 1, "id": 2, "field": 1, "value": "0", "text": "", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"kind": 0, "id": 2, "field": 1, "value": "0", "text": "x2", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "0", "provisional": false}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "1", "field": "1", "value": "0", "text": "kept", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"id": "1", "field": "2", "value": "0", "text": "mine", "wallTime": "1727001001000", "counter": 0, "nodeId": "1"}, {"id": "2", "field": "2", "value": "0", "text": "y", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"id": "2", "field": "1", "value": "0", "text": "x2", "wallTime": "1727001002500", "counter": 0, "nodeId": "3"}], "adds": [{"element": "65537", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"element": "65538", "wallTime": "1727001001000", "counter": 0, "nodeId": "1"}, {"element": "131074", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"element": "131073", "wallTime": "1727001002500", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727001002500", "counter": 1, "nodeId": "1"}, "refusals": 0}}},
    {"note": "the copy's own clear after the cut, recalled: the clock is raised to its stamp", "event": "record_list.recall", "data": {"by": "1", "wallTime": "1727001003000", "counter": 0, "ops": [{"kind": 1, "id": 1, "field": 2, "value": "0", "text": "", "wallTime": "1727001001000", "counter": 0, "nodeId": "1"}], "command": "4", "provisional": false}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "1", "field": "1", "value": "0", "text": "kept", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"id": "2", "field": "2", "value": "0", "text": "y", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"id": "2", "field": "1", "value": "0", "text": "x2", "wallTime": "1727001002500", "counter": 0, "nodeId": "3"}], "adds": [{"element": "65537", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"element": "131074", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"element": "131073", "wallTime": "1727001002500", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727001003000", "counter": 0, "nodeId": "1"}, "refusals": 0}}},
    {"note": "the copy's next change is offered, stamped after everything it was given", "event": "record_list.edit", "data": {"id": 1, "field": 1, "value": "0", "text": "kept, again", "now": "1727001000000", "command": "5"}, "expect": {"state": "open", "sent": [{"target": "#journal", "event": "record_list.made", "data": {"by": "1", "wallTime": "1727001003000", "counter": 1, "ops": [{"kind": 1, "id": 1, "field": 1, "value": "0", "text": "", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"kind": 0, "id": 1, "field": 1, "value": "0", "text": "kept, again", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "5"}}], "variables": {"values": [{"id": "1", "field": "1", "value": "0", "text": "kept", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"id": "2", "field": "2", "value": "0", "text": "y", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"id": "2", "field": "1", "value": "0", "text": "x2", "wallTime": "1727001002500", "counter": 0, "nodeId": "3"}], "adds": [{"element": "65537", "wallTime": "1727001000000", "counter": 0, "nodeId": "2"}, {"element": "131074", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"element": "131073", "wallTime": "1727001002500", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727001003000", "counter": 1, "nodeId": "1"}, "refusals": 0}}},
    {"note": "accepted: taken in", "event": "record_list.verdict", "data": {"wallTime": "1727001003000", "counter": 1, "outcome": "accepted", "reason": null}, "expect": {"state": "open", "sent": [{"target": "#journal", "event": "record_list.closed", "data": {"command": "5", "operations": 2, "reason": null, "wallTime": "1727001003000", "counter": 1}}], "variables": {"values": [{"id": "2", "field": "2", "value": "0", "text": "y", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"id": "2", "field": "1", "value": "0", "text": "x2", "wallTime": "1727001002500", "counter": 0, "nodeId": "3"}, {"id": "1", "field": "1", "value": "0", "text": "kept, again", "wallTime": "1727001003000", "counter": 1, "nodeId": "1"}], "adds": [{"element": "131074", "wallTime": "1727001001500", "counter": 1, "nodeId": "3"}, {"element": "131073", "wallTime": "1727001002500", "counter": 0, "nodeId": "3"}, {"element": "65537", "wallTime": "1727001003000", "counter": 1, "nodeId": "1"}], "clock": {"wallTime": "1727001003000", "counter": 1, "nodeId": "1"}, "refusals": 0}}}
  ]
}
