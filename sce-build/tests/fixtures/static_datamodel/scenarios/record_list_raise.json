{
  "machine": "sce:std/shared/record_list",
  "about": "The host's word of the highest stamp of a copy's own node its delivery layer holds, `record_list.raise` (docs/adr/0093, section 4.3), given to a copy of the standard shared record list: the clock is raised to a stamp above it, as to a stamp of the copy's own, and never by a receive, so it takes no tick; a stamp at or below it moves nothing; and the next change the copy makes is stamped after it, whatever the `now` of its command. The copy keeps no journal here, so its change is sent whole to `#people` with its stamp. Expected values come from a model of the list, not from a backend.",
  "steps": [
    {"note": "started: a copy that holds nothing", "expect": {"state": "open", "sent": [], "variables": {"node": "0", "clock": {"wallTime": "0", "counter": 0, "nodeId": "0"}}}},
    {"note": "the host names the copy, node 1, which keeps no journal: a test throws it away", "event": "record_list.join", "data": {"node": "1", "journal": false}, "expect": {"state": "open", "sent": [], "variables": {"node": "1"}}},
    {"note": "a raise above the clock moves it to the stamp, no tick past it", "event": "record_list.raise", "data": {"wallTime": "1727000800000", "counter": 4, "command": "0"}, "expect": {"state": "open", "sent": [], "variables": {"clock": {"wallTime": "1727000800000", "counter": 4, "nodeId": "0"}}}},
    {"note": "a raise of an earlier wall time moves nothing", "event": "record_list.raise", "data": {"wallTime": "1727000799000", "counter": 9, "command": "0"}, "expect": {"state": "open", "sent": [], "variables": {"clock": {"wallTime": "1727000800000", "counter": 4, "nodeId": "0"}}}},
    {"note": "nor does one of the same wall time and a lower counter", "event": "record_list.raise", "data": {"wallTime": "1727000800000", "counter": 2, "command": "0"}, "expect": {"state": "open", "sent": [], "variables": {"clock": {"wallTime": "1727000800000", "counter": 4, "nodeId": "0"}}}},
    {"note": "a change whose command says an earlier `now` is stamped after the raised stamp", "event": "record_list.edit", "data": {"id": 7, "field": 1, "value": "0", "text": "after", "now": "1727000795000"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.change", "data": {"by": "1", "wallTime": "1727000800000", "counter": 5, "ops": [{"kind": 0, "id": 7, "field": 1, "value": "0", "text": "after", "wallTime": "0", "counter": 0, "nodeId": "0"}]}}], "variables": {"clock": {"wallTime": "1727000800000", "counter": 5, "nodeId": "1"}, "values": [{"id": "7", "field": "1", "value": "0", "text": "after", "wallTime": "1727000800000", "counter": 5, "nodeId": "1"}]}}},
    {"note": "a raise to the stamp the clock holds moves nothing", "event": "record_list.raise", "data": {"wallTime": "1727000800000", "counter": 5, "command": "0"}, "expect": {"state": "open", "sent": [], "variables": {"clock": {"wallTime": "1727000800000", "counter": 5, "nodeId": "1"}}}},
    {"note": "a peer's change of the same wall time moves the clock past its counter", "event": "record_list.change", "data": {"by": "2", "wallTime": "1727000800000", "counter": 9, "ops": [{"kind": 0, "id": 8, "field": 1, "value": "0", "text": "bob", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"clock": {"wallTime": "1727000800000", "counter": 10, "nodeId": "1"}}}},
    {"note": "a raise past that moves it again", "event": "record_list.raise", "data": {"wallTime": "1727000800000", "counter": 20, "command": "0"}, "expect": {"state": "open", "sent": [], "variables": {"clock": {"wallTime": "1727000800000", "counter": 20, "nodeId": "1"}}}},
    {"note": "and the next change is stamped after it", "event": "record_list.edit", "data": {"id": 7, "field": 2, "value": "1", "text": "", "now": "1727000800000"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.change", "data": {"by": "1", "wallTime": "1727000800000", "counter": 21, "ops": [{"kind": 0, "id": 7, "field": 2, "value": "1", "text": "", "wallTime": "0", "counter": 0, "nodeId": "0"}]}}], "variables": {"clock": {"wallTime": "1727000800000", "counter": 21, "nodeId": "1"}, "values": [{"id": "7", "field": "1", "value": "0", "text": "after", "wallTime": "1727000800000", "counter": 5, "nodeId": "1"}, {"id": "8", "field": "1", "value": "0", "text": "bob", "wallTime": "1727000800000", "counter": 9, "nodeId": "2"}, {"id": "7", "field": "2", "value": "1", "text": "", "wallTime": "1727000800000", "counter": 21, "nodeId": "1"}]}}}
  ]
}
