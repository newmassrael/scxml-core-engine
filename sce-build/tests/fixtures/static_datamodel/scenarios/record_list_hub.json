{
  "machine": "sce:std/shared/record_list",
  "about": "The hub's copy of the standard shared record list (sce:std/shared/record_list.scxml), node 9: every change taken in is passed on to every person's copy by the route `#people`, whoever made it; a roster drops what a member who may only read sends; the hub's own change is relayed and sent to no hub; a settle asks the people, counts the answers that are its own and tells everyone the instant, repeating the last instant to an answer that differs; and the walk of the digest answers a person on the same route. Expected values are computed by a model of the list held first to every step todo_peer took in the world's afternoon, not observed from a backend.",
  "steps": [
    {"note": "started", "expect": {"state": "open", "sent": [], "variables": {"node": "0", "hub": false}}},
    {"note": "the host names the copy the hub, node 9", "event": "record_list.join", "data": {"node": "9", "hub": true}, "expect": {"state": "open", "sent": [], "variables": {"node": "9", "hub": true}}},
    {"note": "a person's write is taken in and passed on to every person's copy, its author's included", "event": "record_list.write", "data": {"id": 7, "field": 1, "value": "0", "text": "buy milk", "wallTime": "1727000040000", "counter": 1, "nodeId": "1"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.write", "data": {"id": 7, "field": 1, "value": "0", "text": "buy milk", "wallTime": "1727000040000", "counter": 1, "nodeId": "1"}}], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "buy milk", "wallTime": "1727000040000", "counter": 1, "nodeId": "1"}]}}},
    {"note": "a supersede is passed on the same way", "event": "record_list.supersede", "data": {"id": 7, "field": 1, "wallTime": "1727000040000", "counter": 1, "nodeId": "1", "by": "2"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.supersede", "data": {"id": 7, "field": 1, "wallTime": "1727000040000", "counter": 1, "nodeId": "1", "by": "2"}}], "variables": {"values": [], "tombstones": [{"element": "458753", "wallTime": "1727000040000", "counter": 1, "nodeId": "1"}]}}},
    {"note": "the host sets the roster: node 1 writes, node 2 reads", "event": "record_list.role", "data": {"node": "1", "role": 2}, "expect": {"state": "open", "sent": [], "variables": {"denied": 0}}},
    {"note": "node 2 may only read", "event": "record_list.role", "data": {"node": "2", "role": 1}, "expect": {"state": "open", "sent": [], "variables": {"denied": 0}}},
    {"note": "a write of a member who may only read is dropped whole and counted, and passed on to no one", "event": "record_list.write", "data": {"id": 7, "field": 2, "value": "1", "text": "", "wallTime": "1727000040010", "counter": 0, "nodeId": "2"}, "expect": {"state": "open", "sent": [], "variables": {"values": [], "denied": 1}}},
    {"note": "so is its supersede", "event": "record_list.supersede", "data": {"id": 7, "field": 2, "wallTime": "1727000040010", "counter": 0, "nodeId": "1", "by": "2"}, "expect": {"state": "open", "sent": [], "variables": {"tombstones": [{"element": "458753", "wallTime": "1727000040000", "counter": 1, "nodeId": "1"}], "denied": 2}}},
    {"note": "a writer's write is taken and passed on", "event": "record_list.write", "data": {"id": 7, "field": 2, "value": "1", "text": "", "wallTime": "1727000040020", "counter": 0, "nodeId": "1"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.write", "data": {"id": 7, "field": 2, "value": "1", "text": "", "wallTime": "1727000040020", "counter": 0, "nodeId": "1"}}], "variables": {"values": [{"id": "7", "field": "2", "value": "1", "text": "", "wallTime": "1727000040020", "counter": 0, "nodeId": "1"}]}}},
    {"note": "the host takes the roster down", "event": "record_list.role", "data": {"node": "1", "role": 0}, "expect": {"state": "open", "sent": [], "variables": {"denied": 2}}},
    {"note": "and node 2 off the roster, which then refuses no one", "event": "record_list.role", "data": {"node": "2", "role": 0}, "expect": {"state": "open", "sent": [], "variables": {"denied": 2}}},
    {"note": "the hub's own change: taken in here and passed on to the people, and sent to no hub", "event": "record_list.edit", "data": {"id": 7, "field": 2, "value": "3", "text": "", "now": "1727000100000"}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.supersede", "data": {"id": 7, "field": 2, "wallTime": "1727000040020", "counter": 0, "nodeId": "1", "by": "9"}}, {"target": "#people", "event": "record_list.write", "data": {"id": 7, "field": 2, "value": "3", "text": "", "wallTime": "1727000100000", "counter": 0, "nodeId": "9"}}], "variables": {"values": [{"id": "7", "field": "2", "value": "3", "text": "", "wallTime": "1727000100000", "counter": 0, "nodeId": "9"}], "tombstones": [{"element": "458753", "wallTime": "1727000040000", "counter": 1, "nodeId": "1"}, {"element": "458754", "wallTime": "1727000040020", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000100000", "counter": 0, "nodeId": "9"}}}},
    {"note": "the host asks the hub to settle up to an instant with two people: the hub, whose clock is past it already, asks the people", "event": "record_list.settle", "data": {"before": "1727000070000", "members": 2}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.propose", "data": {"before": "1727000070000"}}], "variables": {"clock": {"wallTime": "1727000100000", "counter": 0, "nodeId": "9"}}}},
    {"note": "one person answers with what the hub holds: one of two", "event": "record_list.ack", "data": {"sender": "1", "before": "1727000070000", "hash": 548050040}, "expect": {"state": "open", "sent": [], "variables": {"floor": "0"}}},
    {"note": "an answer for another instant is not read", "event": "record_list.ack", "data": {"sender": "2", "before": "1727000060000", "hash": 548050040}, "expect": {"state": "open", "sent": [], "variables": {"floor": "0"}}},
    {"note": "the other answers the same: the instant is settled, every person is told, and the hub forgets the tombstones up to it", "event": "record_list.ack", "data": {"sender": "2", "before": "1727000070000", "hash": 548050040}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.floor", "data": {"before": "1727000070000", "hash": 548050040}}], "variables": {"floor": "1727000070000", "tombstones": []}}},
    {"note": "a later round", "event": "record_list.settle", "data": {"before": "1727000130000", "members": 2}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.propose", "data": {"before": "1727000130000"}}], "variables": {"floor": "1727000070000"}}},
    {"note": "an answer that differs settles nothing, and the people are told the instant last settled", "event": "record_list.ack", "data": {"sender": "1", "before": "1727000130000", "hash": 548050041}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.floor", "data": {"before": "1727000070000", "hash": 548050040}}], "variables": {"floor": "1727000070000"}}},
    {"note": "the link is back: the hub shows every person the root of its digest", "event": "record_list.resync", "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.node", "data": {"sender": "9", "to": "0", "depth": 0, "prefix": "0", "hash": 1193544754, "reply": false}}], "variables": {"refusals": 0}}},
    {"note": "a person's root differs: the hub shows that person the children of the root", "event": "record_list.node", "data": {"sender": "1", "to": "0", "depth": 0, "prefix": "0", "hash": 1193544755, "reply": false}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.node", "data": {"sender": "9", "to": "1", "depth": 1, "prefix": "0", "hash": 1193544754, "reply": false}}, {"target": "#people", "event": "record_list.node", "data": {"sender": "9", "to": "1", "depth": 1, "prefix": "1", "hash": 0, "reply": false}}, {"target": "#people", "event": "record_list.node", "data": {"sender": "9", "to": "1", "depth": 1, "prefix": "2", "hash": 0, "reply": false}}], "variables": {"refusals": 0}}},
    {"note": "at a minute they differ in, the hub shares what it holds of that minute with the people, and shows its node there once", "event": "record_list.node", "data": {"sender": "1", "to": "0", "depth": 30, "prefix": "28783335", "hash": 0, "reply": false}, "expect": {"state": "open", "sent": [{"target": "#people", "event": "record_list.write", "data": {"id": 7, "field": 2, "value": "3", "text": "", "wallTime": "1727000100000", "counter": 0, "nodeId": "9"}}, {"target": "#people", "event": "record_list.node", "data": {"sender": "9", "to": "1", "depth": 30, "prefix": "28783335", "hash": 1193544754, "reply": true}}], "variables": {"refusals": 0}}}
  ]
}
