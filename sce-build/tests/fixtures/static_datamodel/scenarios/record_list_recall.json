{
  "machine": "sce:std/shared/record_list",
  "about": "A copy of the standard shared record list built again by its host from what was made, never from the commands (docs/adr/0083 section 1.5, docs/adr/0085 section 7.2, docs/adr/0093 section 2.1): each change of its journal and of its layer's history is given back whole as `record_list.recall`, in a causal order, and taken in by the one path every change is taken in by. Nothing is reported to the host or sent to a peer while it is, and the roster judges no recalled change, though it judges a peer's change the layer gives. A recalled change of the copy's own raises the clock to its stamp, one of write-overs only (a clear) included (docs/adr/0083 section 1.6), and another's moves it as a peer's change does. A change of the copy's own recalled as provisional is taken in provisionally and withdrawn as one taken in at its verdict is; the flag is not read of another's change. The copy's next change is stamped past every stamp it was given. Expected values come from a model of the list, not from a backend.",
  "steps": [
    {"note": "started: a copy that holds nothing", "expect": {"state": "open", "sent": [], "variables": {"node": "0", "values": []}}},
    {"note": "the host builds the copy again, node 1, which keeps a journal", "event": "record_list.join", "data": {"node": "1"}, "expect": {"state": "open", "sent": [], "variables": {"node": "1"}}},
    {"note": "its own first change is recalled: taken in, nothing reported or sent, and the clock raised to its stamp", "event": "record_list.recall", "data": {"by": "1", "wallTime": "1727000900000", "counter": 0, "ops": [{"kind": 0, "id": 5, "field": 1, "value": "0", "text": "call the clinic", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "7", "provisional": false}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "5", "field": "1", "value": "0", "text": "call the clinic", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "327681", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000900000", "counter": 0, "nodeId": "0"}, "denied": 0, "refusals": 0}}},
    {"note": "a peer's change from the layer's history is recalled: the clock moves as a peer's change moves it", "event": "record_list.recall", "data": {"by": "2", "wallTime": "1727000900500", "counter": 0, "ops": [{"kind": 0, "id": 6, "field": 1, "value": "0", "text": "from bob", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "0", "provisional": false}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "5", "field": "1", "value": "0", "text": "call the clinic", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}, {"id": "6", "field": "1", "value": "0", "text": "from bob", "wallTime": "1727000900500", "counter": 0, "nodeId": "2"}], "adds": [{"element": "327681", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}, {"element": "393217", "wallTime": "1727000900500", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000900500", "counter": 1, "nodeId": "1"}, "denied": 0, "refusals": 0}}},
    {"note": "its own clear, a change of write-overs only, raises the clock to its stamp all the same", "event": "record_list.recall", "data": {"by": "1", "wallTime": "1727000901000", "counter": 0, "ops": [{"kind": 1, "id": 6, "field": 1, "value": "0", "text": "", "wallTime": "1727000900500", "counter": 0, "nodeId": "2"}], "command": "9", "provisional": false}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "5", "field": "1", "value": "0", "text": "call the clinic", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "327681", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000901000", "counter": 0, "nodeId": "1"}, "denied": 0, "refusals": 0}}},
    {"note": "the host sets a roster in which only node 1 writes", "event": "record_list.role", "data": {"node": "1", "role": 2}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "5", "field": "1", "value": "0", "text": "call the clinic", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "327681", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000901000", "counter": 0, "nodeId": "1"}, "denied": 0, "refusals": 0}}},
    {"note": "a recalled change of a node the roster does not let write is taken in: it was admitted where it was carried", "event": "record_list.recall", "data": {"by": "3", "wallTime": "1727000901100", "counter": 0, "ops": [{"kind": 0, "id": 7, "field": 1, "value": "0", "text": "carol", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "0", "provisional": false}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "5", "field": "1", "value": "0", "text": "call the clinic", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}, {"id": "7", "field": "1", "value": "0", "text": "carol", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}], "adds": [{"element": "327681", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}, {"element": "458753", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000901100", "counter": 1, "nodeId": "1"}, "denied": 0, "refusals": 0}}},
    {"note": "where the same node's change, given by the layer, is judged and taken in as no change", "event": "record_list.change", "data": {"by": "3", "wallTime": "1727000901150", "counter": 0, "ops": [{"kind": 0, "id": 7, "field": 2, "value": "0", "text": "carol again", "wallTime": "0", "counter": 0, "nodeId": "0"}]}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "5", "field": "1", "value": "0", "text": "call the clinic", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}, {"id": "7", "field": "1", "value": "0", "text": "carol", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}], "adds": [{"element": "327681", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}, {"element": "458753", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}], "clock": {"wallTime": "1727000901100", "counter": 1, "nodeId": "1"}, "denied": 1, "refusals": 0}}},
    {"note": "its own change the host journalled as provisional is recalled so: taken in provisionally", "event": "record_list.recall", "data": {"by": "1", "wallTime": "1727000901200", "counter": 0, "ops": [{"kind": 1, "id": 5, "field": 1, "value": "0", "text": "", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}, {"kind": 0, "id": 5, "field": 1, "value": "0", "text": "call home", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "10", "provisional": true}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "carol", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"id": "5", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000901200", "counter": 0, "nodeId": "1"}], "adds": [{"element": "458753", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"element": "327681", "wallTime": "1727000901200", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000901200", "counter": 0, "nodeId": "1"}, "denied": 1, "refusals": 0}}},
    {"note": "a peer's change recalled with the flag is taken in as any peer's change", "event": "record_list.recall", "data": {"by": "2", "wallTime": "1727000901300", "counter": 0, "ops": [{"kind": 0, "id": 8, "field": 1, "value": "0", "text": "bob", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "0", "provisional": true}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "carol", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"id": "5", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000901200", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "0", "text": "bob", "wallTime": "1727000901300", "counter": 0, "nodeId": "2"}], "adds": [{"element": "458753", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"element": "327681", "wallTime": "1727000901200", "counter": 0, "nodeId": "1"}, {"element": "524289", "wallTime": "1727000901300", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000901300", "counter": 1, "nodeId": "1"}, "denied": 1, "refusals": 0}}},
    {"note": "so a withdrawal of it names no provisional change, and is counted", "event": "record_list.withdraw", "data": {"wallTime": "1727000901300", "counter": 0, "command": "0"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "carol", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"id": "5", "field": "1", "value": "0", "text": "call home", "wallTime": "1727000901200", "counter": 0, "nodeId": "1"}, {"id": "8", "field": "1", "value": "0", "text": "bob", "wallTime": "1727000901300", "counter": 0, "nodeId": "2"}], "adds": [{"element": "458753", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"element": "327681", "wallTime": "1727000901200", "counter": 0, "nodeId": "1"}, {"element": "524289", "wallTime": "1727000901300", "counter": 0, "nodeId": "2"}], "clock": {"wallTime": "1727000901300", "counter": 1, "nodeId": "1"}, "denied": 1, "refusals": 1}}},
    {"note": "the withdrawal of the recalled provisional change gives back the value it wrote over", "event": "record_list.withdraw", "data": {"wallTime": "1727000901200", "counter": 0, "command": "10"}, "expect": {"state": "open", "sent": [], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "carol", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"id": "8", "field": "1", "value": "0", "text": "bob", "wallTime": "1727000901300", "counter": 0, "nodeId": "2"}, {"id": "5", "field": "1", "value": "0", "text": "call the clinic", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "458753", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"element": "524289", "wallTime": "1727000901300", "counter": 0, "nodeId": "2"}, {"element": "327681", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000901300", "counter": 1, "nodeId": "1"}, "denied": 1, "refusals": 1}}},
    {"note": "the copy's next change is offered, stamped past every stamp it was given back", "event": "record_list.edit", "data": {"id": 9, "field": 1, "value": "0", "text": "new", "now": "1727000901250", "command": "11"}, "expect": {"state": "open", "sent": [{"target": "#journal", "event": "record_list.made", "data": {"by": "1", "wallTime": "1727000901300", "counter": 2, "ops": [{"kind": 0, "id": 9, "field": 1, "value": "0", "text": "new", "wallTime": "0", "counter": 0, "nodeId": "0"}], "command": "11"}}], "variables": {"values": [{"id": "7", "field": "1", "value": "0", "text": "carol", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"id": "8", "field": "1", "value": "0", "text": "bob", "wallTime": "1727000901300", "counter": 0, "nodeId": "2"}, {"id": "5", "field": "1", "value": "0", "text": "call the clinic", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "adds": [{"element": "458753", "wallTime": "1727000901100", "counter": 0, "nodeId": "3"}, {"element": "524289", "wallTime": "1727000901300", "counter": 0, "nodeId": "2"}, {"element": "327681", "wallTime": "1727000900000", "counter": 0, "nodeId": "1"}], "clock": {"wallTime": "1727000901300", "counter": 2, "nodeId": "1"}, "denied": 1, "refusals": 1}}}
  ]
