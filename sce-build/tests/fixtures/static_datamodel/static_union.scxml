<?xml version="1.0" encoding="UTF-8"?>
<!--
  A statechart that reads a payload holding a union by testing its tag
  (docs/adr/0092, section 6.1): the tag of `one` taken into a variable of its
  enum; a chain of tests on it, each branch reading a field its case declares,
  `radius` under a test that leaves both cases that share it, a list `path`
  holds walked where its case is proven; and each shape of `many` narrowed by
  the same tests on the loop's item; and the present value of `maybe`, where a
  test proves it present and in its case. A union variable built where it is
  declared has a field of its case written where the case is proven, and an
  optional one takes the payload's `one` whole. A text is lifted into an
  optional union whole, or the refusal of it kept beside it. A shape at an index
  of a list is taken whole into a union variable and then narrowed by its tag; an
  index outside the list writes nothing, ends the block and raises
  error.execution (docs/adr/0099, section 5.3). A delivery outside its type is
  refused whole and counted. Every out variable is what a host reads back, and
  scenarios/static_union.json replays it.

  The Rust backend lowers it; every other backend refuses the union by its own
  name until it lowers one (section 7). Rust compile+run gate:
  scripts/regen_static_datamodel_rust.sh commits the generated machine, and
  backends/rust/tests/tests/a_union_payload_is_read_by_its_tag.rs drives it.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="idle"
       datamodel="sce-static"
       name="static_union">
  <sce:import kind="enum" src="enum_shape_kind.scxml" as="Kind"/>
  <sce:import kind="event-schema" src="event_shapes.scxml" as="Shapes"/>
  <sce:import kind="event-schema" src="shape_radius.scxml" as="Radius"/>
  <sce:import kind="event-schema" src="shape_rect.scxml" as="Rect"/>
  <sce:import kind="event-schema" src="shape_label.scxml" as="Label"/>
  <sce:import kind="event-schema" src="shape_path.scxml" as="Path"/>
  <sce:import kind="union" src="union_shape.scxml" as="Shape"/>
  <sce:import kind="event-schema" src="event_shape_said.scxml" as="Said"/>
  <sce:import kind="event-schema" src="event_shapes_picked.scxml" as="Picked"/>
  <sce:import kind="event-schema" src="sce:std/lift/refusal.scxml" as="LiftRefusal"/>
  <datamodel>
    <!-- A union variable is built where it is declared, a case and each of its
         fields; one with no case to start at is optional and starts absent
         (docs/adr/0092, section 6.1 item 5, and its amendment of 2026-11-07). -->
    <data id="built" sce:type="union:Shape" sce:direction="out">
      <sce:set name="kind" expr="Kind.rect"/>
      <sce:set name="width" expr="1"/>
      <sce:set name="height" expr="2"/>
    </data>
    <data id="kept" sce:type="optional&lt;union:Shape&gt;" expr="null" sce:direction="out"/>
    <data id="last_kind" sce:type="enum:Kind" expr="Kind.dot" sce:direction="out"/>
    <data id="radius" sce:type="uint16" expr="0" sce:direction="out"/>
    <data id="width" sce:type="uint16" expr="0" sce:direction="out"/>
    <data id="height" sce:type="uint16" expr="0" sce:direction="out"/>
    <data id="labels" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="points" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="dots" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="many_radius" sce:type="uint16" expr="0" sce:direction="out"/>
    <data id="many_width" sce:type="uint16" expr="0" sce:direction="out"/>
    <data id="many_shapes" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="maybe_width" sce:type="uint16" expr="0" sce:direction="out"/>
    <data id="refusals" sce:type="uint32" expr="0" sce:direction="out"/>
    <!-- A text lifted into a union whole, or why it is none (section 6.1
         item 5; docs/adr/0087, section 2.1). -->
    <data id="lifted" sce:type="optional&lt;union:Shape&gt;" expr="null" sce:direction="out"/>
    <data id="lift_why" sce:type="optional&lt;record:LiftRefusal&gt;" expr="null" sce:direction="out"/>
    <!-- A shape taken whole from a list's element at an index, into a union
         that starts at a case and into one that starts absent; how many were
         taken, and the width of a picked rect (docs/adr/0099, section 5.3). -->
    <data id="picked" sce:type="union:Shape" sce:direction="out">
      <sce:set name="kind" expr="Kind.dot"/>
    </data>
    <data id="picked_maybe" sce:type="optional&lt;union:Shape&gt;" expr="null" sce:direction="out"/>
    <data id="picks" sce:type="uint32" expr="0" sce:direction="out"/>
    <data id="picked_width" sce:type="uint16" expr="0" sce:direction="out"/>
  </datamodel>
  <state id="idle">
    <transition event="shapes.sent" type="internal">
      <assign location="last_kind" expr="_event.data.one.kind"/>
      <if cond="_event.data.one.kind === Kind.dot">
        <assign location="dots" expr="dots + 1"/>
      <elseif cond="_event.data.one.kind === Kind.circle || _event.data.one.kind === Kind.disc"/>
        <assign location="radius" expr="_event.data.one.radius"/>
      <elseif cond="_event.data.one.kind === Kind.rect"/>
        <assign location="width" expr="_event.data.one.width"/>
        <assign location="height" expr="_event.data.one.height"/>
      <elseif cond="_event.data.one.kind === Kind.path"/>
        <foreach array="_event.data.one.points" item="point">
          <assign location="points" expr="points + 1"/>
        </foreach>
      <else/>
        <assign location="labels" expr="labels + 1"/>
      </if>
      <foreach array="_event.data.many" item="shape">
        <assign location="many_shapes" expr="many_shapes + 1"/>
        <if cond="shape.kind === Kind.rect">
          <assign location="many_width" expr="shape.width"/>
        <elseif cond="shape.kind === Kind.circle || shape.kind === Kind.disc"/>
          <assign location="many_radius" expr="shape.radius"/>
        </if>
      </foreach>
      <if cond="_event.data.maybe !== null &amp;&amp; _event.data.maybe.value.kind === Kind.rect">
        <assign location="maybe_width" expr="_event.data.maybe.value.width"/>
      </if>
      <!-- A field is written where its case is proven, and a union is put
           into a variable whole (section 6.1 items 5 and 6). -->
      <if cond="built.kind === Kind.rect">
        <assign location="built.width" expr="built.width + 1"/>
      </if>
      <assign location="kept" expr="_event.data.one"/>
    </transition>
    <transition event="shape.said" type="internal">
      <sce:lift text="_event.data.text" schema="Shape" location="lifted" refusal="lift_why"/>
    </transition>
    <!-- The element at an index is read by the checked read of an index, which
         fails outside the list: then nothing is written, the rest of the block
         does not run, and error.execution is raised (docs/adr/0099, section
         5.3; §scxml-4.9). The element itself is no subject a test narrows, so
         the copy is, and is narrowed by its tag (docs/adr/0092, section 6.1
         item 2). -->
    <transition event="shapes.picked" type="internal">
      <assign location="picked" expr="_event.data.many[_event.data.at]"/>
      <assign location="picked_maybe" expr="_event.data.many[_event.data.at]"/>
      <assign location="picks" expr="picks + 1"/>
      <if cond="picked.kind === Kind.rect">
        <assign location="picked_width" expr="picked.width"/>
      </if>
    </transition>
    <!-- A delivery outside its type is refused whole: none of the content above
         runs, and error.execution says so once. -->
    <transition event="error.execution" type="internal">
      <assign location="refusals" expr="refusals + 1"/>
    </transition>
  </state>
</scxml>
