<?xml version="1.0" encoding="UTF-8"?>
<!--
  datamodel="sce-static": a statechart hands an imported algorithm the payload of the
  event it is on as a record whose text the algorithm's record holds within eight
  UTF-8 bytes, and holds the record the algorithm gives back.

  `Echo` cannot fail and `Bump` declares `may-fail` (its addition overflows past 255).
  Until `use.bump`, a `labelled.taken` is handed to `Echo` and its answer kept in
  `echoed`; after it, to `Bump`, kept in `bumped`. A label past eight bytes is held to
  the algorithm's bound where the payload crosses into its record: the call fails as
  an assignment past a bound does, so error.execution is raised once, counted in
  `errors`, and the record keeps what it held. So does `Bump`'s own overflow.

  The Rust backend holds a payload's text as the wire carries it until ADR 0086
  section 4.4 lands on every lane, and the algorithm's record in its bounded type, so
  the crossing is where the bound is held (docs/adr/0086, section 7.4). Rust
  compile+run gate: scripts/regen_static_datamodel_rust.sh commits the generated
  machine, and backends/rust/tests/tests/a_payload_text_is_held_where_it_crosses_into_an_algorithm.rs
  drives it.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="open" datamodel="sce-static" name="static_payload_text_call">
  <sce:import kind="event-schema" src="schema_labelled.scxml" as="Labelled"/>
  <sce:import kind="algorithm" src="algorithm_labelled_echo.scxml" as="Echo"/>
  <sce:import kind="algorithm" src="algorithm_labelled_bump.scxml" as="Bump"/>
  <datamodel>
    <data id="bumping" sce:type="bool" expr="false"/>
    <data id="echoed" sce:type="record:Labelled" sce:direction="out">
      <sce:set name="sensor" expr="0"/>
      <sce:set name="label" expr="''"/>
    </data>
    <data id="bumped" sce:type="record:Labelled" sce:direction="out">
      <sce:set name="sensor" expr="0"/>
      <sce:set name="label" expr="''"/>
    </data>
    <data id="errors" sce:type="uint32" expr="0" sce:direction="out"/>
  </datamodel>
  <state id="open">
    <transition event="labelled.taken" cond="!bumping" type="internal">
      <assign location="echoed" expr="Echo(_event.data)"/>
    </transition>
    <transition event="labelled.taken" cond="bumping" type="internal">
      <assign location="bumped" expr="Bump(_event.data)"/>
    </transition>
    <transition event="use.bump" type="internal">
      <assign location="bumping" expr="true"/>
    </transition>
    <transition event="error.execution" type="internal">
      <assign location="errors" expr="errors + 1"/>
    </transition>
  </state>
</scxml>
