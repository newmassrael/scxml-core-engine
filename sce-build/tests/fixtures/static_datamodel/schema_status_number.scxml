<?xml version="1.0" encoding="UTF-8"?>
<!--
  A number that names where an item stands: the field of
  `static_enum_number.scxml`'s `status.number`, an integer wider than the enum's
  carrier, so a number the carrier cannot hold reaches the conversion too
  (docs/adr/0047).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="schema_status_number"
       sce:event-name="status.number">
  <datamodel>
    <data id="number" sce:type="int64" sce:direction="in"/>
  </datamodel>
</scxml>
