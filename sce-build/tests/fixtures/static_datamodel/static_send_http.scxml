<?xml version="1.0" encoding="UTF-8"?>
<!--
  datamodel="sce-static" (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A BasicHTTP send"):
  the `<param>`s of a `<send>` over the BasicHTTP Event I/O Processor
  (docs/adr/0005, decision 4). The processor is the runtime's, and what the
  machine owes it is the pairs: each value read from the machine's own fields
  when the send runs, as the text a form carries. A generated machine has no
  script engine, so no expression of a param is handed to one.

  `bump` changes `count`, `ready` and `label` before the send reads them, so a
  copy taken at start-up (`count` 3, `ready` false, `label` "idle") is told from
  the value the fields hold now:

    count = 4   ready = true   label = "busy"   twice = 8
    delta = -5  ratio = 1.5

  `twice` is an expression rather than a variable, so a lowering that handled
  only a bare name would still be wrong. `delta` (a signed 16-bit integer) and
  `ratio` (a real) are the other kinds of value a pair carries: a negative number
  and a fraction cross as the text they spell. `boom` is `count * 2000000000`,
  which a 32-bit field cannot hold: the checked multiplication fails, so its
  pair is left out and `error.execution` is raised (§scxml-5.7.1) while the
  request still goes with the pair that could be read. `errors` counts those.

  The target names no endpoint of the suite (`example.invalid` is reserved for
  this): the request is observed where the engine hands it to the transport, so
  no listener is involved, and the form's encoding is the transport's.

  Deliberately single-axis: no event payload, no delay, no `<content>`, and no
  `namelist` (`static_send_namelist` holds that one). The pairs are held on each
  engine by a test of its own that records the request, since a scenario states
  what a machine's fields hold and not what it sent over a wire.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:sce="http://sce.dev/ext"
       version="1.0" initial="idle" datamodel="sce-static" name="static_send_http">
  <datamodel>
    <data id="count" sce:type="uint32" expr="3"/>
    <data id="ready" sce:type="bool" expr="false"/>
    <data id="label" sce:type="string" sce:capacity="16" expr="'idle'"/>
    <data id="delta" sce:type="int16" expr="-5"/>
    <data id="ratio" sce:type="float64" expr="1.5"/>
    <data id="errors" sce:type="uint32" expr="0" sce:direction="out"/>
  </datamodel>
  <state id="idle">
    <transition event="bump" type="internal">
      <assign location="count" expr="4"/>
      <assign location="ready" expr="true"/>
      <assign location="label" expr="'busy'"/>
    </transition>
    <transition event="go" type="internal">
      <send event="note" type="http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor" target="http://example.invalid/hook">
        <param name="count" expr="count"/>
        <param name="ready" expr="ready"/>
        <param name="label" location="label"/>
        <param name="twice" expr="count * 2"/>
        <param name="delta" expr="delta"/>
        <param name="ratio" expr="ratio"/>
      </send>
    </transition>
    <transition event="boom" type="internal">
      <send event="note" type="http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor" target="http://example.invalid/hook">
        <param name="count" expr="count"/>
        <param name="big" expr="count * 2000000000"/>
      </send>
    </transition>
    <transition event="error.execution" type="internal">
      <assign location="errors" expr="errors + 1"/>
    </transition>
  </state>
</scxml>
