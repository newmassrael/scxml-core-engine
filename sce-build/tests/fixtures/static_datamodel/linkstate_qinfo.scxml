<!--
  What a peer declared with its queryable (zenoh's QueryableInfoType): the value of the inner map. Its event is never raised; the schema types the value.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="linkstate_qinfo"
       sce:event-name="interest.value">
  <datamodel>
    <data id="complete" sce:type="bool" sce:direction="in"/>
    <data id="distance" sce:type="uint16" sce:direction="in"/>
  </datamodel>
</scxml>
