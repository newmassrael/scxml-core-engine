<!--
  W3C SCXML 6.2.4: a `<send>` may choose where it goes at run time, from the
  datamodel (`targetexpr`). A draft does that when the specification never says
  who the caller is: the route is a data item, and the data item carries the open
  question (`sce:unresolved`).

  Every send here routes to a target nothing answers at, so each raises
  `error.communication` (W3C SCXML C.1) and the block ends (W3C SCXML 4.9). What
  the fixture holds apart is WHICH send raised the error the machine did not
  answer, because that is what a host that plays the design needs to know:

    send.open      the route reads `openRoute`, an open question: the error is
                   the question showing through
    send.assumed   the route reads a value chosen without an answer
                   (`sce:assumed`): applied, and not a question
    send.plain     the route reads a plain data item
    send.literal   a literal target nothing answers at: no route is computed
    send.reachable the route reads an open question but resolves to a target
                   that exists, so the send fails nothing
    send.badtype   the TYPE reads an open question and names a processor this
                   platform does not support: the route fails at its type, so the
                   question is attributed
    send.badaddress   the route produces an address this processor cannot use
    send.noroute      the route evaluates to nothing
    send.badroute     the route expression itself fails to evaluate
    send.badtypeexpr  the type expression itself fails to evaluate
                   (each of the four fails the ROUTE, so each carries the question)
    send.badevent  the route is sound and rests on an open question, but the
                   event name reads a variable nobody declared
    send.baddelay  the same, in the delay
    send.badnamelist the same, in the namelist

  The last three fail for a reason no answer to the route's question would mend,
  so none of them carries it: the fault is the document's.

    send.late      the route names a Mesh peer nobody serves, and the send waits:
                   the refusal is made when the wait is over, long after the send
                   site returned, and still rests on the open question
    send.lateplain the same route read from a plain data item: no question

  `listen` moves to a state that answers `error.communication`, so the same
  open route can also be shown to fail where the document handles the failure.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       initial="idle"
       datamodel="ecmascript">
  <datamodel>
    <data id="openRoute" expr="'#_nobody'" sce:unresolved="caller-target"
          sce:unresolved-reason="the specification does not say who the caller is"/>
    <data id="assumedRoute" expr="'#_nobody'" sce:assumed="caller-by-default"
          sce:assumed-reason="the standing rule says a notice goes to the caller"/>
    <data id="plainRoute" expr="'#_nobody'"/>
    <data id="reachableRoute" expr="'#_internal'" sce:unresolved="caller-target"
          sce:unresolved-reason="the specification does not say who the caller is"/>
    <data id="openType" expr="'x-unsupported-processor'" sce:unresolved="caller-target"
          sce:unresolved-reason="the specification does not say who the caller is"/>
    <data id="invalidRoute" expr="'!nowhere'" sce:unresolved="caller-target"
          sce:unresolved-reason="the specification does not say who the caller is"/>
    <data id="emptyRoute" sce:unresolved="caller-target"
          sce:unresolved-reason="the specification does not say who the caller is"/>
    <data id="openPeer" expr="'#peer'" sce:unresolved="caller-target"
          sce:unresolved-reason="the specification does not say who the caller is"/>
    <data id="plainPeer" expr="'#peer'"/>
    <data id="answered" expr="0"/>
  </datamodel>

  <state id="idle">
    <transition event="send.open" target="idle">
      <send event="notice" targetexpr="openRoute"/>
    </transition>
    <transition event="send.assumed" target="idle">
      <send event="notice" targetexpr="assumedRoute"/>
    </transition>
    <transition event="send.plain" target="idle">
      <send event="notice" targetexpr="plainRoute"/>
    </transition>
    <transition event="send.literal" target="idle">
      <send event="lost" target="#_nobody"/>
    </transition>
    <transition event="send.reachable" target="idle">
      <send event="notice" targetexpr="reachableRoute"/>
    </transition>
    <transition event="send.badtype" target="idle">
      <send event="notice" typeexpr="openType"/>
    </transition>
    <transition event="send.late" target="idle">
      <send event="notice" delay="1s" targetexpr="openPeer"/>
    </transition>
    <transition event="send.lateplain" target="idle">
      <send event="notice" delay="1s" targetexpr="plainPeer"/>
    </transition>
    <transition event="send.badaddress" target="idle">
      <send event="notice" targetexpr="invalidRoute"/>
    </transition>
    <transition event="send.noroute" target="idle">
      <send event="notice" targetexpr="emptyRoute"/>
    </transition>
    <transition event="send.badroute" target="idle">
      <send event="notice" targetexpr="openRoute()"/>
    </transition>
    <transition event="send.badtypeexpr" target="idle">
      <send event="notice" typeexpr="openType()"/>
    </transition>
    <transition event="send.badevent" target="idle">
      <send eventexpr="missingEvent" targetexpr="reachableRoute"/>
    </transition>
    <transition event="send.baddelay" target="idle">
      <send event="notice" delayexpr="missingDelay" targetexpr="reachableRoute"/>
    </transition>
    <transition event="send.badnamelist" target="idle">
      <send event="notice" targetexpr="reachableRoute" namelist="missingName"/>
    </transition>
    <transition event="listen" target="listening"/>
  </state>

  <state id="listening">
    <transition event="send.open" target="listening">
      <send event="notice" targetexpr="openRoute"/>
    </transition>
    <transition event="error.communication" target="listening">
      <assign location="answered" expr="answered + 1"/>
    </transition>
  </state>
</scxml>
