<?xml version="1.0" encoding="UTF-8"?>
<!-- A person of the board example of docs/adr/0151, D1. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="person"
       sce:event-name="board.person">
  <datamodel>
    <data id="name" sce:type="string[64]" sce:direction="in"/>
  </datamodel>
</scxml>
