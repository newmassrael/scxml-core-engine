<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/adr/0151, D1: the hours of a project summed, floating numbers whose sum
     depends on the order they are added in: refused (view/floating-aggregate). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="view"
       name="floating_aggregate">
  <sce:import kind="event-schema" src="task.scxml" as="Task"/>
  <sce:import kind="event-schema" src="hours_row.scxml" as="HoursRow"/>
  <sce:table name="tasks" type="map&lt;uint64, record:Task&gt;[tasks_max=10000]" public="true"/>
  <sce:query>
    <sce:from table="tasks" as="t"/>
    <sce:group by="t.row.project">
      <sce:field name="project" expr="t.row.project"/>
      <sce:sum name="hours" expr="t.row.hours"/>
    </sce:group>
    <sce:order by="project"/>
  </sce:query>
  <sce:result type="record:HoursRow" key="project" bound="rows=100"/>
</scxml>
