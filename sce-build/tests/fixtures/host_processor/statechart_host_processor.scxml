<!--
  W3C SCXML 6.2.5: a `<send type="...">` naming an Event I/O Processor the
  HOST supplies, rather than one of the two the specification names.

  The fixture holds three things apart that the configuration alone cannot
  tell apart, which is why each has its own counter:

    served   — the host's handler ran and answered; its reply arrived as an
               event the document was waiting for.
    refused  — the platform raised error.execution instead, because nothing
               performed the act.
    plain    — a `<send>` with no `type` delivered in the same block.

  `plain` is the false-positive guard. Every measurement here is of one
  branch in one send template, and a change that broke ordinary sends while
  leaving the host branch working would otherwise read as a pass.

  Once served, the machine sends to the host a second time, from `pairs`, to
  measure what the request CARRIES rather than whether it arrives (W3C SCXML
  5.10). A host that forwards the event — the Mesh router puts it in an
  envelope — needs the event data a local delivery would have carried, so the
  request's event data is asserted against it: the namelist pair is in it, and
  the `<param>` that cannot be read is not (W3C SCXML 5.7.1 leaves the pair
  out, raises error.execution, and the message still goes). That error is
  counted in `paramErrors`, in its own state, so it cannot be mistaken for the
  `refused` of a processor nobody registered.

  The generated machine is compiled with the host-processor declaration
  `x-sce-host` (scripts/regen_host_processor.sh names the flag; an XML
  comment cannot spell a double hyphen). Driven with a handler registered
  it must reach `served`; driven with none it must reach `refused` — the
  same binary, so the pair measures the registration and not the build.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="statechart_host_processor" initial="dispatching">

  <datamodel>
    <data id="served" expr="0"/>
    <data id="refused" expr="0"/>
    <data id="plain" expr="0"/>
    <data id="paramErrors" expr="0"/>
    <!-- Named by the second send's namelist. -->
    <data id="mode" expr="'pairs'"/>
    <!-- Read by its failing <param>: indexing null raises in every
         expression language this fixture runs. -->
    <data id="nothing" expr="null"/>
  </datamodel>

  <state id="dispatching">
    <onentry>
      <!-- Ordinary send, first, so the guard below is measured even when
           the host branch aborts the rest of the block. -->
      <send event="plain.arrived"/>
      <!-- The host-served send. `within` is a <param> so the request the
           handler receives is asserted to carry it, not just to exist. -->
      <send type="x-sce-host" event="watch.turn">
        <param name="within" expr="'2500'"/>
      </send>
      <!-- External, so it queues behind every reply the host made above. -->
      <send event="advance"/>
    </onentry>

    <transition event="plain.arrived">
      <assign location="plain" expr="plain + 1"/>
    </transition>
    <transition event="turn.done">
      <assign location="served" expr="served + 1"/>
    </transition>
    <transition event="error.execution">
      <assign location="refused" expr="refused + 1"/>
    </transition>
    <!-- Queued by the onentry after the host's replies, so every reply has
         been counted when it arrives; the second send is made only by a
         machine the host actually served. -->
    <transition event="advance" cond="served &gt; 0" target="pairs"/>
  </state>

  <state id="pairs">
    <onentry>
      <send type="x-sce-host" event="watch.pairs" namelist="mode">
        <param name="kept" expr="'here'"/>
        <param name="broken" expr="nothing.deep"/>
      </send>
    </onentry>
    <transition event="error.execution">
      <assign location="paramErrors" expr="paramErrors + 1"/>
    </transition>
  </state>
</scxml>
