<!--
  The record `statechart_host_invoker_optional.scxml`'s `lookup` invocation
  completes with (`sce:result`, SCE Accepted Subset §2.12): what the host found
  for a key. Imported as `LookupResult`.

  A lookup may find nothing, so `at`, `label` and `hit` are values that may be
  absent (docs/adr/0055, section 4): the host completes with the record's JSON,
  and an absent value is `null` there, its key written all the same. `rows`
  is a field every completion carries. There is no sentinel day, no empty text
  that stands for "no label" and no second field saying whether `at` is
  meaningful.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="host_invoker_lookup_result"
       sce:kind="event-schema"
       sce:event-name="lookup.result">
  <datamodel>
    <data id="rows" sce:type="uint8" sce:direction="in"/>
    <data id="at" sce:type="optional&lt;int64&gt;" sce:direction="in"/>
    <data id="label" sce:type="optional&lt;string&gt;" sce:max-size="16" sce:direction="in"/>
    <data id="hit" sce:type="optional&lt;bool&gt;" sce:direction="in"/>
  </datamodel>
</scxml>
