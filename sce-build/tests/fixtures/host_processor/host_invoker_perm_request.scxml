<!--
  The record `statechart_host_invoker.scxml`'s `perm` invocation asks with
  (`sce:request`, SCE Accepted Subset §2.12): what the host is asked to
  grant, and how far. Imported as `PermRequest`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="host_invoker_perm_request"
       sce:kind="event-schema"
       sce:event-name="perm.request">
  <datamodel>
    <data id="scope" sce:type="string" sce:direction="in"/>
    <data id="level" sce:type="uint8" sce:direction="in"/>
  </datamodel>
</scxml>
