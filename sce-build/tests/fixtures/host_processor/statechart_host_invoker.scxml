<!--
  W3C SCXML 6.4.1: an `<invoke type="...">` the HOST runs, rather than one
  of the processors SCE implements.

  An invoke is not a send: it has a lifetime. So the fixture holds four
  outcomes apart, each with its own counter, because the configuration
  alone cannot tell them apart:

    started  — the host's invoker was asked to begin, and answered with a
               completion, which arrived as done.invoke.probe.
    refused  — error.execution instead, because nobody ran the process.
    ended    — the state exited, so the host was told to stop. The counter
               lives on the state AFTER the exit, since an exiting state
               cannot observe its own teardown.
    entered  — plain entry ran. The false-positive guard: a change that
               broke the entry chain while leaving the invoke arm working
               would otherwise read as a pass.

  Two things the counters also hold, because nothing else would:

    `_event.invokeid` — a completion counts only when it names its
               invocation (W3C SCXML 5.10.1). One raised with no invokeid
               falls through and `started` stays 0.
    probe2   — a second invocation in the same state whose id begins with
               the first's. A dispatch that found an entry by substring
               started `probe` for it, so `started2` stays 0 and the host
               sees `probe` twice.

  And what the request says is evaluated when the invocation starts, which
  `evaluating` holds apart from the literal case above (W3C SCXML 6.4.1):

    req      — `srcexpr` and `namelist` read the data model; a repeated
               `<param>` name keeps both values; a `<param>` that cannot be
               evaluated is reported and dropped (W3C SCXML 5.7.1) while the
               invocation still starts.
    req2     — `<content expr>` crosses as the text of its value.
    req3     — a `srcexpr` that cannot be evaluated starts nothing and
               reports it.

    dropped  — the error.execution events `evaluating` saw: one for the bad
               `<param>` and one for req3, so 2.

  And a completion is accepted at most once, and only from the run it
  belongs to (W3C SCXML 6.4): `again` re-enters `invoking`, which starts
  `probe` a second time under the same id, so a late reply from the first
  run can be told apart from the second run's by the start's token and
  refused.

  `done` also runs an invoke with no id and an `idlocation` (W3C SCXML
  6.4.1): the generated id is written to `doneId`, handed to the host, and
  carried as `_event.invokeid` on the completion. The document names no
  specific `done.invoke.<id>` for it, so the completion arrives as the generic
  `done.invoke`, and `matched` counts it only when its invokeid is what the
  document stored.

  An `idlocation` is a location expression, so the write is an assignment
  (W3C SCXML 6.2.4, 6.4.1, 5.4), which `locating` holds for both elements:

    slot     — `slot.id` and `slot.sid` are member paths, and receive the
               invoke's and the send's ids. `slotted` counts the completion
               only when its invokeid is what `slot.id` holds, and `pinged`
               counts the send that arrived.
    lost     — `n.nope.deeper` cannot take an id, so each element raises
               error.execution and is abandoned (W3C SCXML 5.9.2): the host
               is never asked to start that invoke, and `leaked` stays 0
               because that message is never sent. So `lost` is 2.

  The generated machine is compiled with the host-invoker declaration
  `x-sce-host` (scripts/regen_host_processor.sh names the flag; an XML
  comment cannot spell a double hyphen).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="statechart_host_invoker" initial="invoking">

  <datamodel>
    <data id="started" expr="0"/>
    <data id="started2" expr="0"/>
    <data id="refused" expr="0"/>
    <data id="ended" expr="0"/>
    <data id="entered" expr="0"/>
    <data id="destination" expr="'pane://dyn'"/>
    <data id="n" expr="7"/>
    <data id="dropped" expr="0"/>
    <data id="doneId" expr="''"/>
    <data id="matched" expr="0"/>
    <data id="slot" expr="{ id: '', sid: '' }"/>
    <data id="slotted" expr="0"/>
    <data id="pinged" expr="0"/>
    <data id="leaked" expr="0"/>
    <data id="lost" expr="0"/>
  </datamodel>

  <state id="invoking">
    <onentry>
      <assign location="entered" expr="entered + 1"/>
    </onentry>

    <invoke id="probe" type="x-sce-host" src="pane://turn">
      <param name="within" expr="'2500'"/>
    </invoke>
    <invoke id="probe2" type="x-sce-host" src="pane://other"/>

    <transition event="done.invoke.probe" cond="_event.invokeid === 'probe'">
      <assign location="started" expr="started + 1"/>
    </transition>
    <transition event="done.invoke.probe2" cond="_event.invokeid === 'probe2'">
      <assign location="started2" expr="started2 + 1"/>
    </transition>
    <transition event="error.execution">
      <assign location="refused" expr="refused + 1"/>
    </transition>
    <!-- Leaving the state is what cancels the invocation. `leave` is
         raised by the host so the test decides when the exit happens. -->
    <transition event="leave" target="done"/>
    <transition event="evaluate" target="evaluating"/>
    <transition event="locate" target="locating"/>
  </state>

  <state id="evaluating">
    <invoke id="req" type="x-sce-host" srcexpr="destination" namelist="n">
      <param name="twice" expr="'a'"/>
      <param name="twice" expr="n + 1"/>
      <param name="bad" expr="n.nope.deeper"/>
    </invoke>
    <invoke id="req2" type="x-sce-host">
      <content expr="'body:' + n"/>
    </invoke>
    <invoke id="req3" type="x-sce-host" srcexpr="n.nope.deeper"/>

    <transition event="error.execution">
      <assign location="dropped" expr="dropped + 1"/>
    </transition>
  </state>

  <state id="done">
    <onentry>
      <assign location="ended" expr="ended + 1"/>
    </onentry>
    <invoke type="x-sce-host" idlocation="doneId"/>
    <transition event="done.invoke" cond="_event.invokeid === doneId">
      <assign location="matched" expr="matched + 1"/>
    </transition>
    <transition event="again" target="invoking"/>
  </state>

  <state id="locating">
    <onentry>
      <send event="ping" idlocation="slot.sid"/>
      <send event="leak" idlocation="n.nope.deeper"/>
    </onentry>
    <invoke type="x-sce-host" idlocation="slot.id"/>
    <invoke type="x-sce-host" idlocation="n.nope.deeper"/>

    <transition event="done.invoke" cond="_event.invokeid === slot.id">
      <assign location="slotted" expr="slotted + 1"/>
    </transition>
    <transition event="ping">
      <assign location="pinged" expr="pinged + 1"/>
    </transition>
    <transition event="leak">
      <assign location="leaked" expr="leaked + 1"/>
    </transition>
    <transition event="error.execution">
      <assign location="lost" expr="lost + 1"/>
    </transition>
  </state>
</scxml>
