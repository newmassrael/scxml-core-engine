<!--
  The record `statechart_host_invoker.scxml`'s `perm` invocation completes
  with (`sce:result`, SCE Accepted Subset §2.12): whether the host granted
  what it was asked. Imported as `PermResult`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       name="host_invoker_perm_result"
       sce:kind="event-schema"
       sce:event-name="perm.result">
  <datamodel>
    <data id="granted" sce:type="bool" sce:direction="in"/>
  </datamodel>
</scxml>
