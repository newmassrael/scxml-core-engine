<?xml version="1.0"?>
<!--
  Regression fixture for the cpp-namespace-prefix flag of
  `sce-codegen generate -l cpp`.

  The prefix nests the emitted machine namespace from
  `SCE::Generated::<machine>` to `SCE::Generated::<prefix>::<machine>`. The
  parent's child-machine *declaration* lives in the `.h`
  (state_machine.jinja2), while the *definitions* that reference the same
  child namespace live in the `.inl` (invoke_methods.jinja2 `make_shared`
  and actions/send.jinja2 `ChildEvent`). If the prefix reaches the `.h` but
  not the `.inl`, the declared and defined types diverge and the unit fails
  to compile — the exact bug this fixture guards.

  Shape requirements to exercise both `.inl` sites:
    - an inline `<content>` `<invoke>` (co-emitted as a template sibling, so
      the suite compiles standalone — unlike a `src=` external child), with
      an `id` so it is addressable, and
    - an `<onentry>` `<send target="#_<invokeid>">` to that child, which
      emits the `using ChildEvent = ::SCE::Generated::<...>::Event` block.

  The inline child carries no `name=`: sce-codegen derives the child slug
  from the parent plus a synth suffix (cf. invoke_inline_content.scxml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       name="cpp_namespace_prefix_invoke" initial="parent">
  <state id="parent">
    <invoke type="scxml" id="worker">
      <content>
        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
               initial="waiting">
          <state id="waiting">
            <transition event="ping" target="leaf"/>
          </state>
          <final id="leaf"/>
        </scxml>
      </content>
    </invoke>
    <onentry>
      <send target="#_worker" event="ping"/>
    </onentry>
    <transition event="done.invoke" target="done"/>
  </state>
  <final id="done"/>
</scxml>
