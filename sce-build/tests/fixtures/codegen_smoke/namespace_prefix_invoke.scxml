<?xml version="1.0"?>
<!--
  Shared regression fixture for the suite-prefix flags that nest emitted
  symbols so identically-named machines from different catalogs link into
  one binary: the cpp-namespace-prefix (C++) and c-symbol-prefix (C11)
  flags of `sce-codegen generate`.

  Both backends split the parent's child-machine reference across two
  translation units, so the prefix must reach BOTH or the references
  diverge and the unit fails to compile — the exact bug this fixture
  guards:
    - C++: the child `shared_ptr` *declaration* is in the `.h`
      (state_machine.jinja2) while its *definitions* are in the `.inl`
      (invoke_methods.jinja2 `make_shared`, actions/send.jinja2
      `ChildEvent`). The `.h` and `.inl` use separate render contexts.
    - C11: every symbol is `<name>_…` (no namespace); the child symbol
      refs span the `.h` and `.c`, and the suite prefix must nest them
      while leaving the `#include` filename and SCE-MAP markers alone.

  Shape requirements to exercise both child-ref sites:
    - an inline `<content>` `<invoke>` (co-emitted as a template sibling, so
      the suite compiles standalone — unlike a `src=` external child), with
      an `id` so it is addressable, and
    - an `<onentry>` `<send target="#_<invokeid>">` to that child, which
      emits the child-event send block.

  The inline child carries no `name=`: sce-codegen derives the child slug
  from the parent plus a synth suffix (cf. invoke_inline_content.scxml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       name="cpp_namespace_prefix_invoke" initial="parent">
  <state id="parent">
    <invoke type="scxml" id="worker">
      <content>
        <scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
               initial="waiting">
          <state id="waiting">
            <transition event="ping" target="leaf"/>
          </state>
          <final id="leaf"/>
        </scxml>
      </content>
    </invoke>
    <onentry>
      <send target="#_worker" event="ping"/>
    </onentry>
    <transition event="done.invoke" target="done"/>
  </state>
  <final id="done"/>
</scxml>
