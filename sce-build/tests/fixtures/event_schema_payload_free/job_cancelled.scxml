<?xml version="1.0" encoding="UTF-8"?>
<!--
  An event-schema that declares no field because the specification does not
  say whether the event carries data: the open question is marked on the
  datamodel with `sce:unresolved`, the marker every other open question
  uses. Generic vocabulary (`job.cancelled`). Held by
  `a_payload_free_event_is_declared_not_omitted`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       sce:kind="event-schema"
       name="job_cancelled"
       sce:event-name="job.cancelled">
  <datamodel sce:unresolved="cancel-payload"
             sce:unresolved-reason="the specification does not say whether a cancellation names a reason"/>
</scxml>
