<?xml version="1.0" encoding="UTF-8"?>
<!-- A shape whose rect case holds a record with a field under the tag's
     key. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="union" name="union_shape_tag_collision">
  <sce:import kind="enum" src="shape_kind.scxml" as="ShapeKind"/>
  <sce:import kind="event-schema" src="shape_radius.scxml" as="Radius"/>
  <sce:import kind="event-schema" src="shape_kinded.scxml" as="Kinded"/>
  <datamodel>
    <data id="kind" sce:type="enum:ShapeKind">
      <sce:case variant="dot"/>
      <sce:case variant="circle" record="Radius"/>
      <sce:case variant="rect" record="Kinded"/>
    </data>
  </datamodel>
</scxml>
