<?xml version="1.0" encoding="UTF-8"?>
<!-- A shape with a case for every variant of its tag's enum and one more,
     for a variant the enum does not declare. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="union" name="union_shape_stray_case">
  <sce:import kind="enum" src="shape_kind.scxml" as="ShapeKind"/>
  <sce:import kind="event-schema" src="shape_radius.scxml" as="Radius"/>
  <sce:import kind="event-schema" src="shape_rect.scxml" as="Rect"/>
  <datamodel>
    <data id="kind" sce:type="enum:ShapeKind">
      <sce:case variant="dot"/>
      <sce:case variant="circle" record="Radius"/>
      <sce:case variant="rect" record="Rect"/>
      <sce:case variant="square" record="Rect"/>
    </data>
  </datamodel>
</scxml>
