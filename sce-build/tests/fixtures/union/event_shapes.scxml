<?xml version="1.0" encoding="UTF-8"?>
<!-- An event that carries a shape alone, a list of them, and one that may be
     absent (docs/adr/0092, section 1.1, item 3): a union is a type a field
     holds at any depth. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="event-schema" name="event_shapes"
       sce:event-name="shapes.sent">
  <sce:import kind="union" src="union_shape.scxml" as="Shape"/>
  <datamodel>
    <data id="one" sce:type="union:Shape" sce:direction="in"/>
    <data id="many" sce:type="list&lt;union:Shape&gt;[1..3]" sce:direction="in"/>
    <data id="maybe" sce:type="optional&lt;union:Shape&gt;" sce:direction="in"/>
  </datamodel>
</scxml>
