<?xml version="1.0" encoding="UTF-8"?>
<!-- The shape kinds as an open set: a number no variant names is a value of
     it, so it is no tag a union may have (docs/adr/0092, section 1.1). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="enum" name="shape_kind_open" sce:underlying-type="uint8"
       sce:strict-variants="false">
  <datamodel>
    <data id="variants">
      <sce:variant name="dot" value="0"/>
      <sce:variant name="circle" value="1"/>
      <sce:variant name="rect" value="2"/>
    </data>
  </datamodel>
</scxml>
