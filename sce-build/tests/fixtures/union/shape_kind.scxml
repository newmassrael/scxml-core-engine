<?xml version="1.0" encoding="UTF-8"?>
<!-- The tag of the shape unions beside this file (docs/adr/0092, section
     1.1): three kinds of shape, one of which carries nothing. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="enum" name="shape_kind" sce:underlying-type="uint8">
  <datamodel>
    <data id="variants">
      <sce:variant name="dot" value="0"/>
      <sce:variant name="circle" value="1"/>
      <sce:variant name="rect" value="2"/>
    </data>
  </datamodel>
</scxml>
