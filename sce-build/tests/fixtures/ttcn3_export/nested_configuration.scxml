<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §11.6: the nested tester as the MTC, its port
     mapped to the port of the system under test. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-configuration" name="nested_configuration">
  <sce:import kind="test-component" src="nested_tester.scxml" as="Tester"/>
  <sce:import kind="test-port-type" src="orders_port.scxml" as="OrdersPort"/>
  <sce:mtc type="Tester"/>
  <sce:system-port id="sut" type="OrdersPort"/>
  <sce:map component="mtc" port="sut" system-port="sut"/>
</scxml>
