<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/SCE_TEST_PROFILE.md §9.4: a suite whose one test component nests its
     states, so the validator of the export computes exit and entry sets of
     more than one state for its branches. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0" sce:kind="test-suite" name="nested_suite">
  <sce:import kind="test-case" src="nested_case.scxml" as="NestedCase"/>
  <sce:execute test-case="NestedCase" guard="5s"/>
</scxml>
