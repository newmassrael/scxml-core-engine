{
  "record": "sce-scenario-set",
  "v": 1,
  "specification": {"doc_id": "vending-controller", "rev": "1"},
  "origin": "ai-proposed",
  "interface": {
    "why": "The specification describes what happens to coins and products but names no signal, no payload field and no output. Every name here is a proposal, to be accepted or replaced.",
    "inputs": [
      {"name": "coin", "payload": {"value": "integer"}},
      {"name": "product", "payload": {"id": "text"}},
      {"name": "cancel"},
      {"name": "dispense-done"}
    ],
    "outputs": [
      {"name": "return-coin", "payload": {"value": "integer"}},
      {"name": "dispense", "payload": {"id": "text"}},
      {"name": "return-change", "payload": {"amount": "integer"}},
      {"name": "show-price", "payload": {"id": "text", "price": "integer"}},
      {"name": "return-credit", "payload": {"amount": "integer"}},
      {"name": "sold-out", "payload": {"id": "text"}}
    ],
    "data": ["credit"],
    "conditions": ["idle", "dispensing"]
  },
  "world": {
    "why": "The selected product's price and out of stock need a price list and a stock. The specification does not say where they come from, so the scenarios that need them are blocked and these values are placeholders for that decision, not facts.",
    "source": "undecided",
    "values": {"prices": {"A": 150, "B": 200}, "stock": {"A": 5, "B": 0}}
  },
  "scenarios": [
    {
      "id": "V1",
      "quote": "The vending controller starts idle with no credit.",
      "steps": [
        {"expect": {"condition": "idle", "data": {"credit": 0}}}
      ]
    },
    {
      "id": "V2",
      "quote": "Inserting a coin adds its value to the credit; 100 and 500 coins are accepted",
      "steps": [
        {"send": "coin", "payload": {"value": 100}, "expect": {"data": {"credit": 100}, "outbound": []}},
        {"send": "coin", "payload": {"value": 500}, "expect": {"data": {"credit": 600}, "outbound": []}}
      ]
    },
    {
      "id": "V3",
      "quote": "any other coin is returned at once.",
      "steps": [
        {"send": "coin", "payload": {"value": 200}, "expect": {"outbound": [{"event": "return-coin", "payload": {"value": 200}}], "data": {"credit": 0}}}
      ]
    },
    {
      "id": "V4",
      "quote": "Pressing cancel returns the whole credit and the controller goes back to idle.",
      "steps": [
        {"send": "coin", "payload": {"value": 100}},
        {"send": "coin", "payload": {"value": 500}},
        {"send": "cancel", "expect": {"outbound": [{"event": "return-credit", "payload": {"amount": 600}}], "condition": "idle", "data": {"credit": 0}}}
      ]
    },
    {
      "id": "V5-timeout-boundary",
      "quote": "If credit is held and nothing happens for 30 seconds, the credit is returned.",
      "steps": [
        {"send": "coin", "payload": {"value": 100}},
        {"advance_ms": 29999, "expect": {"outbound": []}},
        {"advance_ms": 1, "expect": {"outbound": [{"event": "return-credit", "payload": {"amount": 100}}], "data": {"credit": 0}}}
      ]
    },
    {
      "id": "V6-no-credit-no-timeout",
      "quote": "If credit is held and nothing happens for 30 seconds, the credit is returned.",
      "note": "The sentence is conditional on credit being held: with none, nothing is returned however long it waits.",
      "steps": [
        {"advance_ms": 100000, "expect": {"outbound": []}}
      ]
    },
    {
      "id": "V7-enough-credit",
      "quote": "When the credit is at least the selected product's price, the product is dispensed and the change is returned;",
      "status": "blocked",
      "blocked_by": "world.source: where the price list comes from is not decided",
      "steps": [
        {"send": "coin", "payload": {"value": 100}},
        {"send": "coin", "payload": {"value": 100}},
        {"send": "product", "payload": {"id": "A"}, "expect": {"outbound": [{"event": "dispense", "payload": {"id": "A"}}, {"event": "return-change", "payload": {"amount": 50}}], "condition": "dispensing"}}
      ]
    },
    {
      "id": "V8-not-enough-credit",
      "quote": "otherwise the price is shown.",
      "status": "blocked",
      "blocked_by": "world.source",
      "steps": [
        {"send": "coin", "payload": {"value": 100}},
        {"send": "product", "payload": {"id": "A"}, "expect": {"outbound": [{"event": "show-price", "payload": {"id": "A", "price": 150}}], "data": {"credit": 100}}}
      ]
    },
    {
      "id": "V9-exactly-the-price",
      "quote": "When the credit is at least the selected product's price",
      "note": "The boundary of at least: credit equal to the price dispenses, with change of zero. Whether a zero change is reported as an event is itself undecided.",
      "status": "blocked",
      "blocked_by": "world.source; and whether a zero change is reported",
      "steps": [
        {"send": "coin", "payload": {"value": 100}},
        {"send": "coin", "payload": {"value": 100}},
        {"send": "coin", "payload": {"value": 100}},
        {"send": "product", "payload": {"id": "A"}, "expect": {"outbound": [{"event": "dispense", "payload": {"id": "A"}}]}}
      ]
    },
    {
      "id": "V10-buttons-ignored-while-dispensing",
      "quote": "While dispensing, buttons are ignored.",
      "status": "blocked",
      "blocked_by": "world.source",
      "steps": [
        {"send": "coin", "payload": {"value": 500}},
        {"send": "product", "payload": {"id": "A"}, "expect": {"condition": "dispensing"}},
        {"send": "cancel", "expect": {"outbound": [], "condition": "dispensing"}},
        {"send": "product", "payload": {"id": "B"}, "expect": {"outbound": [], "condition": "dispensing"}}
      ]
    },
    {
      "id": "V11-idle-again",
      "quote": "When the dispense-done sensor reports, the controller is idle again.",
      "status": "blocked",
      "blocked_by": "world.source",
      "steps": [
        {"send": "coin", "payload": {"value": 500}},
        {"send": "product", "payload": {"id": "A"}},
        {"send": "dispense-done", "expect": {"condition": "idle"}}
      ]
    },
    {
      "id": "V12-sold-out",
      "quote": "If the selected product is out of stock it is not dispensed and a sold-out message is shown.",
      "status": "blocked",
      "blocked_by": "world.source (stock)",
      "steps": [
        {"send": "coin", "payload": {"value": 500}},
        {"send": "product", "payload": {"id": "B"}, "expect": {"outbound": [{"event": "sold-out", "payload": {"id": "B"}}]}}
      ]
    },
    {
      "id": "V13-sold-out-and-too-little-credit",
      "quote": "If the selected product is out of stock it is not dispensed and a sold-out message is shown.",
      "note": "Not decided by the specification: out of stock AND credit below the price. No expectation is written, on purpose; the scenario exists to be turned into a question for the owner.",
      "status": "awaiting-decision",
      "decision": {"question": "A product that is out of stock is selected with less credit than its price: is the price shown, the sold-out message, or both?"},
      "steps": [
        {"send": "coin", "payload": {"value": 100}},
        {"send": "product", "payload": {"id": "B"}}
      ]
    }
  ]
}
