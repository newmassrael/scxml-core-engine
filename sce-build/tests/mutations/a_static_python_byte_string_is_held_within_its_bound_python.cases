# Mutation cases for "a bytes variable is held within the `sce:capacity` it declares"
# under the Python backend (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A byte string";
# docs/adr/0005, decision 2).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_python_byte_string_is_held_within_its_bound_python.cases`.
#
# `static_bytes` assigns a bytes variable from a literal and from another one, and
# expects a value past the bound to leave the variable as it was and `errors` to count
# it. A Python machine is not saved, so the bound is the assignment's, and the scenario
# reads each value through its reader as its Latin-1 text. The mutants take one
# decision away each:
#
#   an assignment to a byte string is not held to its bound;
#   the helper that holds a value to its bound counts it as no bytes at all.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_pytest backends/python/tests integration/static_datamodel/
mutation_regen scripts/regen_static_datamodel_python.sh
mutation_runtime_targets sce-build/src/forge/static_lowering.rs backends/python/forge-runtime/sce_forge_runtime/algorithm.py
mutation_oracles backends/python/tests/integration/static_datamodel/test_static_scenarios.py sce-build/tests/fixtures/static_datamodel/scenarios/static_bytes.json

mutation_case "an assignment to a byte string is not held to its bound" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "            } else if let Some(capacity) = rewrites.bytes.get(location) {",
     "            } else if let Some(capacity) = rewrites.bytes.get(location).filter(|_| false) {")
PY

mutation_case "the helper that holds a value to its bound counts it as no bytes at all" <<'PY'
edit("backends/python/forge-runtime/sce_forge_runtime/algorithm.py",
     "    size = len(value.encode(\"utf-8\")) if isinstance(value, str) else len(value)",
     "    size = 0")
PY
