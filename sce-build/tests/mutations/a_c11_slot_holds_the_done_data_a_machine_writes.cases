# Mutation cases for "the done data a C11 machine that is not a `sce-static` one
# writes is an input of its slot and of what it hands its parent"
# (docs/adr/0086, section 8.6 (c)).
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_c11_slot_holds_the_done_data_a_machine_writes.cases
#
# A machine with no script engine under another data model holds its done data,
# an inline `<content>` finished at build time, in a buffer of its slot, and its
# parent takes it on `done.invoke`. The integration test generates a Null
# parent whose Null child ends with 300 bytes of text, and asks the child for a
# slot that holds the 302 bytes of its JSON string and for 302 bytes published
# to its parent, and the parent for a slot that holds them. The unit tests ask
# the measure for a literal pair, a literal `<content expr>` and a pair an
# engine computes, and the machine for the done data it can bound and a refusal
# by name of what it cannot bound when it has no engine. Each case breaks one
# link: the done data is no input of the machine's slot, the parent is not
# handed it, a pair's value is not measured, inline content is measured at
# nothing, and done data with no bound is grown on a machine with no engine.
#
# The machine is generated by `sce-codegen`, which the test runs as a
# subprocess, so the generator's source is a target compiled into a binary the
# test spawns.

mutation_tests -p sce-build --features cli --lib --test a_c11_machine_sizes_its_event_data_slot done_data
mutation_targets sce-build/src/forge/generator.rs

mutation_case "the done data is no input of the machine's slot" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "        sent = sent.max(bytes);\n        if state.parent.is_none() {\n",
     "        if state.parent.is_none() {\n")
PY

mutation_case "the parent is not handed the done data" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "        if state.parent.is_none() {\n            to_parent = to_parent.max(bytes);\n",
     "        if state.parent.is_some() {\n            to_parent = to_parent.max(bytes);\n")
PY

mutation_case "a pair's value is not measured" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "            (Some(expr), _) => value(expr),\n",
     "            (Some(_), _) => TextBound::Bounded(0),\n")
PY

mutation_case "inline content is measured at nothing" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "                | crate::filters::InlineContentReading::Value(wire) => {\n                    TextBound::Bounded(wire.len() as u64)\n",
     "                | crate::filters::InlineContentReading::Value(wire) => {\n                    TextBound::Bounded(wire.len() as u64 * 0)\n")
PY

mutation_case "done data with no bound is grown on a machine with no engine" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "            crate::forge::text_bound::TextBound::Unbounded(_) if model.needs_script_engine => {\n",
     "            crate::forge::text_bound::TextBound::Unbounded(_) if true => {\n")
PY
