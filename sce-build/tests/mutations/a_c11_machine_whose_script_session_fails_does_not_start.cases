# Mutation cases for docs/adr/0096 on the C11 channel: a machine whose script
# session cannot be established does not start, and its host is told why; an
# invoked child that cannot start is a failed invoke.
#
# Run with `scripts/mutate sce-build/tests/mutations/a_c11_machine_whose_script_session_fails_does_not_start.cases`.
#
# Establishing a session used to be part of `_init` and answer nothing: a NULL
# Lua state skipped the setup silently, the shared library ran as
# `(void)luaL_dostring`, and a bind that failed printed a line and queued
# error.execution while the start went on, so the machine ran over a session it
# did not have. Each case below puts back one piece of that shape and names the
# assertion that must go red. The oracle reaches the failure through the one seam
# a C11 machine has for its engine, the factory of its Lua state
# (`SCE_LUA_STATE_FACTORY`), which its target names and which fails the step a
# case asks for.
#
# The machines are generated when the tests are built, so there is no committed
# tree to regenerate: the build is what carries a mutated template into them.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^c11_integration_a_machine_whose_script_session_fails_does_not_start$'
mutation_targets tools/codegen/templates/c/state_machine.c.jinja2 tools/codegen/templates/c/scriptengine.jinja2 tools/codegen/templates/c/invoke_methods.jinja2
mutation_oracles backends/c/tests/integration/test_a_machine_whose_script_session_fails_does_not_start.c integration_resources/a_child_may_send_many_events_in_one_tick/a_child_may_send_many_events_in_one_tick.scxml

# ── The start goes on past a session that failed ────────────────────
#
# The construction drops the answer and declares the datamodel and enters
# anyway: the old shape, with the failure now reported to nobody.
# Killer: `a_start_whose_session_cannot_be_established_is_refused_with_the_step`,
# whose `_init` answers something other than
# `_START_SCRIPT_SESSION_UNAVAILABLE` (or whose run ends at the first Lua call
# on a state that is not there).

mutation_case "the start declares the datamodel past a session that failed" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     """    if (!establish_script_session(sm)) {
        return SCE_START_REFUSAL_SCRIPT_SESSION_UNAVAILABLE;
    }""",
     """    (void)establish_script_session(sm);""")
PY

# ── A library chunk that does not load is passed over ───────────────
#
# Every chunk runs and none is read, as `(void)luaL_dostring` did. The library
# the factory refuses is then absent, and the start fails one step later, at
# the bind, so the step it names is the wrong one.
# Killer: `expect_failure`'s stage check for `library`.

mutation_case "a library chunk that does not load is passed over" <<'PY'
edit("tools/codegen/templates/c/scriptengine.jinja2",
     """            if (luaL_dostring(sm->L, library[_chunk]) != 0) {
                return script_session_failed(sm, SCE_SCRIPT_SESSION_STAGE_LIBRARY);
            }""",
     """            (void)luaL_dostring(sm->L, library[_chunk]);""")
PY

# ── A bind that failed is passed over ───────────────────────────────
#
# The binder answers that it bound what it did not, as the old shape's printed
# line and carried-on start did.
# Killer: `a_start_whose_session_cannot_be_established_is_refused_with_the_step`,
# whose `system-variables` round starts.

mutation_case "a failed bind of the system variables is passed over" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     """       out loud, rather than leaving it to a nil read later. */
    return lua_pcall(L, 2, 0, 0) == LUA_OK;""",
     """       out loud, rather than leaving it to a nil read later. */
    if (lua_pcall(L, 2, 0, 0) != LUA_OK) {
        lua_pop(L, 1);
    }
    return true;""")
PY

# ── The state of a failed session is kept ───────────────────────────
#
# The failure is recorded and the Lua state the steps made is left open, so a
# refused machine holds a session nothing established.
# Killer: `expect_nothing_started`, which finds `sm->L` set and the state's
# memory still held.

mutation_case "the state of a session that failed is not closed" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     """                                   said != NULL ? said : "the engine gave no message");
    lua_close(sm->L);
    sm->L = NULL;
    return false;""",
     """                                   said != NULL ? said : "the engine gave no message");
    return false;""")
PY

# ── The resumed start is stood in its configuration anyway ──────────
#
# `_init_at` reads the construction's refusal and stands the machine in the
# configuration it was handed, over no session.
# Killer: `a_resumed_start_whose_session_cannot_be_established_is_refused`,
# which finds `_CONFIG_NONE`.

mutation_case "the resumed start stands in its configuration past a session that failed" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     """    if (refused == SCE_START_REFUSAL_SCRIPT_SESSION_UNAVAILABLE) {
        return {{ csym_prefix | upper }}{{ model.name | upper }}_CONFIG_SCRIPT_SESSION_UNAVAILABLE;
    }""",
     """""")
PY

# ── The refused child is kept ──────────────────────────────────────
#
# The parent marks the child whose start was refused as running and goes on as
# if it had started.
# Killer: `a_child_whose_session_fails_leaves_its_parent_with_error_execution_and_no_child`,
# which finds `child_chatty_active` set.

mutation_case "the child whose start was refused is kept" <<'PY'
edit("tools/codegen/templates/c/invoke_methods.jinja2",
     """                    break;
                }
{% endif %}
                continue;
            }
{% endmacro %}""",
     """                    break;
                }
{% endif %}
            }
{% endmacro %}""")
PY

# ── The refused child raises nothing ───────────────────────────────
#
# The invoke ends without a child and without telling the document.
# Killer: `a_child_whose_session_fails_leaves_its_parent_with_error_execution_and_no_child`,
# whose `_unhandled_error_events` finds no error.execution.

mutation_case "the child whose start was refused raises no error.execution" <<'PY'
edit("tools/codegen/templates/c/invoke_methods.jinja2",
     """            if (_child_started != {{ csym_prefix | upper }}{{ stem | upper }}_START_OK) {
{% if 'error.execution' in model.events %}""",
     """            if (_child_started != {{ csym_prefix | upper }}{{ stem | upper }}_START_OK) {
{% if false %}""")
PY
