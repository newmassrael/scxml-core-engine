# Mutation cases for "a byte case states the value as its interface presents it".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_byte_case_states_the_value_as_its_interface_presents_it.cases`.
#
# A positional codec's byte case states its value as the codec's interface
# presents it, its `source` (docs/adr/0081 §5). The conformance generator folds
# each `source` into the Rust harness as a literal of the codec's ready-made
# source, `{Codec}Parts`, and into the C++ harness as the printed value its
# constructor makes; each harness encodes it and compares the bytes an
# independent model wrote. The unit tests render each harness and find the
# literals there, and find none in a backend that does not print the plan. A
# refused case is folded the same way and held to the refusal its encode
# answers, by the name each runtime gives it; a refusal the encode never
# answers is refused by name. A value of an imported enum is spelled as the
# variant it holds, a flag input the value does not say is handed to the
# encode as to the decode, and a number the value states while its content is
# absent is a `std::optional` of C++ as it is an `Option` of Rust.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --lib conformance::
mutation_targets sce-build/src/conformance.rs sce-build/src/forge/generator/rust_source.rs sce-build/src/forge/generator/cpp_source/source_case.rs
mutation_oracles sce-build/src/conformance.rs

mutation_case "the byte cases reach the wrong backend" <<'PY'
edit("sce-build/src/conformance.rs",
     r'''            Language::Rust => Some(CasePrinter::Rust),''',
     r'''            Language::Rust => Some(CasePrinter::Cpp),''')
PY

mutation_case "a refused case states a refusal its encode never answers" <<'PY'
edit("sce-build/src/conformance.rs",
     r'''                r.kind == failure.refusal_kind()''',
     r'''                r.kind == failure.refusal_kind() || r.kind != failure.refusal_kind()''')
PY

mutation_case "a refused case is held to another runtime's name of its refusal" <<'PY'
edit("sce-build/src/conformance.rs",
     r'''            let symbol = failure.symbol(printer.language()).ok_or_else(|| {''',
     r'''            let symbol = failure.symbol(Language::Rust).ok_or_else(|| {''')
PY

mutation_case "an integer of a source is spelled as another" <<'PY'
edit("sce-build/src/forge/generator/rust_source.rs",
     r'''    json.as_u64()
        .map(i128::from)
        .or_else(|| json.as_i64().map(i128::from))''',
     r'''    json.as_u64()
        .map(|n| i128::from(n ^ 1))
        .or_else(|| json.as_i64().map(i128::from))''')
PY

mutation_case "a gated element that is there is spelled absent" <<'PY'
edit("sce-build/src/forge/generator/rust_source.rs",
     r'''                format!("Some({one})")''',
     r'''                {
                    let _ = one;
                    "None".to_string()
                }''')
PY

mutation_case "a C++ number is spelled as a literal of a signed type" <<'PY'
edit("sce-build/src/forge/generator/cpp_source/source_case.rs",
     r'''        format!("{n}u")''',
     r'''        format!("{n}")''')
PY

mutation_case "a C++ variant holds its arm at another alternative" <<'PY'
edit("sce-build/src/forge/generator/cpp_source/source_case.rs",
     r'''        "{namespace}::{type_name}Variant{{std::in_place_index<{}>, {alternative}}}",
        arm.index''',
     r'''        "{namespace}::{type_name}Variant{{std::in_place_index<{}>, {alternative}}}",
        arm.index + 1''')
PY

mutation_case "an input the value does not say is not handed to the Rust encode" <<'PY'
edit("sce-build/src/forge/generator/rust_source.rs",
     r'''            given.push(value.to_string());
            continue;''',
     r'''            continue;''')
PY

mutation_case "a C++ enum is named from the namespace the harness is in" <<'PY'
edit("sce-build/src/forge/generator/cpp_source/source_case.rs",
     r'''                &format!("::{ty}"),''',
     r'''                &ty,''')
PY

mutation_case "a C++ number the value states is held as always there" <<'PY'
edit("sce-build/src/forge/generator/cpp_source/source_case.rs",
     r'''                let optional = element.presence.optional();''',
     r'''                let optional = matches!(
                    element.presence,
                    crate::forge::encode_plan::Presence::Gated
                );''')
PY
