# Mutation cases for "a form holds what its deployment says".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_form_holds_what_its_deployment_says.cases`.
#
# A field's bound is the language and its capacity is the deployment's
# (docs/adr/0077 §7). The first case drops the capacity, so the eager decode
# holds the bound and reads a frame the deployment cannot store; the second has
# a full list say the frame is malformed; the third has a decode stop at the
# first field past its capacity, before the frame is read whole; the fourth
# admits a capacity past the bound; the fifth has a C11 list past its capacity
# say the frame is malformed.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test forge_conformance
mutation_targets sce-build/src/forge/model.rs sce-build/src/forge/generator.rs sce-build/src/lib.rs sce-build/src/forge/deployment.rs tools/codegen/templates/_macros/forge_rust_storage.jinja2 backends/rust/forge-runtime/src/capped.rs
mutation_runtime_targets tools/codegen/templates/forge/rust/codec.rs.jinja2 backends/rust/forge-runtime/src/storage.rs backends/rust/forge-runtime/src/codec.rs
mutation_oracles sce-build/tests/forge_conformance.rs

mutation_case "a list holds its bound whatever the deployment says" <<'PY'
edit("sce-build/src/forge/model.rs",
     r'''        self.capacity
            .or_else(|| self.bound(fields).and_then(|b| u32::try_from(b).ok()))''',
     r'''        self.bound(fields).and_then(|b| u32::try_from(b).ok())''')
PY

mutation_case "a full list says its frame is malformed" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''        "if {RUST_LIST_FULL} {{\n{indent}    return Err(CodecError::CapacityExceeded);\n{indent}}}\n{indent}Ok(())"''',
     r'''        "if {RUST_LIST_FULL} {{\n{indent}    return Err(CodecError::TooManyElements);\n{indent}}}\n{indent}Ok(())"''')
PY

mutation_case "a frame is called too big to hold before it is judged whole" <<'PY'
edit("backends/rust/forge-runtime/src/codec.rs",
     r'''    match result {
        Err(CodecError::CapacityExceeded) => {
            *over = true;
            Ok(())
        }
        other => other,
    }''',
     r'''    match result {
        Err(CodecError::CapacityExceeded) => {
            *over = true;
            Err(CodecError::CapacityExceeded)
        }
        other => other,
    }''')
PY

mutation_case "a capacity past the bound is taken" <<'PY'
edit("sce-build/src/forge/model.rs",
     r'''            if let Some(bound) = bound.filter(|bound| u64::from(*capacity) > *bound) {''',
     r'''            if let Some(bound) = bound.filter(|bound| u64::from(*capacity) > *bound + 1) {''')
PY

# Killed by `c11_holds_a_field_in_an_array_of_its_capacity` (a third entry past
# two held is CAPACITY_EXCEEDED, not too many).
mutation_case "a C11 list past its capacity is called too many" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''if (_i >= {capacity}U) _over = true;''',
     r'''if (_i >= {capacity}U) return SCE_FORGE_CODEC_TOO_MANY_ELEMENTS;''')
PY

# A heap node holds a list with no limit, so a frame past its policy is held.
# Killed by `a_heap_node_holds_a_field_to_its_policy_limit` (the needle
# `CappedVec<T, 2>` and a third entry past two).
mutation_case "a heap node's list grows past its policy limit" <<'PY'
edit("tools/codegen/templates/_macros/forge_rust_storage.jinja2",
     r'''    type List<T> = {{ runtime }}::CappedVec<T, {{ field.capacity }}> where''',
     r'''    type List<T> = {{ runtime }}::GrowVec<T> where''')
PY

# A capped text takes a view past its limit. Killed by
# `a_heap_node_holds_a_field_to_its_policy_limit` (a description of nine bytes
# past eight).
mutation_case "a capped text holds a view past its limit" <<'PY'
edit("backends/rust/forge-runtime/src/capped.rs",
     r'''    fn from_view(s: &str) -> Result<Self, CodecError> {
        if s.len() > N {''',
     r'''    fn from_view(s: &str) -> Result<Self, CodecError> {
        if s.len() > usize::MAX - 1 {''')
PY

# A heap node is refused for a field with no bound and no limit, as an inline
# node is. Killed by `a_heap_node_holds_a_field_to_its_policy_limit`.
mutation_case "a heap node is held to an inline node's refusal" <<'PY'
edit("sce-build/src/forge/deployment.rs",
     r'''        let unheld = (deployment.storage == NodeStorage::Inline)''',
     r'''        let unheld = (deployment.storage == NodeStorage::Inline || true)''')
PY
