# Mutation cases for "a deployment answers from a file of its own".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_deployment_answers_from_a_file_of_its_own.cases`.
#
# A Rust tree takes a storage profile and holds no capacity, and a deployment is
# a type generated into a file of its own (docs/adr/0077 §7): it copies, and it
# answers for every field of every codec its set holds or imports, at the
# capacity its deploy input gives it or at the bound, under the gate the build
# compiles the codec under. A defect here is a tree that holds one deployment's
# capacity for the whole build, or a deployment that compiles and holds the
# bound where it was given a capacity, or does not compile where it should.
#
# The oracle is `sce-build/tests/forge_conformance.rs`: the tree compared with and
# without a deployment, a deployment's decode run on the frames of its capacity,
# a set that holds and imports codecs of every kind compiled on a deployment with
# no allocator, the gated text, and the refusals.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test forge_conformance
mutation_targets sce-build/src/generator.rs sce-build/src/forge/deployment.rs tools/codegen/templates/forge/rust/deployment.rs.jinja2
mutation_oracles sce-build/tests/forge_conformance.rs

# A Rust tree sized by the deployment holds its capacity for every profile of the
# build. Killed by `a_rust_tree_is_the_same_tree_whatever_a_deployment_holds`.
mutation_case "a Rust tree takes the deployment's capacities" <<'PY'
edit("sce-build/src/generator.rs",
     r'''        matches!(self, Language::C11)''',
     r'''        matches!(self, Language::C11 | Language::Rust)''')
PY

# A deployment that does not copy cannot store a byte string of a frame. Killed by
# `a_deployment_answers_for_every_field_of_its_set` (`copied` does not compile).
mutation_case "the deployment does not copy" <<'PY'
edit("tools/codegen/templates/forge/rust/deployment.rs.jinja2",
     r'''impl ::sce_forge_runtime::codec::Copying for {{ deployment }} {}''',
     r'''''')
PY

# A deployment that checks its capacities and takes none holds each field at its
# bound. Killed by `a_form_that_stores_refuses_past_its_capacity_and_a_view_reads_on`
# and by `a_deployment_answers_for_every_field_of_its_set` (`InlineBytes<64>`).
mutation_case "a deployment holds the bound where it is given a capacity" <<'PY'
edit("sce-build/src/forge/deployment.rs",
     r'''            .take_capacities(&deployment.capacities)''',
     r'''            .check_capacities(&deployment.capacities)''')
PY

# A codec a document of the set imports is a module of the tree as well, and a
# codec that holds it asks the deployment for its fields. Killed by
# `a_deployment_answers_for_every_field_of_its_set` (`CodecZenohMsgPutPayloadField`).
mutation_case "a codec reached by import is not answered for" <<'PY'
edit("sce-build/src/forge/deployment.rs",
     r'''        for import in imports.iter().filter(|i| i.kind == ForgeKind::Codec) {''',
     r'''        for import in imports.iter().filter(|_| false) {''')
PY

# A gated codec answered for outside its gate names a module the build leaves out.
# Killed by `a_deployment_answers_a_gated_codec_under_its_gate`.
mutation_case "a gated codec is answered for outside its gate" <<'PY'
edit("tools/codegen/templates/forge/rust/deployment.rs.jinja2",
     r'''{% if codec.cfg %}
{{ codec.cfg }}
{% endif %}''',
     r'''''')
PY

# A gate for a codec the set does not hold is a misspelling that leaves the codec
# it meant ungated. Killed by `a_deployment_that_names_what_its_set_has_not_is_refused`.
mutation_case "a gate for no codec of the set is taken" <<'PY'
edit("sce-build/src/forge/deployment.rs",
     r'''        .find(|codec| !members.contains_key(*codec))''',
     r'''        .find(|codec| codec.is_empty() && !members.contains_key(*codec))''')
PY

# A capacity for a codec no document of the set is would leave the codec it meant
# at its bound. Killed by `a_deployment_that_names_what_its_set_has_not_is_refused`.
mutation_case "a capacity for no codec of the set is taken" <<'PY'
edit("sce-build/src/forge/deployment.rs",
     r'''        .find(|(codec, _)| !members.contains_key(*codec))''',
     r'''        .find(|(codec, _)| codec.is_empty() && !members.contains_key(*codec))''')
PY

# The file names a codec's tags as the tree's modules name one another. Named from
# the crate root, it compiles only where the tree is the crate root. Killed by
# `a_deployment_answers_for_every_field_of_its_set` (`super::codec_zenoh_msg_put::`).
mutation_case "the file names the tree from the crate root" <<'PY'
edit("sce-build/src/forge/deployment.rs",
     r'''            "module": format!("super::{}", filters::to_snake_case(name.clone())),''',
     r'''            "module": format!("crate::{}", filters::to_snake_case(name.clone())),''')
PY
