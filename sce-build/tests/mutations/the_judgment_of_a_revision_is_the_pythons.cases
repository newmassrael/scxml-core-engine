mutation_case "of_list: a pair that is not objects is adopted" <<'PY'
edit("sce-revision/src/lib.rs",
     "    if !manifest.is_object() || !sidecar.is_object() {",
     "    if false && (!manifest.is_object() || !sidecar.is_object()) {")
PY

mutation_case "normalise: words are not collapsed before they are digested" <<'PY'
edit("sce-revision/src/lib.rs",
     "    text.split_whitespace().collect::<Vec<_>>().join(\" \")",
     "    text.trim().to_string()")
PY

mutation_case "delta_object: a line of another kind is gathered as a requirement" <<'PY'
edit("sce-revision/src/join.rs",
     "        .filter(|line| line[\"kind\"] == \"acceptance-delta\")",
     "        .filter(|line| line[\"kind\"] != \"acceptance-delta-summary\")")
PY
