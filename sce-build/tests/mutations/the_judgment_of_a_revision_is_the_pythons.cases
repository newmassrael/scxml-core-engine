# Mutation cases for "the judgment of a revision is the Python's".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/the_judgment_of_a_revision_is_the_pythons.cases`.
#
# `sce-revision` judges a requirement lineage: that it is one, that it continues the one a work
# holds, that it is the lineage of the list beside it, and what became of the words between two
# states. It is held to the Python reference by the shared cases, sentence by sentence. Each
# case below switches off ONE rule of one of those judgments and must make a test of
# `sce-revision/tests/the_cases_the_python_gives.rs` red: a rule no case reaches would let a
# port be wrong in a way nobody sees.
#
# ⚠ A mutated tree is built under `-D warnings`, so every case keeps each binding it had in
# use: a mutation that stops reading one is an unused-variable ERROR, the tree does not
# compile, and the verdict is INCONCLUSIVE.
#
# Anchors are literal slices of the source; an edit that moves one is reported INCONCLUSIVE with
# the anchor quoted, never as a pass.

mutation_tests -p sce-revision --test the_cases_the_python_gives
mutation_targets sce-revision/src/lib.rs sce-revision/src/revision.rs sce-revision/src/join.rs
mutation_oracles sce-revision/tests/the_cases_the_python_gives.rs

mutation_case "extends: a lineage of another specification continues" <<'PY'
edit("sce-revision/src/lib.rs",
     "    if previous[\"doc_id\"] != following[\"doc_id\"] {",
     "    if false && previous[\"doc_id\"] != following[\"doc_id\"] {")
PY

mutation_case "extends: a next that is behind continues" <<'PY'
edit("sce-revision/src/lib.rs",
     "    if following_next < previous_next {",
     "    if false && following_next < previous_next {")
PY

mutation_case "extends: a revision may be rewritten" <<'PY'
edit("sce-revision/src/lib.rs",
     "        if !kept_as_it_was {",
     "        if false && !kept_as_it_was {")
PY

mutation_case "extends: the sidecar digest of the last revision is not allowed to move when the text is read again" <<'PY'
edit("sce-revision/src/lib.rs",
     "            .filter(|(key, _)| !(same_text_again && LIST_DIGESTS.contains(&key.as_str())))",
     "            .filter(|(key, _)| !(same_text_again && key.as_str() == \"manifest_sha256\"))")
PY

mutation_case "extends: an id may be issued in another revision than it was" <<'PY'
edit("sce-revision/src/lib.rs",
     "        if now[\"first_rev\"] != row[\"first_rev\"] {",
     "        if false && now[\"first_rev\"] != row[\"first_rev\"] {")
PY

mutation_case "extends: a retired id may live again" <<'PY'
edit("sce-revision/src/lib.rs",
     "        if !row[\"retired_rev\"].is_null() && now[\"retired_rev\"] != row[\"retired_rev\"] {",
     "        if false && !row[\"retired_rev\"].is_null() && now[\"retired_rev\"] != row[\"retired_rev\"] {")
PY

mutation_case "extends: a requirement's history may be rewritten" <<'PY'
edit("sce-revision/src/lib.rs",
     "        if new.len() < old.len() || old[..old.len() - 1] != new[..old.len() - 1] {",
     "        if new.len() < old.len() {")
PY

mutation_case "extends: the last words may be replaced in any revision" <<'PY'
edit("sce-revision/src/lib.rs",
     "        if edge != edge_now && !(edge[\"rev\"] == edge_now[\"rev\"] && edge[\"rev\"] == *last_rev) {",
     "        if false && edge != edge_now && !(edge[\"rev\"] == edge_now[\"rev\"] && edge[\"rev\"] == *last_rev) {")
PY

mutation_case "extends: an id may be numbered below the work's next" <<'PY'
edit("sce-revision/src/lib.rs",
     "            Some(number) => i128::try_from(number).map_or(true, |number| number >= previous_next),",
     "            Some(number) => i128::try_from(number).map_or(true, |number| number >= 0),")
PY

mutation_case "belongs_to_list: the sidecar's digest is not compared" <<'PY'
edit("sce-revision/src/lib.rs",
     "    if sidecar_digest != sha256_text(sidecar_text) {",
     "    if false && sidecar_digest != sha256_text(sidecar_text) {")
PY

mutation_case "belongs_to_list: the manifest's digest is not compared" <<'PY'
edit("sce-revision/src/lib.rs",
     "    if manifest_digest != sha256_text(manifest_text) {",
     "    if false && manifest_digest != sha256_text(manifest_text) {")
PY

mutation_case "parse: an id issued twice is a lineage" <<'PY'
edit("sce-revision/src/lib.rs",
     "        if !ids.insert(id) {",
     "        if false && !ids.insert(id) {")
PY

mutation_case "between: words that changed are carried" <<'PY'
edit("sce-revision/src/lib.rs",
     "                if last_quote(was)[\"sha256\"] == last_quote(row)[\"sha256\"] {",
     "                if true || last_quote(was)[\"sha256\"] == last_quote(row)[\"sha256\"] {")
PY

mutation_case "belongs_to: a delta of another specification belongs" <<'PY'
edit("sce-revision/src/revision.rs",
     "    if doc_id != pinned_doc {",
     "    if false && doc_id != pinned_doc {")
PY

mutation_case "belongs_to: a delta of another step belongs" <<'PY'
edit("sce-revision/src/revision.rs",
     "    if from_rev != pinned_rev {",
     "    if false && from_rev != pinned_rev {")
PY

mutation_case "belongs_to: a delta of another list of the same name and revision belongs" <<'PY'
edit("sce-revision/src/revision.rs",
     "    if from_manifest != pinned_manifest {",
     "    if false && from_manifest != pinned_manifest {")
PY

mutation_case "belongs_to: a delta of the same shape over other words belongs" <<'PY'
edit("sce-revision/src/revision.rs",
     "    if from_sidecar != pinned_sidecar {",
     "    if false && from_sidecar != pinned_sidecar {")
PY

mutation_case "belongs_to: a record taken without the words is not told so" <<'PY'
edit("sce-revision/src/revision.rs",
     "    if !manifest[\"sidecar_sha256\"].is_string() {",
     "    if false && !manifest[\"sidecar_sha256\"].is_string() {")
PY

mutation_case "join: a carried requirement whose evidence moved is not a violation" <<'PY'
edit("sce-revision/src/join.rs",
     "        (\"carried\", Some(\"changed\" | \"dropped\")) => (\"moved-without-reason\", VIOLATION),",
     "        (\"carried\", Some(\"changed\" | \"dropped\")) => (\"moved-without-reason\", OK),")
PY

mutation_case "join: a retired requirement the design still cites is not a violation" <<'PY'
edit("sce-revision/src/join.rs",
     "        (\"retired\", Some(\"unchanged\" | \"changed\" | \"new\")) => (\"retired-still-cited\", VIOLATION),",
     "        (\"retired\", Some(\"unchanged\" | \"changed\" | \"new\")) => (\"retired-still-cited\", LOOK),")
PY

mutation_case "join: a requirement no node cites is carried over" <<'PY'
edit("sce-revision/src/join.rs",
     "        (\"carried\", None) => (\"uncited\", UNCOVERED),",
     "        (\"carried\", None) => (\"carries-over\", OK),")
PY

mutation_case "join: a carried neighbour explains a move" <<'PY'
edit("sce-revision/src/join.rs",
     "        if matches!(words, \"changed\" | \"new\") && matches!(evidence, \"changed\" | \"new\") {",
     "        if { let _ = words; true } && matches!(evidence, \"changed\" | \"new\") {")
PY

mutation_case "join: more rows gone than places moved is explained all the same" <<'PY'
edit("sce-revision/src/join.rs",
     "        if places.is_empty() || gone > places.len() as i64 {",
     "        if places.is_empty() || { let _ = gone; false } {")
PY

mutation_case "join: a move is explained when only one of its places is the neighbour's" <<'PY'
edit("sce-revision/src/join.rs",
     "        if places.iter().all(|place| covered.contains(place)) {",
     "        if places.iter().any(|place| covered.contains(place)) {")
PY

mutation_case "render: a check that saw nothing does not say so" <<'PY'
edit("sce-revision/src/join.rs",
     "    if requirements != 0 && summary[\"seen\"].as_i64().unwrap_or(0) == 0 {",
     "    if false && requirements != 0 && summary[\"seen\"].as_i64().unwrap_or(0) == 0 {")
PY

mutation_case "adopt: a manifest that carries the source's own ids is adopted" <<'PY'
edit("sce-revision/src/lib.rs",
     "    if manifest[\"extraction\"][\"ids\"] != \"synthesized\" || !manifest[\"extraction\"].is_object() {",
     "    if false && manifest[\"extraction\"][\"ids\"] != \"synthesized\" {")
PY

mutation_case "adopt: a revision that is not a whole number is adopted" <<'PY'
edit("sce-revision/src/lib.rs",
     "    if !whole {",
     "    if false && !whole {")
PY

mutation_case "adopt: a manifest that lists no requirements is adopted" <<'PY'
edit("sce-revision/src/lib.rs",
     "    if rows.is_empty() {",
     "    if false && rows.is_empty() {")
