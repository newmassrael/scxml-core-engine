# Mutation cases for "a C11 queue deeper than 255 holds each event at its own
# index".
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_c11_queue_counts_its_depth_in_16_bits.cases
#
# docs/adr/0086, section 8.5 (c): a document declares its queues' depth with
# `sce:capacity`, up to 65535, so the ring's tail, head and count are 16 bits.
# Each case narrows one of them to 8 bits again, which a depth of 255 or less
# never shows: the tail wraps at 256 and overwrites the first entries, the head
# wraps at 256 and the run leaves it off zero, the count wraps and the queue
# takes an event past its depth.
#
# The machine is generated by `sce-codegen`, which the test runs as a
# subprocess, and compiled and run by the test, so the evidence a mutation
# reached what ran is the template differing on disk while the test ran.

mutation_tests -p sce-build --features cli --test a_c11_machine_sizes_its_event_data_slot a_c11_queue_deeper_than_255_holds_each_event_at_its_own_index
mutation_targets sce-build/tests/a_c11_machine_sizes_its_event_data_slot.rs
mutation_runtime_targets tools/codegen/templates/c/state_machine.c.jinja2

mutation_case "the tail of a queue without a script engine is counted in 8 bits" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "        return;\n    }\n    q->tail = (uint16_t)((q->tail + 1u)",
     "        return;\n    }\n    q->tail = (uint8_t)((q->tail + 1u)")
PY

mutation_case "the head of a queue is counted in 8 bits" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "    q->head = (uint16_t)((q->head + 1u)",
     "    q->head = (uint8_t)((q->head + 1u)")
PY

mutation_case "the count of a queue without a script engine is counted in 8 bits" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "    q->count = (uint16_t)(q->count + 1u);\n}\n{% endif %}",
     "    q->count = (uint8_t)(q->count + 1u);\n}\n{% endif %}")
PY
