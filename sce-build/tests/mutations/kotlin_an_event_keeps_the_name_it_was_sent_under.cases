# Mutation cases for "an event keeps the name it was sent under" (Kotlin engine).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/kotlin_an_event_keeps_the_name_it_was_sent_under.cases`.
#
# A transition on `request` takes `request.new` by whole-token matching
# (§scxml-3.12.1), and `_event.name` is then the name the event was sent under
# (§scxml-5.10), not the descriptor it was matched through. The engine carries the
# event as the member of a name the document writes, so the whole name has to
# travel beside it: `arrivalNameOf` decides what it is, every by-name door records
# it in `EventMetadata.name`, and the generated `_event` binding reads it before
# the member's name. A parent's `<send>` to its child reaches the child through
# `sendByNameWithData`, the one by-name door of the type-erased path, which
# `handToChild` calls for a send with a payload and for one without alike.
# `integration_resources/an_event_keeps_the_name_it_was_sent_under/` is the
# document: the parent writes `request.new`, the child only `request`, and the
# child reports `arrivedShortened` unless it is told the whole name.
#
# Three things are easy to get wrong and read as success: a door that resolves
# the name and forgets to carry it (the event is delivered, the transition is
# taken, the child is told the shorter name), a payload-less send that goes
# round the shared door and drops the name there, and a binding that reads the
# member's name first (the carried name is there and unused). Each leaves the
# machine reaching its final state, so only `_event.name` itself tells them
# apart.
#
# The fixture's `<send target="#_listener" event="request.new"/>` carries no
# payload. While `sendByName` was a second copy of the door, the door case below
# mutated `sendByNameWithData`, which that send never entered, and SURVIVED
# (scheduled round 40125467304): the mutant was unobservable, not unguarded by
# a weak test. With one door the case runs on the fixture's path. The copy is
# gone (docs/adr/0090 gave the door the origin and the sender to carry, and a
# second door would have had to carry them too), so the third case asks the
# door itself to drop the name of a payload-less send, which is the fixture's.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_gradle . :sce-kotlin-tests:test --tests 'com.sce.integration.AnEventKeepsTheNameItWasSentUnderTest'
mutation_oracles backends/kotlin/tests/src/test/kotlin/com/sce/integration/AnEventKeepsTheNameItWasSentUnderTest.kt
mutation_targets backends/kotlin/runtime/src/commonMain/kotlin/com/sce/runtime/StateMachineEngine.kt backends/kotlin/tests/src/main/kotlin/com/sce/integration/an_event_keeps_the_name_it_was_sent_under/an_event_keeps_the_name_it_was_sent_under__sce_synth_invoke__listenerSm.kt

mutation_case "no name is ever recorded as the one an event arrived under" <<'PY'
edit("backends/kotlin/runtime/src/commonMain/kotlin/com/sce/runtime/StateMachineEngine.kt",
     "        if (resolveEventByName(name) == event) \"\" else name",
     "        if (resolveEventByName(name) == event || name.isNotEmpty()) \"\" else name")
PY

mutation_case "a by-name door delivers the event without its arrival name" <<'PY'
edit("backends/kotlin/runtime/src/commonMain/kotlin/com/sce/runtime/StateMachineEngine.kt",
     "origin = origin, sender = sender, name = arrivalNameOf(it, name)))",
     "origin = origin, sender = sender))")
PY

mutation_case "a payload-less send drops its arrival name at the door" <<'PY'
edit("backends/kotlin/runtime/src/commonMain/kotlin/com/sce/runtime/StateMachineEngine.kt",
     "origin = origin, sender = sender, name = arrivalNameOf(it, name)))",
     "origin = origin, sender = sender, name = if (data.isEmpty()) \"\" else arrivalNameOf(it, name)))")
PY

mutation_case "the generated binding reads the member's name before the arrival name" <<'PY'
edit("backends/kotlin/tests/src/main/kotlin/com/sce/integration/an_event_keeps_the_name_it_was_sent_under/an_event_keeps_the_name_it_was_sent_under__sce_synth_invoke__listenerSm.kt",
     "        val eventName = meta.name.ifEmpty { eventNameOf(event) ?: return }",
     "        val eventName = eventNameOf(event) ?: return")
PY
