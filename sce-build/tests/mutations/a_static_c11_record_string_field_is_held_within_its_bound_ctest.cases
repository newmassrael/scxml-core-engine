# Mutation cases for "a record's string field is held within the `sce:max-size` its
# schema declares" under the C11 backend
# (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A record's string field"; docs/adr/0005,
# decision 1).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_c11_record_string_field_is_held_within_its_bound_ctest.cases`.
#
# A C11 record holds the field in a buffer of the bound, as a string variable does:
# `static_record_string` writes it from a literal, from a string variable and from a
# typed payload, a field at a time and the payload whole, and expects a value past
# eight UTF-8 bytes to leave the record as it was and `errors` to count it. A C
# machine is not saved, so there is no restore to refuse here. The mutants take one
# decision away each:
#
#   a record's string field is not among the strings an `<assign>` is held to;
#   a string is copied into the field without its terminator, so a shorter text
#     leaves the tail of the longer one it replaced.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^c11_integration_static_scalars$'
mutation_targets sce-build/src/forge/static_lowering.rs
mutation_oracles backends/c/tests/integration/test_static_scalars.c sce-build/tests/fixtures/static_datamodel/scenarios/static_record_string.json

mutation_case "a record's string field is not held to its bound by an assignment" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "        .chain(record_field_bounds(variables, &records, |ty| {\n            matches!(ty, SceType::String)\n        }))",
     "        .chain(record_field_bounds(variables, &records, |_| false))")
PY

mutation_case "a string is copied into the field without its terminator" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "        self.assign_string(&format!(\"{target}.{field}.data\"), value)",
     "        format!(\"memmove({target}.{field}.data, {value}, strlen({value}));\")")
PY
