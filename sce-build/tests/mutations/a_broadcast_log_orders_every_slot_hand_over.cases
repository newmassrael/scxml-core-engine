# Mutation cases for "a broadcast log orders every slot hand-over".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_broadcast_log_orders_every_slot_hand_over.cases`.
#
# The bounded broadcast log of ADR 0062 hands each entry from the one publisher
# to any number of readers through a sequence-lock: a stamp that carries the
# entry's sequence number, relaxed atomic words between two fences, and a head
# index. Every order in `publish` and `read` is a decision the protocol needs, and
# the TLA+ model (`docs/formal/BroadcastLog.tla`) cannot check them, because it is
# sequentially consistent. The oracle is the loom models in
# `backends/rust/forge-runtime/tests/loom_broadcast_log.rs`, which explore every
# interleaving and every outcome the memory model allows, so a weakened order is
# not something they might sample but something they must reach.
#
# Two of the cases are not hypothetical: the first version of the log stored the
# `busy` stamp relaxed and loaded the second stamp relaxed, and each was found by
# the model `two_readers_each_hold_their_own_cursor` as a lag that skipped nothing.
# The sequentially consistent model had passed both.
#
# The models build only under `--cfg loom`. The selector passes it as a cargo
# `--config` rather than through RUSTFLAGS, so the casefile carries the whole
# command, and gives the build a target directory of its own so that the cfg does
# not invalidate the ordinary build's.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-forge-runtime --release --target-dir target/loom --config 'build.rustflags=["--cfg","loom"]' --test loom_broadcast_log
mutation_targets backends/rust/forge-runtime/src/broadcast_log.rs
mutation_oracles backends/rust/forge-runtime/tests/loom_broadcast_log.rs

# ── The publisher's four orders ────────────────────────────────────

# A reader that sees this stamp and reloads `head` must find the head the previous
# publish stored.
mutation_case "the publisher stores the busy stamp without releasing the head before it" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''slot.stamp.store(busy(n), Ordering::Release);''',
     r'''slot.stamp.store(busy(n), Ordering::Relaxed);''')
PY

# Without the fence the busy stamp may reach a reader after the words it guards, and
# a copy that mixes two entries then validates.
mutation_case "the publisher writes the words without a release fence after the busy stamp" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''        fence(Ordering::Release);''',
     r'''        /* no release fence */''')
PY

mutation_case "the publisher stores the done stamp without releasing the words" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''slot.stamp.store(done(n), Ordering::Release);''',
     r'''slot.stamp.store(done(n), Ordering::Relaxed);''')
PY

mutation_case "the publisher moves the head without releasing the slot" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''self.log.head.0.store(n + 1, Ordering::Release);''',
     r'''self.log.head.0.store(n + 1, Ordering::Relaxed);''')
PY

# ── The reader's five orders ───────────────────────────────────────

mutation_case "a reader loads the head without acquiring the slot behind it" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''        let h = self.head.0.load(Ordering::Acquire);
        debug_assert!(r <= h, "a reader's cursor never passes the head");''',
     r'''        let h = self.head.0.load(Ordering::Relaxed);
        debug_assert!(r <= h, "a reader's cursor never passes the head");''')
PY

mutation_case "a reader loads the first stamp without acquiring" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''let first = slot.stamp.load(Ordering::Acquire);''',
     r'''let first = slot.stamp.load(Ordering::Relaxed);''')
PY

mutation_case "a reader copies the words without an acquire fence before the second stamp" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''            fence(Ordering::Acquire);''',
     r'''            /* no acquire fence */''')
PY

# The load that decides whether the copy was overwritten is also the one a lap
# is read from; a fence orders only the reads before it.
mutation_case "a reader loads the second stamp without acquiring" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''if slot.stamp.load(Ordering::Acquire) == first {''',
     r'''if slot.stamp.load(Ordering::Relaxed) == first {''')
PY

mutation_case "a lagging reader reloads the head without acquiring" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''        // published through `r + RETENTION` and `head` shows it.
        let h = self.head.0.load(Ordering::Acquire);''',
     r'''        // published through `r + RETENTION` and `head` shows it.
        let h = self.head.0.load(Ordering::Relaxed);''')
PY

# ── What the stamp and the window mean ─────────────────────────────

# A stamp compared as a flag cannot tell the entry the reader wants from the one a
# later lap wrote into the same slot.
mutation_case "a reader accepts any written stamp instead of the sequence it wants" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''        if first == done(r) {''',
     r'''        if first != 0 {''')
PY

# `RETENTION + 1` slots mean an entry `SLOTS` behind the head is outside the
# window; one more slot's worth is read as retained while it is being overwritten.
mutation_case "a reader reads an entry a whole ring behind the head as retained" <<'PY'
edit("backends/rust/forge-runtime/src/broadcast_log.rs",
     r'''        if h - r >= SLOTS as u64 {''',
     r'''        if h - r > SLOTS as u64 {''')
PY
