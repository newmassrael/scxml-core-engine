# Mutation cases for "a flag input the value says is written as it says it".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_flag_input_the_value_says_is_written_as_it_says_it.cases`.
#
# A Rust codec reads a flag input its value says off the value, a parent
# derives the flag it binds to the input from the body, and a value handed from
# elsewhere (a flag bound to every entry of a chain) is held to the input each
# entry says before the first byte (docs/adr/0065 §6 R4a). The conformance
# crate generates its codecs from the documents when it builds, so each case
# reaches the codecs the `said_inputs` tests encode with: an input read with
# the wrong polarity, a bound flag left as the value presents it, and an entry
# no longer held to the flag its chain hands it.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-forge-conformance --features alloc --test forge_source_round_trip
mutation_targets sce-build/src/forge/generator/rust_source.rs
mutation_oracles backends/rust/forge-conformance/tests/forge_source_round_trip.rs

mutation_case "an input is read with the wrong polarity" <<'PY'
edit("sce-build/src/forge/generator/rust_source.rs",
     r'''                if *when_clear {
                    format!("!{present}")''',
     r'''                if !*when_clear {
                    format!("!{present}")''')
PY

# That an arm's input is read under the arm's own name for it has no case: each
# codec's `input_{i}` is named after its own input, so reading it under the
# parent's name either reads the same function (the name is the same) or names
# a function the arm's codec does not have, and the build refuses it (E0599).
# A round reported the case INCONCLUSIVE for that reason (run 41415818510).

# A value that says nothing of an input disagrees with nothing (§6 R4e). Refused
# instead, every chain with a unit or a number entry refuses a frame it decoded.
mutation_case "a value that says nothing of an input is refused" <<'PY'
edit("sce-build/src/forge/generator/rust_source.rs",
     r'''                format!("{read}.is_some_and(|_s| _s != {value})")''',
     r'''                format!("{read}.is_none_or(|_s| _s != {value})")''')
PY

mutation_case "an arm that does not read the input says it is clear" <<'PY'
edit("sce-build/src/forge/generator/rust_source.rs",
     r'''                    said.push("_ => None,".to_string());''',
     r'''                    said.push("_ => Some(false),".to_string());''')
PY

mutation_case "a bound flag keeps the bit the value presents" <<'PY'
edit("sce-build/src/forge/generator/rust_source.rs",
     r'''                Derivation::BoundInput { binders } => {
                    self.derive_bound_input(id, binders, lines, &mut derived)
                }''',
     r'''                Derivation::BoundInput { binders } => {
                    let _ = (Self::derive_bound_input, binders);
                }''')
PY

# That an entry is held to the flag its chain hands it is a case of
# `a_generation_writes_what_its_analysis_says.cases`: dropping the check fails
# the generation itself, which a build of generated codecs never gets past.
