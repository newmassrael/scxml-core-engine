# Mutation cases for §scxml-4.9 and the guard of a `datamodel="sce-static"`
# machine generated as Python (docs/SCE_ACCEPTED_SUBSET.md §2.15).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_python_machine_ends_its_block_at_a_failure_python.cases`.
#
# A statement of such a machine is Python the lowering wrote, and the templates
# only place it: a checked operation raises `AlgorithmFailure` in place of a
# value, the statement around it receives that as `error.execution` and leaves
# its action block with the sentinel every block catches, a condition that
# cannot be computed is false and says so, and a lowered statement runs where
# the author's script text used to be handed to an engine. The values those
# decide are the ones `scenarios/*.json` state, replayed by
# `backends/python/tests/integration/static_datamodel/test_static_scenarios.py`
# over the machines `scripts/regen_static_datamodel_python.sh` generates.
#
# What is easy to get wrong and reads as success: a failed value written anyway
# is a wrapped number where a variable keeps what it held, and a block that goes
# on after an error runs the statements the document meant never to run.
# `static_overflow` and `static_block_ends` tell those apart.
#
# Python compiles nothing and its generated machines are gitignored, so the
# templates and the spellings in `static_lowering.rs` reach the tests only
# through the regeneration declared below. They are `mutation_runtime_targets`
# for the reason the other Python casefiles give: what shows a mutation arrived
# is that the file on disk differed while the tests ran.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_pytest backends/python/tests integration/static_datamodel/
mutation_regen scripts/regen_static_datamodel_python.sh
mutation_runtime_targets backends/python/runtime/sce_runtime/event_payload.py
mutation_runtime_targets tools/codegen/templates/python/_actions.py.jinja2 tools/codegen/templates/python/actions/native_action.py.jinja2 tools/codegen/templates/python/actions/send.py.jinja2 tools/codegen/templates/python/entry_exit_actions.py.jinja2 tools/codegen/templates/python/invoke_methods.py.jinja2 tools/codegen/templates/python/process_transition.py.jinja2 tools/codegen/templates/python/state_machine.py.jinja2 tools/codegen/templates/python/scriptengine_helpers.py.jinja2 sce-build/src/forge/static_lowering.rs
mutation_oracles backends/python/tests/integration/static_datamodel/test_static_scenarios.py backends/python/tests/integration/static_datamodel/test_a_static_child_is_handed_its_params.py backends/python/tests/integration/static_datamodel/test_a_static_host_action.py

# ── A failed statement ends its block ──────────────────────────────

mutation_case "a block goes on after a statement that failed" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "        lines.push(\"    raise _ActionAbort\".to_string());\n        lines.join(\"\\n\")",
     "        lines.push(\"    pass\".to_string());\n        lines.join(\"\\n\")")
PY

# ── An <if> whose cond failed ends its block ───────────────────────

mutation_case "a block goes on after an <if> whose cond failed" <<'PY'
edit("tools/codegen/templates/python/state_machine.py.jinja2",
     "            if failed is not None:\n                failed[0] = True\n",
     "            if failed is not None:\n                pass\n")
PY

# ── A condition that cannot be computed is false ───────────────────

mutation_case "a condition that failed is true" <<'PY'
edit("tools/codegen/templates/python/state_machine.py.jinja2",
     "                failed[0] = True\n            return False\n",
     "                failed[0] = True\n            return True\n")
PY

# ── A lowered statement runs ───────────────────────────────────────

mutation_case "a lowered statement is not what the block runs" <<'PY'
edit("tools/codegen/templates/python/_actions.py.jinja2",
     "{%- if action.native_code -%}\n",
     "{%- if false and action.native_code -%}\n")
PY

# ── The variables are initialised ──────────────────────────────────

mutation_case "a variable is not given its declared value" <<'PY'
edit("tools/codegen/templates/python/state_machine.py.jinja2",
     "        {{ field.name }}: {{ field.ty }} = {{ field.init }}\n",
     "        {{ field.name }}: {{ field.ty }} = None\n")
PY

# ── A donedata pair that failed is left out ────────────────────────

mutation_case "a donedata pair that failed is carried anyway" <<'PY'
edit("tools/codegen/templates/python/entry_exit_actions.py.jinja2",
     "            except sce_algorithm.AlgorithmFailure:\n                self._raise_error_execution(\n                    engine,\n                    \"<donedata> <param name='{{ param.name }}'> failed to evaluate\",\n                )\n{% elif not _pexpr %}",
     "            except sce_algorithm.AlgorithmFailure:\n                _done_parts.append('\"{{ param.name | escape_json_string }}\":0')\n{% elif not _pexpr %}")
PY

# ── Content that reads the payload runs only for a delivery that carried it ──

mutation_case "content reads a payload no delivery carried" <<'PY'
edit("tools/codegen/templates/python/process_transition.py.jinja2",
     "{% if transition.content_reads_payload %}\n                if self._pending_{{ transition.event | to_snake_case }}_payload is None:\n                    return\n{% endif %}\n",
     "")
PY

# ── A child is handed the values its invoke names ──────────────────

mutation_case "a child is handed none of the values its invoke names" <<'PY'
edit("tools/codegen/templates/python/invoke_methods.py.jinja2",
     "                _child_policy.accept_params(_seed)\n{% elif inv.namelist or inv.params %}",
     "                _child_policy.accept_params(_seed.__class__())\n{% elif inv.namelist or inv.params %}")
PY

# ── A host call whose argument failed is not made ───────────────────
#
# `static_host_call_arguments`: `level + 10` does not fit a uint8, so the host is
# not called with 4 and `error.execution` is raised in the call's place, which
# the machine counts. A call not received lets the exception out of the block; a
# call received and not reported is the host unheard and `errors` still 0.

mutation_case "a host call is not received where its argument failed" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "        format!(\"try:\\n    {statement}\\nexcept sce_algorithm.AlgorithmFailure:\\n    {on_failure}\")\n",
     "        let _ = on_failure;\n        statement.to_string()\n")
PY

mutation_case "a host call whose argument failed raises nothing" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "        let on_failure = if failed.is_empty() { \"pass\" } else { failed };\n",
     "        let on_failure = {\n            let _ = failed;\n            \"pass\"\n        };\n")
PY

mutation_case "a multi-line host call is placed on one line" <<'PY'
edit("tools/codegen/templates/python/actions/native_action.py.jinja2",
     "{% if '\\n' in action.native_action_rendered -%}\n",
     "{% if false and '\\n' in action.native_action_rendered -%}\n")
PY

# ── A send reads the payload its transition's event carried ─────────
#
# `static_payload_relay`: a `<param>` of the `<send>` is the only thing that reads
# the payload of `view.shown`, so the walk that does not count it a read leaves
# the event without its typed channel, and the machine names a field it never
# lifted. The payload-less delivery is held by a test of its own.

mutation_case "a send's params do not count as a payload read" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "                reads_payload |=\n                    reads(crate::forge::static_datamodel::WireParam::of_param(param).written);\n",
     "")
PY

# ── A send's namelist is the params it abbreviates ─────────────────
#
# `static_send_namelist`: `namelist="layout zoom"` carries the two variables as
# the pairs `<param name="layout" expr="layout"/>` and
# `<param name="zoom" expr="zoom"/>`. A walk that leaves the names in the
# `namelist` hands the templates a list of pairs with none of them in it, and the
# receiver finds nothing of what was sent.

mutation_case "a send's namelist is not folded into its params" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "            action.fold_namelist_into_params();\n",
     "")
PY

# ── A send's content record is the pairs of its fields ─────────────
#
# `static_send_content`: `<content expr="shown"/>` carries the record variable as
# the pairs of its fields, and `<content expr="_event.data"/>` the payload of the
# event the transition is on. A walk that leaves the record in the `contentexpr`
# hands the templates a send with no pairs and an expression only an engine reads.

mutation_case "a send's content record is not folded into its pairs" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "                action.fold_content_record_into_params(&content, &fields);\n",
     "                let _ = &fields;\n")
PY

# ── A send param that failed is left out and the message goes ─────

mutation_case "a send param that failed is carried as a zero" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{{ indent }}    _param_failures.append({{ param.name | py_string_literal }})\n{% endfor %}\n{% elif has_payload %}",
     "{{ indent }}    _param_failures.append({{ param.name | py_string_literal }})\n{{ indent }}    _data[{{ param.name | py_string_literal }}] = 0\n{% endfor %}\n{% elif has_payload %}")
PY

# ── A called algorithm is a module the machine imports ─────────────

mutation_case "an algorithm the machine calls is not imported" <<'PY'
edit("tools/codegen/templates/python/state_machine.py.jinja2",
     "{% for line in static_imports %}\n{{ line }}\n{% endfor %}",
     "{% for line in static_imports %}\n{% endfor %}")
PY

mutation_case "a call names the module of another language's identity" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "        Some(generated_callee(Language::Python, document_name, None))",
     "        Some(generated_callee(Language::Rust, document_name, None))")
PY

# ── A list holds no more than its bound ────────────────────────────

mutation_case "an append past the capacity is not refused" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "        let mut lines = vec![format!(\"if len({target}) >= {capacity}:\")];\n",
     "        let mut lines = vec![format!(\"if False and len({target}) >= {capacity}:\")];\n")
PY

# ── A string holds no more than its bound ──────────────────────────
#
# `static_string_capacity`: `copy` assigns a sixteen-byte `body` to a four-byte
# `title`, and the refused copy must leave `title` and `copied` as they were. A
# value written without the bound is a string the variable never declared.

mutation_case "a string is assigned past its capacity" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "format!(\"sce_algorithm.bounded({value}, {capacity})\")",
     "format!(\"sce_algorithm.bounded({value}, {capacity} + 1000000)\")")
PY

# ── A payload's enum field holds a variant of its enum ─────────────
#
# `static_payload_enum`: `view.shown` carries a `layout` named as the enum
# document declares it. A name no variant declares (`fortnight`) is a payload that
# does not fit its schema, and the delivery must be refused with nothing written
# — a name taken for the enum's first value writes the `zoom` beside it.

mutation_case "a payload's enum field takes a name no variant declares" <<'PY'
edit("backends/python/runtime/sce_runtime/event_payload.py",
     "        raise TypedPayloadError(\n            f\"{name!r} ({value!r}) is not a variant of {declared.__name__}\")\n",
     "        return next(iter(declared))\n")
PY
