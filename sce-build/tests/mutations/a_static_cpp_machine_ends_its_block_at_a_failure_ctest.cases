# Mutation cases for §scxml-4.9 and the guard of a `datamodel="sce-static"`
# machine generated as C++ (docs/SCE_ACCEPTED_SUBSET.md §2.15).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_cpp_machine_ends_its_block_at_a_failure_ctest.cases`.
#
# A statement of such a machine is C++ the lowering wrote, and the templates
# only place it: a statement that can fail is an expression that is `true` when
# it did, the transition's guard is the lowered expression itself, and an
# error ends the block it stands in. The values those three decide are the
# ones `scenarios/*.json` state, replayed by
# `tests/integration/AStaticDatamodelRunsGeneratedCppTest.cpp` over machines
# generated from the fixtures beside them.
#
# What is easy to get wrong and reads as success: a block that goes on after a
# failed statement still ends with the right counters whenever the statements
# after it write what they would have written anyway, so only `static_block_ends`
# (a write after the failure that must not happen) tells the two apart.
#
# The lowering's own spellings are Rust (`sce-build/src/forge/static_lowering.rs`)
# and are held by the Rust suites over the same scenarios; this file holds the
# templates, which `cmake --build` reads at generation time.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^static_datamodel_generated_cpp$'
mutation_targets tools/codegen/templates/actions/_native_statement.jinja2 tools/codegen/templates/actions/if.jinja2 tools/codegen/templates/actions/send.jinja2 tools/codegen/templates/process_transition.jinja2 tools/codegen/templates/entry_exit_actions.jinja2 tools/codegen/templates/invoke_methods.jinja2
mutation_oracles tests/integration/AStaticDatamodelRunsGeneratedCppTest.cpp tests/integration/StaticHostParamsAotTest.cpp sce-build/tests/fixtures/host_processor/statechart_static_host_params.scxml

# ── A failed statement ends its block ──────────────────────────────

mutation_case "a block goes on after a statement that failed" <<'PY'
edit("tools/codegen/templates/actions/_native_statement.jinja2",
     "{% if block_exit is defined and block_exit %}\n    {{ block_exit }}\n{% endif %}\n}",
     "{% if false and block_exit is defined and block_exit %}\n    {{ block_exit }}\n{% endif %}\n}")
PY

# ── An <if> whose cond failed ends its block ───────────────────────

mutation_case "a block goes on after an <if> whose cond failed" <<'PY'
edit("tools/codegen/templates/actions/if.jinja2",
     "{% if if_native_can_fail and block_exit is defined and block_exit %}",
     "{% if false and block_exit is defined and block_exit %}")
PY

# ── A guard is the lowered expression ──────────────────────────────

mutation_case "a transition's native guard is not asked" <<'PY'
edit("tools/codegen/templates/process_transition.jinja2",
     "{%- elif trans.native_guard -%}{{ trans.native_guard }}",
     "{%- elif trans.native_guard -%}true")
PY

# ── A <final>'s donedata is what survived ──────────────────────────
#
# A param whose value does not fit is left out and the others cross
# (§scxml-5.7.1); `static_donedata` holds a uint8 that overflows beside three
# that do not, so a pair carried with the 0 a failed operation yields, and the
# done event with no data at all, are two different reds.

mutation_case "a donedata param that failed is carried with its zero" <<'PY'
edit("tools/codegen/templates/entry_exit_actions.jinja2",
     "                        if (sce_failure_.failed()) SCE_UNLIKELY {\n                            SCE_LOG_WARN(\"Donedata param '",
     "                        if (false) SCE_UNLIKELY {\n                            SCE_LOG_WARN(\"Donedata param '")
PY

mutation_case "the donedata pairs are not handed to the done event" <<'PY'
edit("tools/codegen/templates/entry_exit_actions.jinja2",
     "                    ::SCE::DoneDataHelper::collectParams(doneValues, eventData, &typedData);",
     "                    (void)doneValues;")
PY

# ── A <send> carries the pairs that survived ───────────────────────
#
# `static_send_params`: a param whose value does not fit is reported and left out
# and the message still goes, so the receiver, finding the field missing, refuses
# it a second time. A pair carried with the 0 a failed operation yields is one
# refusal and a `partialTotal` of 6.

mutation_case "a send param that failed is carried with its zero" <<'PY'
edit("tools/codegen/templates/actions/send.jinja2",
     "    if (sce_failure_.failed()) SCE_UNLIKELY {\n{{ param_eval_failed(param, '        ') }}",
     "    if (false) SCE_UNLIKELY {\n{{ param_eval_failed(param, '        ') }}")
PY

# ── A child is handed what its invoke names ────────────────────────
#
# `static_invoke_params`: `worker` ends only when it holds the 7 its `<param>`
# reads and the true its `namelist` names, so a parent that computes the seed and
# never gives it to the child leaves the parent in `working` with nothing
# counted.

mutation_case "a child is not handed the values its invoke names" <<'PY'
edit("tools/codegen/templates/invoke_methods.jinja2",
     "                            {{ slot }}->acceptParams(seed);",
     "                            (void)seed;")
PY

# ── A host is handed the values the fields hold ────────────────────
#
# `statechart_static_host_params`: a `<param>` of a host-served `<send>` and
# `<invoke>` is native code over the machine's fields, read when the element runs
# and handed to the host as text (`params`) and as the pairs' JSON (`eventData`).
# `boom` is a multiplication a 32-bit field cannot hold: that pair is the
# evaluation that failed, so it is reported and left out while the message still
# goes. A pair written with a failed value is a request that still looks
# complete; a send whose text params were never filled is one a host that reads
# `params` meets empty — only the JSON carried the values.

mutation_case "an invoke's param that failed is written into the request" <<'PY'
edit("tools/codegen/templates/invoke_methods.jinja2",
     "                            if (sce_failure_.failed()) SCE_UNLIKELY {\n                                engine.raise(typename Engine::EventWithMetadata(\n                                    Event::Error_execution,\n                                    \"<invoke> <param name='{{ param.name | escape_cpp }}'> failed to evaluate\"));\n                            } else",
     "                            if (false) SCE_UNLIKELY {\n                                engine.raise(typename Engine::EventWithMetadata(\n                                    Event::Error_execution,\n                                    \"<invoke> <param name='{{ param.name | escape_cpp }}'> failed to evaluate\"));\n                            } else")
PY

mutation_case "a send's param reaches the host as the pairs' JSON alone" <<'PY'
edit("tools/codegen/templates/actions/send.jinja2",
     "{% else %}\n    params[\"{{ param.name | escape_cpp }}\"].push_back(\n        ::SCE::ScriptResultUtils::resultToString(::SCE::ScriptResult::createSuccess(paramValue)));\n    typedParams",
     "{% else %}\n    typedParams")
PY
