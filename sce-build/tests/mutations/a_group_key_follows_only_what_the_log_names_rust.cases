# Mutation cases for the group key of a shared list (ADR 0034, section 6): the MLS group that gives the
# list its content key for each epoch, bound to the membership log. A commit is applied only when the
# log names it by hash and at the epoch the log gives it; after a commit the group's roster is the
# log's members and a commit that leaves it otherwise is undone; a device that joins from a Welcome
# holds the confirmation tag of the commit the log names; a device the log has no grant for (or has
# with another key) is not added; a removed device derives no key of a later epoch; the epoch key and
# the key of a section come from the group's exporter under labels and contexts of their own; and the
# member of a host takes the entries of the log, the commit and the Welcome in that order.
#
# Each case takes one of those checks away or weakens it, and the tests under study must turn red. A
# check no test notices is a check nothing holds in place.
#
# The tests under study are the three of the crate and the one that carries the commits and Welcomes
# through a relay, which is the only one that runs `Member::absorb` and `Member::advance`.
#
# Run with `scripts/mutate sce-build/tests/mutations/a_group_key_follows_only_what_the_log_names_rust.cases`.
#
# Anchors are literal slices of the source; an edit that moves one is reported INCONCLUSIVE with the
# anchor quoted, never as a pass.

mutation_tests -p sce-rust-mls --lib --test a_known_answer_scenario_is_what_every_lane_replays --test a_person_links_a_device_loses_one_and_is_taken_off_with_the_group_following --test an_mls_group_follows_the_log_and_cuts_off_the_removed --test a_member_waits_for_the_log_to_name_what_it_holds_and_then_takes_it -p sce-rust-world --test a_shared_list_keys_its_content_with_mls_through_a_relay
mutation_targets backends/rust/mls/src/lib.rs backends/rust/mls/src/host.rs
mutation_oracles backends/rust/mls/tests/a_known_answer_scenario_is_what_every_lane_replays.rs backends/rust/mls/tests/a_person_links_a_device_loses_one_and_is_taken_off_with_the_group_following.rs backends/rust/mls/tests/an_mls_group_follows_the_log_and_cuts_off_the_removed.rs backends/rust/mls/tests/a_member_waits_for_the_log_to_name_what_it_holds_and_then_takes_it.rs backends/rust/world/tests/a_shared_list_keys_its_content_with_mls_through_a_relay.rs

# ── The keys the exporter gives: the labels and what they are asked with ──────────────────────

mutation_case "The key of an epoch is asked of the exporter under another label" <<'PY'
edit("backends/rust/mls/src/lib.rs",
     'const EPOCH_LABEL: &str = "sce-trust/epoch-key/1";',
     'const EPOCH_LABEL: &str = "sce-trust/epoch-key/2";')
PY

mutation_case "The key of a section is asked of the exporter under the label of the epoch's" <<'PY'
edit("backends/rust/mls/src/lib.rs",
     'const SECTION_LABEL: &str = "sce-trust/section-key/1";',
     'const SECTION_LABEL: &str = "sce-trust/epoch-key/1";')
PY

mutation_case "The key of a section does not depend on the name of the section" <<'PY'
edit("backends/rust/mls/src/lib.rs",
     "        context.extend_from_slice(name.as_bytes());",
     "        let _ = name;")
PY

mutation_case "The key of an epoch is asked for no list" <<'PY'
edit("backends/rust/mls/src/lib.rs",
     "        self.export(EPOCH_LABEL, self.list.as_bytes())",
     "        self.export(EPOCH_LABEL, &[])")
PY

mutation_case "A device removed from the group is given the exporter's key of the epoch it was in" <<'PY'
edit("backends/rust/mls/src/lib.rs",
     "        if !group.is_active() {\n            return Err(MlsError::Removed);",
     "        if false {\n            return Err(MlsError::Removed);")
PY

# ── A commit the log names, and when ──────────────────────────────────────────────────────────

mutation_case "A device applies a commit the log does not name as the one that begins the next epoch" <<'PY'
edit("backends/rust/mls/src/lib.rs",
     "        if named != Some(commit_hash(commit)) {\n            return Err(MlsError::CommitNotNamed { epoch: next });",
     "        if false {\n            return Err(MlsError::CommitNotNamed { epoch: next });")
PY

mutation_case "A device applies a commit the log names for its latest epoch, whichever epoch is next" <<'PY'
edit("backends/rust/mls/src/lib.rs",
     "        let named = u32::try_from(next)\n            .ok()\n            .and_then(|epoch| log.commit_of(epoch));",
     "        let named = u32::try_from(next)\n            .ok()\n            .and_then(|_| log.commit_of(log.epoch()));")
PY

