# Mutation cases for "a date expression resolves each kind as its table says".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_date_expression_resolves_each_kind_as_its_table_says.cases`.
#
# `sce:std/time/resolve_date` resolves a date expression from today, one arm per
# kind of date_kind.scxml (docs/adr/0087, section 5). Each case takes one rule
# of one arm away: the week a coming or a previous weekday of today's own
# weekday is, the Monday an ISO week starts on, the step of a weekly shift, the
# day a month or a year lands on, the next year that has a 29 February, the
# leap year a month day is admitted against, and the absent answer of `none`.
# The calendar table `tests/forge/conformance/gen_cases.py` writes into the
# oracle resolves every kind from each day of five weeks, and the Rust
# numerical conformance harness holds the generated document to it, so each
# case changes an answer the table states.
#
# Anchors are literal slices of the document; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-forge-conformance --features alloc --test numerical_conformance
mutation_targets stdlib/time/resolve_date.scxml
mutation_oracles tests/forge/conformance/numerical_reference.json

mutation_case "none answers today instead of no date" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''    <sce:if cond="kind === DateKind.none">
      <sce:return expr="null"/>''',
     r'''    <sce:if cond="kind === DateKind.none">
      <sce:return expr="today"/>''')
PY

mutation_case "absolute reads the first of the month for any day" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''<sce:return expr="daysOf(year.value, month.value, day.value)"/>''',
     r'''<sce:return expr="daysOf(year.value, month.value, 1)"/>''')
PY

mutation_case "a month day is admitted against a common year, so 29 February is refused" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''day.value &lt;= monthLength(2000, month.value)''',
     r'''day.value &lt;= monthLength(2001, month.value)''')
PY

mutation_case "a month day already past this year is answered in this year" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''<sce:if cond="thisYear &gt;= today">''',
     r'''<sce:if cond="thisYear &gt;= today || true">''')
PY

mutation_case "a 29 February is looked for only in the next year" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''<sce:while cond="day.value &gt; landingLast">''',
     r'''<sce:while cond="day.value &gt; landingLast &amp;&amp; false">''')
PY

mutation_case "relativeDays counts back" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''<sce:return expr="today + dayShift"/>''',
     r'''<sce:return expr="today - dayShift"/>''')
PY

mutation_case "relativeWeeks shifts by days" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''<sce:return expr="today + weekShift * 7"/>''',
     r'''<sce:return expr="today + weekShift"/>''')
PY

mutation_case "relativeMonths shifts by years" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''addMonths(monthFrom.year, monthFrom.month, monthFrom.day, count.value)''',
     r'''addMonths(monthFrom.year + count.value, monthFrom.month, monthFrom.day, 0)''')
PY

mutation_case "relativeYears keeps 29 February in a year that has none" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''yearFrom.day &lt; yearLast ? yearFrom.day : yearLast''',
     r'''yearFrom.day''')
PY

mutation_case "the coming weekday of today's own weekday is today" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''<sce:return expr="today + (comingGap === 0 ? 7 : comingGap)"/>''',
     r'''<sce:return expr="today + comingGap"/>''')
PY

mutation_case "the previous weekday of today's own weekday is today" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''<sce:return expr="today - (previousGap === 0 ? 7 : previousGap)"/>''',
     r'''<sce:return expr="today - previousGap"/>''')
PY

mutation_case "a weekday past Saturday is admitted as a coming weekday" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''<sce:require cond="weekday !== null &amp;&amp; weekday.value &lt;= 6"/>
      <sce:var name="comingWanted" type="int64" init="weekday.value"/>''',
     r'''<sce:require cond="weekday !== null &amp;&amp; weekday.value &lt;= 7"/>
      <sce:var name="comingWanted" type="int64" init="weekday.value"/>''')
PY

mutation_case "the week of a weekday starts on Sunday, not on the ISO Monday" <<'PY'
edit("stdlib/time/resolve_date.scxml",
     r'''(isoWanted + 6) % 7 - (isoNow + 6) % 7''',
     r'''isoWanted - isoNow''')
PY
