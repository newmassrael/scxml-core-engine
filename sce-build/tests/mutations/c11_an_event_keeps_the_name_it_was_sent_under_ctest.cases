# Mutation cases for "an event keeps the name it was sent under" (C11 generated
# machines).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/c11_an_event_keeps_the_name_it_was_sent_under_ctest.cases`.
#
# A transition on `request` takes `request.new` by whole-token matching
# (§scxml-3.12.1), and `_event.name` is then the name the event was sent under
# (§scxml-5.10), not the descriptor it was matched through. A generated C machine
# carries the event as the enum member of a name its document writes, so the whole
# name has to travel beside it: `<machine>_arrive` records it in
# `event_with_meta_t.name` and `set_current_event` writes it over the member's name
# in `_event`.
# `integration_resources/an_event_keeps_the_name_it_was_sent_under/` is the
# document: the parent writes `request.new`, the child only `request`, and the
# child reports `arrivedShortened` unless it is told the whole name.
#
# Two things are easy to get wrong and read as success: a door that resolves the
# name and forgets to record it (the event is delivered, the transition is taken,
# the child is told the shorter name), and a binding that never applies the
# recorded name (it is there and unused). Either leaves the machine reaching its
# final state, so only `_event.name` itself tells them apart.
#
# The machine is emitted by the templates, which `cmake --build` reads at
# generation time, so the templates are the targets.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^c11_integration_an_event_keeps_the_name_it_was_sent_under$'
mutation_targets tools/codegen/templates/c/state_machine.c.jinja2
mutation_oracles backends/c/tests/integration/test_an_event_keeps_the_name_it_was_sent_under.c

mutation_case "the resolver never records the name it was cut back from" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "            if (strlen(candidate) != len) {\n                memcpy(arrival, name, len);\n                arrival[len] = '\\0';\n            }\n",
     "")
PY

mutation_case "the recorded name is never written over the member's" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "    if (evt->name[0] != '\\0') {\n        lua_getglobal(L, \"_event\");",
     "    if (evt->name[0] != '\\0' && 0) {\n        lua_getglobal(L, \"_event\");")
PY
