# Mutation cases for "a C11 machine reads a composed payload at any depth and
# sends a composed value by its name" (docs/adr/0086, sections 4, 5.3, 5.4, 6
# and 7.1, the C11 row).
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_c11_machine_reads_and_sends_a_composed_value.cases
#
# A C11 machine holds a composed value in types named by their shape, reads a
# payload by one function of the machine per type over the runtime's bounded
# readers, names the path of a refused place in a buffer of the longest path the
# type has, writes a composed value where its pair stands, holding a host's
# value to its type as it writes it, and reads a text it holds in a buffer as
# the buffer's text. Each case takes one of those decisions away and
# has to turn the pin test red on its own.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test a_c11_machine_reads_a_composed_payload_at_any_depth
mutation_targets sce-build/src/forge/composed_lowering/c11.rs sce-build/src/forge/generator.rs sce-build/src/forge/static_lowering.rs sce-build/src/forge/expr.rs tools/codegen/templates/c/state_machine.c.jinja2
mutation_oracles sce-build/tests/a_c11_machine_reads_a_composed_payload_at_any_depth.rs

# A list is read with no bound: one element past it is kept (section 4.1).
mutation_case "a list is read past its bound" <<'PY'
edit("sce-build/src/forge/composed_lowering/c11.rs",
     r'''sce_payload_list_open_within(sce_value, {least}u, {max}u,''',
     r'''sce_payload_list_open_within(sce_value, {least}u, UINT32_MAX,''')
PY

# A host's list past the room of its type is written as far as it says it
# reaches, past the array that holds it (section 5.4).
mutation_case "a list past the room of its type is written" <<'PY'
edit("sce-build/src/forge/composed_lowering/c11.rs",
     r'''            "if ({value}.len > sizeof({value}.data) / sizeof({value}.data[0]))''',
     r'''            "if (false && {value}.len > sizeof({value}.data) / sizeof({value}.data[0]))''')
PY

# The pairs of a payload are written in the schema's order, not ascending by
# their keys' bytes (ARCHITECTURE.md, "JSON Object Key Order").
mutation_case "the pairs are written in the schema's order" <<'PY'
edit("sce-build/src/forge/composed_lowering/c11.rs",
     r'''    // A record's ids are distinct, so the pairs order by their ids.
    let mut sorted: Vec<&(String, String)> = fields.iter().collect();
    sorted.sort();''',
     r'''    // A record's ids are distinct, so the pairs order by their ids.
    let sorted: Vec<&(String, String)> = fields.iter().collect();''')
PY

# The path of a refused place is measured without the digits of its indices,
# so the buffer that names it is too short and the reason cuts it (section 4.2).
mutation_case "a path is measured without its indices" <<'PY'
edit("sce-build/src/forge/composed_lowering/c11.rs",
     r'''            1 + last.to_string().len() as u64 + c11_path_len(elem, within, records)?''',
     r'''            let _ = last;
            1 + c11_path_len(elem, within, records)?''')
PY

# A composed payload is lifted into a copy of its size on the stack, which the
# machine's own storage exists to keep off it (section 8.5 (d)).
mutation_case "a composed payload is lifted into a copy" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''            owned_payload: String::new(),
            in_place: true,''',
     r'''            owned_payload: String::new(),
            in_place: false,''')
PY

# An element of a list of lists, read through an index outside the list,
# answers 0, which is no list: the C the machine is written as does not compile.
mutation_case "a list element read outside its list answers zero" <<'PY'
edit("sce-build/src/forge/expr.rs",
     r'''        InferredType::Bytes | InferredType::List(_) => CFailedRead::Aggregate,''',
     r'''        InferredType::Bytes => CFailedRead::Aggregate,''')
PY

# A composed param is written as a value the send holds, which C has none of.
mutation_case "a composed param is written as a value" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     r'''            writes: rewrites.target.composed_param_writes(),''',
     r'''            writes: false,''')
PY

# A text a composed value holds in its buffer is read as the pointer every C
# text expression is, which is C that does not compile (docs/adr/0086,
# section 6).
mutation_case "a composed text is read as a pointer" <<'PY'
edit("sce-build/src/forge/expr.rs",
     r'''    if matches!(target, ExprTarget::C) {
        read_composed_texts_through_buffers(ast, ctx, renames);
    }''',
     r'''    if matches!(target, ExprTarget::C) {
        let _ = (ctx, renames);
    }''')
PY

# The item of a loop over a list a place holds is taken for a value of the
# loop's own, so a text it holds, or a text below it, is read as a pointer.
mutation_case "a loop's item over a place is no part of a composed value" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     r'''                loop_variables.bind_item_of_a_place(ctx)''',
     r'''                loop_variables.bind(ctx)''')
PY

# A text field read through a checked index is read through its buffer outside
# the conditional, whose other arm is the empty text: a struct and a pointer
# are no one type, and the C does not compile.
mutation_case "a member's text is read outside its checked index" <<'PY'
edit("sce-build/src/forge/expr.rs",
     r'''    if let ExprKind::Member { property, .. } = &mut node.kind {
        property.push('.');
        property.push_str(C_BUFFER_TEXT);
        return;
    }''',
     r'''    if let ExprKind::Member { .. } = &mut node.kind {
        let _ = C_BUFFER_TEXT;
    }''')
PY

# A send a host serves hands it, as a composed pair's text, the payload from its
# start rather than the value alone: every pair before it, its key, and the
# value.
mutation_case "a host's pair text is read from the payload's start" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     r'''                        const size_t sce_value_at = sce_forge_wire_mark(sce_wire);''',
     r'''                        const size_t sce_value_at = 0u;''')
PY
