# Mutation cases for the BUILD half of a host-served Event I/O Processor.
#
# Run with
# `scripts/mutate sce-build/tests/mutations/host_processor_declaration.cases`.
#
# W3C SCXML 6.2.5 makes the `<send>` `type` an extensible identifier, so the
# set of processors is open by design — but only the platform can widen it,
# and SCE had no way for a platform to say so. A consumer could name a
# processor and be refused; it could not name one and be served.
#
# The declaration is one decision applied once, after the parse and before
# any backend renders. Each case below either stops the decision reaching
# somewhere it must, or widens it past what was declared. Both directions
# matter: a declaration that claims nothing is a dead feature, and one that
# claims everything delivers acts the host never agreed to perform.
#
# The refusal cases are the ones that keep this honest. Five backends have no
# processor registry, and honouring a declaration for them would emit a
# dispatch nothing can service — the build would then actively promise a
# delivery that never happens, which is worse than the silence this round
# removes. So "the refusal stops firing" and "the refusal fires when nothing
# was declared" are both mutations, in opposite directions.
#
# The template is a `mutation_runtime_targets` entry because codegen reads it
# at generation time; the committed `_sm.rs` trees are NOT the witness here
# (they are already generated), which is why the oracle regenerates through
# the CLI and reads the emitted text.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --lib --test host_processor_declaration \
    --test cli_check_generate_parity
mutation_targets sce-build/src/host_processor_analyzer.rs sce-build/src/generator.rs
# Both entries here are read by the tests at RUN time rather than linked into
# them, which is how the harness detects that a mutation arrived.
#
# The template is the obvious case: codegen opens it while generating.
# `sce_codegen.rs` is the less obvious one, and it cost this casefile a round
# to learn — the CLI suite SPAWNS the binary as a subprocess, so mutating it
# changes `sce-codegen` and leaves every *test* binary byte-identical. Listed
# as a compiled target it reported INCONCLUSIVE ("the mutation never reached
# the code under test") while in fact reaching it perfectly well.
mutation_runtime_targets tools/codegen/templates/rust/actions/send.rs.jinja2 \
    tools/codegen/templates/rust/invoke_methods.rs.jinja2 \
    sce-build/src/bin/sce_codegen.rs
# The analyzer's own `tests` module and the CLI-level declaration suite. Named
# explicitly because a `--lib` selector cannot resolve an oracle from a target
# name, and because the analyzer file is also a mutation target — nothing else
# would notice a case that reds by weakening a test rather than breaking code.
mutation_oracles sce-build/src/host_processor_analyzer.rs \
    sce-build/tests/host_processor_declaration.rs \
    sce-build/tests/cli_check_generate_parity.rs

# ── The declaration stops being applied ─────────────────────────────
#
# The feature's off switch. Everything else in this file is a narrower
# version of this case.

mutation_case "the declaration is recorded but never applied" <<'PY'
edit("sce-build/src/host_processor_analyzer.rs",
     """    if send_types.is_empty() && invoke_types.is_empty() {
        return;
    }""",
     """    if !(send_types.is_empty() && invoke_types.is_empty()) {
        return;
    }""")
PY

mutation_case "an invoke declaration is recorded but never applied" <<'PY'
edit("sce-build/src/host_processor_analyzer.rs",
     "                    if invoke_types.iter().any(|t| t == &info.invoke_type) {",
     "                    if false && invoke_types.iter().any(|t| t == &info.invoke_type) {")
PY

mutation_case "an invoke declaration claims every unsupported type" <<'PY'
edit("sce-build/src/host_processor_analyzer.rs",
     "                    if invoke_types.iter().any(|t| t == &info.invoke_type) {",
     "                    if true || invoke_types.iter().any(|t| t == &info.invoke_type) {")
PY

mutation_case "a claimed send is not marked host-served" <<'PY'
edit("sce-build/src/host_processor_analyzer.rs",
     """        action.send_type_unsupported = false;
        action.send_type_host_served = true;""",
     """        action.send_type_unsupported = false;
        action.send_type_host_served = false;""")
PY

# ── …or is applied to more than was declared ────────────────────────
#
# The false-positive direction, and the dangerous one: a host that declared
# one processor would start receiving sends addressed to every other.

mutation_case "the declaration claims every unsupported type" <<'PY'
edit("sce-build/src/host_processor_analyzer.rs",
     "    if action.send_type_unsupported && types.iter().any(|t| t == &action.send_type) {",
     "    if action.send_type_unsupported {")
PY

mutation_case "the declaration matches a type by prefix" <<'PY'
edit("sce-build/src/host_processor_analyzer.rs",
     "    if action.send_type_unsupported && types.iter().any(|t| t == &action.send_type) {",
     "    if action.send_type_unsupported && types.iter().any(|t| action.send_type.starts_with(t.as_str())) {")
PY

# ── …or reaches only the sends that are easy to find ────────────────

mutation_case "the declaration does not reach nested executable content" <<'PY'
edit("sce-build/src/host_processor_analyzer.rs",
     """    for nested in action
        .actions
        .iter_mut()
        .chain(action.then_actions.iter_mut())
        .chain(action.else_actions.iter_mut())
    {
        claim_action(nested, types);
    }""",
     "")
PY

# ── The report and the emitted code stop agreeing ───────────────────
#
# The flags and the cause list are two readings of one decision. Leaving the
# list stale reports a refusal the build just arranged not to emit — the
# exact disagreement `declare_host_processors` exists to make impossible.

mutation_case "the cause list is left as the parse found it" <<'PY'
edit("sce-build/src/host_processor_analyzer.rs",
     "    model.host_processor_causes = analyze(model);",
     "")
PY

# ── The build stops echoing its own half of the contract ────────────
#
# The declaration is made in the build command and the registration in the
# host's startup code. Publishing the build's half is what lets a consumer
# check the pair instead of meeting the mismatch as a runtime error.

mutation_case "the manifest does not report what was declared" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """        report
            .host_processor_types
            .clone_from(&model.host_processor_types);""",
     "")
PY

# ── The emitted code stops dispatching ──────────────────────────────

mutation_case "the template emits no host dispatch" <<'PY'
edit("tools/codegen/templates/rust/actions/send.rs.jinja2",
     "{% elif action.send_type_host_served %}",
     "{% elif false %}")
PY

mutation_case "the template refuses a served type as well as dispatching" <<'PY'
edit("tools/codegen/templates/rust/actions/send.rs.jinja2",
     "{% if action.send_type_unsupported %}",
     "{% if action.send_type_unsupported or action.send_type_host_served %}")
PY

# ── The declared `<invoke>` stops being started ─────────────────────
#
# ⚠ FOUR CASES USED TO LIVE HERE and they are gone rather than re-aimed.
# They mutated `reject_declaration_in_unsupported_lang` — the fail-fast that
# refused a declaration on a backend with no registry — and that function has
# no callers left: every backend grew both registries, so both
# `reject_host_processors_in_unsupported_lang` and
# `reject_host_invokers_in_unsupported_lang` were retired with it.
#
# Re-aiming was not available. An anchor is re-aimed when the site MOVED; here
# the site was deleted on purpose, and the claim it guarded ("a backend that
# cannot service a declaration must not accept it") is now vacuously true —
# there is no such backend. A case that cannot fail is worse than no case,
# because it reads as coverage.
#
# What the retirement has to be paid for with is the opposite claim, and it is
# the one the cases below make: a declaration REACHES the backend that renders,
# and nothing else does. That claim cannot be retired by coverage, because it
# is the feature rather than the absence of one. The per-backend halves live in
# `host_processor_dispatch_{go,python,cpp,c11}.cases`; Rust's are here beside
# the send-half cases they mirror.

mutation_case "the rust template emits no host invoke start" <<'PY'
edit("tools/codegen/templates/rust/invoke_methods.rs.jinja2",
     "{% if state.invokes | host_invoker %}",
     "{% if false and state.invokes | host_invoker %}")
PY

# ── …or is emitted alongside the refusal it replaced ────────────────
#
# The other direction, and the one a single-sided case would miss. A machine
# that both starts the invocation and raises `error.execution` for it has the
# document seeing the act performed AND refused — the send half's
# `a served type also takes the unsupported arm` in reverse.

mutation_case "a declared invoke also takes the refusal arm" <<'PY'
edit("tools/codegen/templates/rust/invoke_methods.rs.jinja2",
     "{% if state.invokes | unsupported_refused %}",
     "{% if state.invokes | unsupported_refused or state.invokes | host_invoker %}")
PY

# ── `check` stops being able to predict the build ───────────────────
#
# The declaration is read by the backends, so a command that cannot be told
# it cannot reach the verdict it claims to predict. Measured on
# `examples/ai_loop/ai_loop.scxml`: `check` reported all six backends `ok`
# for a document `generate --host-processor` refuses on four of them.
#
# These three are the ways that comes back — the flag unspellable, the
# declaration accepted and dropped, or accepted and not published.

# ⚠ The anchor carries `conflicts_with_all = ["forge"]` because that is what
# makes it `CheckArgs`'s and not one of the two identically-named flags on
# `generate` and `orchestrate`. It was `["scxml_set", "forge", "deploy"]`
# while the flag was single-document-only; `orchestrate` then grew the same
# declaration, so the route stopped conflicting and only `--forge` — a
# document set with no `<send>` for a processor to serve — still does.
mutation_case "check cannot be told about a declared processor" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """    #[arg(
        long = "host-processor",
        value_name = "TYPE",
        conflicts_with_all = ["forge"]
    )]
    host_processor: Vec<String>,""",
     """    #[arg(
        long = "host-processor-unspellable",
        value_name = "TYPE",
        conflicts_with_all = ["forge"]
    )]
    host_processor: Vec<String>,""")
PY

# Replaced by a binding of the two lists rather than deleted outright: with
# the call gone they are unused and the tree stops compiling, which the
# harness reports INCONCLUSIVE — a case that cannot run is worth less than
# no case, since it reads as coverage and measures nothing. Measured: the
# form below compiles and turns `check_and_generate_agree_about_a_host_declaration`
# red, which the deleting form never got far enough to do.
mutation_case "check accepts the declaration and never applies it" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """            sce_build::host_processor_analyzer::declare_host_surfaces(
                &mut model,
                &host_processor,
                &host_invoker,
            );""",
     "            let _ = (&host_processor, &host_invoker);")
PY

mutation_case "check does not publish what it was told" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """            report
                .host_processor_types
                .clone_from(&model.host_processor_types);""",
     "")
PY
