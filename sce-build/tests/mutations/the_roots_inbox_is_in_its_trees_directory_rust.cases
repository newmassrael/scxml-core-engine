# Mutation cases for docs/adr/0084, D2 as amended at step 10, on the Rust
# runtime's `std` profile: the tree keeps a directory from the id of each of its
# sessions to that session's inbox, the root's as well as each child's
# (docs/adr/0147, D2).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/the_roots_inbox_is_in_its_trees_directory_rust.cases`.
#
# The test posts an ending naming the root through a child's handle, which the
# directory must take for the root, and posts it again once the root's engine is
# gone, which the directory must refuse as naming a session the tree does not
# hold. The mutants take one decision away each:
#
#   an inbox made in a tree does not enter its directory (the root, which no
#   parent adopts, is then never in it);
#   an inbox whose engine is gone stays in the directory.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-rust-runtime --test an_inbox_takes_posts_from_any_thread
mutation_targets backends/rust/runtime/src/inbox.rs
mutation_oracles backends/rust/runtime/tests/an_inbox_takes_posts_from_any_thread.rs

mutation_case "Rust makes an inbox in a tree without entering it in the directory" <<'PY'
edit("backends/rust/runtime/src/inbox.rs",
     "        tree.enter(&shared);\n        Self { shared, receiver }\n",
     "        Self { shared, receiver }\n")
PY

mutation_case "Rust leaves an inbox in the directory once its engine is gone" <<'PY'
edit("backends/rust/runtime/src/inbox.rs",
     "        self.shared.tree().leave_if_named(&self.shared);\n",
     "        let _ = self.shared.tree();\n")
PY
