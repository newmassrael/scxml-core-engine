# Mutation cases for §scxml-3.13's internal-event branch on the three engines
# that ctest drives — C++ Interpreter, C++ AOT, C11.
#
# Run with `scripts/mutate sce-build/tests/mutations/internal_chain_is_bounded_ctest.cases`.
#
# The Rust half lives in `internal_chain_is_bounded.cases`. This file exists
# separately for the reason the sibling axis's does: the ctest runner builds a
# different tree, and mixing the two in one file makes a round rebuild both.
#
# The C++ Interpreter's half is the odd one: the budget belongs to the machine
# and the queue belongs to the raiser. The main event loop asks the budget
# BEFORE it takes the next internal event off the raiser's queue, so a refusal
# leaves the event queued instead of consuming it — the cases below cut that
# ask, and the report the refusal owes.
#
# ⚠ A case that edits `sce/include/static/StaticExecutionEngine.h` costs a full
# C++ rebuild, because every generated machine includes it. Measured
# 2026-08-20 on the sibling axis: six such cases took forty-five minutes.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^(IntegrationTests|c11_integration_internal_chain_is_bounded)$'
mutation_targets sce/include/static/StaticExecutionEngine.h sce/src/runtime/StateMachine.cpp sce/src/runtime/EventRaiserImpl.cpp tools/codegen/templates/c/state_machine.c.jinja2
mutation_oracles tests/integration/InternalChainIsBoundedTest.cpp tests/integration/InternalChainIsBoundedAotTest.cpp backends/c/tests/integration/test_internal_chain_is_bounded.c

# ── C++ AOT: the refusal itself ────────────────────────────────────
#
# The gate the drain asks before every dequeue always says yes, which is what
# the shared queue helper did before it took a budget at all. Left alone the
# document does not return, so the ctest entry's own TIMEOUT is the witness.

mutation_case "the cpp aot internal drain has no ceiling" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     """                if (macrostepMicrostepsTaken_ < MAX_MACROSTEP_MICROSTEPS) {
                    return true;
                }""",
     """                if (true) {
                    return true;
                }""")
PY

# ── C++ AOT: the refusal leaves the queue alone ────────────────────
#
# Asking after the pop consumes the event the drain then declines to run. The
# chain is still bounded and the count still moves, so only
# `ARefusedChainIsLeftQueuedForTheNextMacrostep` sees it — the `resume` chain
# stops a link short of its end and never finishes.

mutation_case "the cpp aot refusal swallows the event it declined" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     """                recordTruncatedMacrostep(currentState_);
                SCE_LOG_ERROR("StaticExecutionEngine: macrostep still going after {} microsteps; stopped draining """,
     """                (void)internalQueue_.pop();  // MUTANT: consumed, not left queued
                recordTruncatedMacrostep(currentState_);
                SCE_LOG_ERROR("StaticExecutionEngine: macrostep still going after {} microsteps; stopped draining """)
PY

# ── C++ AOT: one budget, not one per branch ────────────────────────
#
# The internal branch gets a counter of its own, which is what the Kotlin
# engine shipped. Nothing hangs and `spin` still reports one refusal; the
# chain that gets through is the alternating one, and `alts` is the only
# reading that separates five hundred from a thousand.

# The ceiling is doubled rather than the counter reset at the drain's entry.
# Resetting there is a no-op and read as SURVIVED: `processInternalQueue` is
# entered with the counter already at zero for this macrostep (the resets live
# in `_step` and `checkEventlessTransitions`), and the drain loop that spends
# the budget is inside `processInternalEventQueue`, so a statement before that
# call never runs again while the chain turns. Doubling the ceiling is the same
# claim — the internal branch answers to a limit of its own rather than to the
# macrostep's — and it is one the alternating chain can show: 500 laps become
# 1000, which is exactly what `AnAlternatingChainSpendsOneSharedBudget` reads.
mutation_case "the cpp aot internal branch budgets itself" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     """                if (macrostepMicrostepsTaken_ < MAX_MACROSTEP_MICROSTEPS) {""",
     """                if (macrostepMicrostepsTaken_ < MAX_MACROSTEP_MICROSTEPS * 2) {""")
PY

# ── C++ AOT: the microstep that was answered is the one counted ────
#
# Counting a dispatch that selected nothing spends the budget on events the
# macrostep did not act on, and the `bounded` chain ends exactly at the
# ceiling — so any over-count reports a document that settles as a runaway.

mutation_case "an unanswered internal event still spends the cpp aot budget" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     """                if (outcome.selected) {
                    // Appendix D: the loop turn that selects nothing takes no""",
     """                if (true) {
                    // Appendix D: the loop turn that selects nothing takes no""")
PY

# ── Interpreter: the loop that asks ────────────────────────────────
#
# The interpreter's main event loop takes internal events off the raiser
# itself, and asks the budget before each one leaves the queue. A loop that
# stopped asking would take a `<raise>` that answers itself forever — the
# eventless branch's own check never sees an internal chain.
#
# (Two cases stood here for the budget the machine used to LEND its raiser,
# and the raiser's gate that refused a dispatch with it. The raiser no longer
# dispatches internal events inside a macrostep — the loop takes them — so
# neither the loan nor that gate exists, and a mutation of either would have
# matched nothing.)
#
# ⚠ What the gate protects is TERMINATION, not a value, so the only observable
# is a run that does not end. `IntegrationTests` carries `TIMEOUT 180`
# (tests/CMakeLists.txt); measured 2026-08-25 a timed-out ctest run came back
# `ran 0 tests, baseline ran 3`, INCONCLUSIVE rather than CAUGHT. The honest
# mutation is still the one below; the repair belongs in the harness's reading
# of a timed-out ctest run.
mutation_case "the interpreter loop stops asking the budget" <<'PY'
edit("sce/src/runtime/StateMachine.cpp",
     """            if (!mayTakeMicrostep()) {
                // Asked before the event leaves the queue, so a refusal leaves""",
     """            if (false) {
                // Asked before the event leaves the queue, so a refusal leaves""")
PY

# ── Interpreter: the report ────────────────────────────────────────
#
# The chain is still cut and `getStatistics()` still answers — it simply stops
# saying that the configuration the host is reading is not a stable one.

mutation_case "the interpreter internal refusal is silent" <<'PY'
edit("sce/src/runtime/StateMachine.cpp",
     """    // stays where it is; this publishes the refusal.
    recordTruncatedMacrostep();
    return false;""",
     """    // MUTANT: refused, and nothing said so.
    return false;""")
PY

# ── C11: the refusal itself ────────────────────────────────────────

mutation_case "the c11 internal drain has no ceiling" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     """        if (sm->macrostep_microsteps_taken == SCE_MAX_MACROSTEP_MICROSTEPS) {
            /* Work is still queued one microstep past the budget. Refuse the""",
     """        if (false) {
            /* Work is still queued one microstep past the budget. Refuse the""")
PY

# ── C11: the microstep that was answered is the one counted ────────

# The spend is moved BEFORE the gate rather than after its closing brace. A
# document with `error_events` emits `else if (event_is_error(...))` right
# after that brace, so a statement placed between them compiles to
# `'else' without a previous 'if'` and every generated machine is refused —
# reported INCONCLUSIVE, which measures nothing. Spending first says the same
# thing (the turn pays whether or not it answered) and leaves the chain intact.
mutation_case "an unanswered internal event still spends the c11 budget" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     """        if (select_transitions(sm, evt.event, enabled, &count)) {
            microstep(sm, enabled, count);
            /* W3C SCXML Appendix D: the loop turn that selects nothing takes
               no microstep, so it spends no budget. Only a turn that answered
               the event moved the machine, and only those are what a ceiling
               on microsteps can be counted in. */
            sm->macrostep_microsteps_taken++;
        }""",
     """        sm->macrostep_microsteps_taken++;  /* MUTANT: spent before the turn answered */
        if (select_transitions(sm, evt.event, enabled, &count)) {
            microstep(sm, enabled, count);
        }""")
PY

# ── C11: one budget, not one per branch ────────────────────────────

# Same repair as its C++ AOT twin above, for the same reason: a reset placed
# before the `while` is a no-op, because the counter is already zero when the
# drain is entered and the statement never runs again while the loop turns.
# The doubled ceiling makes the claim the alternating chain can count.
mutation_case "the c11 internal branch budgets itself" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     """    while (sm->internal_queue.count != 0u) {
        if (sm->macrostep_microsteps_taken == SCE_MAX_MACROSTEP_MICROSTEPS) {""",
     """    while (sm->internal_queue.count != 0u) {
        if (sm->macrostep_microsteps_taken == SCE_MAX_MACROSTEP_MICROSTEPS * 2u) {""")
PY
