# Mutation cases for "a record's bytes field is held within the `sce:max-size` its
# schema declares" under the Go backend
# (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A byte string"; docs/adr/0005, decision 2).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_go_record_bytes_field_is_held_within_its_bound_go.cases`.
#
# `static_record_bytes` writes the field from a literal and from a bytes variable and
# expects a value past eight bytes to leave the record as it was and `errors` to count
# it. A Go machine is not saved, so there is no restore to refuse here; the bound is the
# assignment's. `TestAHostThatWritesIntoARecordsBytesItWasHanded...` writes into the
# bytes a record's reader answered and expects the machine not to have moved. The
# mutants take one decision away each:
#
#   a record's bytes field is not among the byte strings an `<assign>` is held to;
#   the reader a record gives a bytes field answers the machine's own slice.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/static_datamodel/
mutation_targets sce-build/src/forge/static_lowering.rs
mutation_targets backends/go/tests/integration/static_datamodel/static_record_bytes/static_record_bytes_sm.go
mutation_regen scripts/regen_static_datamodel_go.sh
mutation_oracles backends/go/tests/integration/static_datamodel/static_scenarios_test.go sce-build/tests/fixtures/static_datamodel/scenarios/static_record_bytes.json

mutation_case "a record's bytes field is not held to its bound by an assignment" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "        .chain(record_field_bounds(variables, &records, |ty| {\n            matches!(ty, SceType::Bytes)\n        }))",
     "        .chain(record_field_bounds(variables, &records, |_| false))")
PY

mutation_case "the reader of a bytes field answers the machine's own slice" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "                let answer = if matches!(field.sce_type, SceType::Bytes) {",
     "                let answer = if false && matches!(field.sce_type, SceType::Bytes) {")
PY
