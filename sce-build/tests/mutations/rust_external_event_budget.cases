# Mutation cases for "a call that drains a self-refilling external queue is
# handed back", Rust runtime.
#
# Run with
# `scripts/mutate sce-build/tests/mutations/rust_external_event_budget.cases`.
#
# A machine that answers an event by sending itself the next one, with no
# target, never lets the external queue empty, and every macrostep of it ends, so
# the microstep ceiling never applies: the call did not return. The Rust engine
# takes at most `max_external_events_per_call` events in one invocation of its
# main event loop, leaves the rest queued, and counts the cut; and it bounds the
# scheduler entries due AT one clock reading popped by one tick by the same
# budget (ARCHITECTURE.md "External-Event Budget", rules 1-5).
# `tests/integration/external_chain_is_bounded.scxml` is the document.
#
# What is easy to get wrong and reads as success: a budget off by one in either
# direction (the chain that ENDS at exactly the budget is the case that tells
# them apart), a refusal that swallows the event it declined (the chain stops
# short and never finishes), a cut that is not counted (the host sees a machine
# that is running and has returned), a counter that outlives its invocation, and
# a same-instant bound that counts what it must not: a clock the host moved a
# long way pops many entries at ONE reading and they are not a runaway.
#
# A mutation that removes a bound leaves the binary spinning, and the harness
# caps every run, so "did not terminate" is the verdict that case is held to.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-rust-tests --test external_chain_is_bounded
mutation_targets backends/rust/runtime/src/engine.rs
mutation_oracles backends/rust/tests/tests/external_chain_is_bounded.rs

# ── The refusal itself ──────────────────────────────────────────────

mutation_case "the drain has no budget at all" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "            if taken >= self.max_external_events_per_call {",
     "            if false {")
PY

mutation_case "the budget is one event more than it says" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "            if taken >= self.max_external_events_per_call {",
     "            if taken > self.max_external_events_per_call {")
PY

mutation_case "the budget is one event fewer than it says" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "            if taken >= self.max_external_events_per_call {",
     "            if taken + 1 >= self.max_external_events_per_call {")
PY

# ── The refusal leaves the queue alone ──────────────────────────────
#
# Popping before asking consumes the event the drain then declines to run. The
# chain is still bounded and the count still moves, so only the `resume` outcome
# can see it: it stops a link short of its end and never finishes, because the
# link that would have continued it was thrown away.

mutation_case "the drain swallows the event it refused" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "                self.record_truncated_event_chain(head);\n                break;\n            }\n            taken += 1;",
     "                self.record_truncated_event_chain(head);\n                let _ = self.external_queue.pop();\n                break;\n            }\n            taken += 1;")
PY

# ── The cut is said ─────────────────────────────────────────────────

mutation_case "a cut is not counted" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "            self.truncated_event_chains = self.truncated_event_chains.saturating_add(1);",
     "            self.truncated_event_chains = self.truncated_event_chains.saturating_add(0);")
PY

mutation_case "the cut does not say which event it was still taking" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "            self.last_truncated_event = head;",
     "            self.last_truncated_event = None;")
PY

# ── The budget is the invocation's own, from a clean start ──────────
#
# A counter that does not begin at zero spends part of the invocation's budget
# before it takes anything, so a chain that ends at exactly the budget is cut one
# event short: the same arithmetic that catches a budget off by one.

mutation_case "an invocation starts with one event already spent" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "        let mut taken: u32 = 0;\n        loop {",
     "        let mut taken: u32 = 1;\n        loop {")
PY

# ── The scheduler cannot refill itself without end ──────────────────
#
# `delayexpr="'0ms'"` is the one way this engine hands a zero delay to its
# scheduler. Without the same-instant bound the tick that pops it finds each
# handler has armed another due at the same reading, and never returns.

mutation_case "the scheduler's same-instant pops have no budget" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "                    if popped_due_at_reading >= self.max_external_events_per_call {",
     "                    if false {")
PY

# The bound must count entries due AT the reading, not every entry popped at it.
# The reading is latched for the whole tick, so a host that jumps the clock eight
# milliseconds pops eight entries at ONE reading, seven of them due earlier: a
# bound on pops at the reading would refuse a legitimate time-driven chain.

mutation_case "the same-instant bound counts entries that came due earlier" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "                if due == now {",
     "                if due <= now {")
PY

# ── What a host may set ─────────────────────────────────────────────

mutation_case "a budget the host sets is ignored" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "        self.max_external_events_per_call = limit.get();",
     "        let _ = limit;")
PY

mutation_case "the default budget is not the documented one" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "pub(crate) const MAX_EXTERNAL_EVENTS_PER_CALL: u32 = 10_000;",
     "pub(crate) const MAX_EXTERNAL_EVENTS_PER_CALL: u32 = 1_000;")
PY
