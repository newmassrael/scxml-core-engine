# Mutation cases for "a C11 machine whose data model is a script engine grows
# each role of its scratch its engine's values are written into in the
# engine's heap" (docs/adr/0086, section 8.6 (d)).
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_c11_script_machine_grows_its_scratch.cases
#
# The test generates two machines with a script engine (one that sends, serves
# a host-served send and runs host-run invocations; one that invokes a child
# with done data, raises a compound final's done data and makes a BasicHTTP
# request) and a typed machine. It asks the script machines' scratch for a
# growing buffer per role, their source for no role sized by a slot, for the
# reserve through the engine's allocator, for the scratch freed with every
# text, for a send's payload grown to its text and for a child's done data
# measured before the scratch is grown to it; and the typed machine for fixed
# storage and a reserve that asks whether the text fits. Each case breaks one
# link: the payload stays a slot, the scratch is never freed, a send's payload
# is held to the buffer's size, and a child's done data is copied unmeasured.
#
# The machine is generated by `sce-codegen`, which the test runs as a
# subprocess, so the generator's source is a target compiled into a binary the
# test spawns.

mutation_tests -p sce-build --features cli --test a_c11_machine_sizes_its_event_data_slot
mutation_targets sce-build/src/forge/c11_scratch.rs tools/codegen/templates/c/state_machine.c.jinja2 tools/codegen/templates/c/invoke_methods.jinja2

mutation_case "a script machine's payload stays a slot" <<'PY'
edit("sce-build/src/forge/c11_scratch.rs",
     "pub const GROWN_IN_THE_SCRATCH: &[&str] = &[\n    \"payload\",\n",
     "pub const GROWN_IN_THE_SCRATCH: &[&str] = &[\n")
PY

mutation_case "the scratch is never freed" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "#endif\n    release_scratch(sm);\n}\n",
     "#endif\n    (void)release_scratch;\n}\n")
PY

mutation_case "a send's payload is held to the buffer's size" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "                    if (!SCE_SCRATCH_RESERVE(payload, _jl + 1u)) {\n",
     "                    if (_jl >= SCE_SCRATCH_CAP(payload)) {\n")
PY

mutation_case "a child's done data is copied unmeasured" <<'PY'
edit("tools/codegen/templates/c/invoke_methods.jinja2",
     "                    const size_t _done_whole = {{ csym_prefix }}{{ stem }}_done_data_wire(&{{ slot }}, NULL, 0u);\n",
     "                    const size_t _done_whole = SCE_SCRATCH_CAP(done);\n")
PY
