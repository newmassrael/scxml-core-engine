# Mutation cases for "the members of a JSON object the Rust runtime writes into
# `_event.data` come in the one order every engine writes" (ARCHITECTURE.md,
# "JSON Object Key Order").
#
# Run with
# `scripts/mutate sce-build/tests/mutations/rust_event_data_key_order.cases`.
#
# The oracle is `helpers::event_data::tests`, which reads
# `tests/json_text/object_key_order.json` and writes each case through
# `build_json_from_typed_params`. The Rust writer already sorted before the
# table existed; what the table adds is something that notices if it stops. A
# reversed order is a deterministic stand-in for any order but the right one:
# an object value is a `HashMap`, whose own iteration order is random, so a
# case that merely dropped the sort would survive by chance.

mutation_tests -p sce-rust-runtime --lib
mutation_targets backends/rust/runtime/src/helpers/event_data.rs
mutation_oracles backends/rust/runtime/src/helpers/event_data.rs

# ── The params a send names come out in the wrong order ────────────

mutation_case "the names of a send's params are written in reverse" <<'PY'
edit("backends/rust/runtime/src/helpers/event_data.rs",
     "    let mut parts: Vec<String> = Vec::new();\n    for (name, values) in params {",
     "    let mut parts: Vec<String> = Vec::new();\n    for (name, values) in params.iter().rev() {")
PY

# ── An object value's members come out in the wrong order ──────────

mutation_case "the members of an object value are written in reverse" <<'PY'
edit("backends/rust/runtime/src/helpers/event_data.rs",
     "keys.sort();",
     "keys.sort_by(|a, b| b.cmp(a));")
PY
