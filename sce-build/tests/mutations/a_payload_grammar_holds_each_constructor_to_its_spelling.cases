# Mutation cases for "the grammar of a schema states one spelling of each value,
# its bounds held exactly" (docs/adr/0087, section 1).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_payload_grammar_holds_each_constructor_to_its_spelling.cases`.
#
# Two folds over the one value type write a payload's JSON Schema and its GBNF
# grammar, one arm per constructor. The goldens of each constructor and the
# range check hold them. The mutants take one decision away each:
#
#   JSON Schema: a text's byte bound, a byte string's one-byte characters, an
#   optional value's `null`, a list's bound, a record's closed set of keys, an
#   integer's upper end, a 64-bit integer's quoted digits, a single's range,
#   and the refusal of an open enum;
#   GBNF: a character's weight in bytes in the chain, the characters of more
#   than one byte, a byte string's one byte a character, a list's bound, an
#   optional value's `null`, the comma between two keys, a 64-bit integer's
#   quotes, a text's bound, and the last digit of a range up to its end;
#   and the order each form writes: a record's keys in the GBNF grammar in
#   the order its document declares them, a JSON Schema's keywords in their
#   one order.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --lib forge::value_type
mutation_targets sce-build/src/forge/value_type.rs
mutation_oracles sce-build/src/forge/value_type.rs

mutation_case "a text's byte bound is stated one past" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     ".with(Keyword::MaxBytes, SchemaNode::value(max.max)),",
     ".with(Keyword::MaxBytes, SchemaNode::value(max.max + 1)),")
PY

mutation_case "a byte string's characters are any character" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     ".with(Keyword::Pattern, SchemaNode::value(latin1_pattern())),",
     ".with(Keyword::Pattern, SchemaNode::value(\"^.*$\")),")
PY

mutation_case "an optional value is never null in the JSON Schema" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "SchemaNode::Schemas(vec![element, null])",
     "SchemaNode::Schemas(vec![element, null][..1].to_vec())")
PY

mutation_case "a list holds one past its bound in the JSON Schema" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     ".with(Keyword::MaxItems, SchemaNode::value(max.max))",
     ".with(Keyword::MaxItems, SchemaNode::value(max.max + 1))")
PY

mutation_case "a record admits a key it does not declare" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     ".with(Keyword::AdditionalProperties, SchemaNode::value(false)))",
     ".with(Keyword::AdditionalProperties, SchemaNode::value(true)))")
PY

mutation_case "an integer's upper end is one past its type's" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     ".with(Keyword::Maximum, SchemaNode::value(narrow(hi)))",
     ".with(Keyword::Maximum, SchemaNode::value(narrow(hi) + 1))")
PY

mutation_case "a 64-bit integer is a JSON number" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "            SchemaObject::typed(\"string\")\n                .with(Keyword::Pattern, SchemaNode::value(regex_range(lo, hi)))",
     "            SchemaObject::typed(\"integer\")\n                .with(Keyword::Pattern, SchemaNode::value(regex_range(lo, hi)))")
PY

mutation_case "a single's range is twice its largest value" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     ".with(Keyword::Maximum, SchemaNode::value(most))",
     ".with(Keyword::Maximum, SchemaNode::value(most * 2.0))")
PY

mutation_case "a record states its keys in ascending order" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "    for (at, (id, field)) in fields.iter().enumerate() {",
     "    let mut fields = fields.to_vec();\n    fields.sort_by(|a, b| a.0.cmp(&b.0));\n    for (at, (id, field)) in fields.iter().enumerate() {")
PY

mutation_case "a schema's keywords stand in ascending order" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "        for (at, (keyword, node)) in self.keywords.iter().enumerate() {",
     "        let mut sorted: Vec<_> = self.keywords.iter().collect();\n        sorted.sort_by_key(|(keyword, _)| keyword.name());\n        for (at, (keyword, node)) in sorted.into_iter().enumerate() {")
PY

mutation_case "an open enum is spelled by its names" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "    if !enumeration.strict {\n        return Err(GrammarError::OpenEnum {",
     "    if !enumeration.strict && false {\n        return Err(GrammarError::OpenEnum {")
PY

mutation_case "every character of a text weighs one byte" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "                    body.push_str(&format!(\" | c{width} t{}\", k - width));",
     "                    body.push_str(&format!(\" | c{width} t{}\", k - 1));")
PY

mutation_case "a text holds no character of more than one byte" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "                for width in 1..=k.min(4) {",
     "                for width in 1..=k.min(1) {")
PY

mutation_case "a byte string's character weighs two" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "                    &format!(\"\\\"\\\" | byte b{}\", k - 1),",
     "                    &format!(\"\\\"\\\" | byte byte b{}\", k - 1),")
PY

mutation_case "a list holds one past its bound in the GBNF grammar" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "                *most = (*most).max(more);",
     "                *most = (*most).max(more + 1);")
PY

mutation_case "an optional value is never null in the GBNF grammar" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "            format!(\"( \\\"null\\\" | {} )\", gbnf(elem, env, rules, on_path)?)",
     "            format!(\"( {} )\", gbnf(elem, env, rules, on_path)?)")
PY

mutation_case "two keys of a record stand with no comma between" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "            literal.push(',');",
     "            literal.push(' ');")
PY

mutation_case "a 64-bit integer is unquoted in the GBNF grammar" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     ".or_insert_with(|| format!(\"{GBNF_QUOTE} ( {} ) {GBNF_QUOTE}\", gbnf_range(lo, hi)));",
     ".or_insert_with(|| format!(\"( {} )\", gbnf_range(lo, hi)));")
PY

mutation_case "a text holds one byte past its bound in the GBNF grammar" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "            format!(\"{GBNF_QUOTE} t{} {GBNF_QUOTE}\", max.max)",
     "            format!(\"{GBNF_QUOTE} t{} {GBNF_QUOTE}\", max.max + 1)")
PY

mutation_case "an escape writes its hex in upper case" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "        EscapeForm::Json | EscapeForm::Gbnf if n <= 0xffff => format!(\"\\\\u{n:04x}\"),",
     "        EscapeForm::Json | EscapeForm::Gbnf if n <= 0xffff => format!(\"\\\\u{n:04X}\"),")
PY

mutation_case "a code point past ASCII is written raw in a GBNF literal" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "        if c.is_ascii() {\n            out.push(c);",
     "        if c.is_ascii() || true {\n            out.push(c);")
PY

mutation_case "a range's last digit stops below its end" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "        let last = if at + 1 == n {\n            digit\n",
     "        let last = if at + 1 == n {\n            digit.saturating_sub(1)\n")
PY
