# Mutation cases for the `<param>`s of a host-served `<invoke>` of a
# `datamodel="sce-static"` machine generated as Python
# (docs/SCE_ACCEPTED_SUBSET.md §2.15).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_python_machines_host_params_are_the_values_it_holds_python.cases`.
#
# A `<param expr>` of such a machine is Python the lowering wrote, read from the
# policy's own attributes when the invocation starts, and the template only places
# it: the value goes into the request as the text the payload renders and, typed,
# into the pairs the request's `event_data` is built from. A value that cannot be
# computed — a checked multiplication that overflows — raises `AlgorithmFailure`,
# and it is the evaluation that failed (W3C SCXML 5.7.1): the pair is left out and
# `error.execution` is raised, while the invocation still starts.
#
# What is easy to get wrong and reads as success: a failure that escapes is a
# machine that stops on a value its document said to skip, and a pair dropped
# without a word is a request that looks complete. `statechart_static_host_params`
# tells both apart: its `boom` is `count * 2000000000`, and `errors` counts the
# reports the document took — one for the send and one for the invoke.
#
# Python compiles nothing and its generated machines are gitignored, so the
# template reaches the tests only through the regeneration declared below. It is a
# `mutation_runtime_targets` for the reason the other Python casefiles give: what
# shows a mutation arrived is that the file on disk differed while the tests ran.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_pytest backends/python/tests integration/host_processor/test_static_host_params.py
mutation_regen scripts/regen_host_processor_python.sh
mutation_runtime_targets tools/codegen/templates/python/invoke_methods.py.jinja2
mutation_oracles backends/python/tests/integration/host_processor/test_static_host_params.py sce-build/tests/fixtures/host_processor/statechart_static_host_params.scxml

# ── A value that cannot be computed is left out ────────────────────

mutation_case "a failure of a param's value escapes the invoke" <<'PY'
edit("tools/codegen/templates/python/invoke_methods.py.jinja2",
     "                except sce_algorithm.AlgorithmFailure:\n                    self._raise_error_execution(\n                        engine, \"<invoke> <param name='\"",
     "                except ZeroDivisionError:\n                    self._raise_error_execution(\n                        engine, \"<invoke> <param name='\"")
PY

# ── ... and reported ───────────────────────────────────────────────

mutation_case "a param whose value failed is left out without a word" <<'PY'
edit("tools/codegen/templates/python/invoke_methods.py.jinja2",
     "                    self._raise_error_execution(\n                        engine, \"<invoke> <param name='\" + {{ param.name | py_string_literal }} + \"'> expr failed to evaluate\"\n                    )\n                else:",
     "                    pass\n                else:")
PY
