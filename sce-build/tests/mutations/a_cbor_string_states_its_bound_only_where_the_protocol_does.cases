# Mutation cases for "a CBOR string states its bound only where the protocol does".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_cbor_string_states_its_bound_only_where_the_protocol_does.cases`.
#
# A CBOR map's text or byte string states the most it holds in its type
# (docs/adr/0101, section 1.3): one that states none is no type of the language,
# and every backend refuses the map at the entry's type. Within its bound, a
# deployment gives the entry a smaller capacity, C11 refuses a text past the
# capacity apart from one past the bound, and a codec `Inline` does not hold
# names no default profile, since that profile is `Inline` with no allocator. A
# defect here is a map that generates around a text with no bound, a capacity
# that sizes nothing, a node's refusal reported as a malformed frame, or a tree
# that does not compile with no allocator.
#
# The oracles are `sce-build/tests/forge_conformance.rs` (the refusal of a text
# with no bound on every backend, a text of 64 bytes on a growing profile and at
# a deployment of eight, C11's arrays and reads at the bound and the capacity,
# and a no-allocator build of every field with no bound) and
# `sce-build/tests/a_c11_codec_holds_what_may_be_absent_in_the_optional_type.rs`
# (the bound and the capacity of each C11 read).
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test forge_conformance --test a_c11_codec_holds_what_may_be_absent_in_the_optional_type
mutation_targets sce-build/src/forge/cbor_codec.rs sce-build/src/forge/model.rs sce-build/src/forge/generator.rs sce-build/src/forge/value_type.rs tools/codegen/templates/forge/c/codec_cbor.h.jinja2
mutation_oracles sce-build/tests/forge_conformance.rs sce-build/tests/a_c11_codec_holds_what_may_be_absent_in_the_optional_type.rs

# A CBOR text that states no bound is let through at a bound of one byte, so the
# map generates where every backend refuses it at the entry's type. Killed by
# `a_cbor_text_with_no_bound_is_refused_at_its_type_on_every_backend`. The case
# this replaces cut the owned mirror of a map whose text has no bound; since the
# parser refuses such a map, no codec reaches that mirror, and the cut survived.
mutation_case "a map's text with no bound is let through" <<'PY'
edit("sce-build/src/forge/value_type.rs",
     "            Self::Text { max } => ValueType::Text {\n                max: required(max)?,\n            },\n",
     "            Self::Text { max } => ValueType::Text {\n                max: max.unwrap_or(Bound::of(1)),\n            },\n")
PY

# A capacity the deployment gives an entry that sizes nothing leaves C11 with no
# array for it and Rust with no store at it. Killed by
# `c11_holds_a_cbor_text_at_its_bound_or_the_capacity_it_is_given`
# (`char note[8];`) and
# `a_cbor_text_is_held_within_its_bound_and_a_deployment_capacity`.
mutation_case "a CBOR entry's capacity is dropped" <<'PY'
edit("sce-build/src/forge/model.rs",
     r'''                HeldAt::Entry(at) => self.cbor_entries[at].capacity = Some(capacity),''',
     r'''                HeldAt::Entry(_) => {}''')
PY

# A C11 read handed its capacity as its bound reports a node's refusal as a
# malformed frame. Killed by
# `a_c11_codec_holds_what_may_be_absent_in_the_optional_type` (`64U, 64`).
mutation_case "a C11 read takes no bound apart from its capacity" <<'PY'
edit("sce-build/src/forge/cbor_codec.rs",
     r'''                .map_or_else(|| "SIZE_MAX".to_string(), |max| format!("{max}U"))''',
     r'''                .map_or_else(|| "SIZE_MAX".to_string(), |_| "SIZE_MAX".to_string())''')
PY

# A C11 map answers a text past its capacity before its own rules, so one frame
# has two answers across C11 and Rust. Killed by
# `c11_holds_a_cbor_text_at_its_bound_or_the_capacity_it_is_given` (the read is
# wrapped in `sce_forge_codec_note_capacity`) and
# `a_c11_codec_holds_what_may_be_absent_in_the_optional_type`.
mutation_case "a C11 map answers a capacity at the text past it" <<'PY'
edit("tools/codegen/templates/forge/c/codec_cbor.h.jinja2",
     r'''            s = sce_forge_codec_note_capacity(sce_forge_cbor_read_text(&c, {{ e.bound }}, {{ e.capacity }}, v->{{ e.data_ref }}, &{{ ("v->" ~ e.len_ref) if e.len_ref else "text_len" }}), &over);''',
     r'''            s = sce_forge_cbor_read_text(&c, {{ e.bound }}, {{ e.capacity }}, v->{{ e.data_ref }}, &{{ ("v->" ~ e.len_ref) if e.len_ref else "text_len" }});''')
PY

# A codec `Inline` does not hold given the default profile names `Inline` with
# no allocator, and the tree does not compile there. Killed by
# `what_has_no_bound_compiles_on_the_heap_free_tier`.
mutation_case "every codec has a default profile" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''            codec_inline_holds(m, imports).into(),''',
     r'''            true.into(),''')
PY
