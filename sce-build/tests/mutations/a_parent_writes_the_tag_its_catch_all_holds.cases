# Mutation cases for "a parent writes the tag its catch-all holds".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_parent_writes_the_tag_its_catch_all_holds.cases`.
#
# A parent whose carrier holds, in a flag, the tag of a variant it embeds
# derives the flag's bits from the arm the embedded body holds; a catch-all
# body holds the tag no arm names, and that tag, masked to the flag's width,
# is what the parent writes (ADR 0058). The flag is the body's, so the encode
# clears it in the stored carrier before it adds the derived bits. C and Go
# once added nothing for a catch-all body, C++ and Python the bits of the
# last arm, Kotlin named no catch-all in its `when`, and each added the
# derived bits to the stored flag. Each case below breaks one part of the
# rule: the derivation forgets the catch-all, a backend leaves the catch-all
# out of its term or writes the tag unmasked or unshifted, Kotlin parts its
# entries so that one reads as a type test, or a carrier write keeps the
# stored flag.
# `sce-build/tests/a_parent_writes_the_tag_its_catch_all_holds.rs` refuses
# them by the term and the carrier write each backend renders and, where a
# backend's toolchain is present, by a decode and encode of two frames whose
# stored flag is made stale. The runs do not reach the gated C++ chain or the
# unmasked tag: their variant has no gated arm, and their tags fill the flag.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --test a_parent_writes_the_tag_its_catch_all_holds
mutation_targets sce-build/src/forge/generator.rs
mutation_oracles sce-build/tests/a_parent_writes_the_tag_its_catch_all_holds.rs

mutation_case "the derivation forgets the embedded variant's catch-all" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''                catch_all: imp.codec_variant_has_catch_all,''',
     r'''                catch_all: false,''')
PY

# ── The C++ parent ──

mutation_case "a C++ parent leaves the catch-all's term out of its chain" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''    if let Some(term) = catch_all {
        chain.push_str(&format!("{term} : "));
    }''',
     r'''    let _ = catch_all;''')
PY

mutation_case "a C++ parent of a gated variant leaves the catch-all's term out" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''        chain.push_str(&format!("            {term} :\n"));''',
     r'''        let _ = term;''')
PY

mutation_case "a C++ parent writes the catch-all's tag unmasked" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''->tag & 0x{mask:X}u) << {})",''',
     r'''->tag) << {})",''')
PY

# ── The C parent ──

mutation_case "a C parent has no case for a catch-all body" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''    if d.catch_all {
        switch_block.push_str(&format!(
            "    case {embed_upper}_BODY_KIND_DEFAULT:''',
     r'''    if d.catch_all && d.bit == u32::MAX {
        switch_block.push_str(&format!(
            "    case {embed_upper}_BODY_KIND_DEFAULT:''')
PY

mutation_case "a C parent adds the catch-all's tag without shifting it to the flag" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''u) << {}); break;\n",
            d.bit
        ));''',
     r'''u) << {}); break;\n",
            0u32
        ));''')
PY

# ── The Python, Go and Kotlin parents ──

mutation_case "a Python parent leaves the catch-all out of its term" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''    if d.catch_all {
        inner = format!(''',
     r'''    if d.catch_all && d.bit == u32::MAX {
        inner = format!(''')
PY

mutation_case "a Go parent has no case for a catch-all body" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''    if d.catch_all {
        switch_block.push_str(&format!(
            "\tcase {embed}.Body.Default != nil:''',
     r'''    if d.catch_all && d.bit == u32::MAX {
        switch_block.push_str(&format!(
            "\tcase {embed}.Body.Default != nil:''')
PY

mutation_case "a Kotlin parent's when names no catch-all" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''    if d.catch_all {
        arms.push(format!(''',
     r'''    if d.catch_all && d.bit == u32::MAX {
        arms.push(format!(''')
PY

mutation_case "a Kotlin parent parts its when entries by a space" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''    let arms_str = arms.join("; ");''',
     r'''    let arms_str = arms.join(" ");''')
PY

# ── The carrier write ──

mutation_case "no carrier write clears the flags the bodies fill" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''                keep: !filled & 0xFF,''',
     r'''                keep: 0xFF,''')
PY

mutation_case "a C and C++ carrier write keeps the stored flag" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''        Language::Cpp | Language::C11 => format!("({stored} & 0x{keep:02X}u) | {local}"),''',
     r'''        Language::Cpp | Language::C11 => format!("{stored} | {local}"),''')
PY

mutation_case "a Python and Go carrier write keeps the stored flag" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''            format!("({stored} & 0x{keep:02X}) | {local}")''',
     r'''            format!("{stored} | {local}")''')
PY

mutation_case "a Kotlin carrier write keeps the stored flag" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''        Language::Kotlin => format!("(({stored} and 0x{keep:02X}u.toUByte()) or {local})"),''',
     r'''        Language::Kotlin => format!("({stored} or {local})"),''')
PY
