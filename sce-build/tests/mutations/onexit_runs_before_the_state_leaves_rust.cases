# Mutation cases for §scxml-D-exitStates — a state leaves the configuration
# AFTER its own <onexit> has run: onexit, then cancelInvoke, then
# configuration.delete(s).
#
# Run with `scripts/mutate sce-build/tests/mutations/onexit_runs_before_the_state_leaves_rust.cases`.
#
# Measured 2026-09-26: the Rust channel had the order backwards — the
# generated exit deactivated the state first and ran the handler last, so
# `In(s)` inside s's own <onexit> answered false. The configuration after the
# microstep is the same either way, which is why no fixture before
# `integration_resources/onexit_runs_before_the_state_leaves/` noticed. This
# file is its witness: it puts the old order back and asks whether the
# fixture's own driver goes red.
#
# Anchors are literal slices of the committed generated source.
# `scripts/regen_onexit_runs_before_the_state_leaves.sh` rewrites that file, so
# a regeneration that changes the exit function needs these anchors re-cut
# (`scripts/mutate --check` reports it).

mutation_tests -p sce-rust-tests --test onexit_runs_before_the_state_leaves
mutation_targets backends/rust/tests/src/integration/onexit_runs_before_the_state_leaves/onexit_runs_before_the_state_leaves_sm.rs
mutation_oracles backends/rust/tests/tests/onexit_runs_before_the_state_leaves.rs

# ── The state leaves before its handler runs ────────────────────────
#
# The deactivation moves back to the head of the exit, ahead of the <onexit>
# match — the order this channel generated until the round that added the
# fixture. `In('inner')` inside `inner`'s own handler then answers false and
# the document lands in `failSelfInInner`.

mutation_case "the state is deactivated before its own onexit runs" <<'PY'
edit("backends/rust/tests/src/integration/onexit_runs_before_the_state_leaves/onexit_runs_before_the_state_leaves_sm.rs",
     """        // own handler is true: the deactivation is the LAST step here.
        match state {""",
     """        // own handler is true: the deactivation is the LAST step here.
        self.deactivate(state);
        match state {""")
edit("backends/rust/tests/src/integration/onexit_runs_before_the_state_leaves/onexit_runs_before_the_state_leaves_sm.rs",
     """        // and invoke cancellation — the configuration.delete(s) step.
        self.deactivate(state);
    }""",
     """        // and invoke cancellation — the configuration.delete(s) step.
    }""")
PY
