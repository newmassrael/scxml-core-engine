# Mutation cases for "a marker names where a state was written".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_marker_names_where_a_state_was_written.cases`.
#
# The templates stamp SCE-MAP markers from the positions the model copy a
# backend renders from carries, and the model records positions against the
# expanded text. `SCXMLModel::into_artifact_coordinates` moves that copy's
# positions to where they were written. Each case puts part of that back: the
# move skipped for a backend, a kind of position the walk no longer reaches,
# or the map kept after the move. The `--emit-ast` envelope is built from the
# same move and is held with it. The integration tests
# `a_marker_names_where_a_state_was_written.rs` and
# `an_ast_export_names_where_a_node_was_written.rs` and the
# `artifact_coordinates` unit tests in `model.rs` refuse them.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --lib --test a_marker_names_where_a_state_was_written --test an_ast_export_names_where_a_node_was_written
mutation_targets sce-build/src/generator.rs sce-build/src/model.rs sce-build/src/forge/ast_export.rs
mutation_oracles sce-build/tests/a_marker_names_where_a_state_was_written.rs sce-build/tests/an_ast_export_names_where_a_node_was_written.rs sce-build/src/model.rs

mutation_case "the AST envelope carries the expanded text's rows" <<'PY'
edit("sce-build/src/forge/ast_export.rs",
     r'''    model.into_artifact_coordinates();
    ParsedForge {''',
     r'''    let _ = &mut model;
    ParsedForge {''')
PY

mutation_case "the Rust backend renders the expanded text's rows" <<'PY'
edit("sce-build/src/generator.rs",
     r'''    model_lowered.into_artifact_coordinates();
    let ctx = minijinja::context! {''',
     r'''    let ctx = minijinja::context! {''')
PY

mutation_case "a transition keeps the expanded text's row" <<'PY'
edit("sce-build/src/model.rs",
     r'''                visit_optional(&mut transition.source_location, visit);''',
     r'''                let _ = &transition.source_location;''')
PY

mutation_case "an action inside an if keeps the expanded text's row" <<'PY'
edit("sce-build/src/model.rs",
     r'''        for block in action.nested_blocks_mut() {
            visit_action_locations(block, visit);
        }''',
     r'''        let _ = action.nested_blocks_mut();''')
PY

mutation_case "a state's invoke keeps the expanded text's row" <<'PY'
edit("sce-build/src/model.rs",
     r'''            for invoke in &mut state.invokes {
                visit_invoke_locations(invoke.base_mut(), visit);
            }''',
     r'''            let _ = &state.invokes;''')
PY

mutation_case "a donedata param keeps the expanded text's row" <<'PY'
edit("sce-build/src/model.rs",
     r'''                for param in &mut donedata.params {
                    visit_optional(&mut param.source_location, visit);
                }''',
     r'''                let _ = &donedata.params;''')
PY

mutation_case "the moved copy keeps the map its positions left" <<'PY'
edit("sce-build/src/model.rs",
     r'''        let Some(positions) = self.authored_positions.take() else {''',
     r'''        let Some(positions) = self.authored_positions.clone() else {''')
PY
