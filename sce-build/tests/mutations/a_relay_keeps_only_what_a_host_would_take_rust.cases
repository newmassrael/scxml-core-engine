     "                if request.len() > self.limits.max_request_bytes {",
     "                if false {")
PY

mutation_case "A relay does not spend a device's allowance on its requests" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     ".take(&session.list, session.node, cost, now_ms, &self.limits)",
     ".take(&session.list, session.node, cost, now_ms, &self.limits)\n                .or(Ok(()))")
PY

mutation_case "A relay asks no role of a session for what it asks" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "        if role < needs {",
     "        if false {")
PY

mutation_case "A reader may submit, check, and publish what only a writer may" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "            | Request::PublishWelcome { .. } => WRITER,",
     "            | Request::PublishWelcome { .. } => READER,")
PY

mutation_case "A device that is no member reads the feed, the ranges and the heads" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "Request::Feed { .. } | Request::Operations { .. } | Request::Heads => READER,",
     "Request::Feed { .. } | Request::Operations { .. } | Request::Heads => 0,")
PY

