# Mutation cases for what a relay of a shared list checks before it keeps anything and before it gives
# anything back (ADR 0034): the token that names a device (its tag, its time, its audience, the list it
# is for), the allowance of each device and the bounds on a request, who may ask what (a reader, a
# stranger, a device taken off), what is kept once, the feed and the ranges it is read by, what a store
# is held to when a relay starts from it, and the bounds on the MLS messages a relay keeps for a group.
#
# Each case takes one of those checks away or weakens it, and the tests under study must turn red.
# A check no test notices is a check nothing holds in place.
#
# Run with `scripts/mutate sce-build/tests/mutations/a_relay_keeps_only_what_a_host_would_take_rust.cases`.
#
# Anchors are literal slices of the source; an edit that moves one is reported INCONCLUSIVE with the
# anchor quoted, never as a pass.

mutation_tests -p sce-rust-relay --lib --test a_relay_keeps_what_members_signed_and_reads_none_of_it
mutation_targets backends/rust/relay/src/relay.rs backends/rust/relay/src/token.rs backends/rust/relay/src/limits.rs backends/rust/relay/src/store.rs backends/rust/relay/src/protocol.rs backends/rust/relay/src/client.rs
mutation_oracles backends/rust/relay/tests/a_relay_keeps_what_members_signed_and_reads_none_of_it.rs

# ── What a courier gives a relay that shows a device's conflict, and tells a machine ──────────

mutation_case "A courier does not give the relay the proof of a device's conflict" <<'PY'
edit("backends/rust/relay/src/client.rs",
     "            if self.evidence_sent.contains(&data) {",
     "            if true {")
PY

mutation_case "A courier tells the machine an operation that is held only as proof" <<'PY'
edit("backends/rust/relay/src/client.rs",
     "                    if (taken.new || redeliver) && taken.applied {",
     "                    if taken.new || redeliver {")
PY

mutation_case "A courier does not say that the machine is to forget what the host stopped holding" <<'PY'
edit("backends/rust/relay/src/client.rs",
     "        round.evicted = self.trust.take_evicted();",
     "        round.evicted = Vec::new();")
PY

# ── A token: the tag, the time, the audience, the list ────────────────────────────────────────

mutation_case "A relay takes a token whose tag is not the one its secret makes" <<'PY'
edit("backends/rust/relay/src/token.rs",
     "    if !equal(&hmac_sha256(&self.secret, &payload), &tag) {",
     "    if !equal(&hmac_sha256(&self.secret, &payload), &tag) && false {")
PY

mutation_case "A relay takes a token whose tag is shorter or longer than the one its secret makes" <<'PY'
edit("backends/rust/relay/src/token.rs",
     "a.len() == b.len() && a.iter()",
     "a.iter()")
PY

mutation_case "A relay takes a token in the very millisecond it expires" <<'PY'
edit("backends/rust/relay/src/token.rs",
     "        if now_ms >= expires {",
     "        if now_ms > expires {")
PY

mutation_case "A relay takes a token that another relay issued under the same secret" <<'PY'
edit("backends/rust/relay/src/token.rs",
     "        if audience != self.audience {",
     "        if audience != self.audience && false {")
PY

mutation_case "A token names the audience where it should name the list" <<'PY'
edit("backends/rust/relay/src/token.rs",
     "            list: list.to_string(),",
     "            list: audience.to_string(),")
PY

# ── The allowance of a device ─────────────────────────────────────────────────────────────────

mutation_case "A device that holds exactly what a request costs is made to wait" <<'PY'
edit("backends/rust/relay/src/limits.rs",
     "        if *held >= wanted {",
     "        if *held > wanted {")
PY

mutation_case "A device that was away gains more than its burst" <<'PY'
edit("backends/rust/relay/src/limits.rs",
     "        *held = held.saturating_add(gained).min(capacity);",
     "        *held = held.saturating_add(gained);")
PY

mutation_case "A relay that refills nothing divides by the nothing" <<'PY'
edit("backends/rust/relay/src/limits.rs",
     "        } else if refill == 0 {",
     "        } else if false {")
PY

mutation_case "A device that is new to the relay starts with nothing" <<'PY'
edit("backends/rust/relay/src/limits.rs",
     "            .or_insert((capacity, now_ms));",
     "            .or_insert((0, now_ms));")
PY

mutation_case "The devices of a list spend one allowance between them" <<'PY'
edit("backends/rust/relay/src/limits.rs",
     "            .entry((list.to_string(), node))",
     "            .entry((list.to_string(), node.min(1)))")
PY

mutation_case "The lists of a relay spend one allowance between them" <<'PY'
edit("backends/rust/relay/src/limits.rs",
     "            .entry((list.to_string(), node))",
     "            .entry((list.chars().take(0).collect::<String>(), node))")
PY

