# ── A relay that starts from a store holds it to the checks that took each record in ──────────

mutation_case "A relay starts from an operation in its store that does not verify" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "Record::Operation { event, data } => trust\n            .take_operation(event, data)\n            .map(|taken| taken.new)\n            .map_err(|error| match error {\n                TakeError::NotReached(reason)\n                | TakeError::NoKey(reason)\n                | TakeError::Refused(reason) => (Code::Invalid, reason),\n            }),",
     "Record::Operation { .. } => Ok(true),")
PY

mutation_case "A relay starts from a store and passes over a record that does not verify" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "Err((_, reason)) => {\n                    return Err(invalid_data(format!(\n                        \"record {index} of `{list}` does not verify: {reason}\"\n                    )))\n                }",
     "Err((_, _reason)) => {}")
PY

mutation_case "A relay starts from a checkpoint in its store that does not verify" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "Record::Checkpoint(text) => {\n            let checkpoint = Checkpoint::from_json(text)\n                .ok_or((Code::Invalid, \"it is not a checkpoint\".to_string()))?;\n            trust\n                .take_checkpoint(&checkpoint)\n                .map_err(|error| (Code::Invalid, format!(\"{error:?}\")))\n        }",
     "Record::Checkpoint(_) => Ok(true),")
PY

mutation_case "A store reads the last line a crash cut off as a record" <<'PY'
edit("backends/rust/relay/src/store.rs",
     "            let complete = text.rfind('\\n').map_or(0, |end| end + 1);",
     "            let complete = text.len();")
PY

