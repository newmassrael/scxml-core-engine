# Mutation cases for docs/adr/0096 on the C++ channel: a machine whose script
# session cannot be established does not start, and its host is told why; an
# invoked child that cannot start is a failed invoke.
#
# Run with `scripts/mutate sce-build/tests/mutations/a_cpp_machine_whose_script_session_fails_does_not_start.cases`.
#
# Establishing a session used to be lazy, logged and marked done whatever
# happened: `createSession`'s answer was discarded, a bind that failed was a
# log line, `ensureScriptEngine` made the session again at the first use, and
# the machine ran over a session it did not have, every condition an error.
# Each case below puts back one piece of that shape and names the assertion
# that must go red. The script engine of the oracle is a double over the
# build's engine that fails the step a case asks for, so the failure is
# reached through the engine a generated machine is handed, as a host's would
# be.
#
# The machines are generated when the tests are built, so there is no
# committed tree to regenerate: the build is what carries a mutated template
# into them.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^IntegrationTests$'
mutation_targets sce/include/static/StaticExecutionEngine.h tools/codegen/templates/scriptengine_helpers.jinja2 tools/codegen/templates/invoke_methods.jinja2
mutation_oracles tests/integration/AMachineWhoseScriptSessionFailsDoesNotStartAotTest.cpp integration_resources/a_child_may_send_many_events_in_one_tick/a_child_may_send_many_events_in_one_tick.scxml

# ── The start goes on past a session that failed ────────────────────
#
# The engine drops the policy's failure and enters the initial configuration
# anyway: the old shape, with the failure now reported to nobody.
# Killer: `AStartWhoseSessionCannotBeEstablishedIsRefusedWithTheStep`, whose
# `ASSERT_TRUE(refused.has_value())` finds a start that succeeded.

mutation_case "the start enters the machine past a session that failed" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     """            if (auto failure = policy_.initializeDataModel(*this)) {
                SCE_LOG_ERROR("AOT initialize: the start is refused - {}", failure->describe());
                return failure;
            }""",
     """            static_cast<void>(policy_.initializeDataModel(*this));""")
PY

# ── The resumed start goes on past a session that failed ────────────
#
# Killer: `AResumedStartWhoseSessionCannotBeEstablishedIsRefused`, which finds
# `enterAt` answering `None`.

mutation_case "enterAt enters the configuration past a session that failed" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     """            if (auto failure = policy_.initializeDataModel(*this)) {
                SCE_LOG_ERROR("AOT enterAt: refused — {}", failure->describe());
                return SCE::Core::ConfigurationVerdict{SCE::Core::ConfigurationRejection::ScriptSessionUnavailable,
                                                       std::move(failure)};
            }""",
     """            static_cast<void>(policy_.initializeDataModel(*this));""")
PY

# ── A bind that failed is a log line again ──────────────────────────
#
# The generated policy logs the failed bind and carries on initializing the
# datamodel in a session whose system variables are not there.
# Killers: `AStartWhoseSessionCannotBeEstablishedIsRefusedWithTheStep` (its
# `system-variables` round starts) and
# `ASessionWhoseSystemVariablesCannotBeBoundIsReleased` (nothing is destroyed).

mutation_case "a failed bind of the system variables is logged and passed over" <<'PY'
edit("tools/codegen/templates/scriptengine_helpers.jinja2",
     """            SCE_LOG_ERROR("AOT initializeDataModel: Failed to setup system variables: {}", setupResult.getErrorMessage());
            scriptEngine.destroySession(sessionId_.value());
            return ::SCE::ScriptSessionFailure{::SCE::ScriptSessionStage::SystemVariables, setupResult.getErrorMessage()};
        }""",
     """            SCE_LOG_ERROR("AOT initializeDataModel: Failed to setup system variables: {}", setupResult.getErrorMessage());
        }""")
PY

# ── A session that failed is marked established ─────────────────────
#
# The first start is refused, and the flag says the session is there, so the
# next start finds it "done" and runs the machine over no session.
# Killer: `ARefusedStartIsRefusedAgainRatherThanRunWithoutASession`, whose
# second start succeeds.

mutation_case "a session whose creation failed is marked established" <<'PY'
edit("tools/codegen/templates/scriptengine_helpers.jinja2",
     """                          sessionId_.value(), failure->describe());
            return failure;""",
     """                          sessionId_.value(), failure->describe());
            scriptEngineInitialized_ = true;
            return failure;""")
PY

# ── The refused child is kept ──────────────────────────────────────
#
# The parent keeps the child whose start was refused, in its slot and its
# table of invocations, and goes on as if it had started.
# Killer: `AChildWhoseSessionFailsLeavesItsParentWithErrorExecutionAndNoChild`,
# whose `isChildSessionRunning` finds it.

mutation_case "the child whose start was refused is kept" <<'PY'
edit("tools/codegen/templates/invoke_methods.jinja2",
     """                            {{ slot }}->detachMesh();
                            activeInvokes_.erase("{{ invoke_info.invoke_id }}");
                            {{ slot }}.reset();
{% if 'error.execution' in model.events %}""",
     """{% if 'error.execution' in model.events %}""")
edit("tools/codegen/templates/invoke_methods.jinja2",
     """{% endif %}
                            return;
                        }
{% endmacro %}""",
     """{% endif %}
                        }
{% endmacro %}""")
PY

# ── The refused child raises nothing ───────────────────────────────
#
# The invoke ends without a child and without telling the document.
# Killer: `AChildWhoseSessionFailsLeavesItsParentWithErrorExecutionAndNoChild`,
# whose `lastUnhandledError` finds no error.execution.

mutation_case "the child whose start was refused raises no error.execution" <<'PY'
edit("tools/codegen/templates/invoke_methods.jinja2",
     """{% if 'error.execution' in model.events %}
                            engine.raise(typename Engine::EventWithMetadata(Event::Error_execution,
                                std::string("<invoke id='") + {{ invoke_named }} +""",
     """{% if false %}
                            engine.raise(typename Engine::EventWithMetadata(Event::Error_execution,
                                std::string("<invoke id='") + {{ invoke_named }} +""")
PY
