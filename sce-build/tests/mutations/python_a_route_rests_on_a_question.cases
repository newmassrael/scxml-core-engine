# Mutation cases for "the Python engine gives back the question an unanswered send's route rested on".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/python_a_route_rests_on_a_question.cases`.
#
# A draft routes a notice from a data item (`targetexpr="callerTarget"`) because a send
# needs a target, while the specification never says who the caller is, and marks the
# item as an open question. Played, the send raises `error.communication` and nothing
# answers it; a host that plays the design to its owner needs to say that the failure is
# the owner's question showing through, not a fault of the document. The generated machine
# raises a failure OF THE ROUTE with the questions the route rests on
# (`raise_internal(..., rests_on=...)`); the engine holds them with the `error.*` event and
# gives them back for the last one nothing answered (`last_unhandled_error_rests_on`).
#
# Things easy to get wrong and read as success: the question lost on the way, the question
# given to an error the route did not raise (a wrong question named is worse than none), the
# question given back for an error the document answered, and an entry kept after the error
# that carried it has been taken, which no public question can see and a machine that fails
# for long enough would pay for.
#
# The generated half (which places of a send hand the questions on, and which do not) is
# held by the Rust casefile `a_send_whose_route_is_computed_says_what_it_rests_on.cases`,
# whose round runs the generator the templates are embedded in. This one holds the engine.
#
# Python compiles nothing, so its sources are its artifacts and every edit here is a
# `mutation_runtime_targets`. The machine this suite imports is GENERATED and gitignored,
# which is why the regeneration below is declared.

mutation_pytest backends/python/tests integration/route_rests_on_a_question/
mutation_regen scripts/regen_route_rests_on_a_question_python.sh
mutation_runtime_targets backends/python/runtime/sce_runtime/engine.py
mutation_runtime_targets backends/python/runtime/sce_runtime/scheduler.py
mutation_oracles backends/python/tests/integration/route_rests_on_a_question/test_route_rests_on_a_question_aot.py

# ── The question travels with the error ─────────────────────────────

mutation_case "the error is queued without the question" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "            self._queued_route_failures[metadata.send_id] = rests_on",
     "            self._queued_route_failures[metadata.send_id] = ()")
PY

mutation_case "the question is never held for the error" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "        if rests_on and metadata.send_id:",
     "        if False and rests_on and metadata.send_id:")
PY

mutation_case "the question is never recorded against the unanswered error" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "                self._last_unhandled_error_rests_on = rests_on\n",
     "")
PY

mutation_case "the accessor gives back nothing" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "        return self._last_unhandled_error_rests_on",
     "        return ()")
PY

# ── Whose question it is ────────────────────────────────────────────

mutation_case "an error raised with no question is given the last one's" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "                self._last_unhandled_error_rests_on = rests_on\n",
     "                self._last_unhandled_error_rests_on = rests_on or self._last_unhandled_error_rests_on\n")
PY

# ── A delayed send is refused long after its site returned ──────────
#
# The refusal of a delayed send is made by the scheduler when the wait is over, so the
# questions have to ride the entry: armed with, kept by, handed to the drain, and raised
# with. Each case below drops one of those hand-overs.

mutation_case "a delayed entry forgets the questions it was armed with" <<'PY'
edit("backends/python/runtime/sce_runtime/scheduler.py",
     "                rests_on=rests_on,\n",
     "")
PY

mutation_case "a delayed routed send is armed without its questions" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "self._now_ms + delay_ms, sendid, event, data, route=route, rests_on=rests_on",
     "self._now_ms + delay_ms, sendid, event, data, route=route")
PY

mutation_case "a delayed host send is armed without its questions" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "self._now_ms + delay_ms, sendid, None, \"\", host_send=request, rests_on=rests_on",
     "self._now_ms + delay_ms, sendid, None, \"\", host_send=request")
PY

mutation_case "the drain hands a routed send's refusal no questions" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "entry.event, entry.sendid, entry.data, entry.route, entry.rests_on",
     "entry.event, entry.sendid, entry.data, entry.route")
PY

mutation_case "the drain hands a host send's refusal no questions" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "self._perform_deferred_host_send(entry.host_send, entry.rests_on)",
     "self._perform_deferred_host_send(entry.host_send)")
PY

mutation_case "an invocation gone at the deadline is reported without the questions" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "                EventMetadata(send_id=sendid, event_type=\"platform\"),\n                rests_on=rests_on,\n",
     "                EventMetadata(send_id=sendid, event_type=\"platform\"),\n")
PY

mutation_case "a host act nobody performed is reported without the questions" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "            EventMetadata(send_id=request.send_id, event_type=\"platform\"),\n            rests_on=rests_on,\n",
     "            EventMetadata(send_id=request.send_id, event_type=\"platform\"),\n")
PY

# ── How long it is held ─────────────────────────────────────────────

mutation_case "a question outlives the error that carried it" <<'PY'
edit("backends/python/runtime/sce_runtime/engine.py",
     "                self._queued_route_failures.pop(evt.metadata.send_id, ())",
     "                self._queued_route_failures.get(evt.metadata.send_id, ())")
PY
