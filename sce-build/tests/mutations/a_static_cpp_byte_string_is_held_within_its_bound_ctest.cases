# Mutation cases for "a bytes variable is held within the `sce:capacity` it declares"
# under the C++ backend (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A byte string";
# docs/adr/0005, decision 2).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_cpp_byte_string_is_held_within_its_bound_ctest.cases`.
#
# `static_bytes` assigns a bytes variable from a literal and from another one, and
# expects a value past the bound to leave the variable as it was and `errors` to count
# it. A C++ machine is not saved, so the bound is the assignment's, and the scenario reads
# each value through its reader as its Latin-1 text; the test also asserts, where it is
# compiled, that a published byte string is lent as a constant reference. The mutants take
# one decision away each:
#
#   an assignment to a byte string is not held to its bound;
#   a published byte string is handed out as a copy and not lent as a constant reference.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^static_datamodel_generated_cpp$'
mutation_targets sce-build/src/forge/static_lowering.rs
mutation_oracles tests/integration/AStaticDatamodelRunsGeneratedCppTest.cpp sce-build/tests/fixtures/static_datamodel/scenarios/static_bytes.json

mutation_case "an assignment to a byte string is not held to its bound" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "            } else if let Some(capacity) = rewrites.bytes.get(location) {",
     "            } else if let Some(capacity) = rewrites.bytes.get(location).filter(|_| false) {")
PY

mutation_case "a published byte string is handed out as a copy" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "            SceType::Bytes => Some(\"const std::vector<uint8_t>&\".to_string()),",
     "            SceType::Bytes => None,")
PY
