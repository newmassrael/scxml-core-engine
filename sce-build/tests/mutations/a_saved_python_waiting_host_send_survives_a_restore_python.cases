# Mutation cases for a delayed `<send>` the host serves, saved and restored under the Python
# backend (docs/SCE_ACCEPTED_SUBSET.md section 2.15, "Saving and restoring"; docs/adr/0045,
# section 3): a waiting host-served send is saved with the request it will make when the wait
# ends (its target, its params, its data and its id) and the moment it comes due, and a restore
# hands the host that request, not one evaluated again with what the machine holds now.
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_saved_python_waiting_host_send_survives_a_restore_python.cases`.
#
# `statechart_static_delayed_host_send.scxml` arms a send with `job` 7, `bump` changes `job` to
# 8 after, and the machine is saved 100 ms into a wait of 500 ms. The test holds the saved text
# to the shared one, restores it 50 ms after the save and reads the request the host is handed
# when the wait ends, then cancels the restored send by its id. The mutants below each take one
# decision away and leave a runtime that still imports and runs:
#
#   a save does not write the target of the request;
#   a save does not write the params of the request;
#   a restore hands the host a request without its target;
#   a restore hands the host a request without its params;
#   a restore hands the host a request without its data;
#   a restored send is armed under no id, so a cancel does not find it;
#   a restored send comes due at once, not when its saved moment does.
#
# The generated machines are gitignored and are regenerated before the tests; every edit here is
# to the runtime, which is read from disk on every run, the evidence the harness asks of a
# runtime target.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_pytest backends/python/tests integration/host_processor/test_a_generated_machines_waiting_host_send_survives_a_restore.py
mutation_regen scripts/regen_host_processor_python.sh
mutation_runtime_targets backends/python/runtime/sce_runtime/saved_engine.py
mutation_oracles backends/python/tests/integration/host_processor/test_a_generated_machines_waiting_host_send_survives_a_restore.py sce-build/tests/fixtures/host_processor/statechart_static_delayed_host_send.scxml sce-build/tests/fixtures/host_processor/saved/statechart_static_delayed_host_send_waiting.json

## What a save writes of the request
#
# `act.target == "job://report"` in
# `test_a_waiting_send_is_saved_with_the_request_it_was_armed_with`, and the saved text differs
# from the shared one.

mutation_case "a save does not write the target of the request" <<'PY'
edit("backends/python/runtime/sce_runtime/saved_engine.py",
     "                target=request.target,",
     "                target=\"\",")
PY

# `act.params == {"job": ["7"], "label": ["report"]}` in the same test.

mutation_case "a save does not write the params of the request" <<'PY'
edit("backends/python/runtime/sce_runtime/saved_engine.py",
     "                content=request.content,\n                params=_clone_params(request.params),\n                send_id=request.send_id,",
     "                content=request.content,\n                params={},\n                send_id=request.send_id,")
PY

## What a restore hands the host
#
# The request the host is handed names no target: the assertion on
# `(request.processor_type, request.event_name, request.target, request.send_id)` in
# `test_a_restored_send_is_made_when_its_moment_comes_with_the_job_it_was_armed_with`.

mutation_case "a restore hands the host a request without its target" <<'PY'
edit("backends/python/runtime/sce_runtime/saved_engine.py",
     "                    target=act.target,",
     "                    target=\"\",")
PY

# `_job_of(request) == "7"` in the same test, and the list of jobs in
# `test_a_waiting_send_saved_in_format_one_is_made_when_its_moment_comes`.

mutation_case "a restore hands the host a request without its params" <<'PY'
edit("backends/python/runtime/sce_runtime/saved_engine.py",
     "                    params=_clone_params(act.params),",
     "                    params={},")
PY

# `request.event_data == '{"job":7,"label":"report"}'` in the same test.

mutation_case "a restore hands the host a request without its data" <<'PY'
edit("backends/python/runtime/sce_runtime/saved_engine.py",
     "                    event_data=act.data,",
     "                    event_data=\"\",")
PY

## How a restored send is armed
#
# Armed under no id, the send is not found by `<cancel sendid>`: `host.calls == []` in
# `test_a_restored_send_can_still_be_cancelled_by_its_id` reads one call.

mutation_case "a restored send is armed under no id" <<'PY'
edit("backends/python/runtime/sce_runtime/saved_engine.py",
     "                ready_at(read.due),\n                act.send_id,\n                None,\n                \"\",\n                host_send=HostSendRequest(",
     "                ready_at(read.due),\n                \"\",\n                None,\n                \"\",\n                host_send=HostSendRequest(")
PY

# Due at once, the send is made at the first drive: `host.calls == []` at 349 ms in
# `test_a_restored_send_is_made_when_its_moment_comes_with_the_job_it_was_armed_with`.

mutation_case "a restored send comes due at once, not when its saved moment does" <<'PY'
edit("backends/python/runtime/sce_runtime/saved_engine.py",
     "                ready_at(read.due),\n                act.send_id,\n                None,\n                \"\",\n                host_send=HostSendRequest(",
     "                ready_at(0),\n                act.send_id,\n                None,\n                \"\",\n                host_send=HostSendRequest(")
PY
