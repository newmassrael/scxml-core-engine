# Mutation cases for docs/adr/0096 on the Go channel: a machine whose script
# session cannot be established does not start, and its host is told why; an
# invoked child that cannot start is a failed invoke.
#
# Run with `scripts/mutate sce-build/tests/mutations/a_go_machine_whose_script_session_fails_does_not_start.cases`.
#
# Establishing a session used to be lazy and marked done whatever happened:
# `ensureScriptEngine` discarded what `CreateSession` and
# `SetupSystemVariables` answered with `_ =`, and the machine ran over a
# session it did not have, every condition an error. Each case below puts back
# one piece of that shape and names the test that must go red. The script
# engine of the oracle is a double over the Lua engine that fails the step a
# case asks for, so the failure is reached through the engine a generated
# machine is handed, as a host's would be.
#
# The values a refusal hands its host are held on their own in
# `backends/go/runtime/script_session_test.go`; this file holds the generated
# machine, which is where the template halves can only be seen.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/a_child_may_send_many_events_in_one_tick/
mutation_runtime_targets backends/go/runtime/engine.go backends/go/runtime/script_session.go

# The templates reach the Go tests only through the committed tree the
# regeneration below writes, so both halves are declared: the generated files
# are compiled into the test, and the command is what carries a mutated
# template into them.
mutation_targets tools/codegen/templates/go/scriptengine_helpers.go.jinja2 tools/codegen/templates/go/invoke_methods.go.jinja2
mutation_targets backends/go/tests/integration/a_child_may_send_many_events_in_one_tick/a_child_may_send_many_events_in_one_tick_sm.go
mutation_targets backends/go/tests/integration/a_child_may_send_many_events_in_one_tick/a_child_may_send_many_events_in_one_tick__sce_synth_invoke__chatty_sm.go
mutation_regen scripts/materialize.sh go-integration

mutation_oracles backends/go/tests/integration/a_child_may_send_many_events_in_one_tick/a_machine_whose_script_session_fails_does_not_start_test.go

# ── The start goes on past a session that failed ────────────────────
#
# The engine drops the policy's failure and enters the initial configuration
# anyway: the old shape, with the failure now reported to nobody.
# Killer: `TestAStartWhoseSessionCannotBeEstablishedIsRefusedWithTheStep`,
# whose start answers nil.

mutation_case "the start enters the machine past a session that failed" <<'PY'
edit("backends/go/runtime/engine.go",
     "\tif e.policy.NeedsDataModelInit() {\n\t\tif failure := e.policy.InitializeDataModel(e); failure != nil {\n\t\t\tlog.Printf(\"[sce] Engine::Initialize: refused -- %s\", failure)\n\t\t\treturn failure\n\t\t}\n\t}\n",
     "\tif e.policy.NeedsDataModelInit() {\n\t\te.policy.InitializeDataModel(e)\n\t}\n")
PY

# ── The resumed start goes on past a session that failed ────────────
#
# Killer: `TestAResumedStartWhoseSessionCannotBeEstablishedIsRefused`, which
# finds `EnterAt` accepting the configuration.

mutation_case "EnterAt enters the configuration past a session that failed" <<'PY'
edit("backends/go/runtime/engine.go",
     "\t\tif failure := e.policy.InitializeDataModel(e); failure != nil {\n\t\t\tlog.Printf(\"[sce] Engine::EnterAt: refused -- %s\", failure)\n\t\t\treturn ConfigurationVerdict{\n\t\t\t\tRejection:            ConfigurationScriptSessionUnavailable,\n\t\t\t\tScriptSessionFailure: failure,\n\t\t\t}\n\t\t}\n",
     "\t\te.policy.InitializeDataModel(e)\n")
PY

# ── A library that did not load is the engine's own failure ─────────
#
# The creation failure is no longer told apart, so a build that shipped a
# chunk that does not load is reported as a session the engine could not make.
# Killers: `TestAStartWhoseSessionCannotBeEstablishedIsRefusedWithTheStep`
# (its `library` round names `create`) and
# `TestTheCheckedRootStartIsRefusedForTheSession`.

mutation_case "a library that did not load is reported as the create step" <<'PY'
edit("backends/go/runtime/script_session.go",
     "\tif errors.As(err, &library) {\n\t\tstage = ScriptSessionStageLibrary\n\t}\n",
     "\tif errors.As(err, &library) {\n\t\tstage = ScriptSessionStageCreate\n\t}\n")
PY

# ── A bind that failed is passed over again ─────────────────────────
#
# The generated policy carries on initializing the datamodel in a session
# whose system variables are not there.
# Killers: `TestAStartWhoseSessionCannotBeEstablishedIsRefusedWithTheStep`
# (its `system-variables` round starts) and
# `TestASessionWhoseSystemVariablesCannotBeBoundIsReleased` (nothing is
# destroyed).

mutation_case "a failed bind of the system variables is passed over" <<'PY'
edit("tools/codegen/templates/go/scriptengine_helpers.go.jinja2",
     "\t\tsce.BuildIoProcessors(sessionID, p.BasicHTTPAccessURI)); err != nil {\n\t\tengine.DestroySession(sessionID)\n\t\treturn sce.ScriptSessionFailureOfSystemVariables(err)\n\t}\n",
     "\t\tsce.BuildIoProcessors(sessionID, p.BasicHTTPAccessURI)); err != nil {\n\t}\n")
PY

# ── A session that failed is marked established ─────────────────────
#
# The first start is refused, and the flag says the session is there, so the
# next start finds it "done" and runs the machine over no session.
# Killer: `TestARefusedStartIsRefusedAgainRatherThanRunWithoutASession`, whose
# second start answers nil.

mutation_case "a session whose creation failed is marked established" <<'PY'
edit("tools/codegen/templates/go/scriptengine_helpers.go.jinja2",
     "\tif err := engine.CreateSession(sessionID); err != nil {\n\t\treturn sce.ScriptSessionFailureOfCreation(err)\n\t}\n",
     "\tif err := engine.CreateSession(sessionID); err != nil {\n\t\tp.scriptEngineInitialized = true\n\t\treturn sce.ScriptSessionFailureOfCreation(err)\n\t}\n")
PY

# ── The refused child is kept ───────────────────────────────────────
#
# The parent keeps the child whose start was refused, in its slot and its
# table of invocations, as a session of its own.
# Killer: `TestAChildWhoseSessionFailsLeavesItsParentWithErrorExecutionAndNoChild`,
# whose `IsChildSessionRunning` finds it.

mutation_case "the child whose start was refused is kept" <<'PY'
edit("tools/codegen/templates/go/invoke_methods.go.jinja2",
     "\t\t\t\tchildEngine.DetachMesh()\n\t\t\t\tdelete(p.activeInvokes, \"{{ invoke_info.invoke_id }}\")\n",
     "\t\t\t\tchildEngine.DetachMesh()\n")
edit("tools/codegen/templates/go/invoke_methods.go.jinja2",
     "{% endif %}\n\t\t\t\tcontinue\n\t\t\t}\n{% endmacro %}\n{% macro hybrid_child_start",
     "{% endif %}\n\t\t\t}\n{% endmacro %}\n{% macro hybrid_child_start")
PY

# ── The refused child raises nothing ────────────────────────────────
#
# The invoke ends without a child and without telling the document. The
# refusal is still read, so the mutant compiles.
# Killer: `TestAChildWhoseSessionFailsLeavesItsParentWithErrorExecutionAndNoChild`,
# whose `LastUnhandledError` finds no error.execution.

mutation_case "the child whose start was refused raises no error.execution" <<'PY'
edit("tools/codegen/templates/go/invoke_methods.go.jinja2",
     "\t\t\t\tengine.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, sce.ChildStartRefusal({{ invoke_named }}, refused)))\n",
     "\t\t\t\t_ = refused\n")
PY
