# Mutation cases for "a C11 machine whose data model is a script engine grows a
# host's replies and a host-run invocation's answer in its engine's heap"
# (docs/adr/0086, section 8.6 (d)).
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_c11_script_machine_grows_host_answers.cases
#
# The test generates a machine with a script engine that serves a host-served
# send and runs a host-run invocation, and a typed machine that does both, and
# asks the script machine's scratch for neither role, its calls for the
# engine's allocator handed to the writers, and its answer for a release after
# a refusal and after a completion; the typed machine keeps both roles. Each
# case breaks one link: the script machine holds the replies in its scratch,
# and a completion's text is never released.
#
# The machine is generated by `sce-codegen`, which the test runs as a
# subprocess, so the generator's source is a target compiled into a binary the
# test spawns.

mutation_tests -p sce-build --features cli --test a_c11_machine_sizes_its_event_data_slot
mutation_targets sce-build/src/forge/c11_scratch.rs tools/codegen/templates/c/state_machine.c.jinja2

mutation_case "a script machine holds the replies in its scratch" <<'PY'
edit("sce-build/src/forge/c11_scratch.rs",
     "pub const GROWN_ON_A_SCRIPT_ENGINE: &[&str] = &[\"answer\", \"replies\"];\n",
     "pub const GROWN_ON_A_SCRIPT_ENGINE: &[&str] = &[\"answer\"];\n")
PY

mutation_case "a completion's text is never released" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "    /* The answer was copied by the queue that took it, so its text is freed\n       here, once. */\n    sce_host_invoke_response_release(&out);\n",
     "    /* The answer was copied by the queue that took it. */\n")
PY
