# Mutation cases for "a record variable, or a list of records, whose schema has a
# `string` field is refused by every target that does not hold the field"
# (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A record's string field"; docs/adr/0005).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_record_with_a_string_field_is_refused_until_a_target_holds_it.cases`.
#
# Measured 2026-10-06: `check` answered ok for Rust, Kotlin, Go, C++ and Python
# for such a record, and Rust wrote `#[derive(Clone, Copy)]` over a `String`
# field, which does not compile; only C11 refused, from inside its own target.
# The refusal is now asked once in `lower`, ahead of the target's own `unsupported`,
# and a target lifts it by answering `lowers_record_string_fields`. The judge
# (`a_language_holds_a_record_string_field_or_refuses_it_by_name`) reads, for a
# record variable and for a list of records, that each language that has not lowered
# the field refuses it by name and each that has accepts it. The mutants take one
# decision away each:
#
#   the target is not asked, so a record with a string field is let through;
#   a list of records is not looked into;
#   any record field is refused, not only a string.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test a_static_datamodel_holds_every_variable_to_a_type
mutation_targets sce-build/src/forge/static_lowering.rs
mutation_oracles sce-build/tests/a_static_datamodel_holds_every_variable_to_a_type.rs

mutation_case "a record with a string field is let through" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "    if target.lowers_record_string_fields() {\n        return None;",
     "    if true {\n        return None;")
PY

mutation_case "a list of records is not looked into" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "        let alias = var.value_type.as_ref().and_then(|t| {\n            t.record_alias()\n                .or_else(|| t.list_elem().and_then(|e| e.record_alias()))\n        })?;",
     "        let alias = var.value_type.as_ref().and_then(|t| {\n            t.record_alias()\n        })?;")
PY

mutation_case "any record field is refused, not only a string" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "            .find(|f| matches!(f.sce_type, SceType::String))?;",
     "            .find(|f| matches!(f.sce_type, SceType::String) || true)?;")
PY
