# Mutation cases for "a list holds the flag it hands its entries as its start".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_list_holds_the_flag_it_hands_its_entries_as_its_start.cases`.
#
# A list whose entries say a flag input the parent binds to its own flag holds
# the flag as its start, and the encode writes the flag from it
# (docs/adr/0065 §6 R8a). The test runs the four documents of the tree that do
# so, with a frame of each value of the flag and an empty list with it set.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --test forge_conformance entries_are_handed_the_flag_their_import_binds_in_rust
mutation_targets sce-build/src/forge/codec_roles.rs sce-build/src/forge/generator.rs sce-build/src/forge/generator/rust_source.rs
mutation_oracles sce-build/tests/forge_conformance.rs

mutation_case "a list's bound flag is checked again rather than held as its start" <<'PY'
edit("sce-build/src/forge/codec_roles.rs",
     r'''                    BindSite::List { field } => lawful(field),''',
     r'''                    BindSite::List { .. } => false,''')
PY

mutation_case "a decode fills the list from a start that is not the bit it read" <<'PY'
edit("sce-build/src/forge/generator.rs",
     r'''        format!("({}) != 0", input.expr)''',
     r'''        format!("({}) == 2", input.expr)''')
PY

mutation_case "the encode writes the flag without reading the list's start" <<'PY'
edit("sce-build/src/forge/generator/rust_source.rs",
     r'''                            law_start(&self.roles, field, &binder.input, l)''',
     r'''                            { let _ = (l, field); String::from("false") }''')
PY
