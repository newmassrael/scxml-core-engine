# Mutation cases for the retired-header-key scan — every committed generated
# tree is read, not only the ones someone remembered to list.
#
# Run with
# `scripts/mutate sce-build/tests/mutations/retired_header_key_scan_reach.cases`.
#
# `committed_generated_files_carry_the_current_header_shape` replaced a scan
# for a pinned `generated-at` stamp that iterated a list of roots. That list
# was short Go's and Kotlin's integration trees until 2026-08-13, and the
# omission was not theoretical: a regeneration that stamped the wall clock into
# the Rust, Go and Kotlin outputs of one stem was reported for exactly one of
# the three. The replacement reads every tracked file that opens with the
# header banner, so no root has to be remembered — and these cases hold it to
# that, in the two trees the old list once missed.
#
# Each case plants a key the header retired (`template-hash`, `generated-at`)
# directly under the banner, which is what a file regenerated by a binary
# built before the retirement looks like.
#
# A case that SURVIVES here means that backend's tree is unwatched.

mutation_tests -p sce-build --features cli --test b9_drift_detection

# Read at run time, not compiled in: the test walks these files from disk, so
# the `sce-build` test binary cannot change when one of them does. Declared as
# compiled targets every case below would be INCONCLUSIVE by construction.
mutation_runtime_targets backends/go/tests/integration/parallel_done_state_is_delivered/parallel_done_state_is_delivered_sm.go
mutation_runtime_targets backends/kotlin/tests/src/main/kotlin/com/sce/integration/parallel_done_state_is_delivered/parallel_done_state_is_deliveredSm.kt

# ── Go's integration tree ──────────────────────────────────────────

mutation_case "a retired header key in the go integration tree" <<'PY'
edit("backends/go/tests/integration/parallel_done_state_is_delivered/parallel_done_state_is_delivered_sm.go",
     "// SCE-GENERATED — DO NOT EDIT\n",
     "// SCE-GENERATED — DO NOT EDIT\n// generated-at: 0\n")
PY

# ── Kotlin's integration tree ──────────────────────────────────────
#
# Same key, different backend — and the reason both get a case rather than one
# standing for the other: they were two separate missing roots, and a single
# case would leave whichever tree it did not touch exactly as unproven as it
# was before.

mutation_case "a retired header key in the kotlin integration tree" <<'PY'
edit("backends/kotlin/tests/src/main/kotlin/com/sce/integration/parallel_done_state_is_delivered/parallel_done_state_is_deliveredSm.kt",
     "// SCE-GENERATED — DO NOT EDIT\n",
     "// SCE-GENERATED — DO NOT EDIT\n// template-hash: 00\n")
PY
