# Mutation cases for W3C SCXML 3.4 — `getCurrentState()` names an atomic
# state in a parallel machine.
#
# Run with
# `scripts/mutate sce-build/tests/mutations/parallel_current_state_is_atomic.cases`.
#
# The first case restores the tree as it stood until 2026-08-13: no descent at
# all. That shipped for as long as the engine has had parallel support and no
# suite saw it, because every parallel assertion in this repository reads
# `getActiveStates()` — which was correct the whole time. Only the single-state
# accessor was wrong, and 105 files read it.
#
# Sibling of `parallel_microstep_owns_exit_and_entry.cases`. That one guards
# the CONFIGURATION across a microstep; this one guards the one field the
# entry set does not settle by itself. The settling lives in the engine's
# `settleCurrentState`, and neither file can see the other's defect.
#
# A case that SURVIVES here means the descent is asserted by nothing.

mutation_ctest --test-dir build -R '^IntegrationTests$'
mutation_targets sce/include/static/StaticExecutionEngine.h
# Measured, not guessed: both cases red
# `ParallelCurrentStateAotTest.CurrentStateIsAtomicAfterACompoundTarget`, and
# that suite lives in one file.
mutation_oracles tests/integration/ParallelCurrentStateAotTest.cpp

# ── No descent at all ──────────────────────────────────────────────
#
# `currentState_` is left on the first state the last transition names. When
# that target is compound the accessor names a state the machine is merely
# within — `outer` where the truth is `a`.

mutation_case "a parallel transition leaves currentState on the target" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     """                    currentState_ = targets.front();
                    resolveCurrentStateToLeaf();
                    return;""",
     """                    currentState_ = targets.front();
                    return;""")
PY

# ── The descent ignores parentage ──────────────────────────────────
#
# The descent chooses among the CHILDREN of the state it stands on, in
# document order, the first one the configuration holds. Broken here to
# choose among every active state instead — which a descent written without
# the parent test would do: it wanders out of `drive` and lands in the
# sibling region, or back on an ancestor.

mutation_case "the descent does not check parentage" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     """            const std::vector<State> children = StatePolicy::getChildStates(currentState_);""",
     """            const std::vector<State> children = active;""")
PY
