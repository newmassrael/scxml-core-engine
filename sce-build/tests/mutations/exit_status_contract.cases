# Mutation cases for "every non-zero exit carries a record, with a status
# SCE_ERROR_CONTRACT.md §6 assigns".
#
# Run with `scripts/mutate sce-build/tests/mutations/exit_status_contract.cases`.
#
# The defect these stand for was live on eight failure modes at once and in
# two distinct shapes, so the gate has to fail on both: a path that exits
# with no record at all (the argument parser's own failure, and every
# hand-rolled `eprintln! + exit`), and a path that emits a record under a
# status §6 assigns elsewhere (a query miss collapsed into the CLI-boundary
# 20, or a `cli/*` leaving as 2).
#
# Three of the cases break the *document* rather than the code, because §6
# is one of the two independent sources this gate compares — a table that
# stops naming a status the binary produces is exactly as much a defect as a
# binary that stops honouring the table, and a gate that only watched the
# code would call the first one green.
#
# The last two break the gate itself: the table is found by shape in
# markdown and the probe list is hand-written, and either going quiet prints
# the same green as a clean run.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test exit_status_contract
# The gate drives the CLI as a subprocess and reads the contract off disk, so
# nothing it judges is linked into the test binary. `sce_codegen.rs` is
# nevertheless COMPILED — into that CLI — and the cargo runner hashes the
# binaries it built beside the test executables, so the reach check sees it.
# The markdown is the genuine run-time entry: it is read off disk as the gate
# runs.
#
# ⚠ Residue, named rather than guessed (2026-09-09). The three library
# sources below are compiled too, and by the same argument belong here — but
# whether a mutation to one of them MOVES the CLI's bytes depends on whether
# the linker retained that code, and this gate names nothing from the
# `sce_build` library, which is why they were classified this way in the
# first place. Moving them without measuring that would trade a check that is
# off for a round that reports INCONCLUSIVE. The measurement is per file:
# mutate it, rebuild, and compare `sce-codegen`'s hash.
mutation_targets sce-build/tests/exit_status_contract.rs \
                 sce-build/src/bin/sce_codegen.rs
mutation_runtime_targets sce-build/src/cli_error.rs \
                         sce-build/src/forge/diagnostic.rs \
                         sce-build/src/mesh/error.rs \
                         SCE_ERROR_CONTRACT.md

mutation_case "the argument parser's failure leaves through its own exit" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """            let _ = ERROR_FORMAT.set(peek_error_format(std::env::args()));""",
     """            err.exit();
            #[allow(unreachable_code)]
            let _ = ERROR_FORMAT.set(peek_error_format(std::env::args()));""")
PY

mutation_case "a query miss collapses into the CLI-boundary status" <<'PY'
edit("sce-build/src/cli_error.rs",
     "            CliError::QueryNoMatch { .. } => Self::EXIT_QUERY_NO_MATCH,\n",
     "")
PY

mutation_case "a query miss stops carrying a record" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """    let Some(entry) = map.symbols.get(symbol) else {
        cli_exit(CliError::QueryNoMatch {
            tool: "addr2sce",
            query: format!("symbol '{symbol}'"),
            searched: map_path.display().to_string(),
        })
    };""",
     """    let Some(entry) = map.symbols.get(symbol) else {
        eprintln!("addr2sce: symbol '{symbol}' not found");
        std::process::exit(1);
    };""")
PY

mutation_case "generate-integration reverts to a bare exit for a missing script" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """            cli_exit(CliError::ReadInput {
                path: script.display().to_string(),
                source: std::io::Error::new(
                    std::io::ErrorKind::NotFound,
                    "no regen script for this stem",
                ),
            });""",
     """            eprintln!("generate-integration: missing regen script");
            std::process::exit(1);""")
PY

mutation_case "a flag stops requiring the companion it cannot work without" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     '        #[arg(long, requires = "elf", value_parser = parse_pc_address)]',
     "        #[arg(long, value_parser = parse_pc_address)]")
PY

mutation_case "--version is routed like a failure" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     "                ErrorKind::DisplayHelp | ErrorKind::DisplayVersion",
     "                ErrorKind::DisplayHelp")
PY

mutation_case "the table stops registering the status a query miss exits with" <<'PY'
edit("SCE_ERROR_CONTRACT.md",
     "| `1` | `cli/query-no-match`",
     "| `99` | `cli/query-no-match`")
PY

mutation_case "the table's exact row loses to the family wildcard" <<'PY'
edit("SCE_ERROR_CONTRACT.md",
     "| `1` | `cli/query-no-match` — a well-formed query",
     "| `1` | `cli/*` — a well-formed query")
PY

mutation_case "the section that documents statuses is renamed out of reach" <<'PY'
edit("SCE_ERROR_CONTRACT.md",
     "## 6. Exit codes",
     "## 6. Process statuses")
PY

mutation_case "the probe list empties and the sweep proves nothing" <<'PY'
edit("sce-build/tests/exit_status_contract.rs",
     "    out\n}\n\n/// §6's own universal",
     "    out.truncate(0);\n    out\n}\n\n/// §6's own universal")
PY

# ── A reader that stops reading ────────────────────────────────────
#
# The closed-reader sweep added a second shape of "ends outside the table":
# a status the process never chose. These three break it in the three ways
# that all print the same green — the panicking macro comes back, the
# failure is swallowed into a successful-looking exit, and the buffered
# tail never reaches a write that could fail.

mutation_case "list-fixtures prints through the panicking macro again" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """            for n in names {
                outln!("{n}");
            }""",
     """            for n in names {
                println!("{n}");
            }""")
PY

# The workspace denies warnings, so a mutation that leaves a binding
# unreferenced fails to compile and reports INCONCLUSIVE rather than
# exercising anything. Both bodies below keep every name in use and change
# only the behaviour under study.

mutation_case "a failed stdout write is swallowed into a clean exit" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """        cli_exit(CliError::WriteOutput {
            path: STDOUT_LABEL.to_string(),
            source,
        });""",
     """        let _ = (STDOUT_LABEL, source);""")
PY

mutation_case "output that ends without a newline is never flushed" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     "    let result = emit(&mut handle).and_then(|()| handle.flush());",
     "    let result = emit(&mut handle).and_then(|()| Write::flush(&mut std::io::sink()));")
PY

mutation_case "the closed-reader sweep loses its probes" <<'PY'
edit("sce-build/tests/exit_status_contract.rs",
     "    let mut violations: Vec<String> = Vec::new();\n    let mut reached = 0usize;\n    for argv in &argvs {",
     "    let mut violations: Vec<String> = Vec::new();\n    let mut reached = 0usize;\n    for argv in argvs.iter().take(0) {")
PY

# ── The rows that were delegated on a false reason ──────────────────
#
# Rows 5, 6 and 12 were declared covered by other gates and asserted by
# none. Each is now probed here, so each gets a case that breaks the
# producer it probes. The last one breaks the matcher: §6 spells five rows
# with the wildcard inside the family (`mesh/codegen-*`), and a matcher
# that only understood a trailing `/*` matched none of them — invisible
# for exactly as long as those rows went unprobed.

mutation_case "an unresolved import leaves under the backend family" <<'PY'
edit("sce-build/src/forge/diagnostic.rs",
     '    #[serde(rename = "import/file-not-found")]',
     '    #[serde(rename = "generate/file-not-found")]')
PY

mutation_case "a dependency cycle leaves under the CLI boundary" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """    let manifest = sce_build::build_forge_manifest(dir_path)
        .unwrap_or_else(|e| current_error_format().emit_and_exit(&e, "Forge codegen error: "));""",
     """    let manifest = sce_build::build_forge_manifest(dir_path).unwrap_or_else(|e| {
        cli_exit(CliError::ScxmlGenerate {
            stage: "manifest",
            detail: e.error.to_string(),
        })
    });""")
PY

mutation_case "the mesh codegen refusal collapses onto the deploy status" <<'PY'
edit("sce-build/src/mesh/error.rs",
     "            MeshError::Codegen(_) => 12,",
     "            MeshError::Codegen(_) => 10,")
PY

mutation_case "the wildcard stops reaching inside a family" <<'PY'
edit("sce-build/tests/exit_status_contract.rs",
     """        Some(prefix) => code.len() > prefix.len() && code.starts_with(prefix),""",
     """        Some(prefix) => {
            let prefix = prefix.strip_suffix('/').map(|p| p.to_string() + "/");
            match prefix {
                Some(p) => code.len() > p.len() && code.starts_with(&p),
                None => false,
            }
        }""")
PY
