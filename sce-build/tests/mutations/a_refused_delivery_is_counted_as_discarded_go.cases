# Mutation cases for "a delivery the door refuses in a document that declares no
# error.execution is not dropped unseen: it is counted as a discarded external event"
# under the Go engine (docs/adr/0086, section 4.2, amended 2026-11-09).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_refused_delivery_is_counted_as_discarded_go.cases`.
#
# `statechart_minimal` declares no error.execution, so its door has nothing to take
# in the place of a `job.completed` whose `elapsed_ms` is a text. The engine counts
# it as a discarded external event and names it the last one, the hook every lane
# shares. The mutants take one decision away each:
#
#   the refused delivery is not counted;
#   the refused delivery is counted and not named.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/event_schema_native/
mutation_targets backends/go/runtime/engine.go
mutation_oracles backends/go/tests/integration/event_schema_native/event_schema_native_test.go

mutation_case "the refused delivery is not counted" <<'PY'
edit("backends/go/runtime/engine.go",
     "\t\te.discardedExternalEvents++\n\t\te.lastDiscardedEvent = eventWithMeta.Event\n\t\te.hasDiscarded = true\n\t\treturn true\n",
     "\t\te.lastDiscardedEvent = eventWithMeta.Event\n\t\te.hasDiscarded = true\n\t\treturn true\n")
PY

mutation_case "the refused delivery is counted and not named" <<'PY'
edit("backends/go/runtime/engine.go",
     "\t\te.discardedExternalEvents++\n\t\te.lastDiscardedEvent = eventWithMeta.Event\n\t\te.hasDiscarded = true\n\t\treturn true\n",
     "\t\te.discardedExternalEvents++\n\t\treturn true\n")
PY
