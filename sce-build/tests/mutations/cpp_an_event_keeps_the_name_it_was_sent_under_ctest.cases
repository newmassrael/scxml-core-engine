# Mutation cases for "an event keeps the name it was sent under" (C++ engines).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/cpp_an_event_keeps_the_name_it_was_sent_under_ctest.cases`.
#
# A transition on `request` takes `request.new` by whole-token matching
# (§scxml-3.12.1), and `_event.name` is then the name the event was sent under
# (§scxml-5.10), not the descriptor it was matched through. The AOT engine carries
# the event as the enum member of a name the document writes, so the whole name
# has to travel beside it: `StaticExecutionEngine::arrivalNameOf` decides what it
# is, every by-name door records it in `EventWithMetadata::name`, and the generated
# `bindCurrentEvent` reads it before the member's name.
# `integration_resources/an_event_keeps_the_name_it_was_sent_under/` is the
# document: the parent writes `request.new`, the child only `request`, and the
# child reports `arrivedShortened` unless it is told the whole name.
#
# Two things are easy to get wrong and read as success: a door that resolves the
# name and forgets to carry it (the event is delivered, the transition is taken,
# the child is told the shorter name), and a binding that reads the member's name
# first (the carried name is there and unused). Either leaves the machine
# reaching its final state, so only `_event.name` itself tells them apart.
#
# The generated machine is built from the document at CMake time, from the
# templates, so a template edit reaches the test through `cmake --build`.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^IntegrationTests$'
mutation_targets sce/include/static/StaticExecutionEngine.h tools/codegen/templates/process_transition.jinja2
mutation_oracles tests/integration/AnEventKeepsTheNameItWasSentUnderAotTest.cpp

mutation_case "no name is ever recorded as the one an event arrived under" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        return name == policy_.getEventName(event) ? std::string() : name;",
     "        return std::string();")
PY

mutation_case "the by-name door delivers the event without its arrival name" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "            meta.name = arrivalNameOf(*event, eventName);\n",
     "")
PY

mutation_case "the generated binding reads the member's name before the arrival name" <<'PY'
edit("tools/codegen/templates/process_transition.jinja2",
     "            pendingEventName_ = pendingEventArrivalName_.empty() ? ::std::string({{ model.name }}Policy::getEventName(event))\n                                                                 : pendingEventArrivalName_;",
     "            pendingEventName_ = ::std::string({{ model.name }}Policy::getEventName(event));")
PY
