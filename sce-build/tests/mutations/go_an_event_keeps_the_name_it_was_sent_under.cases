# Mutation cases for "an event keeps the name it was sent under" (Go engine).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/go_an_event_keeps_the_name_it_was_sent_under.cases`.
#
# A transition on `request` takes `request.new` by whole-token matching
# (§scxml-3.12.1), and `_event.name` is then the name the event was sent under
# (§scxml-5.10), not the descriptor it was matched through. The engine carries the
# event as the value of a name the document writes, so the whole name has to
# travel beside it: `Engine.arrivalNameOf` decides what it is, every by-name door
# records it in `EventMetadata.Name`, and the generated `BindCurrentEvent` reads
# it before the value's name.
# `integration_resources/an_event_keeps_the_name_it_was_sent_under/` is the
# document: the parent writes `request.new`, the child only `request`, and the
# child reports `arrivedShortened` unless it is told the whole name.
#
# Two things are easy to get wrong and read as success: a door that resolves the
# name and forgets to carry it (the event is delivered, the transition is taken,
# the child is told the shorter name), and a binding that reads the value's name
# first (the carried name is there and unused). Either leaves the machine
# reaching its final state, so only `_event.name` itself tells them apart.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/an_event_keeps_the_name_it_was_sent_under/
mutation_runtime_targets backends/go/runtime/engine.go
mutation_targets backends/go/tests/integration/an_event_keeps_the_name_it_was_sent_under/an_event_keeps_the_name_it_was_sent_under__sce_synth_invoke__listener_sm.go
mutation_oracles backends/go/tests/integration/an_event_keeps_the_name_it_was_sent_under/an_event_keeps_the_name_it_was_sent_under_test.go

mutation_case "no name is ever recorded as the one an event arrived under" <<'PY'
edit("backends/go/runtime/engine.go",
     "\tif e.policy.GetEventName(event) == name {\n\t\treturn \"\"\n\t}\n\treturn name\n",
     "\tif true {\n\t\treturn \"\"\n\t}\n\treturn name\n")
PY

mutation_case "the by-name door delivers the event without its arrival name" <<'PY'
edit("backends/go/runtime/engine.go",
     "\tmeta.Metadata.Name = e.arrivalNameOf(event, eventName)\n",
     "\tmeta.Metadata.Name = \"\"\n")
PY

mutation_case "the generated binding reads the value's name before the arrival name" <<'PY'
edit("backends/go/tests/integration/an_event_keeps_the_name_it_was_sent_under/an_event_keeps_the_name_it_was_sent_under__sce_synth_invoke__listener_sm.go",
     "\t\tname := p.pendingEventArrivalName\n",
     "\t\tname := \"\"\n")
PY
