# Mutation cases for the `sce:unhandled` declaration contract.
#
# Run with `scripts/mutate sce-build/tests/mutations/scxml_exhaustiveness.cases`.
#
# Each case restores a defect the contract exists to prevent, and the run
# is only meaningful if the tests notice. The harness — not this file —
# is what guarantees the mutation reached the binary and that the same
# test set ran; see the header of `scripts/mutate`.
#
# Anchors are literal slices of the source, so a reformat can move one out
# from under a case. That is reported as INCONCLUSIVE with the anchor
# quoted, never as a pass — re-anchor the case against the current source
# rather than reading the run as evidence.

mutation_tests -p sce-build --features cli --test scxml_exhaustiveness --lib \
    --test cli_lint_parity
mutation_targets sce-build/src/scxml_exhaustiveness.rs sce-build/src/parser.rs
# The CLI is where the declaration check stopped being a lint, and the suite
# that judges that SPAWNS `sce-codegen` — so mutating this file changes the
# binary and leaves every test binary byte-identical. Listed as a compiled
# target it would report INCONCLUSIVE while in fact reaching the code under
# test, which is the lesson `host_processor_declaration.cases` paid for.
mutation_runtime_targets sce-build/src/bin/sce_codegen.rs
mutation_oracles sce-build/tests/cli_lint_parity.rs

# ── The grain of the exemption ─────────────────────────────────────

mutation_case "one child's declaration covers the whole gap (the withdrawn parent-level blanket)" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     ".filter(|id| !declares_unhandled(model, id, event))",
     ".filter(|_| !non_handlers.iter().any(|d| declares_unhandled(model, d, event)))")
PY

mutation_case "the gap set consults declarations, so a declaration justifies itself" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     "if state_handles_event(c, event) {\n                    any_handler = true;",
     "if state_handles_event(c, event) || c.unhandled.iter().any(|e| e == event) {\n                    any_handler = true;")
PY

# ── Both directions the declaration is checked in ──────────────────

mutation_case "a declaration the state's own transitions contradict is accepted" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     "if state_handles_event(state, event) {",
     "if false && state_handles_event(state, event) {")
PY

mutation_case "a declaration that exempts nothing is accepted" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     "if !covers {",
     "if false && !covers {")
PY

mutation_case "staleness is judged against the parent alone, ignoring which child the gap names" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     ".is_some_and(|non_handlers| non_handlers.contains(&state.id))",
     ".is_some()")
PY

# ── The attribute's own shape ──────────────────────────────────────

mutation_case "the withdrawn sce:exhaustive is ignored instead of rejected" <<'PY'
edit("sce-build/src/parser.rs",
     'if let Some(withdrawn) = node.attribute((SCE_NAMESPACE, "exhaustive")) {',
     'if let Some(withdrawn) = Option::<&str>::None {')
PY

mutation_case "wildcard tokens are accepted, giving the attribute a second matching rule" <<'PY'
edit("sce-build/src/parser.rs",
     "if tok == \"*\" || tok == \".*\" || tok.ends_with(\".*\") || tok.contains('*') {",
     "if false {")
PY

mutation_case "duplicate tokens are accepted" <<'PY'
edit("sce-build/src/parser.rs",
     "if out.iter().any(|seen| seen == tok) {",
     "if false {")
PY

mutation_case "a present-but-empty declaration is accepted" <<'PY'
edit("sce-build/src/parser.rs",
     "if out.is_empty() {",
     "if false {")
PY

# ── Every element that can carry a declaration must read it ────────
#
# `<final>` and `<parallel>` are parsed on their own paths. An element
# that skips `parse_sce_unhandled` swallows both the declaration and the
# withdrawn `sce:exhaustive` without a word. Both arrived on this list
# the same way: the harness found the first, and the second was next
# door on the very next loop.

mutation_case "a <final> child's declaration is never read" <<'PY_CASE'
edit("sce-build/src/parser.rs",
     """            state.unhandled =
                parse_sce_unhandled(&child, || format!("<final id=\\"{final_id}\\">"), source_name)?;""",
     "")
PY_CASE

mutation_case "a <parallel> child's declaration is never read" <<'PY_CASE'
edit("sce-build/src/parser.rs",
     """            state.unhandled = parse_sce_unhandled(
                &child,
                || format!("<parallel id=\\"{parallel_id}\\">"),
                source_name,
            )?;""",
     "")
PY_CASE

# ── The two questions collapse back into one set ────────────────────
#
# The common-ground precondition decides what is worth REPORTING. Whether
# a declaration is TRUE is a fact about the document. They shared one set
# until 2026-08-23, and the cost was that a true declaration under a
# protocol-stage compound was refused with "that state has no
# inconsistently-handled events at all" — so the check could not be paid
# in advance, and every author met it first as a rejection.
#
# Both directions of the collapse are cases, because they fail in
# opposite ways and only one of them looks like a regression: judging
# declarations against the filtered set refuses true ones, and reporting
# from the unfiltered set floods every sequential protocol machine in the
# W3C corpus.

mutation_case "declarations are judged against the reportable subset again" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     "    check_declarations(model, &found.inconsistent, source)?;",
     "    check_declarations(model, &found.reportable, source)?;")
PY

mutation_case "the report fires wherever an inconsistency exists" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     "    report_uncovered_gaps(model, &found.reportable, source)",
     "    report_uncovered_gaps(model, &found.inconsistent, source)")
PY

# `common_ground` is bound rather than dropped: with the `if` gone the
# variable is unused and the tree stops compiling, which the harness reports
# INCONCLUSIVE — a case that cannot run reads as coverage and measures
# nothing.
mutation_case "the common-ground precondition stops filtering anything" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     """            if common_ground {
                out.reportable.insert(parent.id.clone(), gaps.clone());
            }""",
     """            let _ = common_ground;
            out.reportable.insert(parent.id.clone(), gaps.clone());""")
PY

# ── The declaration check goes back behind the flag ─────────────────
#
# A `sce:unhandled` declaration the document contradicts is a false
# statement, not design advice — the parser already refuses the attribute's
# SHAPE unconditionally, and only its TRUTH was behind `--lint`. These two
# put it back, at each of the two call sites, which is also what would
# happen if someone added the check to one command and forgot the other.

mutation_case "check stops judging declarations without the flag" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     """            if let Err(e) = sce_build::validate_unhandled_declarations(&model, scxml_path) {
                error_format.emit_and_exit(&e, "");
            }""",
     "")
PY

# Widening the declares-nothing short-circuit, rather than replacing the
# whole `if` with an unconditional `return Ok(())`. The two mutations have
# the same effect on the entry point, but the second leaves the walk below
# unreachable and the tree stops compiling under `-D warnings`
# (`unreachable_statement`, and `source` goes unused with it) — reported
# INCONCLUSIVE, which is the verdict this case carried while measuring
# nothing.
mutation_case "the always-on entry point reports nothing" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     "    if model.states.values().all(|s| s.unhandled.is_empty()) {",
     "    if true || model.states.values().all(|s| s.unhandled.is_empty()) {")
PY

# ── …or starts reporting gaps on every build ────────────────────────
#
# The other direction: the always-on entry must run pass 1 ONLY.
#
# What this does NOT reach is the W3C corpus, and believing it did is what
# left the case SURVIVED for a round. The entry short-circuits before the
# walk when the document declares nothing, so a corpus that never writes
# `sce:unhandled` cannot tell the two apart — and neither can a document
# whose only declaration is under a compound the common-ground precondition
# excludes, because there the reportable set is empty and pass 2 is silent
# anyway. The discriminator is a document where a TRUE declaration and an
# UNCOVERED reportable gap coexist: `cli_lint_parity.rs`'s
# `the_always_on_entry_does_not_report_gaps`.

mutation_case "the always-on entry runs the gap report too" <<'PY'
edit("sce-build/src/scxml_exhaustiveness.rs",
     """    let found = collect_gaps(model);
    check_declarations(model, &found.inconsistent, source)
}""",
     """    let found = collect_gaps(model);
    check_declarations(model, &found.inconsistent, source)?;
    report_uncovered_gaps(model, &found.reportable, source)
}""")
PY
