# Mutation cases for "a composed value is walked once per constructor"
# (docs/adr/0086, sections 4, 3.1 and 7.1).
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_composed_value_is_walked_once_per_constructor.cases
#
# One walk of a value type gives the type a machine holds a composed value in,
# the records it names (each once, an inner one first), the reader that lifts
# it out of the event's data (one runtime call per constructor, each bound held
# where the value is read) and the writer that spells it as JSON. Each case
# takes one constructor's arm, or one rule of the walk, away and has to turn the
# walk's own tests red on its own.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --lib forge::composed_lowering
mutation_targets sce-build/src/forge/composed_lowering.rs sce-build/src/forge/composed_lowering/rust.rs
mutation_oracles sce-build/src/forge/composed_lowering.rs sce-build/src/forge/composed_lowering/rust.rs sce-build/src/forge/composed_lowering/test_support.rs

# An optional value is held as its present value: absence has nowhere to be.
mutation_case "the machine holds no optional" <<'PY'
edit("sce-build/src/forge/composed_lowering/rust.rs",
     r'''        format!("Option<{elem}>")''',
     r'''        elem.to_string()''')
PY

# A list is read past its bound: one element too many is kept.
mutation_case "a list is read with no bound" <<'PY'
edit("sce-build/src/forge/composed_lowering/rust.rs",
     r'''        format!("{value}.list::<_, {max}>(|v| {elem})")''',
     r'''        format!("{value}.list::<_, {}>(|v| {elem})", max + 1)''')
PY

# A list is held in a type whose bound is not the list's own (docs/adr/0086,
# section 7.4): the machine would hold one element past it.
mutation_case "a list is held past its bound" <<'PY'
edit("sce-build/src/forge/composed_lowering/rust.rs",
     r'''    format!("{RUST_PORTABLE}::BoundedList<{elem}, {max}>")''',
     r'''    format!("{RUST_PORTABLE}::BoundedList<{elem}, {}>", max + 1)''')
PY

# A byte string of a smaller bound is copied into a place of a larger one as
# though the two were one type, which no widening checks.
mutation_case "a byte string is copied with no widening" <<'PY'
edit("sce-build/src/forge/composed_lowering.rs",
     r'''        (ValueType::Bytes { .. }, ValueType::Bytes { max }) => {
            Ok(spelling.copy_bytes(max.max, held))
        }''',
     r'''        (ValueType::Bytes { .. }, ValueType::Bytes { .. }) => {
            Ok(spelling.copy_whole(held, false))
        }''')
PY

# A text is read with no bound, so a text past it is kept (section 4.4).
mutation_case "a text is read with no bound" <<'PY'
edit("sce-build/src/forge/composed_lowering/rust.rs",
     r'''        format!("{value}.text::<{max}>()")''',
     r'''        format!("{value}.text::<{}>()", u32::MAX)''')
PY

# A text of a smaller bound is copied into a place of a larger one as though
# the two were one type.
mutation_case "a text is copied with no widening" <<'PY'
edit("sce-build/src/forge/composed_lowering.rs",
     r'''        (ValueType::Text { .. }, ValueType::Text { max }) => Ok(spelling.copy_text(max.max, held)),''',
     r'''        (ValueType::Text { .. }, ValueType::Text { .. }) => Ok(spelling.copy_whole(held, false)),''')
PY

# An enum name the enum does not declare is not refused.
mutation_case "an unknown variant name is not refused" <<'PY'
edit("sce-build/src/forge/composed_lowering/rust.rs",
     r'''            "{value}.name().and_then(|name| match name {{ {arms}other => \
             Err({value}.unknown_variant(other, \"{}\")) }})",
            crate::filters::escape_rust(held.alias.clone())''',
     r'''            "{value}.name().and_then(|name| match name {{ {arms}_ => Ok({}::{}) }})",
            held.ty, held.variants[0].1''')
PY

# A record whose schema grew reads a delivery of its first revision as refused.
mutation_case "a record reads no defaults" <<'PY'
edit("sce-build/src/forge/composed_lowering.rs",
     r'''                crate::forge::schema_revision::composed_defaults_wire(held.schema).as_deref(),''',
     r'''                None,''')
PY

# A record is declared before the records its fields name.
mutation_case "an outer record is reached first" <<'PY'
edit("sce-build/src/forge/composed_lowering.rs",
     r'''            for field in &held.schema.fields {
                held_records(&field.sce_type, Some(held.alias), records, reached)?;
            }''',
     r'''            reached.records.push(held.alias.to_string());
            for field in &held.schema.fields {
                held_records(&field.sce_type, Some(held.alias), records, reached)?;
            }''')
PY

# A value that may be absent is written as though it were present.
mutation_case "an optional value is written as its present value" <<'PY'
edit("sce-build/src/forge/composed_lowering/rust.rs",
     r'''            "{RUST_PAYLOAD}::optional_json({}.as_ref(), |h| {elem})",''',
     r'''            "{RUST_PAYLOAD}::list_json({}.as_ref(), |h| {elem})",''')
PY
