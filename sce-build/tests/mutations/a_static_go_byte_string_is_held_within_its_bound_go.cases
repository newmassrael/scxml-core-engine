# Mutation cases for "a bytes variable is held within the `sce:capacity` it declares"
# under the Go backend (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A byte string";
# docs/adr/0005, decision 2).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_go_byte_string_is_held_within_its_bound_go.cases`.
#
# `static_bytes` assigns a bytes variable from a literal and from another one, and
# expects a value past the bound to leave the variable as it was and `errors` to count
# it. A Go machine is not saved, so the bound is the assignment's, and a host reads the
# value through its accessor, which `TestAHostThatWritesIntoAByteStringItWasHanded...`
# writes into and expects the machine not to have moved. The mutants take one decision
# away each:
#
#   an assignment to a byte string is not held to its bound;
#   a published byte string is handed out as the machine's own slice and not as a copy.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/static_datamodel/
mutation_targets sce-build/src/forge/static_lowering.rs
mutation_targets backends/go/forge-runtime/algorithm/algorithm.go
mutation_targets tools/codegen/templates/go/state_machine.go.jinja2
mutation_targets backends/go/tests/integration/static_datamodel/static_bytes/static_bytes_sm.go
mutation_regen scripts/regen_static_datamodel_go.sh
mutation_oracles backends/go/tests/integration/static_datamodel/static_scenarios_test.go sce-build/tests/fixtures/static_datamodel/scenarios/static_bytes.json

mutation_case "an assignment to a byte string is not held to its bound" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "            } else if let Some(capacity) = rewrites.bytes.get(location) {",
     "            } else if let Some(capacity) = rewrites.bytes.get(location).filter(|_| false) {")
PY

mutation_case "a published byte string is handed out as the machine's own slice" <<'PY'
edit("tools/codegen/templates/go/state_machine.go.jinja2",
     "{% if field.saved_kind == 'list' or field.saved_type == 'bytes' %}",
     "{% if field.saved_kind == 'list' %}")
PY
