# Mutation cases for "a sce-static statechart hands an algorithm a record whose field is
# a value of an enum, and a value of the enum itself, and takes one back; the enum is
# identified by its document, and a value crosses by the name its variant declares"
# (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A value of an enum").
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_machine_hands_an_algorithm_an_enum.cases`.
#
# The judge is `a_static_machine_hands_algorithms_the_state_it_holds`: the machine over
# the item-status documents lowers on every backend, the Interpreter's lowering hands the
# algorithm a variant as its declared name, a value of another enum, a number and an
# open enum are refused at the call, and a field of another enum document takes no
# variant of the statechart's enum of the same alias (docs/adr/0054). The mutants take
# one decision away each:
#
#   an enum field whose document is not the statechart's is held as the statechart's;
#   a value of another enum is handed to an enum parameter;
#   a number is handed to an enum parameter;
#   an open enum crosses;
#   the Interpreter's algorithm has no value form for an enum;
#   an algorithm's parameter, return or local is read in the grammar of a scalar,
#   which names no enum (judged also by `the_grammar_accepts_what_the_parser_accepts`,
#   which parses the committed algorithm documents with the XSD first).
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test a_static_machine_hands_algorithms_the_state_it_holds --test the_grammar_accepts_what_the_parser_accepts
mutation_targets sce-build/src/forge/static_imports.rs sce-build/src/forge/static_enum.rs sce-build/src/forge/static_js_algorithm.rs sce-build/src/forge/parser.rs sce-build/src/forge/event_schema_check.rs sce-build/src/forge/static_datamodel.rs
mutation_oracles sce-build/tests/a_static_machine_hands_algorithms_the_state_it_holds.rs sce-build/tests/the_grammar_accepts_what_the_parser_accepts.rs

mutation_case "an enum field of another document is held as the statechart's" <<'PY'
edit("sce-build/src/forge/event_schema_check.rs",
     "                    .is_some_and(|document| document.key == held.key)\n",
     "                    .is_some()\n")
PY

mutation_case "a value of another enum is handed to an enum parameter" <<'PY'
edit("sce-build/src/forge/static_enum.rs",
     "                    (Some(wanted), Some(held)) if wanted == held => {}\n",
     "                    (Some(wanted), Some(held)) if wanted == held || !held.is_empty() => {}\n")
PY

mutation_case "a number is handed to an enum parameter" <<'PY'
edit("sce-build/src/forge/static_enum.rs",
     "                let wanted = slot.map(|slot| slot.alias);\n",
     "                let wanted = slot.map(|slot| slot.alias).filter(|_| held.is_some());\n")
PY

# The list that would hand the open enum over is refused where it is declared, before
# any call (docs/adr/0054): the mutant lets a record of an open enum be declared.
mutation_case "an open enum crosses" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "            if held.strict_variants {\n",
     "            if held.strict_variants || !held.strict_variants {\n")
PY

mutation_case "the Interpreter's algorithm has no value form for an enum" <<'PY'
edit("sce-build/src/forge/static_js_algorithm.rs",
     "    !matches!(ty, SceType::Bytes)\n",
     "    !matches!(ty, SceType::Bytes | SceType::Enum(_))\n")
PY

mutation_case "an algorithm's slot is read in the grammar of a scalar" <<'PY'
edit("sce-build/src/forge/parser.rs",
     "            TypeGrammar::ScalarOrEnumRef,\n            element,\n            attr,\n            text,\n        )\n        .map(AlgorithmValueType::Scalar);\n",
     "            TypeGrammar::Scalar,\n            element,\n            attr,\n            text,\n        )\n        .map(AlgorithmValueType::Scalar);\n")
PY
