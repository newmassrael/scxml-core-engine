     "                    crate::model::DoneDataContent::None\n")
PY

# A `<param>` reads the payload of the event its transition is on, and only
# there. The first mutant refuses every read again, as the rule did before the
# lowering put the payload channel's guard around a `<send>`; the second admits
# a read where no event's payload is in scope (an entry, an event with no
# schema, a `<final>`), which would reach a backend as a name nothing declares.
mutation_case "a param that reads the payload is refused everywhere again" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "        if crate::forge::expr::references_event_data_lexically(written)\n            && self.payload_schema.borrow().is_none()\n        {",
     "        if crate::forge::expr::references_event_data_lexically(written) {")
PY

mutation_case "a param reads a payload that is not in scope" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "        if crate::forge::expr::references_event_data_lexically(written)\n            && self.payload_schema.borrow().is_none()\n        {",
     "        if false {")
PY

# A `<send>`'s `namelist` is the params it abbreviates, held to the rule a param
# is. The first mutant admits any name, so a variable with no wire spelling (or
# none at all) reaches a backend; the second counts the `namelist` as an engine
# need again, which the manifest of a pure-static machine would then deny.
mutation_case "a namelist name is not judged" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "                    self.wire_param(ctx, &namelist, \"<send>\", state)?;\n",
     "                    let _ = (&namelist, ctx, state);\n")
PY

mutation_case "a namelist needs a script engine again" <<'PY'
edit("sce-build/src/script_engine_analyzer.rs",
     "            // (`Action::fold_namelist_into_params`).\n            | C::SendNamelist { .. }\n",
     "            // (`Action::fold_namelist_into_params`).\n")
edit("sce-build/src/script_engine_analyzer.rs",
     "            C::GlobalScript\n            | C::UnresolvedExternalScript\n",
     "            C::GlobalScript\n            | C::SendNamelist { .. }\n            | C::UnresolvedExternalScript\n")
PY

# A `<send>`'s `<content expr>` that names a record is the pairs of its fields.
# The first mutant admits an expression that names none (an empty record), the
# second a `<param>` beside the content, and the third counts the content as an
# engine need again, which the manifest of a pure-static machine would deny; the
# fourth lets a `namelist` name repeat a `<param>` of the same send into C11,
# which carries a name once.
mutation_case "a content that names no record is admitted" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "        let Some(fields) = self.content_fields(written) else {",
     "        let Some(fields) = self.content_fields(written).or(Some(Vec::new())) else {")
PY

mutation_case "a content is admitted beside a param" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "        if beside {\n            return Err(self.rule_at(\n                construct,\n",
     "        if false && beside {\n            return Err(self.rule_at(\n                construct,\n")
PY

# The same record named in a `<final>`'s `<donedata>` is read when the state is
