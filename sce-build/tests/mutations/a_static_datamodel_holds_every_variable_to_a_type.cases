# A `<send>`'s `<content expr>` that names no record is the one value the event
# carries, and is held to the rule a `<param>`'s value is: a name nothing declares
# and a 64-bit integer, which no backend spells alike, are refused where written.
# The case lets the value through unjudged, and both are accepted.
mutation_case "a send content value is not held to the rule a param's value is" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "            return self.wire_param(\n                ctx,\n                &WireParam::of_content(written, spelling),\n                element,\n                state,\n            );",
