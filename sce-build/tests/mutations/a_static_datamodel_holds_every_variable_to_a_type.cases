# The `namelist` of an `<invoke>` a host runs is the pairs of its request, the
# `<param>`s it abbreviates. Four mutants take one step away: the names are not
# judged, so a name no variable declares reaches a backend; a name that repeats a
# `<param>` reaches C, which carries a name once; the names are not folded into
# the params, so a backend evaluates the attribute with an engine the machine
# lacks; and the attribute is left standing after the fold, which does the same.
mutation_case "a host-run invoke's namelist is not judged" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "            for name in info.namelist.split_whitespace() {\n                let pair = WireParam::of_namelist_name(name, None, at);\n                self.wire_param(ctx, &pair, &element, state)?;\n            }\n",
     "")
PY

mutation_case "a namelist name that repeats a host-run invoke's param reaches C" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "namelist_name_taken(info.base.params.iter().map(|p| p.name.as_str()), &info.namelist)",
     "namelist_name_taken(info.base.params.iter().map(|p| p.name.as_str()), \"\")")
PY

mutation_case "a host-run invoke's namelist is not folded into its params" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "                    info.fold_namelist_into_params();\n",
     "")
PY

mutation_case "a host-run invoke's namelist stands after it is folded" <<'PY'
edit("sce-build/src/model.rs",
     "        let names = std::mem::take(&mut self.namelist);\n        let at = self.base.source_location.clone();\n",
     "        let names = self.namelist.clone();\n        let at = self.base.source_location.clone();\n")
PY

# A `<cancel>`'s `sendidexpr` is a string the machine computes, the id of the send
