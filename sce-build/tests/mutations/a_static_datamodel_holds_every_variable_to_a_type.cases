# Mutation cases for "a static data model holds every variable to a type"
# (docs/SCE_ACCEPTED_SUBSET.md §2.15).
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_static_datamodel_holds_every_variable_to_a_type.cases
#
# Each case takes one rule of the model away, and each has to turn the
# suite red on its own. The model's point is that a document under it needs
# no script engine, so the rules that matter most are the ones that keep an
# untyped expression from reaching one: a closed scope, a judged place, an
# attribute with no typed form refused.

mutation_tests -p sce-build --features cli --test a_static_datamodel_holds_every_variable_to_a_type
# The rules live in `sce-codegen`, which the tests run as a subprocess — the
# evidence a mutation reached what ran is the file differing on disk while
# the tests ran.
mutation_targets sce-build/tests/a_static_datamodel_holds_every_variable_to_a_type.rs
mutation_runtime_targets sce-build/src/forge/static_datamodel.rs sce-build/src/forge/static_lowering.rs sce-build/src/forge/type_ctx.rs sce-build/src/kotlin.rs sce-build/src/model.rs sce-build/src/parser.rs sce-build/src/script_engine_analyzer.rs sce-build/src/generator.rs tools/codegen/templates/python/actions/send.py.jinja2 tools/codegen/templates/kotlin/actions/send.kt.jinja2 tools/codegen/templates/c/state_machine.c.jinja2 tools/codegen/templates/go/entry_exit_actions.go.jinja2 tools/codegen/templates/rust/entry_exit_actions.rs.jinja2 tools/codegen/templates/python/entry_exit_actions.py.jinja2 tools/codegen/templates/kotlin/entry_exit_actions.kt.jinja2 tools/codegen/templates/entry_exit_actions.jinja2

# A transition's condition stops being judged as a bool: `cond="count + 1"`
# generates, and every backend emits a guard of an integer.
mutation_case "a transition's condition is not judged as a bool" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     """                    transition.cond_spelling.as_ref(),
                    Expected::Slot(InferredType::Bool),""",
     """                    transition.cond_spelling.as_ref(),
                    Expected::Hint(InferredType::Unknown),""")
PY

# An assignment stops being judged against its variable: a bool lands in a
# `uint32`.
mutation_case "an assignment is not judged against its variable" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     """                        action.spellings.get("expr"),
                        Expected::Slot(slot),""",
     """                        action.spellings.get("expr"),
                        Expected::Hint(slot),""")
PY

# The scope opens: a name nothing declares is admitted, which is the one
# thing a document with no host behind it cannot afford.
mutation_case "the scope is left open" <<'PY'
edit("sce-build/src/forge/type_ctx.rs",
     """    );
    ctx.insert_record("_event", RecordShape::Open);
    close_the_scope(&mut ctx);""",
     """    );
    ctx.insert_record("_event", RecordShape::Open);""")
PY

# `targetexpr` stops being refused, so script text reaches a document that
# declared it has none.
mutation_case "an attribute with no typed form is admitted" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     """&[("send", "targetexpr"), ("send", "typeexpr")];""",
     """&[("send", "typeexpr")];""")
PY

# A variable with no initial value is admitted, and a backend would pick
# one for it.
mutation_case "a variable with no initial value is admitted" <<'PY'
edit("sce-build/src/parser.rs",
     """            if node.attribute("expr").is_none_or(|e| e.trim().is_empty()) {""",
     """            if node.attribute("expr").is_none_or(|e| e.trim().is_empty()) && false {""")
PY

# The gate stops reaching the tool: every document reads as accepted. The
# refusal cases are what stand between this and a green run.
mutation_case "the gate reports every document as accepted" <<'PY'
edit("sce-build/tests/a_static_datamodel_holds_every_variable_to_a_type.rs",
     "    (\n        out.status.success(),",
     "    (\n        true,")
PY

# A `<donedata>` param stops being lowered: it is judged and accepted, and the
# generated machine asks an engine for it — which Rust did not compile against
# and Kotlin never emitted at all.
mutation_case "a donedata param is judged but not lowered" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "            lower_done_params(&mut done.params, &plain_ctx, &plain_renames, &rewrites)?;\n",
     "            let _ = (&mut done.params, lower_done_params);\n")
PY

# A `<donedata>` param's `location` is not read as the expression it is: a name
# nothing declares reaches the generated machine.
mutation_case "a donedata param's location is not judged" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "            (_, Some(location)) => (location.as_str(), param.location_spelling.as_ref()),\n",
     "            (_, Some(_)) => (\"\", None),\n")
PY

# A `<send>`'s literal `<content>` stops being finished at build time: every
# backend falls back to the path that asks a script engine for the text, which
# the machine was never given. The manifest still says it needs none, so only the
# generated machine shows it.
mutation_case "a send content is left for an engine to evaluate" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "                action.native_content = crate::filters::static_content_wire(&action.content);\n",
     "                let _ = crate::filters::static_content_wire;\n")
PY

# Python's native arm for the content is the one that stops reading it through
# the engine's helper.
mutation_case "a Python send content is read by the engine's helper again" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{% if action.native_content %}\n{# `datamodel=\"sce-static\"`: a literal `<content>`",
     "{% if false and action.native_content %}\n{# `datamodel=\"sce-static\"`: a literal `<content>`")
PY

# Kotlin's arm for it is the one that stops calling `evaluateSendContent`.
mutation_case "a Kotlin send content is read by the engine again" <<'PY'
edit("tools/codegen/templates/kotlin/actions/send.kt.jinja2",
     "{% if action.native_content %}\n{% set content_data",
     "{% if false and action.native_content %}\n{% set content_data")
PY

# C's arm for it is the one that stops copying the text, and falls through to the
# branch that asks the Lua engine the machine was not given.
mutation_case "a C send content is read by the engine again" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "{% elif action.native_content %}\n                {\n                    static const char _lit[]",
     "{% elif false and action.native_content %}\n                {\n                    static const char _lit[]")
PY

# C stops lowering the text and refuses the send by name again.
mutation_case "C refuses a send content again" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "                \"send\" => {\n                    let scxml_processor = action.send_type.is_empty()",
     "                \"send\" => {\n                    if !action.content.is_empty() {\n                        return Some(\"a <send> with a <content>\".to_string());\n                    }\n                    let scxml_processor = action.send_type.is_empty()")
PY

# A `<donedata>`'s inline `<content>` is finished at build time the way a `<send>`'s
# literal one is. Without it every backend falls back to the arm that asks a script
# engine for the text, which the machine was never given; the manifest still says it
# needs none, so only the generated machine shows it. What is read is
# `a_donedata_content_is_the_text_it_spells_and_no_engine_reads_it`.
#
# Not reached here: the copy of that text into the done event of a COMPOUND final in
# C (`static_done_data`, and the `native_content` clause beside `params` where the
# event is built). No scenario hands a `done.state.<parent>` event's data to a guard,
# which no `sce-static` expression can read untyped, so a mutation there survives.

mutation_case "a donedata content is left for an engine to evaluate" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "                done.native_content = crate::filters::static_content_wire(text);\n",
     "                let _ = (text, crate::filters::static_content_wire);\n")
PY

mutation_case "a Go donedata content is read by the engine again" <<'PY'
edit("tools/codegen/templates/go/entry_exit_actions.go.jinja2",
     "{% elif state.donedata.native_content %}",
     "{% elif false and state.donedata.native_content %}")
PY

mutation_case "a Rust donedata content is read by the engine again" <<'PY'
edit("tools/codegen/templates/rust/entry_exit_actions.rs.jinja2",
     "{% elif state.donedata.native_content %}",
     "{% elif false and state.donedata.native_content %}")
PY

mutation_case "a Python donedata content is read by the engine again" <<'PY'
edit("tools/codegen/templates/python/entry_exit_actions.py.jinja2",
     "{% elif state.donedata.native_content %}",
     "{% elif false and state.donedata.native_content %}")
PY

mutation_case "a Kotlin donedata content is read by the engine again" <<'PY'
edit("tools/codegen/templates/kotlin/entry_exit_actions.kt.jinja2",
     "{% if state.donedata.native_content %}",
     "{% if false and state.donedata.native_content %}")
PY

mutation_case "a C++ donedata content is read by the engine again" <<'PY'
edit("tools/codegen/templates/entry_exit_actions.jinja2",
     "{% elif state.donedata.native_content %}",
     "{% elif false and state.donedata.native_content %}")
