mutation_case "a Go machine's imports are not read from its text" <<'PY'
edit("sce-build/src/generator.rs",
     "    if unimported.is_empty() {\n        return Ok(first);\n    }\n",
     "    if true {\n        return Ok(first);\n    }\n")
