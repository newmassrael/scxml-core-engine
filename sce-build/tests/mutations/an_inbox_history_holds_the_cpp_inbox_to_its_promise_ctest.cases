# Mutation cases for docs/adr/0147, D3 on the generated C++ engine: every run of
# its inbox is a history linearizable to docs/formal/InboxService.tla.
#
# Run with
# `scripts/mutate sce-build/tests/mutations/an_inbox_history_holds_the_cpp_inbox_to_its_promise_ctest.cases`.
#
# The program runs the inbox of tests/integration/inbox_probe.scxml on real
# threads with the machine's inbox port on, writes each run as an inbox history,
# and `sce-codegen check-inbox-history` judges them (ctest
# `cpp_inbox_history_check`, which needs the record of `cpp_inbox_history_record`).
# The mutants take one decision away each:
#
#   the drain before an event of the owner's own: an own event enters ahead of
#   a post taken before it (arrival order, W3C test 201's shape);
#   the inbox applied where a run ends: an input taken before the end never
#   enters (never lost);
#   the port tells no event that entered: the history loses every enqueue, so
#   every input a post took is one that never entered;
#   the port tells an applied input as an event of the machine's own.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^cpp_inbox_history_(record|check)$'
mutation_targets sce/include/static/StaticExecutionEngine.h
mutation_oracles tests/integration/inbox_history_recorder.cpp

mutation_case "C++ puts an own event on the external queue ahead of what the inbox holds" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        tellInboxPort(eventWithMetadata, posted, false);\n        applyHeldBeforeExternalEnqueue();\n",
     "        tellInboxPort(eventWithMetadata, posted, false);\n")
PY

mutation_case "C++ leaves what the inbox holds unapplied where a run ends" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        inbox_.state().close();\n        drainInbox();\n",
     "        inbox_.state().close();\n")
PY

mutation_case "C++'s inbox port tells no event that entered the external queue" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        externalQueue_.raise(eventWithMetadata);\n        tellInboxPort(eventWithMetadata, posted, true);\n",
     "        externalQueue_.raise(eventWithMetadata);\n")
PY

mutation_case "C++'s inbox port tells an applied input as an event of the machine's own" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        tellInboxPort(eventWithMetadata, posted, true);\n",
     "        tellInboxPort(eventWithMetadata, false, true);\n")
PY
