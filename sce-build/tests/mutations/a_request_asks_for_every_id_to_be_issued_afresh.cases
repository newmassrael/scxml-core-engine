# Mutation cases for "a request asks for every id to be issued afresh".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_request_asks_for_every_id_to_be_issued_afresh.cases`.
#
# The owner can ask, with a request, for every requirement of the list it makes to be issued a new
# id (`request_generation`'s `fresh_ids`, ADR 0012). The ask travels: the registration keeps it on
# the request (and it is an input of the key, so a press that asked is not the press that did not),
# the request says it in its record only when it was made, and the command both takes it and says
# it back. Each case below takes one of those away and must make a test of
# `sce-works/tests/{requests,request_commands}.rs` red.
#
# What an application's runner does with the ask (hands it to the generator in the job, and fails
# the request whose list carries an id the owner asked to retire) is judged where the runner is:
# it left for the workbench's own repository, and what took it away went with it.
#
# ⚠ A mutated tree is built under `-D warnings`, so every case keeps each binding it had in
# use: a mutation that stops reading one is an unused-variable ERROR, the tree does not
# compile, and the verdict is INCONCLUSIVE.
#
# Anchors are literal slices of the source; an edit that moves one is reported INCONCLUSIVE with
# the anchor quoted, never as a pass.

mutation_tests -p sce-works --test requests --test request_commands
mutation_targets sce-works/src/store/request_store.rs sce-works/src/requests.rs sce-works/src/commands.rs
mutation_oracles sce-works/tests/requests.rs sce-works/tests/request_commands.rs

mutation_case "a press that asked is taken for the press that did not" <<'PY'
edit("sce-works/src/store/request_store.rs",
     "            if same.inputs != registration.expect || same.fresh_ids != fresh_ids {",
     "            if same.inputs != registration.expect {")
PY

mutation_case "a request does not keep what the owner asked" <<'PY'
edit("sce-works/src/requests.rs",
     "        Request { fresh_ids, ..self }",
     "        Request { fresh_ids: fresh_ids && false, ..self }")
PY

mutation_case "a request that asked for nothing writes the ask all the same" <<'PY'
edit("sce-works/src/requests.rs",
     "    #[serde(default, skip_serializing_if = \"std::ops::Not::not\")]\n    pub fresh_ids: bool,",
     "    #[serde(default)]\n    pub fresh_ids: bool,")
PY

mutation_case "the command does not pass the ask on to the registration" <<'PY'
edit("sce-works/src/commands.rs",
     "                pin,\n                fresh_ids,\n            )?;",
     "                pin,\n                false && fresh_ids,\n            )?;")
PY

mutation_case "the request is said without what was asked" <<'PY'
edit("sce-works/src/commands.rs",
     "        \"fresh_ids\": request.fresh_ids,",
     "        \"fresh_ids\": false,")
PY
