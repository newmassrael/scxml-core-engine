# Mutation cases for "which entry point a machine needs reaches the host that
# has to pick one".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/tick_requirement_reaches_the_consumer.cases`.
#
# `Engine::step` never consults the delayed-send scheduler and never ticks an
# invoked child, so a host driving such a machine with it alone gets no delayed
# event, no error and no warning. SCE decided that requirement at parse time and
# published it only on the CLI generate manifest — `sce_build::compile_scxml`,
# the route both downstream consumers use from `build.rs`, returns `()`.
#
# The repair is one verdict with many carriers: the analyzer writes
# `needs_tick_driving` from the method that owns the union, each backend's
# template carries it into the emitted artifact in that language's spelling, and
# the engine counts the macrosteps taken before any `tick`. Each case below
# removes one carrier, or widens/narrows the verdict, and each must red.
#
# C11 is the one backend whose answer is a different question, and that is
# asserted rather than assumed: it reaches an invoked child from inside its own
# macrostep, so its parent needs a `_tick` only for the parent's own delayed
# sends. The last case holds that apart from the union.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests --workspace --test tick_requirement_reaches_the_consumer --test delayed_sends_need_tick_not_step
# The analyzer decides, the model owns the union, the template carries it into
# the emitted policy, and the engine is where the silence was.
mutation_targets sce-build/src/analyzer.rs sce-build/src/model.rs backends/rust/runtime/src/engine.rs
# Read at generation time rather than compiled in: the templates are files the
# codegen opens. One per backend a consumer can generate — the answer is only
# useful where that consumer can read it.
mutation_runtime_targets tools/codegen/templates/rust/state_machine.rs.jinja2 \
    tools/codegen/templates/state_machine.jinja2 \
    tools/codegen/templates/go/state_machine.go.jinja2 \
    tools/codegen/templates/python/state_machine.py.jinja2 \
    tools/codegen/templates/kotlin/state_machine.kt.jinja2

# ── The requirement stops reaching the emitted policy ───────────────
#
# The defect exactly as it was: SCE knows, and the generated code does not say.

mutation_case "the analyzer stops writing the verdict the templates read" <<'PY'
edit("sce-build/src/analyzer.rs",
     "    model.needs_tick_driving = model.needs_event_scheduler_driving();",
     "    model.needs_tick_driving = false;")
PY

mutation_case "the template emits the constant as a fixed false" <<'PY'
edit("tools/codegen/templates/rust/state_machine.rs.jinja2",
     "    const NEEDS_EVENT_SCHEDULER: bool = {{ 'true' if model.needs_tick_driving else 'false' }};",
     "    const NEEDS_EVENT_SCHEDULER: bool = false;")
PY

# ── …or reaches it as a word that means nothing ─────────────────────
#
# A constant that is always `true` looks like it works on every machine that
# needs the scheduler. It tells a consumer as little as always `false`, because
# a host cannot use it to decide anything.

mutation_case "the template emits the constant as a fixed true" <<'PY'
edit("tools/codegen/templates/rust/state_machine.rs.jinja2",
     "    const NEEDS_EVENT_SCHEDULER: bool = {{ 'true' if model.needs_tick_driving else 'false' }};",
     "    const NEEDS_EVENT_SCHEDULER: bool = true;")
PY

# ── The union narrows to the flag it is not ─────────────────────────
#
# `needs_event_scheduler` is about this machine owning scheduler entries. A
# parent that schedules nothing still reaches its child's queue only through
# `tick_children`, which `step` does not call — which is why the verdict is a
# union and not that flag on its own.

mutation_case "the verdict forgets the child sessions it has to tick" <<'PY'
edit("sce-build/src/model.rs",
     """    pub fn needs_event_scheduler_driving(&self) -> bool {
        self.needs_event_scheduler.unwrap_or(false)
            || self.has_scxml_invoke()
            || self.has_hybrid_invoke()
    }""",
     """    pub fn needs_event_scheduler_driving(&self) -> bool {
        self.needs_event_scheduler.unwrap_or(false)
    }""")
PY

# ── The engine goes back to saying nothing ──────────────────────────
#
# The count is what turns a wiring mistake into something a program can see. A
# run that merely takes forever is the failure mode this replaces.

mutation_case "the engine stops counting the unattended macrosteps" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "        if concepts::needs_event_scheduler::<P>() && !self.tick_has_run {",
     "        if false {")
PY

# ── …or accuses a host that did nothing wrong ───────────────────────
#
# `tick` is a superset of `step`, so mixing them is a legitimate driving loop.
# A counter that kept climbing after the first `tick` would report every such
# host as broken, and a counter that climbs on a machine with no delayed send
# would report all of them.

mutation_case "a host that ticks is counted anyway" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     """        self.tick_has_run = true;
        if !self.is_running {""",
     """        if !self.is_running {""")
PY

mutation_case "every machine is treated as scheduler-driven" <<'PY'
edit("backends/rust/runtime/src/engine.rs",
     "        if concepts::needs_event_scheduler::<P>() && !self.tick_has_run {",
     "        if !self.tick_has_run {")
PY

# ── The other five backends stop answering ─────────────────────────
#
# The defect this round repaid was the same in each: the generate manifest knew
# and the generated artifact did not say. A backend that goes quiet again is a
# consumer whose driving loop is back to guessing, so each carrier is its own
# case rather than one case standing for five.

mutation_case "the C++ policy stops declaring the requirement" <<'PY'
edit("tools/codegen/templates/state_machine.jinja2",
     "    static constexpr bool NEEDS_EVENT_SCHEDULER = {{ 'true' if model.needs_tick_driving else 'false' }};",
     "    static constexpr bool NEEDS_EVENT_SCHEDULER = false;")
PY

mutation_case "the Go policy stops declaring the requirement" <<'PY'
edit("tools/codegen/templates/go/state_machine.go.jinja2",
     "\treturn {{ 'true' if model.needs_tick_driving else 'false' }}\n}",
     "\treturn false\n}")
PY

mutation_case "the Python policy stops declaring the requirement" <<'PY'
edit("tools/codegen/templates/python/state_machine.py.jinja2",
     "        return {{ 'True' if model.needs_tick_driving else 'False' }}",
     "        return False")
PY

mutation_case "the Kotlin machine stops declaring the requirement" <<'PY'
edit("tools/codegen/templates/kotlin/state_machine.kt.jinja2",
     "    override val needsEventScheduler: Boolean = {{ 'true' if model.needs_tick_driving else 'false' }}",
     "    override val needsEventScheduler: Boolean = false")
PY

# ── …or answers the C11 question with the C++ one ───────────────────
#
# C11 reaches an invoked child from inside its own macrostep and picks the
# child's `_step` or `_tick` accordingly, so its parent needs a `_tick` only for
# its own delayed sends. Widening that to the union would emit an entry point
# with nothing to do, which is the mirror of the defect: a declaration that does
# not describe the machine.

mutation_case "C11 emits a tick entry point for a parent that schedules nothing" <<'PY'
edit("sce-build/src/analyzer.rs",
     "    model.needs_tick_driving = model.needs_event_scheduler_driving();",
     """    model.needs_tick_driving = model.needs_event_scheduler_driving();
    if model.needs_tick_driving {
        model.needs_event_scheduler = Some(true);
    }""")
PY
