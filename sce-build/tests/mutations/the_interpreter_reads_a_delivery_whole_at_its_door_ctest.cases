# Mutation cases for "the Interpreter reads a delivery whole at its door, before it
# selects a transition, and takes error.execution in the place of one it refuses, as
# every generated machine does" (docs/adr/0086, sections 4.2 and 4.4, amended
# 2026-11-09).
#
# The lowering installs the record of each event whose payload the document reads
# (`SceStatic.door`); the Interpreter asks the library's reader when it takes an event
# (`StateMachine::processTakenEvent`), and on a refusal binds the `error.execution` that
# carries it and answers that in the delivery's place: no transition is selected for the
# refused delivery. `static_payload_bytes`, replayed by `static_datamodel_lowered`, sends
# a frame past its bound on a route that reads none of it (a sensor of 40 to 49), and
# `sync_client` sends a page whose `more` is a number, where the last-page transition
# reads nothing of the payload. The mutants take one decision away each:
#
#   the engine never asks the door;
#   the engine takes the refused delivery after all;
#   the engine answers the refusal by raising it and goes on with the delivery;
#   the library lets a refused delivery in;
#   the library's reader reads no field of the record;
#   a document under another data model is given no door;
#   an event whose schema holds a composed value is given no door;
#   a composed door lets its delivery in unread.
#
# The first of the last three is held by `event_schema/statechart_lifted.scxml`, an
# `ecmascript` document whose guard reads `job.completed` through its schema: the door
# holds wherever an event's type is known. The other two by `static_composed_payload`,
# whose `batch.sent` with `items` a text is refused at the door, so the transition the
# Interpreter reports is error.execution's and none on `batch.sent` is taken.
#
# The library is embedded in the generator, so the regeneration is the build the ctest
# names. Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^static_datamodel_lowered$'
mutation_targets sce/src/runtime/StateMachine.cpp sce-build/src/forge/static_js/sce_static.js sce-build/src/forge/static_js.rs
mutation_oracles tests/integration/AStaticDatamodelRunsLoweredUnderTheInterpreterTest.cpp sce-build/tests/fixtures/static_datamodel/static_payload_bytes.scxml sce-build/tests/fixtures/static_datamodel/scenarios/static_payload_bytes.json sce-build/tests/fixtures/static_datamodel/sync_client.scxml sce-build/tests/fixtures/static_datamodel/scenarios/sync_client.json sce-build/tests/fixtures/event_schema/statechart_lifted.scxml sce-build/tests/fixtures/static_datamodel/static_composed_payload.scxml

mutation_case "the engine never asks the door" <<'PY'
edit("sce/src/runtime/StateMachine.cpp",
     "    const std::string refusal = readAtTheDoor(scriptEngine_, sessionId_, model_.get());\n",
     "    const std::string refusal;\n")
PY

mutation_case "the engine takes the refused delivery after all" <<'PY'
edit("sce/src/runtime/StateMachine.cpp",
     "    if (!refusal.empty()) {\n        EventMetadata replacement(\"error.execution\", refusal, \"platform\");",
     "    if (false) {\n        EventMetadata replacement(\"error.execution\", refusal, \"platform\");")
PY

mutation_case "the engine answers the refusal by raising it and goes on with the delivery" <<'PY'
edit("sce/src/runtime/StateMachine.cpp",
     "    if (!refusal.empty()) {\n        EventMetadata replacement(\"error.execution\", refusal, \"platform\");",
     "    if (!refusal.empty() && eventRaiser_) {\n        eventRaiser_->raiseEvent(\"error.execution\", refusal);\n    }\n    if (false) {\n        EventMetadata replacement(\"error.execution\", refusal, \"platform\");")
PY

mutation_case "the library lets a refused delivery in" <<'PY'
edit("sce-build/src/forge/static_js/sce_static.js",
     "      return '`' + String(event.name) + '` payload: ' + String(why);",
     "      return '';")
PY

mutation_case "the library's reader reads no field of the record" <<'PY'
edit("sce-build/src/forge/static_js/sce_static.js",
     "    var door = doors[event.name];",
     "    return '';")
PY

mutation_case "a document under another data model is given no door" <<'PY'
edit("sce-build/src/forge/static_js.rs",
     "        return install_doors(text, model).map_err(refuse);",
     "        return Ok(text.to_string());")
PY

mutation_case "an event whose schema holds a composed value is given no door" <<'PY'
edit("sce-build/src/forge/static_js.rs",
     "        if let Some(descriptor) = composed.get(event) {",
     "        if let Some(descriptor) = composed.get(event).filter(|_| false) {")
PY

mutation_case "a composed door lets its delivery in unread" <<'PY'
edit("sce-build/src/forge/static_js/sce_static.js",
     "        kept = { name: event.name, value: payload(event.data, door.type) };",
     "        kept = null;")
PY
