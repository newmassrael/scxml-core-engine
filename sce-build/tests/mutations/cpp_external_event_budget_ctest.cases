# Mutation cases for "a call that drains a self-refilling external queue is
# handed back", C++ AOT engine.
#
# Run with
# `scripts/mutate sce-build/tests/mutations/cpp_external_event_budget_ctest.cases`.
#
# A machine that answers an event by sending itself the next one, with no
# target, never lets the external queue empty, and every macrostep of it ends, so
# the microstep ceiling never applies: the call did not return. The C++ AOT
# engine takes at most `maxExternalEventsPerCall()` events in one invocation of
# its main event loop, leaves the rest queued, and counts the cut; and it bounds
# the scheduler entries due AT one clock reading popped by one tick by the same
# budget (ARCHITECTURE.md "External-Event Budget", rules 1-5). `processEvent`
# handles the host's event directly, so the loop it runs starts with one event
# spent. This engine hands a STATIC zero delay to its scheduler, so `zero` and
# `zero_expr` both hold the same-instant bound.
# `tests/integration/external_chain_is_bounded.scxml` is the document.
#
# What is easy to get wrong and reads as success: a budget off by one in either
# direction (the chain that ENDS at exactly the budget is the case that tells
# them apart), the host's own event not counted as the first of its invocation, a
# refusal that swallows the event it declined (the chain stops short and never
# finishes), a cut that is not counted, and a same-instant bound that counts what
# it must not: a clock the host moved a long way pops many entries at ONE
# reading and they are not a runaway.
#
# A mutation that removes a bound leaves the binary spinning, and the harness
# caps every run, so "did not terminate" is the verdict that case is held to.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^IntegrationTests$'
mutation_targets sce/include/static/StaticExecutionEngine.h sce/include/common/SendSchedulingHelper.h
mutation_oracles tests/integration/ExternalChainIsBoundedAotTest.cpp

# ── The refusal itself ──────────────────────────────────────────────

mutation_case "the drain has no budget at all" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "            if (taken >= maxExternalEventsPerCall_) {",
     "            if (false) {")
PY

mutation_case "the budget is one event more than it says" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "            if (taken >= maxExternalEventsPerCall_) {",
     "            if (taken > maxExternalEventsPerCall_) {")
PY

mutation_case "the budget is one event fewer than it says" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "            if (taken >= maxExternalEventsPerCall_) {",
     "            if (taken + 1 >= maxExternalEventsPerCall_) {")
PY

# ── The host's own event is the first of its invocation ─────────────
#
# `processEvent` handles the event directly and then runs the loop, so the loop
# starts with one spent. A door that starts at zero gives the host's call one
# event more than the budget says: `spin` then leaves `links == B`, not `B - 1`.

mutation_case "processEvent's loop starts with nothing spent" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "[this] { runMainEventLoop(1); }",
     "[this] { runMainEventLoop(0); }")
PY

# ── The refusal leaves the queue alone ──────────────────────────────
#
# Popping before asking consumes the event the drain then declines to run. The
# chain is still bounded and the count still moves, so only the `resume` outcome
# can see it: it stops a link short of its end and never finishes.

mutation_case "the drain swallows the event it refused" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "                recordTruncatedEventChain(externalQueue_.front().event);\n                break;",
     "                recordTruncatedEventChain(externalQueue_.front().event);\n                (void)externalQueue_.pop();\n                break;")
PY

# ── The cut is said ─────────────────────────────────────────────────

mutation_case "a cut is not counted" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        ++truncatedEventChains_;\n",
     "        truncatedEventChains_ += 0;\n")
PY

mutation_case "the cut does not say which event it was still taking" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        hasTruncatedEvent_ = head.has_value();",
     "        hasTruncatedEvent_ = head.has_value() && false;")
PY

# ── The budget is the invocation's own, from a clean start ──────────

mutation_case "an invocation starts with one event already spent" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        uint32_t taken = alreadyTaken;",
     "        uint32_t taken = alreadyTaken + 1;")
PY

# ── The scheduler cannot refill itself without end ──────────────────
#
# A static `delay="0ms"` and a `delayexpr` that evaluates to zero both reach this
# engine's scheduler. Without the same-instant bound the tick that pops one finds
# each handler has armed another due at the same reading, and never returns.

mutation_case "the scheduler's same-instant pops have no budget" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "                    if (poppedDueAtReading >= maxExternalEventsPerCall_) {",
     "                    if (false) {")
PY

# The bound must count entries due AT the reading, not every entry popped at it.
# The reading is latched for the whole tick, so a host that jumps the clock eight
# milliseconds pops eight entries at ONE reading, seven of them due earlier: a
# bound on pops at the reading would refuse a legitimate time-driven chain.

mutation_case "the same-instant bound counts entries that came due earlier" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "head && head->fireTime == now) {",
     "head && head->fireTime <= now) {")
PY

# ── What a host may set ─────────────────────────────────────────────

mutation_case "a budget that takes no event is accepted" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        if (limit < 1) {\n            return false;\n        }",
     "        if (limit < 1 && false) {\n            return false;\n        }")
PY

mutation_case "a budget the host sets is ignored" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "        maxExternalEventsPerCall_ = limit;\n        return true;",
     "        return true;")
PY

mutation_case "the default budget is not the documented one" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "static constexpr uint32_t DEFAULT_MAX_EXTERNAL_EVENTS_PER_CALL = 10000;",
     "static constexpr uint32_t DEFAULT_MAX_EXTERNAL_EVENTS_PER_CALL = 1000;")
PY
