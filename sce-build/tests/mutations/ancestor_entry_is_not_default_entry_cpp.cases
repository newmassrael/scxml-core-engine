# Mutation cases for §scxml-D-addAncestorStatesToEnter — a state entered only
# because the transition's target lies inside it takes NO default child.
#
# Run with `scripts/mutate sce-build/tests/mutations/ancestor_entry_is_not_default_entry_cpp.cases`.
#
# Appendix D asks two different questions with two functions.
# `addDescendantStatesToEnter` gives a compound state its default child and is
# called for the transition's TARGET; `addAncestorStatesToEnter` walks the
# states between the target and the domain and adds them WITHOUT defaults. The
# C++ engines ask both through `EntrySetAlgorithms` in
# `sce/include/core/EntrySetHelper.h`, the one transcription of the appendix
# the generated code and the engine share — so that is where the mutations go.
#
# ⚠ This file used to aim at the generated transition code's own `pathChild`
# walk in `process_transition.jinja2`, measured as the path this shape of
# transition actually took. That walk is gone: every AOT microstep now enters
# the entry set `computeEntrySet` returns, so the helper is the code under test
# and a mutation of it reaches the oracles below through every generated
# machine.
#
# Why the clause needs a witness at all. It is asserted in three places and
# was witnessed in none: `integration_resources/ancestor_entry_is_not_default_entry/`
# pins it across seven channels, `examples/ai_loop/ai_loop.scxml` demonstrates
# it, and `AnsweringAQuestionDoesNotRePrimeTheSession` asserts it as the
# supervision bug it shipped as — and until this file nothing under
# `sce-build/tests/mutations/` broke the entry walk to find out whether any of
# them would notice.
#
# The defect it restores is not loud. Measured 2026-08-15 on both AOT engines
# with every W3C fixture green: an engine that gives every entered compound
# state its default leaves two of one state's children active at once, and in
# the worked example the extra child is `priming`, whose `<onentry>` sends the
# opening prompt. The symptom was a supervised session being re-sent its
# opening prompt every time a person answered a dialog. Nothing crashed.

mutation_ctest --test-dir build -R '^IntegrationTests$'
mutation_targets sce/include/core/EntrySetHelper.h
mutation_oracles tests/integration/AncestorEntryIsNotDefaultEntryAotTest.cpp
mutation_oracles tests/integration/AiLoopAotTest.cpp

# ── An ancestor is entered as though it were a target ──────────────
#
# The ancestor walk hands each state it adds to addDescendantStatesToEnter
# instead of adding it alone, so every compound state between the target and
# the domain takes its default initial child as well as the child the target
# lies in. It is the shape a reader writing the walk from the prose can land
# on, because "enter this state" and "enter this state by default" are one
# call apart.

mutation_case "an ancestor on the way to the target takes its default child" <<'PY'
edit("sce/include/core/EntrySetHelper.h",
     """            addOnce(entry.statesToEnter, anc);
            if (doc.isParallel(anc)) {
                addRegionDefaults(anc, doc, entry);
            }""",
     """            addDescendantStatesToEnter(Target<Doc>::onState(anc), doc, entry);""")
PY

# ── A region already taken is given its default too ────────────────
#
# The same defect reached from the other end: the `<parallel>` exception —
# every region is entered — applied without its own exception, so the region
# the entry set already descends into gets its default child as well. Worth
# pinning separately because it survives any rewrite of the walk above.

mutation_case "a parallel ancestor defaults the region the target lies in" <<'PY'
edit("sce/include/core/EntrySetHelper.h",
     """            if (!taken) {
                addDescendantStatesToEnter(Target<Doc>::onState(child), doc, entry);
            }""",
     """            (void)taken;
            addDescendantStatesToEnter(Target<Doc>::onState(child), doc, entry);""")
PY
