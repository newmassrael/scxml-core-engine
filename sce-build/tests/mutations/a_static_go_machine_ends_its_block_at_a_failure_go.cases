# ── A failed statement ends its block ──────────────────────────────

mutation_case "a block goes on after a statement that failed" <<'PY'
edit("tools/codegen/templates/go/actions/_native_statement.go.jinja2",
     "{% if in_action_block is defined and in_action_block %}\n\t\treturn  // W3C SCXML 4.9: the error ends the block\n{% endif %}\n\t}",
     "{% if false and in_action_block is defined and in_action_block %}\n\t\treturn  // W3C SCXML 4.9: the error ends the block\n{% endif %}\n\t}")
PY

# ── An <if> whose cond failed ends its block ───────────────────────

mutation_case "a block goes on after an <if> whose cond failed" <<'PY'
edit("tools/codegen/templates/go/actions/if.go.jinja2",
     "\tif ifCondFailed{{ action.if_ordinal }} {\n\t\treturn // W3C SCXML 4.9: the error ends the block\n\t}",
     "\t_ = ifCondFailed{{ action.if_ordinal }}")
PY

# ── A guard is the lowered expression ──────────────────────────────
#
# ⚠ A guard may be the only place a machine calls an algorithm, and Go refuses an
# import nothing uses, so a mutant that dropped the guard would not compile
# (INCONCLUSIVE, measured 2026-10-03 on `static_record` and `sync_client`). The
# guard stays in the expression and is short-circuited: it is never asked.

mutation_case "a transition's native guard is not asked" <<'PY'
edit("tools/codegen/templates/go/process_transition.go.jinja2",
     "{%- elif trans.native_guard -%}{{ trans.native_guard }}",
     "{%- elif trans.native_guard -%}true || ({{ trans.native_guard }})")
PY

# ── A failed value is not written ──────────────────────────────────

mutation_case "a statement writes the zero a failed operation answered" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "            Self::then(&[failed, \"return true\"]),\n            write(\"sceValue\")",
     "            Self::then(&[failed]),\n            write(\"sceValue\")")
PY

# ── A failed argument does not reach the host ──────────────────────

mutation_case "the host is called with the argument that failed" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "             if sceFailure.Failed() {{ {} }} else {{ {callee}({}) }} }}\",",
     "             if false {{ {} }} else {{ {callee}({}) }} }}\",")
PY

# ── Content that reads the payload runs only for a delivery that carried it ──

mutation_case "content reads a payload no delivery carried" <<'PY'
edit("tools/codegen/templates/go/process_transition.go.jinja2",
     "{% if trans.content_reads_payload %}\n\t\t\t\tif p.pendingPayloadTag != {{ machine_name }}PayloadTag{{ trans.event | to_event_variant }} {\n\t\t\t\t\treturn\n\t\t\t\t}\n{% endif %}",
     "")
PY

# ── A donedata pair that failed is left out ────────────────────────

mutation_case "a donedata pair that failed is carried as the zero" <<'PY'
edit("tools/codegen/templates/go/entry_exit_actions.go.jinja2",
     "{% if param.native_fails %}\n\t\t\t\t\tif !sceFailure.Failed() {\n",
     "{% if param.native_fails %}\n\t\t\t\t\tif true || !sceFailure.Failed() {\n")
PY

# ── A send param that failed is left out ───────────────────────────

mutation_case "a send param that failed is carried as the zero" <<'PY'
edit("tools/codegen/templates/go/actions/send.go.jinja2",
     "{% if param.native_fails %}\n\t\t\tif !sceFailure.Failed() {\n\t\t\t\tparts = append(",
     "{% if param.native_fails %}\n\t\t\tif true || !sceFailure.Failed() {\n\t\t\t\tparts = append(")
PY

# ── A child is handed the values its invoke names ──────────────────

mutation_case "a child is started without the values its invoke names" <<'PY'
edit("tools/codegen/templates/go/invoke_methods.go.jinja2",
     "\t\t\t\tchildPolicy.AcceptParams(seed)\n",
     "\t\t\t\t_ = seed\n")
PY

# ── A list holds no more than its bound ────────────────────────────

mutation_case "an append past the capacity is not refused" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "             if len({target}) >= {capacity} {{ {} }}; \\\n",
     "             if false && len({target}) >= {capacity} {{ {} }}; \\\n")
PY

# ── A string holds no more than its bound ──────────────────────────
#
# `static_string_capacity`: `copy` assigns a sixteen-byte `body` to a four-byte
# `title`, and the refused copy must leave `title` and `copied` as they were. A
# value written without the bound is a string the variable never declared.

mutation_case "a string is assigned past its capacity" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "format!(\"scealgorithm.Bounded(&sceFailure, {value}, {capacity})\")",
     "format!(\"scealgorithm.Bounded(&sceFailure, {value}, {capacity} + 1000000)\")")
PY

# ── A payload's enum field holds a variant of its enum ─────────────
#
# `static_payload_enum`: `view.shown` carries a `layout` named as the enum
# document declares it. A name no variant declares (`fortnight`) is a payload that
# does not fit its schema, and the delivery must be refused with nothing written
# — a name taken for the enum's first value writes the `zoom` beside it.

mutation_case "a payload's enum field takes a name no variant declares" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "                 return 0, fmt.Errorf(\\\"%q (%s) is not a variant of {alias}\\\", \\\"{id}\\\", name) }}()\",\n",
     "                 return 0, nil }}()\",\n")
PY
