mutation_targets backends/go/tests/integration/static_datamodel/static_host_call/static_host_call_sm.go
mutation_targets backends/go/tests/integration/static_datamodel/static_host_call_arguments/static_host_call_arguments_sm.go
mutation_targets backends/go/tests/integration/static_datamodel/static_invoke/static_invoke_sm.go
mutation_targets backends/go/tests/integration/static_datamodel/static_invoke/static_invoke__sce_synth_invoke__worker_sm.go
mutation_targets backends/go/tests/integration/static_datamodel/static_invoke_params/static_invoke_params_sm.go
mutation_targets backends/go/tests/integration/static_datamodel/static_invoke_params/static_invoke_params__sce_synth_invoke__control_sm.go
