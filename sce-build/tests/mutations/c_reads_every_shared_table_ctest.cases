# Mutation cases for the tables every backend's tests read at run time (ARCHITECTURE.md,
# "JSON Text", "JSON Number Text", "Durations", "Document Stem"): the C11 runtime's tests
# read each one, and a table a test does not read is a table that cannot be wrong. The
# object key order table is read by a cargo test that generates C, so it has its own
# casefile, `c_reads_the_shared_key_order_table.cases`.
#
# Run with `scripts/mutate sce-build/tests/mutations/c_reads_every_shared_table_ctest.cases`.
#
# Each mutant changes one expected value of one table to an answer no engine gives, and
# leaves the table well formed, so only a test that loads the table can tell it from the
# right one. The real-text case is held twice, by the wire writer's unit test and by the
# typed payload seam of a generated machine. A SURVIVED here means the C11 tests carry
# their own copy of that table's expectations, or do not read the table at all.
#
# Anchors are literal slices of the table; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^(c11_unit_json_text|c11_integration_event_schema_real|c11_unit_duration|c11_unit_document_stem)$'
mutation_runtime_targets tests/json_text/string_escape.json tests/json_text/real_text.json tests/durations/css2_time.json tests/document_stem/document_stem.json
mutation_oracles backends/c/tests/unit/shared_table.h backends/c/tests/unit/json_text_test.cbackends/c/tests/integration/test_event_schema_real.c backends/c/tests/unit/duration_test.c backends/c/tests/unit/document_stem_test.c

mutation_case "a string's escaped form is written down wrongly" <<'PY'
edit("tests/json_text/string_escape.json",
     '{ "name": "plain text", "text": "hello", "escaped": "hello" }',
     '{ "name": "plain text", "text": "hello", "escaped": "hellp" }')
PY

mutation_case "a real's text is written down wrongly" <<'PY'
edit("tests/json_text/real_text.json",
     '{ "name": "ten", "bits": "4024000000000000", "text": "10" }',
     '{ "name": "ten", "bits": "4024000000000000", "text": "11" }')
PY

mutation_case "a duration's milliseconds are written down wrongly" <<'PY'
edit("tests/durations/css2_time.json",
     '{ "name": "whole seconds", "text": "1s", "ms": 1000 }',
     '{ "name": "whole seconds", "text": "1s", "ms": 1001 }')
PY

mutation_case "a document's stem is written down wrongly" <<'PY'
edit("tests/document_stem/document_stem.json",
     '{ "name": "a bare file name", "value": "x.scxml", "stem": "x" }',
     '{ "name": "a bare file name", "value": "x.scxml", "stem": "y" }')
PY
