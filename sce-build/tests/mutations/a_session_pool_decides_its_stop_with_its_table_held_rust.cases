# Mutation cases for docs/adr/0115, D13 on the Rust session pool: a stop and
# every admit are decided with the pool's table held, so that once
# `Pool::stop` returned nothing more is admitted, and every input admitted
# before it was applied or answered once.
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_session_pool_decides_its_stop_with_its_table_held_rust.cases`.
#
# The oracle is the loom models of `backends/rust/mesh/src/pool.rs` (module
# `pool::tests::loom_models`), which run a stop against a post, and a stop
# against the wake of a session that came due, under every interleaving within
# three preemptions of the table, the slots' locks and the stop's flags. The
# property is also the model `SessionPool`'s `StoppedClean`, whose part
# `StopHoldsTable` a run of docs/formal takes out. Each case moves one read of
# the stop back outside the table's lock, where it was before the fix:
#
#   a post reads the stop before it takes the table, and the admit under the
#   table no longer reads it, so a post that read the pool running is admitted
#   after the stop drained and saved its sessions;
#   a call of `Pool::due` reads the stop only before it reads the store, so a
#   wake named there is admitted after the stop returned.
#
# Either fails a model by the session it loads after the stop returned. The
# stop's own write of its flag with the table held is not a case: the drain
# that follows takes the table, so an admit that read the flag unset is seen
# there either way, and a case that removed that lock would read SURVIVED.
#
# The models build only under `--cfg loom`. The selector passes it as a cargo
# `--config`, as the bounded inbox ring's casefiles do, with the same target
# directory of its own so that the cfg does not invalidate the ordinary build's.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-rust-mesh --release --target-dir target/loom --config 'build.rustflags=["--cfg","loom"]' --lib pool::tests::loom_models
mutation_targets backends/rust/mesh/src/pool.rs
mutation_oracles backends/rust/mesh/src/pool.rs

mutation_case "a post reads the stop before it holds the table" <<'PY'
edit("backends/rust/mesh/src/pool.rs",
     r'''        self.post_in(&mut hold(&self.table), key, input).map(|_| ())''',
     r'''        if self.stopping.load(Ordering::SeqCst) {
            return Err((input, Full::Stopping));
        }
        self.post_in(&mut hold(&self.table), key, input).map(|_| ())''')
edit("backends/rust/mesh/src/pool.rs",
     r'''        // Read with the table held, as `Self::stop` sets it.
        let stopping = self.stopping.load(Ordering::SeqCst);''',
     r'''        let stopping = false;''')
PY

mutation_case "a wake reads the stop only before it reads the store" <<'PY'
edit("backends/rust/mesh/src/pool.rs",
     r'''        let mut table = hold(&self.table);
        // Read again with the table held, as `Self::stop` sets it: a stop
        // decided while the store was read admits no session named here.
        if self.stopping.load(Ordering::SeqCst) {
            return Vec::new();
        }
        for (key, indexed) in named {''',
     r'''        let mut table = hold(&self.table);
        for (key, indexed) in named {''')
PY
