# Mutation cases for §scxml-B-1 — a number's text is ECMAScript's String(value).
#
# Run with `scripts/mutate sce-build/tests/mutations/a_number_reaches_the_wire_as_ecmascript_spells_it.cases`.
#
# `ScriptResultUtils::resultToString` is what every outbound C++ surface asks
# for a value's text: a `targetexpr`, a `delayexpr`, a `<log>` label, and every
# `<param>` a BasicHTTP send form-encodes (§scxml-C-2). Its numeric arm used to
# carry its own rules, and they were wrong where only a document using those
# values could surface it: an infinity took an `int64_t` cast (undefined, observed
# as INT64_MIN), NaN went through an ostringstream that writes `nan`, and the
# default stream precision wrote pi as `3.14159`. The arm now calls
# `SCE::JsonText::numberText`, the one spelling every engine writes
# (ARCHITECTURE.md, "JSON Number Text"), and `tests/json_text/real_text.json`
# holds the cases. Each case below puts one way of losing a rule back.
#
# `JSEngineTests` is kept in the oracle for the cases of a document's own
# `String(x)` through the engines; `JsonText` reads the table.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^(JSEngineTests|JsonText)$'
mutation_targets sce/src/scripting/ScriptResultUtils.cpp sce/include/scripting/ScriptResultUtils.h sce/include/common/JsonText.h
mutation_oracles tests/engine/JSEngineBasicTest.cpp tests/common/JsonTextTest.cpp

# ── The callers stop using the one writer ──────────────────────────
# (A scalar's text is `scalarText`, in the header, since 2026-10-06: generated
# code under `datamodel="sce-static"` links no SCE library and reaches it there;
# `resultToString` calls it for the same arms.)

mutation_case "a double's text is std::to_string's again" <<'PY'
edit("sce/include/scripting/ScriptResultUtils.h",
     "        return JsonText::numberText(std::get<double>(value));",
     "        return std::to_string(std::get<double>(value));")
PY

mutation_case "a double in an array is std::to_string's again" <<'PY'
edit("sce/src/scripting/ScriptResultUtils.cpp",
     "                            return JsonText::numberText(v);",
     "                            return std::to_string(v);")
PY

# ── The writer loses a rule ────────────────────────────────────────

mutation_case "an infinity is no longer spelled" <<'PY'
edit("sce/include/common/JsonText.h",
     """    if (std::isinf(value)) {
        return value > 0 ? "Infinity" : "-Infinity";
    }
""",
     "")
PY

mutation_case "NaN is spelled the way iostream spells it again" <<'PY'
edit("sce/include/common/JsonText.h",
     """    if (std::isnan(value)) {
        return "NaN";
    }""",
     """    if (std::isnan(value)) {
        return "nan";
    }""")
PY

mutation_case "negative zero keeps its sign" <<'PY'
edit("sce/include/common/JsonText.h",
     """    if (value == 0.0) {
        return "0";
    }""",
     """    if (value == 0.0) {
        return std::signbit(value) ? "-0" : "0";
    }""")
PY

mutation_case "decimal notation ends at 1e20" <<'PY'
edit("sce/include/common/JsonText.h",
     "    if (k <= point && point <= 21) {",
     "    if (k <= point && point <= 20) {")
PY

mutation_case "decimal notation of a small value reaches 1e-7" <<'PY'
edit("sce/include/common/JsonText.h",
     "    } else if (-6 < point && point <= 0) {",
     "    } else if (-7 < point && point <= 0) {")
PY
