# Mutation cases for the `<content expr>` of a host-served `<send>` that names
# one value, in a `datamodel="sce-static"` machine generated as C11
# (docs/SCE_ACCEPTED_SUBSET.md §2.15).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_c_send_content_value_is_the_whole_event_data_ctest.cases`.
#
# The expression is C the lowering wrote, read from the machine's own fields when
# the send runs, and the template only places it: the value is the event's whole
# data as the JSON `sce_forge_wire_json` writes (`8`, `"busy"`) and, in the
# request a host serves, the `content` as the text `sce_forge_wire_text` renders
# (`8`, `busy`), both from the one reading. A value that cannot be computed — a
# checked multiplication that overflows — is the evaluation that failed (W3C SCXML
# 5.6.2): `error.execution` is raised and the empty string is the content's
# value, so the message still goes, and the error ends the block it is in (W3C
# SCXML 4.9).
#
# What is easy to get wrong and reads as success: the zero of a failed value is a
# request that looks complete, a failure that is not reported is one that looks
# like a quiet success, and a block that goes on is a send nobody asked for.
# `statechart_static_host_params` tells them apart: its `lost` is
# `count * 2000000000`, `errors` counts the reports the document took (the pairs'
# `boom`, this and the invoke's), and `after` follows `lost` in its block and
# must never be sent.
#
# The generated machine is built from the template at build time, so the template
# is the declared target and the build is what carries a mutation into it.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^c11_integration_static_host_params$'
mutation_targets tools/codegen/templates/c/state_machine.c.jinja2 backends/c/forge-runtime/include/sce/forge/wire.h
mutation_oracles backends/c/tests/integration/test_static_host_params.c sce-build/tests/fixtures/host_processor/statechart_static_host_params.scxml

# ── A value that cannot be computed is the empty string ────────────

mutation_case "a content value that failed is the zero of its type, not the empty string" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "                        sce_value = sce_forge_wire_string(\"\");\n                        _param_failed = true;",
     "                        sce_value = sce_forge_wire_int(0);\n                        _param_failed = true;")
PY

# ── ... and reported ───────────────────────────────────────────────

mutation_case "a content value that failed is replaced by the empty string without a word" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "                        {{ csym_prefix }}{{ machine }}_raise_platform_error(\n                            sm, {{ csym_prefix | upper }}{{ machine | upper }}_EVENT_ERROR_EXECUTION,\n                            \"<send> <content expr> failed to evaluate\");\n                        sce_value = sce_forge_wire_string(\"\");",
     "                        sce_value = sce_forge_wire_string(\"\");")
PY

# ── ... and ends the block it is in ────────────────────────────────

mutation_case "the error of a content value does not end its block" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "                        sce_value = sce_forge_wire_string(\"\");\n                        _param_failed = true;",
     "                        sce_value = sce_forge_wire_string(\"\");")
PY

# ── The one value is two renderings ────────────────────────────────

mutation_case "a host is handed the JSON of the value as its content" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "{% elif action.native_content_value and not basic_http %}_host_content{% else %}",
     "{% elif action.native_content_value and not basic_http %}_ed{% else %}")
PY

mutation_case "the event's data is the text of the value, not its JSON" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "                    if (!sce_forge_wire_json(sce_value, {{ json_buf }}, sizeof({{ json_buf }}))) {",
     "                    if (!sce_forge_wire_text(sce_value, {{ json_buf }}, sizeof({{ json_buf }}))) {")
PY

# A string is quoted as JSON where it is the event's whole data as it is where it is
# a pair's, from the one writer; the case writes it bare, and `"busy"` is `busy`.
mutation_case "a string value is written without its quotes" <<'PY'
edit("backends/c/forge-runtime/include/sce/forge/wire.h",
     "    case SCE_FORGE_WIRE_STRING:\n        sce_forge_wire_put(w, \"\\\"\", 1u);\n        sce_forge_wire_put_text(w, value.as.s);\n        sce_forge_wire_put(w, \"\\\"\", 1u);\n        break;\n    }\n}\n\n/* End the array",
     "    case SCE_FORGE_WIRE_STRING:\n        sce_forge_wire_put_text(w, value.as.s);\n        break;\n    }\n}\n\n/* End the array")
PY
