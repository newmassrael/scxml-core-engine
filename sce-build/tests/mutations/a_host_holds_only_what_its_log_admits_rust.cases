edit("backends/rust/trust/src/trust.rs",
     "    let epoch_then = state.log.epoch_at(entry);",
     "    let epoch_then = state.log.epoch();")
PY

mutation_case "The epoch at an entry counts the entry after it" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "        self.epoch_began.partition_point(|began| *began <= index) as u32",
     "        self.epoch_began.partition_point(|began| *began < index) as u32")
PY

