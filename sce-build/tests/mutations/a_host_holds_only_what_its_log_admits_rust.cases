# ── What a host drops, tells and keeps when the log or a conflict moves what it held ──────────

mutation_case "A host keeps what it admitted of a device that an entry then took off at a lower number" <<'PY'
edit("backends/rust/trust/src/trust.rs",
     "            evict_past_the_cutoff(&mut state);",
     "            let _ = &mut state;")
PY

mutation_case "A host finds a conflict of a device and does not freeze its chain" <<'PY'
edit("backends/rust/trust/src/chain.rs",
     "            self.frozen = Some(self.frozen.map_or(at, |from| from.min(at)));",
     "            let _ = at;")
PY

# Re-aimed 2026-10-18 at `hold`. A write that freezes a chain lower used to
# reach the machine through `tell_what_changed`; since e2b0a30ab5 `hold` reads
# only what lies above the frozen place and evicts it itself, so that is where
# the machine is told to forget. The case first moved to `tell_what_changed`'s
# copy of the line, which only the cutoff path still reaches, and SURVIVED
# there (0/109): the eviction this case names is no longer made at that site.
mutation_case "A host that froze a device does not tell its machine to forget what it was told" <<'PY'
edit("backends/rust/trust/src/trust.rs",
     """    if !left.is_empty() {
        state
            .evicted
            .extend(left.into_iter().map(|seq| (node, seq)));""",
     """    if !left.is_empty() {
        state
            .evicted
            .extend(std::iter::empty::<(u64, u64)>().chain(left.into_iter().map(|_| (0, 0))).take(0));""")
PY

mutation_case "A device whose chain conflicts goes on signing" <<'PY'
edit("backends/rust/trust/src/trust.rs",
     "    if let Some(from) = state.ops.get(&author).and_then(Chain::frozen) {",
     "    if let Some(from) = state.ops.get(&author).and_then(Chain::frozen).filter(|_| false) {")
PY

mutation_case "A device signs a write whose stamp goes back or repeats" <<'PY'
edit("backends/rust/trust/src/trust.rs",
     "    if let Some((at, why)) = conflict {",
     "    if let Some((at, why)) = conflict.filter(|_| false) {")
PY

mutation_case "A device with a new key numbers its first operation as the old chain's next" <<'PY'
edit("backends/rust/trust/src/trust.rs",
     "        Some(last) if last.seq() > floor => (last.seq() + 1, last.id),",
     "        Some(last) if last.seq() >= floor => (last.seq() + 1, last.id),")
PY

# ── What a write is judged by: the entry it names, not how far this host's log has come ───────

