# ── The entries of the log: a linked device, an amendment, a destroyed epoch ──────────────────

mutation_case "A device is linked with a higher role than its parent's" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "                if *role > linking.role {",
     "                if false {")
PY

mutation_case "A device is linked as a node the log has held before" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "                if self.members.contains_key(node) {",
     "                if false {")
PY

mutation_case "A device is linked without its parent's signature" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "                if !linking.key.verifies(&statement, parent_signature)",
     "                if false")
PY

mutation_case "An amendment lowers the last accepted or leaves it" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "        if final_seq <= cutoff {",
     "        if false {")
PY

mutation_case "An amendment is shown by the checkpoint of the device that was taken off" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "                || checkpoint.device == node\n",
     "                || false\n")
PY

mutation_case "An amendment is shown by a checkpoint made after the removal" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "                || checkpoint.log >= index\n",
     "                || false\n")
PY

mutation_case "An amendment is shown by a checkpoint that does not reach the number" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "                    .any(|head| head.node == node && head.seq >= final_seq)",
     "                    .any(|head| head.node == node)")
PY

mutation_case "The keys of the epoch the list is in may be destroyed" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "                if *epoch == 0 || *epoch >= self.epoch {",
     "                if *epoch == 0 {")
PY

mutation_case "An epoch may be destroyed twice" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "                if !self.shredded.insert(*epoch) {",
     "                if false && !self.shredded.insert(*epoch) {")
PY
