PY

mutation_case "A host takes a checkpoint that names an entry of the log it does not hold as it is" <<'PY'
edit("backends/rust/trust/src/trust.rs",
     "    if state.log.hash_at(checkpoint.log) != Some(checkpoint.log_hash) {",
     "    if false {")
