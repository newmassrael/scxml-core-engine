     "                Ok(_) => LogError::Fork { index: entry.index },\n                Err(error) => error,",
     "                Ok(_) => LogError::Fork { index: entry.index },\n                Err(_) => LogError::Fork { index: entry.index },")
PY

mutation_case "An entry that names an entry this log lacks and is under-signed is taken for a fork" <<'PY'
edit("backends/rust/trust/src/membership.rs",
     "            Ok(had) if had >= needed => LogError::Fork { index: entry.index },\n            Ok(had) => LogError::NotEnoughSignatures { needed, had },",
