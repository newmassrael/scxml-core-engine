# Mutation cases for "an event that arrives by name is delivered as the event
# whose name it extends, or as the wildcard" (Go engine).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/go_event_arrival_name.cases`.
#
# An event arrives by name from outside the document — a child's autoforward, a
# host, a host-served act's reply — so the names it can arrive under are open
# (§scxml-3.12.1): `request` takes `request.new` though the document never writes
# it, a name no descriptor of the document matches is the wildcard member's when
# the document listens with `event="*"`, and is dropped when it does not.
# `Engine.ResolveEventByName` is the one rule every by-name door of the engine
# reaches the machine through, and
# `sce-build/tests/fixtures/static_datamodel/scenarios/static_event_arrival.json`
# and `static_event_wildcard.json` state what it decides, replayed by
# `backends/go/tests/integration/static_datamodel/static_scenarios_test.go`.
#
# Things that are easy to get wrong and read as success: a walk that never leaves
# the whole name (every document that writes its names whole still passes), a
# cut at any character rather than at a `.` (`requesty` is then `request`'s, and
# a machine that is sent a misspelling answers it), a wildcard that is never
# reached (every document without `event="*"` still passes) and one that is taken
# before the document's own events (a name the document writes goes to `*`). Only
# a name that extends a descriptor past a `.`, one that merely begins like it, and
# one that has nothing to do with it tell them apart.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/static_datamodel/
mutation_runtime_targets backends/go/runtime/engine.go
mutation_oracles backends/go/tests/integration/static_datamodel/static_scenarios_test.go

mutation_case "the walk never leaves the whole name" <<'PY'
edit("backends/go/runtime/engine.go",
     "\t\tat := strings.LastIndexByte(candidate, '.')\n",
     "\t\tat := strings.LastIndexByte(candidate, '.') - len(candidate) - 1\n")
PY

mutation_case "the name is cut at any character, not at a token boundary" <<'PY'
edit("backends/go/runtime/engine.go",
     "\t\tat := strings.LastIndexByte(candidate, '.')\n",
     "\t\tat := len(candidate) - 1 + 0*strings.LastIndexByte(candidate, '.')\n")
PY

mutation_case "a name no event of the document matches is dropped although it has a wildcard" <<'PY'
edit("backends/go/runtime/engine.go",
     "\t\t\treturn e.policy.GetEventFromName(\"*\")\n",
     "\t\t\tvar none E\n\t\t\treturn none, false\n")
PY

mutation_case "the wildcard member takes a name before the document's own events" <<'PY'
edit("backends/go/runtime/engine.go",
     "\tcandidate := name\n",
     "\tif event, ok := e.policy.GetEventFromName(\"*\"); ok {\n\t\treturn event, true\n\t}\n\tcandidate := name\n")
PY
