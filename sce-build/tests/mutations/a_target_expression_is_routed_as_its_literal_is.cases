# Mutation cases for §scxml-6.2.4 / §scxml-C-1 on `<send targetexpr>`: the
# value is routed as the same value written in `target` is, at once or after
# a delay, by one target table per runtime — a target naming nothing that is
# there is error.communication when the send is made, one the SCXML Event I/O
# Processor does not support is error.execution, and either ends the block.
#
# Run with `scripts/mutate sce-build/tests/mutations/a_target_expression_is_routed_as_its_literal_is.cases`.
#
# Measured 2026-09-29, before this round no generated channel routed a dynamic
# `#_parent`, `#_<invokeid>` or foreign session anywhere but the sender's own
# external queue, and none raised error.execution for an unsupported value.
# The cases below hold the three channels this harness reaches; the Rust, Go,
# Kotlin and Python halves are held by the same fixture in their suites.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^(IntegrationTests|c11_integration_a_target_expression_is_routed_as_its_literal_is)$'
mutation_targets sce/include/common/SendHelper.h sce/include/static/StaticExecutionEngine.h tools/codegen/templates/c/state_machine.c.jinja2
mutation_oracles tests/integration/ATargetExpressionIsRoutedAsItsLiteralIsTest.cpp tests/integration/ATargetExpressionIsRoutedAsItsLiteralIsAotTest.cpp backends/c/tests/integration/test_a_target_expression_is_routed_as_its_literal_is.c

# ── The table: a value no processor addresses is accepted ──────────

mutation_case "the interpreter accepts a target the SCXML processor does not support" <<'PY'
edit("sce/include/common/SendHelper.h",
     "            (scxmlProcessor && !target.empty() && classifyTarget(target, \"\").kind == SendTarget::Kind::Unsupported);",
     "            (scxmlProcessor && target.empty());")
PY

# ── C++ AOT: an orphan's `#_parent` is held by another casefile ────
#
# The guard on `hasParentSession()` in `StaticExecutionEngine.h` is not a case
# of this file: this fixture's root sends to `#_parent` only through a
# `targetexpr`, so its generated machine carries no parent delivery and takes
# the compile-time `else` beside the guard — the guard is not in the binary,
# and the case SURVIVED (measured 2026-09-30). The orphan's `#_parent` through
# a `targetexpr` is held in `a_send_reaches_only_what_its_target_names.cases`,
# whose root carries a literal `#_parent` send and so has the guard to mutate.
#
# What this fixture does reach is the `else` itself: a machine with no parent
# delivery, told to send to `#_parent`, reports it unreachable at compile time.
# Reporting it as sent instead is the silence the row was written against.

mutation_case "the C++ AOT reports a #_parent send from a machine with no parent as sent" <<'PY'
edit("sce/include/static/StaticExecutionEngine.h",
     "            } else {\n                return TargetSendOutcome::Unreachable;\n            }\n            route = ::SCE::ScheduledRoute{RouteKind::Parent, eventName, \"\"};",
     "            } else {\n                return TargetSendOutcome::Sent;\n            }\n            route = ::SCE::ScheduledRoute{RouteKind::Parent, eventName, \"\"};")
PY

# ── C++ AOT: a session target is delivered to no one ───────────────

mutation_case "the C++ AOT reads a foreign session as unreachable" <<'PY'
edit("sce/include/common/SendHelper.h",
     "            return {Kind::Session, located};",
     "            return {Kind::Unreachable, \"\"};")
PY

# ── C11: an orphan's delayed `#_parent` waits instead of failing ───

# ⚠ The anchor is the INNER test, `sm->parent_sm == NULL`, with the raise it
# guards. The branch now reads `parent_dispatch == NULL` and then asks whether
# the session ever had a parent: a parent that was cancelled clears only the
# dispatch pointer (test252) and that send is dropped, while a session nothing
# invoked has no `parent_sm` at all and must raise. Killing the outer test
# would send both down another path; killing this one is the defect the case
# names — the orphan's send waits instead of failing.
mutation_case "C11 schedules a #_parent send from a session nothing invoked" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "                            if (sm->parent_sm == NULL) {\n                                {{ P }}_raise_platform_error_with_send_id(\n                                    sm, {{ PU }}_EVENT_ERROR_COMMUNICATION,\n                                    \"<send> targetexpr names #_parent, and nothing invoked this session\",",
     "                            if (false) {\n                                {{ P }}_raise_platform_error_with_send_id(\n                                    sm, {{ PU }}_EVENT_ERROR_COMMUNICATION,\n                                    \"<send> targetexpr names #_parent, and nothing invoked this session\",")
PY

# ── C11: an invocation target is reported unreachable ──────────────

mutation_case "C11 finds no running invocation for #_<invokeid>" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "                            _send_invoke = invocation_is_running(sm, _send_target_id)\n                                               ? _send_target_id\n                                               : invocation_of_session(sm, _send_target_id);",
     "                            _send_invoke = invocation_of_session(sm, _send_target_id);")
PY
