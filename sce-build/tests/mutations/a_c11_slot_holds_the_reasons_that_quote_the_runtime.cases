# Mutation cases for "a C11 machine's slot holds the reasons that quote a
# sentence of the runtime, and the machine checks the bound".
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_c11_slot_holds_the_reasons_that_quote_the_runtime.cases
#
# docs/adr/0086, section 8.6 (b): the lift of a typed payload quotes the
# sentence a payload reader refused with, and a host-run invocation's start
# raises the host's refusal whole. The tests generate a machine with a typed
# guard and one with a host-run invocation, and ask the header for a longest
# reason that holds the quoted bound and the source for the static assertion
# of that bound. Each case breaks one link: the lift quotes with no bound, the
# host's refusal is not held, the source checks no bound.
#
# The machine is generated by `sce-codegen`, which the test runs as a
# subprocess, so the generator's source is a target compiled into a binary the
# test spawns.

mutation_tests -p sce-build --features cli --test a_c11_machine_sizes_its_event_data_slot
mutation_targets sce-build/src/forge/generator.rs sce-build/src/generator.rs tools/codegen/templates/c/state_machine.c.jinja2

mutation_case "the lift quotes a field's refusal with no bound" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "        &[event, id],\n        crate::forge::c11_reasons::Quote::Published(crate::forge::c11_reasons::PAYLOAD_REFUSAL),\n",
     "        &[event, id],\n        crate::forge::c11_reasons::Quote::Within(0),\n")
PY

mutation_case "the host's refusal is no reason of the machine" <<'PY'
edit("sce-build/src/generator.rs",
     "    if !model.host_invoker_types.is_empty() {\n        crate::forge::c11_reasons::HOST_INVOKE_REFUSED\n",
     "    if model.host_invoker_types.is_empty() {\n        crate::forge::c11_reasons::HOST_INVOKE_REFUSED\n")
PY

mutation_case "the source checks no bound its reasons quote" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     "{% if bounds_checked %}\n",
     "{% if false %}\n")
PY
