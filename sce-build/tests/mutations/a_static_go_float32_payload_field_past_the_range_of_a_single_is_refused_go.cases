# Mutation cases for "a payload number past the range of a single does not fit
# a field a schema declares float32" under the Go runtime
# (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A 32-bit real").
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_go_float32_payload_field_past_the_range_of_a_single_is_refused_go.cases`.
#
# `PayloadFloat` converted the double to a `float32` whatever it held, which is
# infinity for `1e39`: the machine held infinity where C, Python and the
# Interpreter refuse the delivery. `static_record_real32` sends 1e39 and expects
# the record untouched and `errors` at 1. The case below takes the refusal away
# and leaves a runtime that still reads the single:
#
#   a number past the range of a single is read, as infinity.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/static_datamodel/
mutation_targets backends/go/runtime/event_payload.go
mutation_oracles backends/go/tests/integration/static_datamodel/static_scenarios_test.go sce-build/tests/fixtures/static_datamodel/scenarios/static_record_real32.json

mutation_case "a number past the range of a single is read" <<'PY'
edit("backends/go/runtime/event_payload.go",
     "	if _, single := any(T(0)).(float32); single && math.Abs(v) > math.MaxFloat32 {",
     "	if _, single := any(T(0)).(float32); single && false && math.Abs(v) > math.MaxFloat32 {")
PY
