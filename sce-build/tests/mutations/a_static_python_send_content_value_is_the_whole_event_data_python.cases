# Mutation cases for the `<content expr>` of a host-served `<send>` that names
# one value, in a `datamodel="sce-static"` machine generated as Python
# (docs/SCE_ACCEPTED_SUBSET.md §2.15).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_python_send_content_value_is_the_whole_event_data_python.cases`.
#
# The expression is Python the lowering wrote, read from the policy's own
# attributes when the send runs, and the template only places it: the value is
# the event's whole data as the JSON it is (`8`, `"busy"`) and, in the request a
# host serves, the `content` as the text it is (`8`, `busy`), both from the one
# reading. A value that cannot be computed — a checked multiplication that
# overflows — raises `AlgorithmFailure`, and it is the evaluation that failed
# (W3C SCXML 5.6.2): `error.execution` is raised and the empty string is the
# content's value, so the message still goes, and the error ends the block it is
# in (W3C SCXML 4.9).
#
# What is easy to get wrong and reads as success: a failed value written as the
# zero of its type is a request that looks complete, a failure that is not
# reported is one that looks like a quiet success, and a block that goes on is a
# send nobody asked for. `statechart_static_host_params` tells them apart: its
# `lost` is `count * 2000000000`, `errors` counts the reports the document took
# (the pairs' `boom`, this and the invoke's), and `after` follows `lost` in its
# block and must never be sent.
#
# Python compiles nothing and its generated machines are gitignored, so the
# template reaches the tests only through the regeneration declared below. It is a
# `mutation_runtime_targets` for the reason the other Python casefiles give: what
# shows a mutation arrived is that the file on disk differed while the tests ran.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_pytest backends/python/tests integration/host_processor/test_static_host_params.py
mutation_regen scripts/regen_host_processor_python.sh
mutation_runtime_targets tools/codegen/templates/python/actions/send.py.jinja2
mutation_oracles backends/python/tests/integration/host_processor/test_static_host_params.py sce-build/tests/fixtures/host_processor/statechart_static_host_params.scxml

# ── A value that cannot be computed is the empty string ────────────

mutation_case "a content value that failed is the zero of its type, not the empty string" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{{ indent }}    _param_failures.append(\"\")\n{{ indent }}    _data = \"\"\n",
     "{{ indent }}    _param_failures.append(\"\")\n{{ indent }}    _data = 0\n")
PY

# ── ... and reported ───────────────────────────────────────────────

mutation_case "a content value that failed is replaced by the empty string without a word" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{{ indent }}    self._raise_error_execution(engine, \"<send> contentexpr failed to evaluate\")\n",
     "")
PY

# ── ... and ends the block it is in ────────────────────────────────

mutation_case "the error of a content value does not end its block" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{{ indent }}    _param_failures.append(\"\")\n{{ indent }}    _data = \"\"\n",
     "{{ indent }}    _data = \"\"\n")
PY

# ── The one value is two renderings ────────────────────────────────

mutation_case "a host is handed the JSON of the value as its content" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{{ indent }}    content={% if action.native_content_value %}_ScriptValue.of(_data).to_wire_string(){% else %}",
     "{{ indent }}    content={% if action.native_content_value %}_ScriptValue.of(_data).to_json_literal(){% else %}")
PY
