# Mutation cases for the Rust reader of the value a hybrid `<invoke srcexpr>`
# computes (docs/SCE_ACCEPTED_SUBSET.md §2.13): `document_stem` reduces it to the
# stem of the document it names, and the table
# `tests/document_stem/document_stem.json` holds every engine's reader, and the
# build's, to one answer.
#
# Run with `scripts/mutate sce-build/tests/mutations/rust_document_stem.cases`.
#
# Each mutant changes one decision of the rule — which scheme is dropped, which
# extension goes, what a leading dot is — and leaves a reader that still
# compiles, so only the table can tell it from the right one.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-rust-runtime --lib a_value_is_reduced_to_the_one_stem_every_engine_reduces_it_to
mutation_targets backends/rust/runtime/src/helpers/invoke_processing.rs
mutation_oracles tests/document_stem/document_stem.json

mutation_case "a file: scheme stays in the stem" <<'PY'
edit("backends/rust/runtime/src/helpers/invoke_processing.rs",
     "        .unwrap_or(value)\n        .trim_start_matches(\"file:\");",
     "        .unwrap_or(value);")
PY

mutation_case "the first extension goes, not the last" <<'PY'
edit("backends/rust/runtime/src/helpers/invoke_processing.rs",
     "    match name.rfind('.') {",
     "    match name.find('.') {")
PY

mutation_case "a leading dot is an extension" <<'PY'
edit("backends/rust/runtime/src/helpers/invoke_processing.rs",
     "        Some(dot) if dot > 0 => &name[..dot],",
     "        Some(dot) => &name[..dot],")
PY
