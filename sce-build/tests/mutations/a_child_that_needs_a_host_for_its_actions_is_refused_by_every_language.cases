# Mutation cases for "an `<invoke type=\"scxml\">` of a child that declares
# `<sce:action>`s is refused by a target that does not give the child its host"
# (docs/SCE_ACCEPTED_SUBSET.md §2.15, "Child sessions"; docs/adr/0005, decision 6).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_child_that_needs_a_host_for_its_actions_is_refused_by_every_language.cases`.
#
# A child's machine takes the host that performs its acts when it is built, so a
# parent that does not obtain one for it writes that constructor called with the
# host left out. Every generated language now obtains it from its parent's own host
# (`every_language_builds_a_child_with_the_host_its_parent_answers`, for a parent of
# either data model and for a candidate of a hybrid `<invoke>`), and what still
# refuses is the Interpreter's lowering, which the static lowering asks
# (`StaticTarget::lowers_child_host`) and which the same judges read through
# `sce-codegen lower`, together with the child that declares no act, which it
# lowers. The refusals each generated language used to carry, and the table of
# which did, were retired when the last of them stopped refusing: their mutants
# had no instance left to defend. The mutants take one decision away each:
#
#   a child that declares an act is let through;
#   a child that declares no act is refused too;
#   a candidate that declares an act is let through;
#   the static lowering does not ask;
#   a target that answers is refused all the same.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test a_static_datamodel_holds_every_variable_to_a_type
mutation_targets sce-build/src/forge/native_action.rs sce-build/src/forge/static_lowering.rs
mutation_oracles sce-build/tests/a_static_datamodel_holds_every_variable_to_a_type.rs

mutation_case "a child that declares an act is let through" <<'PY'
edit("sce-build/src/forge/native_action.rs",
     "            crate::model::Invoke::Scxml(info) if info.common.child_declares_host_acts => Some((",
     "            crate::model::Invoke::Scxml(info) if info.common.child_declares_host_acts && false => Some((")
PY

mutation_case "a child that declares no act is refused too" <<'PY'
edit("sce-build/src/forge/native_action.rs",
     "            crate::model::Invoke::Scxml(info) if info.common.child_declares_host_acts => Some((",
     "            crate::model::Invoke::Scxml(info) if info.common.child_declares_host_acts || true => Some((")
PY

mutation_case "a candidate that declares an act is let through" <<'PY'
edit("sce-build/src/forge/native_action.rs",
     "                .find(|candidate| candidate.child_declares_host_acts)\n",
     "                .find(|_| false)\n")
PY

mutation_case "the static lowering does not ask" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "    if let Some(construct) = invoke_of_a_child_that_needs_a_host(model, target)\n",
     "    if let Some(construct) = invoke_of_a_child_that_needs_a_host(model, target).filter(|_| false)\n")
PY

mutation_case "a target that answers is refused all the same" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "    if target.lowers_child_host() {\n        return None;\n    }\n    crate::forge::native_action::child_that_needs_a_host(model)",
     "    if target.lowers_child_host() && false {\n        return None;\n    }\n    crate::forge::native_action::child_that_needs_a_host(model)")
PY
