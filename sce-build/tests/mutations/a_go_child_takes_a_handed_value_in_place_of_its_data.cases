# Mutation cases for docs/adr/0098 on the Go channel: a value an invoke hands
# its child is declared as the initial value of the child's top-level <data>
# it names, in place of that <data>'s own, which is never evaluated
# (§scxml-6.4). A state's <data> never takes one, a name no top-level <data>
# carries is not added, the top-level <script> reads what was handed, and a
# value the session cannot hold is that <data>'s initialization error.
#
# Run with `scripts/mutate sce-build/tests/mutations/a_go_child_takes_a_handed_value_in_place_of_its_data.cases`.
#
# The Go child used to evaluate every <data> and then overwrite the ones whose
# name its session held (`HasVariable`), which reached an early-bound state
# <data> too. Each case below puts back one piece of a wrong shape and names
# the test that must go red. The script engine of the oracle is a double over
# the Lua engine, shared by the parent and its child, that records every
# expression it runs and every value it writes, and can refuse the writes of
# one name, so a failure to hold a handed value is reached through the engine
# a generated machine is handed, as a host's would be.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/a_go_child_takes_a_handed_value_in_place_of_its_data/

# The templates reach the Go tests only through the committed tree the
# regeneration below writes, so both halves are declared: the generated files
# are compiled into the test, and the command is what carries a mutated
# template into them.
mutation_targets tools/codegen/templates/go/scriptengine_helpers.go.jinja2
mutation_targets backends/go/tests/integration/a_go_child_takes_a_handed_value_in_place_of_its_data/a_go_child_takes_a_handed_value_in_place_of_its_data_sm.go
mutation_targets backends/go/tests/integration/a_go_child_takes_a_handed_value_in_place_of_its_data/a_go_child_takes_a_handed_value_in_place_of_its_data__sce_synth_invoke__taker_sm.go
mutation_regen scripts/materialize.sh go-integration

mutation_oracles backends/go/tests/integration/a_go_child_takes_a_handed_value_in_place_of_its_data/a_go_child_takes_a_handed_value_in_place_of_its_data_test.go backends/go/tests/integration/a_go_child_takes_a_handed_value_in_place_of_its_data/a_go_child_takes_a_handed_value_in_place_of_its_data.scxml

# ── The <data>'s own value is evaluated, then overwritten ───────────
#
# The old shape: every top-level <data> takes its own value, and a handed
# one is written over it afterwards. `risky`'s own expression raises and
# `noted`'s pushes onto `trail`, though neither value is kept.
# Killers: `TestAChildTakesEachHandedValueInPlaceOfItsTopLevelData` (the
# parent ends in sawErrorExecution, and the double ran `invalidProperty`)
# and `TestAHandedValueTheSessionCannotHoldIsThatDataInitializationError`
# (the double ran the own values).

mutation_case "a handed data's own value is evaluated, then overwritten" <<'PY'
edit("tools/codegen/templates/go/scriptengine_helpers.go.jinja2",
     "\tif value, wasHanded := handed[\"{{ var.id }}\"]; wasHanded {\n\t\t// §scxml-6.4: {{ var.id }} takes the handed value as its initial\n\t\t// value; its own is not evaluated.\n\t\tp.declareHandedValue(eng, engine, sessionID, \"{{ var.id }}\", value)\n\t} else {\n",
     "\t{\n")
edit("tools/codegen/templates/go/scriptengine_helpers.go.jinja2",
     "{% endif %}\n\t}\n{% endfor %}\n\n{% if model.binding == 'early' %}",
     "{% endif %}\n\t}\n\tif value, wasHanded := handed[\"{{ var.id }}\"]; wasHanded {\n\t\tp.declareHandedValue(eng, engine, sessionID, \"{{ var.id }}\", value)\n\t}\n{% endfor %}\n\n{% if model.binding == 'early' %}")
PY

# ── A handed value is ignored ───────────────────────────────────────
#
# The child declares every top-level <data> with its own value and takes
# nothing it was handed.
# Killer: `TestAChildTakesEachHandedValueInPlaceOfItsTopLevelData`, whose
# parent ends in sawErrorExecution and whose `risky` is never written with
# the handed value.

mutation_case "a handed value is ignored" <<'PY'
edit("tools/codegen/templates/go/scriptengine_helpers.go.jinja2",
     "\tif value, wasHanded := handed[\"{{ var.id }}\"]; wasHanded {\n",
     "\tif value, wasHanded := handed[\"{{ var.id }}\"]; wasHanded && false {\n")
PY

# ── The handed values are declared after the top-level <script> ─────
#
# Each handed <data> is declared when the start returns, after the
# top-level <script> ran: the script reads `risky` before it holds the
# handed value. Its own value is still not evaluated, so this case is held
# by the order alone.
# Killer: `TestAChildTakesEachHandedValueInPlaceOfItsTopLevelData`, whose
# parent ends in sawScriptReadOwnValue.

mutation_case "the handed values are declared after the top-level script" <<'PY'
edit("tools/codegen/templates/go/scriptengine_helpers.go.jinja2",
     "\t\tp.declareHandedValue(eng, engine, sessionID, \"{{ var.id }}\", value)\n\t} else {\n",
     "\t\tdefer p.declareHandedValue(eng, engine, sessionID, \"{{ var.id }}\", value)\n\t} else {\n")
PY

# ── A state's <data> takes a handed value ───────────────────────────
#
# The `HasVariable` shape put back after the early-bound state <data> is
# declared: any name the session holds takes the handed value, so the
# state `report`'s `stateOwned` loses its own.
# Killer: `TestAChildTakesEachHandedValueInPlaceOfItsTopLevelData`, whose
# parent ends in sawStateDataSeeded, and whose `risky` is written twice.

mutation_case "a state's data takes a handed value" <<'PY'
edit("tools/codegen/templates/go/scriptengine_helpers.go.jinja2",
     "{% endif %}\n\n{% if model.global_scripts %}\n\t// W3C SCXML 5.8: Execute global scripts at document load time\n",
     "{% endif %}\n{% if model.variables %}\n\tfor name, value := range handed {\n\t\tif engine.HasVariable(sessionID, name) {\n\t\t\t_ = engine.SetVariable(sessionID, name, value)\n\t\t}\n\t}\n{% endif %}\n\n{% if model.global_scripts %}\n\t// W3C SCXML 5.8: Execute global scripts at document load time\n")
PY

# ── A name no top-level <data> carries is added ─────────────────────
#
# Every handed name becomes a variable of the child before its <data> is
# declared, `stray` among them.
# Killer: `TestAChildTakesEachHandedValueInPlaceOfItsTopLevelData`, whose
# parent ends in sawStrayAdded and whose double wrote `stray`.

mutation_case "a name no top-level data carries is added" <<'PY'
edit("tools/codegen/templates/go/scriptengine_helpers.go.jinja2",
     "\tp.handedValues = nil\n",
     "\tp.handedValues = nil\n{% if model.variables %}\n\tfor name, value := range handed {\n\t\t_ = engine.SetVariable(sessionID, name, value)\n\t}\n{% endif %}\n")
PY

# ── A handed value the session cannot hold raises nothing ───────────
#
# The refused write is passed over: `risky` is left unset and the child
# runs on as if nothing failed.
# Killer: `TestAHandedValueTheSessionCannotHoldIsThatDataInitializationError`,
# whose parent ends in sawOwnValueKept rather than sawErrorExecution.

mutation_case "a handed value the session cannot hold raises nothing" <<'PY'
edit("tools/codegen/templates/go/scriptengine_helpers.go.jinja2",
     "\t\teng.Raise(sce.NewPlatformError({{ machine_name }}Event{{ 'error.execution' | to_event_variant }}, \"<data id='\"+name+\"'> could not hold the value its invoking session handed it\"))\n",
     "")
PY
