     "        message::part(&mut bytes, &self.list);",
     "        let _ = &self.list;")
PY

mutation_case "A checkpoint is signed without the number of heads it holds" <<'PY'
edit("backends/rust/trust/src/checkpoint.rs",
     "message::part(&mut bytes, &self.heads.len().to_string());",
