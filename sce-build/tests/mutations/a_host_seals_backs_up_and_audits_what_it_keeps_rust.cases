PY

mutation_case "A checkpoint whose heads repeat a node is canonical" <<'PY'
edit("backends/rust/trust/src/checkpoint.rs",
     "                .all(|pair| pair[0].node < pair[1].node)",
     "                .all(|pair| pair[0].node <= pair[1].node)")
PY

mutation_case "A checkpoint is read back whatever the order of its heads" <<'PY'
edit("backends/rust/trust/src/checkpoint.rs",
     "checkpoint.is_canonical().then_some(checkpoint)",
     "Some(checkpoint)")
PY
