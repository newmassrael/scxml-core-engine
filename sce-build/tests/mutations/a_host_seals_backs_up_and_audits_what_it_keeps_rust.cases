# ── A copy of a device's secrets ──────────────────────────────────────────────────────────────

mutation_case "A copy is sealed and opened with no header authenticated" <<'PY'
edit("backends/rust/trust/src/backup.rs",
     "                msg: &plain,\n                aad: header(cost, &salt).as_bytes(),",
     "                msg: &plain,\n                aad: &header(cost, &salt).as_bytes()[..0],")
edit("backends/rust/trust/src/backup.rs",
     "            msg: &ciphertext,\n            aad: header(cost, &salt).as_bytes(),",
     "            msg: &ciphertext,\n            aad: &header(cost, &salt).as_bytes()[..0],")
PY

mutation_case "A copy's key is made by Argon2i where its header says Argon2id" <<'PY'
edit("backends/rust/trust/src/backup.rs",
     "Argon2::new(Algorithm::Argon2id, Version::V0x13, params)",
     "Argon2::new(Algorithm::Argon2i, Version::V0x13, params)")
PY

mutation_case "A copy may ask for any number of passes" <<'PY'
edit("backends/rust/trust/src/backup.rs",
     "        || cost.passes > Cost::MAX.passes",
     "        || false")
PY

mutation_case "A copy opened under a wrong passphrase is called something other than corrupt" <<'PY'
edit("backends/rust/trust/src/backup.rs",
     "let mut plain = opened.map_err(|_| BackupError::Corrupt)?;",
     "let mut plain = opened.unwrap_or_default();")
PY

mutation_case "A copy that names another key derivation is taken for one" <<'PY'
edit("backends/rust/trust/src/backup.rs",
     "        || value.get(\"kdf\").and_then(Value::as_str) != Some(\"argon2id\")",
     "        || false")
PY

mutation_case "A copy keeps a name twice when it is given twice" <<'PY'
edit("backends/rust/trust/src/backup.rs",
     "self.extras.retain(|(held, _)| held != name);",
     "self.extras.retain(|_| true);")
PY

mutation_case "A copy puts back the key of an epoch the list had destroyed and counts it" <<'PY'
edit("backends/rust/trust/src/backup.rs",
     "taken += usize::from(trust.set_epoch_key(epoch, key));",
     "let _ = trust.set_epoch_key(epoch, key);\n                taken += 1;")
PY

mutation_case "Two copies of one thing are made with one salt and one nonce" <<'PY'
edit("backends/rust/trust/src/backup.rs",
     "getrandom::getrandom(&mut salt).map_err(|_| BackupError::NoRandomness)?;",
     "let _ = &mut salt;")
edit("backends/rust/trust/src/backup.rs",
     "getrandom::getrandom(&mut nonce).map_err(|_| BackupError::NoRandomness)?;",
     "let _ = &mut nonce;")
PY

mutation_case "A copy's contents are read with bytes left over after the last extra" <<'PY'
edit("backends/rust/trust/src/backup.rs",
     "rest.is_empty().then_some(Self {",
     "(rest.len() < usize::MAX).then_some(Self {")
PY

