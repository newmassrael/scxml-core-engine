# Mutation cases for "an unresolved marker is placed where it was written".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/an_unresolved_marker_is_placed_where_it_was_written.cases`.
#
# A marker is recorded against the expanded text. Each case puts one place
# back where that position left unmoved, or where the forge list read the
# file unexpanded. The integration tests in
# `an_unresolved_marker_is_placed_where_it_was_written.rs` refuse them: every
# fixture has an include before its marker, so the expanded row is not the
# authored one, and a fragment that carries a marker is listed only by a
# reader that expanded.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test an_unresolved_marker_is_placed_where_it_was_written
mutation_targets sce-build/src/unresolved_check.rs sce-build/src/bin/sce_codegen.rs
mutation_oracles sce-build/tests/an_unresolved_marker_is_placed_where_it_was_written.rs

mutation_case "a statechart record keeps the expanded row" <<'PY'
edit("sce-build/src/unresolved_check.rs",
     r'''                    .map(|at| model.authored_location(at)),''',
     r'''                    .cloned(),''')
PY

mutation_case "a statechart refusal keeps the expanded row" <<'PY'
edit("sce-build/src/unresolved_check.rs",
     r'''                .map(|at| model.authored_location(at))
                .unwrap_or(SourceLocation {''',
     r'''                .cloned()
                .unwrap_or(SourceLocation {''')
PY

mutation_case "a forge marker keeps the expanded row" <<'PY'
edit("sce-build/src/unresolved_check.rs",
     r'''                .map(|at| positions.authored_location(at));''',
     r'''                .cloned();''')
PY

mutation_case "the forge list reads the file unexpanded" <<'PY'
edit("sce-build/src/bin/sce_codegen.rs",
     r'''            let positions = read_review_input(scxml, error_format);''',
     r'''            let positions = sce_build::model::AuthoredPositions::new(
                scxml,
                content.clone(),
                sce_build::position_map::PositionMap::identity(scxml, &content),
            );''')
PY
