# Mutation cases for "a lawful list follows its law where it is made and walked".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_lawful_list_follows_its_law_where_it_is_made_and_walked.cases`.
#
# `Lawful<L, A>` holds a list whose entries say their inputs by the automaton
# `A` (docs/adr/0065 §6 R8): its constructor runs the automaton once, a decode's
# fill runs it again, and a walk runs it as it reads, panicking where a source's
# entries say otherwise than when the list was made.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-forge-runtime --features alloc --lib law::
mutation_targets backends/rust/forge-runtime/src/law.rs
mutation_oracles backends/rust/forge-runtime/src/law.rs

mutation_case "the law of a bound flag admits any entry" <<'PY'
edit("backends/rust/forge-runtime/src/law.rs",
     r'''            .is_none_or(|said| said == state)
            .then_some(state)''',
     r'''            .map_or(true, |_| true)
            .then_some(state)''')
PY

mutation_case "the law of the entry before forgets the kind of the entry" <<'PY'
edit("backends/rust/forge-runtime/src/law.rs",
     r'''            .then(|| K::matches(entry))''',
     r'''            .then_some(false)''')
PY

# An entry that says nothing of an input disagrees with no state (§6 R8b).
mutation_case "an entry that says nothing is refused by the entry before" <<'PY'
edit("backends/rust/forge-runtime/src/law.rs",
     r'''            .is_none_or(|said| said == state)
            .then(|| K::matches(entry))''',
     r'''            .is_some_and(|said| said == state)
            .then(|| K::matches(entry))''')
PY

mutation_case "a fill keeps entries that break the law" <<'PY'
edit("backends/rust/forge-runtime/src/law.rs",
     r'''            Ok(()) | Err(CodecError::CapacityExceeded) if !self.list.follows(start) => {''',
     r'''            Ok(()) | Err(CodecError::CapacityExceeded) if !self.list.follows(start) && start != start => {''')
PY

# The call stays in the mutant and is never taken: a mutant that dropped it
# left `law_broken` unused, which `-D warnings` refuses to build (run
# 41447545208, INCONCLUSIVE).
mutation_case "a walk reads an entry that breaks the law" <<'PY'
edit("backends/rust/forge-runtime/src/law.rs",
     r'''            None => law_broken(),''',
     r'''            None => {
                if false {
                    law_broken()
                }
            }''')
PY
