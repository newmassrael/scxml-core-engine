# Mutation cases for "a store keeps only a lineage that continues the work's".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_store_keeps_only_a_lineage_that_continues_the_works.cases`.
#
# The store refused a list that LOST the lineage and nothing else, so a model that built its
# list without the lineage it was given got a fresh one, which the store kept, and a retired id
# was issued again to another requirement (review of 2026-10-09). It now judges the lineage of a
# list when the list is saved or published: that it is a lineage, that it is the list's own, and
# that it continues the work's. Each case below takes one of those away, or leaves the
# publication path out, and must make a test of
# `app-core/tests/a_work_keeps_the_lineage_of_its_requirement_list.rs` red.
#
# ⚠ A mutated tree is built under `-D warnings`, so every case keeps each binding it had in
# use: a mutation that stops reading one is an unused-variable ERROR, the tree does not
# compile, and the verdict is INCONCLUSIVE.
#
# Anchors are literal slices of the source; an edit that moves one is reported INCONCLUSIVE with
# the anchor quoted, never as a pass.

mutation_tests -p sce-app-core --test a_work_keeps_the_lineage_of_its_requirement_list
mutation_targets app-core/src/store.rs app-core/src/store/bundle_store.rs app-core/src/commands.rs app-core/src/requirements.rs
mutation_oracles app-core/tests/a_work_keeps_the_lineage_of_its_requirement_list.rs

mutation_case "a list that loses the lineage is saved" <<'PY'
edit("app-core/src/store.rs",
     "            if held.is_some() || (adopted.is_some() && !the_same_list) {\n                return Err(StoreError::refused(\n                    \"lineage-dropped\",",
     "            if (held.is_some() || (adopted.is_some() && !the_same_list)) && false {\n                return Err(StoreError::refused(\n                    \"lineage-dropped\",")
PY

mutation_case "what names itself a lineage and is not one is kept" <<'PY'
edit("app-core/src/store.rs",
     "        let lineage = sce_revision::parse(text).map_err(|why| {",
     "        let lineage = serde_json::from_str::<serde_json::Value>(text).map_err(|why| {")
PY

mutation_case "a lineage that is not the list's own is kept" <<'PY'
edit("app-core/src/store.rs",
     "        sce_revision::belongs_to_list(&lineage, &list.manifest, list.sidecar.as_deref()).map_err(\n            |why| {",
     "        sce_revision::belongs_to_list(&lineage, &list.manifest, list.sidecar.as_deref())\n            .or(Ok::<(), sce_revision::LineageError>(()))\n            .map_err(|why| {")
PY

mutation_case "a lineage that does not continue the work's is kept" <<'PY'
edit("app-core/src/store.rs",
     "            sce_revision::extends(&previous, &lineage).map_err(|why| {",
     "            sce_revision::extends(&previous, &previous).map_err(|why| {")
PY

mutation_case "a published candidate is not judged" <<'PY'
edit("app-core/src/store/bundle_store.rs",
     "            self.refuse_a_lineage_not_kept(id, &text)?;",
     "            let _ = (id, &text);")
PY

# When the lineage the work holds cannot be read, the new one is held to the ids the work's lists
# carried (`lineage-numbers-reused`). Each case below takes one part of that away.

mutation_case "a lineage the work cannot read is not compared with the lists it kept" <<'PY'
edit("app-core/src/store.rs",
     "            Some(Err(_)) => self.refuse_numbers_already_issued(id, &lineage, &detail)?,",
     "            Some(Err(_)) => {\n                let _ = self.refuse_numbers_already_issued(id, &lineage, &detail);\n            }")
PY

mutation_case "a lineage numbered from the very id the work carried is kept" <<'PY'
edit("app-core/src/store.rs",
     "        if next > floor {\n            return Ok(());",
     "        if next >= floor {\n            return Ok(());")
PY

mutation_case "no list the work kept is counted" <<'PY'
edit("app-core/src/store.rs",
     "        for file in files {",
     "        for file in files.take(0) {")
PY

mutation_case "a lineage numbered past the lists is refused all the same" <<'PY'
edit("app-core/src/store.rs",
     "        if next > floor {\n            return Ok(());",
     "        if next > floor && false {\n            return Ok(());")
PY

# When the owner asked for every id to be issued afresh (`fresh-ids-not-issued`), a list that
# carries one is not published. Each case below takes one part of that away.

mutation_case "a list that carries an id the owner asked to retire is published" <<'PY'
edit("app-core/src/store/bundle_store.rs",
     "            if current.fresh_ids {",
     "            if current.fresh_ids && false {")
PY

# The ids are judged in the manifests of the two lists, not in a lineage: a work whose list was made
# before lineages keeps none, and the check passed a list that ignored the ask there (review of
# 2026-10-09).

mutation_case "the ids of a list made before lineages are not the work's to retire" <<'PY'
edit("app-core/src/store.rs",
     "                .ok()\n                .map(|list| manifest_ids(&list.manifest, \"requirements\"))",
     "                .ok()\n                .and_then(|list| list.lineage.map(|_| manifest_ids(&list.manifest, \"requirements\")))")
PY

mutation_case "a list given without a lineage is not held to the ask" <<'PY'
edit("app-core/src/store.rs",
     "        let Some(given) = ids_of(next) else {",
     "        let Some(given) = ids_of(next).filter(|_| crate::requirements::Requirements::parse(next).is_ok_and(|list| list.lineage.is_some())) else {")
PY

mutation_case "an id only one of the lists has is counted as carried" <<'PY'
edit("app-core/src/store.rs",
     "held.intersection(&given).cloned().collect();",
     "held.union(&given).cloned().collect();")
PY

mutation_case "the ids carried are named in the order a text sorts them" <<'PY'
edit("app-core/src/store.rs",
     "        carried.sort_by_key(|id| {\n            id.trim_start_matches('R')\n                .parse::<u64>()\n                .unwrap_or(u64::MAX)\n        });",
     "        carried.sort();")
PY

# A list made before lineages keeps none and stands on the one adopting it makes (ADR 0012): the
# core derives it, gives it with the list, and holds the next list to it as to a kept one.

mutation_case "a lineage is not continued from the one adopting a list made before lineages makes" <<'PY'
edit("app-core/src/store.rs",
     "                if let Some(previous) = &adopted {",
     "                if let Some(previous) = &adopted.clone().filter(|_| false) {")
PY

mutation_case "a list made before lineages may lose the lineage it stands on" <<'PY'
edit("app-core/src/store.rs",
     "            if held.is_some() || (adopted.is_some() && !the_same_list) {",
     "            if held.is_some() || (false && adopted.is_some() && !the_same_list) {")
PY

mutation_case "the same list made before lineages saved again is refused as dropped" <<'PY'
edit("app-core/src/store.rs",
     "            if held.is_some() || (adopted.is_some() && !the_same_list) {",
     "            if held.is_some() || (adopted.is_some() && !(the_same_list && false)) {")
PY

mutation_case "a list made before lineages is read without the lineage it stands on" <<'PY'
edit("app-core/src/commands.rs",
     "    } else if let Some(adopted) = list.adopted_lineage() {",
     "    } else if let Some(adopted) = list.adopted_lineage().filter(|_| false) {")
PY

mutation_case "the lineage a list stands on is not said to be derived" <<'PY'
edit("app-core/src/commands.rs",
     "        reply[\"lineage_adopted\"] = Value::Bool(true);",
     "        reply[\"lineage_adopted\"] = Value::Bool(false);")
PY
