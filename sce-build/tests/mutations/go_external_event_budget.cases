# Mutation cases for "a call that drains a self-refilling external queue is
# handed back", Go runtime.
#
# Run with
# `scripts/mutate sce-build/tests/mutations/go_external_event_budget.cases`.
#
# A machine that answers an event by sending itself the next one, with no
# target, never lets the external queue empty, and every macrostep of it ends, so
# the microstep ceiling never applies: the call did not return. The Go engine
# takes at most MaxExternalEventsPerCall events in one invocation of its main
# event loop, leaves the rest queued, and counts the cut; and it bounds the
# scheduler entries due AT one clock reading popped by one tick by the same
# budget (ARCHITECTURE.md "External-Event Budget", rules 1-5). This engine hands
# a STATIC zero delay to its scheduler, so `zero` and `zero_expr` both hold the
# same-instant bound. `tests/integration/external_chain_is_bounded.scxml` is the
# document.
#
# What is easy to get wrong and reads as success: a budget off by one in either
# direction (the chain that ENDS at exactly the budget is the case that tells
# them apart), a refusal that swallows the event it declined (the chain stops
# short and never finishes), a cut that is not counted, and a same-instant bound
# that counts what it must not: a clock the host moved a long way pops many
# entries at ONE reading and they are not a runaway.
#
# A mutation that removes a bound leaves the binary spinning, and the harness
# caps every run, so "did not terminate" is the verdict that case is held to.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/external_chain_is_bounded/
mutation_runtime_targets backends/go/runtime/engine.go
mutation_oracles backends/go/tests/integration/external_chain_is_bounded/external_chain_is_bounded_test.go

# ── The refusal itself ──────────────────────────────────────────────

mutation_case "the drain has no budget at all" <<'PY'
edit("backends/go/runtime/engine.go",
     "		if taken >= e.MaxExternalEventsPerCall() {",
     "		if false {")
PY

mutation_case "the budget is one event more than it says" <<'PY'
edit("backends/go/runtime/engine.go",
     "		if taken >= e.MaxExternalEventsPerCall() {",
     "		if taken > e.MaxExternalEventsPerCall() {")
PY

mutation_case "the budget is one event fewer than it says" <<'PY'
edit("backends/go/runtime/engine.go",
     "		if taken >= e.MaxExternalEventsPerCall() {",
     "		if taken+1 >= e.MaxExternalEventsPerCall() {")
PY

# ── The refusal leaves the queue alone ──────────────────────────────
#
# Popping before asking consumes the event the drain then declines to run. The
# chain is still bounded and the count still moves, so only the `resume` outcome
# can see it: it stops a link short of its end and never finishes.

mutation_case "the drain swallows the event it refused" <<'PY'
edit("backends/go/runtime/engine.go",
     "			e.recordTruncatedEventChain(head.Event, true)\n			break",
     "			e.recordTruncatedEventChain(head.Event, true)\n			e.externalQueue.Pop()\n			break")
PY

# ── The cut is said ─────────────────────────────────────────────────

mutation_case "a cut is not counted" <<'PY'
edit("backends/go/runtime/engine.go",
     "	e.truncatedEventChains++\n",
     "	e.truncatedEventChains += 0\n")
PY

mutation_case "the cut does not say which event it was still taking" <<'PY'
edit("backends/go/runtime/engine.go",
     "	e.hasTruncatedEvent = hasHead\n",
     "	e.hasTruncatedEvent = false\n")
PY

# ── The budget is the invocation's own, from a clean start ──────────

mutation_case "an invocation starts with one event already spent" <<'PY'
edit("backends/go/runtime/engine.go",
     "	var taken uint32\n	for {",
     "	var taken uint32 = 1\n	for {")
PY

# ── The scheduler cannot refill itself without end ──────────────────
#
# A static `delay="0ms"` and a `delayexpr` that evaluates to zero both reach this
# engine's scheduler. Without the same-instant bound the tick that pops one finds
# each handler has armed another due at the same reading, and never returns.

mutation_case "the scheduler's same-instant pops have no budget" <<'PY'
edit("backends/go/runtime/engine.go",
     "			if poppedDueAtReading >= e.MaxExternalEventsPerCall() {",
     "			if false {")
PY

# The bound must count entries due AT the reading, not every entry popped at it.
# The reading is latched for the whole tick, so a host that jumps the clock eight
# milliseconds pops eight entries at ONE reading, seven of them due earlier: a
# bound on pops at the reading would refuse a legitimate time-driven chain.

mutation_case "the same-instant bound counts entries that came due earlier" <<'PY'
edit("backends/go/runtime/engine.go",
     "ready && dueMs == e.turnNowMs {",
     "ready && dueMs <= e.turnNowMs {")
PY

# ── What a host may set ─────────────────────────────────────────────

mutation_case "a budget that takes no event is accepted" <<'PY'
edit("backends/go/runtime/engine.go",
     "	if limit < 1 || uint64(limit) > uint64(math.MaxUint32) {",
     "	if uint64(limit) > uint64(math.MaxUint32) {")
PY

mutation_case "a budget the host sets is ignored" <<'PY'
edit("backends/go/runtime/engine.go",
     "	e.maxExternalEventsPerCall = uint32(limit)\n	return nil",
     "	return nil")
PY

mutation_case "the default budget is not the documented one" <<'PY'
edit("backends/go/runtime/engine.go",
     "const defaultMaxExternalEventsPerCall uint32 = 10000",
     "const defaultMaxExternalEventsPerCall uint32 = 1000")
PY
