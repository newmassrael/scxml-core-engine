# Mutation cases for the external-event budget numbers the C11 driver reads from
# `tests/external_event_budget/budget_outcomes.json` (ARCHITECTURE.md, "External-Event
# Budget"): the table states the default and the counters every engine's test holds its
# engine to, and a test that does not read it carries its own copy.
#
# Run with `scripts/mutate sce-build/tests/mutations/c_reads_the_external_event_budget_table_ctest.cases`.
#
# Each mutant moves one number of the table by one and leaves it well formed, so only a
# test that loads the table can tell it from the right one. A SURVIVED here means the
# driver kept a literal of that number. The same four cases run against every other
# backend in the sibling casefiles `<backend>_reads_the_external_event_budget_table*.cases`.
#
# Anchors are literal slices of the table; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^c11_integration_external_chain_is_bounded$'
mutation_runtime_targets tests/external_event_budget/budget_outcomes.json
mutation_oracles backends/c/tests/integration/test_external_chain_is_bounded.c

mutation_case "the default budget is written down one too high" <<'PY'
edit("tests/external_event_budget/budget_outcomes.json",
     '"default_budget": 10000,',
     '"default_budget": 10001,')
PY

mutation_case "an exact chain's laps are written down one too many" <<'PY'
edit("tests/external_event_budget/budget_outcomes.json",
     '"exact": { "budget": 6, "laps": 5, "truncated": 0 }',
     '"exact": { "budget": 6, "laps": 6, "truncated": 0 }')
PY

mutation_case "a chain one short leaves one more lap than it does" <<'PY'
edit("tests/external_event_budget/budget_outcomes.json",
     '"one_short": { "budget": 5, "laps": 4, "truncated": 1 }',
     '"one_short": { "budget": 5, "laps": 5, "truncated": 1 }')
PY

mutation_case "the second call's beats are written down one too many" <<'PY'
edit("tests/external_event_budget/budget_outcomes.json",
     '"beats_after_second_call": 30,',
     '"beats_after_second_call": 31,')
PY

mutation_case "a static zero's cut count is written down one too many" <<'PY'
edit("tests/external_event_budget/budget_outcomes.json",
     '"static_zero": { "budget": 50, "truncated_after_entry": 0, "truncated": 1 }',
     '"static_zero": { "budget": 50, "truncated_after_entry": 0, "truncated": 2 }')
PY

mutation_case "the pulses of a timed chain are written down as due together" <<'PY'
edit("tests/external_event_budget/budget_outcomes.json",
     '"interval_ms": 1,',
     '"interval_ms": 0,')
PY
