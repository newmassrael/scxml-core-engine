# Mutation cases for "a Mesh request names its peer by a string the machine computes"
# under the C++ backend (docs/SCE_ACCEPTED_SUBSET.md §2.15, "Params"; docs/adr/0005,
# decision 7).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_cpp_mesh_request_names_its_peer_by_srcexpr_ctest.cases`.
#
# `brake_static_srcexpr` asks `motor_static_srcexpr` for a request whose peer is the
# string `peer` holds, changes `peer` to a name no binding carries before it asks, and
# has a second request whose peer cannot be computed
# (`'#motor_static_srcexpr' + (load * 2000000000)`). The test links no script engine and
# reads the request where the router the build generates hands it to its link: so the
# peer is the string the machine writes, and the mutants each take one decision of it
# away, and each still compiles:
#
#   the peer is not the string the machine computed;
#   the router is asked for a peer the field does not name;
#   a peer that cannot be computed is not reported.
#
# Two decisions of the template have no case, and say why. The shape check on the name
# and the use of a peer that failed to compute are not observable with this fixture:
# a name of the wrong shape, and the text a failed computation leaves, are not names of
# a binding the deployment carries, so with either check taken away the router's miss
# answers with the same `error.execution` once and nothing sent. A case written for
# them would be a mutant that survives for the right reason, and reads as a hole.
#
# The test is registered only when the tree is configured with `SCE_ENABLE_MESH=ON`,
# which the C++ suite's own build is. The template is read by the generator binary
# CMake already holds, so the build the ctest names carries a mutated template into
# the generated machine. Anchors are literal slices of the template; an edit that
# moves one is reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_ctest --test-dir build -R '^mesh_static_invoke_srcexpr_verification$'
mutation_targets tools/codegen/templates/entry_exit_actions.jinja2
mutation_oracles tests/mesh/test_mesh_static_invoke_srcexpr.cpp tests/mesh/brake_static_srcexpr.scxml

mutation_case "the peer is not the string the machine computed" <<'PY'
edit("tools/codegen/templates/entry_exit_actions.jinja2",
     "                            _resolved_src_{{ invoke_info.invoke_id }} = {{ invoke_info.native_src }};",
     "                            _resolved_src_{{ invoke_info.invoke_id }} = std::string(\"#motor_static_srcexpr\");")
PY

mutation_case "the router is asked for a peer the field does not name" <<'PY'
edit("tools/codegen/templates/entry_exit_actions.jinja2",
     "                                if (!engine.performMeshInvoke(this->_mesh_resolved_src_{{ invoke_info.field_suffix }}_,\n",
     "                                if (!engine.performMeshInvoke(std::string(\"#motor_static_srcexpr\"),\n")
PY

mutation_case "a peer that cannot be computed is not reported" <<'PY'
edit("tools/codegen/templates/entry_exit_actions.jinja2",
     "                        if (!_srcexpr_read_{{ invoke_info.invoke_id }}) {\n                            engine.raise(typename Engine::EventWithMetadata(\n                                Event::Error_execution,\n                                \"mesh-rpc invoke '{{ invoke_info.invoke_id }}' srcexpr evaluation failed: {{ invoke_info.srcexpr | escape_cpp }}\"));",
     "                        if (!_srcexpr_read_{{ invoke_info.invoke_id }}) {\n                            (void)engine;")
PY
