# Mutation cases for "inline `<content>` text is read once, at build time,
# wherever the clause puts it".
#
# Run with `scripts/mutate sce-build/tests/mutations/inline_content_has_one_reading.cases`.
#
# The first four restore the defect one backend at a time, because that is
# how it existed: five backends each searched for the reading at run time,
# in five different ways, and every one of them generated cleanly. A case
# per backend is what says the gate sees each of them rather than noticing
# that *something* changed.
#
# The last two break the gate. It compares emitted text, so a comparison
# that stops looking at a backend checks fewer of them; and its comment
# stripper is what lets it read emitted sources that explain the very
# searches it looks for — a stripper that stops stripping reports the
# explanation as the defect, which is what happened twice while this file
# was being written.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test inline_content_has_one_reading
mutation_targets sce-build/tests/inline_content_has_one_reading.rs sce-build/src/parser.rs sce-build/src/filters.rs
mutation_runtime_targets tools/codegen/templates/rust/actions/send.rs.jinja2 tools/codegen/templates/go/actions/send.go.jinja2 tools/codegen/templates/c/scriptengine.jinja2 tools/codegen/templates/python/actions/send.py.jinja2 tools/codegen/templates/python/scriptengine_helpers.py.jinja2 tools/codegen/templates/rust/actions/assign.rs.jinja2 tools/codegen/templates/go/actions/assign.go.jinja2 tools/codegen/templates/c/state_machine.c.jinja2 tools/codegen/templates/python/actions/assign.py.jinja2 tools/codegen/templates/actions/assign.jinja2 tools/codegen/templates/kotlin/actions/assign.kt.jinja2 tools/codegen/templates/actions/send.jinja2 tools/codegen/templates/kotlin/actions/send.kt.jinja2

# ⚠ Re-aimed 2026-08-17: the payload these two sites write is now JSON
# (§scxml-B-2-9), so the authored text is evaluated at send time and the
# result serialised rather than embedded as a Lua expression. The reading is
# still decided by the same filter, which is what these cases are about, so
# only the site moved — the anchors follow it.
mutation_case "rust hands the author's text over unread again" <<'PY'
edit("tools/codegen/templates/rust/actions/send.rs.jinja2",
     '''        match se.evaluate_expression(&sid, "{{ action.content | to_lua_data_content | escape_rust }}") {''',
     '''        match se.evaluate_expression(&sid, "{{ action.content | escape_rust }}") {''')
PY

mutation_case "go hands the author's text over unread again" <<'PY'
edit("tools/codegen/templates/go/actions/send.go.jinja2",
     '''		if contentVal, contentErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.content | to_lua_data_content }}`); contentErr == nil {''',
     '''		if contentVal, contentErr := p.ScriptEngine.EvaluateExpression(p.SessionID, `{{ action.content }}`); contentErr == nil {''')
PY

# Aimed at the helper rather than a call site: `send.py.jinja2` spells the
# same call four times, one per dispatch shape, so an anchor there names
# one of four and the first round of this casefile mutated a site the
# probe document does not reach — SURVIVED, with the defect live. The
# helper is the single place the reading is consumed.
mutation_case "python returns the author's text unread again" <<'PY'
edit("tools/codegen/templates/python/scriptengine_helpers.py.jinja2",
     """            try:
                return engine._script_engine.evaluate_expression(
                    self._session_id, content
                ).to_python()
            except _ScriptError:
                self._raise_error_execution(
                    engine, "<send> <content> failed to evaluate"
                )
                raise _ActionAbort""",
     """            return content""")
PY

mutation_case "c11 searches for the reading at run time again" <<'PY'
edit("tools/codegen/templates/c/scriptengine.jinja2",
     '''    (void)luaL_dostring(sm->L,
        "_pending_donedata = ({{ content | to_lua_data_content | escape_c }})");''',
     '''    (void)luaL_dostring(sm->L,
        "do "
          "local _c = [[{{ content | escape_c }}]]; "
          "local _fn = load('return (' .. _c .. ')'); "
          "local _ok = false; local _val = nil; "
          "if _fn then _ok, _val = pcall(_fn) end; "
          "if _ok then _pending_donedata = _val "
          "else _pending_donedata = _c end "
        "end");''')
PY

# The two backends that evaluate the authored spelling. The unread form
# once differed from the read one by two quotes and nothing else, so the
# presence check alone said yes to both of these — they SURVIVED the
# first round of this casefile, and the `unread_form` assertion is what
# the gate grew in answer.
#
# Re-aimed 2026-08-28: C++'s read form is now a `ScriptSource` named
# constructor (`to_script_source_data_content`), not a quoted literal, so
# for C++ the two forms no longer differ by quotes alone. The mutation
# still lands the unread spelling — `ScriptSource` takes a bare string
# implicitly, and `ScriptSource.h` says that is deliberate — so
# `unread_form` is still what decides it. Kotlin's site is unchanged.

mutation_case "cpp quotes the send content again" <<'PY'
edit("tools/codegen/templates/actions/send.jinja2",
     '''    {{ action.content | to_script_source_data_content }},''',
     '''    "'{{ action.content | escape_cpp }}'",''')
PY

# Re-aimed 2026-08-30, for the reason the C++ twin was re-aimed two days
# earlier and now on the same site shape: Kotlin's read form crossed the
# language seam in `e99c50a4e6`, so the binding names `to_script_source_data_content`
# and the value it builds is a `ScriptSource`, not a quoted literal. The
# mutation still lands the UNREAD spelling — a bare quoted string, wrapped so
# the reading is thrown away — which is what `unread_form` decides on.
mutation_case "kotlin quotes the send content again" <<'PY'
edit("tools/codegen/templates/kotlin/actions/send.kt.jinja2",
     """{% set content_data = 'evaluateSendContent(' ~ (action.content | to_script_source_data_content) ~ ')' %}""",
     """{% set content_data = 'evaluateSendContent("\\'' ~ (action.content | escape_kotlin) ~ '\\'")' %}""")
PY

mutation_case "the comparison stops looking at four backends" <<'PY'
edit("sce-build/tests/inline_content_has_one_reading.rs",
     """    let probed: Vec<&str> = Language::ALL.iter().map(|l| l.canonical_name()).collect();""",
     """    let probed: Vec<&str> = Language::ALL
        .iter()
        .filter(|l| **l == Language::Cpp)
        .map(|l| l.canonical_name())
        .collect();""")
PY

# The line-comment path is the load-bearing one: the C++ emitter explains
# what it replaced in a `//` comment naming `jsonStringToScriptValue`,
# which is exactly the term the search below looks for. Aiming this at the
# block path instead was SURVIVED in the first round — true, and useless,
# because no emitted block comment happens to carry a search term today.
mutation_case "the comment stripper stops stripping line comments" <<'PY'
edit("sce-build/tests/inline_content_has_one_reading.rs",
     """        if (c == '/' && next == Some('/')) || (c == '#' && at_line_start) {""",
     """        if false && ((c == '/' && next == Some('/')) || (c == '#' && at_line_start)) {""")
PY

# ── The same clause at `<assign>` ──────────────────────────────────
#
# The parser case first, because it is the one that made every other
# question unanswerable: with the text branch gone the children never
# reach a template, so a backend can carry any reading at all and the
# document still generates cleanly.

mutation_case "the parser reads only an assign's element children again" <<'PY'
edit("sce-build/src/parser.rs",
     """    // element children serialise and everything else is the text.
    if node.children().any(|c| c.is_element()) {""",
     """    // element children serialise and everything else is the text.
    if true {""")
PY

# The reading itself. `to_lua_assign_content` is one function for four
# backends, so a single case covers what would otherwise be four —
# whereas each *template* can still stop calling it on its own, which is
# what the five below are for.

mutation_case "the assign reading quotes every value again" <<'PY'
edit("sce-build/src/filters.rs",
     """    if let Ok(lua) = crate::ecmascript::to_lua_value(&content, scope) {
        return Ok(lua);
    }
    Ok(lua_string_literal(&normalize_ws(content)))
}

/// The same value for the two backends that hand the author's ECMAScript""",
     """    let _ = crate::ecmascript::to_lua_value(&content, scope);
    Ok(lua_string_literal(&normalize_ws(content)))
}

/// The same value for the two backends that hand the author's ECMAScript""")
PY

mutation_case "rust quotes an assign's inline text again" <<'PY'
edit("tools/codegen/templates/rust/actions/assign.rs.jinja2",
     '''    let expr = "{{ action.content | to_lua_assign_content | escape_rust }}";''',
     '''    let expr = "'{{ action.content | escape_rust }}'";''')
PY

mutation_case "go quotes an assign's inline text again" <<'PY'
edit("tools/codegen/templates/go/actions/assign.go.jinja2",
     '''"{{ action.content | to_lua_assign_content | escape_go }}"''',
     '''`'{{ action.content | escape_go }}'`''')
PY

mutation_case "c11 quotes an assign's inline text again" <<'PY'
edit("tools/codegen/templates/c/state_machine.c.jinja2",
     '''"{{ action.location | to_lua_location | escape_c }} = ({{ action.content | to_lua_assign_content | escape_c }})"''',
     '''"{{ action.location | to_lua_location | escape_c }} = '{{ action.content | escape_c }}'"''')
PY

mutation_case "python quotes an assign's inline text again" <<'PY'
edit("tools/codegen/templates/python/actions/assign.py.jinja2",
     '''{{ action.content | to_lua_assign_content | py_string_literal }})''',
     '''("'" ~ action.content ~ "'") | py_string_literal }})''')
PY

# cpp and kotlin share a case shape but not a filter: they hand the
# author's own ECMAScript to an ECMAScript engine, so their reading is
# `to_author_assign_content` and the spelling the gate looks for is the
# authored one.

mutation_case "cpp quotes an assign's inline text again" <<'PY'
edit("tools/codegen/templates/actions/assign.jinja2",
     '''    ::SCE::ScriptSource expr = {{ action.content | to_script_source_assign_content }};''',
     '''    ::SCE::ScriptSource expr = "'{{ action.content | replace('"', '\\\\"') | replace("'", "\\\\'") }}'";''')
PY

# Re-aimed 2026-08-30 with the send case above and for the same reason: both
# arguments cross the seam now (`to_script_source_location`,
# `to_script_source_assign_content`). The restored spelling quotes the value
# back into a string literal, which is the reading this file exists to refuse.
mutation_case "kotlin quotes an assign's inline text again" <<'PY'
edit("tools/codegen/templates/kotlin/actions/assign.kt.jinja2",
     '''            executeAssign({{ action.location | to_script_source_location }}, {{ action.content | to_script_source_assign_content }})''',
     '''            executeAssign({{ action.location | to_script_source_location }}, "'{{ action.content | escape_kotlin }}'")''')
PY
