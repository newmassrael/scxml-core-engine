# Mutation cases for "a 64-bit integer crosses a `<param>` as the text of its digits and is
# read back from it" under the Kotlin backend (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A 64-bit
# integer").
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_kotlin_a_64_bit_integer_crosses_as_its_digits_kotlin.cases`.
#
# `static_wire_wide` sends a uint64 and an int64 to itself and keeps their remainders by
# 1000; it also hands the machine a number past 2^53 - 1, which every engine refuses where
# it is read. The mutants take one decision away each:
#
#   a 64-bit `<param>` is written as a JSON number and not as its digits;
#   a JSON number past 2^53 - 1 is read as a 64-bit field.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_gradle . :sce-kotlin-tests:test --tests 'com.sce.integration.StaticScenarioTest'
mutation_targets sce-build/src/forge/static_lowering.rs
mutation_targets backends/kotlin/runtime/src/commonMain/kotlin/com/sce/runtime/EventPayload.kt
mutation_regen scripts/regen_static_datamodel_kotlin.sh
mutation_oracles backends/kotlin/tests/src/test/kotlin/com/sce/integration/StaticScenarioTest.kt backends/kotlin/scenarios/src/commonMain/kotlin/com/sce/scenarios/Replay.kt sce-build/tests/fixtures/static_datamodel/scenarios/static_wire_wide.json

mutation_case "a 64-bit param is written as a JSON number" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "InferredType::Int { bits: 64, .. } => format!(\"({value}).toString()\"),",
     "InferredType::Int { bits: 64, .. } => format!(\"({value}).toLong()\"),")
PY

mutation_case "a JSON number past 2^53 - 1 is read as a 64-bit field" <<'PY'
edit("backends/kotlin/runtime/src/commonMain/kotlin/com/sce/runtime/EventPayload.kt",
     "if (n > EXACT_IN_A_DOUBLE || n < -EXACT_IN_A_DOUBLE) {",
     "if (false) {")
PY
