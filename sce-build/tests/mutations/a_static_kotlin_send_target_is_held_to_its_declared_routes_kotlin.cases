# Mutation cases for "a computed target is chosen among the routes the document
# declares" under the Kotlin backend (docs/SCE_ACCEPTED_SUBSET.md §2.15, "A computed
# target"; docs/adr/0005, decision 3).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_kotlin_send_target_is_held_to_its_declared_routes_kotlin.cases`.
#
# `static_send_target` sends `landed` to the route its `route` variable holds, among
# the routes the send declares: `fire` declares `#_internal` and `#_parent`, `narrow`
# declares `#_parent` alone. The scenario holds what each leaves: a declared route
# that a session answers at delivers (`landed`), and every other value — one the
# machine could send by but this send did not declare, a declared parent that does
# not exist, and a session nothing declares — is `error.communication` with nothing
# sent (`refused`). The mutants each take one decision away, and each still compiles:
#
#   a value that is none of the declared routes is let through;
#   a value that names no route raises nothing.
#
# Anchors are literal slices of the template; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_gradle . :sce-kotlin-tests:test --tests 'com.sce.integration.StaticScenarioTest.staticSendTargetIsChosenAmongTheDeclaredRoutes'
mutation_targets tools/codegen/templates/kotlin/actions/send.kt.jinja2 backends/kotlin/tests/src/main/kotlin/com/sce/integration/static_send_target/static_send_targetSm.kt
mutation_regen scripts/regen_static_datamodel_kotlin.sh
mutation_oracles backends/kotlin/tests/src/test/kotlin/com/sce/integration/StaticScenarioTest.kt backends/kotlin/scenarios/src/commonMain/kotlin/com/sce/scenarios/Replay.kt sce-build/tests/fixtures/static_datamodel/static_send_target.scxml sce-build/tests/fixtures/static_datamodel/scenarios/static_send_target.json

mutation_case "a value that is none of the declared routes is let through" <<'PY'
edit("tools/codegen/templates/kotlin/actions/send.kt.jinja2",
     ") _computed else \"\"",
     ") _computed else _computed")
PY

# A value in none of the routes leaves `_rt` empty, and an empty target is refused
# twice over: by the guard before the payload is built, and by `sendToTarget`, whose
# `classifyTarget` reads it as `Unreachable` and whose `UNREACHABLE` arm raises the
# same `error.communication` with the same send id and ends the block the same way.
# Taking away the guard alone changes only the text of the error's data, which the
# scenario does not read, so this case SURVIVED with the contract intact. The
# decision is taken away at both places.
mutation_case "a value that names no route raises nothing" <<'PY'
edit("tools/codegen/templates/kotlin/actions/send.kt.jinja2",
     "            if (com.sce.runtime.SendHelper.isUnreachableTarget(_rt)) {",
     "            if (false && com.sce.runtime.SendHelper.isUnreachableTarget(_rt)) {")
edit("tools/codegen/templates/kotlin/actions/send.kt.jinja2",
     "                    raisePlatformError({{ machine_name }}Event.Error.Communication, \"<send> targetexpr names a session this processor cannot reach\", {{ send_id_kt }})\n",
     "")
PY
