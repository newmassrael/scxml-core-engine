# Mutation cases for "a child that declares acts is built with the host its parent's
# host answers, each time the invocation starts" under the Go backend
# (docs/SCE_ACCEPTED_SUBSET.md §2.15, "Child sessions"; docs/adr/0005, decision 6).
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_static_go_child_is_built_with_the_host_its_parent_answers_go.cases`.
#
# `static_child_host` invokes `worker`, which performs `started` as it is entered and
# `finished` as it ends; `static_child_host_hybrid` invokes whichever of two
# candidates its `srcexpr` names, each with an act of its own. The Go test keeps every
# host the parent's host answered and reads what each was asked: the parent's host is
# asked once per start, the first act is already performed (the host was there when
# the child was built), a state invoked again is given a host of its own, and a
# candidate is given the host answered for IT and for no other. The mutants take one
# decision away each, and each still compiles — a mutated tree that does not is
# INCONCLUSIVE, which fails the round, and Go refuses a constructor called without its
# host:
#
#   a child is built with a nil host, where it declares acts;
#   a candidate is built with a nil host, where it declares acts;
#   the parent's host is asked twice for one start.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_go backends/go/tests ./integration/static_datamodel/
mutation_targets tools/codegen/templates/go/invoke_methods.go.jinja2 sce-build/src/forge/native_action.rs
mutation_targets backends/go/tests/integration/static_datamodel/static_child_host/static_child_host_sm.go backends/go/tests/integration/static_datamodel/static_child_host/static_child_host__sce_synth_invoke__worker_sm.go
mutation_targets backends/go/tests/integration/static_datamodel/static_child_host_hybrid/static_child_host_hybrid_sm.go backends/go/tests/integration/static_datamodel/static_child_host_hybrid/static_hosted_first_sm.go backends/go/tests/integration/static_datamodel/static_child_host_hybrid/static_hosted_second_sm.go
mutation_regen scripts/regen_static_datamodel_go.sh
mutation_oracles backends/go/tests/integration/static_datamodel/a_child_is_given_its_host_by_its_parent_test.go sce-build/tests/fixtures/static_datamodel/static_child_host.scxml sce-build/tests/fixtures/static_datamodel/static_child_host_hybrid.scxml sce-build/tests/fixtures/static_datamodel/static_hosted_first.scxml sce-build/tests/fixtures/static_datamodel/static_hosted_second.scxml

mutation_case "a child is built with a nil host where it declares acts" <<'PY'
edit("tools/codegen/templates/go/invoke_methods.go.jinja2",
     "Policy({{ invoke_info.child_host_call }})",
     "Policy({% if invoke_info.child_host_call %}nil{% endif %})")
PY

mutation_case "a candidate is built with a nil host where it declares acts" <<'PY'
edit("tools/codegen/templates/go/invoke_methods.go.jinja2",
     "Policy({{ child.child_host_call }})",
     "Policy({% if child.child_host_call %}nil{% endif %})")
PY

mutation_case "the parent's host is asked twice for one start" <<'PY'
edit("sce-build/src/forge/native_action.rs",
     "        let call = call_expression(lang, &operation, &[]);\n        let host = ChildHost {",
     "        let call = { let c = call_expression(lang, &operation, &[]); format!(\"func() {} {{ _ = {c}; return {c} }}()\", interface_name(lang, &machine_token(lang, child_name))) };\n        let host = ChildHost {")
PY
