# Mutation cases for "a C11 machine with no script engine holds the data of an
# event no schema of its document declares, which the host ABI bounds"
# (docs/adr/0086, section 8.6 (c)).
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_c11_slot_holds_the_untyped_data_the_host_abi_declares.cases
#
# A host hands any machine an event by name, a host-served send's reply or the
# end of a host-run invocation that declares no result, and nothing in the
# document bounds what such an event carries: `sce/types.h` declares
# SCE_UNTYPED_EVENT_DATA_MAX_LEN for it. The tests generate a `sce-static`
# machine that receives no schema, one that runs an untyped host-run
# invocation, and a machine with a script engine, and ask the static ones for a
# slot that holds 255 bytes and a NUL and for the static assertion of the bound,
# and the script machine for neither; the unit test asks the book of bounds to
# check the bound once. Each case breaks one link: a static machine holds no
# untyped data, a script machine relies on the bound, the machine checks no
# bound, the slot leaves the input out, the book takes nothing.
#
# The machine is generated by `sce-codegen`, which the test runs as a
# subprocess, so the generator's source is a target compiled into a binary the
# test spawns.

mutation_tests -p sce-build --features cli --lib --test a_c11_machine_sizes_its_event_data_slot untyped
mutation_targets sce-build/src/forge/generator.rs sce-build/src/generator.rs sce-build/src/forge/c11_reasons.rs

mutation_case "a static machine holds no untyped data" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "    } else {\n        crate::forge::c11_reasons::UNTYPED_EVENT_DATA.max_len\n    };\n",
     "    } else {\n        0\n    };\n")
PY

mutation_case "a script machine relies on the untyped bound" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "    let untyped = if model.needs_script_engine {\n",
     "    let untyped = if false {\n")
PY

mutation_case "the machine checks no untyped bound" <<'PY'
edit("sce-build/src/generator.rs",
     "    if data_slot.untyped > 0 {\n        crate::forge::c11_reasons::hold_bound(",
     "    if data_slot.untyped == u64::MAX {\n        crate::forge::c11_reasons::hold_bound(")
PY

mutation_case "the slot leaves the untyped data out" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "            .chain([self.untyped])\n",
     "            .chain([0])\n")
PY

mutation_case "the book takes no bound the slot is sized by" <<'PY'
edit("sce-build/src/forge/c11_reasons.rs",
     "pub fn hold_bound(bound: Published) -> Result<(), ReasonError> {\n    rely(bound.key, bound)\n}\n",
     "pub fn hold_bound(bound: Published) -> Result<(), ReasonError> {\n    let _ = bound;\n    Ok(())\n}\n")
PY
