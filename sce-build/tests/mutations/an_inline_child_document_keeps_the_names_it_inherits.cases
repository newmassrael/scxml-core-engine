# Mutation cases for "an in-line child document keeps the names it
# inherits".
#
# Run with `scripts/mutate sce-build/tests/mutations/an_inline_child_document_keeps_the_names_it_inherits.cases`.
#
# An `<invoke>`'s in-line `<scxml>` is cut out of its parent and parsed as a
# document of its own. What makes that parse the author's machine is the
# bindings it inherits, declared on its root, and nothing else moved: each
# case below takes one of those away. Declaring none restores the defect for
# every child; declaring only the default namespace restores it for a child
# that uses a prefix its parent bound; and misplacing the declarations either
# breaks the root's start tag or moves every line after it.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --test an_inline_child_document_keeps_the_names_it_inherits
mutation_targets sce-build/src/parser.rs

mutation_case "the child is its author's text alone again" <<'PY'
edit("sce-build/src/parser.rs",
     r'''        .map(namespace_declaration)
        .collect();
    format!(''',
     r'''        .map(namespace_declaration)
        .take(0)
        .collect();
    format!(''')
PY

mutation_case "the child is given the default namespace and no prefix" <<'PY'
edit("sce-build/src/parser.rs",
     r'''    let declarations: String = inherited_bindings(root)
        .into_iter()
        .map(namespace_declaration)''',
     r'''    let declarations: String = inherited_bindings(root)
        .into_iter()
        .filter(|(prefix, _)| prefix.is_none())
        .map(namespace_declaration)''')
PY

mutation_case "the declarations land before the root's name" <<'PY'
edit("sce-build/src/parser.rs",
     r'''        "{}{declarations}{}",
        &text[..after_name],''',
     r'''        "{declarations}{}{}",
        &text[..after_name],''')
PY

mutation_case "the declarations are given a line of their own" <<'PY'
edit("sce-build/src/parser.rs",
     r'''        "{}{declarations}{}",
        &text[..after_name],''',
     r'''        "{}\n{declarations}{}",
        &text[..after_name],''')
PY
