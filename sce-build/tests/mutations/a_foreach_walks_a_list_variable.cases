# Mutation cases for "a foreach walks a list variable"
# (docs/SCE_ACCEPTED_SUBSET.md §2.15, W3C SCXML 4.6).
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_foreach_walks_a_list_variable.cases
#
# A loop's variables are declared by the generated code in every backend as
# written, so the rules that matter are the ones that keep a name the code
# cannot declare, or one that hides something already in scope, from reaching
# it, and the ones that give the body the scope the loop's variables are in.
# Each case takes one away and has to turn the suite red on its own.

mutation_tests -p sce-build --features cli --test a_foreach_walks_a_list_variable
# The rules live in `sce-codegen`, which the tests run as a subprocess — the
# evidence a mutation reached what ran is the file differing on disk while
# the tests ran.
mutation_targets sce-build/tests/a_foreach_walks_a_list_variable.rs
mutation_runtime_targets sce-build/src/forge/static_datamodel.rs

# A loop variable hides a variable, an enum, an algorithm or an outer loop's
# variable: `item="total"` reads the loop's element where the author meant the
# total, and a nested loop reusing a name is a shadowed name in Kotlin.
mutation_case "a loop variable hides what is in scope" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "            } else if ctx.declares(name) {\n",
     "            } else if false && ctx.declares(name) {\n")
PY

# The index takes the item's name: one of the two is lost.
mutation_case "the index has the item's name" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "            } else if attr == \"index\" && name == item {\n",
     "            } else if attr == \"index\" && name == \"\" {\n")
PY

# The names the generated code keeps for its own (`sce_position_of_<index>`,
# `sce_failed`) are open to the author.
mutation_case "a loop variable begins with the generator's prefix" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "            } else if name.starts_with(\"sce_\") {\n",
     "            } else if name.starts_with(\"sce_zz_\") {\n")
PY

# A word one backend reserves is a loop variable, and that backend cannot
# declare it.
mutation_case "a loop variable is a keyword of some backend" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "                .any(|l| crate::reader_names::is_reserved_word(*l, name))\n",
     "                .any(|l| false && crate::reader_names::is_reserved_word(*l, name))\n")
PY

# A name that is no code identifier is emitted verbatim.
mutation_case "a loop variable is no code identifier" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "            let why = if !crate::scxml_identifier::is_code_identifier(name) {\n",
     "            let why = if false && !crate::scxml_identifier::is_code_identifier(name) {\n")
PY

# The item is not typed as the list's element: any use of it is accepted,
# and the lowering is asked to type what the judge never did.
mutation_case "the item is untyped" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "        inner.insert_var(item, elem);\n",
     "        inner.insert_var(item, InferredType::Unknown);\n")
PY

# The body is judged in the scope without the loop's variables: the item the
# body reads is a name nothing declares.
mutation_case "the body is judged without the loop's variables" <<'PY'
edit("sce-build/src/forge/static_datamodel.rs",
     "        self.actions(&inner, &action.actions, state)\n",
     "        self.actions(ctx, &action.actions, state)\n")
PY
