# Mutation cases for "the longest reason a C11 machine raises is an input of
# its slot".
#
# Run with:
#   scripts/mutate sce-build/tests/mutations/a_c11_slot_holds_the_longest_reason_its_machine_raises.cases
#
# docs/adr/0086, section 8.6 (b): every reason a C11 machine raises with an
# error comes from one table (`sce-build/src/forge/c11_reasons.rs`), each
# instantiation is recorded in the book of the machine being generated, and the
# longest is an input of the slot of `_event.data`. The test generates a
# machine whose longest reason is a lowering's sentence that names a list of
# 100 bytes, and asks the header for that length and for a slot one byte
# longer. Each case breaks one link: the slot ignores the book, the book
# records nothing, a lowering writes its sentence past the table.
#
# The machine is generated by `sce-codegen`, which the test runs as a
# subprocess, so the generator's source is a target compiled into a binary the
# test spawns.

mutation_tests -p sce-build --features cli --test a_c11_machine_sizes_its_event_data_slot the_longest_reason_a_machine_raises_is_an_input_of_its_slot
mutation_targets sce-build/src/forge/generator.rs sce-build/src/forge/c11_reasons.rs sce-build/src/forge/static_lowering.rs

mutation_case "the slot leaves the longest reason out" <<'PY'
edit("sce-build/src/forge/generator.rs",
     "            .chain(std::iter::once(reasons))\n",
     "            .chain(std::iter::once(0))\n")
PY

mutation_case "the book records no reason's length" <<'PY'
edit("sce-build/src/forge/c11_reasons.rs",
     "            book.longest = book.longest.max(len);",
     "            book.longest = book.longest.max(len.min(0));")
PY

mutation_case "a lowering writes its sentence past the table" <<'PY'
edit("sce-build/src/forge/static_lowering.rs",
     "            crate::forge::c11_reasons::LOWERING\n                .literal(&[message])\n                .expect(\"a lowering emits its reasons before the machine's slot is computed\")",
     "            format!(\"\\\"{}\\\"\", filters::escape_c(message.to_string()))")
PY
