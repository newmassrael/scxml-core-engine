# Mutation cases for what a relay of a shared list does with an operation that conflicts with what it
# holds of its author, and what a device's side does with its answer (ADR 0083 section 4): the relay
# keeps it as proof whoever gives it, and answers `conflict` with what it held to a client of
# protocol 2 and `accepted` to one of protocol 1, in the version it was asked in; the device's core
# takes in what the relay held, ends its round when that froze its own chain, and says so.
#
# Each case takes one of those away or weakens it, and the tests under study must turn red. A check
# no test notices is a check nothing holds in place.
#
# Run with `scripts/mutate sce-build/tests/mutations/a_relay_answers_a_conflict_and_keeps_it_as_proof_rust.cases`.
#
# Anchors are literal slices of the source; an edit that moves one is reported INCONCLUSIVE with the
# anchor quoted, never as a pass.

mutation_tests -p sce-rust-relay --lib --test a_relay_answers_an_operation_that_conflicts_and_keeps_it_as_proof --test a_device_told_its_operation_conflicts_freezes_at_once
mutation_targets backends/rust/relay/src/relay.rs backends/rust/relay/src/client.rs
mutation_oracles backends/rust/relay/tests/a_relay_answers_an_operation_that_conflicts_and_keeps_it_as_proof.rs backends/rust/relay/tests/a_device_told_its_operation_conflicts_freezes_at_once.rs

# ── What the relay answers ─────────────────────────────────────────────────────────────────────

mutation_case "A relay answers accepted to an operation that conflicts with what it holds" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "    let told = version >= CONFLICT_SINCE;",
     "    let told = false;")
PY

mutation_case "A relay answers conflict to a client of the version before it" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "    let told = version >= CONFLICT_SINCE;",
     "    let told = true;")
PY

mutation_case "A relay answers conflict without what it held" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "            held: conflict.with,",
     "            held: Vec::new(),")
PY

mutation_case "A relay answers a request it read in the oldest version and not in the request's" <<'PY'
edit("backends/rust/relay/src/relay.rs",
     "                            (self.call(&session, asked, version, now_ms), version)",
     "                            (self.call(&session, asked, version, now_ms), OLDEST_VERSION)")
PY

# ── What a device's side does with the answer ──────────────────────────────────────────────────

mutation_case "A courier does not take in what the relay held with a conflict" <<'PY'
edit("backends/rust/relay/src/client.rs",
     "            take(&self.trust, &mut self.state.parked, &record, &mut read);",
     "            let _ = (&self.trust, &mut self.state.parked, &record, &mut read);")
PY

mutation_case "A device told its own operation conflicts goes on with its round" <<'PY'
edit("backends/rust/relay/src/client.rs",
     "        if !froze {\n            return None;\n        }",
     "        if !froze || froze {\n            return None;\n        }")
PY

mutation_case "A round that froze the device's own chain does not say so" <<'PY'
edit("backends/rust/relay/src/client.rs",
     "                round.conflicted = Some(frozen);",
     "                let _ = frozen;")
PY
