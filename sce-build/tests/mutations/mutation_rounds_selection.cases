# Mutation cases for "a mutation round runs where a change reached, and only
# there".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/mutation_rounds_selection.cases`.
#
# The gate script is read by the tests at run time, not compiled into them, so
# it is a `mutation_runtime_targets`; the harness header explains what that
# changes about the evidence.
#
# What these guard is the one decision `mutation-rounds` makes. Everything
# expensive about the gate follows from it, and both ways of getting it wrong
# are quiet. Selecting too much turns every push into a corpus sweep, which is
# the version of this gate that gets switched off. Selecting too little leaves
# the case guarding a file unverified on the one push that could have broken
# it — and that failure looks exactly like the common, correct case of
# selecting nothing.
#
# `mutation-cases` cannot cover this gate for the reason this gate exists:
# whether the choosing still chooses is not a question about anchors.

mutation_tests -p sce-build --test mutation_rounds_selection
mutation_runtime_targets scripts/gates/mutation-rounds.sh
# The lane's selection step is read out of the YAML and executed by
# `the_lane_configures_a_cmake_tree_when_the_selection_needs_one`, so the
# workflow is a runtime target too. The gate answering correctly was never the
# half that broke.
mutation_runtime_targets .github/workflows/mutation-rounds.yml

# ── The match stops being exact ────────────────────────────────────
#
# Both sides are repository-relative paths written by the same tooling, so
# equality is the whole comparison. A prefix test instead pulls in every
# casefile declaring a file under any directory somebody touched, and a
# change-scoped gate becomes an unconditional one without anything failing.

mutation_case "a changed path matches a declared target by prefix" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     'if [[ "$changed" == "$target" ]]; then',
     'if [[ "$target" == "$changed"* ]]; then')
PY

# ── Everything is selected regardless of the change set ────────────
#
# The shape the gate had before its change set reached it: correct, and
# unaffordable. It passes every round it runs, so nothing turns red — the
# cost is the only signal, and cost is not something a suite measures.

mutation_case "the change set is ignored and the corpus always runs" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     '    if (( ${#SELECTED[@]} == 0 )); then\n        # The change set is paths',
     '    SELECTED=("${CASEFILES[@]}")\n    if (( 0 )); then\n        # The change set is paths')
PY

# ── The count stops being reported ─────────────────────────────────
#
# Choosing nothing is the common and correct outcome, so it must pass — which
# is exactly why it has to be said out loud. A gate that passes silently for
# having examined nothing is indistinguishable from one that examined
# everything, and this repository has already been misled by that once, over a
# casefile recorded as CAUGHT while it was INCONCLUSIVE.

mutation_case "the gate stops saying how many casefiles it chose" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     'sce_gate_step "${#SELECTED[@]} of ${#CASEFILES[@]} casefile(s) to run — $reason"',
     'true')
PY

# ── The dry run refuses for want of what only a round needs ────────
#
# Selecting is not running. The workflow asks the dry run which casefiles a
# push reaches and configures CMake when one of them says it needs it, so a
# dry run that refused without that tree refused exactly when the answer was
# "yes, configure one". It cost a red on the first push to touch a C11
# template — the job failed for having been asked, and claimed nothing about
# the tree.

mutation_case "the ctest precondition runs ahead of the dry run again" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     """if [[ -n "${SCE_MUTATION_ROUNDS_DRY_RUN:-}" ]]; then
    for casefile in""",
     """if [[ ! -f build/CMakeCache.txt ]]; then
    for casefile in ${SELECTED[@]+"${SELECTED[@]}"}; do
        [[ "${RUNNER_OF[$casefile]}" == "ctest" ]] \\
            && sce_gate_cannot_run "no configured CMake tree at build/"
    done
fi
if [[ -n "${SCE_MUTATION_ROUNDS_DRY_RUN:-}" ]]; then
    for casefile in""")
PY

# ── The report stops naming the runner ─────────────────────────────
#
# The workflow has to know whether the selection contains a ctest round
# *before* it installs anything, and the gate is the only party that has
# already read every declaration. Dropping the column does not make the
# question go away — it moves it somewhere else, and the somewhere else it
# lived before was a shell pipeline that answered wrong on every push that
# needed it.

mutation_case "the dry run stops saying which runner each round needs" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     """    for casefile in ${SELECTED[@]+"${SELECTED[@]}"}; do
        printf '%s\\t%s\\n' "$casefile" "${RUNNER_OF[$casefile]}"
    done""",
     """    printf '%s\\n' ${SELECTED[@]+"${SELECTED[@]}"}""")
PY

# ── The lane works the runner out for itself again ─────────────────
#
# This is the defect verbatim, restored: `grep -q` leaves at the first match,
# the writer takes SIGPIPE, and under `set -o pipefail` the pipeline reports
# 141 — so the lane answers "no CMake tree needed" precisely when one is, and
# the rounds then refuse (exit 3) for the want of the tree the step declined
# to build. Measured 20/20, deterministic. Five casefiles went 34 commits
# without a single CI round before anybody read the lane.
#
# A case against the workflow rather than the gate on purpose: the gate was
# right the whole time, and a corpus that only mutates the gate would have
# stayed green through all 34 of those commits.

mutation_case "the lane derives the runner in its own shell again" <<'PY'
edit(".github/workflows/mutation-rounds.yml",
     """        if awk -F'\\t' '$2 == "ctest" { found = 1 } END { exit !found }' "$selected"; then
          needs_ctest=yes
        else
          needs_ctest=no
        fi""",
     """        needs_ctest=no
        while read -r casefile _; do
          [ -n "$casefile" ] || continue
          if scripts/mutate --declares "$casefile" | grep -qx $'runner\\tctest'; then
            needs_ctest=yes
          fi
        done < "$selected\"""")
PY
