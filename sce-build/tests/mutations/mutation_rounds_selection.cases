# Mutation cases for "a mutation round runs where a change reached, and only
# there".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/mutation_rounds_selection.cases`.
#
# The gate script is read by the tests at run time, not compiled into them, so
# it is a `mutation_runtime_targets`; the harness header explains what that
# changes about the evidence.
#
# What these guard is the one decision `mutation-rounds` makes. Everything
# expensive about the gate follows from it, and both ways of getting it wrong
# are quiet. Selecting too much turns every push into a corpus sweep, which is
# the version of this gate that gets switched off. Selecting too little leaves
# the case guarding a file unverified on the one push that could have broken
# it — and that failure looks exactly like the common, correct case of
# selecting nothing.
#
# `mutation-cases` cannot cover this gate for the reason this gate exists:
# whether the choosing still chooses is not a question about anchors.

mutation_tests -p sce-build --test mutation_rounds_selection
mutation_runtime_targets scripts/gates/mutation-rounds.sh
# The lane's selection step is read out of the YAML and executed by
# `the_lane_configures_a_cmake_tree_when_the_selection_needs_one`, so the
# workflow is a runtime target too. The gate answering correctly was never the
# half that broke.
mutation_runtime_targets .github/workflows/mutation-rounds.yml
# The lane's tree preparation, executed the same way by
# `the_lane_prepares_the_tree_the_rounds_judge`: the script the step now calls,
# and the helper it delegates the configure to. Both are read at run time, and
# both carried a defect that only a runner could meet — a configure with no
# generator built first.
mutation_runtime_targets scripts/prepare_ctest_tree.sh
mutation_runtime_targets scripts/gates/lib.sh
# The harness, because the oracle side of a selection is resolved there: the
# casefile a change reaches, the test its selector names, and the casefile
# itself. `mutation_case_liveness.cases` declares the same file for its own
# half; a change to it selects both rounds, which is the point.
mutation_runtime_targets scripts/mutate

# ── The match stops being exact ────────────────────────────────────
#
# Both sides are repository-relative paths written by the same tooling, so
# equality is the whole comparison. A prefix test instead pulls in every
# casefile declaring a file under any directory somebody touched, and a
# change-scoped gate becomes an unconditional one without anything failing.

mutation_case "a changed path matches a declared target by prefix" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     'if [[ "$changed" == "$target" ]]; then',
     'if [[ "$target" == "$changed"* ]]; then')
PY

# ── Everything is selected regardless of the change set ────────────
#
# The shape the gate had before its change set reached it: correct, and
# unaffordable. It passes every round it runs, so nothing turns red — the
# cost is the only signal, and cost is not something a suite measures.

mutation_case "the change set is ignored and the corpus always runs" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     '    if (( ${#SELECTED[@]} == 0 )); then\n        # The change set is paths',
     '    SELECTED=("${CASEFILES[@]}")\n    if (( 0 )); then\n        # The change set is paths')
PY

# ── The count stops being reported ─────────────────────────────────
#
# Choosing nothing is the common and correct outcome, so it must pass — which
# is exactly why it has to be said out loud. A gate that passes silently for
# having examined nothing is indistinguishable from one that examined
# everything, and this repository has already been misled by that once, over a
# casefile recorded as CAUGHT while it was INCONCLUSIVE.

mutation_case "the gate stops saying how many casefiles it chose" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     'sce_gate_step "${#SELECTED[@]} of ${#CASEFILES[@]} casefile(s) to run — $reason"',
     'true')
PY

# ── The dry run refuses for want of what only a round needs ────────
#
# Selecting is not running. The workflow asks the dry run which casefiles a
# push reaches and configures CMake when one of them says it needs it, so a
# dry run that refused without that tree refused exactly when the answer was
# "yes, configure one". It cost a red on the first push to touch a C11
# template — the job failed for having been asked, and claimed nothing about
# the tree.

mutation_case "the ctest precondition runs ahead of the dry run again" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     """if [[ -n "${SCE_MUTATION_ROUNDS_DRY_RUN:-}" ]]; then
    for casefile in""",
     """if [[ ! -f build/CMakeCache.txt ]]; then
    for casefile in ${SELECTED[@]+"${SELECTED[@]}"}; do
        [[ "${RUNNER_OF[$casefile]}" == "ctest" ]] \\
            && sce_gate_cannot_run "no configured CMake tree at build/"
    done
fi
if [[ -n "${SCE_MUTATION_ROUNDS_DRY_RUN:-}" ]]; then
    for casefile in""")
PY

# ── The report stops naming the runner ─────────────────────────────
#
# The workflow has to know whether the selection contains a ctest round
# *before* it installs anything, and the gate is the only party that has
# already read every declaration. Dropping the column does not make the
# question go away — it moves it somewhere else, and the somewhere else it
# lived before was a shell pipeline that answered wrong on every push that
# needed it.

mutation_case "the dry run stops saying which runner each round needs" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     """    for casefile in ${SELECTED[@]+"${SELECTED[@]}"}; do
        printf '%s\\t%s\\n' "$casefile" "${RUNNER_OF[$casefile]}"
    done""",
     """    printf '%s\\n' ${SELECTED[@]+"${SELECTED[@]}"}""")
PY

# ── The lane works the runner out for itself again ─────────────────
#
# This is the defect verbatim, restored: `grep -q` leaves at the first match,
# the writer takes SIGPIPE, and under `set -o pipefail` the pipeline reports
# 141 — so the lane answers "no CMake tree needed" precisely when one is, and
# the rounds then refuse (exit 3) for the want of the tree the step declined
# to build. Measured 20/20, deterministic. Five casefiles went 34 commits
# without a single CI round before anybody read the lane.
#
# A case against the workflow rather than the gate on purpose: the gate was
# right the whole time, and a corpus that only mutates the gate would have
# stayed green through all 34 of those commits.

mutation_case "the lane writes its own recipe for the tree again" <<'PY'
edit(".github/workflows/mutation-rounds.yml",
     "      run: scripts/prepare_ctest_tree.sh",
     """      run: |
        set -euo pipefail
        cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug
        cmake --build build --parallel "$(nproc)\"""")
PY

# ── The tree is configured without the generator it needs ──────────
#
# The defect verbatim. A runner's checkout has no `target/`, the configure
# resolves `sce-codegen` and stops with a FATAL_ERROR without one, and this is
# the line that makes sure there is one. Nothing on a developer's machine can
# feel its absence — every workstation here carries a built generator — which
# is why the case has to be a mutation and the test has to run in a fixture
# that has none.

mutation_case "the tree is configured without the generator it requires" <<'PY'
edit("scripts/gates/lib.sh",
     """    sce_gate_codegen >/dev/null \\
        || sce_gate_fail "could not provide sce-codegen, which configuring $SCE_MAIN_BUILD_DIR requires\"""",
     "    true")
PY

# ── The verdict's oracle side stops being watched ──────────────────
#
# A verdict has two sides: the source a case breaks, and the test that noticed.
# The gate watched only the first, and the second is where a case dies quietly —
# weaken the assertion and every case in the file keeps the verdict it last
# earned. Measured 2026-08-17: a change to the file holding every assertion
# behind this casefile's own ten CAUGHT verdicts selected 0 of 30 casefiles.

mutation_case "the selection stops watching the test that produced the verdict" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     'target|oracle) TARGETS_OF["$casefile"]+="$value"',
     'target) TARGETS_OF["$casefile"]+="$value"')
PY

# ── A casefile stops selecting its own round ────────────────────────
#
# Its text decides which edit is applied and where. Replace a case's anchor with
# something the compiler drops, or its replacement with a no-op, and the round
# reports CAUGHT over nothing — so the casefile is an oracle for itself.

mutation_case "a casefile no longer selects its own round" <<'PY'
edit("scripts/mutate",
     """    { printf '%s\\n' "$CASEFILE"; mutation_test_oracles; } | awk 'NF && !seen[$0]++'""",
     """    mutation_test_oracles | awk 'NF && !seen[$0]++'""")
PY

# ── The cargo test source stops being derived ───────────────────────
#
# 13 of the 24 cargo casefiles name their test file nowhere else, so a
# derivation that stops resolving takes their oracle side with it — silently,
# because a casefile with no oracle looks exactly like one whose test never
# changes.

mutation_case "the cargo selector's test source stops resolving" <<'PY'
edit("scripts/mutate",
     """        if [[ "$MUTATION_RUNNER" == cargo ]]; then
            mutation_cargo_oracles || true
        fi""",
     "        true")
PY

# ── Narrowing happens once, where the selection is made ────────────
#
# The selection decides which casefiles run and hands each one a job; a round
# obeys the matrix entry it was given. An input that reaches only one of them
# makes the lane prepare for one set and judge another — the asymmetry this
# lane already paid for, and the reason a round is handed exactly one thing.

mutation_case "the dispatch narrows nothing because the selection stops reading it" <<'PY'
edit(".github/workflows/mutation-rounds.yml",
     """        SCE_MUTATION_ROUNDS: ${{ inputs.casefiles }}
      run: |
        set -euo pipefail""",
     """      run: |
        set -euo pipefail""")
PY

mutation_case "the round narrows a second time, on an input its job lacks" <<'PY'
edit(".github/workflows/mutation-rounds.yml",
     """      env:
        SCE_MUTATION_ROUNDS: ${{ matrix.casefile }}
      run: scripts/gate mutation-rounds""",
     """      env:
        SCE_MUTATION_ROUNDS: ${{ matrix.casefile }}
        SCE_GATE_CHANGED_FILE: changed.txt
      run: scripts/gate mutation-rounds""")
PY

mutation_case "the round runs the dispatch's subset instead of its own entry" <<'PY'
edit(".github/workflows/mutation-rounds.yml",
     """        SCE_MUTATION_ROUNDS: ${{ matrix.casefile }}
      run: scripts/gate mutation-rounds""",
     """        SCE_MUTATION_ROUNDS: ${{ inputs.casefiles }}
      run: scripts/gate mutation-rounds""")
PY

# ── The matrix is the only channel between the two jobs ────────────
#
# A round job holds no change set — `changed.txt` is written in the selection's
# workspace — so everything it needs travels in its matrix entry. An entry that
# loses a column does not fail loudly: it produces a job that builds no tree
# for a ctest casefile, and the round then refuses for the want of one.

mutation_case "the matrix carries casefiles without saying which runner they need" <<'PY'
edit(".github/workflows/mutation-rounds.yml",
     """          NF >= 2 { printf "%s{\\"casefile\\":\\"%s\\",\\"runner\\":\\"%s\\"}", sep, $1, $2; sep = "," }""",
     """          NF >= 2 { printf "%s{\\"casefile\\":\\"%s\\"}", sep, $1; sep = "," }""")
PY

mutation_case "the matrix and the count answer for different sets" <<'PY'
edit(".github/workflows/mutation-rounds.yml",
     """          BEGIN { printf "{\\"include\\":[" }""",
     """          BEGIN { printf "{\\"include\\":[" }
          NR == 1 { next }""")
PY

# ── A tree is built for the casefile that needs one ────────────────
#
# The runner column travels with the casefile so the answer is per job. A
# lane-wide answer is the version that makes every cargo casefile in a mixed
# selection pay for a tree it never opens, and it reads as a saving nowhere.

mutation_case "the tree is built for every job or for none" <<'PY'
edit(".github/workflows/mutation-rounds.yml",
     """    - name: Configure and build the CMake tree
      if: matrix.runner == 'ctest'""",
     """    - name: Configure and build the CMake tree
      if: needs.select.outputs.count != '0'""")
PY

# ── The tree is configured and never built ─────────────────────────
#
# `scripts/mutate` builds its own baseline with the output discarded, so a tree
# that does not compile surfaces there as a round that proves nothing rather
# than as the build failure it is. The first build in the open is what makes
# that attributable.

mutation_case "the prepared tree is never built" <<'PY'
edit("scripts/prepare_ctest_tree.sh",
     """cmake --build "$SCE_MAIN_BUILD_DIR" --parallel "$(sce_build_jobs)" \\
    || sce_gate_fail "the main tree does not build; the rounds below it would have nothing to judge\"""",
     "true")
PY

mutation_case "the lane derives the runner in its own shell again" <<'PY'
edit(".github/workflows/mutation-rounds.yml",
     """          NF >= 2 { printf "%s{\\"casefile\\":\\"%s\\",\\"runner\\":\\"%s\\"}", sep, $1, $2; sep = "," }
          END { printf "]}\\n" }
        ' "$selected")\"""",
     """          NF >= 1 { printf "%s{\\"casefile\\":\\"%s\\",\\"runner\\":\\"%s\\"}", sep, $1,
                            (system("scripts/mutate --declares " $1 " | grep -qx runner\\tctest") == 0 ? "ctest" : "cargo"); sep = "," }
          END { printf "]}\\n" }
        ' "$selected")\"""")
PY

# ── What has to be RUNNING for a round to mean anything ─────────────
#
# The three links between a casefile saying it needs a service and something
# starting one. Each is a place the chain was actually broken, or could be
# broken back to where it was: `send_namelist_reaches_the_form.cases` drives a
# suite that posts over a real socket, and with no link at all its round
# reported `baseline is not green (1 failing)` on every CI run it ever had —
# a true sentence about a listener nobody started, phrased as a defect in the
# tree.

mutation_case "the declared service never reaches the caller" <<'PY'
edit("scripts/mutate",
     """        while IFS= read -r _need; do
            [[ -n "$_need" ]] && printf 'needs\\t%s\\n' "$_need"
        done < <(mutation_all_needs)
""",
     "")
PY

mutation_case "the gate stops reading which service a round needs" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     """            needs) NEEDS_OF["$casefile"]+="$value"$'\\n' ;;""",
     """            needs) : ;;""")
PY

mutation_case "the gate reads the service and provisions nothing" <<'PY'
edit("scripts/gates/mutation-rounds.sh",
     """    if [[ "${NEEDS_OF[$casefile]:-}" == *"http-fixture"* ]]; then
        round=(sce_gate_with_http_fixture_server "${round[@]}")
    fi
""",
     "")
PY
