# Mutation cases for "a null data model refusal names the state that holds it".
#
# Run with `scripts/mutate sce-build/tests/mutations/a_refusal_names_the_state_that_holds_it.cases`.
#
# The first case puts the defect back whole: the owning state looked for
# among `<state>` and `<parallel>` ancestors only, so a construct in a
# `<final>` named the state around it, or none at the top level. The unit
# tests in `parser.rs` refuse it at a final state's `<onentry>` and at a
# top-level final state's `<donedata>`.
#
# The rest each take one rule of the lookup away: that the NEAREST state
# is named, and that document scope names no state.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --lib
mutation_targets sce-build/src/parser.rs
mutation_oracles sce-build/src/parser.rs

mutation_case "a final state is not taken for the owning state" <<'PY'
edit("sce-build/src/parser.rs",
     r'''    node.ancestors()
        .find(|ancestor| is_scxml_state_element(ancestor))''',
     r'''    node.ancestors()
        .skip(1)
        .find(|ancestor| matches!(ancestor.tag_name().name(), "state" | "parallel"))''')
PY

mutation_case "the outermost state is named instead of the nearest" <<'PY'
edit("sce-build/src/parser.rs",
     r'''    node.ancestors()
        .find(|ancestor| is_scxml_state_element(ancestor))''',
     r'''    node.ancestors()
        .filter(|ancestor| is_scxml_state_element(ancestor))
        .last()''')
PY

mutation_case "document scope names the root element" <<'PY'
edit("sce-build/src/parser.rs",
     r'''        .and_then(|state| state.attribute("id"))
        .unwrap_or("")''',
     r'''        .and_then(|state| state.attribute("id"))
        .unwrap_or("scxml")''')
PY
