# Mutation cases for "a send whose route is computed says what that route rests on".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_send_whose_route_is_computed_says_what_it_rests_on.cases`.
#
# A draft writes `targetexpr="callerTarget"` because a send needs a target, while the
# specification never says who the caller is: the question is on the data item the route
# reads, not on the send. A scenario run of such a design ended in `error.communication`
# and the verdict called it the design's. The manifest now lists every send that writes a
# `typeexpr` or a `targetexpr` (`computed_routes`), with the data items its route names
# (`reads`) and the questions open on the send or on any of them (`decisions`), and the same
# reading is written onto the send, the type's and the target's apart (`type_decisions`,
# `target_decisions`), for the machine the generator emits.
# Things easy to get wrong and read as success: a value chosen without an answer
# (`sce:assumed`) listed as a question, a question never read off the data item or the
# send, a name after a `.` read as though it were a variable, a `typeexpr` ignored, a
# question listed twice, an empty list written where the field should be absent, and an
# annotation that misses the sends nested in an `<if>` or a history's default transition.
#
# The Python machine the generator emits hands those questions to the places the ROUTE fails
# (the `typeexpr` / `targetexpr` evaluation, the address they produce, the delivery) and to
# no other. Measured 2026-10-02, an earlier registration at the start of the send attached
# them to every error the send raised, so a failing event name, delay or namelist beside an
# open route was told to the owner as the route's open question. The template cases below
# take a place away, or add the questions to one that is not the route, and must make
# `only_the_places_the_route_fails_carry_its_questions` red. The invalid-address and the
# two delivery refusals are held by the same test; the runtime half (the engine giving the
# questions back for the error nothing answered) has its own casefile.
#
# Each case below takes one of those away and must make a test red: the unit tests of the
# two modules (`--lib`), or `a_send_whose_route_is_computed_says_what_it_rests_on.rs`,
# which reads the manifest the binary writes and validates it against the wire schema.
#
# ⚠ A mutated tree is built under `-D warnings`, so every case keeps each binding it
# had in use: a mutation that stops reading one is an unused-variable ERROR, the tree
# does not compile, and the verdict is INCONCLUSIVE (2026-10-01, two other casefiles of
# this family).
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-build --features cli --lib --test a_send_whose_route_is_computed_says_what_it_rests_on
mutation_targets sce-build/src/computed_route_analyzer.rs sce-build/src/ecmascript/reads.rs tools/codegen/templates/python/actions/send.py.jinja2
mutation_oracles sce-build/src/computed_route_analyzer.rs sce-build/src/ecmascript/reads.rs sce-build/tests/a_send_whose_route_is_computed_says_what_it_rests_on.rs

# ── What the manifest says of a send ────────────────────────────────

mutation_case "a value chosen without an answer on a data item is listed as a question" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "            if marker.kind == MarkerKind::Unresolved && !entry.contains(&marker.id) {",
     "            if !entry.contains(&marker.id) {")
PY

mutation_case "a value chosen without an answer on the send is listed as a question" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "        .filter(|marker| marker.kind == MarkerKind::Unresolved)\n        .map(|marker| marker.id.clone())\n        .collect();",
     "        .map(|marker| marker.id.clone())\n        .collect();")
PY

mutation_case "the questions on the send itself are never read" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "    for id in own.iter().cloned().chain(read) {",
     "    for id in own.iter().cloned().take(0).chain(read) {")
PY

mutation_case "the questions on the data items are never read" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "    for id in own.iter().cloned().chain(read) {",
     "    for id in own.iter().cloned().chain(read.take(0)) {")
PY

mutation_case "a question two items share is listed twice" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "        if !decisions.contains(&id) {",
     "        if true {")
PY

mutation_case "a name that is not a declared data item is listed as a read" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "        .filter(|name| data.contains_key(name.as_str()))",
     "        .filter(|name| data.contains_key(name.as_str()) || true)")
PY

mutation_case "the type expression is not read" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "    let type_reads = items_named(&send.typeexpr, data);",
     "    let type_reads = items_named(\"\", data);")
PY

mutation_case "a send with a literal route is listed" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "    if send.typeexpr.is_empty() && send.targetexpr.is_empty() {",
     "    if send.typeexpr.is_empty() && send.targetexpr.is_empty() && false {")
PY

mutation_case "one written site is listed once for each time it is walked" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "    routes.dedup();\n",
     "")
PY

mutation_case "a send with no question is written with an empty list" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "    #[serde(skip_serializing_if = \"Vec::is_empty\")]\n    pub decisions: Vec<String>,",
     "    pub decisions: Vec<String>,")
PY

mutation_case "a send that reads no data item is written with an empty list" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "    #[serde(skip_serializing_if = \"Vec::is_empty\")]\n    pub reads: Vec<String>,",
     "    pub reads: Vec<String>,")
PY

# ── What the generated machine is told ──────────────────────────────

mutation_case "the annotation carries the data items and not the target's questions" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "reading.map(|r| r.target_decisions).unwrap_or_default();",
     "reading.map(|r| { let _ = r.target_decisions; r.reads }).unwrap_or_default();")
PY

mutation_case "a send nested in an if is not annotated" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "                walk(block, data);",
     "                let _ = (block, data);")
PY

mutation_case "a send in a state's blocks is not annotated" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "            walk(block, &data);",
     "            let _ = (block, &data);")
PY

mutation_case "a send in a history's default transition is not annotated" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "        walk(&mut history.default_actions, &data);",
     "        let _ = (&mut history.default_actions, &data);")
PY

# ── What the lexer says an expression reads ─────────────────────────

mutation_case "a member after a dot is read as a variable" <<'PY'
edit("sce-build/src/ecmascript/reads.rs",
     "            if !after_dot && !names.contains(name) {",
     "            if !names.contains(name) {")
PY

mutation_case "a name written twice is listed twice" <<'PY'
edit("sce-build/src/ecmascript/reads.rs",
     "            if !after_dot && !names.contains(name) {",
     "            if !after_dot {")
PY

# ── What the Python machine hands to the places the route fails ─────

mutation_case "the event name is told the route's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "\"<send> eventexpr could not be evaluated to an event name\").to_wire_string()",
     "\"<send> eventexpr could not be evaluated to an event name\"{{ route_ns.arg }}).to_wire_string()")
PY

mutation_case "an event name that evaluates to nothing is told the route's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "self._send_argument_error(engine, _sid, \"<send> eventexpr could not be evaluated to an event name\")\n{% endif %}\n{% if action.targetexpr %}",
     "self._send_argument_error(engine, _sid, \"<send> eventexpr could not be evaluated to an event name\"{{ route_ns.arg }})\n{% endif %}\n{% if action.targetexpr %}")
PY

mutation_case "a route expression that fails to evaluate loses its questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "\"<send> targetexpr could not be evaluated\"{{ route_ns.target_arg }})",
     "\"<send> targetexpr could not be evaluated\")")
PY

mutation_case "an address the processor cannot use loses the route's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "\"<send> targetexpr produced a target this processor cannot address\"{{ route_ns.target_arg }})",
     "\"<send> targetexpr produced a target this processor cannot address\")")
PY

mutation_case "a route that evaluates to nothing loses its questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "event_type=\"platform\"){{ route_ns.target_arg }})",
     "event_type=\"platform\"))")
PY

mutation_case "a type expression that fails to evaluate loses its questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "\"<send> typeexpr could not be evaluated\"{{ route_ns.type_arg }}).to_wire_string()",
     "\"<send> typeexpr could not be evaluated\").to_wire_string()")
PY

mutation_case "a type the platform does not support loses the route's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "\"<send> typeexpr names a processor this platform does not support\"{{ route_ns.type_arg }})",
     "\"<send> typeexpr names a processor this platform does not support\")")
PY

mutation_case "a target nobody can reach loses the route's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{{ 'error.communication' | to_python_const }}, EventMetadata(send_id=_sid, event_type=\"platform\"){{ route_arg }})",
     "{{ 'error.communication' | to_python_const }}, EventMetadata(send_id=_sid, event_type=\"platform\"))")
PY

mutation_case "a target the processor refuses to deliver to loses the route's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{{ indent }}if _routed == \"unsupported\":\n{% if 'error.execution' in model.events %}\n{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.execution' | to_python_const }}, EventMetadata(send_id=_sid, event_type=\"platform\"){{ route_arg }})",
     "{{ indent }}if _routed == \"unsupported\":\n{% if 'error.execution' in model.events %}\n{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.execution' | to_python_const }}, EventMetadata(send_id=_sid, event_type=\"platform\"))")
PY

mutation_case "a peer nobody serves loses the route's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.execution' | to_python_const }}, EventMetadata(send_id=_sid, event_type=\"platform\"){{ route_arg }})\n{% endif %}\n{% endif %}",
     "{{ indent }}    engine.raise_internal({{ machine_name }}Event.{{ 'error.execution' | to_python_const }}, EventMetadata(send_id=_sid, event_type=\"platform\"))\n{% endif %}\n{% endif %}")
PY

mutation_case "a delayed route is armed without its questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{% if has_delay %}{{ delay_py }}{% else %}0{% endif %}, _sid, _data{{ route_arg }})",
     "{% if has_delay %}{{ delay_py }}{% else %}0{% endif %}, _sid, _data)")
PY

mutation_case "a delayed host act is armed without the route's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "engine.schedule_host_send(_host_request, {{ delay_py }}, _sid{{ route_arg }})",
     "engine.schedule_host_send(_host_request, {{ delay_py }}, _sid)")
PY

mutation_case "a send resting on no type question is handed an empty one" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{% if route_ns.text %}\n{% set route_ns.type_arg =",
     "{% if true %}\n{% set route_ns.type_arg =")
PY

mutation_case "a send resting on no target question is handed an empty one" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{% if route_ns.text %}\n{% set route_ns.target_arg =",
     "{% if true %}\n{% set route_ns.target_arg =")
PY

# ── The type and the target are two questions ───────────────────────

mutation_case "a type that fails is handed the target's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "\"<send> typeexpr could not be evaluated\"{{ route_ns.type_arg }}).to_wire_string()",
     "\"<send> typeexpr could not be evaluated\"{{ route_ns.target_arg }}).to_wire_string()")
PY

mutation_case "a type the platform does not support is handed the target's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "\"<send> typeexpr names a processor this platform does not support\"{{ route_ns.type_arg }})",
     "\"<send> typeexpr names a processor this platform does not support\"{{ route_ns.target_arg }})")
PY

mutation_case "a target that fails to evaluate is handed the type's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "\"<send> targetexpr could not be evaluated\"{{ route_ns.target_arg }})",
     "\"<send> targetexpr could not be evaluated\"{{ route_ns.type_arg }})")
PY

mutation_case "the delivery to the target is handed the type's questions" <<'PY'
edit("tools/codegen/templates/python/actions/send.py.jinja2",
     "{{ routed_to_target(indent, has_delay, delay_py, machine_name, model, route_ns.target_arg) }}",
     "{{ routed_to_target(indent, has_delay, delay_py, machine_name, model, route_ns.type_arg) }}")
PY

mutation_case "the annotation hands the type the target's reading as well" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "                    .map(|r| r.type_decisions.clone())",
     "                    .map(|r| [r.type_decisions.clone(), r.target_decisions.clone()].concat())")
PY

mutation_case "the type's questions are read from every name the route reads" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "        type_decisions: apart(&send.typeexpr, &type_reads),",
     "        type_decisions: apart(&send.typeexpr, &reads),")
PY

mutation_case "the target's questions are read from every name the route reads" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "        target_decisions: apart(&send.targetexpr, &target_reads),",
     "        target_decisions: apart(&send.targetexpr, &reads),")
PY

mutation_case "a send with no type expression is given a type question" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "        if expression.is_empty() {\n            Vec::new()",
     "        if false {\n            Vec::new()")
PY

mutation_case "the manifest list leaves out the target's questions" <<'PY'
edit("sce-build/src/computed_route_analyzer.rs",
     "        decisions: questions_of(&own, &reads, data),",
     "        decisions: questions_of(&own, &type_reads, data),")
PY
