# Mutation cases for "one storing value at any profile".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/one_storing_value_at_any_profile.cases`.
#
# A codec has one storing value type, and any profile may hold less than a bound
# (docs/adr/0077 §7). A storing decode reads its frame whole and says
# `CapacityExceeded` only of a frame that parses, through the frame's reader
# (docs/adr/0128). The first case lets the reader's verdict answer `Ok` for a
# frame that noted a capacity; the second has a value past its capacity not
# noted at all; the third has a value past its capacity stop the frame, so a
# frame malformed after it reports `CapacityExceeded`; the fourth has a stored
# list keep the entries of a failed fill; the fifth lets a stored list stay past
# its bound.
#
# Anchors are literal slices of the source; an edit that moves one is
# reported INCONCLUSIVE with the anchor quoted, never as a pass.

mutation_tests -p sce-forge-conformance --features alloc --test forge_view_round_trip
mutation_targets backends/rust/forge-runtime/src/reader.rs backends/rust/forge-runtime/src/bounded.rs
mutation_oracles backends/rust/forge-conformance/tests/forge_view_round_trip.rs

mutation_case "a decode read past a capacity answers as one that held the frame" <<'PY'
edit("backends/rust/forge-runtime/src/reader.rs",
     r'''            None if self.over => Err(CodecError::CapacityExceeded),
            None => Ok(()),''',
     r'''            None => Ok(()),''')
PY

mutation_case "a body with no list read past a capacity answers as one that held it" <<'PY'
edit("backends/rust/forge-runtime/src/reader.rs",
     r'''        if matches!(refused, CodecError::CapacityExceeded) {
            self.over = true;
        } else {''',
     r'''        if matches!(refused, CodecError::CapacityExceeded) {
        } else {''')
PY

mutation_case "a body past a capacity stops the decode that holds it" <<'PY'
edit("backends/rust/forge-runtime/src/reader.rs",
     r'''        if matches!(refused, CodecError::CapacityExceeded) {
            self.over = true;
        } else {''',
     r'''        if matches!(refused, CodecError::CapacityExceeded) {
            self.fail(CodecError::CapacityExceeded);
        } else {''')
PY

mutation_case "a failed fill keeps what it pushed" <<'PY'
edit("backends/rust/forge-runtime/src/bounded.rs",
     r'''                (MIN..=MAX).contains(&self.0.as_slice().len())
            }
            Err(_) => false,
        };''',
     r'''                (MIN..=MAX).contains(&self.0.as_slice().len())
            }
            Err(_) => true,
        };''')
PY

mutation_case "a refill holds a list past its bound" <<'PY'
edit("backends/rust/forge-runtime/src/bounded.rs",
     r'''            n if n > MAX => Err(crate::codec::CodecError::TooManyElements),
            _ => Ok(()),
        });
        // A list read past its capacity keeps the entries it held, which are''',
     r'''            _ => Ok(()),
        });
        // A list read past its capacity keeps the entries it held, which are''')
PY
