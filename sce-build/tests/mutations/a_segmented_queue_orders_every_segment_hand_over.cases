# Mutation cases for "a segmented queue orders every segment hand-over".
#
# Run with
# `scripts/mutate sce-build/tests/mutations/a_segmented_queue_orders_every_segment_hand_over.cases`.
#
# The `segmented` storage mode of SCE Protocol-Synthesis RFC §synth-5-P is a list
# of segments: linked Lamport rings for one producer and one consumer
# (`queue::linked`), and LSCQ, a list of SCQ rings reclaimed through hazard
# pointers, for any other cardinality (`queue::lscq`, `queue::hazard`). Each
# segment is handed from the participant that built it to the others through a
# link, and an element a segment holds is handed from its producer to its
# consumer through the filled count (linked) or the ring's own indices (LSCQ,
# whose rings are the SCQ of `an_scq_queue_orders_every_index_hand_over.cases`).
# The oracle is the loom models in
# `backends/rust/forge-runtime/tests/loom_queue_lscq.rs` (the race of two
# producers to link a successor is in `loom_queue_lscq_race.rs`, whose
# exploration takes minutes, longer than `scripts/mutate` lets one test binary
# run, and is not part of this casefile's oracle), which explore every
# interleaving within three preemptions and every outcome the memory model
# allows, and fail when a slot is read or written with no happens-before edge
# from the access before it, or when an element is lost or a segment is not
# given back. The five cases below each take one hand-over away: the release
# that publishes a link or a count, the acquire that takes it, and the drain that
# must precede a retirement.
#
# Two things this oracle cannot see are not cases here, because a case no oracle
# can catch is a permanent SURVIVED and says nothing (measured 2026-10-10). The
# close bit of a segment's ring matters only to a producer that arrives after
# the segment was closed, which takes a second producer: its oracle is the race
# model, and it needs a casefile of its own with a longer limit than
# `scripts/mutate` gives one test binary. The hazards that keep a retired
# segment alive are in `a_scan_keeps_what_a_hazard_names.cases`, with the reason
# these models cannot judge them.
#
# One thing this file needed, and why it is in the models. Loom keeps one last
# access per atomic and queues a thread switch only against it, so a producer
# that loads an atomic and then stores it hides every earlier access of the other
# thread, and the model runs once and passes whatever the ordering. The linked
# ring's producer does that with its filled count; its model yields in the
# consumer (`offer_switch` in `tests/loom_support/mod.rs`, which says when a
# model may). Both linked cases survived until it did.
#
# Anchors are literal slices of the source; an edit that moves one is reported
# INCONCLUSIVE with the anchor quoted, never as a pass.
#
# The models build only under `--cfg loom`. The selector passes it as a cargo
# `--config` rather than through RUSTFLAGS, so the casefile carries the whole
# command, and gives the build a target directory of its own so that the cfg
# does not invalidate the ordinary build's.

mutation_tests -p sce-forge-runtime --release --target-dir target/loom --config 'build.rustflags=["--cfg","loom"]' --test loom_queue_lscq
mutation_targets backends/rust/forge-runtime/src/queue/lscq.rs backends/rust/forge-runtime/src/queue/linked.rs
mutation_oracles backends/rust/forge-runtime/tests/loom_queue_lscq.rs backends/rust/forge-runtime/tests/loom_support/mod.rs

# ── Linked Lamport rings ───────────────────────────────────────────

mutation_case "the linked producer publishes a filled slot without releasing it" <<'PY'
edit("backends/rust/forge-runtime/src/queue/linked.rs",
     r'''            (*tail).written.0.store(written + 1, Ordering::Release);''',
     r'''            (*tail).written.0.store(written + 1, Ordering::Relaxed);''')
PY

mutation_case "the linked consumer reads the filled count without acquiring it" <<'PY'
edit("backends/rust/forge-runtime/src/queue/linked.rs",
     r'''        let written = unsafe { (*head).written.0.load(Ordering::Acquire) };
        if read >= written {''',
     r'''        let written = unsafe { (*head).written.0.load(Ordering::Relaxed) };
        if read >= written {''')
PY

# ── LSCQ: the link between two segments ────────────────────────────

mutation_case "an LSCQ producer links a segment without releasing it" <<'PY'
edit("backends/rust/forge-runtime/src/queue/lscq.rs",
     r'''                ptr::null_mut(),
                fresh.as_ptr(),
                Ordering::AcqRel,
                Ordering::Acquire,''',
     r'''                ptr::null_mut(),
                fresh.as_ptr(),
                Ordering::Relaxed,
                Ordering::Relaxed,''')
PY

mutation_case "an LSCQ consumer reads the link without acquiring it" <<'PY'
edit("backends/rust/forge-runtime/src/queue/lscq.rs",
     r'''            let next = segment.next.load(Ordering::Acquire);
            if next.is_null() {
                self.hazard.clear();
                return None;''',
     r'''            let next = segment.next.load(Ordering::Relaxed);
            if next.is_null() {
                self.hazard.clear();
                return None;''')
PY

# ── LSCQ: ending a segment ─────────────────────────────────────────

# A consumer that moves `head` past a closed segment on the threshold's word
# alone leaves behind an element whose enqueue holds a ticket and has not yet
# filled its entry.
mutation_case "a consumer retires a closed segment without draining it" <<'PY'
edit("backends/rust/forge-runtime/src/queue/lscq.rs",
     r'''            if let Some(value) = segment.ring.pop_drained() {''',
     r'''            if let Some(value) = segment.ring.pop_drained().filter(|_| false) {''')
PY
